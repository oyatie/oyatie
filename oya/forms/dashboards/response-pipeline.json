{
  "$schema": "https://schemas.grafana.com/dashboard.json",
  "_meta": {
    "doc_class": "GrafanaDashboard",
    "microservice": "forms",
    "owner_team": "axis-forms + ops-sre-reliability + council-privacy",
    "audience": "internal operators + axis-forms + council-privacy + auditors on request",
    "tenant_scoped": false,
    "datasource": "Mimir aggregate (oya-forms tenant)"
  },
  "uid": "forms-response-pipeline",
  "title": "oyatie Forms — Response pipeline (submit → encrypt → seal → fan-out)",
  "tags": ["forms", "response-pipeline", "audit-chain", "captcha"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "templating": {
    "list": [
      {
        "name": "pack",
        "type": "custom",
        "options": [
          {"text": "pack-kr", "value": "kr", "selected": true},
          {"text": "pack-eu", "value": "eu"},
          {"text": "pack-us", "value": "us"},
          {"text": "pack-us-healthcare", "value": "us-hc"},
          {"text": "pack-jp", "value": "jp"},
          {"text": "pack-sg", "value": "sg"},
          {"text": "pack-au", "value": "au"},
          {"text": "pack-in", "value": "in"},
          {"text": "pack-br", "value": "br"},
          {"text": "pack-ae", "value": "ae"},
          {"text": "pack-ksa", "value": "ksa"}
        ]
      },
      {
        "name": "captcha_provider",
        "type": "query",
        "datasource": "Mimir",
        "query": "label_values(oya_forms_captcha_verify_total, provider)",
        "label": "Captcha Provider",
        "includeAll": true
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Submission p95 latency (target ≤ 150ms GA)",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "targets": [
        {"expr": "histogram_quantile(0.95, sum by (le) (rate(oya_forms_submission_latency_seconds_bucket{pack=\"$pack\"}[5m])))", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 0.12}, {"color": "red", "value": 0.15}]}}}
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Submission accept rate (vs 429/captcha/validation reject)",
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
      "targets": [
        {"expr": "sum(rate(oya_forms_submission_accepted_total{pack=\"$pack\"}[5m])) / sum(rate(oya_forms_submission_total{pack=\"$pack\"}[5m]))", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "percentunit"}}
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Captcha provider health",
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
      "targets": [
        {"expr": "min by (provider) (oya_forms_captcha_provider_up{pack=\"$pack\",provider=~\"$captcha_provider\"})", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"thresholds": {"steps": [{"color": "red", "value": 0}, {"color": "green", "value": 1}]}}}
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Audit-chain seal coverage (MUST be 100%)",
      "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
      "targets": [
        {"expr": "sum(rate(oya_forms_response_audit_sealed_total{pack=\"$pack\"}[1h])) / sum(rate(oya_forms_submission_accepted_total{pack=\"$pack\"}[1h]))", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "percentunit", "thresholds": {"steps": [{"color": "red", "value": 0}, {"color": "yellow", "value": 0.999}, {"color": "green", "value": 1.0}]}}}
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Submission rate by form (top-10)",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "targets": [
        {"expr": "topk(10, sum by (form_id) (rate(oya_forms_submission_total{pack=\"$pack\"}[5m])))", "legendFormat": "{{form_id}}", "refId": "A"}
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Submission p50/p95/p99 latency breakdown",
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum by (le) (rate(oya_forms_submission_latency_seconds_bucket{pack=\"$pack\"}[5m])))", "legendFormat": "p50", "refId": "A"},
        {"expr": "histogram_quantile(0.95, sum by (le) (rate(oya_forms_submission_latency_seconds_bucket{pack=\"$pack\"}[5m])))", "legendFormat": "p95", "refId": "B"},
        {"expr": "histogram_quantile(0.99, sum by (le) (rate(oya_forms_submission_latency_seconds_bucket{pack=\"$pack\"}[5m])))", "legendFormat": "p99", "refId": "C"},
        {"expr": "vector(0.15)", "legendFormat": "GA budget (p95 150ms)", "refId": "D"}
      ],
      "fieldConfig": {"defaults": {"unit": "s"}}
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Submit rejections by reason",
      "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum by (reason) (rate(oya_forms_submission_rejected_total{pack=\"$pack\"}[5m]))", "legendFormat": "{{reason}}", "refId": "A"}
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Field validation p99 latency (target ≤ 50ms)",
      "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8},
      "targets": [
        {"expr": "histogram_quantile(0.99, sum by (le, field_type) (rate(oya_forms_field_validate_latency_seconds_bucket{pack=\"$pack\"}[5m])))", "legendFormat": "{{field_type}} p99", "refId": "A"},
        {"expr": "vector(0.05)", "legendFormat": "GA budget (50ms)", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"unit": "s"}}
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Postgres connection pool saturation",
      "gridPos": {"x": 0, "y": 20, "w": 12, "h": 8},
      "targets": [
        {"expr": "oya_forms_postgres_connection_pool_saturation{pack=\"$pack\"}", "legendFormat": "{{shard}}", "refId": "A"},
        {"expr": "vector(0.7)", "legendFormat": "scale-out threshold", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"unit": "percentunit"}}
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Valkey memory usage (rate-limit + session)",
      "gridPos": {"x": 12, "y": 20, "w": 12, "h": 8},
      "targets": [
        {"expr": "oya_forms_valkey_memory_used_bytes{pack=\"$pack\"} / oya_forms_valkey_memory_max_bytes{pack=\"$pack\"}", "legendFormat": "{{cluster}}", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "percentunit", "thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 0.75}, {"color": "red", "value": 0.85}]}}}
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Workflow-trigger fan-out queue depth (cross-µservice to workflow-engine)",
      "gridPos": {"x": 0, "y": 28, "w": 12, "h": 8},
      "targets": [
        {"expr": "oya_forms_workflow_trigger_queue_depth{pack=\"$pack\"}", "legendFormat": "queue depth", "refId": "A"},
        {"expr": "oya_forms_workflow_trigger_dlq_depth{pack=\"$pack\"}", "legendFormat": "DLQ depth", "refId": "B"}
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Webhook delivery success rate (mTLS + HMAC)",
      "gridPos": {"x": 12, "y": 28, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum(rate(oya_forms_webhook_delivered_total{pack=\"$pack\",http_status=~\"2..\"}[5m])) / sum(rate(oya_forms_webhook_delivered_total{pack=\"$pack\"}[5m]))", "legendFormat": "success rate", "refId": "A"},
        {"expr": "oya_forms_webhook_dlq_depth{pack=\"$pack\"}", "legendFormat": "DLQ depth", "refId": "B"}
      ]
    },
    {
      "id": 13,
      "type": "stat",
      "title": "PII column-encryption correctness (MUST be 100%)",
      "gridPos": {"x": 0, "y": 36, "w": 12, "h": 4},
      "targets": [
        {"expr": "sum(rate(oya_forms_pii_column_encrypted_total{pack=\"$pack\"}[1h])) / sum(rate(oya_forms_pii_column_write_total{pack=\"$pack\"}[1h]))", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "percentunit", "thresholds": {"steps": [{"color": "red", "value": 0}, {"color": "yellow", "value": 0.9999}, {"color": "green", "value": 1.0}]}}}
    },
    {
      "id": 14,
      "type": "stat",
      "title": "Cross-pack write attempt (MUST be 0)",
      "gridPos": {"x": 12, "y": 36, "w": 12, "h": 4},
      "targets": [
        {"expr": "sum(rate(oya_forms_cross_pack_write_attempt_total{pack=\"$pack\"}[24h]))", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "red", "value": 1}]}}}
    }
  ]
}
