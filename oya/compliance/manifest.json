{
  "$schema": "../../specs/microservices/manifest-schema.json",
  "microservice": "compliance",
  "tier": "substrate",
  "tier_subtype": "substrate-compliance",
  "dr_tier": "T1",
  "substrate_dag_position": {
    "stratum": "S4",
    "depends_on": [],
    "consumed_by_substrates": [],
    "_note": "forward-declared per ADR-0280 Appendix C; edges land in DAG v1.1.0"
  },
  "owner": "axis-compliance",
  "co_owners": [
    "axis-security",
    "council-architecture"
  ],
  "purpose": "Compliance evidence automation per ADR-0209. In-house pipeline covering SOC 2 Type II, GDPR (incl. DSAR automation), HIPAA, PCI-DSS — replacing Drata / Vanta / Tugboat Logic / AuditBoard / ServiceNow GRC. Substrate kernel: oya-shared-compliance-evidence-kernel.",
  "layout": "flat",
  "adr_authority_chain": [
    "ADR-0131",
    "ADR-0209",
    "ADR-0145",
    "ADR-0394",
    "ADR-0181",
    "ADR-0183"
  ],
  "phase": "PHASE-01-EVIDENCE-PIPELINE-BOOTSTRAP",
  "status": "Drafting",
  "scope": {
    "frameworks_covered": [
      "soc2-type-2",
      "gdpr",
      "hipaa",
      "pci-dss"
    ],
    "evidence_collectors": [
      "ci-artifact-hash",
      "deploy-receipt",
      "access-review-snapshot",
      "backup-restore-drill-receipt",
      "vuln-scan-report",
      "pen-test-report",
      "dsar-completion-record",
      "baa-inventory-entry",
      "minimum-necessary-access-log"
    ],
    "dsar_sla_days": 30,
    "dsar_target_days": 5,
    "cross_tenant_isolation_enforced": true
  },
  "i18n": {
    "default_locale": "en-US",
    "required_locales": [
      "en-US",
      "ko-KR",
      "ja-JP",
      "de-DE",
      "fr-FR",
      "es-MX",
      "ar-SA",
      "he-IL"
    ],
    "rtl_support": true,
    "min_coverage_bps": 9500
  },
  "a11y": {
    "wcag_target": "aa",
    "test_runners": [
      "axe-core-playwright",
      "pa11y"
    ]
  },
  "realtime": {
    "transport": {
      "tier": "sse"
    },
    "payload_budget_bytes": 1048576
  },
  "observability": {
    "trace_sampling_recipe": {
      "head_bps": 200,
      "tail_policies": [
        "status_code=ERROR",
        "latency_p99",
        "new_endpoint_warmup",
        "audit_event",
        "random_baseline=0.02"
      ],
      "p99_latency_threshold_ms": 800,
      "new_endpoints": []
    },
    "metric_cardinality_envelope": {
      "max_unique_attribute_combinations": 50000
    }
  },
  "compliance": {
    "evidence_collectors": [
      "ci-artifact-hash",
      "deploy-receipt",
      "access-review-snapshot",
      "backup-restore-drill-receipt",
      "vuln-scan-report",
      "pen-test-report",
      "dsar-completion-record",
      "baa-inventory-entry",
      "minimum-necessary-access-log"
    ],
    "audit_chain_seal_required": true,
    "tamper_evidence_algorithm": "sha256-cosign-keyless-oidc"
  },
  "data_classes": {
    "ingested": [
      "AUDIT",
      "SECRET",
      "PII_IDENTIFYING",
      "PHI",
      "INTERNAL_ONLY"
    ],
    "emitted": [
      "AUDIT",
      "INTERNAL_ONLY"
    ]
  },
  "storage": {
    "evidence_backing": "seaweedfs-filer",
    "audit_chain_backing": "append-only-jsonl-with-cosign-seal"
  },
  "team_topology": {
    "team_type": "platform",
    "rotation": "ops-sre-reliability+axis-security"
  },
  "ip_register": [
    "IP-001-evidence-collector-bootstrap",
    "IP-002-soc2-control-mapping",
    "IP-003-gdpr-dsar-automation-pipeline",
    "IP-004-hipaa-min-necessary-log-substrate",
    "IP-005-audit-chain-seal-coverage",
    "IP-006-evidence-storage-seaweedfs",
    "IP-007-auditor-readonly-portal",
    "IP-008-pii-scrubber",
    "IP-009-retention-tier-policy",
    "IP-010-attestation-aggregator",
    "IP-011-cross-microservice-evidence-fan-in",
    "IP-012-evidence-replay",
    "IP-013-audit-anomaly-detection",
    "IP-014-manual-evidence-upload-flow",
    "IP-015-regulatory-pack-evidence-overlay"
  ],
  "mesh_layering": {
    "cilium_l4": true,
    "ambient_ztunnel": true,
    "ambient_waypoint": false
  },
  "naming_justifications": "compliance is a BNF v4.1 kebab-case microservice slug; generated names follow oya-compliance-<bounded-context>-<layer>, with layer rest from ADR-0105's 13-layer enum.",
  "tenant_class_model": {
    "tenant_class": [
      "demo_trial",
      "paid"
    ],
    "billing_components": [
      "revenue_share",
      "per_seat",
      "per_usage"
    ],
    "availability": "demo_trial is cap-bounded; paid unlocks pack activation through compliance_pack and billing_components."
  },
  "bounded_contexts": [
    "auditor-engagement-read",
    "breach-declare",
    "compliance-admin-upload",
    "dsar-subject-self-service",
    "pack-overlay-subscribe"
  ],
  "packs": [
    "soc2-type2",
    "gdpr",
    "hipaa",
    "PCI-DSS",
    "soc2",
    "iso27001-2022",
    "kr-pipa",
    "iso27001",
    "il5",
    "il6",
    "fedramp-high",
    "eu-ai-act",
    "cn-pipl-2021",
    "fedramp"
  ],
  "hyperscaler_benchmark": "1: AWS IAM service-linked roles anchors the external control pattern for principals; 2: Google Cloud service agents provides a second independent hyperscaler pattern for principals; 1: AWS Verified Permissions Cedar anchors the external control pattern for cedar-gates; 2: Google Zanzibar provides a second independent hyperscaler pattern for cedar-gates; 1: Stripe account isolation anchors the external control pattern for tenant-scoping; 2: AWS Organizations account boundary provides a second independent hyperscaler pattern for tenant-scoping",
  "owner_team": "axis-compliance",
  "tier_classification": "Drafting",
  "data_classification": "AUDIT, SECRET, PII_IDENTIFYING, PHI, INTERNAL_ONLY, PII_QUASI",
  "compliance_packs_applicable": [
    "soc2-type2",
    "gdpr",
    "hipaa",
    "PCI-DSS",
    "soc2",
    "iso27001-2022",
    "kr-pipa",
    "iso27001",
    "il5",
    "il6",
    "fedramp-high",
    "eu-ai-act",
    "cn-pipl-2021",
    "fedramp"
  ],
  "depends_on_microservices": [
    "audit-chain",
    "tenancy",
    "identity",
    "observability",
    "cell",
    "intelligence",
    "detection",
    "network",
    "cloud-iac"
  ],
  "failure_domain": "tenant-cell and regional-failover execution domain",
  "criticality_tier": "T2",
  "layer": "rest",
  "doc_class": "Machine-Readable-Spec",
  "capacity_model": {
    "baseline_cpu_per_tenant": 0.16,
    "baseline_ram_per_tenant": 256,
    "storage_per_tenant": 12,
    "connections_per_tenant": {
      "valkey": 2,
      "postgres": 3,
      "outbound_http": 8
    },
    "scaling_dimension": "per_workflow_run",
    "cell_placement_class": "Tier-2",
    "notes": "Evidence exports and compliance collectors scale with workflow executions and retention footprint."
  },
  "sharding_automation": {
    "autosharding": "control_plane_driven",
    "auto_rebalance": {
      "enabled": false,
      "trigger_load_skew_threshold_percent": 30,
      "honors_residency": true,
      "honors_compliance_packs": true,
      "audit_chain_emit": true
    },
    "dynamic_sharding": {
      "enabled": false,
      "hot_split_threshold_p99_ms": 50,
      "hot_split_utilization_threshold_percent": 80,
      "cold_merge_utilization_threshold_percent": 20,
      "cold_merge_minimum_quiet_hours": 24,
      "audit_chain_emit": true
    }
  },
  "dr": {
    "rto_p99_seconds": 1800,
    "rpo_p99_seconds": 300,
    "multi_region_active_active": true,
    "backup_substrate": [
      "object_storage_versioned",
      "seaweedfs_replicated",
      "postgres_wal_g",
      "audit_chain_merkle_seal"
    ],
    "failover_runbook": "runbooks/seaweedfs-evidence-bucket-loss.md",
    "dr_tier": "T1",
    "replication_shape": "active-active-multi-az-cross-region-warm"
  },
  "pod_runtime_tier": 1,
  "pod_runtime_tier_justification": "Compliance handles regulated tenant evidence, DSAR exports, auditor access, and breach declarations. It is first-party code, but it touches sensitive tenant evidence and compliance data planes, so Tier 1 isolation applies.",
  "pod_runtime_tier_surface_evidence": [
    "microservices/compliance/PRD.md",
    "microservices/compliance/ARCHITECTURE.md",
    "microservices/compliance/IP-004-hipaa-min-necessary-log-substrate.md",
    "microservices/compliance/IP-011-cross-microservice-evidence-fan-in.md",
    "microservices/compliance/runbooks/seaweedfs-evidence-bucket-loss.md"
  ],
