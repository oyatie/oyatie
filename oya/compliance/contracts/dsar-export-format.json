{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oya.dev/dsar/v1/export-format",
  "title": "GDPR Art. 20 portable export format (JSON-LD)",
  "type": "object",
  "required": ["@context", "subject_pseudonym", "tenant_id", "exported_at", "records", "audit_chain_seal_hex"],
  "properties": {
    "@context": {
      "type": "string",
      "const": "https://oya.dev/dsar/v1"
    },
    "subject_pseudonym": {
      "type": "string",
      "description": "Subject's pseudonymized identifier (raw subject identity NEVER appears in export payload)."
    },
    "tenant_id": {
      "type": "string",
      "description": "Tenant scope; cross-tenant data must NEVER appear in this export."
    },
    "exported_at": {
      "type": "string",
      "format": "date-time"
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["@type", "id", "data"],
        "properties": {
          "@type": {"type": "string"},
          "id": {"type": "string"},
          "source_microservice": {"type": "string"},
          "data": {"type": "object"}
        }
      }
    },
    "audit_chain_seal_hex": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "replay_from_seal_hex": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "Optional; present when export is replayed from cold archive."
    }
  }
}
