{
  "title": "Compliance — Pack Overlay Coverage",
  "uid": "compliance-pack-overlay-coverage",
  "schemaVersion": 39,
  "tags": ["compliance", "pack-overlay", "ADR-0251"],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Active packs per tenant",
      "targets": [{ "expr": "sum by (tenant_id) (oya_compliance_pack_subscribed{state=\"active\"})" }]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Pack-publish events / hour",
      "targets": [{ "expr": "sum(rate(oya_compliance_pack_published_total[1h]))" }]
    },
    {
      "id": 3,
      "type": "table",
      "title": "Packs by jurisdiction",
      "targets": [{ "expr": "sum by (pack_id, jurisdiction) (oya_compliance_pack_subscribed)" }]
    }
  ],
  "binding_adrs": ["ADR-0251", "ADR-0263"]
}
