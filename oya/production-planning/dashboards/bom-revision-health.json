{
  "title": "Production Planning health",
  "tags": [
    "erp",
    "production-planning",
    "bom-revision",
    "PP"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "benchmarks": [
    "SAP PP Production Planning",
    "Oracle Fusion Cloud Manufacturing",
    "Workday Adaptive Planning production-capacity counterpart",
    "NetSuite Manufacturing WIP and Routings",
    "Microsoft Dynamics 365 Supply Chain Management"
  ],
  "panels": [
    {
      "title": "bom-revision command rate",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(oya_production_planning_bom_revision_commands_total[5m])) by (tenant_id)"
        }
      ]
    },
    {
      "title": "bom-revision p99 latency",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(oya_production_planning_bom_revision_latency_seconds_bucket[5m])) by (le, tenant_id))"
        }
      ]
    },
    {
      "title": "bom-revision audit events",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(rate(audit_events_total{service=\"production-planning\",bounded_context=\"bom-revision\"}[5m]))"
        }
      ]
    }
  ]
}
