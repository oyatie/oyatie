{
  "dashboard": {
    "title": "Social — Minor Protection Health",
    "uid": "social-minor-protection-health",
    "tags": ["social", "minor-protection", "ADR-0292"],
    "panels": [
      {
        "id": 1,
        "title": "COPPA <13 sign-up refusals (24h)",
        "type": "stat",
        "targets": [
          {"expr": "sum(rate(oya_social_minor_protect_engage_total{reason=\"COPPA_UNDER_13_REFUSE\"}[24h]))"}
        ]
      },
      {
        "id": 2,
        "title": "KOSA 14-17 strict-default engagements per tenant",
        "type": "timeseries",
        "targets": [
          {"expr": "sum(rate(oya_social_minor_protect_engage_total{minor_age_band=\"KOSA_14_17\"}[5m])) by (tenant_id, default_class)"}
        ]
      },
      {
        "id": 3,
        "title": "Anti-grooming heuristic engagements (24h)",
        "type": "stat",
        "targets": [
          {"expr": "sum(rate(oya_social_minor_grooming_detect_total[24h]))"}
        ]
      },
      {
        "id": 4,
        "title": "Guardian dashboard accesses (24h)",
        "type": "stat",
        "targets": [
          {"expr": "sum(rate(oya_social_guardian_dashboard_read_total[24h]))"}
        ]
      },
      {
        "id": 5,
        "title": "Algorithmic ranking opt-in rate (KOSA tier)",
        "type": "stat",
        "targets": [
          {"expr": "sum(oya_social_kosa_algorithmic_ranking_opted_in) / sum(oya_social_kosa_account_total)"}
        ]
      },
      {
        "id": 6,
        "title": "Overnight notification mutes engaged (KOSA tier)",
        "type": "stat",
        "targets": [
          {"expr": "sum(rate(oya_social_push_notification_overnight_mute_total[24h]))"}
        ]
      }
    ]
  }
}
