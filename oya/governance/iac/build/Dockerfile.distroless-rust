# Canonical distroless runtime Dockerfile wrapper per ADR-0146.
#
# 2026-06-02 Buck2 authority amendment: CI/CD/scripts/build lanes must compile
# service binaries and OCI layouts through Buck2 targets. This Dockerfile is a
# runtime wrapper for tools that already have a Buck2-produced binary in the
# Docker build context; it does not invoke Cargo, rustup, or a Rust compiler.
#
# Expected handoff:
#   1. buck2 build <service-binary-or-oci-target> [--target-platforms <linux-musl>]
#   2. copy/materialize the selected Buck2 binary to dist/${BIN_NAME}
#   3. docker build --build-arg BIN_NAME=${BIN_NAME} ... only as non-authority
#      runtime-image smoke evidence.
#
# Production release optimization experiments that use Cargo remain separate
# release-exception evidence only and must be encoded back into Buck2 before they
# become a standard build path.

FROM gcr.io/distroless/static-debian12:nonroot
ARG BIN_NAME=oya-app
COPY dist/${BIN_NAME} /app
USER 65532:65532
ENTRYPOINT ["/app"]
