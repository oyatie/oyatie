{
  "name": "@oyatie/app-shell-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Archived SolidJS transition shell retained for ADR-0393 migration evidence; Leptos/Rust-WASM is canonical.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/run-vinxi.mjs dev",
    "build": "node scripts/run-vinxi.mjs build",
    "start": "node scripts/run-vinxi.mjs start",
    "typecheck": "tsc --noEmit",
    "codegen": "openapi-typescript ../../contracts/ops-workspace-shell-v1.openapi.yaml -o ./generated/ops-workspace-shell.d.ts && openapi-typescript ../hr/contracts/openapi-v1.yaml -o ./generated/hr-api.d.ts",
    "codegen:check": "node scripts/codegen-check.mjs",
    "test": "node scripts/shell-contract-check.mjs",
    "lint": "node scripts/shell-contract-check.mjs"
  },
  "dependencies": {
    "@solidjs/router": "0.14.10",
    "@solidjs/start": "1.1.0",
    "solid-js": "1.9.7"
  },
  "devDependencies": {
    "@types/node": "22.15.21",
    "openapi-typescript": "7.8.0",
    "typescript": "5.8.3",
    "vite": "6.3.5",
    "vite-plugin-solid": "2.11.6"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@11.5.2"
}
