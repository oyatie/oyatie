  },
  "capabilities": [
    {
      "tier": "T0",
      "name": "medication-catalog-read",
      "risk_class": "none",
      "rationale": "Read-only catalog reference."
    },
    {
      "tier": "T0",
      "name": "formulary-read",
      "risk_class": "none",
      "rationale": "Read-only formulary status."
    },
    {
      "tier": "T1",
      "name": "drug-interaction-evaluate",
      "risk_class": "limited",
      "rationale": "Decision-support output only; clinician decides."
    },
    {
      "tier": "T1",
      "name": "dose-check-evaluate",
      "risk_class": "limited",
      "rationale": "Decision-support output only; clinician decides."
    },
    {
      "tier": "T1",
      "name": "bcma-verify",
      "risk_class": "limited",
      "rationale": "Five-rights check; clinician scans and decides."
    },
    {
      "tier": "T2",
      "name": "order-queue-route",
      "risk_class": "limited"
    },
    {
      "tier": "T2",
      "name": "refill-triage",
      "risk_class": "limited"
    },
    {
      "tier": "T3",
      "name": "therapeutic-interchange",
      "risk_class": "high",
      "rationale": "Within-formulary interchange under tenant policy; pharmacist final review."
    },
    {
      "tier": "T3",
      "name": "b340-mixed-use-classify",
      "risk_class": "high",
      "rationale": "HRSA-auditable classification; replenishment lot tagging."
    },
    {
      "tier": "T3",
      "name": "pbm-automated-resubmit",
      "risk_class": "high",
      "rationale": "Automated NCPDP reject-then-resubmit within configured rules."
    }
  ],
