  "cross_microservice_dependencies": [
    {
      "depends_on": "audit-chain",
      "via": "oya-audit-chain-emission-sdk",
      "reason": "Seal every controlled event with bilateral cross-pointer when cross-tenant."
    },
    {
      "depends_on": "emr",
      "via": "gRPC emr.Patient/Encounter/Allergy/Problem/Labs/MAR",
      "reason": "Patient identity, allergies, problems, labs (renal/hepatic), MAR write-back."
    },
    {
      "depends_on": "identity",
      "via": "OIDC + Cedar principal",
      "reason": "Prescriber DEA, pharmacist license, nurse identity, EPCS two-factor evidence."
    },
    {
      "depends_on": "cloud-iam",
      "via": "Cedar policy gate",
      "reason": "Every guarded action authorized; break-glass logged."
    },
    {
      "depends_on": "cloud-kms",
      "via": "Sign + verify",
      "reason": "EPCS DEA-bound keys, audit-chain Merkle keys, PBM mTLS material."
    },
    {
      "depends_on": "cloud-secrets",
      "via": "Secret fetch",
      "reason": "Surescripts mTLS, PBM credentials, FDB/Multum API keys."
    },
    {
      "depends_on": "observability",
      "via": "Self-SLO emission",
      "reason": "12 SLOs registered."
