{
  "schema_version": "1.0",
  "microservice": "pharmacy",
  "tier": "product",
  "tier_subtype": "product-consumer",
  "dr_tier": "T2",
  "version": "0.1.0",
  "owner": "axis-pharmacy",
  "authority_adr": "docs/adr-archive/ADR-0332-healthcare-domain-decomposition.md",
  "layout_authority": "docs/decisions/ADR-0701-monorepo-capability-live-apex.md",
  "grouping_policy": "docs/decisions/ADR-0705-product-protocol-live-apex.md",
  "summary": "Pharmacy clinical and operational substrate — medication catalog (NDC + RxNorm + GPI + ATC + UNII), formulary, ePrescribe (Surescripts + NCPDP SCRIPT + EPCS), drug interactions (DDI/DAI/DCI/DPI/DDxI/DLI/DFI/DDoseI), allergy + dose checking, pharmacist verification, compounding (USP 795/797/800), inventory, auto-dispensing cabinets (Pyxis/Omnicell/Carousel), BCMA, IV admixture + smart pump (Alaris/Plum/Hospira), controlled substances (DEA CII–CV + Form 222 + EPCS), reimbursement (340B + PBM NCPDP D.0), operations, interventions, medication reconciliation, outpatient retail/drive-through/mail/specialty, MTM (CMR/TMR/MAP/PML), DSCSA (SGTIN-198 + T1/T2/T3 + saleable returns + suspect product).",
  "bounded_contexts": [
    {
      "name": "medication-catalog",
      "description": "NDC + RxNorm + GPI + ATC + UNII canonical identity; FDB/Multum/Medi-Span ingestion; A/B knowledge package switching.",
      "crates": []
    },
    {
      "name": "formulary",
      "description": "Per-tenant + per-cell formulary; P&T workflow; therapeutic interchange; prior-auth criteria.",
      "crates": []
    },
    {
      "name": "eprescribe",
      "description": "Surescripts + NCPDP SCRIPT 2017-071+ orchestration; EPCS signing for Schedule II–V.",
      "crates": []
    },
    {
      "name": "drug-interaction",
      "description": "DDI/DAI/DCI/DPI/DDxI/DLI/DFI/DDoseI evaluation; severity stratification; tenant suppression with audit.",
      "crates": []
    },
    {
      "name": "allergy-check",
      "description": "Patient allergy mirror from emr; exact + cross-class; severity-aware override capture.",
      "crates": []
    },
    {
      "name": "dose-check",
      "description": "Weight/BSA/renal(eGFR+CrCl)/hepatic(Child-Pugh)/age-band/cumulative caps.",
      "crates": []
    },
    {
      "name": "verification",
      "description": "Single vs dual pharmacist verification; tall-man-lettering rendering; controlled-substance dual-witness.",
      "crates": []
    },
    {
      "name": "compounding",
      "description": "USP 795/797/800; master formulation; compounding record; BUD; environmental monitoring evidence.",
      "crates": []
    },
    {
      "name": "inventory",
      "description": "Par/min/max; lot+expiry; recall sequestration; perpetual reconciliation.",
      "crates": []
    },
    {
      "name": "auto-dispensing",
      "description": "Pyxis/Omnicell/Carousel/AcuDose/MedDispense vendor-neutral adapter contract; offline+reconcile.",
      "crates": []
    },
    {
      "name": "bcma",
      "description": "Five-rights validation; nurse override with pharmacist callback within 5 min; MAR write-back to emr.",
      "crates": []
    },
    {
      "name": "iv-admixture",
      "description": "IV compound preparation; smart pump drug library (Alaris/Plum/Hospira); DERS hard/soft limits; auto-program.",
      "crates": []
    },
    {
      "name": "controlled-substance",
      "description": "DEA Form 222 ordering; perpetual inventory CII–CV; witnessed waste; two-person count; EPCS; DEA inspection report.",
      "crates": []
    },
    {
      "name": "reimbursement",
      "description": "340B eligibility + split billing; PBM NCPDP D.0 claims; payer adjudication; copay; handoff to cloud-billing.",
      "crates": []
    },
    {
      "name": "operations",
      "description": "Order/prep/verify/deliver queues; pharmacist workload balancing; DUR.",
      "crates": []
    },
    {
      "name": "interventions",
      "description": "Clinical intervention capture; outcome tracking; MTM billable mapping; intervention dashboards.",
      "crates": []
    },
    {
      "name": "med-rec",
      "description": "Admission/transfer/discharge medication reconciliation; pre-admission med list reconciliation.",
      "crates": []
    },
    {
      "name": "outpatient-rx",
      "description": "Retail/drive-through/mail-order/specialty; refill requests; will-call expiration; LDD enrollment.",
      "crates": []
    },
    {
      "name": "mtm",
      "description": "CMR/TMR/MAP/PML; CPT 99605–99607 billing codes; intelligence-substrate PML drafting with redaction.",
      "crates": []
    },
    {
      "name": "dscsa",
      "description": "GS1 SGTIN-198 + lot + expiry + serial; T1/T2/T3 exchange (EPCIS 2.0); saleable returns; suspect product investigation.",
      "crates": []
    }
  ],
  "layers": [
    "adapter",
    "api",
    "app",
    "domain",
    "kernel",
    "rest",
    "sdk",
    "usecase",
    "worker"
  ],
