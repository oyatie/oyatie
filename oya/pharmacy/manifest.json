      "file": "oya/pharmacy/slos/bcma-availability.openslo.yaml"
    },
    {
      "name": "oya-pharmacy-eprescribe-availability",
      "target": "0.999",
      "sli": "1 - (sum(rate(oya_pharmacy_eprescribe_total{outcome=\"error\"}[5m])) / sum(rate(oya_pharmacy_eprescribe_total[5m])))",
      "file": "oya/pharmacy/slos/eprescribe-availability.openslo.yaml"
    },
    {
      "name": "oya-pharmacy-catalog-read-availability",
      "target": "0.9995",
      "sli": "1 - (sum(rate(oya_pharmacy_catalog_read_total{outcome=\"error\"}[5m])) / sum(rate(oya_pharmacy_catalog_read_total[5m])))",
      "file": "oya/pharmacy/slos/catalog-read-availability.openslo.yaml"
    },
    {
      "name": "oya-pharmacy-audit-chain-coverage-completeness",
      "target": "1.0",
      "sli": "sum(rate(oya_pharmacy_audit_emit_total{outcome=\"sealed\"}[5m])) / sum(rate(oya_pharmacy_audit_emit_total[5m]))",
      "file": "oya/pharmacy/slos/audit-chain-coverage-completeness.openslo.yaml"
    },
    {
      "name": "oya-pharmacy-controlled-substance-witness-integrity",
      "target": "1.0",
      "sli": "sum(rate(oya_pharmacy_controlled_witness_total{outcome=\"signed\"}[5m])) / sum(rate(oya_pharmacy_controlled_witness_total[5m]))",
      "file": "oya/pharmacy/slos/controlled-substance-witness-integrity.openslo.yaml"
    },
    {
      "name": "oya-pharmacy-340b-classification-accuracy",
      "target": "0.9999",
      "sli": "1 - (sum(rate(oya_pharmacy_b340_classification_total{outcome=\"incorrect\"}[1h])) / sum(rate(oya_pharmacy_b340_classification_total[1h])))",
      "file": "oya/pharmacy/slos/340b-classification-accuracy.openslo.yaml"
    },
    {
      "name": "oya-pharmacy-dscsa-saleable-return-verification-rate",
      "target": "0.999",
      "sli": "sum(rate(oya_pharmacy_dscsa_saleable_return_total{outcome=\"verified\"}[5m])) / sum(rate(oya_pharmacy_dscsa_saleable_return_total[5m]))",
      "file": "oya/pharmacy/slos/dscsa-saleable-return-verification-rate.openslo.yaml"
    }
  ],
