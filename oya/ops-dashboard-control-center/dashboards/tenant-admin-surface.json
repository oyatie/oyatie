{
  "__inputs": [{ "name": "DS_PROMETHEUS", "type": "datasource", "pluginId": "prometheus" }],
  "__requires": [{ "type": "grafana", "id": "grafana", "name": "Grafana", "version": "12.0.0" }],
  "title": "Ops Dashboard — Tenant Admin Surface",
  "uid": "oya-ops-tenant-admin-v1",
  "description": "Tenant-admin panel: tenant lifecycle, isolation posture, quota, residency, SLO posture, evidence refs. Scoped to operator's authorized tenant list (Cedar-enforced). Keyboard shortcut: G→T. Hyperscaler precedent: Stripe Dashboard tenant portal, AWS Organizations account view.",
  "tags": ["ops", "tenant", "isolation", "quota", "internal"],
  "timezone": "browser",
  "editable": false,
  "schemaVersion": 40,
  "version": 1,
  "refresh": "60s",
  "time": { "from": "now-24h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Tenants in Scope",
      "description": "Count of tenants visible to this operator (Cedar-scoped). Partner-agency operators see sub-tenant count only.",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "targets": [{
        "expr": "oya_ops_control_center_tenant_scope_count{operator_audience_type=~\".+\"}",
        "legendFormat": "{{ operator_audience_type }}"
      }]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Isolation Posture Coverage",
      "description": "SLO: 100% tenants visible to authorized operators. Target: 1.0.",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "targets": [{
        "expr": "sum(rate(oya_ops_control_center_isolation_posture_total{visible=\"true\"}[5m])) / sum(rate(oya_ops_control_center_isolation_posture_total[5m]))",
        "legendFormat": "Coverage"
      }],
      "fieldConfig": { "defaults": { "unit": "percentunit" } }
    },
    {
      "id": 3,
      "type": "table",
      "title": "Tenant Lifecycle State Distribution",
      "description": "Distribution of tenants by lifecycle_state. Alerts on unexpected SUSPENDED or PENDING states.",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 4 },
      "targets": [{
        "expr": "sum by (lifecycle_state) (oya_ops_control_center_tenant_state_total)",
        "legendFormat": "{{ lifecycle_state }}"
      }]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Tenant Isolation Posture Freshness",
      "description": "Age of isolation posture data. SLO: ≤30s freshness floor (per ARCHITECTURE.md §ontology-read-path).",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 4 },
      "targets": [{
        "expr": "oya_ops_control_center_isolation_posture_age_seconds",
        "legendFormat": "Posture Age (s)"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": { "steps": [
            { "color": "green", "value": 0 },
            { "color": "yellow", "value": 20 },
            { "color": "red", "value": 30 }
          ]}
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Tenant Scope Violation Attempts",
      "description": "Cross-tenant pivot attempts. Zero tolerance.",
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 4 },
      "targets": [{
        "expr": "sum(rate(oya_ops_control_center_tenant_scope_violations_total[5m]))",
        "legendFormat": "Violations/s"
      }]
    },
    {
      "id": 6,
      "type": "table",
      "title": "Evidence Pack Freshness by Tenant",
      "description": "Age of last evidence-pack export per tenant. SLO: ≤24h (86400s). Alert on stale packs.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "targets": [{
        "expr": "topk(20, oya_ops_control_center_evidence_pack_age_seconds) by (tenant_id)",
        "legendFormat": "{{ tenant_id }}"
      }],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 7,
      "type": "table",
      "title": "Tenant Quota Utilization",
      "description": "Quota utilization by tenant (% of limit). Alert at 80%.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "targets": [{
        "expr": "topk(20, oya_ops_control_center_tenant_quota_utilization_ratio) by (tenant_id, quota_class)",
        "legendFormat": "{{ tenant_id }} / {{ quota_class }}"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": { "steps": [
            { "color": "green", "value": 0 },
            { "color": "yellow", "value": 0.8 },
            { "color": "red", "value": 0.95 }
          ]}
        }
      }
    }
  ]
}
