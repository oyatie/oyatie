# Buck2 build targets for oya-identity.
# Single-crate hyperscaler pattern per ADR-0509.
# TODO(ADR-0392): single rust_binary target

rust_binary(
    name = "oya-identity",
    srcs = glob(["src/**/*.rs", "migrations/**/*.sql", "**/*.cedar", "**/*.sql", "**/*.json", "**/*.toml", "**/*.yaml", "**/*.yml", "**/*.proto", "**/*.graphql", "**/*.html", "**/*.css", "**/*.txt"], allow_empty = True),
    visibility = ["PUBLIC"],
)

alias(
    name = "check",
    actual = ":oya-identity",
)

alias(
    name = "test",
    actual = ":oya-identity",
)

alias(
    name = "image",
    actual = ":oya-identity",
)
