{
  "$schema": "https://schemas.grafana.com/dashboard.json",
  "_meta": {
    "doc_class": "GrafanaDashboard",
    "microservice": "payments",
    "owner_team": "ops-sre-reliability + axis-payments",
    "audience": "internal operators (cross-PSP view; admin RBAC)",
    "tenant_scoped": false,
    "datasource": "Mimir aggregate"
  },
  "uid": "payments-psp-routing",
  "title": "PSP Routing — per-PSP success / failure",
  "tags": ["payments", "psp", "routing"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-24h", "to": "now"},
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "PSPs healthy",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "count(sum by (psp) (rate(payments_charge_total{outcome=\"captured\"}[5m])) / sum by (psp) (rate(payments_charge_total[5m])) > 0.99)", "refId": "A"}]
    },
    {
      "id": 2,
      "type": "table",
      "title": "PSP status snapshot",
      "gridPos": {"x": 6, "y": 0, "w": 18, "h": 8},
      "targets": [{"expr": "sum by (psp) (rate(payments_charge_total[5m])) / on(psp) sum by (psp) (rate(payments_charge_total[5m]))", "refId": "A"}]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Stripe — success-rate (24h)",
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 6},
      "targets": [{"expr": "sum(rate(payments_charge_total{psp=\"stripe\",outcome=\"captured\"}[5m])) / sum(rate(payments_charge_total{psp=\"stripe\"}[5m]))", "refId": "A"}]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Adyen — success-rate (24h)",
      "gridPos": {"x": 12, "y": 8, "w": 12, "h": 6},
      "targets": [{"expr": "sum(rate(payments_charge_total{psp=\"adyen\",outcome=\"captured\"}[5m])) / sum(rate(payments_charge_total{psp=\"adyen\"}[5m]))", "refId": "A"}]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Toss + KakaoPay (KR) — success-rate (24h)",
      "gridPos": {"x": 0, "y": 14, "w": 12, "h": 6},
      "targets": [{"expr": "sum(rate(payments_charge_total{psp=~\"toss|kakaopay\",outcome=\"captured\"}[5m])) / sum(rate(payments_charge_total{psp=~\"toss|kakaopay\"}[5m]))", "refId": "A"}]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "LINE Pay + WeChat + Alipay (Asia-Pacific) — success-rate (24h)",
      "gridPos": {"x": 12, "y": 14, "w": 12, "h": 6},
      "targets": [{"expr": "sum(rate(payments_charge_total{psp=~\"line-pay|wechat-pay|alipay\",outcome=\"captured\"}[5m])) / sum(rate(payments_charge_total{psp=~\"line-pay|wechat-pay|alipay\"}[5m]))", "refId": "A"}]
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Per-PSP latency p99",
      "gridPos": {"x": 0, "y": 20, "w": 24, "h": 8},
      "targets": [{"expr": "histogram_quantile(0.99, sum by (psp, le)(rate(payments_charge_latency_ms_bucket[5m])))", "refId": "A"}]
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Fallback-PSP activation rate (charges)",
      "gridPos": {"x": 0, "y": 28, "w": 12, "h": 8},
      "targets": [{"expr": "sum by (primary_psp, fallback_psp) (rate(payments_charge_fallback_total[5m]))", "refId": "A"}]
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "Cross-PSP webhook ingestion rate",
      "gridPos": {"x": 12, "y": 28, "w": 12, "h": 8},
      "targets": [{"expr": "sum by (psp) (rate(payments_webhook_received_total[5m]))", "refId": "A"}]
    }
  ]
}
