{
  "$schema": "https://grafana.com/api/dashboards/json-schema",
  "title": "identity — Passkey Funnel",
  "uid": "identity-passkey-funnel",
  "tags": ["identity", "passkey", "webauthn", "funnel"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-24h", "to": "now" },
  "templating": {
    "list": [
      { "name": "pack", "type": "custom", "label": "Pack", "options": [{ "text": "eu", "value": "eu", "selected": true }] }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Register → Authenticate funnel",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 },
      "targets": [
        { "expr": "sum(rate(oya_identity_webauthn_register_total{pack=\"$pack\",stage=\"start\"}[1h]))", "legendFormat": "Register start" },
        { "expr": "sum(rate(oya_identity_webauthn_register_total{pack=\"$pack\",stage=\"finish\",outcome=\"success\"}[1h]))", "legendFormat": "Register finish" },
        { "expr": "sum(rate(oya_identity_webauthn_authenticate_total{pack=\"$pack\",stage=\"start\"}[1h]))", "legendFormat": "Auth start" },
        { "expr": "sum(rate(oya_identity_webauthn_authenticate_total{pack=\"$pack\",stage=\"finish\",outcome=\"success\"}[1h]))", "legendFormat": "Auth finish" }
      ]
    },
    {
      "id": 2,
      "title": "Conditional UI adoption (% of auth-start with mediation=conditional)",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "100 * sum(rate(oya_identity_webauthn_authenticate_total{pack=\"$pack\",stage=\"start\",mediation=\"conditional\"}[1h])) / sum(rate(oya_identity_webauthn_authenticate_total{pack=\"$pack\",stage=\"start\"}[1h]))"
        }
      ]
    },
    {
      "id": 3,
      "title": "AAGUID distribution (top 10)",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "targets": [
        { "expr": "topk(10, sum(oya_identity_webauthn_credential_total{pack=\"$pack\"}) by (aaguid))" }
      ]
    },
    {
      "id": 4,
      "title": "Sign-count regression events (last 24h)",
      "type": "stat",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "targets": [
        { "expr": "sum(increase(oya_identity_webauthn_sign_count_regression_total{pack=\"$pack\"}[24h]))" }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "title": "Cross-device (caBLE) success rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        { "expr": "100 * sum(rate(oya_identity_webauthn_authenticate_total{pack=\"$pack\",transport=\"hybrid\",outcome=\"success\"}[5m])) / sum(rate(oya_identity_webauthn_authenticate_total{pack=\"$pack\",transport=\"hybrid\"}[5m]))" }
      ]
    },
    {
      "id": 6,
      "title": "Backup-eligible credential ratio",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        { "expr": "100 * sum(oya_identity_webauthn_credential_total{pack=\"$pack\",backup_eligible=\"true\"}) / sum(oya_identity_webauthn_credential_total{pack=\"$pack\"})" }
      ]
    }
  ]
}
