  "workload_identity_design": {
    "bounded_context": "workload-identity",
    "description": "Machine-to-machine workload identity + Cedar PARC authorization design package (ADR-0002 task T3): ring OIDC/JWS token validation, WorkloadPrincipal lifecycle, and a swap-in Cedar PDP. Distinct from the human-identity surface.",
    "crates": [
      "oya-identity-workload-domain",
      "oya-identity-workload-oidc-adapter",
      "oya-identity-workload-authz-cedar-adapter"
    ],
    "adrs": [
      "ADR-0002",
      "ADR-0131",
      "ADR-0183"
    ],
    "adrs_note": "The genuinely-governing ADRs for this design are recorded here: ADR-0002 (tenant-and-identity-kernel, the source_adr in the workload crate catalog records), ADR-0131 (flat per-microservice layout), and ADR-0183 (Cedar+Kyverno policy-engine separation). The wave-task placeholder ids ADR-0370/0371/0372 were NOT adopted because the existing docs/decisions ADR-0370 (Talos Apple-silicon substrate), ADR-0371 (Cloudflare tunnel access), and ADR-0372 (superseded app-shell frontend-stack ADR) do not govern workload identity/authz; claiming them would be a false citation under the honest-claims gate.",
    "regulatory_packs": [
      "eu",
      "us",
      "us-healthcare",
      "kr",
      "soc2",
      "iso27001",
      "fedramp",
      "PCI-DSS",
      "gdpr"
    ],
