    "core_signals": "rate=oya_identity_oidc_issue_total; errors=oya_identity_oidc_issue_total{error=~\".+\"}; latency=oya_identity_oidc_issue_duration_seconds; saturation=oya_identity_zitadel_postgres_pool_utilization; dashboard: dashboards/identity-overview.json panel-1",
