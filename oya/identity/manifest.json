      "prd": "microservices/identity/workload-identity/PRD.md",
      "ip": "microservices/identity/IP-001-identity-design.md",
      "contracts": {
        "openapi": "microservices/identity/contracts/identity.openapi.yaml",
        "asyncapi": "microservices/identity/contracts/identity.asyncapi.yaml",
        "proto": "microservices/identity/contracts/identity.proto"
      },
      "policy": "microservices/identity/policy/identity.cedar",
