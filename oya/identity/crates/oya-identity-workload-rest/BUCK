load("@prelude//rust:cargo_buildscript.bzl", "buildscript_run")

rust_binary(
    name = "oya-identity-workload-rest-build-script",
    srcs = ["build.rs"],
    crate = "build_script_build",
    crate_root = "build.rs",
    visibility = [],
    deps = [
        "third-party//:protoc-bin-vendored",
        "third-party//:tonic-prost-build",
    ],
)

export_file(
    name = "build.rs",
    visibility = [],
)

genrule(
    name = "oya-identity-workload-rest-manifest-dir",
    srcs = [
        ":build.rs",
        "//oya/identity/contracts/proto:workload.proto",
    ],
    out = "manifest_dir",
    cmd = "mkdir -p $OUT/contracts/proto && cp $(location :build.rs) $OUT/ && cp $(location //oya/identity/contracts/proto:workload.proto) $OUT/contracts/proto/",
)

buildscript_run(
    name = "oya-identity-workload-rest-build-script-run",
    buildscript_rule = ":oya-identity-workload-rest-build-script",
    package_name = "oya-identity-workload-rest",
    version = "0.1.0",
    manifest_dir = ":oya-identity-workload-rest-manifest-dir",
)

rust_library(
    name = "oya-identity-workload-rest",
    srcs = glob(["src/**/*.rs", "migrations/**/*.sql", "**/*.cedar", "**/*.sql", "**/*.json", "**/*.toml", "**/*.yaml", "**/*.yml", "**/*.proto", "**/*.graphql", "**/*.html", "**/*.css", "**/*.txt"]),
    crate = "oya_identity_workload_rest",
    crate_root = "src/lib.rs",
    env = {"OUT_DIR": "$(location :oya-identity-workload-rest-build-script-run[out_dir])"},
    visibility = ["PUBLIC"],
    deps = [
        "//oya/identity/crates/oya-identity-workload-api:oya-identity-workload-api",
        "//oya/identity/crates/oya-identity-workload-app:oya-identity-workload-app",
        "//oya/identity/crates/oya-identity-workload-authz-cedar-adapter:oya-identity-workload-authz-cedar-adapter",
        "//oya/identity/crates/oya-identity-workload-domain:oya-identity-workload-domain",
        "//oya/identity/crates/oya-identity-workload-oidc-adapter:oya-identity-workload-oidc-adapter",
        "third-party//:aws-lc-rs",
        "third-party//:axum",
        "third-party//:base64",
        "third-party//:http-body-util",
        "third-party//:prost",
        "third-party//:protoc-bin-vendored",
        "third-party//:serde",
        "third-party//:serde_json",
        "third-party//:tokio",
        "third-party//:tokio",
        "third-party//:tonic",
        "third-party//:tonic-prost",
        "third-party//:tonic-prost-build",
        "third-party//:tower",
        "third-party//:tower",
        "third-party//:tracing",
    ],
)
