{
  "title": "Treasury health",
  "authority": {
    "prd_ref": "specs/microservices/treasury.json",
    "scope": "preview planning inventory only",
    "non_claim": "dashboard panels are not evidence of live metrics, runtime audit-chain emission, cloud deployment, measured SLO, GA, or production readiness"
  },
  "tags": [
    "erp",
    "treasury",
    "cash-position",
    "TRM"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "benchmarks": [
    "SAP TRM Treasury and Risk Management",
    "Oracle Fusion Cash Management",
    "Workday Financial Management cash and treasury counterpart",
    "NetSuite Cash Management",
    "Microsoft Dynamics 365 Finance Cash and Bank"
  ],
  "panels": [
    {
      "title": "cash-position command rate",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(oya_treasury_cash_position_commands_total[5m])) by (tenant_id)"
        }
      ]
    },
    {
      "title": "cash-position p99 latency",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(oya_treasury_cash_position_latency_seconds_bucket[5m])) by (le, tenant_id))"
        }
      ]
    },
    {
      "title": "cash-position audit events",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(rate(audit_events_total{service=\"treasury\",bounded_context=\"cash-position\"}[5m]))"
        }
      ]
    }
  ]
}
