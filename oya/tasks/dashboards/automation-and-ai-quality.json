{
  "$schema": "https://schemas.grafana.com/dashboard.json",
  "_meta": {
    "doc_class": "GrafanaDashboard",
    "microservice": "tasks",
    "owner_team": "axis-tasks + council-privacy + foundry-runtime",
    "audience": "axis-tasks + council-privacy + regional AI-risk notified body + EEOC bias auditor",
    "tenant_scoped": true,
    "datasource": "per-pack Mimir; tenant-scoped via X-Scope-OrgID",
    "purpose": "Automation + AI capability quality + employment-context high-risk auto-decision fairness monitoring per ADR-TASKS-0006"
  },
  "uid": "tasks-automation-ai-quality",
  "title": "tasks: automation + AI quality (T0/T1/T2 + regional AI-risk + EEOC fairness)",
  "tags": ["tasks", "ai", "automation", "eu-ai-act", "eeoc", "fairness"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "60s",
  "time": {"from": "now-7d", "to": "now"},
  "templating": {
    "list": [
      {"name": "pack", "type": "custom", "label": "Pack",
        "options": [
          {"text": "pack-kr", "value": "kr", "selected": true},
          {"text": "pack-eu", "value": "eu"},
          {"text": "pack-us", "value": "us"},
          {"text": "pack-us-healthcare", "value": "us-hc"},
          {"text": "pack-jp", "value": "jp"}
        ]},
      {"name": "tenant", "type": "query", "label": "Tenant",
        "query": "label_values(oya_tasks_ai_invocation_total{pack=\"$pack\"}, tenant_id)"},
      {"name": "capability", "type": "custom", "label": "Capability",
        "options": [
          {"text": "T0-next-task-suggest", "value": "t0-next"},
          {"text": "T0-priority-suggest", "value": "t0-priority"},
          {"text": "T1-auto-categorise", "value": "t1-categorise"},
          {"text": "T1-priority-bulk-apply", "value": "t1-bulk-priority"},
          {"text": "T2-auto-assign", "value": "t2-auto-assign", "selected": true},
          {"text": "T2-status-auto-advance", "value": "t2-status-advance"},
          {"text": "T2-recurrence-materialise", "value": "t2-recurrence"}
        ]}
    ]
  },
  "panels": [
    {"id": 1, "type": "stat", "title": "AI invocations/sec (selected capability)",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "sum(rate(oya_tasks_ai_invocation_total{pack=\"$pack\",tenant_id=\"$tenant\",capability=\"$capability\"}[5m]))", "refId": "A"}]},

    {"id": 2, "type": "stat", "title": "AI fallback rate (capability)",
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "sum(rate(oya_tasks_ai_fallback_total{pack=\"$pack\",tenant_id=\"$tenant\",capability=\"$capability\"}[5m])) / sum(rate(oya_tasks_ai_invocation_total{pack=\"$pack\",tenant_id=\"$tenant\",capability=\"$capability\"}[5m]))", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "thresholds": {"mode": "absolute", "steps": [{"value": null, "color": "green"}, {"value": 0.05, "color": "yellow"}, {"value": 0.20, "color": "red"}]}}}},

    {"id": 3, "type": "stat", "title": "T1/T2 reversibility-window cancels (selected capability)",
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "sum(rate(oya_tasks_ai_reversibility_cancel_total{pack=\"$pack\",tenant_id=\"$tenant\",capability=\"$capability\"}[5m]))", "refId": "A"}]},

    {"id": 4, "type": "stat", "title": "**T2 auto-assign fairness (min per-protected-class accept-rate; ≥0.8 required)**",
      "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "min(oya_tasks_auto_assign_fairness_score{pack=\"$pack\",tenant_id=\"$tenant\"})", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "none", "thresholds": {"mode": "absolute", "steps": [{"value": null, "color": "red"}, {"value": 0.8, "color": "green"}]}}}},

    {"id": 5, "type": "timeseries", "title": "AI invocations by capability (last 7d)",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum by (capability) (rate(oya_tasks_ai_invocation_total{pack=\"$pack\",tenant_id=\"$tenant\"}[5m]))", "legendFormat": "{{capability}}", "refId": "A"}
      ]},

    {"id": 6, "type": "timeseries", "title": "**T2 auto-assign per-protected-class fairness (7d trailing)**",
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
      "targets": [
        {"expr": "oya_tasks_auto_assign_fairness_score{pack=\"$pack\",tenant_id=\"$tenant\"}", "legendFormat": "{{protected_class}}", "refId": "A"},
        {"expr": "0.8", "legendFormat": "EEOC 4/5 threshold", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"unit": "none"}}},

    {"id": 7, "type": "timeseries", "title": "Cedar refusal counts (T2 in employment-context REFUSED per pack)",
      "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum by (pack, context_kind) (rate(oya_tasks_cedar_refusal_total{capability=~\"t2.*\",refusal_reason=~\"high_risk_auto_decision|employment_context|fairness_audit_pending\"}[5m]))", "legendFormat": "refused {{pack}} {{context_kind}}", "refId": "A"}
      ]},

    {"id": 8, "type": "timeseries", "title": "AI invocation latency p99 (selected capability)",
      "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8},
      "targets": [
        {"expr": "histogram_quantile(0.99, sum by (le) (rate(oya_tasks_ai_invocation_seconds_bucket{pack=\"$pack\",tenant_id=\"$tenant\",capability=\"$capability\"}[5m])))", "legendFormat": "p99 (s)", "refId": "A"}
      ]},

    {"id": 9, "type": "table", "title": "Recent T2 auto-assign decisions (last 1h; for audit replay)",
      "gridPos": {"x": 0, "y": 20, "w": 24, "h": 8},
      "targets": [
        {"expr": "topk(20, oya_tasks_t2_auto_assign_decision_count{pack=\"$pack\",tenant_id=\"$tenant\"})", "format": "table", "refId": "A"}
      ]},

    {"id": 10, "type": "stat", "title": "AI rollback events (last 7d) — should be 0 (Sev-1 if > 0)",
      "gridPos": {"x": 0, "y": 28, "w": 12, "h": 4},
      "targets": [{"expr": "sum(increase(oya_tasks_ai_classifier_rollback_total{pack=\"$pack\"}[7d]))", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "thresholds": {"mode": "absolute", "steps": [{"value": null, "color": "green"}, {"value": 1, "color": "red"}]}}}},

    {"id": 11, "type": "stat", "title": "regional AI-risk Art. 73 incident notifications (last 7d)",
      "gridPos": {"x": 12, "y": 28, "w": 12, "h": 4},
      "targets": [{"expr": "sum(increase(oya_tasks_eu_ai_act_art_73_notification_total{pack=\"pack-eu\"}[7d]))", "refId": "A"}]}
  ],
  "annotations": {
    "list": [
      {"name": "model-promotion", "datasource": "argo-rollouts", "iconColor": "purple", "query": "{microservice=\"tasks\",capability=~\"t.*\"}"},
      {"name": "ai-rollback", "datasource": "prometheus", "iconColor": "red", "expr": "changes(oya_tasks_ai_classifier_rollback_total[1h]) > 0"},
      {"name": "fairness-audit", "datasource": "prometheus", "iconColor": "blue", "expr": "changes(oya_tasks_fairness_audit_completed_total[7d]) > 0"}
    ]
  }
}
