{
  "schemaVersion": 39,
  "title": "Design Collaboration local slo burn",
  "tags": [
    "design-collaboration",
    "local-operational-primitive",
    "adr-0130"
  ],
  "timezone": "utc",
  "templating": {
    "list": [
      {
        "name": "tenant_id",
        "type": "query",
        "query": "label_values(oya_design_collaboration_file_load_time_total, tenant_id)"
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Design file load time burn",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(rate(oya_design_collaboration_file_load_time_good_total[5m])) by (tenant_id, cell_tier) / sum(rate(oya_design_collaboration_file_load_time_total[5m])) by (tenant_id, cell_tier)",
          "legendFormat": "file-load-time ratio"
        }
      ]
    },
    {
      "id": 2,
      "title": "Design version save latency burn",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(oya_design_collaboration_version_save_latency_good_total[5m])) by (tenant_id, cell_tier) / sum(rate(oya_design_collaboration_version_save_latency_total[5m])) by (tenant_id, cell_tier)",
          "legendFormat": "version-save-latency ratio"
        }
      ]
    },
    {
      "id": 3,
      "title": "Comment thread sync latency burn",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(rate(oya_design_collaboration_comment_sync_latency_good_total[5m])) by (tenant_id, cell_tier) / sum(rate(oya_design_collaboration_comment_sync_latency_total[5m])) by (tenant_id, cell_tier)",
          "legendFormat": "comment-sync-latency ratio"
        }
      ]
    },
    {
      "id": 4,
      "title": "Design handoff exports completed burn",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(oya_design_collaboration_design_handoff_export_good_total[30d])) by (tenant_id, cell_tier) / sum(rate(oya_design_collaboration_design_handoff_export_total[30d])) by (tenant_id, cell_tier)",
          "legendFormat": "design-handoff-export ratio"
        }
      ]
    },
    {
      "id": 5,
      "title": "Permission checks complete before file access burn",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(rate(oya_design_collaboration_permission_check_latency_good_total[5m])) by (tenant_id, cell_tier) / sum(rate(oya_design_collaboration_permission_check_latency_total[5m])) by (tenant_id, cell_tier)",
          "legendFormat": "permission-check-latency ratio"
        }
      ]
    },
    {
      "id": 6,
      "title": "Asset previews rendered for active files burn",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(oya_design_collaboration_asset_preview_render_good_total[5m])) by (tenant_id, cell_tier) / sum(rate(oya_design_collaboration_asset_preview_render_total[5m])) by (tenant_id, cell_tier)",
          "legendFormat": "asset-preview-render ratio"
        }
      ]
    }
  ]
}
