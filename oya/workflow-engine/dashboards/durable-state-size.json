{
  "$schema": "https://schemas.grafana.com/dashboard.json",
  "_meta": {
    "doc_class": "GrafanaDashboard",
    "microservice": "workflow-engine",
    "owner_team": "ops-sre-reliability + axis-workflow + ops-finops",
    "audience": "internal operators + FinOps",
    "tenant_scoped": false,
    "datasource": "Mimir per-pack endpoints"
  },
  "uid": "wf-engine-durable-state-size",
  "title": "Workflow Engine — Durable State Size (Postgres + ClickHouse + Object Storage)",
  "tags": ["workflow-engine", "operator", "finops", "storage"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5m",
  "time": {"from": "now-7d", "to": "now"},
  "templating": {
    "list": [
      {
        "name": "pack",
        "type": "custom",
        "options": [
          {"text": "pack-kr", "value": "kr", "selected": true},
          {"text": "pack-eu", "value": "eu"},
          {"text": "pack-us", "value": "us"},
          {"text": "pack-us-healthcare", "value": "us-hc"},
          {"text": "pack-jp", "value": "jp"},
          {"text": "pack-sg", "value": "sg"},
          {"text": "pack-au", "value": "au"},
          {"text": "pack-in", "value": "in"},
          {"text": "pack-br", "value": "br"},
          {"text": "pack-ae", "value": "ae"},
          {"text": "pack-ksa", "value": "ksa"}
        ],
        "label": "Pack"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Postgres + Citus storage (GB)",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "sum(pg_database_size_bytes{pack=\"$pack\",database=\"workflow_engine\"}) / 1024 / 1024 / 1024",
          "legendFormat": "total (GB)",
          "refId": "A"
        },
        {
          "expr": "sum by (table) (pg_relation_size_bytes{pack=\"$pack\",database=\"workflow_engine\"}) / 1024 / 1024 / 1024",
          "legendFormat": "{{table}} (GB)",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "decgbytes"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "ClickHouse run-history replica (GB)",
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "sum(clickhouse_table_size_bytes{pack=\"$pack\",database=\"workflow_engine_analytics\"}) / 1024 / 1024 / 1024",
          "legendFormat": "total (GB)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "decgbytes"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Object storage (large step payloads, GB)",
      "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "sum(oci_objectstorage_bucket_size_bytes{pack=\"$pack\",bucket=\"workflow-engine-payloads\"}) / 1024 / 1024 / 1024",
          "legendFormat": "{{bucket}} (GB)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "decgbytes"
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Per-tenant storage (top 10)",
      "gridPos": {"x": 0, "y": 24, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "topk(10, sum by (tenant_id) (pg_relation_size_bytes_per_tenant{pack=\"$pack\",database=\"workflow_engine\"}) / 1024 / 1024 / 1024)",
          "legendFormat": "{{tenant_id}} (GB)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Daily growth rate (GB/day)",
      "gridPos": {"x": 0, "y": 32, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "deriv(sum(pg_database_size_bytes{pack=\"$pack\",database=\"workflow_engine\"})[1d:1h]) * 86400 / 1024 / 1024 / 1024",
          "legendFormat": "Postgres growth (GB/day)",
          "refId": "A"
        },
        {
          "expr": "deriv(sum(clickhouse_table_size_bytes{pack=\"$pack\",database=\"workflow_engine_analytics\"})[1d:1h]) * 86400 / 1024 / 1024 / 1024",
          "legendFormat": "ClickHouse growth (GB/day)",
          "refId": "B"
        }
      ]
    }
  ]
}
