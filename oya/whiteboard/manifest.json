  "layer": "rest",
  "doc_class": "Machine-Readable-Spec",
  "capacity_model": {
    "baseline_cpu_per_tenant": 0.12,
    "baseline_ram_per_tenant": 384,
    "storage_per_tenant": 8,
    "connections_per_tenant": {
      "valkey": 3,
      "postgres": 2,
      "outbound_http": 4
    },
    "scaling_dimension": "per_user",
    "cell_placement_class": "Tier-3",
    "notes": "Low-latency board presence, canvas operation append, history snapshots, exports, and template installs scale with active collaborators."
  },
  "sharding_automation": {
    "autosharding": "control_plane_driven",
    "auto_rebalance": {
