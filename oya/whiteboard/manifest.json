    "demo_trial",
    "paid"
  ],
  "packs": [
    "soc2",
    "iso27001",
    "gdpr",
    "kr-pipa",
    "education",
    "public-sector",
    "hipaa"
  ],
  "hyperscaler_benchmark": "Miro; Mural; Figma FigJam; Lucid; Lucid. The operational reason for a dedicated flat microservice is: low-latency multi-user canvas operations; board history",
  "owner_team": "axis-whiteboard + council-product",
  "tier_classification": "product / b2b-leader-operational-concern",
  "data_classification": "tenant-scoped operational records with audit evidence",
  "compliance_packs_applicable": [
    "soc2",
    "iso27001",
    "gdpr",
    "kr-pipa",
    "education",
    "public-sector",
    "hipaa"
