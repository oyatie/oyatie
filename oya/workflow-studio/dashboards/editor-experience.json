{
  "$schema": "https://schemas.grafana.com/dashboard.json",
  "_meta": {
    "doc_class": "GrafanaDashboard",
    "microservice": "workflow-studio",
    "owner_team": "axis-workflow + council-design-system + ops-sre-reliability",
    "audience": "internal operators + axis-workflow product owners",
    "tenant_scoped": false,
    "datasource": "Mimir aggregate (oya-workflow-studio tenant) + per-pack Mimir endpoints"
  },
  "uid": "studio-editor-experience",
  "title": "Workflow Studio — Editor Experience (TTI / render / save)",
  "tags": ["workflow-studio", "editor", "perf"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "templating": {
    "list": [
      {
        "name": "pack",
        "type": "custom",
        "options": [
          {"text": "pack-kr", "value": "kr", "selected": true},
          {"text": "pack-eu", "value": "eu"},
          {"text": "pack-us", "value": "us"},
          {"text": "pack-us-healthcare", "value": "us-hc"},
          {"text": "pack-jp", "value": "jp"},
          {"text": "pack-sg", "value": "sg"},
          {"text": "pack-au", "value": "au"},
          {"text": "pack-in", "value": "in"},
          {"text": "pack-br", "value": "br"},
          {"text": "pack-ae", "value": "ae"},
          {"text": "pack-ksa", "value": "ksa"}
        ],
        "label": "Pack"
      },
      {
        "name": "tenant",
        "type": "query",
        "datasource": "Mimir",
        "query": "label_values(oya_workflow_studio_editor_session_open_total, tenant_id)",
        "includeAll": true,
        "label": "Tenant"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Editor TTI cold (p99) vs 2s GA budget",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "targets": [
        {"expr": "histogram_quantile(0.99, sum by (le, pack) (rate(oya_workflow_studio_editor_tti_seconds_bucket{pack=\"$pack\"}[5m])))", "legendFormat": "TTI p99 — {{pack}}", "refId": "A"},
        {"expr": "vector(2.0)", "legendFormat": "GA budget (2s)", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 2.0}, {"color": "red", "value": 5.0}]}}}
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Canvas render p95 vs 16ms (60fps) budget",
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
      "targets": [
        {"expr": "histogram_quantile(0.95, sum by (le, pack) (rate(oya_workflow_studio_canvas_render_seconds_bucket{pack=\"$pack\"}[5m])))", "legendFormat": "render p95 — {{pack}}", "refId": "A"},
        {"expr": "vector(0.016)", "legendFormat": "60fps budget (16ms)", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"unit": "s"}}
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Save round-trip p99 vs 100ms (GA) / 200ms (stable)",
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
      "targets": [
        {"expr": "histogram_quantile(0.99, sum by (le, pack) (rate(oya_workflow_studio_save_round_trip_seconds_bucket{pack=\"$pack\"}[5m])))", "legendFormat": "save p99 — {{pack}}", "refId": "A"},
        {"expr": "vector(0.1)", "legendFormat": "GA budget (100ms)", "refId": "B"},
        {"expr": "vector(0.2)", "legendFormat": "stable budget (200ms)", "refId": "C"}
      ],
      "fieldConfig": {"defaults": {"unit": "s"}}
    },
    {
      "id": 4,
      "type": "table",
      "title": "Save round-trip breakdown (engine spec-store vs Postgres vs audit-chain)",
      "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
      "targets": [
        {"expr": "topk(20, histogram_quantile(0.99, sum by (le, leg) (rate(oya_workflow_studio_save_leg_seconds_bucket{pack=\"$pack\"}[5m]))))", "format": "table", "refId": "A"}
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Active editor sessions by pack",
      "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum by (pack) (oya_workflow_studio_editor_session_active{pack=\"$pack\"})", "legendFormat": "{{pack}}", "refId": "A"}
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Per-tenant active sessions (top 10)",
      "gridPos": {"x": 12, "y": 16, "w": 12, "h": 8},
      "targets": [
        {"expr": "topk(10, sum by (tenant_id) (oya_workflow_studio_editor_session_active{pack=\"$pack\"}))", "legendFormat": "{{tenant_id}}", "refId": "A"}
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Editor TTI / FCP / LCP breakdown",
      "gridPos": {"x": 0, "y": 24, "w": 12, "h": 8},
      "targets": [
        {"expr": "histogram_quantile(0.99, sum by (le, web_vital) (rate(oya_workflow_studio_web_vital_seconds_bucket{pack=\"$pack\"}[5m])))", "legendFormat": "{{web_vital}} p99", "refId": "A"}
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "WASM bundle download p99 + CDN edge cache hit rate",
      "gridPos": {"x": 12, "y": 24, "w": 12, "h": 8},
      "targets": [
        {"expr": "histogram_quantile(0.99, sum by (le) (rate(oya_workflow_studio_wasm_bundle_download_seconds_bucket{pack=\"$pack\"}[5m])))", "legendFormat": "download p99", "refId": "A"},
        {"expr": "sum(rate(oya_workflow_studio_cdn_cache_hit_total{pack=\"$pack\"}[5m])) / sum(rate(oya_workflow_studio_cdn_request_total{pack=\"$pack\"}[5m]))", "legendFormat": "CDN hit rate", "refId": "B"}
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Perf budget breaches (events) by budget",
      "gridPos": {"x": 0, "y": 32, "w": 12, "h": 8},
      "targets": [
        {"expr": "increase(oya_workflow_studio_perf_budget_breached_total{pack=\"$pack\"}[5m])", "legendFormat": "{{budget}}", "refId": "A"}
      ]
    },
    {
      "id": 10,
      "type": "table",
      "title": "Editor 429 rate by tenant (rate-limit hits)",
      "gridPos": {"x": 12, "y": 32, "w": 12, "h": 8},
      "targets": [
        {"expr": "topk(20, rate(oya_workflow_studio_editor_session_429_total{pack=\"$pack\"}[5m]))", "format": "table", "refId": "A"}
      ]
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Round-trip byte-equality rate (load(emit(x)) == x)",
      "gridPos": {"x": 0, "y": 40, "w": 12, "h": 4},
      "targets": [
        {"expr": "sum(rate(oya_workflow_studio_round_trip_byte_equal_total{pack=\"$pack\"}[1h])) / sum(rate(oya_workflow_studio_round_trip_total{pack=\"$pack\"}[1h]))", "legendFormat": "byte-equality rate", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0.99, "max": 1.0, "thresholds": {"steps": [{"color": "red", "value": 0}, {"color": "yellow", "value": 0.999}, {"color": "green", "value": 1.0}]}}}
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Cold-load of 5k-node graph (budget ≤ 3s)",
      "gridPos": {"x": 12, "y": 40, "w": 12, "h": 4},
      "targets": [
        {"expr": "histogram_quantile(0.99, sum by (le) (rate(oya_workflow_studio_cold_load_5k_seconds_bucket{pack=\"$pack\"}[5m])))", "legendFormat": "cold-load p99", "refId": "A"},
        {"expr": "vector(3.0)", "legendFormat": "budget (3s)", "refId": "B"}
      ]
    }
  ]
}
