{
  "$schema": "https://schemas.grafana.com/dashboard.json",
  "_meta": {
    "doc_class": "GrafanaDashboard",
    "microservice": "workflow-studio",
    "owner_team": "axis-workflow + foundry-providers-team + council-privacy",
    "audience": "internal operators + axis-workflow + council-privacy + AI Act regulator on request",
    "tenant_scoped": false,
    "datasource": "Mimir aggregate (oya-workflow-studio tenant + foundry-providers tenant cross-aggregate)"
  },
  "uid": "studio-copilot-quality",
  "title": "Workflow Studio — LLM Copilot Quality + Safety",
  "tags": ["workflow-studio", "llm-assist", "ai-act", "safety"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "60s",
  "time": {"from": "now-24h", "to": "now"},
  "templating": {
    "list": [
      {
        "name": "pack",
        "type": "custom",
        "options": [
          {"text": "pack-kr", "value": "kr", "selected": true},
          {"text": "pack-eu", "value": "eu"},
          {"text": "pack-us", "value": "us"},
          {"text": "pack-us-healthcare", "value": "us-hc"},
          {"text": "pack-jp", "value": "jp"},
          {"text": "pack-sg", "value": "sg"},
          {"text": "pack-au", "value": "au"},
          {"text": "pack-in", "value": "in"},
          {"text": "pack-br", "value": "br"},
          {"text": "pack-ae", "value": "ae"},
          {"text": "pack-ksa", "value": "ksa"}
        ]
      },
      {
        "name": "provider",
        "type": "query",
        "datasource": "Mimir",
        "query": "label_values(oya_workflow_studio_llm_assist_request_total, provider_routed)",
        "label": "LLM Provider",
        "includeAll": true
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Schema-valid completion rate (target ≥ 80%)",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "targets": [
        {"expr": "sum(rate(oya_workflow_studio_llm_assist_response_schema_valid_total{pack=\"$pack\"}[1h])) / sum(rate(oya_workflow_studio_llm_assist_response_total{pack=\"$pack\"}[1h]))", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "percentunit", "thresholds": {"steps": [{"color": "red", "value": 0}, {"color": "yellow", "value": 0.7}, {"color": "green", "value": 0.8}]}}}
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Human-accept rate (proxy for quality)",
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
      "targets": [
        {"expr": "sum(rate(oya_workflow_studio_llm_assist_draft_accepted_total{pack=\"$pack\"}[1h])) / sum(rate(oya_workflow_studio_llm_assist_draft_requested_total{pack=\"$pack\"}[1h]))", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "percentunit"}}
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Prompt injection detected (MUST be near-zero of total)",
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
      "targets": [
        {"expr": "sum(rate(oya_workflow_studio_llm_assist_prompt_injection_detected_total{pack=\"$pack\"}[1h]))", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 0.001}, {"color": "red", "value": 0.01}]}}}
    },
    {
      "id": 4,
      "type": "stat",
      "title": "PII redacted token count (per invocation avg)",
      "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
      "targets": [
        {"expr": "sum(rate(oya_workflow_studio_llm_assist_pii_redacted_tokens_total{pack=\"$pack\"}[1h])) / sum(rate(oya_workflow_studio_llm_assist_request_total{pack=\"$pack\"}[1h]))", "refId": "A"}
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "LLM-assist latency p99 (target ≤ 3s GA)",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "targets": [
        {"expr": "histogram_quantile(0.99, sum by (le, provider_routed) (rate(oya_workflow_studio_llm_assist_latency_seconds_bucket{pack=\"$pack\",provider_routed=~\"$provider\"}[5m])))", "legendFormat": "{{provider_routed}} p99", "refId": "A"},
        {"expr": "vector(3.0)", "legendFormat": "GA budget (3s)", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"unit": "s"}}
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "LLM-assist latency breakdown (PII redactor + LLM + schema validation)",
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
      "targets": [
        {"expr": "histogram_quantile(0.99, sum by (le, leg) (rate(oya_workflow_studio_llm_assist_leg_seconds_bucket{pack=\"$pack\"}[5m])))", "legendFormat": "{{leg}} p99", "refId": "A"}
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Validation failures by JSON-pointer (top 10)",
      "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
      "targets": [
        {"expr": "topk(10, sum by (json_pointer) (rate(oya_workflow_studio_llm_assist_validation_error_total{pack=\"$pack\"}[1h])))", "legendFormat": "{{json_pointer}}", "refId": "A"}
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Circuit breaker state + open events",
      "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8},
      "targets": [
        {"expr": "oya_workflow_studio_llm_assist_circuit_breaker_state{pack=\"$pack\"}", "legendFormat": "{{tenant_id}} state", "refId": "A"},
        {"expr": "increase(oya_workflow_studio_llm_assist_circuit_breaker_open_total{pack=\"$pack\"}[5m])", "legendFormat": "open events", "refId": "B"}
      ]
    },
    {
      "id": 9,
      "type": "table",
      "title": "Per-tenant invocation count + consent rate (24h)",
      "gridPos": {"x": 0, "y": 20, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum by (tenant_id) (increase(oya_workflow_studio_llm_assist_request_total{pack=\"$pack\"}[24h]))", "format": "table", "refId": "A"},
        {"expr": "sum by (tenant_id) (increase(oya_workflow_studio_llm_assist_consent_acknowledged_total{pack=\"$pack\"}[24h])) / sum by (tenant_id) (increase(oya_workflow_studio_llm_assist_request_total{pack=\"$pack\"}[24h]))", "format": "table", "refId": "B"}
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "LLM-assist refused at redactor (prompt injection / consent missing)",
      "gridPos": {"x": 12, "y": 20, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum by (reason) (rate(oya_workflow_studio_llm_assist_request_refused_total{pack=\"$pack\"}[5m]))", "legendFormat": "{{reason}}", "refId": "A"}
      ]
    },
    {
      "id": 11,
      "type": "stat",
      "title": "AI Act compliance — transparency obligation acknowledged rate (pack-eu)",
      "gridPos": {"x": 0, "y": 28, "w": 12, "h": 4},
      "targets": [
        {"expr": "sum(rate(oya_workflow_studio_llm_assist_transparency_ack_total{pack=\"eu\"}[24h])) / sum(rate(oya_workflow_studio_llm_assist_response_total{pack=\"eu\"}[24h]))", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "percentunit", "thresholds": {"steps": [{"color": "red", "value": 0}, {"color": "yellow", "value": 0.95}, {"color": "green", "value": 0.999}]}}}
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Audit-chain seal coverage (LLM-assist invocations)",
      "gridPos": {"x": 12, "y": 28, "w": 12, "h": 4},
      "targets": [
        {"expr": "sum(rate(oya_workflow_studio_llm_assist_audit_chain_sealed_total{pack=\"$pack\"}[1h])) / sum(rate(oya_workflow_studio_llm_assist_request_total{pack=\"$pack\"}[1h]))", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "percentunit", "thresholds": {"steps": [{"color": "red", "value": 0}, {"color": "yellow", "value": 0.999}, {"color": "green", "value": 1.0}]}}}
    }
  ]
}
