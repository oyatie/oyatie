{
  "template_id": "oya-workflow-studio-template-equity-vesting-tax-event",
  "schema_version": "1.0.0",
  "name": "Equity vesting -> payroll tax event",
  "description": "Equity vesting cliff/tranche triggers FMV capture, payroll tax event (RSU income), tax withholding, ledger entry.",
  "persona": "payroll-controller",
  "vertical": "payroll-finance",
  "node_graph": {
    "entry_node": "trigger-vesting-event",
    "terminal_nodes": [
      "t-tax-event-complete"
    ],
    "nodes": [
      {
        "id": "trigger-vesting-event",
        "kind": "trigger",
        "label": "Vesting event"
      },
      {
        "id": "fmv-capture",
        "kind": "connector-call",
        "label": "Capture FMV",
        "connector": "oya-shared-connector-equity",
        "operation": "capture_fmv"
      },
      {
        "id": "tax-compute",
        "kind": "transform",
        "label": "Compute tax event"
      },
      {
        "id": "withholding",
        "kind": "connector-call",
        "label": "Sell-to-cover withholding",
        "connector": "oya-shared-connector-equity",
        "operation": "sell_to_cover"
      },
      {
        "id": "payroll-event",
        "kind": "connector-call",
        "label": "Push payroll tax event",
        "connector": "oya-shared-connector-workday",
        "operation": "post_tax_event"
      },
      {
        "id": "audit-vesting",
        "kind": "audit-emit",
        "label": "Emit vesting tax seal"
      },
      {
        "id": "t-tax-event-complete",
        "kind": "terminal",
        "label": "Tax event complete"
      }
    ],
    "edges": [
      {
        "from": "trigger-vesting-event",
        "to": "fmv-capture"
      },
      {
        "from": "fmv-capture",
        "to": "tax-compute"
      },
      {
        "from": "tax-compute",
        "to": "withholding"
      },
      {
        "from": "withholding",
        "to": "payroll-event"
      },
      {
        "from": "payroll-event",
        "to": "audit-vesting"
      },
      {
        "from": "audit-vesting",
        "to": "t-tax-event-complete"
      }
    ]
  },
  "input_parameters": [
    {
      "name": "grant_id",
      "type": "reference",
      "required": true,
      "description": "Equity grant id"
    },
    {
      "name": "vest_date",
      "type": "date",
      "required": true,
      "description": "Vest date"
    },
    {
      "name": "units_vested",
      "type": "number",
      "required": true,
      "description": "Units vested"
    }
  ],
  "runtime_expectations": {
    "expected_duration_seconds_p50": 300,
    "expected_duration_seconds_p99": 1200
  },
  "compliance_flags": [
    "soc2-type-2",
    "sox-section-404"
  ],
  "audit_emission_points": [
    {
      "node_id": "fmv-capture",
      "seal_kind": "external-call-receipt"
    },
    {
      "node_id": "withholding",
      "seal_kind": "external-call-receipt"
    },
    {
      "node_id": "audit-vesting",
      "seal_kind": "transform-attestation"
    }
  ],
  "cedar_policy": {
    "policy_id": "cedar:oya-workflow-studio-template:equity-vesting-tax-event",
    "effect": "permit",
    "principal_scope": "Workflow::Tenant",
    "resource_scope": "EquityGrant",
    "action_scope": "process_vest_tax",
    "conditions": []
  },
  "connector_dependencies": [
    {
      "connector_id": "oya-shared-connector-equity",
      "operations": [
        "capture_fmv",
        "sell_to_cover"
      ],
      "criticality": "required"
    },
    {
      "connector_id": "oya-shared-connector-workday",
      "operations": [
        "post_tax_event"
      ],
      "criticality": "required"
    }
  ],
  "slo": {
    "max_duration_seconds": 1200,
    "min_success_rate": 0.999,
    "openslo_ref": "microservices/workflow-studio/slos/oya-workflow-studio-template-equity-vesting-tax-event.openslo.yaml"
  },
  "cost_model": {
    "estimated_usd_per_execution_p50": 0.55,
    "foundry_inference_usd": 0.05,
    "connector_call_usd": 0.45,
    "storage_usd": 0.05
  },
  "test_mode_supported": true,
  "live_mode_supported": true,
  "documentation": {
    "explainer_path": "microservices/workflow-studio/templates/explainers/oya-workflow-studio-template-equity-vesting-tax-event.md",
    "fixture_path": "microservices/workflow-studio/templates/fixtures/oya-workflow-studio-template-equity-vesting-tax-event.fixture.json"
  },
  "tags": [
    "payroll",
    "equity",
    "tax",
    "sox"
  ]
}
