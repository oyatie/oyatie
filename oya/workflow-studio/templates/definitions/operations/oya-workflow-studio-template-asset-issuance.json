{
  "template_id": "oya-workflow-studio-template-asset-issuance",
  "schema_version": "1.0.0",
  "name": "Asset issuance (new hire kit)",
  "description": "Issue laptop + peripherals + accounts + access for a new hire; track shipment + first-boot enrolment.",
  "persona": "it-asset-admin",
  "vertical": "operations",
  "node_graph": {
    "entry_node": "trigger-hire-confirmed",
    "terminal_nodes": [
      "t-asset-active"
    ],
    "nodes": [
      {
        "id": "trigger-hire-confirmed",
        "kind": "trigger",
        "label": "Hire confirmed"
      },
      {
        "id": "policy-asset",
        "kind": "policy-check",
        "label": "Cedar asset-issuance policy"
      },
      {
        "id": "inventory-allocate",
        "kind": "connector-call",
        "label": "Allocate inventory",
        "connector": "oya-shared-connector-asset-management",
        "operation": "allocate_kit"
      },
      {
        "id": "ship",
        "kind": "connector-call",
        "label": "Ship kit",
        "connector": "oya-shared-connector-shipping",
        "operation": "ship_kit"
      },
      {
        "id": "mdm-enrol",
        "kind": "connector-call",
        "label": "MDM enrolment",
        "connector": "oya-shared-connector-mdm",
        "operation": "enrol_device"
      },
      {
        "id": "account-create",
        "kind": "connector-call",
        "label": "Create accounts",
        "connector": "oya-shared-connector-identity",
        "operation": "create_accounts"
      },
      {
        "id": "audit-asset",
        "kind": "audit-emit",
        "label": "Emit asset seal"
      },
      {
        "id": "t-asset-active",
        "kind": "terminal",
        "label": "Asset active"
      }
    ],
    "edges": [
      {
        "from": "trigger-hire-confirmed",
        "to": "policy-asset"
      },
      {
        "from": "policy-asset",
        "to": "inventory-allocate",
        "condition": "permit"
      },
      {
        "from": "inventory-allocate",
        "to": "ship"
      },
      {
        "from": "ship",
        "to": "mdm-enrol"
      },
      {
        "from": "mdm-enrol",
        "to": "account-create"
      },
      {
        "from": "account-create",
        "to": "audit-asset"
      },
      {
        "from": "audit-asset",
        "to": "t-asset-active"
      }
    ]
  },
  "input_parameters": [
    {
      "name": "employee_id",
      "type": "reference",
      "required": true,
      "description": "Hire ref"
    },
    {
      "name": "kit_profile",
      "type": "enum",
      "required": true,
      "enum_values": [
        "engineer",
        "designer",
        "sales",
        "ops",
        "exec"
      ],
      "description": "Kit profile"
    },
    {
      "name": "ship_address_ref",
      "type": "reference",
      "required": true,
      "description": "Ship-to address ref"
    }
  ],
  "runtime_expectations": {
    "expected_duration_seconds_p50": 86400,
    "expected_duration_seconds_p99": 259200
  },
  "compliance_flags": [
    "soc2-type-2",
    "iso-27001"
  ],
  "audit_emission_points": [
    {
      "node_id": "inventory-allocate",
      "seal_kind": "external-call-receipt"
    },
    {
      "node_id": "mdm-enrol",
      "seal_kind": "external-call-receipt"
    },
    {
      "node_id": "audit-asset",
      "seal_kind": "decision-recorded"
    }
  ],
  "cedar_policy": {
    "policy_id": "cedar:oya-workflow-studio-template:asset-issuance",
    "effect": "permit",
    "principal_scope": "Workflow::Tenant",
    "resource_scope": "Asset",
    "action_scope": "issue",
    "conditions": []
  },
  "connector_dependencies": [
    {
      "connector_id": "oya-shared-connector-asset-management",
      "operations": [
        "allocate_kit"
      ],
      "criticality": "required"
    },
    {
      "connector_id": "oya-shared-connector-shipping",
      "operations": [
        "ship_kit"
      ],
      "criticality": "required"
    },
    {
      "connector_id": "oya-shared-connector-mdm",
      "operations": [
        "enrol_device"
      ],
      "criticality": "required"
    },
    {
      "connector_id": "oya-shared-connector-identity",
      "operations": [
        "create_accounts"
      ],
      "criticality": "required"
    }
  ],
  "slo": {
    "max_duration_seconds": 259200,
    "min_success_rate": 0.998,
    "openslo_ref": "microservices/workflow-studio/slos/oya-workflow-studio-template-asset-issuance.openslo.yaml"
  },
  "cost_model": {
    "estimated_usd_per_execution_p50": 38.4,
    "foundry_inference_usd": 0.05,
    "connector_call_usd": 2.4,
    "storage_usd": 0.15
  },
  "test_mode_supported": true,
  "live_mode_supported": true,
  "documentation": {
    "explainer_path": "microservices/workflow-studio/templates/explainers/oya-workflow-studio-template-asset-issuance.md",
    "fixture_path": "microservices/workflow-studio/templates/fixtures/oya-workflow-studio-template-asset-issuance.fixture.json"
  },
  "tags": [
    "operations",
    "it",
    "asset",
    "onboarding"
  ]
}
