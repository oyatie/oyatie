{
  "template_id": "oya-workflow-studio-template-offer-esign-onboarding-handoff",
  "schema_version": "1.0.0",
  "name": "Offer letter -> e-signature -> onboarding handoff",
  "description": "Generate offer letter, comp validation, e-signature, 1-click handoff to new-hire onboarding template.",
  "persona": "recruiting-coordinator",
  "vertical": "hiring",
  "node_graph": {
    "entry_node": "trigger-offer-approved",
    "terminal_nodes": [
      "t-handoff-complete"
    ],
    "nodes": [
      {
        "id": "trigger-offer-approved",
        "kind": "trigger",
        "label": "Offer approved"
      },
      {
        "id": "policy-offer",
        "kind": "policy-check",
        "label": "Cedar offer + comp band policy"
      },
      {
        "id": "generate-offer",
        "kind": "transform",
        "label": "Generate offer letter"
      },
      {
        "id": "comp-validate",
        "kind": "policy-check",
        "label": "Validate within comp band"
      },
      {
        "id": "esign",
        "kind": "connector-call",
        "label": "Send e-signature",
        "connector": "oya-shared-connector-esign",
        "operation": "send_for_signature"
      },
      {
        "id": "wait-sign",
        "kind": "wait",
        "label": "Await signature"
      },
      {
        "id": "handoff",
        "kind": "connector-call",
        "label": "Kick off onboarding template",
        "connector": "oya-shared-connector-workflow-bus",
        "operation": "emit_event",
        "parameters": {
          "event": "offer_signed"
        }
      },
      {
        "id": "audit-offer",
        "kind": "audit-emit",
        "label": "Emit offer seal"
      },
      {
        "id": "t-handoff-complete",
        "kind": "terminal",
        "label": "Handoff complete"
      }
    ],
    "edges": [
      {
        "from": "trigger-offer-approved",
        "to": "policy-offer"
      },
      {
        "from": "policy-offer",
        "to": "generate-offer",
        "condition": "permit"
      },
      {
        "from": "generate-offer",
        "to": "comp-validate"
      },
      {
        "from": "comp-validate",
        "to": "esign",
        "condition": "within-band"
      },
      {
        "from": "esign",
        "to": "wait-sign"
      },
      {
        "from": "wait-sign",
        "to": "handoff"
      },
      {
        "from": "handoff",
        "to": "audit-offer"
      },
      {
        "from": "audit-offer",
        "to": "t-handoff-complete"
      }
    ]
  },
  "input_parameters": [
    {
      "name": "candidate_id",
      "type": "reference",
      "required": true,
      "description": "Candidate id"
    },
    {
      "name": "req_id",
      "type": "reference",
      "required": true,
      "description": "Req id"
    },
    {
      "name": "offer_base_usd",
      "type": "number",
      "required": true,
      "description": "Offer base USD"
    },
    {
      "name": "equity_units",
      "type": "number",
      "required": false,
      "description": "Equity units"
    },
    {
      "name": "start_date",
      "type": "date",
      "required": true,
      "description": "Proposed start date"
    }
  ],
  "runtime_expectations": {
    "expected_duration_seconds_p50": 259200,
    "expected_duration_seconds_p99": 1209600
  },
  "compliance_flags": [
    "soc2-type-2",
    "eeoc",
    "gdpr",
    "i9-everify"
  ],
  "audit_emission_points": [
    {
      "node_id": "comp-validate",
      "seal_kind": "policy-verdict"
    },
    {
      "node_id": "esign",
      "seal_kind": "human-approval-signature"
    },
    {
      "node_id": "audit-offer",
      "seal_kind": "decision-recorded"
    }
  ],
  "cedar_policy": {
    "policy_id": "cedar:oya-workflow-studio-template:offer-esign-onboarding-handoff",
    "effect": "permit",
    "principal_scope": "Workflow::Tenant",
    "resource_scope": "OfferLetter",
    "action_scope": "emit_and_handoff",
    "conditions": []
  },
  "connector_dependencies": [
    {
      "connector_id": "oya-shared-connector-esign",
      "operations": [
        "send_for_signature"
      ],
      "criticality": "required"
    },
    {
      "connector_id": "oya-shared-connector-workflow-bus",
      "operations": [
        "emit_event"
      ],
      "criticality": "required"
    }
  ],
  "slo": {
    "max_duration_seconds": 1209600,
    "min_success_rate": 0.995,
    "openslo_ref": "microservices/workflow-studio/slos/oya-workflow-studio-template-offer-esign-onboarding-handoff.openslo.yaml"
  },
  "cost_model": {
    "estimated_usd_per_execution_p50": 0.85,
    "foundry_inference_usd": 0.15,
    "connector_call_usd": 0.6,
    "storage_usd": 0.1
  },
  "test_mode_supported": true,
  "live_mode_supported": true,
  "documentation": {
    "explainer_path": "microservices/workflow-studio/templates/explainers/oya-workflow-studio-template-offer-esign-onboarding-handoff.md",
    "fixture_path": "microservices/workflow-studio/templates/fixtures/oya-workflow-studio-template-offer-esign-onboarding-handoff.fixture.json"
  },
  "tags": [
    "hiring",
    "offer",
    "esign",
    "handoff"
  ]
}
