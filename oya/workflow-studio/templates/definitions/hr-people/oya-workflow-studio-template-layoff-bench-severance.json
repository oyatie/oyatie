{
  "template_id": "oya-workflow-studio-template-layoff-bench-severance",
  "schema_version": "1.0.0",
  "name": "Layoff bench + severance + COBRA",
  "description": "Reduction-in-force batch orchestration: WARN-Act notice, severance package, outplacement enrolment, COBRA, audit.",
  "persona": "hr-business-partner",
  "vertical": "hr-people",
  "node_graph": {
    "entry_node": "trigger-rif-approved",
    "terminal_nodes": [
      "t-rif-complete"
    ],
    "nodes": [
      {
        "id": "trigger-rif-approved",
        "kind": "trigger",
        "label": "RIF batch approved"
      },
      {
        "id": "policy-rif",
        "kind": "policy-check",
        "label": "Cedar RIF + WARN-Act + disparate-impact check"
      },
      {
        "id": "warn-notice",
        "kind": "connector-call",
        "label": "Issue WARN-Act notices",
        "connector": "oya-shared-connector-document-store",
        "operation": "send_warn_notices"
      },
      {
        "id": "severance-package",
        "kind": "connector-call",
        "label": "Compute severance",
        "connector": "oya-shared-connector-workday",
        "operation": "batch_severance"
      },
      {
        "id": "outplacement",
        "kind": "connector-call",
        "label": "Enrol outplacement",
        "connector": "oya-shared-connector-outplacement",
        "operation": "enrol_batch"
      },
      {
        "id": "cobra-batch",
        "kind": "connector-call",
        "label": "COBRA notices",
        "connector": "oya-shared-connector-benefits",
        "operation": "cobra_batch"
      },
      {
        "id": "audit-rif",
        "kind": "audit-emit",
        "label": "Emit RIF seal"
      },
      {
        "id": "t-rif-complete",
        "kind": "terminal",
        "label": "RIF complete"
      }
    ],
    "edges": [
      {
        "from": "trigger-rif-approved",
        "to": "policy-rif"
      },
      {
        "from": "policy-rif",
        "to": "warn-notice",
        "condition": "permit"
      },
      {
        "from": "warn-notice",
        "to": "severance-package"
      },
      {
        "from": "severance-package",
        "to": "outplacement"
      },
      {
        "from": "outplacement",
        "to": "cobra-batch"
      },
      {
        "from": "cobra-batch",
        "to": "audit-rif"
      },
      {
        "from": "audit-rif",
        "to": "t-rif-complete"
      }
    ]
  },
  "input_parameters": [
    {
      "name": "rif_batch_id",
      "type": "reference",
      "required": true,
      "description": "RIF batch identifier"
    },
    {
      "name": "effective_date",
      "type": "date",
      "required": true,
      "description": "Effective separation date"
    }
  ],
  "runtime_expectations": {
    "expected_duration_seconds_p50": 604800,
    "expected_duration_seconds_p99": 1814400
  },
  "compliance_flags": [
    "soc2-type-2",
    "gdpr",
    "cobra",
    "eeoc",
    "flsa",
    "wage-act"
  ],
  "audit_emission_points": [
    {
      "node_id": "policy-rif",
      "seal_kind": "policy-verdict"
    },
    {
      "node_id": "warn-notice",
      "seal_kind": "external-call-receipt"
    },
    {
      "node_id": "audit-rif",
      "seal_kind": "termination-record"
    }
  ],
  "cedar_policy": {
    "policy_id": "cedar:oya-workflow-studio-template:layoff-bench-severance",
    "effect": "permit",
    "principal_scope": "Workflow::Tenant",
    "resource_scope": "LayoffBatch",
    "action_scope": "execute_rif",
    "conditions": [
      "resource.warn_act_threshold_satisfied == true"
    ]
  },
  "connector_dependencies": [
    {
      "connector_id": "oya-shared-connector-document-store",
      "operations": [
        "send_warn_notices"
      ],
      "criticality": "required"
    },
    {
      "connector_id": "oya-shared-connector-workday",
      "operations": [
        "batch_severance"
      ],
      "criticality": "required"
    },
    {
      "connector_id": "oya-shared-connector-benefits",
      "operations": [
        "cobra_batch"
      ],
      "criticality": "required"
    },
    {
      "connector_id": "oya-shared-connector-outplacement",
      "operations": [
        "enrol_batch"
      ],
      "criticality": "preferred"
    }
  ],
  "slo": {
    "max_duration_seconds": 1814400,
    "min_success_rate": 0.999,
    "openslo_ref": "microservices/workflow-studio/slos/oya-workflow-studio-template-layoff-bench-severance.openslo.yaml"
  },
  "cost_model": {
    "estimated_usd_per_execution_p50": 18.4,
    "foundry_inference_usd": 0.4,
    "connector_call_usd": 16.8,
    "storage_usd": 1.2
  },
  "test_mode_supported": true,
  "live_mode_supported": true,
  "documentation": {
    "explainer_path": "microservices/workflow-studio/templates/explainers/oya-workflow-studio-template-layoff-bench-severance.md",
    "fixture_path": "microservices/workflow-studio/templates/fixtures/oya-workflow-studio-template-layoff-bench-severance.fixture.json"
  },
  "tags": [
    "hr",
    "rif",
    "layoff",
    "cobra",
    "warn-act"
  ]
}
