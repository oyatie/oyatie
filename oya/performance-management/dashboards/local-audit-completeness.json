{
  "schemaVersion": 39,
  "title": "Performance Management local audit completeness",
  "tags": [
    "performance-management",
    "local-operational-primitive",
    "adr-0130"
  ],
  "timezone": "utc",
  "templating": {
    "list": [
      {
        "name": "tenant_id",
        "type": "query",
        "query": "label_values(oya_performance_management_goal_alignment_latency_total, tenant_id)"
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Goal alignment update latency burn",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(rate(oya_performance_management_goal_alignment_latency_good_total[5m])) by (tenant_id, cell_tier) / sum(rate(oya_performance_management_goal_alignment_latency_total[5m])) by (tenant_id, cell_tier)",
          "legendFormat": "goal-alignment-latency ratio"
        }
      ]
    },
    {
      "id": 2,
      "title": "Calibration lock operations without conflict burn",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(oya_performance_management_calibration_lock_conflict_rate_good_total[30d])) by (tenant_id, cell_tier) / sum(rate(oya_performance_management_calibration_lock_conflict_rate_total[30d])) by (tenant_id, cell_tier)",
          "legendFormat": "calibration-lock-conflict-rate ratio"
        }
      ]
    },
    {
      "id": 3,
      "title": "Calibration cycles completed by due date burn",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(rate(oya_performance_management_calibration_cycle_completion_good_total[30d])) by (tenant_id, cell_tier) / sum(rate(oya_performance_management_calibration_cycle_completion_total[30d])) by (tenant_id, cell_tier)",
          "legendFormat": "calibration-cycle-completion ratio"
        }
      ]
    },
    {
      "id": 4,
      "title": "Review form load and save latency burn",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(oya_performance_management_review_form_latency_good_total[5m])) by (tenant_id, cell_tier) / sum(rate(oya_performance_management_review_form_latency_total[5m])) by (tenant_id, cell_tier)",
          "legendFormat": "review-form-latency ratio"
        }
      ]
    },
    {
      "id": 5,
      "title": "Feedback submissions accepted with audit evidence burn",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(rate(oya_performance_management_feedback_submit_success_good_total[30d])) by (tenant_id, cell_tier) / sum(rate(oya_performance_management_feedback_submit_success_total[30d])) by (tenant_id, cell_tier)",
          "legendFormat": "feedback-submit-success ratio"
        }
      ]
    },
    {
      "id": 6,
      "title": "Rating distribution projection freshness burn",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(oya_performance_management_rating_distribution_freshness_good_total[1h])) by (tenant_id, cell_tier) / sum(rate(oya_performance_management_rating_distribution_freshness_total[1h])) by (tenant_id, cell_tier)",
          "legendFormat": "rating-distribution-freshness ratio"
        }
      ]
    }
  ]
}
