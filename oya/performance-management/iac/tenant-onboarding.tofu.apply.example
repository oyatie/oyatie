# Tenant onboarding evidence artifact.
# Closes audit Finding 6.7.A (P0).
# Demonstrates the zero-handroll tenant onboarding flow per
# feedback_zero_handroll_opentofu_only_2026_05_20.

# === Step 1: Initialize OpenTofu state for tenant ===
# $ cd microservices/performance-management/iac/<context>/
# $ tofu init -backend-config="key=tenants/<tenant_id>/performance-management.tfstate"

# === Step 2: Plan the deployment ===
# $ tofu plan \
#     -var="tenant_id=018f8ad2-0e0f-7ad2-92d2-pm000001" \
#     -var="tenant_class=paid"

# Expected plan output (excerpt):
#
#   Plan: 7 to add, 0 to change, 0 to destroy.
#
#   Outputs:
#     service_url = "https://018f8ad2-0e0f-7ad2-92d2-pm000001.perf.oyatie.com"
#     namespace   = "perf-mgmt-018f8ad2-0e0f-7ad2-92d2-pm000001"
#     billing_component_id = "bc-performance-management"
#     deal_set_id = "ds-2026-05-21-..."

# === Step 3: Apply ===
# $ tofu apply -auto-approve \
#     -var="tenant_id=018f8ad2-0e0f-7ad2-92d2-pm000001" \
#     -var="tenant_class=paid"

# Expected: helm_release.performance_management = installed.
# Expected: oya_billing_binding.performance_management_settlement = bound.
# Expected: Cedar policies pushed to policy-engine via substrate sync.

# === Step 4: Verify ===
# $ curl -s https://018f8ad2-0e0f-7ad2-92d2-pm000001.perf.oyatie.com/healthz
#   {"status":"ok","tenant_id":"018f8ad2-0e0f-7ad2-92d2-pm000001","tenant_class":"paid"}

# === Step 5: Run smoke tests ===
# $ cd /Users/jasonlee/oyatie
# $ cargo test --package oya-cloud-cell-app --test cloud_cell_bind_api -- --nocapture

# === Step 6: Tenant configures pack overlays ===
# $ oya tenant pack enable --tenant-id <uuid> --pack soc2
# $ oya tenant pack enable --tenant-id <uuid> --pack iso27001
# $ oya tenant pack enable --tenant-id <uuid> --pack gdpr

# === Step 7 (demo_trial only): ===
# Skip steps 5-6; use OCI Always Free flow under iac/oci-guest/always-free/.
