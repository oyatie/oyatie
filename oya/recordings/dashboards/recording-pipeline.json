{
  "$schema": "https://schemas.grafana.com/dashboard.json",
  "_meta": {
    "doc_class": "GrafanaDashboard",
    "microservice": "recordings",
    "owner_team": "axis-recordings + ops-sre-reliability",
    "audience": "tenant operator + axis-recordings SRE",
    "tenant_scoped": true,
    "datasource": "per-pack Mimir; tenant-scoped via X-Scope-OrgID"
  },
  "uid": "rec-recording-pipeline",
  "title": "recordings: ingest + transcode + transcript pipeline",
  "tags": ["recordings", "pipeline", "burn-rate"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "templating": {
    "list": [
      {"name": "pack", "type": "custom", "label": "Pack",
        "options": [
          {"text": "pack-kr", "value": "kr", "selected": true},
          {"text": "pack-eu", "value": "eu"},
          {"text": "pack-us", "value": "us"},
          {"text": "pack-us-healthcare", "value": "us-hc"},
          {"text": "pack-us-financial", "value": "us-fin"},
          {"text": "pack-jp", "value": "jp"},
          {"text": "pack-sg", "value": "sg"},
          {"text": "pack-au", "value": "au"},
          {"text": "pack-in", "value": "in"},
          {"text": "pack-br", "value": "br"},
          {"text": "pack-ae", "value": "ae"},
          {"text": "pack-ksa", "value": "ksa"}
        ]},
      {"name": "tenant", "type": "query", "label": "Tenant",
        "query": "label_values(oya_recordings_ingest_total{pack=\"$pack\"}, tenant_id)"}
    ]
  },
  "panels": [
    {"id": 1, "type": "stat", "title": "Recordings ingested (5m rate)",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "sum(rate(oya_recordings_ingest_total{pack=\"$pack\",tenant_id=\"$tenant\",result=\"success\"}[5m]))", "refId": "A"}]},

    {"id": 2, "type": "stat", "title": "Ingest p99 (s)",
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "histogram_quantile(0.99, sum by (le) (rate(oya_recordings_ingest_duration_seconds_bucket{pack=\"$pack\",tenant_id=\"$tenant\"}[5m])))", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s"}}},

    {"id": 3, "type": "stat", "title": "Whisper queue depth (min)",
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "oya_recordings_transcript_pipeline_queue_minutes{pack=\"$pack\"}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "m", "thresholds": {"mode": "absolute", "steps": [{"value": null, "color": "green"}, {"value": 60, "color": "yellow"}, {"value": 240, "color": "red"}]}}}},

    {"id": 4, "type": "stat", "title": "ffmpeg encode failure rate",
      "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "sum(rate(oya_recordings_transcode_total{pack=\"$pack\",result=\"failure\"}[5m])) / sum(rate(oya_recordings_transcode_total{pack=\"$pack\"}[5m]))", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "thresholds": {"mode": "absolute", "steps": [{"value": null, "color": "green"}, {"value": 0.01, "color": "yellow"}, {"value": 0.05, "color": "red"}]}}}},

    {"id": 5, "type": "timeseries", "title": "Ingest latency percentiles",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum by (le) (rate(oya_recordings_ingest_duration_seconds_bucket{pack=\"$pack\",tenant_id=\"$tenant\"}[5m])))", "legendFormat": "p50", "refId": "A"},
        {"expr": "histogram_quantile(0.95, sum by (le) (rate(oya_recordings_ingest_duration_seconds_bucket{pack=\"$pack\",tenant_id=\"$tenant\"}[5m])))", "legendFormat": "p95", "refId": "B"},
        {"expr": "histogram_quantile(0.99, sum by (le) (rate(oya_recordings_ingest_duration_seconds_bucket{pack=\"$pack\",tenant_id=\"$tenant\"}[5m])))", "legendFormat": "p99", "refId": "C"}
      ]},

    {"id": 6, "type": "timeseries", "title": "Transcript pipeline queue depth (min) by source",
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
      "targets": [{"expr": "oya_recordings_transcript_pipeline_queue_minutes{pack=\"$pack\"} by (source_kind)", "legendFormat": "{{source_kind}}", "refId": "A"}]},

    {"id": 7, "type": "timeseries", "title": "ffmpeg HLS ladder completion rate (rungs/sec)",
      "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
      "targets": [{"expr": "sum(rate(oya_recordings_transcode_ladder_rung_total{pack=\"$pack\",result=\"success\"}[5m])) by (bitrate)", "legendFormat": "{{bitrate}}", "refId": "A"}]},

    {"id": 8, "type": "timeseries", "title": "Whisper model version distribution",
      "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8},
      "targets": [{"expr": "sum(rate(oya_recordings_transcript_completed_total{pack=\"$pack\"}[5m])) by (model_version)", "legendFormat": "{{model_version}}", "refId": "A"}]},

    {"id": 9, "type": "timeseries", "title": "pyannote diarization latency p99",
      "gridPos": {"x": 0, "y": 20, "w": 12, "h": 8},
      "targets": [{"expr": "histogram_quantile(0.99, sum by (le) (rate(oya_recordings_diarization_duration_seconds_bucket{pack=\"$pack\"}[5m])))", "legendFormat": "p99", "refId": "A"}]},

    {"id": 10, "type": "stat", "title": "Burn-rate (fast 1h)",
      "gridPos": {"x": 12, "y": 20, "w": 6, "h": 4},
      "targets": [{"expr": "oya_promotion_burn_rate_fast_1h{microservice=\"recordings\",pack=\"$pack\",sli=\"ingest-availability\"}", "refId": "A"}],
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"value": null, "color": "green"}, {"value": 6, "color": "yellow"}, {"value": 14.4, "color": "red"}]}}}},

    {"id": 11, "type": "stat", "title": "Eligibility verdict",
      "gridPos": {"x": 18, "y": 20, "w": 6, "h": 4},
      "targets": [{"expr": "oya:current_verdict:by_microservice_env{microservice=\"recordings\",pack=\"$pack\",environment=\"production\"}", "refId": "A"}]}
  ]
}
