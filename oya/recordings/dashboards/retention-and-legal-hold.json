{
  "$schema": "https://schemas.grafana.com/dashboard.json",
  "_meta": {
    "doc_class": "GrafanaDashboard",
    "microservice": "recordings",
    "owner_team": "ops-compliance + axis-recordings + ops-security",
    "audience": "ops-compliance + council-privacy",
    "tenant_scoped": true,
    "load_bearing": true,
    "datasource": "per-pack Mimir; tenant-scoped via X-Scope-OrgID"
  },
  "uid": "rec-retention-and-legal-hold",
  "title": "recordings: retention + legal-hold (load-bearing)",
  "tags": ["recordings", "retention", "legal-hold", "load-bearing", "compliance"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-24h", "to": "now"},
  "templating": {
    "list": [
      {"name": "pack", "type": "custom", "label": "Pack",
        "options": [
          {"text": "pack-kr", "value": "kr", "selected": true},
          {"text": "pack-eu", "value": "eu"},
          {"text": "pack-us", "value": "us"},
          {"text": "pack-us-healthcare", "value": "us-hc"},
          {"text": "pack-us-financial", "value": "us-fin"}
        ]}
    ]
  },
  "panels": [
    {"id": 1, "type": "stat", "title": "Active legal holds",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "sum(oya_recordings_legal_hold_active{pack=\"$pack\"})", "refId": "A"}]},

    {"id": 2, "type": "stat", "title": "Legal-hold engagement p99 (s) — LOAD-BEARING",
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "histogram_quantile(0.99, sum by (le) (rate(oya_recordings_legal_hold_engagement_duration_seconds_bucket{pack=\"$pack\"}[5m])))", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"mode": "absolute", "steps": [{"value": null, "color": "green"}, {"value": 0.5, "color": "yellow"}, {"value": 1.0, "color": "red"}]}}}},

    {"id": 3, "type": "stat", "title": "Retention-policy correctness — LOAD-BEARING 100%",
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "1 - (sum(rate(oya_recordings_retention_breach_total{pack=\"$pack\"}[30d])) / sum(rate(oya_recordings_retention_applied_total{pack=\"$pack\"}[30d])))", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "thresholds": {"mode": "absolute", "steps": [{"value": null, "color": "red"}, {"value": 0.999999, "color": "yellow"}, {"value": 1.0, "color": "green"}]}}}},

    {"id": 4, "type": "stat", "title": "Legal-hold chain-of-custody correctness — LOAD-BEARING 100%",
      "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "1 - (sum(rate(oya_recordings_legal_hold_chain_of_custody_breach_total{pack=\"$pack\"}[30d])) / sum(rate(oya_recordings_legal_hold_chain_of_custody_event_total{pack=\"$pack\"}[30d])))", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "thresholds": {"mode": "absolute", "steps": [{"value": null, "color": "red"}, {"value": 0.999999, "color": "yellow"}, {"value": 1.0, "color": "green"}]}}}},

    {"id": 5, "type": "timeseries", "title": "Legal-hold engagement latency percentiles",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum by (le) (rate(oya_recordings_legal_hold_engagement_duration_seconds_bucket{pack=\"$pack\"}[5m])))", "legendFormat": "p50", "refId": "A"},
        {"expr": "histogram_quantile(0.95, sum by (le) (rate(oya_recordings_legal_hold_engagement_duration_seconds_bucket{pack=\"$pack\"}[5m])))", "legendFormat": "p95", "refId": "B"},
        {"expr": "histogram_quantile(0.99, sum by (le) (rate(oya_recordings_legal_hold_engagement_duration_seconds_bucket{pack=\"$pack\"}[5m])))", "legendFormat": "p99", "refId": "C"}
      ]},

    {"id": 6, "type": "timeseries", "title": "Retention purge actions per hour by kind",
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
      "targets": [{"expr": "sum(rate(oya_recordings_retention_applied_total{pack=\"$pack\"}[5m])) by (action)", "legendFormat": "{{action}}", "refId": "A"}]},

    {"id": 7, "type": "timeseries", "title": "eDiscovery exports per day",
      "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
      "targets": [{"expr": "sum(rate(oya_recordings_ediscovery_export_total{pack=\"$pack\",result=\"success\"}[1h])) * 3600", "legendFormat": "successful/h", "refId": "A"}]},

    {"id": 8, "type": "timeseries", "title": "KMS-shred events + failures",
      "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum(rate(oya_recordings_kms_shred_total{pack=\"$pack\",result=\"success\"}[5m]))", "legendFormat": "success", "refId": "A"},
        {"expr": "sum(rate(oya_recordings_kms_shred_total{pack=\"$pack\",result=\"failure\"}[5m]))", "legendFormat": "failure", "refId": "B"}
      ]},

    {"id": 9, "type": "stat", "title": "Recordings under hold (count)",
      "gridPos": {"x": 0, "y": 20, "w": 6, "h": 4},
      "targets": [{"expr": "sum(oya_recordings_under_hold_total{pack=\"$pack\"})", "refId": "A"}]},

    {"id": 10, "type": "stat", "title": "Watermark key rotations (last 24h)",
      "gridPos": {"x": 6, "y": 20, "w": 6, "h": 4},
      "targets": [{"expr": "sum(increase(oya_recordings_watermark_rotated_total{pack=\"$pack\"}[24h]))", "refId": "A"}]},

    {"id": 11, "type": "table", "title": "Tenants by active hold count",
      "gridPos": {"x": 12, "y": 20, "w": 12, "h": 8},
      "targets": [{"expr": "topk(10, sum by (tenant_id) (oya_recordings_legal_hold_active{pack=\"$pack\"}))", "format": "table", "refId": "A"}]}
  ]
}
