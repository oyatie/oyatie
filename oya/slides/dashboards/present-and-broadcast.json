{
  "title": "Slides — Present + Broadcast",
  "schemaVersion": 38,
  "uid": "oya-slides-present-broadcast",
  "tags": ["slides", "present", "broadcast", "livekit"],
  "timezone": "browser",
  "refresh": "30s",
  "panels": [
    {
      "title": "Present-mode transition p95 (60fps invariant; target ≤ 50ms)",
      "type": "stat",
      "datasource": "prometheus",
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(oya_slides_present_transition_seconds_bucket[5m])))" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "thresholds": { "mode": "absolute", "steps": [{"value": 0, "color": "green"}, {"value": 0.05, "color": "orange"}, {"value": 0.1, "color": "red"}] } } },
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 }
    },
    {
      "title": "Present-mode 60fps frame budget (p99 ≤ 16.7ms)",
      "type": "stat",
      "datasource": "prometheus",
      "targets": [
        { "expr": "histogram_quantile(0.99, sum by (le) (rate(oya_slides_present_frame_time_seconds_bucket[5m])))" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "thresholds": { "mode": "absolute", "steps": [{"value": 0, "color": "green"}, {"value": 0.0167, "color": "orange"}, {"value": 0.025, "color": "red"}] } } },
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 }
    },
    {
      "title": "Active broadcast sessions",
      "type": "stat",
      "datasource": "prometheus",
      "targets": [
        { "expr": "sum(oya_slides_broadcast_session_active_count)" }
      ],
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 }
    },
    {
      "title": "Total broadcast viewer count (aggregate)",
      "type": "stat",
      "datasource": "prometheus",
      "targets": [
        { "expr": "sum(oya_slides_broadcast_viewer_count)" }
      ],
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 }
    },
    {
      "title": "Broadcast-mode signaling round-trip",
      "type": "timeseries",
      "datasource": "prometheus",
      "targets": [
        { "expr": "histogram_quantile(0.99, sum by (le) (rate(oya_slides_broadcast_signal_rtt_seconds_bucket[5m])))", "legendFormat": "p99" },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(oya_slides_broadcast_signal_rtt_seconds_bucket[5m])))", "legendFormat": "p95" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } },
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 }
    },
    {
      "title": "LiveKit-bridge health (signaling availability)",
      "type": "timeseries",
      "datasource": "prometheus",
      "targets": [
        { "expr": "avg(oya_slides_broadcast_signal_health)" }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit" } },
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 }
    },
    {
      "title": "Audience engagement — reactions/sec",
      "type": "timeseries",
      "datasource": "prometheus",
      "targets": [
        { "expr": "rate(oya_slides_audience_reaction_total[1m])" }
      ],
      "gridPos": { "x": 0, "y": 12, "w": 8, "h": 8 }
    },
    {
      "title": "Audience engagement — questions/sec",
      "type": "timeseries",
      "datasource": "prometheus",
      "targets": [
        { "expr": "rate(oya_slides_audience_question_total[1m])" }
      ],
      "gridPos": { "x": 8, "y": 12, "w": 8, "h": 8 }
    },
    {
      "title": "Audience engagement — poll responses/sec",
      "type": "timeseries",
      "datasource": "prometheus",
      "targets": [
        { "expr": "rate(oya_slides_audience_poll_response_total[1m])" }
      ],
      "gridPos": { "x": 16, "y": 12, "w": 8, "h": 8 }
    },
    {
      "title": "Speaker-notes exclusion-from-broadcast invariant (must be 0)",
      "type": "stat",
      "datasource": "prometheus",
      "targets": [
        { "expr": "sum(rate(oya_slides_broadcast_speaker_notes_leak_total[5m]))" }
      ],
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [{"value": 0, "color": "green"}, {"value": 0.0001, "color": "red"}] } } },
      "gridPos": { "x": 0, "y": 20, "w": 12, "h": 4 }
    },
    {
      "title": "Reduced-motion fallback engagement",
      "type": "timeseries",
      "datasource": "prometheus",
      "targets": [
        { "expr": "sum by (pack) (rate(oya_slides_reduced_motion_engaged_total[5m]))" }
      ],
      "gridPos": { "x": 12, "y": 20, "w": 12, "h": 4 }
    }
  ]
}
