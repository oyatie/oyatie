{
  "$schema": "https://schemas.grafana.com/dashboard.json",
  "_meta": {
    "doc_class": "GrafanaDashboard",
    "microservice": "intelligence",
    "owner_team": "ops-finops + axis-intelligence",
    "audience": "ops-finops + ops-security",
    "tenant_scoped": false
  },
  "uid": "intel-byok-mix",
  "title": "provider-credential BYOK vs platform-default mix (ADR-0255 §D-4)",
  "tags": ["intelligence", "byok", "finops"],
  "schemaVersion": 39,
  "refresh": "1m",
  "time": {"from": "now-30d", "to": "now"},
  "panels": [
    {"id": 1, "type": "piechart", "title": "Dispatch count: provider-credential BYOK vs platform-default (ADR-0255 §D-4)", "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
     "targets": [{"expr": "sum(rate(oya_intelligence_dispatch_total{status=\"completed\"}[30d])) by (credential_kind)", "legendFormat": "{{credential_kind}}", "refId": "A"}]},
    {"id": 2, "type": "piechart", "title": "Cost USD: provider-credential BYOK vs platform-default (ADR-0255 §D-4)", "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
     "targets": [{"expr": "sum(increase(oya_intelligence_dispatch_cost_usd_total[30d])) by (credential_kind)", "legendFormat": "{{credential_kind}}", "refId": "A"}]},
    {"id": 3, "type": "timeseries", "title": "Platform-default cost float ($/day)", "gridPos": {"x": 0, "y": 8, "w": 24, "h": 8},
     "targets": [{"expr": "sum(rate(oya_intelligence_dispatch_cost_usd_total{credential_kind=\"platform_default\"}[1d])) * 86400", "legendFormat": "platform-default $/day", "refId": "A"}]},
    {"id": 4, "type": "table", "title": "Top 20 tenants by platform-default cost (30d)", "gridPos": {"x": 0, "y": 16, "w": 24, "h": 8},
     "targets": [{"expr": "topk(20, sum(increase(oya_intelligence_dispatch_cost_usd_total{credential_kind=\"platform_default\"}[30d])) by (tenant_id))", "format": "table", "refId": "A"}]}
  ]
}
