{
  "$schema": "https://schemas.grafana.com/dashboard.json",
  "_meta": {
    "doc_class": "GrafanaDashboard",
    "microservice": "foundry-eval",
    "owner_team": "axis-foundry + ops-sre-reliability",
    "audience": "axis-foundry + routing decision-makers + axis-foundry-providers",
    "tenant_scoped": false,
    "datasource": "ClickHouse parity_analytics"
  },
  "uid": "fe-parity-trend",
  "title": "Parity Trend (provider vs in-house variant)",
  "tags": ["foundry-eval", "parity", "in-house-cutover"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5m",
  "time": {"from": "now-30d", "to": "now"},
  "templating": {
    "list": [
      {
        "name": "pack",
        "type": "custom",
        "options": [
          {"text": "pack-kr", "value": "kr", "selected": true},
          {"text": "pack-eu", "value": "eu"},
          {"text": "pack-us", "value": "us"},
          {"text": "pack-us-healthcare", "value": "us-hc"},
          {"text": "pack-jp", "value": "jp"},
          {"text": "pack-sg", "value": "sg"},
          {"text": "pack-au", "value": "au"},
          {"text": "pack-in", "value": "in"},
          {"text": "pack-br", "value": "br"},
          {"text": "pack-ae", "value": "ae"},
          {"text": "pack-ksa", "value": "ksa"}
        ],
        "label": "Pack"
      },
      {
        "name": "capability",
        "type": "query",
        "query": "SELECT DISTINCT capability_id FROM parity_analytics WHERE pack='$pack'",
        "label": "Capability"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Parity margin: in-house vs incumbent provider",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "oya_foundry_eval_parity_margin{pack=\"$pack\",capability=\"$capability\",delta_kind=\"in_house_vs_incumbent\"}",
          "legendFormat": "{{cohort}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "table",
      "title": "Capabilities currently InHouseCutoverEligible",
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "oya_foundry_eval_in_house_cutover_eligible{pack=\"$pack\"} == 1",
          "format": "table",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Provider-A vs Provider-B win-margin (per-cohort)",
      "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "oya_foundry_eval_parity_margin{pack=\"$pack\",capability=\"$capability\",delta_kind=\"a_vs_b\"}",
          "legendFormat": "{{cohort}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Reverse-cutover count (30d)",
      "gridPos": {"x": 0, "y": 24, "w": 6, "h": 4},
      "targets": [
        {"expr": "increase(oya_foundry_eval_reverse_cutover_total{pack=\"$pack\"}[30d])", "refId": "A"}
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Parity verdict latency p99 (target ≤1s)",
      "gridPos": {"x": 6, "y": 24, "w": 6, "h": 4},
      "targets": [
        {"expr": "histogram_quantile(0.99, sum by (le) (rate(oya_foundry_eval_parity_verdict_latency_seconds_bucket{pack=\"$pack\"}[5m])))", "refId": "A"}
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Judge-rotation consistency (κ; target ≥0.7)",
      "gridPos": {"x": 0, "y": 28, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "oya_foundry_eval_judge_cohen_kappa{pack=\"$pack\",capability=\"$capability\"}",
          "legendFormat": "{{capability}} κ",
          "refId": "A"
        }
      ]
    }
  ]
}
