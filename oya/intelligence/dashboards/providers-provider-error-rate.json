{
  "$schema": "https://schemas.grafana.com/dashboard.json",
  "_meta": {
    "doc_class": "GrafanaDashboard",
    "microservice": "foundry-providers",
    "owner_team": "axis-foundry + ops-sre-reliability",
    "related_artifacts": [
      "microservices/intelligence/runbooks/provider-outage-failover.md",
      "microservices/intelligence/failure-modes.md"
    ],
    "audience": "axis-foundry on-call + tenant operators",
    "tenant_scoped": true,
    "datasource": "Mimir (per-pack)"
  },
  "uid": "fprov-provider-error-rate",
  "title": "Provider Error Rate + Health",
  "tags": ["foundry-providers", "errors", "health"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {"from": "now-6h", "to": "now"},
  "templating": {
    "list": [
      {"name": "tenant", "type": "query", "datasource": "Mimir", "query": "label_values(oya_foundry_providers_provider_invocations_total, tenant)", "label": "Tenant"},
      {"name": "vendor", "type": "custom", "options": [
        {"text": "anthropic", "value": "anthropic"},
        {"text": "openai", "value": "openai"},
        {"text": "gemini", "value": "gemini"},
        {"text": "in-house", "value": "in-house"}
      ], "label": "Vendor"}
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Vendor availability (rolling 15m)",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "targets": [
        {"expr": "avg(oya_foundry_providers_provider_availability{vendor=\"$vendor\",tenant=\"$tenant\"})", "refId": "A"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {"steps": [{"color": "red", "value": 0}, {"color": "yellow", "value": 0.95}, {"color": "green", "value": 0.99}]}
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Demoted?",
      "gridPos": {"x": 6, "y": 0, "w": 4, "h": 4},
      "targets": [{"expr": "oya_foundry_providers_provider_demoted{vendor=\"$vendor\"}", "refId": "A"}],
      "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {"0": {"text": "OK", "color": "green"}, "1": {"text": "DEMOTED", "color": "red"}}}]}}
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Error rate (rolling 5m) — by vendor",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum by (vendor) (rate(oya_foundry_providers_provider_invocations_total{tenant=\"$tenant\",status=~\"error|429|5..\"}[5m])) / sum by (vendor) (rate(oya_foundry_providers_provider_invocations_total{tenant=\"$tenant\"}[5m]))", "legendFormat": "{{vendor}}", "refId": "A"}
      ],
      "alert": {
        "name": "provider-error-rate-burn-fast",
        "conditions": [{"evaluator": {"params": [0.01], "type": "gt"}, "query": {"params": ["A", "5m", "now"]}, "type": "query"}],
        "notifications": [{"uid": "grafana-oncall"}]
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Latency p99 — by vendor",
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
      "targets": [
        {"expr": "histogram_quantile(0.99, sum by (le, vendor) (rate(oya_foundry_providers_provider_call_latency_ms_bucket{tenant=\"$tenant\"}[5m])))", "legendFormat": "{{vendor}}", "refId": "A"}
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "429 rate (rate-limit throttling) — by vendor",
      "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum by (vendor) (rate(oya_foundry_providers_provider_429_total{tenant=\"$tenant\"}[5m]))", "legendFormat": "{{vendor}}", "refId": "A"}
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Response-shape anomaly count (T-03 detector)",
      "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum by (vendor) (rate(oya_foundry_providers_response_shape_anomaly_total[15m]))", "legendFormat": "{{vendor}}", "refId": "A"}
      ],
      "alert": {
        "name": "response-shape-anomaly",
        "conditions": [{"evaluator": {"params": [1], "type": "gt"}, "query": {"params": ["A", "15m", "now"]}, "type": "query"}],
        "notifications": [{"uid": "grafana-oncall"}]
      }
    },
    {
      "id": 7,
      "type": "table",
      "title": "Recent Cedar denies — by reason",
      "gridPos": {"x": 0, "y": 20, "w": 24, "h": 6},
      "targets": [
        {"expr": "sum by (reason) (increase(oya_foundry_providers_tenant_unauthorized_invoke_total{tenant=\"$tenant\"}[1h]))", "format": "table", "refId": "A"}
      ]
    }
  ]
}
