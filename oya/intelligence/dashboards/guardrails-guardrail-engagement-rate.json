{
  "$schema": "https://schemas.grafana.com/dashboard.json",
  "_meta": {
    "doc_class": "GrafanaDashboard",
    "microservice": "foundry-guardrails",
    "owner_team": "axis-foundry-guardrails + ops-sre-reliability",
    "audience": "internal operators + tenant operators (own-tenant scope)",
    "tenant_scoped": true,
    "datasource": "Mimir oya-self (engagement totals) + per-tenant aggregates (tenant_id scoped via Cedar)"
  },
  "uid": "fguard-engagement-rate",
  "title": "Guardrail Engagement Rate",
  "tags": ["foundry-guardrails", "engagement", "operator"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "templating": {
    "list": [
      {
        "name": "pack",
        "type": "custom",
        "options": [
          {"text": "pack-kr", "value": "kr", "selected": true},
          {"text": "pack-eu", "value": "eu"},
          {"text": "pack-us", "value": "us"},
          {"text": "pack-us-healthcare", "value": "us-hc"},
          {"text": "pack-jp", "value": "jp"},
          {"text": "pack-sg", "value": "sg"},
          {"text": "pack-au", "value": "au"},
          {"text": "pack-in", "value": "in"},
          {"text": "pack-br", "value": "br"},
          {"text": "pack-ae", "value": "ae"},
          {"text": "pack-ksa", "value": "ksa"}
        ],
        "label": "Pack"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Decisions / sec (live)",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "targets": [
        {"expr": "sum(rate(foundry_guardrails_decisions_total{pack=\"$pack\"}[1m]))", "refId": "A"}
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Block ratio (last 1h)",
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
      "targets": [
        {"expr": "sum(rate(foundry_guardrails_decisions_total{pack=\"$pack\",verdict=\"block\"}[1h])) / sum(rate(foundry_guardrails_decisions_total{pack=\"$pack\"}[1h]))", "refId": "A"}
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Decisions by verdict",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum by (verdict) (rate(foundry_guardrails_decisions_total{pack=\"$pack\"}[1m]))", "legendFormat": "{{verdict}}", "refId": "A"}
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Decisions by BC",
      "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum by (bc) (rate(foundry_guardrails_decisions_total{pack=\"$pack\"}[1m]))", "legendFormat": "{{bc}}", "refId": "A"}
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Pre-invocation classify p99 latency",
      "gridPos": {"x": 0, "y": 20, "w": 12, "h": 8},
      "targets": [
        {"expr": "histogram_quantile(0.99, sum by (le) (rate(foundry_guardrails_classify_duration_seconds_bucket{pack=\"$pack\"}[5m])))", "legendFormat": "p99", "refId": "A"},
        {"expr": "histogram_quantile(0.50, sum by (le) (rate(foundry_guardrails_classify_duration_seconds_bucket{pack=\"$pack\"}[5m])))", "legendFormat": "p50", "refId": "B"}
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Top 10 tenants by block-rate",
      "gridPos": {"x": 0, "y": 28, "w": 12, "h": 8},
      "targets": [
        {"expr": "topk(10, sum by (tenant) (rate(foundry_guardrails_decisions_total{pack=\"$pack\",verdict=\"block\"}[1h])))", "legendFormat": "{{tenant}}", "refId": "A"}
      ]
    }
  ]
}
