{
  "$schema": "https://schemas.grafana.com/dashboard.json",
  "_meta": {
    "doc_class": "GrafanaDashboard",
    "microservice": "intelligence",
    "owner_team": "axis-intelligence",
    "audience": "operator + tenant",
    "tenant_scoped": true
  },
  "uid": "intel-provider-latency-heatmap",
  "title": "Provider latency heatmap",
  "tags": ["intelligence", "providers", "latency", "heatmap"],
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "templating": {"list": [
    {"name": "pack", "type": "query", "datasource": "Mimir", "query": "label_values(oya_intelligence_provider_first_token_latency_seconds_bucket, pack)"}
  ]},
  "panels": [
    {"id": 1, "type": "heatmap", "title": "Anthropic first-token latency", "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
     "targets": [{"expr": "sum(rate(oya_intelligence_provider_first_token_latency_seconds_bucket{provider=\"anthropic\",pack=~\"$pack\"}[5m])) by (le)", "format": "heatmap", "refId": "A"}]},
    {"id": 2, "type": "heatmap", "title": "OpenAI first-token latency", "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
     "targets": [{"expr": "sum(rate(oya_intelligence_provider_first_token_latency_seconds_bucket{provider=\"openai\",pack=~\"$pack\"}[5m])) by (le)", "format": "heatmap", "refId": "A"}]},
    {"id": 3, "type": "heatmap", "title": "Google + Vertex first-token latency", "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
     "targets": [{"expr": "sum(rate(oya_intelligence_provider_first_token_latency_seconds_bucket{provider=~\"google|vertex\",pack=~\"$pack\"}[5m])) by (le)", "format": "heatmap", "refId": "A"}]},
    {"id": 4, "type": "heatmap", "title": "Bedrock first-token latency", "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
     "targets": [{"expr": "sum(rate(oya_intelligence_provider_first_token_latency_seconds_bucket{provider=\"bedrock\",pack=~\"$pack\"}[5m])) by (le)", "format": "heatmap", "refId": "A"}]},
    {"id": 5, "type": "heatmap", "title": "vLLM (self-hosted) first-token latency", "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8},
     "targets": [{"expr": "sum(rate(oya_intelligence_provider_first_token_latency_seconds_bucket{provider=\"vllm\",pack=~\"$pack\"}[5m])) by (le)", "format": "heatmap", "refId": "A"}]},
    {"id": 6, "type": "heatmap", "title": "Groq first-token latency", "gridPos": {"x": 12, "y": 16, "w": 12, "h": 8},
     "targets": [{"expr": "sum(rate(oya_intelligence_provider_first_token_latency_seconds_bucket{provider=\"groq\",pack=~\"$pack\"}[5m])) by (le)", "format": "heatmap", "refId": "A"}]}
  ]
}
