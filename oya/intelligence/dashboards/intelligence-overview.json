{
  "$schema": "https://schemas.grafana.com/dashboard.json",
  "_meta": {
    "doc_class": "GrafanaDashboard",
    "microservice": "intelligence",
    "owner_team": "axis-intelligence",
    "related_artifacts": [
      "microservices/intelligence/contracts/openapi/intelligence-v1.yaml",
      "microservices/intelligence/policy/dispatch-authorization.cedar",
      "microservices/intelligence/slos/"
    ],
    "audience": "axis-intelligence operators + tenant operators",
    "tenant_scoped": true,
    "datasource": "Mimir (per-pack); X-Scope-OrgID = principal.tenant_id"
  },
  "uid": "intel-overview",
  "title": "Intelligence Overview",
  "tags": ["intelligence", "ai", "two-layer-substrate"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-24h", "to": "now"},
  "timepicker": {"refresh_intervals": ["10s","30s","1m","5m","15m","30m","1h"]},
  "templating": {
    "list": [
      {"name": "audience", "type": "custom", "options": [
        {"text": "all", "value": ".+", "selected": true},
        {"text": "consumer", "value": "consumer"},
        {"text": "developer", "value": "developer"},
        {"text": "internal-foundry", "value": "internal-foundry"}
      ], "label": "Audience"},
      {"name": "pack", "type": "query", "datasource": "Mimir",
       "query": "label_values(oya_intelligence_dispatch_total, pack)", "refresh": 1, "label": "Pack"}
    ]
  },
  "panels": [
    {"id": 1, "type": "stat", "title": "Dispatch availability (30d)", "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
     "targets": [{"expr": "oya:intelligence_dispatch_availability{audience=~\"$audience\",pack=~\"$pack\"}", "refId": "A"}],
     "fieldConfig": {"defaults": {"unit": "percentunit", "thresholds": {"steps": [
       {"color": "red", "value": 0}, {"color": "yellow", "value": 0.995}, {"color": "green", "value": 0.9995}]}}}},
    {"id": 2, "type": "stat", "title": "First-token p99 (consumer)", "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
     "targets": [{"expr": "histogram_quantile(0.99, sum(rate(oya_intelligence_first_token_latency_seconds_bucket{audience=\"consumer\",pack=~\"$pack\"}[5m])) by (le))", "refId": "A"}],
     "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"steps": [
       {"color": "green", "value": 0}, {"color": "yellow", "value": 1.5}, {"color": "red", "value": 2.0}]}}}},
    {"id": 3, "type": "stat", "title": "Audit-tap emit success", "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
     "targets": [{"expr": "oya:intelligence_audit_emission_success", "refId": "A"}],
     "fieldConfig": {"defaults": {"unit": "percentunit", "thresholds": {"steps": [
       {"color": "red", "value": 0}, {"color": "yellow", "value": 0.9999}, {"color": "green", "value": 0.99995}]}}}},
    {"id": 4, "type": "stat", "title": "Refusal rate (24h)", "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
     "targets": [{"expr": "sum(rate(oya_intelligence_dispatch_total{status=\"refused\",audience=~\"$audience\",pack=~\"$pack\"}[24h])) / sum(rate(oya_intelligence_dispatch_total{audience=~\"$audience\",pack=~\"$pack\"}[24h]))", "refId": "A"}],
     "fieldConfig": {"defaults": {"unit": "percentunit"}}},
    {"id": 5, "type": "timeseries", "title": "Dispatches/sec by audience", "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
     "targets": [{"expr": "sum(rate(oya_intelligence_dispatch_total{pack=~\"$pack\"}[5m])) by (audience)", "legendFormat": "{{audience}}", "refId": "A"}]},
    {"id": 6, "type": "timeseries", "title": "Dispatches/sec by provider", "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
     "targets": [{"expr": "sum(rate(oya_intelligence_dispatch_total{pack=~\"$pack\"}[5m])) by (provider)", "legendFormat": "{{provider}}", "refId": "A"}]},
    {"id": 7, "type": "timeseries", "title": "First-token latency p50/p95/p99", "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
     "targets": [
       {"expr": "histogram_quantile(0.5,  sum(rate(oya_intelligence_first_token_latency_seconds_bucket{pack=~\"$pack\"}[5m])) by (le))", "legendFormat": "p50", "refId": "A"},
       {"expr": "histogram_quantile(0.95, sum(rate(oya_intelligence_first_token_latency_seconds_bucket{pack=~\"$pack\"}[5m])) by (le))", "legendFormat": "p95", "refId": "B"},
       {"expr": "histogram_quantile(0.99, sum(rate(oya_intelligence_first_token_latency_seconds_bucket{pack=~\"$pack\"}[5m])) by (le))", "legendFormat": "p99", "refId": "C"}]},
    {"id": 8, "type": "timeseries", "title": "Streaming tok/s p99 (by provider)", "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8},
     "targets": [{"expr": "histogram_quantile(0.99, sum(rate(oya_intelligence_streaming_tokens_per_sec_bucket{pack=~\"$pack\"}[5m])) by (le, provider))", "legendFormat": "{{provider}}", "refId": "A"}]},
    {"id": 9, "type": "table", "title": "Recent refusals (sample)", "gridPos": {"x": 0, "y": 20, "w": 24, "h": 8},
     "targets": [{"expr": "topk(20, sum(rate(oya_intelligence_dispatch_total{status=\"refused\",pack=~\"$pack\"}[1h])) by (refusal_reason, gate, audience))", "format": "table", "refId": "A"}]}
  ]
}
