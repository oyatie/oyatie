{
  "title": "Ontology — Cedar Policy Coverage & Audit Chain Health",
  "uid": "ontology-cedar-policy-coverage",
  "schemaVersion": 38,
  "tags": ["ontology", "cedar", "audit-chain", "security"],
  "timezone": "browser",
  "refresh": "30s",
  "panels": [
    {
      "type": "stat",
      "title": "Cedar coverage % (Action Types with permit fragment)",
      "targets": [
        {
          "expr": "(count by () (oya_ontology_action_type_with_cedar_permit_total) / count by () (oya_ontology_action_type_registered_total)) * 100"
        }
      ],
      "thresholds": [{"color": "red", "value": 0}, {"color": "yellow", "value": 99.9}, {"color": "green", "value": 100}],
      "alert": {
        "name": "Cedar coverage < 100%",
        "conditions": [{"type": "query", "evaluator": {"type": "lt", "params": [100]}}]
      }
    },
    {
      "type": "stat",
      "title": "Audit chain completeness ratio (target 1.0)",
      "targets": [
        {
          "expr": "oya:ontology_audit_chain_completeness:rate"
        }
      ],
      "thresholds": [{"color": "red", "value": 0}, {"color": "yellow", "value": 0.999}, {"color": "green", "value": 1.0}],
      "alert": {
        "name": "Audit chain completeness < 1.0 over 5min",
        "conditions": [{"type": "query", "evaluator": {"type": "lt", "params": [1.0]}}]
      }
    },
    {
      "type": "timeseries",
      "title": "Cedar evaluation duration p99 (target ≤ 10ms)",
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(oya_ontology_cedar_evaluation_duration_seconds_bucket[5m])))"
        }
      ],
      "alert": {
        "name": "Cedar evaluation p99 > 10ms (runaway risk)",
        "conditions": [{"type": "query", "evaluator": {"type": "gt", "params": [0.010]}}]
      }
    },
    {
      "type": "timeseries",
      "title": "Cedar deny rate (by deny_reason)",
      "targets": [
        {
          "expr": "rate(oya_ontology_cedar_deny_total[5m])",
          "legendFormat": "{{deny_reason}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Audit chain seal cadence (rate of new Merkle roots)",
      "targets": [
        {
          "expr": "rate(oya_ontology_audit_chain_seal_total[5m])",
          "legendFormat": "{{tenant_id_hashed}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Cross-tenant unauthorized read attempts (target = 0)",
      "targets": [
        {
          "expr": "rate(oya_ontology_tenant_unauthorized_read_attempt_total[5m])"
        }
      ],
      "alert": {
        "name": "Cross-tenant unauthorized read > 0",
        "conditions": [{"type": "query", "evaluator": {"type": "gt", "params": [0]}}]
      }
    },
    {
      "type": "timeseries",
      "title": "Cross-tenant Link Type denied (target = 0 unless explicit grant)",
      "targets": [
        {
          "expr": "rate(oya_ontology_cross_tenant_link_denied_total[5m])"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Cross-pillar unauthorized total (target = 0)",
      "targets": [
        {
          "expr": "rate(oya_ontology_cross_pillar_unauthorized_total[5m])"
        }
      ],
      "alert": {
        "name": "Cross-pillar unauthorized > 0",
        "conditions": [{"type": "query", "evaluator": {"type": "gt", "params": [0]}}]
      }
    },
    {
      "type": "timeseries",
      "title": "Audit chain Merkle tamper detection (target = 0)",
      "targets": [
        {
          "expr": "rate(oya_ontology_audit_chain_merkle_tamper_total[5m])"
        }
      ],
      "alert": {
        "name": "Merkle tamper > 0 (Sev-1)",
        "conditions": [{"type": "query", "evaluator": {"type": "gt", "params": [0]}}]
      }
    },
    {
      "type": "stat",
      "title": "Ed25519 signing key age (days since last rotation)",
      "targets": [
        {
          "expr": "(time() - oya_ontology_signing_key_rotated_at) / 86400"
        }
      ],
      "thresholds": [{"color": "green", "value": 0}, {"color": "yellow", "value": 75}, {"color": "red", "value": 90}]
    },
    {
      "type": "timeseries",
      "title": "Cross-pillar grants in flight (with expires_at countdown)",
      "targets": [
        {
          "expr": "oya_ontology_cross_pillar_grants_active_count"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Outbox-to-Kafka lag (max consumer lag seconds)",
      "targets": [
        {
          "expr": "max(kafka_consumer_lag_seconds{group=\"ontology-audit-chain-worker\"})"
        }
      ],
      "thresholds": [{"color": "green", "value": 0}, {"color": "yellow", "value": 30}, {"color": "red", "value": 60}]
    }
  ]
}
