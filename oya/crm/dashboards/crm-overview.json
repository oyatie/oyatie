{
  "title": "Customer Relationship Management overview",
  "tags": [
    "erp",
    "crm",
    "account-master",
    "CRM"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "benchmarks": [
    "SAP CRM Customer Relationship Management",
    "Oracle Fusion Sales and Service",
    "Workday customer and service-workflow counterpart",
    "NetSuite CRM",
    "Microsoft Dynamics 365 Customer Engagement"
  ],
  "panels": [
    {
      "title": "account-master command rate",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(oya_crm_account_master_commands_total[5m])) by (tenant_id)"
        }
      ]
    },
    {
      "title": "account-master p99 latency",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(oya_crm_account_master_latency_seconds_bucket[5m])) by (le, tenant_id))"
        }
      ]
    },
    {
      "title": "account-master audit events",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(rate(audit_events_total{service=\"crm\",bounded_context=\"account-master\"}[5m]))"
        }
      ]
    }
  ]
}
