{
  "title": "Comms-Email — Reputation Monitoring",
  "uid": "comms-email-reputation-monitoring",
  "schemaVersion": 39,
  "tags": ["comms-email", "reputation"],
  "panels": [
    {"id": 1, "type": "stat", "title": "Tenants with reputation < 70",
     "targets": [{"expr": "count(oya_comms_email_reputation_score < 70)"}]},
    {"id": 2, "type": "timeseries", "title": "Top 10 tenants by reputation",
     "targets": [{"expr": "topk(10, oya_comms_email_reputation_score)"}]},
    {"id": 3, "type": "timeseries", "title": "Gmail Postmaster sender-reputation",
     "targets": [{"expr": "avg by (tenant_id) (oya_comms_email_gmail_postmaster_score)"}]},
    {"id": 4, "type": "timeseries", "title": "SNDS sender-reputation",
     "targets": [{"expr": "avg by (tenant_id) (oya_comms_email_snds_score)"}]},
    {"id": 5, "type": "table", "title": "Reputation-drop circuit-breaker engaged",
     "targets": [{"expr": "oya_comms_email_marketing_circuit_breaker_engaged{state=\"engaged\"}"}]}
  ],
  "binding_adrs": ["ADR-0201", "ADR-0263"]
}
