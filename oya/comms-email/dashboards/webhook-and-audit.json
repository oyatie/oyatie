{
  "title": "comms-email · webhook + audit emission",
  "description": "Webhook ingest rate, audit-chain emit lag, DLQ depth, schema-version distribution.",
  "tags": ["comms-email", "adr-0201", "adr-0145", "adr-0166", "events"],
  "panels": [
    {
      "title": "Webhook ingest rate (per provider)",
      "type": "graph",
      "targets": [
        {"expr": "sum by (provider) (rate(comms_email_webhook_ingest_total[5m]))"}
      ]
    },
    {
      "title": "Audit-chain emit lag p99 (ms)",
      "type": "graph",
      "targets": [
        {"expr": "histogram_quantile(0.99, sum by (le) (rate(comms_email_audit_emit_lag_ms_bucket[5m])))"}
      ],
      "thresholds": [{"value": 5000, "colorMode": "critical", "op": "gt"}]
    },
    {
      "title": "DLQ depth",
      "type": "stat",
      "targets": [
        {"expr": "comms_email_webhook_dlq_depth"}
      ],
      "thresholds": [{"value": 100, "colorMode": "warning", "op": "gt"}, {"value": 10000, "colorMode": "critical", "op": "gt"}]
    },
    {
      "title": "Schema-id distribution",
      "type": "piechart",
      "targets": [
        {"expr": "sum by (schema_id) (rate(comms_email_audit_emit_total[5m]))"}
      ]
    },
    {
      "title": "Signature verification fail rate",
      "type": "graph",
      "targets": [
        {"expr": "sum by (provider) (rate(comms_email_webhook_signature_failed_total[5m]))"}
      ]
    }
  ]
}
