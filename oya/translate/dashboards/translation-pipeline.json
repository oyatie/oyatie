{
  "$schema": "https://schemas.grafana.com/dashboard.json",
  "_meta": {
    "doc_class": "GrafanaDashboard",
    "microservice": "translate",
    "owner_team": "axis-translate + ops-sre-reliability",
    "audience": "tenant operator + axis-translate SRE",
    "tenant_scoped": true,
    "datasource": "per-pack Mimir; tenant-scoped via X-Scope-OrgID"
  },
  "uid": "translate-pipeline",
  "title": "translate: translation pipeline (request rate + latency + engine routing + TM hit rate)",
  "tags": ["translate", "pipeline", "engine-router", "tm-leverage", "burn-rate"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "templating": {
    "list": [
      {"name": "pack", "type": "custom", "label": "Pack",
        "options": [
          {"text": "pack-kr", "value": "kr", "selected": true},
          {"text": "pack-eu", "value": "eu"},
          {"text": "pack-us", "value": "us"},
          {"text": "pack-us-healthcare", "value": "us-hc"},
          {"text": "pack-jp", "value": "jp"},
          {"text": "pack-sg", "value": "sg"},
          {"text": "pack-au", "value": "au"},
          {"text": "pack-in", "value": "in"},
          {"text": "pack-br", "value": "br"},
          {"text": "pack-ae", "value": "ae"},
          {"text": "pack-ksa", "value": "ksa"},
          {"text": "pack-cn-stub", "value": "cn-stub"}
        ]},
      {"name": "tenant", "type": "query", "label": "Tenant",
        "query": "label_values(oya_translate_translation_request_total{pack=\"$pack\"}, tenant_id)"},
      {"name": "engine", "type": "custom", "label": "Engine",
        "options": [
          {"text": "all", "value": ".*", "selected": true},
          {"text": "in-house", "value": "in-house"},
          {"text": "anthropic", "value": "anthropic"},
          {"text": "openai", "value": "openai"},
          {"text": "google-translate", "value": "google-translate"},
          {"text": "deepl", "value": "deepl"}
        ]}
    ]
  },
  "panels": [
    {"id": 1, "type": "stat", "title": "Translation requests/sec (5m rate)",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "sum(rate(oya_translate_translation_request_total{pack=\"$pack\",tenant_id=\"$tenant\",result=\"success\"}[5m]))", "refId": "A"}]},

    {"id": 2, "type": "stat", "title": "p95 latency (s)",
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(oya_translate_translation_request_duration_seconds_bucket{pack=\"$pack\",tenant_id=\"$tenant\"}[5m])))", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"mode": "absolute", "steps": [{"value": null, "color": "green"}, {"value": 0.250, "color": "yellow"}, {"value": 0.400, "color": "red"}]}}}},

    {"id": 3, "type": "stat", "title": "p99 latency (s)",
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "histogram_quantile(0.99, sum by (le) (rate(oya_translate_translation_request_duration_seconds_bucket{pack=\"$pack\",tenant_id=\"$tenant\"}[5m])))", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"mode": "absolute", "steps": [{"value": null, "color": "green"}, {"value": 0.400, "color": "yellow"}, {"value": 0.800, "color": "red"}]}}}},

    {"id": 4, "type": "stat", "title": "Error rate (%, 5m)",
      "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "100 * sum(rate(oya_translate_translation_request_total{pack=\"$pack\",result=\"error\"}[5m])) / sum(rate(oya_translate_translation_request_total{pack=\"$pack\"}[5m]))", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percent", "thresholds": {"mode": "absolute", "steps": [{"value": null, "color": "green"}, {"value": 0.5, "color": "yellow"}, {"value": 5, "color": "red"}]}}}},

    {"id": 5, "type": "timeseries", "title": "Translation-request latency percentiles",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum by (le) (rate(oya_translate_translation_request_duration_seconds_bucket{pack=\"$pack\",tenant_id=\"$tenant\"}[5m])))", "legendFormat": "p50", "refId": "A"},
        {"expr": "histogram_quantile(0.95, sum by (le) (rate(oya_translate_translation_request_duration_seconds_bucket{pack=\"$pack\",tenant_id=\"$tenant\"}[5m])))", "legendFormat": "p95", "refId": "B"},
        {"expr": "histogram_quantile(0.99, sum by (le) (rate(oya_translate_translation_request_duration_seconds_bucket{pack=\"$pack\",tenant_id=\"$tenant\"}[5m])))", "legendFormat": "p99", "refId": "C"},
        {"expr": "histogram_quantile(0.999, sum by (le) (rate(oya_translate_translation_request_duration_seconds_bucket{pack=\"$pack\",tenant_id=\"$tenant\"}[5m])))", "legendFormat": "p999", "refId": "D"}
      ]},

    {"id": 6, "type": "piechart", "title": "Engine routing distribution (5m)",
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
      "targets": [{"expr": "sum by (vendor) (rate(oya_translate_engine_routed_total{pack=\"$pack\",tenant_id=\"$tenant\"}[5m]))", "legendFormat": "{{vendor}}", "refId": "A"}]},

    {"id": 7, "type": "timeseries", "title": "Per-engine availability (rolling 15m)",
      "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum by (vendor) (rate(oya_translate_engine_invocation_total{pack=\"$pack\",result=\"success\"}[15m])) / sum by (vendor) (rate(oya_translate_engine_invocation_total{pack=\"$pack\"}[15m]))", "legendFormat": "{{vendor}}", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "percentunit", "thresholds": {"mode": "absolute", "steps": [{"value": null, "color": "red"}, {"value": 0.99, "color": "yellow"}, {"value": 0.9995, "color": "green"}]}}}},

    {"id": 8, "type": "timeseries", "title": "TM hit rate (exact / ICE / fuzzy / none)",
      "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum(rate(oya_translate_tm_leverage_total{pack=\"$pack\",tenant_id=\"$tenant\",match=\"exact\"}[5m])) / sum(rate(oya_translate_tm_leverage_total{pack=\"$pack\",tenant_id=\"$tenant\"}[5m]))", "legendFormat": "exact", "refId": "A"},
        {"expr": "sum(rate(oya_translate_tm_leverage_total{pack=\"$pack\",tenant_id=\"$tenant\",match=\"ice\"}[5m])) / sum(rate(oya_translate_tm_leverage_total{pack=\"$pack\",tenant_id=\"$tenant\"}[5m]))", "legendFormat": "ICE", "refId": "B"},
        {"expr": "sum(rate(oya_translate_tm_leverage_total{pack=\"$pack\",tenant_id=\"$tenant\",match=\"fuzzy\"}[5m])) / sum(rate(oya_translate_tm_leverage_total{pack=\"$pack\",tenant_id=\"$tenant\"}[5m]))", "legendFormat": "fuzzy", "refId": "C"},
        {"expr": "sum(rate(oya_translate_tm_leverage_total{pack=\"$pack\",tenant_id=\"$tenant\",match=\"none\"}[5m])) / sum(rate(oya_translate_tm_leverage_total{pack=\"$pack\",tenant_id=\"$tenant\"}[5m]))", "legendFormat": "none", "refId": "D"}
      ],
      "fieldConfig": {"defaults": {"unit": "percentunit"}}},

    {"id": 9, "type": "timeseries", "title": "Per-engine RTT distribution (p99)",
      "gridPos": {"x": 0, "y": 20, "w": 12, "h": 8},
      "targets": [{"expr": "histogram_quantile(0.99, sum by (le, vendor) (rate(oya_translate_engine_rtt_seconds_bucket{pack=\"$pack\"}[5m])))", "legendFormat": "{{vendor}}", "refId": "A"}]},

    {"id": 10, "type": "timeseries", "title": "Router decision latency (in-process; p99 ≤ 5 ms)",
      "gridPos": {"x": 12, "y": 20, "w": 12, "h": 8},
      "targets": [{"expr": "histogram_quantile(0.99, sum by (le) (rate(oya_translate_router_decision_duration_seconds_bucket{pack=\"$pack\"}[5m])))", "legendFormat": "p99", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"mode": "absolute", "steps": [{"value": null, "color": "green"}, {"value": 0.003, "color": "yellow"}, {"value": 0.005, "color": "red"}]}}}},

    {"id": 11, "type": "stat", "title": "Burn-rate (fast 1h)",
      "gridPos": {"x": 0, "y": 28, "w": 6, "h": 4},
      "targets": [{"expr": "oya_promotion_burn_rate_fast_1h{microservice=\"translate\",pack=\"$pack\",sli=\"translation-request-latency\"}", "refId": "A"}],
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"value": null, "color": "green"}, {"value": 6, "color": "yellow"}, {"value": 14.4, "color": "red"}]}}}},

    {"id": 12, "type": "stat", "title": "Eligibility verdict",
      "gridPos": {"x": 6, "y": 28, "w": 6, "h": 4},
      "targets": [{"expr": "oya:current_verdict:by_microservice_env{microservice=\"translate\",pack=\"$pack\",environment=\"production\"}", "refId": "A"}]},

    {"id": 13, "type": "stat", "title": "Data-residency violations (must be 0)",
      "gridPos": {"x": 12, "y": 28, "w": 6, "h": 4},
      "targets": [{"expr": "increase(oya_translate_data_residency_violation_total{pack=\"$pack\"}[24h])", "refId": "A"}],
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"value": null, "color": "green"}, {"value": 1, "color": "red"}]}}}},

    {"id": 14, "type": "table", "title": "Top 10 noisy (tenant, language-pair, content-class)",
      "gridPos": {"x": 18, "y": 28, "w": 6, "h": 8},
      "targets": [{"expr": "topk(10, sum by (tenant_id, source_locale, target_locale, content_class) (rate(oya_translate_translation_request_total{pack=\"$pack\"}[5m])))", "format": "table", "refId": "A"}]},

    {"id": 15, "type": "timeseries", "title": "Cost by engine (USD/sec, 5m)",
      "gridPos": {"x": 0, "y": 32, "w": 12, "h": 8},
      "targets": [{"expr": "sum by (vendor) (rate(oya_translate_engine_cost_usd_total{pack=\"$pack\",tenant_id=\"$tenant\"}[5m]))", "legendFormat": "{{vendor}}", "refId": "A"}]}
  ]
}
