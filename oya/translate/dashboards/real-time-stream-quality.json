{
  "$schema": "https://schemas.grafana.com/dashboard.json",
  "_meta": {
    "doc_class": "GrafanaDashboard",
    "microservice": "translate",
    "owner_team": "axis-translate + axis-meet + ops-sre-reliability",
    "audience": "tenant operator + axis-translate SRE + accessibility-ops",
    "tenant_scoped": true,
    "datasource": "per-pack Mimir; tenant-scoped via X-Scope-OrgID"
  },
  "uid": "translate-realtime-stream",
  "title": "translate: real-time caption-translate stream quality",
  "tags": ["translate", "real-time", "captions", "accessibility", "ITU-T G.107", "WCAG"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {"from": "now-1h", "to": "now"},
  "templating": {
    "list": [
      {"name": "pack", "type": "custom", "label": "Pack",
        "options": [
          {"text": "pack-kr", "value": "kr", "selected": true},
          {"text": "pack-eu", "value": "eu"},
          {"text": "pack-us", "value": "us"},
          {"text": "pack-us-healthcare", "value": "us-hc"},
          {"text": "pack-jp", "value": "jp"}
        ]},
      {"name": "tenant", "type": "query", "label": "Tenant",
        "query": "label_values(oya_translate_caption_stream_chunk_total{pack=\"$pack\"}, tenant_id)"}
    ]
  },
  "panels": [
    {"id": 1, "type": "stat", "title": "Active stream sessions",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "sum(oya_translate_stream_session_active_total{pack=\"$pack\",tenant_id=\"$tenant\"})", "refId": "A"}]},

    {"id": 2, "type": "stat", "title": "Caption latency p99 (s)",
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "histogram_quantile(0.99, sum by (le) (rate(oya_translate_caption_stream_chunk_duration_seconds_bucket{pack=\"$pack\",tenant_id=\"$tenant\"}[5m])))", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"mode": "absolute", "steps": [{"value": null, "color": "green"}, {"value": 0.300, "color": "yellow"}, {"value": 0.400, "color": "red"}]}}}},

    {"id": 3, "type": "stat", "title": "Correction-replay drop rate",
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "sum(rate(oya_translate_stream_correction_replay_drops_total{pack=\"$pack\",tenant_id=\"$tenant\"}[5m]))", "refId": "A"}],
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"value": null, "color": "green"}, {"value": 0.1, "color": "yellow"}, {"value": 1, "color": "red"}]}}}},

    {"id": 4, "type": "stat", "title": "Audio quality MOS link (ITU-T G.107 E-model)",
      "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "avg(oya_meet_audio_mos_score{pack=\"$pack\",tenant_id=\"$tenant\"})", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "thresholds": {"mode": "absolute", "steps": [{"value": null, "color": "red"}, {"value": 3.6, "color": "yellow"}, {"value": 4.0, "color": "green"}]}}}},

    {"id": 5, "type": "timeseries", "title": "Caption latency percentiles",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum by (le) (rate(oya_translate_caption_stream_chunk_duration_seconds_bucket{pack=\"$pack\",tenant_id=\"$tenant\"}[5m])))", "legendFormat": "p50", "refId": "A"},
        {"expr": "histogram_quantile(0.95, sum by (le) (rate(oya_translate_caption_stream_chunk_duration_seconds_bucket{pack=\"$pack\",tenant_id=\"$tenant\"}[5m])))", "legendFormat": "p95", "refId": "B"},
        {"expr": "histogram_quantile(0.99, sum by (le) (rate(oya_translate_caption_stream_chunk_duration_seconds_bucket{pack=\"$pack\",tenant_id=\"$tenant\"}[5m])))", "legendFormat": "p99", "refId": "C"}
      ]},

    {"id": 6, "type": "timeseries", "title": "Correction rate (corrections / chunks)",
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
      "targets": [{"expr": "sum(rate(oya_translate_stream_correction_emitted_total{pack=\"$pack\",tenant_id=\"$tenant\"}[5m])) / sum(rate(oya_translate_caption_stream_chunk_total{pack=\"$pack\",tenant_id=\"$tenant\"}[5m]))", "legendFormat": "correction rate", "refId": "A"}]},

    {"id": 7, "type": "timeseries", "title": "Audio quality MOS link (G.107)",
      "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
      "targets": [{"expr": "oya_meet_audio_mos_score{pack=\"$pack\",tenant_id=\"$tenant\"}", "legendFormat": "MOS", "refId": "A"}]},

    {"id": 8, "type": "timeseries", "title": "Stream gateway queue depth per pod",
      "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8},
      "targets": [{"expr": "oya_translate_stream_gateway_queue_depth{pack=\"$pack\"}", "legendFormat": "{{pod}}", "refId": "A"}]},

    {"id": 9, "type": "timeseries", "title": "Chunker panic events (must be 0)",
      "gridPos": {"x": 0, "y": 20, "w": 12, "h": 8},
      "targets": [{"expr": "increase(oya_translate_chunker_panic_total{pack=\"$pack\"}[5m])", "legendFormat": "panic events / 5m", "refId": "A"}]},

    {"id": 10, "type": "timeseries", "title": "Foundry-runtime streaming endpoint p99",
      "gridPos": {"x": 12, "y": 20, "w": 12, "h": 8},
      "targets": [{"expr": "histogram_quantile(0.99, sum by (le) (rate(oya_foundry_runtime_capability_invocation_duration_seconds_bucket{capability=\"translate-stream-v1\",pack=\"$pack\"}[5m])))", "legendFormat": "foundry-runtime stream p99", "refId": "A"}]},

    {"id": 11, "type": "stat", "title": "Stream burn-rate (fast 1h)",
      "gridPos": {"x": 0, "y": 28, "w": 6, "h": 4},
      "targets": [{"expr": "oya_promotion_burn_rate_fast_1h{microservice=\"translate\",pack=\"$pack\",sli=\"real-time-caption-latency\"}", "refId": "A"}],
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"value": null, "color": "green"}, {"value": 6, "color": "yellow"}, {"value": 14.4, "color": "red"}]}}}},

    {"id": 12, "type": "stat", "title": "WCAG 2.2 AA caption-delivery (target: 100%)",
      "gridPos": {"x": 6, "y": 28, "w": 6, "h": 4},
      "targets": [{"expr": "100 * (sum(rate(oya_translate_caption_stream_chunk_total{pack=\"$pack\",result=\"delivered_within_budget\"}[5m])) / sum(rate(oya_translate_caption_stream_chunk_total{pack=\"$pack\"}[5m])))", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percent", "thresholds": {"mode": "absolute", "steps": [{"value": null, "color": "red"}, {"value": 99, "color": "yellow"}, {"value": 99.9, "color": "green"}]}}}},

    {"id": 13, "type": "table", "title": "Top 10 stream sessions by chunk lag",
      "gridPos": {"x": 12, "y": 28, "w": 12, "h": 8},
      "targets": [{"expr": "topk(10, max by (session_id) (oya_translate_stream_session_lag_seconds{pack=\"$pack\",tenant_id=\"$tenant\"}))", "format": "table", "refId": "A"}]}
  ]
}
