String requireRealCiImageDigest(String variableName) {
  String digest = env[variableName]?.trim()
  if (!digest) {
    throw new IllegalStateException("${variableName} must be set before rendering the Jenkins Kubernetes agent pod")
  }
  if (!(digest ==~ /^sha256:[0-9a-f]{64}$/) || digest ==~ /^sha256:0{64}$/) {
    throw new IllegalStateException("${variableName} must be a real non-zero sha256 digest")
  }
  return digest
}

pipeline {
  agent {
    kubernetes {
      defaultContainer 'rust'
      yaml """
apiVersion: v1
kind: Pod
metadata:
  labels:
    oyatie.com/ci-substrate: jenkins
    oyatie.com/adr: ADR-0349
  annotations:
    cosign.sigstore.dev/required: "true"
    oyatie.com/image-promotion: ADR-0181
spec:
  runtimeClassName: kata-cloud-hypervisor
  containers:
    - name: rust
      # Jenkins injects OYA_CI_RUST_IMAGE_DIGEST from ADR-0181 release automation; no fake digest is committed.
      image: registry.oyatie.dev/ci/rust:stable@${requireRealCiImageDigest('OYA_CI_RUST_IMAGE_DIGEST')}
      imagePullPolicy: IfNotPresent
      command:
        - cat
      tty: true
      securityContext:
        allowPrivilegeEscalation: false
        capabilities:
          drop:
            - ALL
"""
    }
  }

  options {
    timestamps()
    ansiColor('xterm')
    disableConcurrentBuilds()
  }

  environment {
    OYA_SERVICE_ROOT = 'oya'
    OYA_SERVICE = 'quality-management'
    OYA_REQUIRED_CONTEXT = 'oya-ci-required'
    OYA_AUTHORITY_BOUNDARY = 'bridge_only_not_branch_protection_authority'
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Buck2 authority policy') {
      steps {
        container('rust') {
          sh 'buck2 build //:buck2-authority-policy-check'
        }
      }
    }

    stage('Buck2 affected build and test') {
      steps {
        container('rust') {
          sh 'infra/ci/buck2-affected-gate.sh "origin/${CHANGE_TARGET:-dev}"'
        }
      }
    }

    stage('Emit Buck2 bridge evidence') {
      steps {
        container('rust') {
          sh '''
set -eu
evidence_dir="evidence/ci/jenkins/${OYA_SERVICE_ROOT}/${OYA_SERVICE}"
mkdir -p "$evidence_dir"
cat > "$evidence_dir/buck2-authority-bridge.json" <<JSON
{
  "schema_version": "2026-06-02",
  "service_root": "${OYA_SERVICE_ROOT}",
  "service": "${OYA_SERVICE}",
  "ci_substrate": "jenkins-lts-bridge",
  "authority_boundary": "${OYA_AUTHORITY_BOUNDARY}",
  "required_context_target": "${OYA_REQUIRED_CONTEXT}",
  "claim_boundary": {
    "branch_protection_authority": false,
    "phase0_complete": false
  },
  "lanes": [
    "buck2 build //:buck2-authority-policy-check",
    "infra/ci/buck2-affected-gate.sh origin/${CHANGE_TARGET:-dev}"
  ],
  "build_url": "${BUILD_URL:-local}",
  "git_commit": "${GIT_COMMIT:-unknown}",
  "image_signature_policy": "cosign-required"
}
JSON
'''
        }
      }
    }
  }

  post {
    always {
      archiveArtifacts artifacts: "evidence/ci/jenkins/${OYA_SERVICE_ROOT}/${OYA_SERVICE}/buck2-authority-bridge.json", allowEmptyArchive: false
    }
  }
}
