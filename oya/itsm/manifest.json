    "ServiceNow ITSM (Washington DC family + Vancouver release; ITSM Pro + CMDB + Now Assist)",
    "Atlassian Jira Service Management (Cloud Enterprise; Assets formerly Insight; Atlassian Intelligence)",
    "Freshservice (Enterprise tier; Freddy AI; Orchestration Center)"
  ],
  "second_tier_counterparts": [
    "BMC Helix ITSM",
    "Ivanti Neurons for ITSM",
    "SolarWinds Service Desk",
    "Zendesk Support",
    "PagerDuty",
    "Opsgenie",
    "FireHydrant"
