  "dr_tier": "T1",
  "title": "IT Service Management",
  "status": "wave-15a-remediation-2026-05-21",
  "date": "2026-05-21",
  "audience_type": "tenant-b2b-it",
  "binding_adrs": [
    "ADR-0064",
    "ADR-0105",
    "ADR-0131",
    "ADR-0132",
    "ADR-0145",
