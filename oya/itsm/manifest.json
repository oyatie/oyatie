  "cell_eligibility": {
    "eligible_infrastructure_tiers": [
      "tier-1",
      "tier-2",
      "tier-3"
    ],
    "infrastructure_tier_authority": "ADR-0248 Amazon cellular Tiers 0-4 (infrastructure availability tiers, NOT capability tiers)",
    "tenant_home_cell_required": true,
    "sovereign_pack_overrides_allowed": true,
    "cross_cell_replication": "metadata-only-unless-pack-allows",
    "shuffle_sharding_per_tenant_class": "demo_trial=shared-pool-cell; paid=dedicated-shard-min-3-cells",
    "isolation": "cloud-hypervisor-plus-kata-containers"
  },
  "layer_enum_conformance": {
    "source": "ADR-0105",
    "layer_count": 13,
    "contract_versions": {
      "rest": "OpenAPI 3.2.0",
      "events": "AsyncAPI 3.1.0",
      "grpc": "proto3 over HTTP/3 per ADR-0253",
      "naming": "BNF v4.1"
    },
    "declared_layers": [
      "api",
      "rest",
      "grpc",
      "asyncapi",
      "application",
      "usecase",
      "domain",
      "kernel",
      "adapter",
      "worker",
      "scheduler",
      "governance",
      "evidence"
    ]
  },
  "tenant_class_support": {
    "authority": "ADR-0331 + feedback_tenant_class_demo_trial_vs_paid_per_seat_usage_2026_05_20",
    "demo_trial": true,
    "paid": true,
    "demo_trial_caps": {
      "tickets_per_month": 500,
      "cmdb_cis": 200,
      "workflow_executions_per_month": 1000,
      "agent_seats": 3,
      "knowledge_articles": 50,
      "ai_deflection_attempts_per_month": 200,
      "attachment_storage_gigabytes": 5,
      "mobile_api_calls_per_month": 5000
    },
    "demo_trial_time_window_days": 60,
    "demo_trial_to_paid_conversion_flow": "tenant submits paid_activation event; billing-µservice issues per_seat license; ITSM unlocks caps; compliance packs may be activated per ADR-0251",
    "demo_trial_compliance_packs_blocked": [
      "SOC-2",
      "ISO-27001",
      "GDPR",
      "KR-PIPA",
      "FedRAMP-High",
      "HIPAA"
    ],
    "demo_trial_slo_posture": "best-effort; no contractual SLO; published on status-update bounded context only",
    "paid_billing_components": [
      "revenue_share",
      "per_seat",
      "per_usage"
    ],
    "paid_slo_posture": "contractual; published in slos/*.openslo.yaml; breach detection in IP-030",
    "paid_meter_shape": {
      "per_seat": "agent_seats_provisioned_max_in_period",
      "per_usage": [
        "tickets_created_per_month",
        "cmdb_cis_stored_per_month",
        "workflow_executions_per_month",
        "ai_deflection_attempts_per_month",
        "attachment_storage_gigabyte_months",
        "mobile_api_calls_per_month"
      ],
      "revenue_share": "service-catalog marketplace listings sold through Oyatie marketplace DealSet settlement per ADR-0314"
    },
    "byok": {
      "authority": "ADR-0255 §D-4",
      "provider_credential_mode": "platform_default | byok | byok_required_by_pack",
      "demo_trial_default": "platform_default",
      "paid_default": "platform_default",
      "paid_byok_optional": true,
      "byok_required_packs": [
        "FedRAMP-High",
        "HIPAA"
      ]
    }
  },
  "compliance_packs": [
    "SOC-2",
    "ISO-27001",
    "ITIL",
    "GDPR",
    "KR-PIPA",
    "FedRAMP-High",
    "HIPAA"
  ],
  "compliance_pack_authority": "ADR-0251 + ADR-0250 (build-ahead-of-certification)",
  "naming_justifications": "itsm is a BNF v4.1 kebab-case microservice slug. Per ADR-0131 flat layout the µservice composes five bounded-context crates: oya-itsm-on-call-schedule, oya-itsm-escalation-policy, oya-itsm-incident-room, oya-itsm-status-update, oya-itsm-postmortem. Layer slugs draw from ADR-0105's 13-layer enum.",
  "owner_team": "axis-itsm + council-product",
  "data_classification": "tenant-scoped operational records with audit evidence",
  "depends_on_microservices": [
    "workflow-engine",
    "tasks",
    "community",
    "ontology",
    "observability",
    "audit-chain",
    "identity",
    "cmdb",
    "change-management",
    "intelligence",
    "marketplace",
    "tenancy",
    "cloud-cell",
    "billing"
  ],
  "failure_domain": "cell-aware service eligible for infrastructure tier-1, tier-2, tier-3",
  "criticality_tier": "product-critical",
  "layer": "umbrella",
  "doc_class": "Machine-Readable-Spec",
  "oyatie_is_a_tenant": {
    "authority": "ADR-0242 KS#1",
    "reserved_namespace": "oyatie.it-ops.*",
    "use_cases": [
      "internal incident management for the Foundry pipeline",
      "internal CMDB for cell + cluster + tenant inventory",
      "internal CAB approvals for cross-µservice changes",
      "internal postmortems for production incidents",
      "internal status-page for tenant-facing degradation"
    ]
  },
  "foundry_absorption_posture": {
    "authority": "ADR-0247 + ADR-0255-amendment + ADR-0328 D-12",
    "absorbed_from_foundry": [
      "workflow-templates",
      "ontology-projection",
      "intelligence-routing"
    ],
    "self_modification_role_namespace": "oyatie.foundry.itsm.*",
    "principal_kinds_serviced": [
      "human_operator",
      "service_account",
      "agent_principal_cedar_gated"
    ]
  },
  "transport_posture": {
    "authority": "ADR-0253 KS#10",
    "default_protocol": "HTTP/3 over QUIC",
    "fallback_protocols": [
      "HTTP/2 over TLS 1.3",
      "HTTP/1.1 over TLS 1.3"
    ],
    "grpc_transport": "gRPC over HTTP/3",
    "tls": "TLS 1.3 with ECH + PQC hybrid (X25519MLKEM768) where negotiated",
    "alpn": [
      "h3",
      "h2"
    ]
  },
