  "intelligence_binding": {
    "authority": "ADR-0255 KS#14",
    "deflection_model": "tenant-isolated Llama-class instruct model via intelligence µservice substrate; per-pack residency overlay",
    "predictive_intelligence_calls": "intelligence µservice projection endpoint for ticket classification + assignment routing"
  },
  "audit_remediation_notes": "Per coherence-audit-2026-05-20.md Wave 15A: bounded-context plurality restored (5 contexts as separate crate members per ADR-0131); compliance pack roster reconciled (7 packs); counterpart roster reconciled (top-3 vs second-tier separated; xMatters removed; PagerDuty + Opsgenie + FireHydrant added); substrate dependencies extended (added cmdb + change-management + intelligence + marketplace + tenancy + cloud-cell + billing); tier-doctrine references removed (capability_profiles field deleted; tier_subtype deleted; tier_classification deleted; capability_profile_doctrine deleted; tier field deleted); tenant_class adoption authored; deployment_contexts authored; supported-oses pointer added; transport posture authored; foundry absorption authored; oyatie-is-a-tenant declared. See REMEDIATION-NOTES-2026-05-21.md for full fix log.",
  "capacity_model": {
    "baseline_cpu_per_tenant": 0.1,
    "baseline_ram_per_tenant": 224,
    "storage_per_tenant": 3,
    "connections_per_tenant": {
      "valkey": 5,
      "postgres": 5,
      "outbound_http": 18
    },
    "scaling_dimension": "per_request",
    "cell_placement_class": "Tier-3",
    "notes": "Tickets, changes, catalog requests, and CMDB lookups create operator/request load; the service is time-sensitive but still first-party product runtime."
  },
  "sharding_automation": {
    "autosharding": "control_plane_driven",
    "auto_rebalance": {
      "enabled": false,
      "trigger_load_skew_threshold_percent": 30,
      "honors_residency": true,
      "honors_compliance_packs": true,
      "audit_chain_emit": true
    },
    "dynamic_sharding": {
      "enabled": false,
      "hot_split_threshold_p99_ms": 50,
      "hot_split_utilization_threshold_percent": 80,
      "cold_merge_utilization_threshold_percent": 20,
      "cold_merge_minimum_quiet_hours": 24,
      "audit_chain_emit": true
    }
  },
  "dr": {
    "rto_p99_seconds": 3600,
    "rpo_p99_seconds": 300,
    "multi_region_active_active": true,
