{
  "title": "Analytics — Ingest Pipeline",
  "uid": "analytics-ingest-pipeline",
  "tags": ["analytics", "ingest", "kafka", "mv", "adr-0195"],
  "timezone": "UTC",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {"from": "now-3h", "to": "now"},
  "templating": {
    "list": [
      {"name": "cluster", "type": "query", "query": "label_values(ClickHouseAsyncMetrics_Uptime, cluster)", "datasource": "Prometheus"}
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Ingest lag p99",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "histogram_quantile(0.99, sum by (le) (rate(oya_analytics_mv_lag_seconds_bucket{cluster=\"$cluster\"}[5m])))", "legendFormat": "p99"}],
      "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"steps": [{"value": 0, "color": "green"}, {"value": 5, "color": "yellow"}, {"value": 30, "color": "red"}]}}}
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Rows ingested / sec",
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "sum(rate(ClickHouseProfileEvents_InsertedRows{cluster=\"$cluster\"}[5m]))", "legendFormat": "rows/s"}]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Kafka consumer lag (messages)",
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "sum(clickhouse_kafka_consumer_lag{cluster=\"$cluster\"})"}],
      "fieldConfig": {"defaults": {"thresholds": {"steps": [{"value": 0, "color": "green"}, {"value": 10000, "color": "yellow"}, {"value": 100000, "color": "red"}]}}}
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Merge backlog (parts in queue)",
      "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "sum(ClickHouseMetrics_PartsActive{cluster=\"$cluster\"}) - sum(ClickHouseMetrics_PartsCommitted{cluster=\"$cluster\"})"}]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "MV lag — last 3h",
      "gridPos": {"x": 0, "y": 4, "w": 24, "h": 8},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum by (le, mv_name) (rate(oya_analytics_mv_lag_seconds_bucket{cluster=\"$cluster\"}[5m])))", "legendFormat": "p50 {{mv_name}}"},
        {"expr": "histogram_quantile(0.99, sum by (le, mv_name) (rate(oya_analytics_mv_lag_seconds_bucket{cluster=\"$cluster\"}[5m])))", "legendFormat": "p99 {{mv_name}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "s"}}
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Kafka consumer lag per partition",
      "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
      "targets": [
        {"expr": "max by (partition) (clickhouse_kafka_consumer_lag{cluster=\"$cluster\"})", "legendFormat": "p{{partition}}"}
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "MV insertion errors",
      "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum by (mv_name) (rate(oya_analytics_mv_insertion_errors_total{cluster=\"$cluster\"}[5m]))", "legendFormat": "{{mv_name}}"}
      ]
    },
    {
      "id": 8,
      "type": "table",
      "title": "Top 10 MV-target tables by row growth",
      "gridPos": {"x": 0, "y": 20, "w": 24, "h": 6},
      "targets": [
        {"expr": "topk(10, sum by (database, table) (rate(ClickHouseProfileEvents_InsertedRows{cluster=\"$cluster\"}[15m])))"}
      ]
    }
  ]
}
