{
  "$schema": "https://grafana.com/schemas/dashboard-v10.json",
  "title": "Analytics ClickHouse Overview",
  "uid": "analytics-clickhouse-overview",
  "tags": ["analytics", "clickhouse", "adr-0193"],
  "timezone": "UTC",
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Cluster health",
      "targets": [
        {
          "expr": "count(up{job=\"clickhouse\"} == 1)",
          "legendFormat": "ready replicas"
        }
      ],
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4}
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Query p99 latency (ms)",
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(ClickHouseProfileEvents_QueryTimeMicroseconds_bucket[5m])) by (le)) / 1000",
          "legendFormat": "p99 ms"
        }
      ],
      "gridPos": {"x": 6, "y": 0, "w": 12, "h": 8}
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Ingest lag (s)",
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(ClickHouseMetrics_AsyncInsertCacheLastAddedAge_bucket[5m])) by (le))",
          "legendFormat": "p99 lag"
        }
      ],
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8}
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Replication lag (s)",
      "targets": [
        {
          "expr": "max(ClickHouseAsyncMetrics_ReplicasMaxAbsoluteDelay)",
          "legendFormat": "max delay"
        }
      ],
      "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8}
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Keeper leader present",
      "targets": [
        {
          "expr": "sum(clickhouse_keeper_is_leader == 1)",
          "legendFormat": "leader count"
        }
      ],
      "gridPos": {"x": 0, "y": 16, "w": 6, "h": 4}
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Part merge backlog",
      "targets": [
        {
          "expr": "max(ClickHouseMetrics_PartsDelayInsert)",
          "legendFormat": "parts queued"
        }
      ],
      "gridPos": {"x": 6, "y": 16, "w": 12, "h": 8}
    }
  ]
}
