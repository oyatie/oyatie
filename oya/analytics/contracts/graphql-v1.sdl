# Oyatie Analytics µservice — GraphQL schema (v1).
# Authority: ADR-0193, ADR-0157 API gateway, ADR-0150 cursor pagination.
# Tier-A 4-INV: Cursor pagination via Relay-style connections.

schema {
  query: Query
}

"Tenant-scoped analytics queries."
type Query {
  "Per-hour workflow execution rollups for the calling tenant."
  workflowExecutionDashboard(
    from: DateTime!
    to: DateTime!
    first: Int = 50
    after: Cursor
  ): WorkflowExecutionConnection!

  "Per-day billing rollup for the calling tenant."
  billingRollup(
    from: Date!
    to: Date!
    first: Int = 50
    after: Cursor
  ): BillingRollupConnection!

  "Tenant-scoped audit-log search."
  auditLog(
    axis: Axis = ALL
    eventType: String
    principalId: String
    from: DateTime!
    to: DateTime!
    first: Int = 50
    after: Cursor
  ): AuditLogConnection!
}

# === Scalars ===

"RFC 3339 timestamp."
scalar DateTime

"ISO 8601 date (YYYY-MM-DD)."
scalar Date

"Opaque, HMAC-signed pagination cursor (per ADR-0150)."
scalar Cursor

# === Connection types ===

type WorkflowExecutionConnection {
  edges: [WorkflowExecutionEdge!]!
  pageInfo: PageInfo!
  totalCount: Int
}

type WorkflowExecutionEdge {
  cursor: Cursor!
  node: WorkflowExecutionBucket!
}

type WorkflowExecutionBucket {
  hour: DateTime!
  tenantId: String!
  runCount: Int!
  durationP50Ms: Int
  durationP95Ms: Int
  durationP99Ms: Int
  errorCount: Int!
}

type BillingRollupConnection {
  edges: [BillingRollupEdge!]!
  pageInfo: PageInfo!
}

type BillingRollupEdge {
  cursor: Cursor!
  node: BillingRollupRow!
}

type BillingRollupRow {
  day: Date!
  tenantId: String!
  resourceType: String!
  count: Int!
}

type AuditLogConnection {
  edges: [AuditLogEdge!]!
  pageInfo: PageInfo!
}

type AuditLogEdge {
  cursor: Cursor!
  node: AuditLogEntry!
}

type AuditLogEntry {
  eventId: ID!
  emittedAt: DateTime!
  tenantId: String!
  axis: Axis!
  eventType: String!
  principalId: String!
  evidenceRef: String
  payloadHash: String
}

type PageInfo {
  hasNextPage: Boolean!
  endCursor: Cursor
}

enum Axis {
  ALL
  AUTH
  WORKFLOW
  BILLING
  TENANCY
  COMPLIANCE
}
