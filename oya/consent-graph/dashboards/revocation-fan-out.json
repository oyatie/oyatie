{
  "title": "consent-graph — Revocation fan-out",
  "uid": "consent-graph-revocation-fanout",
  "schemaVersion": 39,
  "tags": ["consent-graph", "HG-CONSENT", "revocation", "SLO"],
  "timezone": "utc",
  "refresh": "15s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "type": "gauge",
      "title": "Revocation-propagation SLO (p99 ≤1s)",
      "targets": [{ "expr": "oya_slo_budget_remaining_ratio{slo=\"oya-consent-graph-revocation-propagation-latency\"}" }],
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 }
    },
    {
      "type": "timeseries",
      "title": "Revocation propagation p99 by subscriber",
      "targets": [{ "expr": "histogram_quantile(0.99, sum by (subscriber_service, le) (rate(oya_consent_graph_revocation_propagation_seconds_bucket[5m])))" }],
      "gridPos": { "h": 8, "w": 16, "x": 8, "y": 0 }
    },
    {
      "type": "stat",
      "title": "Originated (1h)",
      "targets": [{ "expr": "sum(increase(oya_consent_graph_revocation_originated_total[1h]))" }],
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 8 }
    },
    {
      "type": "stat",
      "title": "PartiallyPropagated (1h)",
      "targets": [{ "expr": "sum(increase(oya_consent_graph_revocation_partially_propagated_total[1h]))" }],
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 8 }
    },
    {
      "type": "stat",
      "title": "Failed (1h)",
      "targets": [{ "expr": "sum(increase(oya_consent_graph_revocation_failed_total[1h]))" }],
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 8 }
    },
    {
      "type": "stat",
      "title": "Pulsar geo-rep lag (revocation topic)",
      "targets": [{ "expr": "max(oya_pulsar_geo_replication_lag_seconds{topic=\"oya.consent-graph.revocation.v1\"})" }],
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 8 }
    },
    {
      "type": "table",
      "title": "Receipts by subscriber × region",
      "targets": [{ "expr": "sum by (subscriber_service, subscriber_region, action_taken) (rate(oya_consent_graph_revocation_receipt_total[5m]))" }],
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 12 }
    }
  ]
}
