{
  "schema_version": "1.0",
  "microservice": "consent-graph",
  "tier": "substrate",
  "tier_subtype": "substrate-consent",
  "dr_tier": "T1",
  "substrate_dag_position": {
    "stratum": "S3",
    "depends_on": [],
    "consumed_by_substrates": [],
    "_note": "forward-declared per ADR-0280 Appendix C; edges land in DAG v1.1.0"
  },
  "version": "0.1.0",
  "owner": "axis-consent-graph",
  "authority_adr": "docs/decisions/ADR-0702-identity-authz-live-apex.md",
  "layout_authority": "docs/decisions/ADR-0701-monorepo-capability-live-apex.md",
  "grouping_policy": "docs/decisions/ADR-0705-product-protocol-live-apex.md",
  "summary": "Cross-tenant real-time visibility kernel. First-class DataSharingAgreement entity + Cedar enforcement + bilateral audit chain + zero-copy ontology projection + real-time revocation.",
  "bounded_contexts": [
    {
      "name": "agreement",
      "description": "DataSharingAgreement CRUD + lifecycle state machine (Drafted/Offered/Accepted/Active/Suspended/Revoked/Expired)",
      "crates": []
    },
    {
      "name": "enforcement",
      "description": "Cedar policy evaluation gate for every cross-tenant hop. Deny-by-default. p99 ≤10ms.",
      "crates": []
    },
    {
      "name": "revocation",
      "description": "Real-time revocation propagation (p99 ≤1s) via Pulsar fan-out to all projection subscribers.",
      "crates": []
    },
    {
      "name": "projection-gateway",
      "description": "Mints per-(grantor,grantee,entity) Pulsar topics in grantor cluster; tenant-aware ACL; scope-narrowing + aggregate-mode emission.",
      "crates": []
    },
    {
      "name": "audit-bridge",
      "description": "Bilateral audit-chain event emission with cross-pointer linking (grantor-seq ↔ grantee-seq).",
      "crates": []
    },
    {
      "name": "partner-directory",
      "description": "Peer-tenant handshake, trust anchor registration, peer audit-chain Merkle root verification.",
      "crates": []
    }
  ],
  "layers": [
    "adapter",
    "api",
    "app",
    "domain",
    "kernel",
    "rest",
    "sdk",
    "usecase",
    "worker"
  ],
  "contracts": {
    "openapi": [
      "microservices/consent-graph/contracts/openapi/consent-graph.yaml"
    ],
    "asyncapi": [
      "microservices/consent-graph/contracts/asyncapi/consent-events.yaml"
    ],
    "internal_grpc": {
      "transport": "http2",
      "language_profile": "proto3",
      "contracts": [
        "oya/consent-graph/contracts/proto/consent-graph.proto"
      ]
    }
  },
  "capabilities": [
    {
      "tier": "T3",
      "name": "consent-grant",
      "file": "microservices/consent-graph/capabilities/consent-grant.yaml",
      "risk_class": "high",
