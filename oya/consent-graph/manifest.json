      "rationale": "Read-only Cedar evaluation; no data modification; deny-by-default failure mode."
    }
  ],
  "slos": [
    {
      "name": "oya-consent-graph-consent-grant-latency",
      "target": "0.95",
      "sli": "sum(rate(oya_consent_graph_grant_duration_seconds_bucket{le=\"2.0\"}[5m]))",
