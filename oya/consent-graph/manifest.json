  "ontology_projections": [
    {
      "entity_name": "DataSharingAgreement",
      "projection_target_table": "ontology_data_sharing_agreements",
      "projection_kind": "idempotent-rewrite",
      "lag_budget_seconds": 30
    },
    {
      "entity_name": "PartnerTenant",
      "projection_target_table": "ontology_partner_tenants",
      "projection_kind": "idempotent-rewrite",
      "lag_budget_seconds": 60
    },
    {
      "entity_name": "ProjectionTopic",
      "projection_target_table": "ontology_projection_topics",
      "projection_kind": "idempotent-rewrite",
      "lag_budget_seconds": 30
    }
  ],
  "cross_microservice_dependencies": [
    {
      "depends_on": "audit-chain",
      "via": "oya-audit-chain-emission-sdk",
      "reason": "Bilateral chain entries are sealed by audit-chain."
    },
    {
      "depends_on": "ontology",
      "via": "ontology cross-tenant projection extension (IP-CT-001..005)",
      "reason": "Cross-tenant projections flow through ontology projection topics."
    },
    {
      "depends_on": "observability",
      "via": "self-SLO emission",
      "reason": "9 self-SLOs registered with HG-CONSENT."
    },
    {
      "depends_on": "identity",
      "via": "principal/tenant resolution",
      "reason": "Cedar enforcement requires resolved principal+tenant."
    },
    {
      "depends_on": "api-gateway",
      "via": "north-south enforcement hook",
      "reason": "Public-facing cross-tenant reads pass through api-gateway → consent-graph."
    }
  ],
  "mesh_layering": {
    "cilium_l4": true,
    "ambient_ztunnel": true,
    "ambient_waypoint": true,
    "north_south_only": false
