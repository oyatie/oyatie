{
  "title": "Plugin App Store \u2014 Install flow",
  "uid": "oya-plugin-app-store-install-flow",
  "schemaVersion": 39,
  "panels": [
    {
      "id": 1,
      "title": "Install latency p99",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.99, rate(oya_plugin_app_store_install_duration_seconds_bucket[5m]))"
        }
      ]
    },
    {
      "id": 2,
      "title": "Install outcome rate (installed/failed/declined)",
      "type": "barchart",
      "targets": [
        {
          "expr": "sum by (outcome) (rate(oya_plugin_app_store_install_outcome_total[5m]))"
        }
      ]
    },
    {
      "id": 3,
      "title": "Cedar policy materialization latency",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.99, rate(oya_plugin_app_store_cedar_materialize_seconds_bucket[5m]))"
        }
      ]
    },
    {
      "id": 4,
      "title": "Per-plugin rate-limit 429s",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(oya_plugin_app_store_plugin_request_total{status=\"429\"}[5m])"
        }
      ]
    },
    {
      "id": 5,
      "title": "Revoke propagation p99",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.99, rate(oya_plugin_app_store_revoke_duration_seconds_bucket[5m]))"
        }
      ]
    }
  ]
}