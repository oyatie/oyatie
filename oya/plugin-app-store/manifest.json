{
  "schema_version": "1.0",
  "microservice": "plugin-app-store",
  "tier": "product",
  "tier_subtype": "product-developer-plugin-store",
  "dr_tier": "T1",
  "version": "0.0.1",
  "status": "seed",
  "seeded_date": "2026-05-18",
  "owner": "axis-ecosystem",
  "owner_council": "council-architecture",
  "doctrine": {
    "canonical_authority": "ADR-0213",
    "naming_reservation_note": "The substring 'marketplace' in oyatie µservice names is reserved for the future B2C commerce µservice (Amazon/Shopify class), per ADR-0213 §Disambiguation. This µservice (plugin/app distribution + vetting + per-plugin permissioning) is named plugin-app-store, NOT marketplace.",
    "in_house_roadmap_phase": "phase-1-target",
    "inheritance": [
      "Apple App Store — vetting + per-app permissions + sandbox + signature verification",
      "VS Code Marketplace — extension catalog + per-extension permissions + signed artifacts",
      "Shopify App Store — per-install model + scopes + subscription management",
      "AWS Marketplace (SaaS + AMI) — vetted catalog + per-account procurement + billing aggregation",
      "Salesforce AppExchange — enterprise vetting (security review)",
      "JetBrains Marketplace — paid plugins + revenue share + per-plugin signing"
    ]
  },
  "bounded_contexts": [
    {
      "name": "plugin-catalog",
      "description": "Public catalog of published plugins/apps; browse + search + category tree + ratings.",
      "crates": [],
      "status": "planned"
    },
    {
      "name": "plugin-install",
      "description": "Tenant-scoped install + uninstall + per-plugin permission grant; produces plugin installation records.",
      "crates": [],
      "status": "planned"
    },
    {
      "name": "plugin-lifecycle",
      "description": "Version state machine: draft → submitted → vetting → published → deprecated → retired (+ revoked kill-switch).",
      "crates": [],
      "status": "planned"
    },
    {
      "name": "vetting-pipeline",
      "description": "Cosign verification + Trivy + Wasmtime-isolation validator + capability-scope + data-use-boundary + WCAG + AI-Act class + perf budget.",
      "crates": [],
      "status": "planned"
    },
    {
      "name": "per-plugin-permissions",
      "description": "Per-plugin Cedar policy fragment generation + tenant install-time permission grant capture.",
      "crates": [],
      "status": "planned"
    },
    {
      "name": "per-plugin-rate-limit",
      "description": "Per-installation rate-limit enforcement (default 100 req/s; per-plugin override with admin approval).",
      "crates": [],
      "status": "planned"
    },
    {
      "name": "subscription-billing",
      "description": "Per-plugin subscription state machine + tenant billing aggregation feeding finops-portal; one-time + recurring.",
      "crates": [],
      "status": "planned"
    },
    {
      "name": "audit-stream",
      "description": "Per-plugin action audit trail; every action seals via audit-chain µservice (ADR-0003).",
      "crates": [],
      "status": "planned"
    }
  ],
