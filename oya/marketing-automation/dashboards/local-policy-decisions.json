{
  "schemaVersion": 39,
  "title": "Marketing Automation local policy decisions",
  "tags": [
    "marketing-automation",
    "local-operational-primitive",
    "adr-0130"
  ],
  "timezone": "utc",
  "templating": {
    "list": [
      {
        "name": "tenant_id",
        "type": "query",
        "query": "label_values(oya_marketing_automation_suppression_enforcement_total, tenant_id)"
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Suppression entries applied before send fanout burn",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(rate(oya_marketing_automation_suppression_enforcement_good_total[30d])) by (tenant_id, cell_tier) / sum(rate(oya_marketing_automation_suppression_enforcement_total[30d])) by (tenant_id, cell_tier)",
          "legendFormat": "suppression-enforcement ratio"
        }
      ]
    },
    {
      "id": 2,
      "title": "Journey trigger evaluation latency burn",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(oya_marketing_automation_journey_trigger_latency_good_total[5m])) by (tenant_id, cell_tier) / sum(rate(oya_marketing_automation_journey_trigger_latency_total[5m])) by (tenant_id, cell_tier)",
          "legendFormat": "journey-trigger-latency ratio"
        }
      ]
    },
    {
      "id": 3,
      "title": "Consent changes propagated to audience segments burn",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(rate(oya_marketing_automation_consent_propagation_good_total[1h])) by (tenant_id, cell_tier) / sum(rate(oya_marketing_automation_consent_propagation_total[1h])) by (tenant_id, cell_tier)",
          "legendFormat": "consent-propagation ratio"
        }
      ]
    },
    {
      "id": 4,
      "title": "Attribution rollups available for active campaigns burn",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(oya_marketing_automation_attribution_freshness_good_total[1h])) by (tenant_id, cell_tier) / sum(rate(oya_marketing_automation_attribution_freshness_total[1h])) by (tenant_id, cell_tier)",
          "legendFormat": "attribution-freshness ratio"
        }
      ]
    },
    {
      "id": 5,
      "title": "Campaign send acceptance latency burn",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(rate(oya_marketing_automation_send_latency_good_total[5m])) by (tenant_id, cell_tier) / sum(rate(oya_marketing_automation_send_latency_total[5m])) by (tenant_id, cell_tier)",
          "legendFormat": "send-latency ratio"
        }
      ]
    },
    {
      "id": 6,
      "title": "Accepted campaign messages that produce delivery evidence burn",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(oya_marketing_automation_deliverability_success_good_total[30d])) by (tenant_id, cell_tier) / sum(rate(oya_marketing_automation_deliverability_success_total[30d])) by (tenant_id, cell_tier)",
          "legendFormat": "deliverability-success ratio"
        }
      ]
    }
  ]
}
