{
  "$schema": "https://schemas.grafana.com/dashboard.json",
  "_meta": {
    "doc_class": "GrafanaDashboard",
    "microservice": "audit-chain",
    "owner_team": "ops-security + axis-audit-chain",
    "audience": "ops-security + ops-sre on-call",
    "tenant_scoped": false,
    "datasource": "Mimir oya-self + oya-aggregate"
  },
  "uid": "audit-chain-verification-failure-rate",
  "title": "Verification Failure Rate — Tamper Detection",
  "tags": ["audit-chain", "verification", "security", "sev1"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {"from": "now-1h", "to": "now"},
  "templating": {
    "list": [
      {
        "name": "pack",
        "type": "custom",
        "options": [
          {"text": "(all)", "value": ".*", "selected": true},
          {"text": "pack-kr", "value": "pack-kr"},
          {"text": "pack-eu", "value": "pack-eu"},
          {"text": "pack-us", "value": "pack-us"},
          {"text": "pack-us-healthcare", "value": "pack-us-healthcare"},
          {"text": "pack-jp", "value": "pack-jp"},
          {"text": "pack-sg", "value": "pack-sg"},
          {"text": "pack-au", "value": "pack-au"},
          {"text": "pack-in", "value": "pack-in"},
          {"text": "pack-br", "value": "pack-br"},
          {"text": "pack-ae", "value": "pack-ae"},
          {"text": "pack-ksa", "value": "pack-ksa"}
        ],
        "label": "Pack"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Verification failures (last 5m)",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "targets": [
        {"expr": "sum(increase(oya_audit_chain_verification_failed_total{pack=~\"$pack\"}[5m]))", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 1}, {"color": "red", "value": 10}]}}},
      "alert": {
        "name": "verification-failed-spike-sev1",
        "conditions": [{"evaluator": {"params": [0], "type": "gt"}, "query": {"params": ["A", "5m", "now"]}, "type": "query"}],
        "notifications": [{"uid": "grafana-oncall-sev1"}]
      }
    },
    {
      "id": 2,
      "type": "table",
      "title": "Verification failures by reason",
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
      "targets": [
        {"expr": "sum by (reason) (oya_audit_chain_verification_failed_total{pack=~\"$pack\"})", "format": "table", "refId": "A"}
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Verification rate (verified=true vs verified=false)",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "targets": [
        {"expr": "rate(oya_audit_chain_verification_total{pack=~\"$pack\", verified=\"true\"}[5m])", "legendFormat": "verified", "refId": "A"},
        {"expr": "rate(oya_audit_chain_verification_total{pack=~\"$pack\", verified=\"false\"}[5m])", "legendFormat": "failed", "refId": "B"}
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Anonymous verify probing rate (potential scan pattern)",
      "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
      "targets": [
        {"expr": "rate(oya_audit_chain_verification_total{pack=~\"$pack\", principal=\"anonymous\"}[5m])", "legendFormat": "anonymous {{reason}}", "refId": "A"}
      ]
    },
    {
      "id": 5,
      "type": "table",
      "title": "Recent VerificationFailed events (last 1h)",
      "gridPos": {"x": 0, "y": 20, "w": 12, "h": 8},
      "targets": [
        {"expr": "topk(20, oya_audit_chain_verification_failed_recent{pack=~\"$pack\"})", "format": "table", "refId": "A"}
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "HSM signing mismatch (Sev-1)",
      "gridPos": {"x": 0, "y": 28, "w": 12, "h": 8},
      "targets": [
        {"expr": "rate(oya_audit_chain_hsm_signing_mismatch_total{pack=~\"$pack\"}[5m])", "refId": "A"}
      ],
      "alert": {
        "name": "hsm-signing-mismatch-sev1",
        "conditions": [{"evaluator": {"params": [0], "type": "gt"}, "query": {"params": ["A", "1m", "now"]}, "type": "query"}],
        "notifications": [{"uid": "grafana-oncall-sev1"}]
      }
    }
  ]
}
