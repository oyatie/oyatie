{
  "$schema": "https://grafana.com/schemas/dashboard-v10.json",
  "title": "Foundry Milvus Overview",
  "uid": "foundry-milvus-overview",
  "tags": ["foundry", "milvus", "adr-0192"],
  "timezone": "UTC",
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Search p99 (ms)",
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(milvus_proxy_req_latency_bucket{operation=\"Search\"}[5m])) by (le)) * 1000",
          "legendFormat": "search p99"
        }
      ],
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4}
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Search QPS by collection",
      "targets": [
        {
          "expr": "sum(rate(milvus_proxy_req_count{operation=\"Search\"}[5m])) by (collection_name)",
          "legendFormat": "{{collection_name}}"
        }
      ],
      "gridPos": {"x": 6, "y": 0, "w": 18, "h": 8}
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Sealed segments (ingest backlog)",
      "targets": [
        {
          "expr": "max(milvus_datacoord_segment_num{state=\"Sealed\"})",
          "legendFormat": "sealed segments"
        }
      ],
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8}
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Coordinator pods up",
      "targets": [
        {
          "expr": "sum(up{job=~\"milvus-.*coord\"})",
          "legendFormat": "coord pods"
        }
      ],
      "gridPos": {"x": 12, "y": 8, "w": 6, "h": 4}
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Per-tenant collection vector count",
      "targets": [
        {
          "expr": "sum(milvus_proxy_collection_num_entities) by (collection_name)",
          "legendFormat": "{{collection_name}}"
        }
      ],
      "gridPos": {"x": 0, "y": 16, "w": 24, "h": 8}
    }
  ]
}
