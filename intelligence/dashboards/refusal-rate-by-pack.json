{
  "$schema": "https://schemas.grafana.com/dashboard.json",
  "_meta": {
    "doc_class": "GrafanaDashboard",
    "microservice": "intelligence",
    "owner_team": "council-privacy + axis-intelligence",
    "audience": "council-privacy + auditor",
    "tenant_scoped": false,
    "datasource": "Mimir (aggregate tenant 'oya-aggregate'; DP noise injected)"
  },
  "uid": "intel-refusal-rate-pack",
  "title": "Refusal rate by pack",
  "tags": ["intelligence", "refusal", "compliance"],
  "schemaVersion": 39,
  "refresh": "1m",
  "time": {"from": "now-7d", "to": "now"},
  "panels": [
    {"id": 1, "type": "timeseries", "title": "Refusal rate by pack", "gridPos": {"x": 0, "y": 0, "w": 24, "h": 8},
     "targets": [{"expr": "sum(rate(oya_intelligence_dispatch_total{status=\"refused\"}[1h])) by (pack) / sum(rate(oya_intelligence_dispatch_total[1h])) by (pack)", "legendFormat": "{{pack}}", "refId": "A"}]},
    {"id": 2, "type": "timeseries", "title": "Refusal reason breakdown (pack-eu)", "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
     "targets": [{"expr": "sum(rate(oya_intelligence_dispatch_total{status=\"refused\",pack=\"pack-eu\"}[1h])) by (refusal_reason)", "legendFormat": "{{refusal_reason}}", "refId": "A"}]},
    {"id": 3, "type": "timeseries", "title": "Refusal reason breakdown (pack-kr)", "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
     "targets": [{"expr": "sum(rate(oya_intelligence_dispatch_total{status=\"refused\",pack=\"pack-kr\"}[1h])) by (refusal_reason)", "legendFormat": "{{refusal_reason}}", "refId": "A"}]},
    {"id": 4, "type": "stat", "title": "EU AI Act Annex III refusals (7d)", "gridPos": {"x": 0, "y": 16, "w": 6, "h": 4},
     "targets": [{"expr": "sum(increase(oya_intelligence_dispatch_total{status=\"refused\",refusal_reason=~\"eu_ai_act_annex_iii_.+\"}[7d]))", "refId": "A"}]},
    {"id": 5, "type": "stat", "title": "PCI-scope refusals (7d)", "gridPos": {"x": 6, "y": 16, "w": 6, "h": 4},
     "targets": [{"expr": "sum(increase(oya_intelligence_dispatch_total{status=\"refused\",refusal_reason=\"pci_scope_refused\"}[7d]))", "refId": "A"}]},
    {"id": 6, "type": "stat", "title": "CSAM refusals (7d)", "gridPos": {"x": 12, "y": 16, "w": 6, "h": 4},
     "targets": [{"expr": "sum(increase(oya_intelligence_dispatch_total{status=\"refused\",refusal_reason=\"csam\"}[7d]))", "refId": "A"}]},
    {"id": 7, "type": "stat", "title": "Prompt-injection detections (7d)", "gridPos": {"x": 18, "y": 16, "w": 6, "h": 4},
     "targets": [{"expr": "sum(increase(oya_intelligence_prompt_injection_detected_total[7d]))", "refId": "A"}]}
  ]
}
