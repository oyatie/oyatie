{
  "$schema": "https://schemas.grafana.com/dashboard.json",
  "_meta": {
    "doc_class": "GrafanaDashboard",
    "microservice": "foundry-supervisor",
    "owner_team": "ops-security + axis-foundry-control-plane",
    "audience": "internal operators + DPOs (cross-tenant view requires admin RBAC)",
    "tenant_scoped": false,
    "datasource": "per-pack Mimir endpoints",
    "linked_slo": "kill-switch-engage.openslo.yaml (p99 ≤ 1s)"
  },
  "uid": "fnd-sup-kill-switch-coverage",
  "title": "Kill-Switch Coverage + Engage Latency",
  "tags": ["foundry-supervisor", "safety", "kill-switch", "EU-AI-Act"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {"from": "now-6h", "to": "now"},
  "templating": {
    "list": [
      {
        "name": "pack",
        "type": "custom",
        "options": [
          {"text": "pack-kr", "value": "kr", "selected": true},
          {"text": "pack-eu", "value": "eu"},
          {"text": "pack-us", "value": "us"},
          {"text": "pack-us-healthcare", "value": "us-hc"},
          {"text": "pack-jp", "value": "jp"},
          {"text": "pack-sg", "value": "sg"},
          {"text": "pack-au", "value": "au"},
          {"text": "pack-in", "value": "in"},
          {"text": "pack-br", "value": "br"},
          {"text": "pack-ae", "value": "ae"},
          {"text": "pack-ksa", "value": "ksa"}
        ],
        "label": "Pack"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Kill-switch engage latency p99 (last 1h)",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 0.8},
              {"color": "red", "value": 1.0}
            ]
          },
          "unit": "s"
        }
      },
      "targets": [
        {"expr": "histogram_quantile(0.99, sum(rate(oya_supervisor_kill_switch_engage_latency_seconds_bucket{pack=\"$pack\"}[1h])) by (le))", "refId": "A"}
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Kill-switch engagements (last 24h)",
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
      "targets": [
        {"expr": "sum(increase(oya_supervisor_kill_switch_engaged_total{pack=\"$pack\"}[24h])) by (scope)", "legendFormat": "{{scope}}", "refId": "A"}
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Engage latency time series (p50 / p99 / p999) vs SLO target (1s)",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "fieldConfig": {
        "defaults": {"unit": "s"}
      },
      "targets": [
        {"expr": "histogram_quantile(0.50, sum(rate(oya_supervisor_kill_switch_engage_latency_seconds_bucket{pack=\"$pack\"}[5m])) by (le))", "legendFormat": "p50", "refId": "A"},
        {"expr": "histogram_quantile(0.99, sum(rate(oya_supervisor_kill_switch_engage_latency_seconds_bucket{pack=\"$pack\"}[5m])) by (le))", "legendFormat": "p99", "refId": "B"},
        {"expr": "histogram_quantile(0.999, sum(rate(oya_supervisor_kill_switch_engage_latency_seconds_bucket{pack=\"$pack\"}[5m])) by (le))", "legendFormat": "p999", "refId": "C"},
        {"expr": "vector(1.0)", "legendFormat": "SLO target (1s)", "refId": "D"}
      ]
    },
    {
      "id": 4,
      "type": "table",
      "title": "Currently-engaged kill-switches (any scope)",
      "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
      "targets": [
        {"expr": "oya_supervisor_kill_switch_engaged{pack=\"$pack\"} == 1", "format": "table", "refId": "A"}
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Engage reason breakdown (last 24h)",
      "gridPos": {"x": 0, "y": 20, "w": 12, "h": 6},
      "targets": [
        {"expr": "sum(increase(oya_supervisor_kill_switch_engaged_total{pack=\"$pack\"}[24h])) by (reason)", "legendFormat": "{{reason}}", "refId": "A"}
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "State divergence (CRD vs Valkey cache)",
      "gridPos": {"x": 0, "y": 26, "w": 12, "h": 4},
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "red", "value": 1}
            ]
          }
        }
      },
      "targets": [
        {"expr": "sum(oya_supervisor_kill_switch_state_divergence_total{pack=\"$pack\"})", "refId": "A"}
      ]
    }
  ]
}
