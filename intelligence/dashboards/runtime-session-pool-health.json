{
  "$schema": "https://schemas.grafana.com/dashboard.json",
  "_meta": {
    "doc_class": "GrafanaDashboard",
    "microservice": "foundry-runtime",
    "owner_team": "axis-foundry-runtime + ops-sre-reliability",
    "related_artifacts": [
      "microservices/intelligence/capacity-model.md",
      "microservices/intelligence/failure-modes.md"
    ],
    "audience": "ops-sre-reliability + axis-foundry-runtime",
    "tenant_scoped": false,
    "datasource": "Mimir (oya-self tenant for runtime self-observability)"
  },
  "uid": "fr-session-pool-health",
  "title": "Foundry Runtime — Session-state + Runtime-pool health",
  "tags": ["foundry-runtime", "session-state", "runtime-pool", "operator-facing"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-1h", "to": "now"},
  "templating": {
    "list": [
      {
        "name": "pack",
        "type": "custom",
        "options": [
          {"text": "pack-kr", "value": "pack-kr", "selected": true},
          {"text": "pack-eu", "value": "pack-eu"},
          {"text": "pack-us", "value": "pack-us"},
          {"text": "pack-us-healthcare", "value": "pack-us-healthcare"}
        ],
        "label": "Pack"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Runtime pods Ready / Desired",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "targets": [
        {"expr": "sum(kube_pod_status_ready{condition=\"true\",pod=~\"oya-intelligence-runtime-.*\",pack=\"$pack\"}) / sum(kube_pod_status_phase{phase=\"Running\",pod=~\"oya-intelligence-runtime-.*\",pack=\"$pack\"})", "refId": "A"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {"steps": [{"color": "red", "value": 0}, {"color": "yellow", "value": 0.9}, {"color": "green", "value": 0.95}]}
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Pool warm pod utilization",
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
      "targets": [
        {"expr": "sum(oya_foundry_runtime_pool_inflight_invocations{pack=\"$pack\"}) / sum(oya_foundry_runtime_pool_warm_capacity{pack=\"$pack\"})", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "percentunit"}}
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Active sessions",
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
      "targets": [
        {"expr": "sum(oya_foundry_runtime_active_sessions{pack=\"$pack\"})", "refId": "A"}
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Valkey cluster health",
      "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
      "targets": [
        {"expr": "min(redis_cluster_state{pack=\"$pack\"})", "refId": "A"}
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {"type": "value", "options": {"1": {"text": "OK", "color": "green"}, "0": {"text": "DOWN", "color": "red"}}}
          ]
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Session hot read latency (Valkey) p50/p99",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "targets": [
        {"expr": "histogram_quantile(0.5, sum by (le) (rate(oya_foundry_runtime_session_hot_read_latency_seconds_bucket{pack=\"$pack\"}[1m])))", "legendFormat": "p50", "refId": "A"},
        {"expr": "histogram_quantile(0.99, sum by (le) (rate(oya_foundry_runtime_session_hot_read_latency_seconds_bucket{pack=\"$pack\"}[1m])))", "legendFormat": "p99", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 0.008}, {"color": "red", "value": 0.010}]}}}
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Cold restore latency (Postgres) p50/p99",
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
      "targets": [
        {"expr": "histogram_quantile(0.5, sum by (le) (rate(oya_foundry_runtime_session_cold_restore_duration_seconds_bucket{pack=\"$pack\"}[1m])))", "legendFormat": "p50", "refId": "A"},
        {"expr": "histogram_quantile(0.99, sum by (le) (rate(oya_foundry_runtime_session_cold_restore_duration_seconds_bucket{pack=\"$pack\"}[1m])))", "legendFormat": "p99", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 0.080}, {"color": "red", "value": 0.100}]}}}
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Pod drain events",
      "gridPos": {"x": 0, "y": 12, "w": 12, "h": 6},
      "targets": [
        {"expr": "sum by (reason) (rate(oya_foundry_runtime_pod_drained_total{pack=\"$pack\"}[5m]))", "legendFormat": "{{reason}}", "refId": "A"}
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Session evictions (LRU + TTL + DSR)",
      "gridPos": {"x": 12, "y": 12, "w": 12, "h": 6},
      "targets": [
        {"expr": "sum by (reason) (rate(oya_foundry_runtime_session_evicted_total{pack=\"$pack\"}[5m]))", "legendFormat": "{{reason}}", "refId": "A"}
      ]
    }
  ]
}
