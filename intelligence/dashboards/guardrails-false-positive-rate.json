{
  "$schema": "https://schemas.grafana.com/dashboard.json",
  "_meta": {
    "doc_class": "GrafanaDashboard",
    "microservice": "foundry-guardrails",
    "owner_team": "axis-foundry-guardrails",
    "audience": "rule-authors + tenant operators (own-tenant scope)",
    "tenant_scoped": true,
    "datasource": "Mimir oya-self + per-tenant FP-escalation events"
  },
  "uid": "fguard-fp-rate",
  "title": "False-Positive Rate + Escalation Budget",
  "tags": ["foundry-guardrails", "false-positive", "rule-author"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {"from": "now-30d", "to": "now"},
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "FP escalations this month (all tenants this pack)",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "targets": [
        {"expr": "sum(increase(foundry_guardrails_fp_escalations_total[30d]))", "refId": "A"}
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Tenants at > 80% budget",
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
      "targets": [
        {"expr": "count(foundry_guardrails_tenant_fp_budget_consumed_pct > 80)", "refId": "A"}
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "FP rate by rule_id (top 20)",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "targets": [
        {"expr": "topk(20, sum by (rule_id) (rate(foundry_guardrails_fp_escalations_total[1d])))", "legendFormat": "{{rule_id}}", "refId": "A"}
      ]
    },
    {
      "id": 4,
      "type": "table",
      "title": "Top 10 tenants by FP-budget-consumption",
      "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
      "targets": [
        {"expr": "topk(10, foundry_guardrails_tenant_fp_budget_consumed_pct)", "refId": "A", "format": "table"}
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Shadow-vs-enforce delta by rule (recently rolled out)",
      "gridPos": {"x": 0, "y": 20, "w": 12, "h": 8},
      "targets": [
        {"expr": "foundry_guardrails_shadow_vs_enforce_delta", "legendFormat": "{{rule_id}}", "refId": "A"}
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "FP rate trend (rolling 30d)",
      "gridPos": {"x": 0, "y": 28, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum(rate(foundry_guardrails_fp_escalations_total[7d]))", "legendFormat": "FP rate", "refId": "A"}
      ]
    }
  ]
}
