{
  "$schema": "https://schemas.grafana.com/dashboard.json",
  "_meta": {
    "doc_class": "GrafanaDashboard",
    "microservice": "foundry-supervisor",
    "owner_team": "ops-security + council-privacy + axis-foundry-control-plane",
    "audience": "internal operators + DPOs",
    "tenant_scoped": false,
    "datasource": "per-pack Mimir endpoints",
    "linked_slo": "autonomy-policy-eval.openslo.yaml (cedar eval p99 ≤ 15ms)"
  },
  "uid": "fnd-sup-autonomy-violation",
  "title": "Autonomy Policy: Violation Rate + Cedar Eval Latency",
  "tags": ["foundry-supervisor", "security", "autonomy", "cedar", "EU-AI-Act"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "templating": {
    "list": [
      {
        "name": "pack",
        "type": "custom",
        "options": [
          {"text": "pack-kr", "value": "kr", "selected": true},
          {"text": "pack-eu", "value": "eu"},
          {"text": "pack-us", "value": "us"},
          {"text": "pack-us-healthcare", "value": "us-hc"},
          {"text": "pack-jp", "value": "jp"},
          {"text": "pack-sg", "value": "sg"},
          {"text": "pack-au", "value": "au"},
          {"text": "pack-in", "value": "in"},
          {"text": "pack-br", "value": "br"},
          {"text": "pack-ae", "value": "ae"},
          {"text": "pack-ksa", "value": "ksa"}
        ],
        "label": "Pack"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Autonomy violations (last 1h)",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "targets": [
        {"expr": "sum(increase(oya_supervisor_autonomy_violation_total{pack=\"$pack\"}[1h]))", "refId": "A"}
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Cedar eval p99 (last 1h)",
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 0.010},
              {"color": "red", "value": 0.015}
            ]
          },
          "unit": "s"
        }
      },
      "targets": [
        {"expr": "histogram_quantile(0.99, sum(rate(oya_supervisor_cedar_eval_seconds_bucket{pack=\"$pack\"}[1h])) by (le))", "refId": "A"}
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Violation rate by tenant (top 10)",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "targets": [
        {"expr": "topk(10, sum(rate(oya_supervisor_autonomy_violation_total{pack=\"$pack\"}[5m])) by (tenant))", "legendFormat": "{{tenant}}", "refId": "A"}
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Violation rate by reason (cedar_reason label)",
      "gridPos": {"x": 0, "y": 12, "w": 12, "h": 6},
      "targets": [
        {"expr": "sum(rate(oya_supervisor_autonomy_violation_total{pack=\"$pack\"}[5m])) by (cedar_reason)", "legendFormat": "{{cedar_reason}}", "refId": "A"}
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Tier-escalation attempts (last 24h; should be 0)",
      "gridPos": {"x": 0, "y": 18, "w": 6, "h": 4},
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "red", "value": 1}
            ]
          }
        }
      },
      "targets": [
        {"expr": "sum(increase(oya_supervisor_autonomy_level_escalation_attempt_total{pack=\"$pack\"}[24h]))", "refId": "A"}
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Active manual overrides (with reason + duration)",
      "gridPos": {"x": 6, "y": 18, "w": 6, "h": 4},
      "targets": [
        {"expr": "sum(oya_supervisor_autonomy_manual_override_active{pack=\"$pack\"})", "refId": "A"}
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Cedar eval latency time series (p50 / p99 / p999)",
      "gridPos": {"x": 0, "y": 22, "w": 12, "h": 6},
      "fieldConfig": {
        "defaults": {"unit": "s"}
      },
      "targets": [
        {"expr": "histogram_quantile(0.50, sum(rate(oya_supervisor_cedar_eval_seconds_bucket{pack=\"$pack\"}[5m])) by (le))", "legendFormat": "p50", "refId": "A"},
        {"expr": "histogram_quantile(0.99, sum(rate(oya_supervisor_cedar_eval_seconds_bucket{pack=\"$pack\"}[5m])) by (le))", "legendFormat": "p99", "refId": "B"},
        {"expr": "histogram_quantile(0.999, sum(rate(oya_supervisor_cedar_eval_seconds_bucket{pack=\"$pack\"}[5m])) by (le))", "legendFormat": "p999", "refId": "C"}
      ]
    }
  ]
}
