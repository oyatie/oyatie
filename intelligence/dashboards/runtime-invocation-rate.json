{
  "$schema": "https://schemas.grafana.com/dashboard.json",
  "_meta": {
    "doc_class": "GrafanaDashboard",
    "microservice": "foundry-runtime",
    "owner_team": "axis-foundry-runtime",
    "related_artifacts": [
      "microservices/intelligence/contracts/openapi/foundry-runtime.yaml",
      "microservices/intelligence/policy/tenant-scope.cedar"
    ],
    "audience": "tenant operators + ops-sre-reliability",
    "tenant_scoped": true,
    "datasource": "Mimir (per-pack); X-Scope-OrgID = principal.tenant_id"
  },
  "uid": "fr-invocation-rate",
  "title": "Foundry Runtime — Invocation rate + dispatch latency",
  "tags": ["foundry-runtime", "invocation", "tenant-facing"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "timepicker": {"refresh_intervals": ["10s","30s","1m","5m","15m","30m","1h"]},
  "templating": {
    "list": [
      {
        "name": "tenant",
        "type": "query",
        "datasource": "Mimir",
        "query": "label_values(oya_foundry_runtime_invocations_total, tenant_id)",
        "refresh": 1,
        "label": "Tenant"
      },
      {
        "name": "capability",
        "type": "query",
        "datasource": "Mimir",
        "query": "label_values(oya_foundry_runtime_invocations_total{tenant_id=\"$tenant\"}, capability_id)",
        "refresh": 1,
        "label": "Capability",
        "includeAll": true
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Invocation rate (per sec) — $tenant / $capability",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "sum by (status) (rate(oya_foundry_runtime_invocations_total{tenant_id=\"$tenant\",capability_id=~\"$capability\"}[1m]))",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Dispatch latency p50/p99/p999",
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
      "targets": [
        {"expr": "histogram_quantile(0.5, sum by (le) (rate(oya_foundry_runtime_dispatch_latency_seconds_bucket{tenant_id=\"$tenant\",capability_id=~\"$capability\"}[1m])))", "legendFormat": "p50", "refId": "A"},
        {"expr": "histogram_quantile(0.99, sum by (le) (rate(oya_foundry_runtime_dispatch_latency_seconds_bucket{tenant_id=\"$tenant\",capability_id=~\"$capability\"}[1m])))", "legendFormat": "p99", "refId": "B"},
        {"expr": "histogram_quantile(0.999, sum by (le) (rate(oya_foundry_runtime_dispatch_latency_seconds_bucket{tenant_id=\"$tenant\",capability_id=~\"$capability\"}[1m])))", "legendFormat": "p999", "refId": "C"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "steps": [
              {"color": "green", "value": 0},
              {"color": "yellow", "value": 0.05},
              {"color": "red", "value": 0.12}
            ]
          }
        }
      },
      "alert": {
        "name": "dispatch-p99-burn",
        "conditions": [
          {"evaluator": {"params": [0.05], "type": "gt"}, "query": {"params": ["B", "5m", "now"]}, "type": "query"}
        ],
        "notifications": [{"uid": "grafana-oncall"}]
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Failure rate (last 5m)",
      "gridPos": {"x": 0, "y": 8, "w": 6, "h": 4},
      "targets": [
        {"expr": "sum(rate(oya_foundry_runtime_invocations_total{tenant_id=\"$tenant\",status=\"failed\"}[5m])) / sum(rate(oya_foundry_runtime_invocations_total{tenant_id=\"$tenant\"}[5m]))", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "percentunit"}}
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Failure reasons (last 6h)",
      "gridPos": {"x": 6, "y": 8, "w": 18, "h": 4},
      "targets": [
        {"expr": "sum by (failure_reason) (rate(oya_foundry_runtime_invocations_total{tenant_id=\"$tenant\",status=\"failed\"}[1m]))", "legendFormat": "{{failure_reason}}", "refId": "A"}
      ]
    },
    {
      "id": 5,
      "type": "table",
      "title": "Recent invocations — last 100",
      "gridPos": {"x": 0, "y": 12, "w": 24, "h": 8},
      "targets": [
        {"expr": "oya_foundry_runtime_invocations_total{tenant_id=\"$tenant\"}", "format": "table", "instant": false, "refId": "A"}
      ]
    }
  ]
}
