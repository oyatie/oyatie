# Committed k8s manifests consumed as DECLARED resources by the intelligence worker ownership
# test, so Buck and the Cargo merge path (ADR-0716) read the same bytes.
export_file(
    name = "cloud-intelligence.yaml",
    visibility = ["PUBLIC"],
)

# Index this package's YAML into the corpus liveness graph (ADR-0541). Declaring the BUCK file
# above made this a package that OWNS YAML, so it owes the corpus an extraction target; without
# it the corpus-index-coverage ratchet counts a new unindexed YAML owner.
genrule(
    name = "corpus-yaml-facts",
    srcs = glob(["**/*.yaml", "**/*.yml"]),
    out = "yaml-facts.json",
    cmd = "$(exe //governance/corpus/extract:yaml-facts) --target root//intelligence/k8s:corpus-yaml-facts --prefix intelligence/k8s --out $OUT $SRCS",
)
