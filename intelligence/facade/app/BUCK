# The boundary-conformance test greps this crate's own source, so the source is a declared
# resource rather than a cwd-relative guess.
export_file(
    name = "intelligence-app-source",
    src = "src/lib.rs",
    visibility = ["PUBLIC"],
)

rust_test(
    name = "intelligence-app-tests",
    srcs = glob(["src/**/*.rs", "migrations/**/*.sql", "**/*.cedar", "**/*.sql", "**/*.json", "**/*.toml", "**/*.yaml", "**/*.yml", "**/*.proto", "**/*.html", "**/*.css", "**/*.txt"]),
    crate = "intelligence_app",
    crate_root = "src/lib.rs",
    # Declared fixture bindings. The conformance tests below read committed manifests and
    # sources; they previously resolved bare repo-relative paths against the process cwd, which
    # only worked because Buck runs the action from the sandbox root. Naming each resource keeps
    # Buck and the Cargo merge path (ADR-0716) reading the same bytes.
    env = {
        "OYATIE_INTELLIGENCE_APP_SOURCE": "$(location :intelligence-app-source)",
        "OYATIE_INTELLIGENCE_HELM_DEPLOYMENT": "$(location //intelligence/iac/k8s/helm/templates:deployment.yaml)",
        "OYATIE_INTELLIGENCE_HELM_EXTERNALSECRET": "$(location //intelligence/iac/k8s/helm/templates:externalsecret.yaml)",
        "OYATIE_INTELLIGENCE_OPENAPI_CONTRACT": "$(location //intelligence/contracts:intelligence-app.openapi.yaml)",
        "OYATIE_INTELLIGENCE_REST_SOURCE": "$(location //intelligence/adapters/rest:intelligence-rest-source)",
    },
    visibility = ["PUBLIC"],
    deps = [
        "//intelligence/adapters/authz-cedar-adapter:intelligence-authz-cedar-adapter",
        "//intelligence/adapters/eventsink-clickhouse-adapter:intelligence-eventsink-clickhouse-adapter",
        "//intelligence/adapters/eventsink-valkey-adapter:intelligence-eventsink-valkey-adapter",
        "//intelligence/core/kernel:intelligence-kernel",
        "//intelligence/adapters/openbao-adapter:intelligence-openbao-adapter",
        "//intelligence/adapters/rest:intelligence-rest",
        "//libs/shared-olap-clickhouse-adapter:shared-olap-clickhouse-adapter",
        "third-party//:axum",
        "third-party//:reqwest",
        "third-party//:serde",
        "third-party//:tokio",
        "third-party//:tracing",
        "third-party//:tracing-subscriber",
    ],
)

