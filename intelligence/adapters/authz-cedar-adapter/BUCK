ADAPTER_ROOT = "intelligence/adapters/authz-cedar-adapter"
ADAPTER_SRCS = glob(["src/**/*.rs", "migrations/**/*.sql", "**/*.cedar", "**/*.sql", "**/*.json", "**/*.toml", "**/*.yaml", "**/*.yml", "**/*.proto", "**/*.graphql", "**/*.html", "**/*.css", "**/*.txt"])
ADAPTER_MAPPED_SRCS = {src: ADAPTER_ROOT + "/" + src for src in ADAPTER_SRCS}
# Place the shared cedar policy at the path src/lib.rs include_str!("../policy/...")
# resolves to inside the hermetic sandbox (ADAPTER_ROOT/policy/...), not the repo
# path of the export_file source — otherwise rustc cannot read it (hermetic-build
# defect: source present in repo but unmapped to the include-relative location).
ADAPTER_MAPPED_SRCS["//cloud/cloud-intelligence/policy:cloud-intelligence.cedar"] = ADAPTER_ROOT + "/policy/cloud-intelligence.cedar"

rust_library(
    name = "intelligence-authz-cedar-adapter",
    srcs = [],
    crate = "intelligence_authz_cedar_adapter",
    crate_root = ADAPTER_ROOT + "/src/lib.rs",
    visibility = ["PUBLIC"],
    mapped_srcs = ADAPTER_MAPPED_SRCS,
    deps = [
        "//intelligence/core/kernel:intelligence-kernel",
        "third-party//:cedar-policy",
    ],
)

rust_test(
    name = "intelligence-authz-cedar-adapter-cross-tenant-forbid",
    srcs = ["tests/cross_tenant_forbid.rs"],
    crate = "intelligence_authz_cedar_adapter_cross_tenant_forbid",
    crate_root = "tests/cross_tenant_forbid.rs",
    visibility = ["PUBLIC"],
    deps = [
        ":intelligence-authz-cedar-adapter",
        "//intelligence/core/kernel:intelligence-kernel",
        "third-party//:cedar-policy",
    ],
)

rust_test(
    name = "intelligence-authz-cedar-adapter-default-deny-and-load",
    srcs = ["tests/default_deny_and_load.rs"],
    crate = "intelligence_authz_cedar_adapter_default_deny_and_load",
