# Exported for the intelligence-app boundary-conformance test, which greps this adapter's
# source as a declared resource rather than a cwd-relative guess.
export_file(
    name = "intelligence-rest-proxy-source",
    src = "src/lib.rs",
    visibility = ["PUBLIC"],
)

# Library target follows the package name `intelligence-rest-proxy`; its `crate`
# stays `intelligence_rest` because Buck2 exposes a dependency only under its
# `crate` attribute and external consumers still say `use intelligence_rest::`
# (Cargo covers them with a `package =` rename). The crate's OWN tests are the
# opposite case: under Cargo they must import the derived name
# `intelligence_rest_proxy`, so each test target maps it back via `named_deps`.
rust_library(
    name = "intelligence-rest-proxy",
    srcs = glob(["src/**/*.rs", "migrations/**/*.sql", "**/*.cedar", "**/*.sql", "**/*.json", "**/*.toml", "**/*.yaml", "**/*.yml", "**/*.proto", "**/*.html", "**/*.css", "**/*.txt"]),
    crate = "intelligence_rest",
    crate_root = "src/lib.rs",
    visibility = ["PUBLIC"],
    deps = [
        "//intelligence/core/kernel:intelligence-kernel",
        "//intelligence/adapters/codex-adapter:intelligence-codex-adapter",
        "//intelligence/adapters/gemini-adapter:intelligence-gemini-adapter",
        "third-party//:axum",
        "third-party//:bytes",
        "third-party//:futures",
        "third-party//:http-body-util",
        "third-party//:reqwest",
        "third-party//:serde",
        "third-party//:serde_json",
        "third-party//:tokio",
        "third-party//:tower",
        "third-party//:tracing",
    ],
)

