{
  "$schema": "https://grafana.com/api/dashboards/json-schema",
  "title": "identity — SCIM Provisioning Health",
  "uid": "identity-scim-health",
  "tags": ["identity", "scim", "provisioning"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      { "name": "pack", "type": "custom", "label": "Pack", "options": [{ "text": "eu", "value": "eu", "selected": true }] },
      { "name": "tenant", "type": "query", "label": "Tenant", "datasource": "Prometheus", "query": "label_values(identity_scim_request_total{pack=\"$pack\"}, tenant_id)" }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "SCIM request rate (rps)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        { "expr": "sum(rate(identity_scim_request_total{pack=\"$pack\",tenant_id=~\"$tenant\"}[5m])) by (http_method, http_status)" }
      ]
    },
    {
      "id": 2,
      "title": "SCIM operations p99 latency (s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "expr": "histogram_quantile(0.99, sum(rate(identity_scim_duration_seconds_bucket{pack=\"$pack\",tenant_id=~\"$tenant\"}[5m])) by (le, http_method))", "legendFormat": "{{http_method}} p99" }
      ]
    },
    {
      "id": 3,
      "title": "Top 10 vendors (User-Agent classification)",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "targets": [
        { "expr": "topk(10, sum(rate(identity_scim_request_total{pack=\"$pack\"}[1h])) by (vendor))" }
      ]
    },
    {
      "id": 4,
      "title": "SCIM bearer rotation status",
      "type": "stat",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "targets": [
        { "expr": "count(identity_scim_bearer_age_days{pack=\"$pack\"} > 80)", "legendFormat": "due-soon" },
        { "expr": "count(identity_scim_bearer_age_days{pack=\"$pack\"} > 90)", "legendFormat": "overdue" }
      ]
    },
    {
      "id": 5,
      "title": "Cross-tenant attempts (should be 0)",
      "type": "stat",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "targets": [
        { "expr": "sum(increase(identity_scim_cross_tenant_attempt_total{pack=\"$pack\"}[24h]))" }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "id": 6,
      "title": "Provisioning lifecycle events / 5min",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "targets": [
        { "expr": "sum(rate(identity_user_provisioned_total{pack=\"$pack\",tenant_id=~\"$tenant\"}[5m]))", "legendFormat": "provisioned" },
        { "expr": "sum(rate(identity_user_suspended_total{pack=\"$pack\",tenant_id=~\"$tenant\"}[5m]))", "legendFormat": "suspended" },
        { "expr": "sum(rate(identity_user_deleted_total{pack=\"$pack\",tenant_id=~\"$tenant\"}[5m]))", "legendFormat": "deleted" },
        { "expr": "sum(rate(identity_user_reactivated_total{pack=\"$pack\",tenant_id=~\"$tenant\"}[5m]))", "legendFormat": "reactivated" }
      ]
    }
  ]
}
