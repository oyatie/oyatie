_DEPS = [
    "//iam/core/node-platform-types:os-kernel",
    # Real X.509 crypto (G002 slice-1b-i; ADR-0561, ADR-0506). All ride the
    # aws-lc-rs backend with NO ring (rcgen default-features disabled at the
    # workspace seam; x509-parser on verify-aws).
    "third-party//:aws-lc-rs",
    "third-party//:rcgen",
    "third-party//:time",
    "third-party//:x509-parser",
]

rust_library(
    name = "os-trustd-domain",
    srcs = glob(["src/**/*.rs", "migrations/**/*.sql", "**/*.cedar", "**/*.sql", "**/*.json", "**/*.toml", "**/*.yaml", "**/*.yml", "**/*.proto", "**/*.html", "**/*.css", "**/*.txt"]),
    crate = "os_trustd_domain",
    crate_root = "src/lib.rs",
    visibility = ["PUBLIC"],
    deps = _DEPS,
)

# `BUCK` is in srcs because `no_buck_target_enables_the_model` reads this file.
# It is a LITERAL PATTERN INSIDE the glob, not `glob([...]) + ["BUCK"]`: the
# concatenation builds the same file set for buck2 and an UNREADABLE one for
# ci/facade/embedded-asset-hermeticity, whose parse_srcs models `glob(...)` and
# a bare list but falls to `_ => unparseable` on a binary `+` of the two.
rust_test(
    name = "os-trustd-domain-unittest",
    srcs = glob(["src/**/*.rs", "migrations/**/*.sql", "**/*.cedar", "**/*.sql", "**/*.json", "**/*.toml", "**/*.yaml", "**/*.yml", "**/*.proto", "**/*.html", "**/*.css", "**/*.txt", "testdata/**", "BUCK"]),
    crate = "os_trustd_domain",
    crate_root = "src/lib.rs",
    visibility = ["PUBLIC"],
    deps = _DEPS,
)
