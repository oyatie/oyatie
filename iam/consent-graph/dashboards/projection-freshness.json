{
  "title": "consent-graph — Projection freshness",
  "uid": "consent-graph-projection-freshness",
  "schemaVersion": 39,
  "tags": ["consent-graph", "HG-CONSENT", "freshness", "SLO"],
  "timezone": "utc",
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "type": "gauge",
      "title": "SLO budget remaining (30d rolling)",
      "targets": [{ "expr": "oya_slo_budget_remaining_ratio{slo=\"oya-consent-graph-cross-tenant-projection-freshness\"}" }],
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 }
    },
    {
      "type": "timeseries",
      "title": "Projection lag (p50/p95/p99) by region pair",
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (grantor_region, grantee_region, le) (rate(oya_consent_graph_projection_lag_seconds_bucket[5m])))", "legendFormat": "p50 {{grantor_region}}->{{grantee_region}}" },
        { "expr": "histogram_quantile(0.95, sum by (grantor_region, grantee_region, le) (rate(oya_consent_graph_projection_lag_seconds_bucket[5m])))", "legendFormat": "p95 {{grantor_region}}->{{grantee_region}}" },
        { "expr": "histogram_quantile(0.99, sum by (grantor_region, grantee_region, le) (rate(oya_consent_graph_projection_lag_seconds_bucket[5m])))", "legendFormat": "p99 {{grantor_region}}->{{grantee_region}}" }
      ],
      "gridPos": { "h": 8, "w": 16, "x": 8, "y": 0 }
    },
    {
      "type": "timeseries",
      "title": "Emit rate by mode",
      "targets": [{ "expr": "sum by (mode) (rate(oya_consent_graph_projection_emit_total[5m]))" }],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 }
    },
    {
      "type": "timeseries",
      "title": "Aggregate buckets suppressed (below-k)",
      "targets": [{ "expr": "sum(rate(oya_consent_graph_aggregate_suppressed_total[5m]))" }],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 }
    },
    {
      "type": "stat",
      "title": "Sovereignty violations (last 24h)",
      "targets": [{ "expr": "sum(increase(oya_consent_graph_sovereignty_violation_total[24h]))" }],
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 16 }
    }
  ]
}
