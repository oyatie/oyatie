{
  "title": "consent-graph — Grant funnel",
  "uid": "consent-graph-grant-funnel",
  "schemaVersion": 39,
  "tags": ["consent-graph", "HG-CONSENT", "lifecycle"],
  "timezone": "utc",
  "refresh": "30s",
  "time": { "from": "now-24h", "to": "now" },
  "panels": [
    {
      "type": "stat",
      "title": "Drafted (24h)",
      "targets": [{ "expr": "sum(increase(oya_consent_graph_agreement_state_transition_total{to=\"Drafted\"}[24h]))" }],
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 }
    },
    {
      "type": "stat",
      "title": "Offered (24h)",
      "targets": [{ "expr": "sum(increase(oya_consent_graph_agreement_state_transition_total{to=\"Offered\"}[24h]))" }],
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 }
    },
    {
      "type": "stat",
      "title": "Accepted (24h)",
      "targets": [{ "expr": "sum(increase(oya_consent_graph_agreement_state_transition_total{to=\"Accepted\"}[24h]))" }],
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 }
    },
    {
      "type": "stat",
      "title": "Active (24h)",
      "targets": [{ "expr": "sum(increase(oya_consent_graph_agreement_state_transition_total{to=\"Active\"}[24h]))" }],
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 }
    },
    {
      "type": "stat",
      "title": "Revoked (24h)",
      "targets": [{ "expr": "sum(increase(oya_consent_graph_agreement_state_transition_total{to=\"Revoked\"}[24h]))" }],
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 }
    },
    {
      "type": "stat",
      "title": "Expired (24h)",
      "targets": [{ "expr": "sum(increase(oya_consent_graph_agreement_state_transition_total{to=\"Expired\"}[24h]))" }],
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 }
    },
    {
      "type": "timeseries",
      "title": "Grant E2E latency (p50/p95/p99)",
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(oya_consent_graph_grant_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, sum(rate(oya_consent_graph_grant_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, sum(rate(oya_consent_graph_grant_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p99" }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 }
    },
    {
      "type": "timeseries",
      "title": "Drop-off (Drafted but never Offered, hourly)",
      "targets": [{ "expr": "sum(rate(oya_consent_graph_agreement_state_transition_total{to=\"Drafted\"}[1h])) - sum(rate(oya_consent_graph_agreement_state_transition_total{to=\"Offered\"}[1h]))" }],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 }
    },
    {
      "type": "table",
      "title": "Funnel by mode + pack",
      "targets": [{ "expr": "sum by (mode, pack, to) (rate(oya_consent_graph_agreement_state_transition_total[24h]))" }],
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 12 }
    }
  ]
}
