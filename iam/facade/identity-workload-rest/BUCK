load("@prelude//rust:cargo_buildscript.bzl", "buildscript_run")

rust_binary(
    name = "iam-identity-workload-rest-build-script",
    srcs = ["build.rs"],
    crate = "build_script_build",
    crate_root = "build.rs",
    visibility = [],
    deps = [
        "third-party//:protoc-bin-vendored",
        "third-party//:tonic-prost-build",
    ],
)

export_file(
    name = "build.rs",
    visibility = [],
)

genrule(
    name = "iam-identity-workload-rest-manifest-dir",
    srcs = [
        ":build.rs",
        "//iam/identity/contracts/proto:workload.proto",
    ],
    out = "manifest_dir",
    cmd = "mkdir -p $OUT/contracts/proto && cp $(location :build.rs) $OUT/ && cp $(location //iam/identity/contracts/proto:workload.proto) $OUT/contracts/proto/",
)

buildscript_run(
    name = "iam-identity-workload-rest-build-script-run",
    buildscript_rule = ":iam-identity-workload-rest-build-script",
    package_name = "iam-identity-workload-rest",
    version = "0.1.0",
    manifest_dir = ":iam-identity-workload-rest-manifest-dir",
)

rust_library(
    name = "iam-identity-workload-rest",
    srcs = glob(["src/**/*.rs", "migrations/**/*.sql", "**/*.cedar", "**/*.sql", "**/*.json", "**/*.toml", "**/*.yaml", "**/*.yml", "**/*.proto", "**/*.html", "**/*.css", "**/*.txt"]),
    crate = "iam_identity_workload_rest",
    crate_root = "src/lib.rs",
    env = {"OUT_DIR": "$(location :iam-identity-workload-rest-build-script-run[out_dir])"},
    visibility = ["PUBLIC"],
    deps = [
        "//iam/ports/identity-workload-api:iam-identity-workload-api",
        "//iam/facade/identity-workload-app:iam-identity-workload-app",
        "//iam/adapters/identity-workload-authz-cedar:iam-identity-workload-authz-cedar",
        "//iam/core/identity-workload-domain:iam-identity-workload-domain",
        "//iam/adapters/identity-workload-oidc:iam-identity-workload-oidc",
        "third-party//:aws-lc-rs",
        "third-party//:axum",
        "third-party//:base64",
        "third-party//:http-body-util",
        "third-party//:prost",
        "third-party//:protoc-bin-vendored",
        "third-party//:serde",
        "third-party//:serde_json",
        "third-party//:tokio",
        "third-party//:tonic",
        "third-party//:tonic-prost",
        "third-party//:tonic-prost-build",
        "third-party//:tower",
        "third-party//:tracing",
    ],
)

