    "third-party//:tower",
    "third-party//:tracing",
    "third-party//:tracing-subscriber",
    "third-party//:x509-parser",
]

rust_library(
    name = "iam-cloud-pdp-app",
    srcs = glob(["src/**/*.rs", "cedar/**", "proto/**"]),
    crate = "iam_cloud_pdp_app",
    crate_root = "src/lib.rs",
    env = {"OUT_DIR": "$(location :iam-cloud-pdp-app-build-script-run[out_dir])"},
    visibility = ["PUBLIC"],
    deps = _DEPS,
)

rust_binary(
    name = "iam-cloud-pdp-app-bin",
    srcs = glob(["src/**/*.rs"]),
    crate_root = "src/main.rs",
    visibility = ["PUBLIC"],
    deps = [":iam-cloud-pdp-app"] + [
        "third-party//:tokio",
        "third-party//:tracing",
    ],
)

rust_test(
    name = "iam-cloud-pdp-app-unittest",
    srcs = glob(["src/**/*.rs", "cedar/**", "proto/**"]),
    crate = "iam_cloud_pdp_app",
    crate_root = "src/lib.rs",
    env = {"OUT_DIR": "$(location :iam-cloud-pdp-app-build-script-run[out_dir])"},
    visibility = ["PUBLIC"],
    deps = _DEPS,
)

