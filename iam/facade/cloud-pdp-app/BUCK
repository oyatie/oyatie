load("@prelude//rust:cargo_buildscript.bzl", "buildscript_run")

rust_binary(
    name = "iam-cloud-pdp-app-build-script",
    srcs = ["build.rs"],
    crate = "build_script_build",
    crate_root = "build.rs",
    visibility = [],
    deps = [
        "third-party//:protoc-bin-vendored",
        "third-party//:tonic-prost-build",
    ],
)

export_file(
    name = "build.rs",
    visibility = [],
)

export_file(
    name = "cloud-iam-pdp.proto",
    src = "proto/cloud-iam-pdp.proto",
    visibility = [],
)

genrule(
    name = "iam-cloud-pdp-app-manifest-dir",
    srcs = [
        ":build.rs",
        ":cloud-iam-pdp.proto",
    ],
    out = "manifest_dir",
    cmd = "mkdir -p $OUT/proto && cp $(location :build.rs) $OUT/ && cp $(location :cloud-iam-pdp.proto) $OUT/proto/",
)

buildscript_run(
    name = "iam-cloud-pdp-app-build-script-run",
    buildscript_rule = ":iam-cloud-pdp-app-build-script",
    package_name = "iam-cloud-pdp-app",
    version = "0.1.0",
    manifest_dir = ":iam-cloud-pdp-app-manifest-dir",
)

_DEPS = [
    "//iam/core/cloud-pdp-kernel:iam-cloud-pdp-kernel",
    "//iam/adapters/cloud-pdp-bundle-file:iam-cloud-pdp-bundle-file",
    "//libs/oya-shared-pdp-kernel:oya-shared-pdp-kernel",
    "//iam/adapters/pdp-cedar:iam-pdp-cedar",
    "//libs/oya-shared-platform-contracts-kernel:oya-shared-platform-contracts-kernel",
    "//libs/oya-shared-ulid-id-kernel:oya-shared-ulid-id-kernel",
    "//iam/core/identity-workload-domain:iam-identity-workload-domain",
    "//iam/core/identity-workload-svid-kernel:iam-identity-workload-svid-kernel",
    "//iam/adapters/identity-workload-svid-trustd:iam-identity-workload-svid-trustd",
    "//os/core/trustd-domain:os-trustd-domain",
    "//libs/oya-http-runtime-hyper-adapter:oya-http-runtime-hyper-adapter",
    "third-party//:async-stream",
    "third-party//:aws-lc-rs",
    "third-party//:axum",
    "third-party//:futures-core",
    "third-party//:hyper",
    "third-party//:hyper-util",
