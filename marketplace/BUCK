load("//governance/corpus/extract:yaml_facts.bzl", "corpus_yaml_facts_shards")

# Hermetic input set for gates that must validate every live marketplace service manifest.
filegroup(
    name = "live-service-manifest-corpus",
    srcs = glob(["**/manifest.json"]),
    visibility = ["PUBLIC"],
)

# Hermetic input set for gates that validate the full internal Proto contract corpus.
filegroup(
    name = "proto-contract-corpus",
    srcs = glob(["**/*.proto"]),
    visibility = ["PUBLIC"],
)

# Corpus graph extraction (ADR-0541). Keep rehomed residual YAML (ex-oya/marketplace)
# and pre-existing marketplace/** YAML inside a buck2 package so the unpackaged ceiling
# does not regress on dual-home burn-down.
corpus_yaml_facts_shards(
    srcs = glob(["**/*.yaml", "**/*.yml"]),
    shard_size = 256,
)
