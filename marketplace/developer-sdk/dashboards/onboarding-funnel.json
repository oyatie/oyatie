{
  "title": "Developer SDK \u2014 Onboarding funnel",
  "uid": "oya-developer-sdk-onboarding-funnel",
  "schemaVersion": 39,
  "panels": [
    {
      "id": 1,
      "title": "Signup \u2192 KYC-approved completion rate",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(rate(oya_developer_sdk_onboarding_total{outcome=\"completed\"}[1h])) / sum(rate(oya_developer_sdk_onboarding_total{outcome=~\"completed|failed|abandoned\"}[1h]))"
        }
      ]
    },
    {
      "id": 2,
      "title": "KYC liveness p99 latency",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.99, rate(oya_developer_sdk_kyc_liveness_seconds_bucket[5m]))"
        }
      ]
    },
    {
      "id": 3,
      "title": "KYC false-positive rate",
      "type": "stat",
      "targets": [
        {
          "expr": "rate(oya_developer_sdk_kyc_false_positive_total[7d])"
        }
      ]
    },
    {
      "id": 4,
      "title": "Bank account verification latency p99",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.99, rate(oya_developer_sdk_bank_verify_seconds_bucket[5m]))"
        }
      ]
    },
    {
      "id": 5,
      "title": "Onboarding abandonment by step",
      "type": "barchart",
      "targets": [
        {
          "expr": "sum by (step) (rate(oya_developer_sdk_onboarding_abandoned_total[1h]))"
        }
      ]
    }
  ]
}