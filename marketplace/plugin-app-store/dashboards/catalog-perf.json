{
  "title": "Plugin App Store \u2014 Catalog perf",
  "uid": "oya-plugin-app-store-catalog-perf",
  "schemaVersion": 39,
  "panels": [
    {
      "id": 1,
      "title": "Catalog browse p95 latency",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(oya_plugin_app_store_catalog_request_seconds_bucket[5m]))"
        }
      ]
    },
    {
      "id": 2,
      "title": "Catalog browse p99 latency",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.99, rate(oya_plugin_app_store_catalog_request_seconds_bucket[5m]))"
        }
      ]
    },
    {
      "id": 3,
      "title": "Catalog search RPS",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(oya_plugin_app_store_catalog_request_total[5m])"
        }
      ]
    },
    {
      "id": 4,
      "title": "Catalog 5xx rate",
      "type": "stat",
      "targets": [
        {
          "expr": "rate(oya_plugin_app_store_catalog_request_total{status=~\"5..\"}[5m]) / rate(oya_plugin_app_store_catalog_request_total[5m])"
        }
      ]
    },
    {
      "id": 5,
      "title": "Cilium L4 cache hit rate",
      "type": "stat",
      "targets": [
        {
          "expr": "rate(cilium_l4_cache_hits_total{microservice=\"plugin-app-store\"}[5m]) / rate(cilium_l4_cache_requests_total{microservice=\"plugin-app-store\"}[5m])"
        }
      ]
    }
  ]
}