    out = "no-grouping-kernel-check.json",
    cmd = "mkdir -p $TMP/no-grouping-kernel && rustc --edition=2024 -D warnings libs/oya-check-no-grouping/src/lib.rs --test -o $TMP/no-grouping-kernel/no_grouping_kernel_check && $TMP/no-grouping-kernel/no_grouping_kernel_check > /dev/null && echo '{\"verdict\":\"PASS\",\"checker\":\"libs/oya-check-no-grouping/src/lib.rs\",\"local_static_only\":true,\"live_mutation_performed\":false}' > $OUT",
