load("@prelude//rust:cargo_buildscript.bzl", "buildscript_run")

rust_binary(
    name = "shared-backbone-grpc-generated-adapter-build-script",
    srcs = ["build.rs"],
    crate = "build_script_build",
    crate_root = "build.rs",
    visibility = [],
    deps = [
        "third-party//:protoc-bin-vendored",
        "third-party//:tonic-prost-build",
    ],
)

export_file(
    name = "build.rs",
    visibility = [],
)

genrule(
    name = "shared-backbone-grpc-generated-adapter-manifest-dir",
    srcs = [
        ":build.rs",
        "//specs/proto/backbone/messenger:message_stream.proto",
        "//specs/proto/backbone/mail:mail.proto",
        "//specs/proto/backbone/social:social_post_composition.proto",
        "//specs/proto/backbone/community:community_post_store.proto",
    ],
    out = "manifest_dir",
    cmd = "mkdir -p $OUT/specs/proto/backbone/messenger $OUT/specs/proto/backbone/mail $OUT/specs/proto/backbone/social $OUT/specs/proto/backbone/community && cp $(location :build.rs) $OUT/ && cp $(location //specs/proto/backbone/messenger:message_stream.proto) $OUT/specs/proto/backbone/messenger/ && cp $(location //specs/proto/backbone/mail:mail.proto) $OUT/specs/proto/backbone/mail/ && cp $(location //specs/proto/backbone/social:social_post_composition.proto) $OUT/specs/proto/backbone/social/ && cp $(location //specs/proto/backbone/community:community_post_store.proto) $OUT/specs/proto/backbone/community/",
)

buildscript_run(
    name = "shared-backbone-grpc-generated-adapter-build-script-run",
    buildscript_rule = ":shared-backbone-grpc-generated-adapter-build-script",
    package_name = "shared-backbone-grpc-generated-adapter",
    version = "0.1.0",
    manifest_dir = ":shared-backbone-grpc-generated-adapter-manifest-dir",
)

rust_library(
    name = "shared-backbone-grpc-generated-adapter",
    srcs = glob(["src/**/*.rs", "migrations/**/*.sql", "**/*.cedar", "**/*.sql", "**/*.json", "**/*.toml", "**/*.yaml", "**/*.yml", "**/*.proto", "**/*.html", "**/*.css", "**/*.txt"]),
    crate = "shared_backbone_grpc_generated_adapter",
    crate_root = "src/lib.rs",
    env = {"OUT_DIR": "$(location :shared-backbone-grpc-generated-adapter-build-script-run[out_dir])"},
    visibility = ["PUBLIC"],
    deps = [
        "//libs/shared-backbone-proto-contracts-kernel:shared-backbone-proto-contracts-kernel",
        "//libs/shared-postgres-command-kernel:shared-postgres-command-kernel",
        "//app/community/ports/post-store-api:community-post-store-api",
        "//app/community/facade/post-store-app:community-post-store-app",
        "//app/community/core/post-store-domain:community-post-store-domain",
        "//app/community/adapters/post-store-grpc:community-post-store-grpc",
        "//app/community/facade/social-app:community-social-app",
        "//app/community/ports/social-post-composition-api:community-social-post-composition-api",
        "//app/community/adapters/social-post-composition-grpc:community-social-post-composition-grpc",
        "//comms/ports/mail-mailbox-api:comms-mail-mailbox-api",
        "//comms/core/mail-mailbox-app:comms-mail-mailbox-app",
        "//comms/facade/mail-mailbox-grpc:comms-mail-mailbox-grpc",
        "//comms/core/messenger-stream-app:comms-messenger-stream-app",
        "//comms/ports/messenger-stream-api:comms-messenger-stream-api",
        "//comms/facade/messenger-stream-grpc:comms-messenger-stream-grpc",
        "third-party//:prost",
        "third-party//:protoc-bin-vendored",
        "third-party//:tonic",
        "third-party//:tonic-prost",
        "third-party//:tonic-prost-build",
    ],
)
