rust_library(
    name = "oya-ci-materializer-kernel",
    # ADR-0597 — E1: pure planner kernel. Library sources are Rust-only; the broad
    # data-file glob is unnecessary here (fixtures live under tests/ and belong to the
    # conformance target). Narrowed to src/**/*.rs to keep the cache key tight.
    srcs = glob(["src/**/*.rs"]),
    crate = "oya_ci_materializer_kernel",
    crate_root = "src/lib.rs",
    visibility = ["PUBLIC"],
    deps = [
        "third-party//:serde",
        "third-party//:serde_json",
    ],
)

rust_test(
    name = "oya-ci-materializer-kernel-unittest",
    # Inline #[cfg(test)] modules compile only the library Rust sources.
    srcs = glob(["src/**/*.rs"]),
    crate = "oya_ci_materializer_kernel",
    crate_root = "src/lib.rs",
    visibility = ["PUBLIC"],
    deps = [
        "third-party//:serde",
        "third-party//:serde_json",
    ],
)

rust_test(
    name = "oya-ci-materializer-kernel-conformance",
    srcs = glob(["tests/**/*.rs", "tests/**/*.json"]),
    crate = "oya_ci_materializer_kernel_conformance",
    crate_root = "tests/conformance.rs",
    visibility = ["PUBLIC"],
    deps = [
        ":oya-ci-materializer-kernel",
        "third-party//:serde_json",
    ],
)
