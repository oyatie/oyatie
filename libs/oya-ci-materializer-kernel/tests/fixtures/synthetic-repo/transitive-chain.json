{
  "$schema": "https://example.com/schemas/generated-artifact-control-plane.schema.json",
  "schema_version": 2,
  "canonical_name": "synthetic-transitive-chain",
  "public_product_contract": "Minimal 3-node producer -> intermediate -> leaf chain to exercise the TRANSITIVE (multi-hop) input_contract closure, not just the direct edge.",
  "runner_registry": [
    {
      "runner_id": "node-codegen",
      "canonical_target_prefix": "npm://",
      "lowering": "npx-codegen"
    }
  ],
  "artifacts": [
    {
      "artifact_id": "chain-producer",
      "path": "gen/chain/producer.ts",
      "artifact_class": "pure-view",
      "materialization_mode": "not-tracked-in-git",
      "merge_policy": "never-manual-merge-regenerate-from-source-tree",
      "owner_team": "frontend",
      "generator": {
        "runner": "node-codegen",
        "generator_target": "npm://codegen/producer",
        "operation_id": "emit-chain-producer",
        "parameters": {},
        "input_contract": ["repo-root"],
        "output_mode": "declared-artifact-path-write"
      }
    },
    {
      "artifact_id": "chain-intermediate",
      "path": "gen/chain/intermediate.ts",
      "artifact_class": "pure-view",
      "materialization_mode": "not-tracked-in-git",
      "merge_policy": "never-manual-merge-regenerate-from-source-tree",
      "owner_team": "frontend",
      "generator": {
        "runner": "node-codegen",
        "generator_target": "npm://codegen/intermediate",
        "operation_id": "emit-chain-intermediate",
        "parameters": {},
        "input_contract": ["emit-chain-producer"],
        "output_mode": "declared-artifact-path-write"
      }
    },
    {
      "artifact_id": "chain-leaf",
      "path": "gen/chain/leaf.ts",
      "artifact_class": "pure-view",
      "materialization_mode": "not-tracked-in-git",
      "merge_policy": "never-manual-merge-regenerate-from-source-tree",
      "owner_team": "frontend",
      "generator": {
        "runner": "node-codegen",
        "generator_target": "npm://codegen/leaf",
        "operation_id": "emit-chain-leaf",
        "parameters": {},
        "input_contract": ["emit-chain-intermediate"],
        "output_mode": "declared-artifact-path-write"
      }
    }
  ]
}
