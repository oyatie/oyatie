{
  "$schema": "https://example.com/schemas/generated-artifact-control-plane.schema.json",
  "schema_version": 2,
  "canonical_name": "synthetic-repo-control-plane",
  "public_product_contract": "Any repository adopting oya-ci can provide this manifest plus an SCM-facts snapshot to the Rust gate.",
  "runner_registry": [
    {
      "runner_id": "buck2",
      "canonical_target_prefix": "//",
      "lowering": "build-target-then-exec",
      "irreducible_glue_adr": "ADR-0523"
    },
    {
      "runner_id": "node-codegen",
      "canonical_target_prefix": "npm://",
      "lowering": "npx-codegen"
    }
  ],
  "artifacts": [
    {
      "artifact_id": "synthetic-scm-facts",
      "path": "ci/scm-facts.generated.json",
      "artifact_class": "pure-view",
      "materialization_mode": "not-tracked-in-git",
      "merge_policy": "never-manual-merge-regenerate-from-source-tree",
      "owner_team": "platform",
      "generator": {
        "runner": "buck2",
        "generator_target": "//ci/emitter:emitter-bin",
        "operation_id": "emit-scm-facts",
        "parameters": {},
        "input_contract": ["repo-root", "full-depth-scm"],
        "output_mode": "declared-artifact-path-write"
      }
    },
    {
      "artifact_id": "synthetic-buck2-face",
      "path": "ci/registry.generated.json",
      "artifact_class": "pure-view",
      "materialization_mode": "not-tracked-in-git",
      "merge_policy": "never-manual-merge-regenerate-from-source-tree",
      "owner_team": "platform",
      "generator": {
        "runner": "buck2",
        "generator_target": "//ci/producer:producer-bin",
        "operation_id": "emit-registry",
        "parameters": {"face": "registry"},
        "input_contract": ["repo-root", "emit-scm-facts"],
        "output_mode": "stdout-json"
      }
    },
    {
      "artifact_id": "synthetic-ts-schema",
      "path": "src/__generated__/schema.ts",
      "artifact_class": "pure-view",
      "materialization_mode": "not-tracked-in-git",
      "merge_policy": "never-manual-merge-regenerate-from-source-tree",
      "owner_team": "frontend",
      "generator": {
        "runner": "node-codegen",
        "generator_target": "npm://codegen/graphql",
        "operation_id": "emit-graphql-types",
        "parameters": {"schema": "schema.graphql"},
        "input_contract": ["repo-root", "schema.graphql"],
        "output_mode": "declared-artifact-path-write"
      }
    },
    {
      "artifact_id": "synthetic-api-client",
      "path": "gen/api-client/index.ts",
      "artifact_class": "pure-view",
      "materialization_mode": "not-tracked-in-git",
      "merge_policy": "never-manual-merge-regenerate-from-source-tree",
      "owner_team": "frontend",
      "generator": {
        "runner": "node-codegen",
        "generator_target": "npm://codegen/openapi",
        "operation_id": "emit-api-client",
        "parameters": {"schema": "openapi.yaml"},
        "input_contract": ["repo-root", "emit-graphql-types"],
        "output_mode": "declared-artifact-path-write"
      }
    },
    {
      "artifact_id": "synthetic-committed-openapi",
      "path": "docs/openapi.json",
      "artifact_class": "committed",
      "materialization_mode": "merge-candidate",
      "merge_policy": "never-manual-merge-regenerate-from-source-tree",
      "owner_team": "platform",
      "generator": {
        "runner": "buck2",
        "generator_target": "//docs:openapi-gen",
        "operation_id": "emit-openapi",
        "parameters": {},
        "input_contract": ["repo-root"],
        "output_mode": "stdout-json"
      }
    }
  ]
}
