{
  "_managed_by": "tools/hook-bootstrap/install.sh",
  "_marker": "oya-bootstrap-v1",
  "_note": "Project-scoped Claude Code settings. Runtime hook commands are intentionally omitted so OMC owns Claude hook orchestration without project-level non-OMC hook conflicts; Codex/Gemini project hooks are declared in specs/agent-hook-runtime-manifest.json.",
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": false,
    "filesystem": {
      "denyRead": [
        "~/.ssh/**",
        "~/.aws/**",
        "~/.config/gcloud/**",
        "**/secrets/**",
        "**/*.pem",
        "**/*.key",
        "**/id_rsa",
        "**/id_ed25519",
        "**/*.p12",
        "**/*.pfx",
        "**/*.kubeconfig"
      ],
      "denyWrite": [
        ".env",
        "**/.env",
        "**/.env.local",
        "**/.env.*.local",
        "**/.env.production",
        "**/.env.development"
      ]
    },
    "network": {
      "allowedDomains": [
        "localhost",
        "127.0.0.1",
        "*.local",
        "*.internal",
        "github.com",
        "*.github.com",
        "*.githubusercontent.com",
        "crates.io",
        "static.crates.io",
        "index.crates.io",
        "static.rust-lang.org",
        "*.rust-lang.org",
        "api.anthropic.com",
        "*.anthropic.com"
      ]
    }
  },
  "permissions": {
    "deny": [
      "Bash(docker *)",
      "Bash(docker:*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gcloud/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/*.kubeconfig)",
      "Read(**/secrets/**)"
    ],
    "disableBypassPermissionsMode": "disable"
  }
}
