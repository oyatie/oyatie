{
  "_managed_by": "hand-maintained (governance PR review); the tools/hook-bootstrap installer was retired in #634",
  "_marker": "oya-bootstrap-v1",
  "_note": "Project-scoped Claude Code hooks (G011: recreated 2026-06-09 after deletion in #606 left Claude sessions without the cargo/local-authority enforcement that Codex sessions get via .codex/hooks.json). Mirrors the .codex/hooks.json hook set; keep the two files in sync via governance PR. The historical sandbox/permissions hardening from the 2026-05-29 security redesign (see git show b626818d1^:.claude/settings.json) is restorable in a separate security lane.",
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "tools/hooks/spec-version-pin-suggester.sh",
            "type": "command"
          },
          {
            "command": "tools/hooks/adr-orphan-detect.sh",
            "type": "command"
          },
          {
            "command": "tools/hooks/vacuous-green-gate-detect.sh",
            "type": "command"
          }
        ],
        "matcher": "Edit|MultiEdit|Write"
      },
      {
        "hooks": [
          {
            "command": "tools/hooks/injection-content-scanner.sh",
            "type": "command"
          }
        ],
        "matcher": "Bash|WebFetch|WebSearch"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "tools/hooks/local-authority-enforcer.sh",
            "type": "command"
          },
          {
            "command": "tools/hooks/no-cargo-enforcer.sh",
            "type": "command"
          },
          {
            "command": "tools/hooks/stale-tool-suggester.sh",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "tools/hooks/pre-dispatch-guide.sh",
            "type": "command"
          }
        ],
        "matcher": "Task"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bd prime --hook-json",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "tools/hooks/stop-did-you-forget-suggester.sh",
            "type": "command"
          }
        ]
      }
    ]
  }
}