/target/
**/target/
/.omx/
.DS_Store
**/.DS_Store

# Local secrets and credentials (never committed).
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.p12
*.pfx
*.kubeconfig

.grit
/bominal/

# Python bytecode (per shell-python audit 2026-05-15)
__pycache__/
*.pyc

# Transient session-scoped audit logs
.audit/
evidence/oci-readiness/a1-capacity-retry.log

# OMC atomic-write temp residue (write-then-rename crash debris)
# Pattern catches *.json.tmp.<uuid> and *.tmp.<uuid> shapes.
**/*.json.tmp.*
.omc/**/*.tmp.*

# Agent-spawned Claude Code worktrees (transient; each is a git worktree itself).
# .claude/settings.json (project-scoped) and .claude/commands/ remain tracked.
.claude/worktrees/

# Transient session state (regenerable; not part of PR scope)
.omc/state/sessions/
.omc/state/last-tool-error.json
.omc/state/hud-stdin-cache.json
test-results/

# buck2 build output
/buck-out/
