/target/
**/target/
# Local agent/runtime state is durable outside git only. Do not commit OMC/OMX
# plans, sessions, checkpoints, HUD state, logs, or verification scratch.
/.omc/*
!/.omc/ultragoal/
/.omc/ultragoal/*
!/.omc/ultragoal/OWNERS
!/.omc/ultragoal/TEAMMATE-PREAMBLE.md
!/.omc/ultragoal/friction-ledger.jsonl
!/.omc/ultragoal/premise.txt
!/.omc/ultragoal/review-verdict.txt
/.omx/
.DS_Store
**/.DS_Store

# Local secrets and credentials (never committed).
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.p12
*.pfx
*.kubeconfig

.grit
/bominal/

# Python bytecode (per shell-python audit 2026-05-15)
__pycache__/
*.pyc

# Transient session-scoped audit logs
.audit/
evidence/oci-readiness/a1-capacity-retry.log

# Atomic-write temp residue (write-then-rename crash debris).
# Pattern catches *.json.tmp.<uuid> and *.tmp.<uuid> shapes outside ignored
# runtime roots.
**/*.json.tmp.*

# Agent-spawned Claude Code worktrees (transient; each is a git worktree itself).
# .claude/settings.json (project-scoped) and .claude/commands/ remain tracked.
.claude/worktrees/

# Session-scoped Claude hook overrides are local-only; tracked project wiring stays authoritative.
.claude/settings.local.json

# Transient test output
test-results/

# Generated outputs default to untracked. Public/productized generated
# artifacts that must be committed are force-added intentionally and declared in
# registry/generated-artifact-control-plane.json, where cloud-ci enforces owner,
# generator, materialization, and merge policy. Keep this preventive layer aligned
# with the manifest's generated_path_rules; the Rust gate is authoritative.
**/generated/**
**/__generated__/**
**/generated-sources/**
**/generated-types/**
**/gen/**
**/*.generated.json
**/*.generated.ts
**/*.generated.d.ts
**/*.pb.go
**/*.pb.rs
!**/generated/
!**/generated/.gitkeep

# buck2 build output
/buck-out/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
