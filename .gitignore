/target/
**/target/
# Local agent/runtime state is durable outside git only. Do not commit OMC/OMX
# plans, sessions, checkpoints, HUD state, logs, or verification scratch.
/.omc/*
!/.omc/ultragoal/
/.omc/ultragoal/*
!/.omc/ultragoal/OWNERS
!/.omc/ultragoal/TEAMMATE-PREAMBLE.md
!/.omc/ultragoal/friction-ledger.jsonl
!/.omc/ultragoal/premise.txt
/.omx/
.DS_Store
**/.DS_Store

# Local secrets and credentials (never committed).
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.p12
*.pfx
*.kubeconfig

.grit
/bominal/

# Python bytecode (per shell-python audit 2026-05-15)
__pycache__/
*.pyc

# Transient session-scoped audit logs
.audit/
evidence/oci-readiness/a1-capacity-retry.log

# Atomic-write temp residue (write-then-rename crash debris).
# Pattern catches *.json.tmp.<uuid> and *.tmp.<uuid> shapes outside ignored
# runtime roots.
**/*.json.tmp.*

# Agent-spawned Claude Code worktrees (transient; each is a git worktree itself).
# .claude/settings.json (project-scoped) and .claude/commands/ remain tracked.
.claude/worktrees/

# Session-scoped Claude hook overrides are local-only; tracked project wiring stays authoritative.
.claude/settings.local.json

# Transient test output
test-results/

# Generated outputs default to untracked. Public/productized generated
# artifacts that must be committed are force-added intentionally and declared in
# registry/generated-artifact-control-plane.json, where cloud-ci enforces owner,
# generator, materialization, and merge policy. Keep this preventive layer aligned
# with the manifest's generated_path_rules; the Rust gate is authoritative.
**/generated/**
**/__generated__/**
**/generated-sources/**
**/generated-types/**
**/gen/**
**/*.generated.json
**/*.generated.ts
**/*.generated.d.ts
**/*.pb.go
**/*.pb.rs
!**/generated/
!**/generated/.gitkeep

# Rename-aware path-keyed CI baseline relabel move-manifest (task #64): a COMMITTED review
# artifact (the authoritative move bijection the scm-facts emitter relabel consumes), unlike
# the untracked per-checkout snapshots below. It is regenerated each PR run by the codemod
# `manifest` subcommand and byte-bound by the registry-drift/freshness committed==regenerated
# coverage + declared in registry/generated-artifact-control-plane.json, so it must be TRACKED
# (the control-plane gate's declared-path-must-be-tracked predicate). Negate the broad
# *.generated.json ignore for exactly this path.
!specs/reorg/move-manifest.generated.json

# buck2 build output
/buck-out/

# Merge-base frozen-baseline snapshot (ADR-0551, FRIC-1781112000): a per-checkout derived
# reference materialized by the scm-facts emitter from `git merge-base <base_ref> HEAD`.
# It varies with the base branch position, so it can never be a committed face; CI
# rematerializes it before gates consume it.
cloud/cloud-ci/gates/oya-cloud-ci-firewall-app/gate-baseline.merge-base.generated.json

# History-volatile SCM facts snapshot (ADR-0552, FRIC-1781234047): per-path last-touch
# revision ids + timestamps, rewritten by every squash-merge — a per-checkout derived input
# materialized by the scm-facts emitter, so it can never be a committed face; CI
# rematerializes it before gates consume it.
cloud/cloud-ci/gates/oya-cloud-ci-scm-facts-emitter-app/scm-volatile-facts.generated.json
