{
  "$schema": "https://schemas.grafana.com/dashboard.json",
  "_meta": {
    "doc_class": "GrafanaDashboard",
    "microservice": "cloud-k8s",
    "owner_team": "axis-cloud + ops-sre-reliability",
    "audience": "cluster operators + on-call IC",
    "tenant_scoped": false,
    "datasource": "Mimir aggregate (per-pack cluster); Prometheus kube-state-metrics"
  },
  "uid": "cloud-k8s-cluster-health",
  "title": "cloud-k8s — Cluster Health",
  "tags": ["cloud-k8s", "kubernetes", "cluster", "health"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Cluster status by pack",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "targets": [
        {"expr": "count by (pack) (cloud_k8s_cluster_status{status=\"ready\"})", "legendFormat": "{{pack}} ready", "refId": "A"}
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Total nodes (per cluster)",
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
      "targets": [
        {"expr": "sum by (cluster) (kube_node_info)", "legendFormat": "{{cluster}}", "refId": "A"}
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Ready vs NotReady nodes",
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
      "targets": [
        {"expr": "sum by (condition) (kube_node_status_condition{condition=\"Ready\",status=\"true\"})", "legendFormat": "Ready", "refId": "A"},
        {"expr": "sum by (condition) (kube_node_status_condition{condition=\"Ready\",status=\"false\"})", "legendFormat": "NotReady", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 1}, {"color": "red", "value": 3}]}}}
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "kube-apiserver request latency (p99)",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "targets": [
        {"expr": "histogram_quantile(0.99, sum by (verb, le) (rate(apiserver_request_duration_seconds_bucket{verb!~\"WATCH|WATCHLIST\"}[5m])))", "legendFormat": "{{verb}}", "refId": "A"}
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "kube-apiserver 5xx rate",
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum by (verb) (rate(apiserver_request_total{code=~\"5..\"}[5m]))", "legendFormat": "{{verb}}", "refId": "A"}
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "etcd has-leader",
      "gridPos": {"x": 0, "y": 12, "w": 8, "h": 6},
      "targets": [
        {"expr": "etcd_server_has_leader", "legendFormat": "{{instance}}", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"min": 0, "max": 1}}
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "etcd request commit latency (p99)",
      "gridPos": {"x": 8, "y": 12, "w": 8, "h": 6},
      "targets": [
        {"expr": "histogram_quantile(0.99, rate(etcd_disk_backend_commit_duration_seconds_bucket[5m]))", "legendFormat": "p99", "refId": "A"}
      ]
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Sec since last etcd snapshot",
      "gridPos": {"x": 16, "y": 12, "w": 8, "h": 6},
      "targets": [
        {"expr": "time() - cloud_k8s_etcd_snapshot_completed_timestamp_seconds", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 300}, {"color": "red", "value": 600}]}}}
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "kubernetes-api-proxy request rate + latency p99",
      "gridPos": {"x": 0, "y": 18, "w": 12, "h": 6},
      "targets": [
        {"expr": "rate(kubernetes_api_proxy_requests_total[5m])", "legendFormat": "rate (req/s)", "refId": "A"},
        {"expr": "histogram_quantile(0.99, rate(kubernetes_api_proxy_request_duration_seconds_bucket[5m]))", "legendFormat": "p99 latency", "refId": "B"}
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Pods per cluster (running)",
      "gridPos": {"x": 12, "y": 18, "w": 12, "h": 6},
      "targets": [
        {"expr": "sum by (cluster) (kube_pod_status_phase{phase=\"Running\"})", "legendFormat": "{{cluster}}", "refId": "A"}
      ]
    },
    {
      "id": 11,
      "type": "table",
      "title": "Recent ClusterBootstrapped / NodeJoined / NodeFailed events",
      "gridPos": {"x": 0, "y": 24, "w": 24, "h": 8},
      "targets": [
        {"expr": "topk(20, cloud_k8s_audit_event_timestamp{event_kind=~\"ClusterBootstrapped|NodeJoined|NodeFailed|KubeadmUpgraded\"})", "format": "table", "refId": "A"}
      ]
    }
  ]
}
