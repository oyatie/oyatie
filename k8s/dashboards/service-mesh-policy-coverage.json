{
  "$schema": "https://schemas.grafana.com/dashboard.json",
  "_meta": {
    "doc_class": "GrafanaDashboard",
    "microservice": "cloud-k8s",
    "owner_team": "axis-cloud + ops-security",
    "audience": "security operators + ops-security on-call",
    "tenant_scoped": false,
    "datasource": "Mimir (Istio + Cilium) + audit-chain Loki"
  },
  "uid": "cloud-k8s-mesh-policy-coverage",
  "title": "cloud-k8s — Service Mesh + Policy Coverage",
  "tags": ["cloud-k8s", "istio", "cilium", "policy", "security"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "mTLS strict coverage (% pods with strict mTLS)",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "targets": [
        {"expr": "100 * sum(istio_pilot_proxy_mtls_strict_count) / sum(istio_pilot_proxy_count)", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "percent", "thresholds": {"steps": [{"color": "red", "value": 0}, {"color": "yellow", "value": 95}, {"color": "green", "value": 99}]}}}
    },
    {
      "id": 2,
      "type": "stat",
      "title": "NetworkPolicy coverage (% namespaces with policy)",
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
      "targets": [
        {"expr": "100 * (count by (cluster) (count by (namespace) (kube_networkpolicy_info)) / count by (cluster) (count by (namespace) (kube_namespace_labels)))", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "percent", "thresholds": {"steps": [{"color": "red", "value": 0}, {"color": "yellow", "value": 95}, {"color": "green", "value": 100}]}}}
    },
    {
      "id": 3,
      "type": "stat",
      "title": "AuthorizationPolicy coverage (% tenant ns with policy)",
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
      "targets": [
        {"expr": "100 * (count by (cluster) (count by (namespace) (istio_authorization_policy_info{namespace=~\"tenant-.*\"})) / count by (cluster) (count by (namespace) (kube_namespace_labels{namespace=~\"tenant-.*\"})))", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "percent"}}
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Cross-tenant cleartext attempts (alert > 0)",
      "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
      "targets": [
        {"expr": "sum(rate(cross_namespace_cleartext_attempt_total[5m]))", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "red", "value": 0.01}]}}}
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Istio xDS push latency (p99)",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "targets": [
        {"expr": "histogram_quantile(0.99, rate(pilot_xds_push_time_seconds_bucket[5m]))", "legendFormat": "{{revision}}", "refId": "A"}
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Cilium policy revision propagation lag",
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
      "targets": [
        {"expr": "max by (node) (cilium_policy_max_revision - cilium_policy_endpoint_revision)", "legendFormat": "{{node}}", "refId": "A"}
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Tenant-scope policy decisions (allow vs deny)",
      "gridPos": {"x": 0, "y": 12, "w": 8, "h": 6},
      "targets": [
        {"expr": "sum(rate(kubernetes_api_proxy_cedar_decision_total{decision=\"allow\"}[5m]))", "legendFormat": "allow/s", "refId": "A"},
        {"expr": "sum(rate(kubernetes_api_proxy_cedar_decision_total{decision=\"deny\"}[5m]))", "legendFormat": "deny/s", "refId": "B"}
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Authorization Policy denies (by namespace)",
      "gridPos": {"x": 8, "y": 12, "w": 16, "h": 6},
      "targets": [
        {"expr": "sum by (destination_namespace) (rate(istio_requests_total{response_code=\"403\"}[5m]))", "legendFormat": "{{destination_namespace}}", "refId": "A"}
      ]
    },
    {
      "id": 9,
      "type": "table",
      "title": "Recent IstioPolicyChanged / NetworkPolicyApplied audit events",
      "gridPos": {"x": 0, "y": 18, "w": 24, "h": 10},
      "targets": [
        {"expr": "topk(30, cloud_k8s_audit_event_timestamp{event_kind=~\"IstioPolicyChanged|NetworkPolicyApplied\"})", "format": "table", "refId": "A"}
      ],
      "transformations": [
        {"id": "organize", "options": {"includeByName": {"event_kind": true, "namespace": true, "policy_name": true, "derived_from_cedar_sha": true, "executor": true, "ts": true}}}
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Cosign admission decisions (rejected unsigned images)",
      "gridPos": {"x": 0, "y": 28, "w": 12, "h": 6},
      "targets": [
        {"expr": "sum(rate(admission_image_rejected_total[5m]))", "legendFormat": "rejected/s", "refId": "A"},
        {"expr": "sum(rate(admission_image_admitted_total[5m]))", "legendFormat": "admitted/s", "refId": "B"}
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Kyverno admission webhook latency (p99)",
      "gridPos": {"x": 12, "y": 28, "w": 12, "h": 6},
      "targets": [
        {"expr": "histogram_quantile(0.99, rate(kyverno_admission_review_duration_seconds_bucket[5m]))", "legendFormat": "{{operation}}", "refId": "A"}
      ]
    }
  ]
}
