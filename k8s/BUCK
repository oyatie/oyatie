# Residual product/docs surface for k8s capability (dual-home burn-down).
# Live crates live under k8s/{core,ports,adapters,facade} with their own package
# BUCKs. This package owns residual service docs, manifests, contracts, and
# OpenSLO YAML rehomed from cloud/cloud-k8s, cloud/managed-k8s-cluster-lifecycle,
# cloud/managed-k8s-control-plane-host, cloud/managed-k8s-sla-observability and
# cloud/managed-k8s-tenant-quota (wave 25) so they remain in the Buck2 corpus
# graph (ADR-0541).

load("//governance/corpus/extract:yaml_facts.bzl", "corpus_yaml_facts_shards")

# Hermetic input set for gates that must validate k8s residual manifests.
filegroup(
    name = "live-service-manifest-corpus",
    srcs = glob(["**/manifest.json"]),
    visibility = ["PUBLIC"],
)

corpus_yaml_facts_shards(
    srcs = glob(["**/*.yaml", "**/*.yml"]),
    shard_size = 256,
)
