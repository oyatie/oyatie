  "owner": "axis-cloud-k8s",
  "bounded_contexts": [
    {
      "name": "managed-k8s-sla-observability",
      "description": "Tenant-scoped managed-Kubernetes SLA observability. Consumes the ControlPlaneProvisioning/status seam from managed-k8s-control-plane-host, computes deterministic availability/provisioning-latency/error-budget summaries, and defers live Prometheus/Kubernetes integration behind the port.",
      "crates": [
        "oya-managed-k8s-sla-observability-kernel",
        "oya-managed-k8s-sla-observability-api",
        "oya-managed-k8s-sla-observability-adapter-inmemory",
        "oya-managed-k8s-sla-observability-app"
      ]
    }
  ],
  "layers": [
    "adapter",
    "api",
    "app",
    "kernel"
  ],
  "contracts": {
    "openapi": [
      "microservices/managed-k8s-sla-observability/contracts/openapi-v1.yaml"
    ],
    "asyncapi": [
      "microservices/managed-k8s-sla-observability/contracts/asyncapi-v1.yaml"
    ],
    "internal_grpc": {
      "transport": "http2",
      "language_profile": "proto3",
      "contracts": [
        "k8s/managed-sla-observability/contracts/managed-k8s-sla-observability.proto"
      ]
    }
  },
  "capabilities": [
    {
      "tier": "T1",
      "name": "sla-summary-read",
      "file": "microservices/managed-k8s-sla-observability/capabilities/sla-summary-read.yaml",
      "risk_class": "minimal"
    }
  ],
  "slos": [
    {
      "name": "managed-cluster-availability",
      "target": "0.999",
      "sli": "healthy_status_samples / total_status_samples from managed-k8s SLA observation snapshots",
      "file": "k8s/observability/slos/sla-observability/managed-cluster-availability.openslo.yaml"
    },
    {
      "name": "managed-cluster-provisioning-latency",
      "target": "<= 600000ms",
      "sli": "provisioning_latency_millis from managed-k8s SLA observation snapshots",
      "file": "k8s/observability/slos/sla-observability/provisioning-latency.openslo.yaml"
    }
  ],
  "ips": [
    {
