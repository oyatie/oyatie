# Residual product/docs surface for observability capability (dual-home burn-down).
# Live crates live under observability/{core,adapters} with their own package
# BUCKs. This package owns residual service docs, manifests, contracts, and
# OpenSLO YAML rehomed from oya/diagnostics and oya/observability (wave 26) so
# they remain in the Buck2 corpus graph (ADR-0541).

load("//governance/corpus/extract:yaml_facts.bzl", "corpus_yaml_facts_shards")

# Hermetic input set for gates that must validate observability residual manifests.
filegroup(
    name = "live-service-manifest-corpus",
    srcs = glob(["**/manifest.json"]),
    visibility = ["PUBLIC"],
)

corpus_yaml_facts_shards(
    srcs = glob(["**/*.yaml", "**/*.yml"]),
    shard_size = 256,
)
