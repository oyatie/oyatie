{
  "$schema": "https://schemas.grafana.com/dashboard.json",
  "_meta": {
    "doc_class": "GrafanaDashboard",
    "microservice": "observability",
    "owner_team": "axis-foundry + axis-observability",
    "audience": "promotion-gate consumers (CI lane + reviewer agent + on-call IC)",
    "tenant_scoped": false,
    "datasource": "Mimir aggregate (ci + aggregate); recording-rules"
  },
  "uid": "obs-gate-eligibility",
  "title": "Gate Eligibility — Promotion Readiness View",
  "tags": ["observability", "gate", "vcs", "promotion"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Pending promotions (count by target env)",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "targets": [
        {"expr": "count(oya:current_verdict:by_microservice_env{target_env=\"staging\",verdict=\"eligible\"})", "legendFormat": "→ staging", "refId": "A"},
        {"expr": "count(oya:current_verdict:by_microservice_env{target_env=\"production\",verdict=\"eligible\"})", "legendFormat": "→ production", "refId": "B"}
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Held promotions (count)",
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
      "targets": [
        {"expr": "count(oya:current_verdict:by_microservice_env{verdict=\"held\"})", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 5}, {"color": "red", "value": 20}]}}}
    },
    {
      "id": 3,
      "type": "table",
      "title": "Current verdict per (microservice, target_env)",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 12},
      "targets": [
        {
          "expr": "oya:current_verdict:by_microservice_env",
          "format": "table",
          "refId": "A"
        }
      ],
      "transformations": [
        {"id": "organize", "options": {"includeByName": {"microservice": true, "target_env": true, "verdict": true, "evaluated_at": true}, "renameByName": {"verdict": "Verdict", "evaluated_at": "Evaluated"}}}
      ]
    },
    {
      "id": 4,
      "type": "table",
      "title": "All-eligible-by-SHA aggregate (for CI lane)",
      "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "oya:all_eligible:by_sha",
          "format": "table",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "PromotionExecuted + RollbackExecuted events",
      "gridPos": {"x": 0, "y": 24, "w": 12, "h": 8},
      "targets": [
        {"expr": "increase(promotion_executed_total[5m])", "legendFormat": "promoted (rate per 5m)", "refId": "A"},
        {"expr": "increase(rollback_executed_total[5m])", "legendFormat": "rolled back (rate per 5m)", "refId": "B"}
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Canary cohort weight progression",
      "gridPos": {"x": 0, "y": 32, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "service_mesh_traffic_split_weight{cohort=\"canary\"}",
          "legendFormat": "{{microservice}}",
          "refId": "A"
        }
      ]
    }
  ]
}
