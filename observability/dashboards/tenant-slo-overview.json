{
  "$schema": "https://schemas.grafana.com/dashboard.json",
  "_meta": {
    "doc_class": "GrafanaDashboard",
    "microservice": "observability",
    "owner_team": "axis-observability",
    "related_artifacts": [
      "observability/contracts/openapi/slo-engine.yaml",
      "observability/policy/tenant-scope.cedar"
    ],
    "audience": "tenant operators",
    "tenant_scoped": true,
    "datasource": "Mimir (per-pack); X-Scope-OrgID = principal.tenant_id"
  },
  "uid": "obs-tenant-slo-overview",
  "title": "SLO Overview (per tenant)",
  "tags": ["observability", "slo", "tenant-facing"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-30d", "to": "now"},
  "timepicker": {"refresh_intervals": ["10s","30s","1m","5m","15m","30m","1h"]},
  "templating": {
    "list": [
      {
        "name": "microservice",
        "type": "query",
        "datasource": "Mimir",
        "query": "label_values(oya_promotion_eligibility_verdict, microservice)",
        "refresh": 1,
        "label": "Microservice"
      },
      {
        "name": "environment",
        "type": "custom",
        "options": [
          {"text": "staging", "value": "staging", "selected": false},
          {"text": "production", "value": "production", "selected": true}
        ],
        "label": "Environment"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Current verdict — $microservice / $environment",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "targets": [
        {
          "expr": "oya:current_verdict:by_microservice_env{microservice=\"$microservice\",target_env=\"$environment\"}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {"type": "value", "options": {"eligible": {"text": "ELIGIBLE", "color": "green"}, "held": {"text": "HELD", "color": "yellow"}, "rejected": {"text": "REJECTED", "color": "orange"}, "rollback": {"text": "ROLLBACK", "color": "red"}}}
          ]
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Error budget remaining (30d)",
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
      "targets": [
        {
          "expr": "oya_promotion_budget_remaining_pct{microservice=\"$microservice\",target_env=\"$environment\"}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "steps": [
              {"color": "red", "value": 0},
              {"color": "yellow", "value": 25},
              {"color": "green", "value": 50}
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Burn-rate (fast-1h vs slow-6h)",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "targets": [
        {"expr": "oya_promotion_burn_rate_fast_1h{microservice=\"$microservice\",target_env=\"$environment\"}", "legendFormat": "fast 1h", "refId": "A"},
        {"expr": "oya_promotion_burn_rate_slow_6h{microservice=\"$microservice\",target_env=\"$environment\"}", "legendFormat": "slow 6h", "refId": "B"}
      ],
      "alert": {
        "name": "fast-burn-page",
        "conditions": [
          {"evaluator": {"params": [14.4], "type": "gt"}, "query": {"params": ["A", "5m", "now"]}, "type": "query"}
        ],
        "notifications": [{"uid": "grafana-oncall"}]
      }
    },
    {
      "id": 4,
      "type": "table",
      "title": "Eligibility verdicts — last 24h",
      "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "oya_promotion_eligibility_verdict{microservice=\"$microservice\"}",
          "format": "table",
          "instant": false,
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Per-SLI burn-rate breakdown",
      "gridPos": {"x": 0, "y": 20, "w": 12, "h": 8},
      "targets": [
        {"expr": "oya_promotion_burn_rate_fast_1h{microservice=\"$microservice\",target_env=\"$environment\"}", "legendFormat": "{{sli}} — fast 1h", "refId": "A"}
      ]
    }
  ]
}
