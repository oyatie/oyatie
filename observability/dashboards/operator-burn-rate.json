{
  "$schema": "https://schemas.grafana.com/dashboard.json",
  "_meta": {
    "doc_class": "GrafanaDashboard",
    "microservice": "observability",
    "owner_team": "ops-sre-reliability + axis-observability",
    "audience": "internal operators (cross-tenant view; behind admin-only RBAC + Cedar)",
    "tenant_scoped": false,
    "datasource": "Mimir aggregate (aggregate tenant; DP-noise protected for any cross-tenant aggregates) and per-pack Mimir endpoints"
  },
  "uid": "obs-operator-burn-rate",
  "title": "Burn-rate Operator View (cross-microservice)",
  "tags": ["observability", "operator", "burn-rate"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "templating": {
    "list": [
      {
        "name": "pack",
        "type": "custom",
        "options": [
          {"text": "pack-kr", "value": "kr", "selected": true},
          {"text": "pack-eu", "value": "eu"},
          {"text": "pack-us", "value": "us"},
          {"text": "pack-us-healthcare", "value": "us-hc"},
          {"text": "pack-jp", "value": "jp"},
          {"text": "pack-sg", "value": "sg"},
          {"text": "pack-au", "value": "au"},
          {"text": "pack-in", "value": "in"},
          {"text": "pack-br", "value": "br"},
          {"text": "pack-ae", "value": "ae"},
          {"text": "pack-ksa", "value": "ksa"}
        ],
        "label": "Pack"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "Microservices currently in HELD / REJECTED / ROLLBACK",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "oya:current_verdict:by_microservice_env{pack=\"$pack\",verdict!=\"eligible\"}",
          "format": "table",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Aggregate fast-burn-1h across microservices",
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "topk(10, promotion_burn_rate_fast_1h{pack=\"$pack\"})",
          "legendFormat": "{{microservice}}/{{sli}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Eligible / Held / Rejected / Rollback count (pack-wide)",
      "gridPos": {"x": 0, "y": 16, "w": 12, "h": 4},
      "targets": [
        {"expr": "count(oya:current_verdict:by_microservice_env{pack=\"$pack\",verdict=\"eligible\"})", "legendFormat": "eligible", "refId": "A"},
        {"expr": "count(oya:current_verdict:by_microservice_env{pack=\"$pack\",verdict=\"held\"})", "legendFormat": "held", "refId": "B"},
        {"expr": "count(oya:current_verdict:by_microservice_env{pack=\"$pack\",verdict=\"rejected\"})", "legendFormat": "rejected", "refId": "C"},
        {"expr": "count(oya:current_verdict:by_microservice_env{pack=\"$pack\",verdict=\"rollback\"})", "legendFormat": "rollback", "refId": "D"}
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Rollback events (last 24h)",
      "gridPos": {"x": 0, "y": 20, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "increase(promotion_eligibility_verdict{verdict=\"rollback\",pack=\"$pack\"}[24h])",
          "legendFormat": "{{microservice}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Evaluator alive + lag",
      "gridPos": {"x": 0, "y": 28, "w": 12, "h": 8},
      "targets": [
        {"expr": "observability_internal_evaluator_alive{pack=\"$pack\"}", "legendFormat": "evaluator alive", "refId": "A"},
        {"expr": "time() - promotion_eligibility_evaluated_at{pack=\"$pack\"}", "legendFormat": "{{microservice}} eval lag (s)", "refId": "B"}
      ]
    }
  ]
}
