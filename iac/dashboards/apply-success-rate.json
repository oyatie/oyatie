{
  "$schema": "https://schemas.grafana.com/dashboard.json",
  "_meta": {
    "doc_class": "GrafanaDashboard",
    "microservice": "cloud-iac",
    "owner_team": "axis-cloud-iac + ops-sre-reliability",
    "audience": "on-call IC + axis-cloud-iac SME + tenant operators",
    "tenant_scoped": true,
    "datasource": "Mimir (oya-self + oya-cloud-iac-self); recording-rules"
  },
  "uid": "cloud-iac-apply-success-rate",
  "title": "cloud-iac — Apply Success Rate + Latency",
  "tags": ["cloud-iac", "iac", "apply", "slo"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {"from": "now-6h", "to": "now"},
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Applies in the last 1h",
      "gridPos": {"x": 0, "y": 0, "w": 4, "h": 4},
      "targets": [
        {"expr": "sum(increase(oya_cloud_iac_apply_completed_total[1h]))", "refId": "A"}
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Apply success rate (1h)",
      "gridPos": {"x": 4, "y": 0, "w": 4, "h": 4},
      "targets": [
        {"expr": "sum(increase(oya_cloud_iac_apply_completed_total{state=\"completed\"}[1h])) / sum(increase(oya_cloud_iac_apply_completed_total[1h]))", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "percentunit", "thresholds": {"steps": [{"color": "red", "value": 0}, {"color": "yellow", "value": 0.95}, {"color": "green", "value": 0.995}]}}}
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Apply rate (5m avg)",
      "gridPos": {"x": 8, "y": 0, "w": 4, "h": 4},
      "targets": [
        {"expr": "sum(rate(oya_cloud_iac_apply_started_total[5m]))", "refId": "A"}
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Active (in-progress) applies",
      "gridPos": {"x": 12, "y": 0, "w": 4, "h": 4},
      "targets": [
        {"expr": "sum(oya_cloud_iac_apply_in_flight)", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 20}, {"color": "red", "value": 100}]}}}
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Stuck-apply count (last 24h)",
      "gridPos": {"x": 16, "y": 0, "w": 4, "h": 4},
      "targets": [
        {"expr": "sum(increase(oya_cloud_iac_stuck_apply_total[24h]))", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 1}, {"color": "red", "value": 5}]}}}
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Rollbacks (last 24h)",
      "gridPos": {"x": 20, "y": 0, "w": 4, "h": 4},
      "targets": [
        {"expr": "sum(increase(oya_cloud_iac_rollback_executed_total[24h]))", "refId": "A"}
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Apply latency p50 / p99 / p999 (by µservice)",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "targets": [
        {"expr": "histogram_quantile(0.5, rate(oya_cloud_iac_apply_duration_seconds_bucket[5m]))", "legendFormat": "p50 {{microservice}}", "refId": "A"},
        {"expr": "histogram_quantile(0.99, rate(oya_cloud_iac_apply_duration_seconds_bucket[5m]))", "legendFormat": "p99 {{microservice}}", "refId": "B"},
        {"expr": "histogram_quantile(0.999, rate(oya_cloud_iac_apply_duration_seconds_bucket[5m]))", "legendFormat": "p999 {{microservice}}", "refId": "C"}
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Apply success vs failure (rate per 5m)",
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum by (state) (rate(oya_cloud_iac_apply_completed_total[5m]))", "legendFormat": "{{state}}", "refId": "A"}
      ]
    },
    {
      "id": 12,
      "type": "table",
      "title": "Per-µservice apply success rate (last 24h)",
      "gridPos": {"x": 0, "y": 12, "w": 12, "h": 10},
      "targets": [
        {"expr": "sum by (microservice) (increase(oya_cloud_iac_apply_completed_total{state=\"completed\"}[24h])) / sum by (microservice) (increase(oya_cloud_iac_apply_completed_total[24h]))", "format": "table", "refId": "A"}
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Per-environment apply rate",
      "gridPos": {"x": 12, "y": 12, "w": 12, "h": 10},
      "targets": [
        {"expr": "sum by (environment) (rate(oya_cloud_iac_apply_started_total[5m]))", "legendFormat": "{{environment}}", "refId": "A"}
      ]
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Render p99 latency",
      "gridPos": {"x": 0, "y": 22, "w": 12, "h": 8},
      "targets": [
        {"expr": "histogram_quantile(0.99, rate(oya_cloud_iac_render_duration_seconds_bucket[5m]))", "legendFormat": "p99 {{microservice}}", "refId": "A"}
      ]
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "SLO burn-rate (cloud-iac self-SLOs)",
      "gridPos": {"x": 12, "y": 22, "w": 12, "h": 8},
      "targets": [
        {"expr": "oya:slo_burn_rate_1h{microservice=\"cloud-iac\"}", "legendFormat": "1h burn", "refId": "A"},
        {"expr": "oya:slo_burn_rate_6h{microservice=\"cloud-iac\"}", "legendFormat": "6h burn", "refId": "B"}
      ]
    }
  ]
}
