{
  "$schema": "https://schemas.grafana.com/dashboard.json",
  "_meta": {
    "doc_class": "GrafanaDashboard",
    "microservice": "cloud-iac",
    "owner_team": "axis-cloud-iac + cloud-secrets + ops-sre-reliability",
    "audience": "on-call IC + axis-cloud-iac SME + auditors",
    "tenant_scoped": false,
    "datasource": "Mimir (cloud-iac-self); recording-rules; Postgres exporter"
  },
  "uid": "cloud-iac-registry-health",
  "title": "cloud-iac — Registry Health (iac-state-index + chart catalog + provenance)",
  "tags": ["cloud-iac", "iac", "registry", "postgres", "slsa"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "iac-state-index rows",
      "gridPos": {"x": 0, "y": 0, "w": 4, "h": 4},
      "targets": [
        {"expr": "sum(cloud_iac_registry_rows_total)", "refId": "A"}
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Registered chart count",
      "gridPos": {"x": 4, "y": 0, "w": 4, "h": 4},
      "targets": [
        {"expr": "sum(cloud_iac_chart_records_total)", "refId": "A"}
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "SLSA L3 attestations (last 24h)",
      "gridPos": {"x": 8, "y": 0, "w": 4, "h": 4},
      "targets": [
        {"expr": "sum(increase(cloud_iac_slsa_verifications_passed_total[24h]))", "refId": "A"}
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "SLSA verify failures (last 24h; target=0)",
      "gridPos": {"x": 12, "y": 0, "w": 4, "h": 4},
      "targets": [
        {"expr": "sum(increase(cloud_iac_slsa_verify_failure_total[24h]))", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "red", "value": 1}]}}}
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Postgres replication lag (s; target ≤30)",
      "gridPos": {"x": 16, "y": 0, "w": 4, "h": 4},
      "targets": [
        {"expr": "max(pg_replication_lag_seconds{db=\"iac_state_index\"})", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 30}, {"color": "red", "value": 60}]}}}
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Postgres connection-pool utilization",
      "gridPos": {"x": 20, "y": 0, "w": 4, "h": 4},
      "targets": [
        {"expr": "max(pg_stat_activity_count{db=\"iac_state_index\"}) / max(pg_settings_max_connections{db=\"iac_state_index\"})", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "percentunit", "thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 0.7}, {"color": "red", "value": 0.9}]}}}
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "iac-state-index write rate",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "targets": [
        {"expr": "rate(cloud_iac_registry_writes_total[5m])", "legendFormat": "writes/sec", "refId": "A"}
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "iac-state-index read latency (p99)",
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
      "targets": [
        {"expr": "histogram_quantile(0.99, rate(cloud_iac_registry_read_duration_seconds_bucket[5m]))", "legendFormat": "p99", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 0.3}, {"color": "red", "value": 1}]}}}
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "SLSA L3 verification rate (success vs failure)",
      "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
      "targets": [
        {"expr": "rate(cloud_iac_slsa_verifications_passed_total[5m])", "legendFormat": "pass", "refId": "A"},
        {"expr": "rate(cloud_iac_slsa_verify_failure_total[5m])", "legendFormat": "fail", "refId": "B"}
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Cosign + Rekor verification latency",
      "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8},
      "targets": [
        {"expr": "histogram_quantile(0.99, rate(cloud_iac_cosign_verify_duration_seconds_bucket[5m]))", "legendFormat": "Cosign p99", "refId": "A"},
        {"expr": "histogram_quantile(0.99, rate(cloud_iac_rekor_lookup_duration_seconds_bucket[5m]))", "legendFormat": "Rekor p99", "refId": "B"}
      ]
    },
    {
      "id": 14,
      "type": "table",
      "title": "Top 10 µservices by apply count (last 24h)",
      "gridPos": {"x": 0, "y": 20, "w": 12, "h": 10},
      "targets": [
        {"expr": "topk(10, sum by (microservice) (increase(cloud_iac_apply_completed_total[24h])))", "format": "table", "refId": "A"}
      ]
    },
    {
      "id": 15,
      "type": "table",
      "title": "Registry storage by pack",
      "gridPos": {"x": 12, "y": 20, "w": 12, "h": 10},
      "targets": [
        {"expr": "sum by (pack) (cloud_iac_registry_rows_total)", "format": "table", "refId": "A"}
      ]
    }
  ]
}
