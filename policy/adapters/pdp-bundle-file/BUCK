# `crate` is the name Cargo derives from the package name. Cargo.toml renames two
# dependencies (`shared-pdp-kernel = { package = "policy-pdp-kernel" }`,
# `iam-pdp-kernel = { package = "policy-decision-service-kernel" }`), so every target
# here maps those idents with `named_deps`; a consumer that renames this package
# (`iam-pdp-bundle-file = { package = "policy-pdp-bundle-file" }`) does the same in its
# own BUCK with
# `named_deps = {"iam_pdp_bundle_file": "//policy/adapters/pdp-bundle-file:policy-pdp-bundle-file"}`.

rust_library(
    name = "policy-pdp-bundle-file",
    srcs = glob(["src/**/*.rs"]),
    crate = "policy_pdp_bundle_file",
    crate_root = "src/lib.rs",
    visibility = ["PUBLIC"],
    named_deps = {
        "iam_pdp_kernel": "//policy/core/decision-service-kernel:policy-decision-service-kernel",
        "shared_pdp_kernel": "//policy/core/pdp-kernel:policy-pdp-kernel",
    },
    deps = [
        "//audit/adapters/digest-awslc:shared-audit-digest-adapter-awslc",
        "//audit/core/event-kernel:shared-audit-event-kernel",
        "//iam/core/platform-contracts-kernel:shared-platform-contracts-kernel",
        "third-party//:serde",
        "third-party//:serde_json",
    ],
)

rust_test(
    name = "policy-pdp-bundle-file-unittest",
    srcs = glob(["src/**/*.rs"]),
    crate = "policy_pdp_bundle_file",
    crate_root = "src/lib.rs",
    visibility = ["PUBLIC"],
    named_deps = {
        "iam_pdp_kernel": "//policy/core/decision-service-kernel:policy-decision-service-kernel",
        "shared_pdp_kernel": "//policy/core/pdp-kernel:policy-pdp-kernel",
    },
    deps = [
        "//audit/adapters/digest-awslc:shared-audit-digest-adapter-awslc",
        "//audit/core/event-kernel:shared-audit-event-kernel",
        "//iam/core/platform-contracts-kernel:shared-platform-contracts-kernel",
        "third-party//:serde",
        "third-party//:serde_json",
    ],
)
