# `crate` keeps the pre-move name `iam_pdp_bundle_file` while consumers still say
# `use iam_pdp_bundle_file::`. Cargo derives `policy_pdp_bundle_file`; a consumer that uses
# that ident maps it in its own BUCK with `named_deps`.

rust_library(
    name = "policy-pdp-bundle-file",
    srcs = glob(["src/**/*.rs"]),
    crate = "iam_pdp_bundle_file",
    crate_root = "src/lib.rs",
    visibility = ["PUBLIC"],
    named_deps = {"shared_pdp_kernel": "//policy/core/pdp-kernel:policy-pdp-kernel"},
    deps = [
        "//policy/core/decision-service-kernel:policy-decision-service-kernel",
        "//audit/adapters/digest-awslc:shared-audit-digest-adapter-awslc",
        "//audit/core/event-kernel:shared-audit-event-kernel",
        "//iam/core/platform-contracts-kernel:shared-platform-contracts-kernel",
        "third-party//:serde",
        "third-party//:serde_json",
    ],
)

rust_test(
    name = "policy-pdp-bundle-file-unittest",
    srcs = glob(["src/**/*.rs"]),
    crate = "iam_pdp_bundle_file",
    crate_root = "src/lib.rs",
    visibility = ["PUBLIC"],
    named_deps = {"shared_pdp_kernel": "//policy/core/pdp-kernel:policy-pdp-kernel"},
    deps = [
        "//policy/core/decision-service-kernel:policy-decision-service-kernel",
        "//audit/adapters/digest-awslc:shared-audit-digest-adapter-awslc",
        "//audit/core/event-kernel:shared-audit-event-kernel",
        "//iam/core/platform-contracts-kernel:shared-platform-contracts-kernel",
        "third-party//:serde",
        "third-party//:serde_json",
    ],
)
