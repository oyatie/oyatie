# Library target renamed to `policy-pdp-cedar`; its `crate` stays
# `iam_pdp_cedar` because Buck2 exposes a dependency only under its `crate`
# attribute and external consumers still say `use iam_pdp_cedar::` (Cargo
# covers them with a `package =` rename). The crate's OWN tests are the
# opposite case: under Cargo they must import the derived name
# `policy_pdp_cedar`, so each test target maps it back via `named_deps` -
# the Buck analogue of the Cargo rename, in the direction tests need.
# Both names converge when the consumers' imports are renamed.

rust_library(
    name = "policy-pdp-cedar",
    srcs = glob(["src/**/*.rs"]),
    crate = "iam_pdp_cedar",
    crate_root = "src/lib.rs",
    visibility = ["PUBLIC"],
    deps = [
        "//audit/adapters/file:audit-file-adapter",
        "//audit/core/chain-domain:audit-chain-domain",
        "//data/core/data-boundary-kernel:data-boundary-kernel",
        "//policy/core/pdp-kernel:policy-pdp-kernel",
        "//iam/core/platform-contracts-kernel:shared-platform-contracts-kernel",
        "//data/core/ulid-id-kernel:shared-ulid-id-kernel",
        "third-party//:cedar-policy",
        "third-party//:serde_json",
    ],
)

rust_test(
    name = "policy-pdp-cedar-cedar-rbac-abac-pbac-grants",
    srcs = glob(["tests/**/*.rs"]),
    crate = "cedar_rbac_abac_pbac_grants",
    crate_root = "tests/cedar_rbac_abac_pbac_grants.rs",
    visibility = ["PUBLIC"],
    named_deps = {"policy_pdp_cedar": ":policy-pdp-cedar"},
    deps = [
        "//audit/adapters/file:audit-file-adapter",
        "//audit/core/chain-domain:audit-chain-domain",
        "//data/core/data-boundary-kernel:data-boundary-kernel",
        "//policy/core/pdp-kernel:policy-pdp-kernel",
        "//iam/core/platform-contracts-kernel:shared-platform-contracts-kernel",
        "//data/core/ulid-id-kernel:shared-ulid-id-kernel",
        "third-party//:serde_json",
    ],
)

