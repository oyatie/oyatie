# `crate` is the name Cargo derives from the package name. Cargo.toml renames
# the kernel (`shared-pdp-kernel = { package = "policy-pdp-kernel" }`), so
# every target here maps that ident with `named_deps`; a consumer that renames
# this package (`iam-pdp-cedar = { package = "policy-pdp-cedar" }`) does the
# same in its own BUCK with
# `named_deps = {"iam_pdp_cedar": "//policy/adapters/pdp-cedar:policy-pdp-cedar"}`.

_NAMED_DEPS = {
    "shared_pdp_kernel": "//policy/core/pdp-kernel:policy-pdp-kernel",
}

_DEPS = [
    "//audit/adapters/ledger-file:audit-ledger-file",
    "//audit/core/chain-domain:audit-chain-domain",
    "//data/core/data-boundary-kernel:data-boundary-kernel",
    "//iam/core/platform-contracts-kernel:shared-platform-contracts-kernel",
    "//data/core/ulid-id-kernel:shared-ulid-id-kernel",
    "third-party//:serde_json",
]

rust_library(
    name = "policy-pdp-cedar",
    srcs = glob(["src/**/*.rs"]),
    crate = "policy_pdp_cedar",
    crate_root = "src/lib.rs",
    visibility = ["PUBLIC"],
    named_deps = _NAMED_DEPS,
    deps = _DEPS + ["third-party//:cedar-policy"],
)

# One in-process test crate per root under tests/.
_TEST_ROOTS = [
    "cedar_bundle_admission",
    "cedar_rbac_abac_pbac_grants",
    "cedar_tenant_overlays",
    "cedar_cross_tenant_evasion",
    "cedar_step_up_forbid",
    "cedar_cache_and_bundle_swap",
    "cedar_audit_chain",
    "cedar_contract_surface",
]

[
    rust_test(
        name = "policy-pdp-cedar-" + stem.replace("_", "-"),
        srcs = glob(["tests/**/*.rs"]),
        crate = stem,
        crate_root = "tests/" + stem + ".rs",
        visibility = ["PUBLIC"],
        named_deps = _NAMED_DEPS,
        deps = _DEPS + [":policy-pdp-cedar"],
    )
    for stem in _TEST_ROOTS
]
