# `crate` keeps the pre-move name `iam_pdp_kernel` while consumers still say
# `use iam_pdp_kernel::`. Cargo derives `policy_decision_service_kernel`; a consumer that uses
# that ident maps it in its own BUCK with `named_deps`.

rust_library(
    name = "policy-decision-service-kernel",
    srcs = glob(["src/**/*.rs"]),
    crate = "iam_pdp_kernel",
    crate_root = "src/lib.rs",
    visibility = ["PUBLIC"],
    named_deps = {"shared_pdp_kernel": "//policy/core/pdp-kernel:policy-pdp-kernel"},
    deps = [
        "//iam/core/platform-contracts-kernel:shared-platform-contracts-kernel",
    ],
)

rust_test(
    name = "policy-decision-service-kernel-unittest",
    srcs = glob(["src/**/*.rs"]),
    crate = "iam_pdp_kernel",
    crate_root = "src/lib.rs",
    visibility = ["PUBLIC"],
    named_deps = {"shared_pdp_kernel": "//policy/core/pdp-kernel:policy-pdp-kernel"},
    deps = [
        "//iam/core/platform-contracts-kernel:shared-platform-contracts-kernel",
    ],
)
