# `crate` is the name Cargo derives from the package name. A consumer whose
# Cargo.toml renames this package (`iam-pdp-kernel = { package =
# "policy-decision-service-kernel" }`) maps the same ident in its own BUCK with
# `named_deps = {"iam_pdp_kernel": "//policy/core/decision-service-kernel:policy-decision-service-kernel"}`.

rust_library(
    name = "policy-decision-service-kernel",
    srcs = glob(["src/**/*.rs"]),
    crate = "policy_decision_service_kernel",
    crate_root = "src/lib.rs",
    visibility = ["PUBLIC"],
    named_deps = {"shared_pdp_kernel": "//policy/core/pdp-kernel:policy-pdp-kernel"},
    deps = [
        "//iam/core/platform-contracts-kernel:shared-platform-contracts-kernel",
    ],
)

rust_test(
    name = "policy-decision-service-kernel-unittest",
    srcs = glob(["src/**/*.rs"]),
    crate = "policy_decision_service_kernel",
    crate_root = "src/lib.rs",
    visibility = ["PUBLIC"],
    named_deps = {"shared_pdp_kernel": "//policy/core/pdp-kernel:policy-pdp-kernel"},
    deps = [
        "//iam/core/platform-contracts-kernel:shared-platform-contracts-kernel",
    ],
)
