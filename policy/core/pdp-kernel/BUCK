# `crate` is the name Cargo derives from the package name. A consumer whose
# Cargo.toml renames this package (`shared-pdp-kernel = { package =
# "policy-pdp-kernel" }`) maps the same ident in its own BUCK with
# `named_deps = {"shared_pdp_kernel": "//policy/core/pdp-kernel:policy-pdp-kernel"}`.

rust_library(
    name = "policy-pdp-kernel",
    srcs = glob(["src/**/*.rs"]),
    crate = "policy_pdp_kernel",
    crate_root = "src/lib.rs",
    visibility = ["PUBLIC"],
    deps = [
        "//iam/core/platform-contracts-kernel:shared-platform-contracts-kernel",
        "third-party//:serde",
        "third-party//:serde_json",
    ],
)

rust_test(
    name = "policy-pdp-kernel-unittest",
    srcs = glob(["src/**/*.rs"]),
    crate = "policy_pdp_kernel",
    crate_root = "src/lib.rs",
    visibility = ["PUBLIC"],
    deps = [
        "//iam/core/platform-contracts-kernel:shared-platform-contracts-kernel",
        "third-party//:serde",
        "third-party//:serde_json",
    ],
)
