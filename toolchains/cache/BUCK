# Cache-only execution platform target used only when CI writes `.buckconfig.local`
# with `execution_platforms = toolchains//cache:cache-platform`.
#
# `remote_enabled` stays false by design (cache-only stage), while cache knobs are
# controlled from `.buckconfig.local` using the local `[oya_cache]` section.
load("@prelude//platforms:defs.bzl", "host_configuration")
load(":defs.bzl", "cache_execution_platform")

cache_execution_platform(
    name = "cache-platform",
    allow_cache_uploads = read_root_config("oya_cache", "allow_cache_uploads", "false") == "true",
    cpu_configuration = host_configuration.cpu,
    os_configuration = host_configuration.os,
    remote_cache_enabled = read_root_config("oya_cache", "remote_cache_enabled", "false") == "true",
    use_windows_path_separators = host_info().os.is_windows,
    visibility = ["PUBLIC"],
)
