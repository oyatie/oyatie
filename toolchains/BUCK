load("@prelude//toolchains:rust.bzl", "system_rust_toolchain")
load("@prelude//toolchains:cxx.bzl", "system_cxx_toolchain")
load("@prelude//toolchains:genrule.bzl", "system_genrule_toolchain")
load("@prelude//toolchains:python.bzl", "system_python_bootstrap_toolchain")
load("@prelude//toolchains:remote_test_execution.bzl", "remote_test_execution_toolchain")
load("@prelude//tests:test_toolchain.bzl", "noop_test_toolchain")

# ---------------------------------------------------------------------------
# Rust 1.95.0 toolchain — pinned to match rust-toolchain.toml
#
# For the musl platform (//platforms:linux-aarch64-musl) the toolchain
# selects aarch64-unknown-linux-musl as the rustc target triple.
#
# musl linker strategy: -C link-self-contained=yes -C linker=rust-lld
#   * link-self-contained=yes: rustc bundles all CRT objects + libgcc stubs
#     from the bundled musl-aware sysroot, bypassing the host gcc toolchain.
#     This avoids the aarch64 static-pie segfault (rust#95926).
#   * crt-static is the DEFAULT for musl targets (target_feature +crt-static
#     is set automatically); no explicit +crt-static flag needed here.
#   * Do NOT route through mold or gcc for musl — both produce broken binaries.
# ---------------------------------------------------------------------------
system_rust_toolchain(
    name = "rust",
    default_edition = "2024",
    rustc_target_triple = select({
        "//platforms:libc_musl": "aarch64-unknown-linux-musl",
        "DEFAULT": "aarch64-unknown-linux-gnu",
    }),
    rustc_flags = select({
        "//platforms:libc_musl": [
            "-C link-self-contained=yes",
            "-C linker=rust-lld",
        ],
        "DEFAULT": [],
    }),
    visibility = ["PUBLIC"],
)

# Absolute compiler paths (not bare "clang") so the prelude's build-script cc-shim
# resolves the compiler regardless of the action PATH — root cause of the Linux
# `exec failed ['clang' ... FileNotFoundError`. /usr/bin/clang + /usr/bin/ar exist on
# BOTH darwin-arm64 and linux-arm64 -> cross-platform-correct. With this, the prelude
# injects CC/CXX/AR into build scripts (ring/aws-lc-sys/openssl-sys), so their fixups
# must NOT hardcode per-OS CC. (Hermetic step later: absolute host paths -> cell artifacts.)
system_cxx_toolchain(
    name = "cxx",
    compiler = "/usr/bin/clang",
    compiler_type = "clang",
    linker = "/usr/bin/clang",
    archiver = "/usr/bin/ar",
    visibility = ["PUBLIC"],
)

# REQUIRED by the prelude: prelude//decls/toolchains_common.bzl `_cxx_toolchain()`
# defaults to select({DEFAULT: toolchains//:cxx, config//:none: toolchains//:cxx_no_default_deps}).
# The config//:none branch is NEVER selected, but buck2 within-view/query validation
# requires the target to EXIST — without it, `//...` graph traversal (deps/rdeps, hence
# the affected-gate query) fails with "Unknown target cxx_no_default_deps". Mirror :cxx.
system_cxx_toolchain(
    name = "cxx_no_default_deps",
    compiler = "/usr/bin/clang",
    compiler_type = "clang",
    linker = "/usr/bin/clang",
    archiver = "/usr/bin/ar",
    visibility = ["PUBLIC"],
)

system_genrule_toolchain(
    name = "genrule",
    visibility = ["PUBLIC"],
)

# Required by prelude//rust/tools:internal_tools_toolchain
system_python_bootstrap_toolchain(
    name = "python_bootstrap",
    visibility = ["PUBLIC"],
)

# Test runner toolchains — REQUIRED by `buck2 test`. The prelude resolves
# toolchains//:test (ExternalRunnerTestToolchainInfo, via noop_test_toolchain — the
# standard local runner the prelude demo wires) AND toolchains//:remote_test_execution
# (RemoteTestExecutionToolchainInfo). Without :test, any rust_test target fails to
# CONFIGURE ("Unknown target `test`"), so the gate's test phase can never run. Local
# execution (no RE configured) runs tests on the gate pod. Prerequisite for #84 (emit
# rust_test -> gate builds AND TESTS). The RE target is wired now for when NativeLink RE lands.
noop_test_toolchain(
    name = "test",
    visibility = ["PUBLIC"],
)

remote_test_execution_toolchain(
    name = "remote_test_execution",
    visibility = ["PUBLIC"],
)
