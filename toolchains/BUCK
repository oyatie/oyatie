load("@prelude//toolchains:rust.bzl", "system_rust_toolchain")
load("@prelude//toolchains:cxx.bzl", "system_cxx_toolchain")
load("@prelude//toolchains:genrule.bzl", "system_genrule_toolchain")
load("@prelude//toolchains:python.bzl", "system_python_bootstrap_toolchain")
load("@prelude//toolchains:remote_test_execution.bzl", "remote_test_execution_toolchain")
load("@prelude//tests:test_toolchain.bzl", "noop_test_toolchain")
load("//rust:defs.bzl", "download_rust_toolchain")

# Rust 1.97.1 toolchain — pinned to match rust-toolchain.toml.
#
# AMBIENT path (the default): rustc is resolved via the rustup shim; PATH must include
# ~/.rustup/toolchains/1.97.1-<host-triple>/bin. That PATH — not rustc's CONTENT — is what
# lands in the action key, so swapping the rustup default leaves every key UNCHANGED. Under a
# shared CAS that serves artifacts built by a different compiler as current.
system_rust_toolchain(
    name = "rust-system",
    default_edition = "2024",
    visibility = ["PUBLIC"],
)

# HERMETIC path: rustc/rust-std/clippy arrive as sha256-pinned static.rust-lang.org tarballs
# whose digests ARE action-key inputs. Same upstream 1.97.1 build rustup installs, so no
# codegen change is possible; see toolchains//rust:releases.bzl.
download_rust_toolchain(
    name = "rust-hermetic",
    default_edition = "2024",
    visibility = ["PUBLIC"],
)

# DARK BY DEFAULT, exactly like toolchains//cache:cache-platform: with no overlay this
# resolves to :rust-system and is byte-identical to the ambient toolchain this repo has always
# used. Only infra/ci/buckconfig/hermetic-rust.buckconfig sets [oya_toolchain] rust = hermetic,
# so the root .buckconfig stays clean and rollback is "stop passing --config-file". An
# unrecognized value fails loud as an unknown target rather than silently falling back.
toolchain_alias(
    name = "rust",
    actual = ":rust-" + read_root_config("oya_toolchain", "rust", "system"),
    visibility = ["PUBLIC"],
)

# Absolute Unix compiler paths keep the prelude build-script cc-shim independent of PATH on
# Darwin/Linux. Windows must retain the prelude MSVC defaults; overriding them with Unix paths
# makes every Rust target that links a C build script fail before its tests can run.
CXX_TOOLCHAIN_CONFIG = {
    "compiler": None if host_info().os.is_windows else "/usr/bin/clang",
    "compiler_type": None if host_info().os.is_windows else "clang",
    "linker": None if host_info().os.is_windows else "/usr/bin/clang",
    "archiver": None if host_info().os.is_windows else "/usr/bin/ar",
}

system_cxx_toolchain(
    name = "cxx",
    visibility = ["PUBLIC"],
    **CXX_TOOLCHAIN_CONFIG
)

# REQUIRED by the prelude: prelude//decls/toolchains_common.bzl `_cxx_toolchain()`
# defaults to select({DEFAULT: toolchains//:cxx, config//:none: toolchains//:cxx_no_default_deps}).
# The config//:none branch is NEVER selected, but buck2 within-view/query validation
# requires the target to EXIST — without it, `//...` graph traversal (deps/rdeps, hence
# the affected-gate query) fails with "Unknown target cxx_no_default_deps". Mirror :cxx.
system_cxx_toolchain(
    name = "cxx_no_default_deps",
    visibility = ["PUBLIC"],
    **CXX_TOOLCHAIN_CONFIG
)

system_genrule_toolchain(
    name = "genrule",
    visibility = ["PUBLIC"],
)

# Required by prelude//rust/tools:internal_tools_toolchain
system_python_bootstrap_toolchain(
    name = "python_bootstrap",
    visibility = ["PUBLIC"],
)

# Test runner toolchains — REQUIRED by `buck2 test`. The prelude resolves
# toolchains//:test (ExternalRunnerTestToolchainInfo, via noop_test_toolchain — the
# standard local runner the prelude demo wires) AND toolchains//:remote_test_execution
# (RemoteTestExecutionToolchainInfo). Without :test, any rust_test target fails to
# CONFIGURE ("Unknown target `test`"), so the gate's test phase can never run. Local
# execution (no RE configured) runs tests on the gate pod. Prerequisite for #84 (emit
# rust_test → gate builds AND TESTS). The RE target is wired now for when NativeLink RE lands.
noop_test_toolchain(
    name = "test",
    visibility = ["PUBLIC"],
)

remote_test_execution_toolchain(
    name = "remote_test_execution",
    visibility = ["PUBLIC"],
)
