{
  "schemaVersion": 39,
  "title": "finops-portal — Anomaly Investigation",
  "uid": "finops-portal-anomaly-investigation",
  "tags": ["finops-portal", "anomaly", "ops-finops"],
  "timezone": "browser",
  "editable": false,
  "_authored": "2026-05-18",
  "_authority": "ADR-0186 + ADR-0199 + IP-011 + IP-012",
  "_fleet_scope": true,
  "templating": {
    "list": [
      {
        "name": "tenant_id",
        "label": "Tenant (anomaly subject)",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${MIMIR_DS}" },
        "query": "label_values(ALERTS{alertname=\"TenantCostAnomalySpike\"}, tenant_id)"
      },
      {
        "name": "anomaly_window",
        "label": "Anomaly window",
        "type": "custom",
        "options": [
          { "text": "Last 1h", "value": "1h", "selected": true },
          { "text": "Last 6h", "value": "6h" },
          { "text": "Last 24h", "value": "24h" }
        ]
      }
    ]
  },
  "time": { "from": "now-24h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Alert context",
      "type": "table",
      "datasource": { "type": "prometheus", "uid": "${MIMIR_DS}" },
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "ALERTS{alertname=\"TenantCostAnomalySpike\",tenant_id=\"$tenant_id\"}",
          "format": "table"
        }
      ]
    },
    {
      "id": 2,
      "title": "Time series vs baseline",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${MIMIR_DS}" },
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 6 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(opencost_pod_cost{tenant_id=\"$tenant_id\"}[5m]))",
          "legendFormat": "observed"
        },
        {
          "refId": "B",
          "expr": "avg_over_time(sum(rate(opencost_pod_cost{tenant_id=\"$tenant_id\"}[5m]))[7d:1h]) * 1.0",
          "legendFormat": "baseline (7d avg)"
        },
        {
          "refId": "C",
          "expr": "avg_over_time(sum(rate(opencost_pod_cost{tenant_id=\"$tenant_id\"}[5m]))[7d:1h]) * 1.5",
          "legendFormat": "anomaly threshold (1.5x)"
        }
      ]
    },
    {
      "id": 3,
      "title": "Contribution by dimension (top contributors)",
      "type": "barchart",
      "datasource": { "type": "prometheus", "uid": "${MIMIR_DS}" },
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 18 },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(5, sum by (cost_center, workload_class, cell) (rate(opencost_pod_cost{tenant_id=\"$tenant_id\"}[$anomaly_window])) - sum by (cost_center, workload_class, cell) (rate(opencost_pod_cost{tenant_id=\"$tenant_id\"}[$anomaly_window] offset 7d)))"
        }
      ]
    },
    {
      "id": 4,
      "title": "Deploy correlation",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${MIMIR_DS}" },
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 18 },
      "targets": [
        {
          "refId": "A",
          "expr": "argo_rollouts_phase{cluster=~\".*\"}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Related foundry runs (tenant)",
      "type": "table",
      "datasource": { "type": "prometheus", "uid": "${MIMIR_DS}" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 28 },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(20, sum by (capability_id, workflow_id) (rate(foundry_capability_invocation_cost_cents{tenant_id=\"$tenant_id\"}[$anomaly_window])))",
          "format": "table"
        }
      ]
    },
    {
      "id": 6,
      "title": "Action buttons (links)",
      "type": "text",
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 38 },
      "options": {
        "mode": "markdown",
        "content": "**Runbooks:**\n- [tenant-cost-anomaly-spike](../runbooks/tenant-cost-anomaly-spike.md)\n- [tenant-budget-headroom-low](../runbooks/tenant-budget-headroom-low.md)\n- [tenant-budget-exhausted](../runbooks/tenant-budget-exhausted.md)\n\n**Audit-chain:** open in audit-chain UI scoped to tenant_id=$tenant_id, class=TenantCostAnomalyInvestigation."
      }
    }
  ]
}
