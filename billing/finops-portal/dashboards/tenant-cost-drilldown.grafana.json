{
  "schemaVersion": 39,
  "title": "finops-portal — Tenant Cost Drill-down",
  "uid": "finops-portal-tenant-cost-drilldown",
  "tags": ["finops-portal", "tenant", "cost-attribution"],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "_authored": "2026-05-18",
  "_authority": "ADR-0186 observability backplane + ADR-0199 cost-attribution canonical + IP-008",
  "_panel_tenant_scope": true,
  "templating": {
    "list": [
      {
        "name": "tenant_id",
        "label": "Tenant",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${MIMIR_DS}" },
        "query": "label_values(opencost_pod_cost{cost_center!=\"\"}, tenant_id)",
        "refresh": 2,
        "includeAll": false,
        "hide": 0
      },
      {
        "name": "regulatory_pack",
        "label": "Regulatory pack",
        "type": "custom",
        "options": [
          { "text": "generic", "value": "generic", "selected": true },
          { "text": "kr", "value": "kr" },
          { "text": "eu", "value": "eu" },
          { "text": "us-healthcare", "value": "us-healthcare" }
        ]
      },
      {
        "name": "locale",
        "label": "Locale",
        "type": "custom",
        "options": [
          { "text": "en-US", "value": "en-US", "selected": true },
          { "text": "ko-KR", "value": "ko-KR" },
          { "text": "fr-FR", "value": "fr-FR" }
        ]
      },
      {
        "name": "currency",
        "label": "Currency",
        "type": "custom",
        "options": [
          { "text": "USD", "value": "usd", "selected": true },
          { "text": "KRW", "value": "krw" },
          { "text": "EUR", "value": "eur" }
        ]
      }
    ]
  },
  "time": { "from": "now-30d", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Headline — current-month total",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${MIMIR_DS}" },
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(opencost_pod_cost{tenant_id=\"$tenant_id\",regulatory_pack=\"$regulatory_pack\"})"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "currencyUSD" } }
    },
    {
      "id": 2,
      "title": "Trend vs last month",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${MIMIR_DS}" },
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(opencost_pod_cost{tenant_id=\"$tenant_id\"}) / sum(opencost_pod_cost{tenant_id=\"$tenant_id\"} offset 30d)) - 1"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit" } }
    },
    {
      "id": 3,
      "title": "Cost by cost-center",
      "type": "barchart",
      "datasource": { "type": "prometheus", "uid": "${MIMIR_DS}" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 6 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (cost_center) (rate(opencost_pod_cost{tenant_id=\"$tenant_id\",regulatory_pack=\"$regulatory_pack\"}[1d]))"
        }
      ]
    },
    {
      "id": 4,
      "title": "Cost by workload-class",
      "type": "piechart",
      "datasource": { "type": "prometheus", "uid": "${MIMIR_DS}" },
      "gridPos": { "h": 10, "w": 8, "x": 0, "y": 16 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (workload_class) (opencost_pod_cost{tenant_id=\"$tenant_id\",regulatory_pack=\"$regulatory_pack\"})"
        }
      ]
    },
    {
      "id": 5,
      "title": "Cost by cell",
      "type": "table",
      "datasource": { "type": "prometheus", "uid": "${MIMIR_DS}" },
      "gridPos": { "h": 10, "w": 16, "x": 8, "y": 16 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (cell, region) (opencost_pod_cost{tenant_id=\"$tenant_id\",regulatory_pack=\"$regulatory_pack\"})",
          "format": "table"
        }
      ]
    },
    {
      "id": 6,
      "title": "Capability invocation cost over time",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${MIMIR_DS}" },
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 26 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (capability_id) (rate(foundry_capability_invocation_cost_cents{tenant_id=\"$tenant_id\"}[5m]))"
        }
      ]
    },
    {
      "id": 7,
      "title": "Storage cost",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${MIMIR_DS}" },
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 26 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (storage_class) (rate(opencost_object_storage_cost_cents{tenant_id=\"$tenant_id\"}[5m]))"
        }
      ]
    },
    {
      "id": 8,
      "title": "Anomaly markers",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${MIMIR_DS}" },
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 36 },
      "targets": [
        {
          "refId": "A",
          "expr": "ALERTS{alertname=\"TenantCostAnomalySpike\",tenant_id=\"$tenant_id\"}"
        }
      ]
    }
  ]
}
