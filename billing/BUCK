# Residual product/docs surface for billing capability (dual-home burn-down).
# Live crates live under billing/{core,ports,adapters,facade,observability} with
# their own package BUCKs. This package owns residual service docs, manifests,
# contracts, and OpenSLO YAML rehomed from cloud/cloud-billing*, oya/finops-portal,
# oya/accounting, etc. so they remain in the Buck2 corpus graph (ADR-0541).

load("//governance/corpus/extract:yaml_facts.bzl", "corpus_yaml_facts_shards")

# Hermetic input set for gates that must validate billing residual manifests.
filegroup(
    name = "live-service-manifest-corpus",
    srcs = glob(["**/manifest.json"]),
    visibility = ["PUBLIC"],
)

corpus_yaml_facts_shards(
    srcs = glob(["**/*.yaml", "**/*.yml"]),
    shard_size = 256,
)
