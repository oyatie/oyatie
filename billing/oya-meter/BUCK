# oya-meter Buck2 build targets (placeholder — ADR-0479)
#
# No buildable targets yet: the crate implementations (oya-meter-kernel/-rest/-app)
# have NOT landed (pending D1-D5), so there is no crates/ source to compile. The
# previous hand-written rust_library/rust_binary targets globbed non-existent
# crates/**/*.rs, which fails `buck2 build` with "crate has no srcs".
#
# This package has no Cargo.toml and is not a workspace member, so no generator can reach it.
# When the implementations land they ship a hand-written BUCK (the buck2-native per-package
# mechanism), and //tools/oya-buck-test-wiring-app wires the rust_test. Until then this package
# intentionally declares no targets.

load("//governance/corpus/extract:yaml_facts.bzl", "corpus_yaml_facts_shards")

corpus_yaml_facts_shards(
    srcs = glob(["**/*.yaml", "**/*.yml"]),
    shard_size = 256,
)
