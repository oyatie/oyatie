{
  "title": "Feature Flags — Kill-Switch History",
  "uid": "feature-flags-killswitch",
  "binding_adr": "ADR-0159",
  "microservice": "feature-flags",
  "description": "Kill-switch activation history with propagation latency, audit trail links, and SLO compliance.",
  "panels": [
    {
      "title": "Active Kill-Switches",
      "type": "stat",
      "alert": "page immediately if > 5 (unusual surge)",
      "targets": [
        {
          "expr": "sum(feature_flag_killswitch_active)",
          "legendFormat": "Active kill-switches"
        }
      ]
    },
    {
      "title": "Kill-Switch Engagements (last 7 days)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(increase(feature_flag_killswitch_engaged_total[1d]))",
          "legendFormat": "Engagements per day"
        }
      ]
    },
    {
      "title": "Kill-Switch Propagation Latency p99",
      "type": "timeseries",
      "slo_ref": "slos/killswitch-fire-latency.openslo.yaml",
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(feature_flag_killswitch_propagation_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99 propagation latency"
        }
      ],
      "thresholds": [
        {"value": 1.0, "color": "red", "description": "SLO breach — SEV-1"}
      ]
    },
    {
      "title": "Kill-Switch Event Log (audit trail)",
      "type": "logs",
      "description": "Sealed KillSwitchEngaged / KillSwitchDisengaged audit events from ClickHouse.",
      "targets": [
        {
          "datasource": "clickhouse",
          "query": "SELECT timestamp, flag_key, tenant_id, actor_principal_id, reason, audit_chain_id FROM feature_flags_audit_events WHERE event_class IN ('KillSwitchEngaged', 'KillSwitchDisengaged') ORDER BY timestamp DESC LIMIT 100"
        }
      ]
    },
    {
      "title": "Per-Cell Kill-Switch State",
      "type": "table",
      "targets": [
        {
          "expr": "feature_flag_killswitch_active by (flag_key, cell_id)",
          "legendFormat": "{{flag_key}} / {{cell_id}}"
        }
      ]
    },
    {
      "title": "Emergency-Services Bypass Events",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(increase(feature_flag_emergency_bypass_total[24h]))",
          "legendFormat": "Emergency bypasses (24h)"
        }
      ]
    },
    {
      "title": "Kill-Switch SLO Error Budget",
      "type": "gauge",
      "slo_ref": "slos/killswitch-fire-latency.openslo.yaml",
      "targets": [
        {
          "expr": "1 - (sum(rate(feature_flag_killswitch_propagation_duration_seconds_bucket{le=\"1.0\"}[28d])) / sum(rate(feature_flag_killswitch_propagation_duration_seconds_count[28d])))",
          "legendFormat": "Error budget remaining"
        }
      ]
    }
  ],
  "links": [
    {"title": "Kill-Switch Runbook", "url": "microservices/feature-flags/runbooks/killswitch-engaged.md"},
    {"title": "Flag State Overview", "url": "/d/feature-flags-flag-state"}
  ]
}
