  "naming_justifications": {
    "microservice": "feature-flags — single-concern substrate per ADR-0132 no-grouping policy; hyphen-separated per BNF v4.1",
    "crate_pattern": "oya-feature-flags-<bc>-<layer> per ADR-0105 13-layer enum; BC values: flag, targeting, experiment, metric, rollout, killswitch",
    "kafka_topics": "oya.feature-flags.<event-class> — dot-separated namespace; snake_case event class per ADR-0263",
    "cedar_fragments": "policy/<capability>-<action>-authorization.cedar — kebab-case; action-scoped per ADR-0183"
  },
