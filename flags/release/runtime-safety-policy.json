  "progressive_delivery_policy": {
    "traffic_shape_gate": "progressive_delivery",
    "closed_stage_percent": 0,
    "canary_stages_percent": [
      1,
      10,
      50,
      100
    ],
    "controller_boundary": "bridge-reference-or-oya-cd-adapter-boundary-only",
    "advance_requires": [
      "latest_slo_gate_verdict_is_eligible",
      "no_fast_burn_alert_firing",
      "no_brownout_or_outage_degradation_class",
      "release_toggle_has_cleanup_gate"
    ],
    "rollback_triggers": [
      "openslo_fast_burn_1h_5m_page",
      "post_promotion_production_fast_burn_within_1h",
      "manual_operator_rollback_receipt"
    ],
    "nonclaims": [
      "no_live_rollout_execution",
      "no_service_mesh_traffic_split_claim",
      "no_tenant_traffic_claim",
      "no_oya_cd_parity_or_cutover_claim"
    ],
    "feature_flag_rollout": {
      "substrate": "OpenFeature",
      "intent": "release_toggle",
      "cleanup_gate_ref": "feature_flag_lifecycle_cleanup_gate",
      "rollout_key_scope": "service-local feature-flags release toggles only"
    },
    "brownout": {
      "spec_ref": "specs/brownout-degradation-signal.json",
      "header_name": "oya-degradation-class",
      "classes": [
        "nominal",
        "degraded",
        "brownout",
        "outage"
      ],
      "retry_budget_multiplier": 0.1,
      "release_actions": [
        "hold_stage_advance",
        "emit_DegradationStateChange_audit_row",
        "prefer_cached_or_local_state_for_non_essential_reads"
      ]
    }
  },
  "openslo_burn_rate_rollback_trigger": {
    "service_openslo": "flags/observability/slos/feature-flags.openslo.yaml",
    "canonical_burn_rate_template": "specs/openslo/canonical-burn-rate-alert-template.openslo.yaml",
    "accepted_spec_ref": "specs/agentic-slo-gated-promotion.json",
    "fast_burn_threshold": 14.4,
    "fast_burn_lookback_window": "1h",
    "fast_burn_alert_window": "5m",
    "verdict_on_fire": "held",
    "rollback_action": "automatic-release-pointer-rollback",
    "audit_events": [
      "EligibilityChanged",
      "RollbackExecuted",
      "DegradationStateChange"
    ]
  },
  "feature_flag_lifecycle_cleanup_gate": {
    "accepted_spec_ref": "specs/feature-flag-substrate-canonical.json",
    "ci_lane": "feature-flag-lifecycle",
    "release_toggle": {
      "sunset_at_required": true,
      "max_lifetime_days": 90
    },
    "required_status_flow": [
      "proposed",
      "live",
      "ramped",
      "deprecated",
      "removed"
    ],
    "cleanup_actions": [
      "remove_flag_definition",
      "remove_dead_code_references",
      "verify_no_stale_code_references",
      "archive_rollout_receipt"
    ]
  },
  "verification": {
    "mode": "data-only-declaration",
