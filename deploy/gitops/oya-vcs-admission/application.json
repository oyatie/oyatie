{
  "apiVersion": "argoproj.io/v1alpha1",
  "kind": "Application",
  "metadata": {
    "name": "oya-vcs-admission-preview",
    "namespace": "argocd",
    "labels": {
      "app.kubernetes.io/part-of": "oyatie-foundry",
      "oya.dev/provider-slot": "argo-gitops",
      "oya.dev/vcs-admission": "true"
    }
  },
  "spec": {
    "project": "default",
    "source": {
      "repoURL": "https://github.com/jason931225/oyatie.git",
      "targetRevision": "HEAD",
      "path": "deploy/gitops/oya-vcs-admission"
    },
    "destination": {
      "server": "https://kubernetes.default.svc",
      "namespace": "oyatie-system"
    },
    "syncPolicy": {
      "automated": {
        "prune": true,
        "selfHeal": true
      },
      "syncOptions": [
        "CreateNamespace=true",
        "ServerSideApply=true"
      ]
    }
  }
}
