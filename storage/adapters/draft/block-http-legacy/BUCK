load("@prelude//rust:cargo_buildscript.bzl", "buildscript_run")

rust_binary(
    name = "storage-block-http-legacy-draft-build-script",
    srcs = ["build.rs"],
    crate = "build_script_build",
    crate_root = "build.rs",
    visibility = [],
)

export_file(name = "build.rs", visibility = [])

genrule(
    name = "storage-block-http-legacy-draft-source-items",
    srcs = glob(["src/items/*.rs"]),
    out = "source_items",
    cmd = "mkdir -p $OUT && cp $SRCS $OUT/",
)

genrule(
    name = "storage-block-http-legacy-draft-manifest-dir",
    srcs = [
        ":build.rs",
        ":storage-block-http-legacy-draft-source-items",
    ],
    out = "manifest_dir",
    cmd = "mkdir -p $OUT/src/items && cp $(location :build.rs) $OUT/ && cp -R $(location :storage-block-http-legacy-draft-source-items)/. $OUT/src/items/",
)

buildscript_run(
    name = "storage-block-http-legacy-draft-build-script-run",
    buildscript_rule = ":storage-block-http-legacy-draft-build-script",
    package_name = "storage-block-http-legacy-draft",
    version = "0.1.0",
    manifest_dir = ":storage-block-http-legacy-draft-manifest-dir",
)

_DEPS = [
    "//network/ports/residency-policy:network-residency-policy",
    "//storage/core/domain:storage-domain",
    "//data/ports/classification:data-classification",
]

rust_library(
    name = "storage-block-http-legacy-draft",
    srcs = glob(["src/**/*.rs"]),
    crate = "storage_block_http_legacy_draft",
    crate_root = "src/lib.rs",
    env = {"OUT_DIR": "$(location :storage-block-http-legacy-draft-build-script-run[out_dir])"},
    visibility = ["PUBLIC"],
    deps = _DEPS,
)

rust_test(
    name = "storage-block-http-legacy-draft-contract",
    srcs = ["tests/cloud_storage_block_api.rs"],
    crate = "storage_block_http_legacy_draft_contract",
    crate_root = "tests/cloud_storage_block_api.rs",
    visibility = ["PUBLIC"],
    deps = [":storage-block-http-legacy-draft"] + _DEPS,
)
