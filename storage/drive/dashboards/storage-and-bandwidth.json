{
  "$schema": "https://schemas.grafana.com/dashboard.json",
  "_meta": {
    "doc_class": "GrafanaDashboard",
    "microservice": "drive",
    "owner_team": "axis-drive + ops-sre-reliability",
    "audience": "tenant operator + axis-drive SRE",
    "tenant_scoped": true,
    "datasource": "per-pack Mimir; tenant-scoped via X-Scope-OrgID"
  },
  "uid": "drive-storage-bandwidth",
  "title": "drive: storage + bandwidth (object-store + CDN + tier)",
  "tags": ["drive", "storage", "object-store", "garage", "minio", "seaweedfs", "cdn", "bandwidth"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "templating": {
    "list": [
      {"name": "pack", "type": "custom", "label": "Pack",
        "options": [
          {"text": "pack-kr", "value": "kr", "selected": true},
          {"text": "pack-eu", "value": "eu"},
          {"text": "pack-us", "value": "us"},
          {"text": "pack-us-healthcare", "value": "us-hc"},
          {"text": "pack-jp", "value": "jp"},
          {"text": "pack-sg", "value": "sg"},
          {"text": "pack-au", "value": "au"},
          {"text": "pack-in", "value": "in"},
          {"text": "pack-br", "value": "br"},
          {"text": "pack-ae", "value": "ae"},
          {"text": "pack-ksa", "value": "ksa"}
        ]},
      {"name": "tenant", "type": "query", "label": "Tenant",
        "query": "label_values(oya_drive_file_count_total{pack=\"$pack\"}, tenant_id)"}
    ]
  },
  "panels": [
    {"id": 1, "type": "stat", "title": "Total bytes stored (per tenant)",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "sum(oya_drive_bytes_stored_total{pack=\"$pack\",tenant_id=\"$tenant\"})", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "bytes"}}},

    {"id": 2, "type": "stat", "title": "Total files (per tenant)",
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "sum(oya_drive_file_count_total{pack=\"$pack\",tenant_id=\"$tenant\"})", "refId": "A"}]},

    {"id": 3, "type": "stat", "title": "Egress (last 1h, bytes)",
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "sum(increase(oya_drive_egress_bytes_total{pack=\"$pack\",tenant_id=\"$tenant\"}[1h]))", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "bytes"}}},

    {"id": 4, "type": "stat", "title": "CDN cache-hit ratio (last 5m)",
      "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "sum(rate(oya_drive_cdn_cache_hit_total{pack=\"$pack\",tenant_id=\"$tenant\"}[5m])) / sum(rate(oya_drive_cdn_request_total{pack=\"$pack\",tenant_id=\"$tenant\"}[5m]))", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "thresholds": {"mode": "absolute", "steps": [{"value": null, "color": "red"}, {"value": 0.7, "color": "yellow"}, {"value": 0.9, "color": "green"}]}}}},

    {"id": 5, "type": "timeseries", "title": "Object-store backend health (Garage / SeaweedFS / SeaweedFS)",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "targets": [
        {"expr": "oya_drive_object_store_replica_count{pack=\"$pack\",backend=\"garage\"}", "legendFormat": "garage replicas", "refId": "A"},
        {"expr": "oya_drive_object_store_replica_count{pack=\"$pack\",backend=\"minio\"}", "legendFormat": "minio replicas", "refId": "B"},
        {"expr": "oya_drive_object_store_replica_count{pack=\"$pack\",backend=\"seaweedfs\"}", "legendFormat": "seaweedfs replicas", "refId": "C"}
      ]},

    {"id": 6, "type": "timeseries", "title": "Bytes stored by tier (hot / warm / archive)",
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum by (tier) (oya_drive_bytes_stored_total{pack=\"$pack\",tenant_id=\"$tenant\"})", "legendFormat": "{{tier}}", "refId": "A"}
      ]},

    {"id": 7, "type": "timeseries", "title": "Upload / download throughput (bytes/s)",
      "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum(rate(oya_drive_upload_bytes_total{pack=\"$pack\",tenant_id=\"$tenant\"}[5m]))", "legendFormat": "upload Bps", "refId": "A"},
        {"expr": "sum(rate(oya_drive_egress_bytes_total{pack=\"$pack\",tenant_id=\"$tenant\"}[5m]))", "legendFormat": "egress Bps", "refId": "B"}
      ]},

    {"id": 8, "type": "timeseries", "title": "Download first-byte latency (p50 / p95 / p99) — warm vs cold",
      "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum by (le, cache_state) (rate(oya_drive_download_first_byte_seconds_bucket{pack=\"$pack\",tenant_id=\"$tenant\"}[5m])))", "legendFormat": "p50 {{cache_state}}", "refId": "A"},
        {"expr": "histogram_quantile(0.95, sum by (le, cache_state) (rate(oya_drive_download_first_byte_seconds_bucket{pack=\"$pack\",tenant_id=\"$tenant\"}[5m])))", "legendFormat": "p95 {{cache_state}}", "refId": "B"},
        {"expr": "histogram_quantile(0.99, sum by (le, cache_state) (rate(oya_drive_download_first_byte_seconds_bucket{pack=\"$pack\",tenant_id=\"$tenant\"}[5m])))", "legendFormat": "p99 {{cache_state}}", "refId": "C"}
      ]},

    {"id": 9, "type": "table", "title": "Top-10 tenants by bytes stored",
      "gridPos": {"x": 0, "y": 20, "w": 12, "h": 8},
      "targets": [
        {"expr": "topk(10, sum by (tenant_id) (oya_drive_bytes_stored_total{pack=\"$pack\"}))", "format": "table", "refId": "A"}
      ]},

    {"id": 10, "type": "table", "title": "Top-10 tenants by egress (last 24h)",
      "gridPos": {"x": 12, "y": 20, "w": 12, "h": 8},
      "targets": [
        {"expr": "topk(10, sum by (tenant_id) (increase(oya_drive_egress_bytes_total{pack=\"$pack\"}[24h])))", "format": "table", "refId": "A"}
      ]}
  ],
  "annotations": {
    "list": [
      {"name": "rollouts", "datasource": "argo-rollouts", "iconColor": "blue", "query": "{microservice=\"drive\"}"},
      {"name": "tier-changes", "datasource": "prometheus", "iconColor": "purple", "expr": "changes(oya_drive_tier_promotion_total[1h]) > 0"}
    ]
  }
}
