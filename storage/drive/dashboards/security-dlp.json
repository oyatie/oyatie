{
  "$schema": "https://schemas.grafana.com/dashboard.json",
  "_meta": {
    "doc_class": "GrafanaDashboard",
    "microservice": "drive",
    "owner_team": "axis-drive + ops-security",
    "audience": "ops-security + council-privacy + tenant compliance officer",
    "tenant_scoped": true
  },
  "uid": "drive-security-dlp",
  "title": "drive: security + DLP + share-link + WORM",
  "tags": ["drive", "security", "dlp", "share-link", "worm", "immutability", "audit-chain"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-24h", "to": "now"},
  "templating": {
    "list": [
      {"name": "pack", "type": "custom",
        "options": [
          {"text": "pack-kr", "value": "kr", "selected": true},
          {"text": "pack-eu", "value": "eu"},
          {"text": "pack-us", "value": "us"},
          {"text": "pack-us-healthcare", "value": "us-hc"},
          {"text": "pack-jp", "value": "jp"}
        ]},
      {"name": "tenant", "type": "query",
        "query": "label_values(oya_drive_share_link_mint_total{pack=\"$pack\"}, tenant_id)"}
    ]
  },
  "panels": [
    {"id": 1, "type": "stat", "title": "Share-links minted (last 24h)",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "sum(increase(oya_drive_share_link_mint_total{pack=\"$pack\",tenant_id=\"$tenant\"}[24h]))", "refId": "A"}]},

    {"id": 2, "type": "stat", "title": "Share-link verifications (last 24h)",
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "sum(increase(oya_drive_share_link_verify_total{pack=\"$pack\",tenant_id=\"$tenant\"}[24h]))", "refId": "A"}]},

    {"id": 3, "type": "stat", "title": "Files in WORM tier",
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "sum(oya_drive_immutability_tier_active_count{pack=\"$pack\",tenant_id=\"$tenant\"})", "refId": "A"}]},

    {"id": 4, "type": "stat", "title": "Files under legal hold",
      "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "sum(oya_drive_legal_hold_active_count{pack=\"$pack\",tenant_id=\"$tenant\"})", "refId": "A"}]},

    {"id": 5, "type": "timeseries", "title": "Share-link verify verdict distribution",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum by (verdict) (rate(oya_drive_share_link_verify_total{pack=\"$pack\",tenant_id=\"$tenant\"}[5m]))", "legendFormat": "{{verdict}}", "refId": "A"}
      ]},

    {"id": 6, "type": "timeseries", "title": "Share-link enumeration anomaly indicator (per-IP > 100/min)",
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum(rate(oya_drive_share_link_enumeration_pattern_detected_total{pack=\"$pack\"}[5m]))", "legendFormat": "enumeration detections/s", "refId": "A"},
        {"expr": "sum(rate(oya_drive_share_link_verify_total{verdict=\"signature_invalid\",pack=\"$pack\"}[5m]))", "legendFormat": "invalid signatures/s", "refId": "B"}
      ]},

    {"id": 7, "type": "timeseries", "title": "DLP flag rate by rule",
      "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
      "targets": [
        {"expr": "topk(10, sum by (rule_id) (rate(oya_drive_dlp_scan_verdict_total{verdict=\"flagged\",pack=\"$pack\"}[1h])))", "legendFormat": "{{rule_id}}", "refId": "A"}
      ]},

    {"id": 8, "type": "timeseries", "title": "Virus-detection rate by signature-engine",
      "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum by (engine) (rate(oya_drive_virus_scan_verdict_total{verdict=\"malicious\",pack=\"$pack\"}[1h]))", "legendFormat": "{{engine}}", "refId": "A"}
      ]},

    {"id": 9, "type": "timeseries", "title": "WORM violations + integrity-scan delta (target = 0)",
      "gridPos": {"x": 0, "y": 20, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum(rate(oya_drive_immutability_tier_violation_total{pack=\"$pack\"}[5m]))", "legendFormat": "violations/s", "refId": "A"},
        {"expr": "oya_drive_immutability_integrity_scan_delta_total{pack=\"$pack\"}", "legendFormat": "integrity-scan delta", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"value": null, "color": "green"}, {"value": 1, "color": "red"}]}}}},

    {"id": 10, "type": "timeseries", "title": "Cedar policy refusal rate (cross-context + cross-tenant + cross-pack)",
      "gridPos": {"x": 12, "y": 20, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum by (policy) (rate(oya_drive_cedar_refused_total{pack=\"$pack\"}[5m]))", "legendFormat": "{{policy}}", "refId": "A"}
      ]},

    {"id": 11, "type": "table", "title": "Audit-chain emission lag (target = 0s)",
      "gridPos": {"x": 0, "y": 28, "w": 24, "h": 8},
      "targets": [
        {"expr": "topk(20, oya_drive_audit_chain_emission_lag_seconds{pack=\"$pack\"})", "format": "table", "refId": "A"}
      ]}
  ],
  "annotations": {
    "list": [
      {"name": "policy-changes", "datasource": "prometheus", "iconColor": "purple", "expr": "changes(oya_drive_policy_version[1h]) > 0"},
      {"name": "incident-events", "datasource": "prometheus", "iconColor": "red", "expr": "changes(oya_drive_incident_open_total[5m]) > 0"}
    ]
  }
}
