{
  "$schema": "https://schemas.grafana.com/dashboard.json",
  "_meta": {
    "doc_class": "GrafanaDashboard",
    "microservice": "drive",
    "owner_team": "axis-drive + ops-sre-reliability",
    "audience": "tenant operator + axis-drive SRE",
    "tenant_scoped": true
  },
  "uid": "drive-sync-pipeline",
  "title": "drive: sync pipeline (FastCDC + LBFS + upload + preview + scan)",
  "tags": ["drive", "sync", "upload", "fastcdc", "lbfs", "preview", "scan"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "templating": {
    "list": [
      {"name": "pack", "type": "custom", "label": "Pack",
        "options": [
          {"text": "pack-kr", "value": "kr", "selected": true},
          {"text": "pack-eu", "value": "eu"},
          {"text": "pack-us", "value": "us"},
          {"text": "pack-us-healthcare", "value": "us-hc"},
          {"text": "pack-jp", "value": "jp"}
        ]},
      {"name": "tenant", "type": "query",
        "query": "label_values(oya_drive_upload_session_total{pack=\"$pack\"}, tenant_id)"}
    ]
  },
  "panels": [
    {"id": 1, "type": "stat", "title": "Active upload sessions",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "sum(oya_drive_upload_session_active_count{pack=\"$pack\",tenant_id=\"$tenant\"})", "refId": "A"}]},

    {"id": 2, "type": "stat", "title": "Upload multipart p99 (s)",
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "histogram_quantile(0.99, sum by (le) (rate(oya_drive_upload_multipart_seconds_bucket{pack=\"$pack\",tenant_id=\"$tenant\"}[5m])))", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"mode": "absolute", "steps": [{"value": null, "color": "green"}, {"value": 90, "color": "yellow"}, {"value": 180, "color": "red"}]}}}},

    {"id": 3, "type": "stat", "title": "Sync delta p99 (s)",
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "histogram_quantile(0.99, sum by (le) (rate(oya_drive_sync_delta_seconds_bucket{pack=\"$pack\",tenant_id=\"$tenant\"}[5m])))", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"mode": "absolute", "steps": [{"value": null, "color": "green"}, {"value": 30, "color": "yellow"}, {"value": 60, "color": "red"}]}}}},

    {"id": 4, "type": "stat", "title": "Sync conflicts (last 1h)",
      "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "sum(increase(oya_drive_sync_conflict_detected_total{pack=\"$pack\",tenant_id=\"$tenant\"}[1h]))", "refId": "A"}]},

    {"id": 5, "type": "timeseries", "title": "Upload session state distribution",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum by (state) (oya_drive_upload_session_active_count{pack=\"$pack\",tenant_id=\"$tenant\"})", "legendFormat": "{{state}}", "refId": "A"}
      ]},

    {"id": 6, "type": "timeseries", "title": "FastCDC chunk size distribution (bytes; p50/p95/p99)",
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum by (le) (rate(oya_drive_fastcdc_chunk_size_bytes_bucket{pack=\"$pack\",tenant_id=\"$tenant\"}[5m])))", "legendFormat": "p50", "refId": "A"},
        {"expr": "histogram_quantile(0.95, sum by (le) (rate(oya_drive_fastcdc_chunk_size_bytes_bucket{pack=\"$pack\",tenant_id=\"$tenant\"}[5m])))", "legendFormat": "p95", "refId": "B"},
        {"expr": "histogram_quantile(0.99, sum by (le) (rate(oya_drive_fastcdc_chunk_size_bytes_bucket{pack=\"$pack\",tenant_id=\"$tenant\"}[5m])))", "legendFormat": "p99", "refId": "C"}
      ]},

    {"id": 7, "type": "timeseries", "title": "Sync delta bytes-saved ratio (lower=better dedup)",
      "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum(rate(oya_drive_sync_delta_bytes_transferred_total{pack=\"$pack\",tenant_id=\"$tenant\"}[5m])) / sum(rate(oya_drive_sync_delta_bytes_logical_total{pack=\"$pack\",tenant_id=\"$tenant\"}[5m]))", "legendFormat": "wire-bytes / logical-bytes", "refId": "A"}
      ]},

    {"id": 8, "type": "timeseries", "title": "Preview render queue depth + p99 latency",
      "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8},
      "targets": [
        {"expr": "oya_drive_preview_worker_queue_depth{pack=\"$pack\"}", "legendFormat": "queue depth", "refId": "A"},
        {"expr": "histogram_quantile(0.99, sum by (le, kind) (rate(oya_drive_preview_render_seconds_bucket{pack=\"$pack\"}[5m])))", "legendFormat": "p99 {{kind}}", "refId": "B"}
      ]},

    {"id": 9, "type": "timeseries", "title": "Virus + DLP scan throughput",
      "gridPos": {"x": 0, "y": 20, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum(rate(oya_drive_virus_scan_completed_total{pack=\"$pack\"}[5m]))", "legendFormat": "virus scans/s", "refId": "A"},
        {"expr": "sum(rate(oya_drive_dlp_scan_completed_total{pack=\"$pack\"}[5m]))", "legendFormat": "dlp scans/s", "refId": "B"},
        {"expr": "sum(rate(oya_drive_virus_scan_verdict_total{verdict=\"malicious\",pack=\"$pack\"}[5m]))", "legendFormat": "malicious/s", "refId": "C"},
        {"expr": "sum(rate(oya_drive_dlp_scan_verdict_total{verdict=\"flagged\",pack=\"$pack\"}[5m]))", "legendFormat": "flagged/s", "refId": "D"}
      ]},

    {"id": 10, "type": "table", "title": "Stuck upload sessions > 4× median",
      "gridPos": {"x": 12, "y": 20, "w": 12, "h": 8},
      "targets": [
        {"expr": "topk(10, oya_drive_upload_session_age_seconds{state=\"chunks-staging\",pack=\"$pack\"})", "format": "table", "refId": "A"}
      ]}
  ],
  "annotations": {
    "list": [
      {"name": "rollouts", "datasource": "argo-rollouts", "iconColor": "blue", "query": "{microservice=\"drive\"}"}
    ]
  }
}
