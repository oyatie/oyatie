{
  "$schema": "https://grafana.com/api/dashboards/json-schema",
  "title": "cloud-secrets — Secret Resolution Rate",
  "uid": "cloud-secrets-resolution-rate",
  "tags": ["cloud-secrets", "secret-resolution", "hot-path"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "timezone": "browser",
  "templating": {
    "list": [
      {"name": "pack", "type": "custom", "label": "Pack", "options": [
        {"text": "kr", "value": "kr", "selected": true},
        {"text": "eu", "value": "eu"},
        {"text": "us", "value": "us"},
        {"text": "us-hc", "value": "us-hc"},
        {"text": "jp", "value": "jp"},
        {"text": "sg", "value": "sg"},
        {"text": "au", "value": "au"},
        {"text": "in", "value": "in"},
        {"text": "br", "value": "br"},
        {"text": "ae", "value": "ae"},
        {"text": "ksa", "value": "ksa"}
      ]},
      {"name": "tenant", "type": "query", "label": "Tenant",
       "datasource": "mimir-cloud-secrets",
       "query": "label_values(oya_cloud_secrets_resolve_total{pack=\"$pack\"}, tenant)"},
      {"name": "microservice", "type": "query", "label": "Consumer µservice",
       "datasource": "mimir-cloud-secrets",
       "query": "label_values(oya_cloud_secrets_resolve_total{pack=\"$pack\",tenant=~\"$tenant\"}, microservice)"}
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Resolutions/sec (per pack)",
      "type": "timeseries",
      "datasource": "mimir-cloud-secrets",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum by (pack) (rate(oya_cloud_secrets_resolve_total{pack=\"$pack\"}[1m]))",
         "legendFormat": "{{pack}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "reqps", "color": {"mode": "palette-classic"}}}
    },
    {
      "id": 2,
      "title": "Cache hit ratio (per consumer)",
      "type": "timeseries",
      "datasource": "mimir-cloud-secrets",
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum by (microservice) (rate(oya_cloud_secrets_resolve_total{pack=\"$pack\",cache_outcome=\"hit\"}[5m])) / sum by (microservice) (rate(oya_cloud_secrets_resolve_total{pack=\"$pack\"}[5m]))",
         "legendFormat": "{{microservice}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "thresholds": {"mode": "absolute", "steps": [
        {"color": "red", "value": null}, {"color": "yellow", "value": 0.85}, {"color": "green", "value": 0.95}
      ]}}}
    },
    {
      "id": 3,
      "title": "Resolution p99 latency (cache-hit)",
      "type": "timeseries",
      "datasource": "mimir-cloud-secrets",
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
      "targets": [
        {"expr": "histogram_quantile(0.99, sum by (le, pack) (rate(oya_cloud_secrets_resolve_duration_seconds_bucket{pack=\"$pack\",cache_outcome=\"hit\"}[5m])))",
         "legendFormat": "p99 {{pack}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"mode": "absolute", "steps": [
        {"color": "green", "value": null}, {"color": "yellow", "value": 0.008}, {"color": "red", "value": 0.010}
      ]}}},
      "options": {"legend": {"showLegend": true}}
    },
    {
      "id": 4,
      "title": "Resolution p99 latency (cache-miss → OpenBao)",
      "type": "timeseries",
      "datasource": "mimir-cloud-secrets",
      "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
      "targets": [
        {"expr": "histogram_quantile(0.99, sum by (le, pack) (rate(oya_cloud_secrets_resolve_duration_seconds_bucket{pack=\"$pack\",cache_outcome=\"miss\"}[5m])))",
         "legendFormat": "p99 {{pack}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"mode": "absolute", "steps": [
        {"color": "green", "value": null}, {"color": "yellow", "value": 0.020}, {"color": "red", "value": 0.025}
      ]}}}
    },
    {
      "id": 5,
      "title": "Per-tenant resolution qps (top 20)",
      "type": "table",
      "datasource": "mimir-cloud-secrets",
      "gridPos": {"x": 0, "y": 16, "w": 24, "h": 8},
      "targets": [
        {"expr": "topk(20, sum by (tenant, microservice) (rate(oya_cloud_secrets_resolve_total{pack=\"$pack\"}[5m])))",
         "format": "table"}
      ]
    },
    {
      "id": 6,
      "title": "Resolution success rate",
      "type": "stat",
      "datasource": "mimir-cloud-secrets",
      "gridPos": {"x": 0, "y": 24, "w": 8, "h": 6},
      "targets": [
        {"expr": "sum(rate(oya_cloud_secrets_resolve_total{pack=\"$pack\",outcome=\"success\"}[5m])) / sum(rate(oya_cloud_secrets_resolve_total{pack=\"$pack\"}[5m]))"}
      ],
      "fieldConfig": {"defaults": {"unit": "percentunit", "thresholds": {"mode": "absolute", "steps": [
        {"color": "red", "value": null}, {"color": "yellow", "value": 0.999}, {"color": "green", "value": 0.9999}
      ]}}}
    },
    {
      "id": 7,
      "title": "Revocation propagation p99 (revoke → consumer flush)",
      "type": "stat",
      "datasource": "mimir-cloud-secrets",
      "gridPos": {"x": 8, "y": 24, "w": 8, "h": 6},
      "targets": [
        {"expr": "histogram_quantile(0.99, sum by (le) (rate(oya_cloud_secrets_revocation_propagation_seconds_bucket{pack=\"$pack\"}[5m])))"}
      ],
      "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"mode": "absolute", "steps": [
        {"color": "green", "value": null}, {"color": "yellow", "value": 3}, {"color": "red", "value": 5}
      ]}}}
    },
    {
      "id": 8,
      "title": "OpenBao backend qps (per cluster)",
      "type": "timeseries",
      "datasource": "mimir-cloud-secrets",
      "gridPos": {"x": 16, "y": 24, "w": 8, "h": 6},
      "targets": [
        {"expr": "sum by (cluster) (rate(openbao_request_total{pack=\"$pack\"}[1m]))"}
      ]
    }
  ]
}
