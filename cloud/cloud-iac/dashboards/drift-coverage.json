{
  "$schema": "https://schemas.grafana.com/dashboard.json",
  "_meta": {
    "doc_class": "GrafanaDashboard",
    "microservice": "cloud-iac",
    "owner_team": "axis-cloud-iac + ops-sre-reliability",
    "audience": "on-call IC + axis-cloud-iac SME + tenant operators",
    "tenant_scoped": true,
    "datasource": "Mimir (oya-self + oya-cloud-iac-self); recording-rules"
  },
  "uid": "cloud-iac-drift-coverage",
  "title": "cloud-iac — Drift Detection Coverage + Reports",
  "tags": ["cloud-iac", "iac", "drift", "slo"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-24h", "to": "now"},
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Drift coverage SLO (target ≥99.5%)",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "targets": [
        {"expr": "oya_cloud_iac_drift_coverage_pct", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "percentunit", "thresholds": {"steps": [{"color": "red", "value": 0}, {"color": "yellow", "value": 0.95}, {"color": "green", "value": 0.995}]}}}
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Drift events (last 1h)",
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
      "targets": [
        {"expr": "sum(increase(oya_cloud_iac_drift_events_total[1h]))", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 10}, {"color": "red", "value": 100}]}}}
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Clusters polled per cycle",
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
      "targets": [
        {"expr": "sum(oya_cloud_iac_drift_clusters_polled)", "refId": "A"}
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Drift cycle latency p99 (target ≤1h)",
      "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
      "targets": [
        {"expr": "histogram_quantile(0.99, rate(oya_cloud_iac_drift_cycle_duration_seconds_bucket[1h]))", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 1800}, {"color": "red", "value": 3600}]}}}
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Drift events rate (per µservice)",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 10},
      "targets": [
        {"expr": "sum by (microservice) (rate(oya_cloud_iac_drift_events_total[5m]))", "legendFormat": "{{microservice}}", "refId": "A"}
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Drift cycle latency (p50 / p99)",
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 10},
      "targets": [
        {"expr": "histogram_quantile(0.5, rate(oya_cloud_iac_drift_cycle_duration_seconds_bucket[5m]))", "legendFormat": "p50", "refId": "A"},
        {"expr": "histogram_quantile(0.99, rate(oya_cloud_iac_drift_cycle_duration_seconds_bucket[5m]))", "legendFormat": "p99", "refId": "B"}
      ]
    },
    {
      "id": 12,
      "type": "table",
      "title": "Top 20 drifted µservices (last 24h)",
      "gridPos": {"x": 0, "y": 14, "w": 12, "h": 10},
      "targets": [
        {"expr": "topk(20, sum by (microservice) (increase(oya_cloud_iac_drift_events_total[24h])))", "format": "table", "refId": "A"}
      ]
    },
    {
      "id": 13,
      "type": "table",
      "title": "Per-(pack, environment) drift coverage",
      "gridPos": {"x": 12, "y": 14, "w": 12, "h": 10},
      "targets": [
        {"expr": "avg by (pack, environment) (oya_cloud_iac_drift_coverage_pct)", "format": "table", "refId": "A"}
      ]
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Drift cascade burst detector",
      "gridPos": {"x": 0, "y": 24, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum(rate(oya_cloud_iac_drift_events_total[5m]))", "legendFormat": "events/sec", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 1}, {"color": "red", "value": 5}]}}}
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Security-sensitive drift (RBAC / NetworkPolicy / Secret)",
      "gridPos": {"x": 12, "y": 24, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum by (resource_kind) (rate(oya_cloud_iac_drift_events_total{resource_kind=~\"RoleBinding|ClusterRoleBinding|NetworkPolicy|Secret|ServiceAccount\"}[5m]))", "legendFormat": "{{resource_kind}}", "refId": "A"}
      ]
    }
  ]
}
