{
  "$comment": "DATA-TABLED carve-outs for the accounting-registry producer (Linus: the exception lives in the table, never in the scanner). Each rule maps a path predicate to a unit_class; the FIRST matching rule (top-to-bottom) wins, so order is significant. The classifier in producer code has ZERO special-case branches — it only walks this table. Adding/removing a carve-out is a DATA edit here, re-runnable by the producer; the registry-drift test makes any hand-edit to the generated face RED. unit_class enum (PHASE-0-FIREWALL-PLAN §5.1): code|doc|spec|registry|evidence|vendor|build_config|generated|ephemeral|husk.",
  "match_kinds": {
    "prefix": "path starts with the given string",
    "suffix": "path ends with the given string (basename or extension)",
    "contains": "path contains the given substring",
    "exact": "path equals the given string"
  },
  "rules": [
    { "id": "ephemeral-omc-state",        "kind": "contains", "value": "/.omc/state/",          "unit_class": "ephemeral" },
    { "id": "ephemeral-omc-state-top",    "kind": "prefix",   "value": ".omc/state/",            "unit_class": "ephemeral" },
    { "id": "ephemeral-omc-sessions",     "kind": "prefix",   "value": ".omc/sessions/",         "unit_class": "ephemeral" },
    { "id": "ephemeral-jsonl",            "kind": "suffix",   "value": ".jsonl",                 "unit_class": "ephemeral" },

    { "id": "vendor-third-party",         "kind": "prefix",   "value": "third-party/",           "unit_class": "vendor" },
    { "id": "vendor-dir",                 "kind": "contains", "value": "/vendor/",               "unit_class": "vendor" },

    { "id": "generated-face",             "kind": "suffix",   "value": ".generated.json",        "unit_class": "generated" },
    { "id": "generated-cargo-lock",       "kind": "suffix",   "value": "Cargo.lock",             "unit_class": "generated" },
    { "id": "generated-machine-readable", "kind": "prefix",   "value": "docs/machine-readable/", "unit_class": "generated" },

    { "id": "build-config-buck",          "kind": "suffix",   "value": "BUCK",                   "unit_class": "build_config" },
    { "id": "build-config-buckconfig",    "kind": "suffix",   "value": ".buckconfig",            "unit_class": "build_config" },
    { "id": "build-config-cargo-toml",    "kind": "suffix",   "value": "Cargo.toml",             "unit_class": "build_config" },
    { "id": "build-config-toolchain",     "kind": "suffix",   "value": "rust-toolchain.toml",    "unit_class": "build_config" },

    { "id": "evidence-tree",             "kind": "prefix",   "value": "evidence/",              "unit_class": "evidence" },
    { "id": "evidence-multispectrum",    "kind": "contains", "value": "/multispectrum/",        "unit_class": "evidence" },

    { "id": "registry-tree",             "kind": "prefix",   "value": "registry/",              "unit_class": "registry" },
    { "id": "registry-fixtures",         "kind": "contains", "value": "specs/fixtures/",        "unit_class": "registry" },

    { "id": "spec-tree",                 "kind": "prefix",   "value": "specs/",                 "unit_class": "spec" },
    { "id": "spec-contracts",           "kind": "prefix",   "value": "contracts/",            "unit_class": "spec" },

    { "id": "doc-decisions",            "kind": "prefix",   "value": "docs/decisions/",       "unit_class": "doc" },
    { "id": "doc-tree",                 "kind": "prefix",   "value": "docs/",                 "unit_class": "doc" },
    { "id": "doc-md",                   "kind": "suffix",   "value": ".md",                   "unit_class": "doc" },

    { "id": "code-rust",               "kind": "suffix",   "value": ".rs",                   "unit_class": "code" },

    { "id": "default-husk",            "kind": "prefix",   "value": "",                      "unit_class": "husk" }
  ]
}
