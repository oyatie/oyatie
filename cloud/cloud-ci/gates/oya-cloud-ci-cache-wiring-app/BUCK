# Resolver + canary toolkit binary (ADR-0560). LOCAL BRIDGE feedback only (founder
# CLI-retirement directive): merge authority is the conformance gate test below,
# never this binary. CI workflows invoke it via `buck2 run` as job steps (resolve /
# report / assert-cold / hash-outputs / canary-verdict); its successors are
# reconcilers per ADR-0556 D4 / ADR-0555 D4.
rust_binary(
    name = "oya-cloud-ci-cache-wiring-bin",
    srcs = glob(["src/**/*.rs", "**/*.json"]),
    crate_root = "src/main.rs",
    visibility = ["PUBLIC"],
    deps = [
        ":oya-cloud-ci-cache-wiring-app",
        "third-party//:serde_json",
    ],
)

