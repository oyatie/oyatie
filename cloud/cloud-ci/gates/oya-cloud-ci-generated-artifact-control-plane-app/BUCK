# Productized generated-artifact control-plane gate. The gate reads two declared inputs from
# the repo root: registry/generated-artifact-control-plane.json and the SCM facts snapshot
# materialized from the candidate tree before gates run. It does not call git, cargo, network,
# or any host-local merge driver, so the same gate shape works under buck2, GitHub Actions
# bridge CI, or future native cloud-ci runners.
rust_test(
    name = "oya-cloud-ci-generated-artifact-control-plane-app-gate",
    srcs = glob(["tests/**/*.rs"]),
    crate = "oya_cloud_ci_generated_artifact_control_plane_app_corpus",
    crate_root = "tests/generated_artifact_control_plane.rs",
    env = {
        "OYA_CI_GENERATED_ARTIFACT_MANIFEST": "$(location //registry:generated-artifact-control-plane.json)",
        "OYA_CI_GENERATED_ARTIFACT_SCM_FACTS": "$(location //cloud/cloud-ci/gates/oya-cloud-ci-accounting-registry-app:scm-facts.generated.json)",
    },
    visibility = ["PUBLIC"],
    deps = [
        ":oya-cloud-ci-generated-artifact-control-plane-app",
        "third-party//:serde_json",
    ],
)

