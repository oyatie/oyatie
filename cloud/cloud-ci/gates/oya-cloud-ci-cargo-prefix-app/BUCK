# ADR-0017 :cargo-prefix — the born-blocking self-test over the live corpus. Runs the
# scm-facts emitter + producer `--face cargo-prefix` to resolve the live workspace members +
# package names, then asserts the gate's verdict matches the live corpus. G-INTEGRITY track:
# no build-graph dep. (Named -gate to avoid an in-package buck2 collision with the rust_library
# above; the package identity carries the :cargo-prefix gate.)
rust_test(
    name = "oya-cloud-ci-cargo-prefix-app-gate",
    srcs = glob(["tests/**/*.rs"]),
    crate = "oya_cloud_ci_cargo_prefix_app_corpus",
    crate_root = "tests/cargo_prefix.rs",
    # HERMETIC: the test execs buck2-BUILT emitter + producer binaries (no `env!("CARGO")`, no
    # `cargo run`). `$(exe ...)` makes buck2 build the binaries and substitute sandbox paths here;
    # the producer consumes the freshly emitted scm-facts face, so fresh checkouts need no hidden
    # committed generated JSON prerequisite.
    env = {
        "OYA_CI_SCM_FACTS_EMITTER_BIN": "$(exe //cloud/cloud-ci/gates/oya-cloud-ci-scm-facts-emitter-app:oya-cloud-ci-scm-facts-emitter-app)",
        "OYA_CI_PRODUCER_BIN": "$(exe //cloud/cloud-ci/gates/oya-cloud-ci-accounting-registry-app:oya-cloud-ci-accounting-registry-app-bin)",
    },
    visibility = ["PUBLIC"],
    deps = [
        ":oya-cloud-ci-cargo-prefix-app",
        "//cloud/cloud-ci/gates/oya-cloud-ci-accounting-registry-app:oya-cloud-ci-accounting-registry-app",
        "third-party//:serde_json",
    ],
)
