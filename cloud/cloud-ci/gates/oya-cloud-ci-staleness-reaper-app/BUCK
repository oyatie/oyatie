# GATE-3 :staleness-reaper — the fixture-corpus + born-blocking self-test gate.
# Globs specs/fixtures/staleness-reaper/tc-*.json (the data-under-test) and asserts
# report.violations == fixture.expected_violations. G-INTEGRITY track: no build-graph dep.
# (Named -gate to avoid a buck2 in-package collision with the rust_library above; the
# package //cloud/cloud-ci/gates/oya-cloud-ci-staleness-reaper-app carries the §5.3 :staleness-reaper identity.)
rust_test(
    name = "oya-cloud-ci-staleness-reaper-app-gate",
    srcs = glob(["tests/**/*.rs"]),
    crate = "oya_cloud_ci_staleness_reaper_app_corpus",
    crate_root = "tests/staleness_reaper.rs",
    # HERMETIC: the test execs the buck2-BUILT producer binary (no `env!("CARGO")`, no `cargo
    # run`). `$(exe ...)` makes buck2 build the producer and substitute its sandbox path here;
    # the producer reads the committed scm-facts face (a declared input) — no action calls git.
    env = {
        "OYA_CI_PRODUCER_BIN": "$(exe //cloud/cloud-ci/gates/oya-cloud-ci-accounting-registry-app:oya-cloud-ci-accounting-registry-app-bin)",
    },
    visibility = ["PUBLIC"],
    deps = [
        ":oya-cloud-ci-staleness-reaper-app",
        "//cloud/cloud-ci/gates/oya-cloud-ci-accounting-registry-app:oya-cloud-ci-accounting-registry-app",
        "third-party//:serde_json",
    ],
)
