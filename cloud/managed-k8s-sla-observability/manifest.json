  "sustainability_emission_model": {"pod_runtime_tier_ref": "self.pod_runtime_tier", "power_model": {"cpu_watts_per_vcpu_second": 0.16, "memory_watts_per_gib_second": 0.0008, "storage_watts_per_gib_hour": 0.0, "network_watts_per_gib": 0.022, "tier_overhead_factor": {"tier_0_kata_clh": 1.4, "tier_1_kata_clh": 1.4, "tier_2_runc": 1.0, "tier_3_runc_edge": 1.05}}, "price_model": {"source": "provider_sku_pricing", "binding": "cloud/cloud-billing/README.md:56-75; cloud/cloud-billing/implementation-plans/IP-004-composable-billing-components.md:91-107", "pin_window_hours": 1}, "workload_signal_source": {"signal_family": "per_request", "source_ref": "cloud/managed-k8s-sla-observability/manifest.json#capabilities.sla-summary-read + managed-cluster-availability/provisioning-latency snapshots"}, "emission_path_tests": ["cloud/managed-k8s-sla-observability/IPs/IP-sustainability-emission-model.md#sla-summary-fixture", "cloud/managed-k8s-sla-observability/slos/managed-cluster-availability.openslo.yaml", "cloud/managed-k8s-sla-observability/slos/provisioning-latency.openslo.yaml"], "validation_baseline": {"expected_watt_hours_per_request_p50_mwh": 7, "expected_co2_grams_per_request_p50_at_grid_400gco2_per_kwh": 0.0028, "tolerance_pct": 20}},
  "tenant_version_pinning": {"declared_versions": [], "default_version": null, "supported_window_size": 1, "supported_window_minimum_days": 0, "supports_per_tenant_pinning": false, "deprecation_calendar": [], "public_surface_files": {}},
