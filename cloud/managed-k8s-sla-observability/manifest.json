  "owner": "axis-cloud-k8s",
  "bounded_contexts": [
    {
      "name": "managed-k8s-sla-observability",
      "description": "Tenant-scoped managed-Kubernetes SLA observability. Consumes the ControlPlaneProvisioning/status seam from managed-k8s-control-plane-host, computes deterministic availability/provisioning-latency/error-budget summaries, and defers live Prometheus/Kubernetes integration behind the port.",
      "crates": [
        "oya-managed-k8s-sla-observability-kernel",
        "oya-managed-k8s-sla-observability-api",
        "oya-managed-k8s-sla-observability-adapter-inmemory",
        "oya-managed-k8s-sla-observability-app"
      ]
    }
  ],
  "layers": ["adapter", "api", "app", "kernel"],
  "contracts": {
    "openapi": ["cloud/managed-k8s-sla-observability/contracts/openapi-v1.yaml"],
    "asyncapi": ["cloud/managed-k8s-sla-observability/contracts/asyncapi-v1.yaml"],
    "proto": ["cloud/managed-k8s-sla-observability/contracts/managed-k8s-sla-observability.proto"]
  },
  "capabilities": [
    {"tier": "T1", "name": "sla-summary-read", "file": "cloud/managed-k8s-sla-observability/capabilities/sla-summary-read.yaml", "risk_class": "minimal"}
  ],
  "slos": [
    {"name": "managed-cluster-availability", "target": "0.999", "sli": "healthy_status_samples / total_status_samples from managed-k8s SLA observation snapshots", "file": "cloud/managed-k8s-sla-observability/slos/managed-cluster-availability.openslo.yaml"},
    {"name": "managed-cluster-provisioning-latency", "target": "<= 600000ms", "sli": "provisioning_latency_millis from managed-k8s SLA observation snapshots", "file": "cloud/managed-k8s-sla-observability/slos/provisioning-latency.openslo.yaml"}
  ],
  "ips": [
    {"id": "ADR-0376", "title": "Oyatie managed-Kubernetes product surface", "acceptance_status": "accepted", "file": "docs/decisions/ADR-0376-managed-kubernetes-product-surface.md"},
    {"id": "IP-001-sla-observability-kernel-api-adapter-app", "title": "IP-001: SLA observability kernel + port + in-memory adapter + composition service", "acceptance_status": "ga", "file": "cloud/managed-k8s-sla-observability/IPs/IP-001-sla-observability-foundation.md"},
    {"id": "IP-sustainability-emission-model", "title": "IP: SLA observability sustainability emission model planning fixture", "acceptance_status": "advisory-plan-spec", "file": "cloud/managed-k8s-sla-observability/IPs/IP-sustainability-emission-model.md"}
  ],
  "regulatory_packs": ["kr","eu","us","jp","sg","au","in","br","ae","ksa"],
  "lts_pins": {"rust": "1.83"},
  "adrs": [
    {"id": "ADR-0376", "title": "Oyatie managed-Kubernetes product surface", "scope": "microservice", "file": "docs/decisions/ADR-0376-managed-kubernetes-product-surface.md"},
    {"id": "ADR-0092", "title": "Workspace dependency-seam policy", "scope": "repo", "file": "docs/decisions/ADR-0092-workspace-dependency-seam-policy.md"},
    {"id": "ADR-0338", "title": "Pod runtime tier 0..3", "scope": "repo", "file": "docs/decisions/ADR-0338-pod-runtime-tier-0-to-3.md"}
  ],
  "audit_chain": {"enabled": false, "seal_events": []},
  "secrets_substrate": {"provider": "openbao", "format": "${openbao:secret/<path>}"},
  "ontology_projections": [],
  "mesh_layering": {"cilium_l4": true, "ambient_ztunnel": true, "ambient_waypoint": false, "north_south_only": false},
