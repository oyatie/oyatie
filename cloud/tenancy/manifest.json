  "capacity_model": {
    "baseline_cpu_per_tenant": 0.14,
    "baseline_ram_per_tenant": 192,
    "storage_per_tenant": 3,
    "connections_per_tenant": {
      "valkey": 3,
      "postgres": 3,
      "outbound_http": 4
