    "failover_runbook": "runbooks/dr-pair-promotion-drill.md",
    "dr_tier": "T1",
    "replication_shape": "active-active-multi-az-cross-region-warm"
  },
  "non_claims": [
    "C2a Phase0 does not prove live multi-region active-active tenancy operation despite target DR posture metadata.",
    "C2a Phase0 does not prove tenant migration, cell rebalance, failover drill, audit-chain seal persistence, or provider runtime execution.",
    "C2a Phase0 does not prove measured SLO SLI burn-rate Prometheus runtime evidence."
