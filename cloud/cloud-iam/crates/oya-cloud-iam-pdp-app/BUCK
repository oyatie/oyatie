rust_library(
    name = "oya-cloud-iam-pdp-app",
    srcs = glob(["src/**/*.rs", "cedar/**", "proto/**"]),
    crate = "oya_cloud_iam_pdp_app",
    crate_root = "src/lib.rs",
    env = {"OUT_DIR": "$(location :oya-cloud-iam-pdp-app-build-script-run[out_dir])"},
    visibility = ["PUBLIC"],
    deps = _DEPS,
)

rust_binary(
    name = "oya-cloud-iam-pdp-app-bin",
    srcs = glob(["src/**/*.rs"]),
    crate_root = "src/main.rs",
    visibility = ["PUBLIC"],
    deps = [":oya-cloud-iam-pdp-app"] + [
        "third-party//:tokio",
        "third-party//:tracing",
    ],
)

