load("@prelude//rust:cargo_buildscript.bzl", "buildscript_run")

rust_binary(
    name = "oya-cloud-iam-pdp-app-build-script",
    srcs = ["build.rs"],
    crate = "build_script_build",
    crate_root = "build.rs",
    visibility = [],
    deps = [
        "third-party//:protoc-bin-vendored",
        "third-party//:tonic-prost-build",
    ],
)

export_file(
    name = "build.rs",
    visibility = [],
)

export_file(
    name = "cloud-iam-pdp.proto",
    src = "proto/cloud-iam-pdp.proto",
    visibility = [],
)

genrule(
    name = "oya-cloud-iam-pdp-app-manifest-dir",
    srcs = [
        ":build.rs",
        ":cloud-iam-pdp.proto",
    ],
    out = "manifest_dir",
    cmd = "mkdir -p $OUT/proto && cp $(location :build.rs) $OUT/ && cp $(location :cloud-iam-pdp.proto) $OUT/proto/",
)

buildscript_run(
    name = "oya-cloud-iam-pdp-app-build-script-run",
    buildscript_rule = ":oya-cloud-iam-pdp-app-build-script",
    package_name = "oya-cloud-iam-pdp-app",
    version = "0.1.0",
    manifest_dir = ":oya-cloud-iam-pdp-app-manifest-dir",
)

_DEPS = [
