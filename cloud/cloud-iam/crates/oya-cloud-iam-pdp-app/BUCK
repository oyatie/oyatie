    "//oya/identity/crates/oya-identity-workload-svid-trustd-adapter:oya-identity-workload-svid-trustd-adapter",
    "//cloud/cloud-os/crates/oya-cloud-os-trustd-domain:oya-cloud-os-trustd-domain",
    "third-party//:async-stream",
