# Hermetic input set for gates that must validate every live cloud service manifest.
filegroup(
    name = "live-service-manifest-corpus",
    srcs = glob(["**/manifest.json"]),
    visibility = ["PUBLIC"],
)

# Hermetic input set for gates that validate the full internal Proto contract corpus.
filegroup(
    name = "proto-contract-corpus",
    srcs = glob(["**/*.proto"]),
    visibility = ["PUBLIC"],
)

# No corpus-yaml-facts extraction target: the waves 25/26 rehome moved the last YAML this package
# owned into the capability roots, which declare their own extraction (ADR-0541). The extractor
# fails closed on an empty input set precisely so a drained glob cannot masquerade as a covered
# corpus, so the target is removed rather than left to extract nothing. This package owns zero YAML
# and is therefore not an observation of the corpus-index-coverage gate at all — no ceiling moves.
# Restore an extraction target here if YAML ever lands under cloud/ outside a subpackage again.
