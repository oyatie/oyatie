# cloud-kernel buck2 surface (G12 LANE-1).
#
# The bare-metal targets (the kernel binary + the two arch Frame backends) need a
# bare-metal rust platform the repo does not define yet (pinned nightly,
# -Z build-std, {aarch64-unknown-none-softfloat, x86_64-unknown-none}, custom
# linker scripts). They are marked target_compatible_with the constraint below,
# which NO current platform provides, so `buck2 build //cloud/cloud-kernel/...`
# SKIPS them as explicitly incompatible (visible, not false-green) until a
# bare-metal execution platform lands. The pure no_std crates build as host
# rlibs and the user-layout math runs as a real buck2 host test.
constraint_setting(
    name = "kernel-target",
    visibility = ["PUBLIC"],
)

constraint_value(
    name = "bare-metal",
    constraint_setting = ":kernel-target",
    visibility = ["PUBLIC"],
)
