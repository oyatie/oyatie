# cloud-kernel buck2 surface (G12 LANE-1).
#
# The bare-metal kernel image and arch Frame backends need a Buck2 Rust platform
# the repo does not define yet (pinned nightly, -Z build-std,
# {aarch64-unknown-none-softfloat, x86_64-unknown-none}, custom linker scripts,
# and nested-workspace third-party no_std deps).
#
# Do NOT expose placeholder Buck2 targets for those surfaces: direct builds fail
# and `buck2 build //cloud/cloud-kernel/...` only skips them, which reads as a
# false green. Until the real bare-metal platform/toolchain lands, the Buck2
# surface here is limited to host-buildable pure no_std crates and host tests.
# The marker below is reserved for that future platform/toolchain work.
constraint_setting(
    name = "kernel-target",
    visibility = ["PUBLIC"],
)

constraint_value(
    name = "bare-metal",
    constraint_setting = ":kernel-target",
    visibility = ["PUBLIC"],
)
