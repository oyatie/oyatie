/target
# The out-of-workspace host test harness builds into its own target dir.
/crates/oya-cloud-kernel-arch-aarch64-adapter/tests-host/target
# The standalone x86_64 ring-3 user program builds into its own target dir.
/crates/oya-cloud-kernel-arch-x86-64-adapter/user-src/target
# Transient Docker build staging dir for the fsbase-worker std/musl ELF
# (created + removed by fsbase-worker-src/build.sh; under the repo root only so
# Docker Desktop can mount it).
/.fsbase-worker-build.*
# Stage B (build-carriers.sh --stage-b) cross-compiles the talos-init/svc musl
# carriers into this dedicated CARGO_TARGET_DIR. Transient build output; the
# produced /out/*.elf carriers (already ignored above) are the only artifacts.
/out/.stage-b-target/
**/*.rs.bk
*.pdb

# QEMU/serial run artifacts. Keep the directory, ignore the logs.
/out/*.log
/out/*.elf
/out/*.bin
# diff-oracle.sh intermediate (the normalized trace it diffs against the
# committed golden in tests/golden/). Transient; the golden is the tracked one.
/out/*.normalized
!/out/.gitkeep
# The EL0 user program is embedded into the kernel image via include_bytes!, so
# it is a required *build input* (not a transient run artifact) and must be
# tracked. Rebuild with `(cd ../kernel-usermode-tests/hello && cargo build --release)` and copy
# the result here.
!/out/user-hello.elf
# The real static musl binary embedded for the EL0 musl milestone (§2d) is also
# a required build input. Rebuild via:
#   docker run --rm --platform linux/arm64 -v "$PWD/out/musl-src":/work -w /work \
#     alpine sh -c "apk add gcc musl-dev && gcc -static -no-pie -O2 -o hello hello.c"
#   cp out/musl-src/hello out/user-musl.elf
!/out/user-musl.elf
# The static x86_64 ring-3 ELF embedded into the x86_64 kernel via include_bytes!
# is also a required build input. Rebuild + refresh it with:
#   (see crates/oya-cloud-kernel-arch-x86-64-adapter/user-src; built standalone)
!/out/user-x86_64.elf
# Keep only the musl *source* used to produce user-musl.elf; the intermediate
# unstripped `hello` binary is a reproducible artifact and stays ignored.
/out/musl-src/*
!/out/musl-src/hello.c

# The default-build embedded EL0/ring-3 images are required *build inputs*
# (include_bytes! in the arch backends), so they are tracked like
# out/user-hello.elf. Rebuilt standalone from their preserved sources
# (aarch64: stack/kernel-usermode-tests on the consolidate snapshot branch;
# x86_64: crates/oya-cloud-kernel-arch-x86-64-adapter/user-{spawn,exec}-src).
!/out/user-spawn.elf
!/out/user-exec.elf
!/out/user-spawn-x86_64.elf
!/out/user-exec-x86_64.elf
