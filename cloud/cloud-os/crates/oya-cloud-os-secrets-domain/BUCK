# The production library. It declares NO features, so the crate-root gate in
# src/lib.rs strips the whole crate: off-feature there is no modeled key
# material to reach. It has ZERO reverse dependencies today
# (`buck2 uquery "rdeps(//..., :oya-cloud-os-secrets-domain)"` returns only itself); it is
# kept for its workspace-member identity (crate-catalog-coverage retired with ADR-0718).
# `no_production_buck_target_enables_the_model` asserts this target never grows
# `features = ["modeled-crypto"]` — the one route to the model that restricting
# the modeled target's `visibility` cannot express.
rust_library(
    name = "oya-cloud-os-secrets-domain",
    srcs = glob(["src/**/*.rs", "migrations/**/*.sql", "**/*.cedar", "**/*.sql", "**/*.json", "**/*.toml", "**/*.yaml", "**/*.yml", "**/*.proto", "**/*.html", "**/*.css", "**/*.txt"]),
    crate = "oya_cloud_os_secrets_domain",
    crate_root = "src/lib.rs",
    visibility = ["PUBLIC"],
    deps = [
        "//os/core/kernel:os-kernel",
    ],
)

# The model, for TEST TARGETS ONLY. Same crate name, so a test target swaps this
# in for the production library without touching a single `use`.
#
# `visibility` is the barrier, not a convention: it is enumerated at the two
# TARGETS that consume this target today, so anything else depending on it fails
# buck2 ANALYSIS rather than a test. That is the compile-time impossibility this
# gate is for. An enumerated `visibility` was chosen over the repo's usual `[]`
# because `[]` is package-private and both real consumers are in other packages;
# over `["PUBLIC"]` because PUBLIC is what let a production target reach the
# model in the first place.
#
# TARGET granularity, not package granularity, and the difference is the whole
# barrier. `//cloud/cloud-os/crates/oya-cloud-os-kubernetes-domain:` admits EVERY target in that package —
# including `:oya-cloud-os-kubernetes-domain`, a `rust_library` with `visibility =
# ["PUBLIC"]`. Under the package form, adding this target to that library's
# `deps` was one line, produced no analysis error, and was invisible to
# `no_production_buck_target_enables_the_model` (which reads only this file). So
# visibility is NECESSARY and NOT SUFFICIENT at package granularity; naming the
# targets is what makes it sufficient. Naming targets also fails LOUDLY if
# either test target is renamed, which is the correct direction.
#
# Proven to fire, by mutation, twice. Both give BUILD FAILED before a single
# compile action:
#
# (1) a package NOT named below — adding this target to the `deps` of
#     `//os/core/runtime-cri-domain:os-runtime-cri-domain` and running
#     `buck2 build //os/core/runtime-cri-domain:os-runtime-cri-domain`:
#
#       Error running analysis for `root//os/core/runtime-cri-domain:os-runtime-cri-domain`
#       1: `root//cloud/cloud-os/crates/oya-cloud-os-secrets-domain:oya-cloud-os-secrets-domain-modeled` is not visible to
#          `root//os/core/runtime-cri-domain:os-runtime-cri-domain`
#
# (2) the SAME-PACKAGE production library, which the package form permitted —
#     adding this target to the `deps` of
#     `//cloud/cloud-os/crates/oya-cloud-os-kubernetes-domain:oya-cloud-os-kubernetes-domain` and running
#     `buck2 build //cloud/cloud-os/crates/oya-cloud-os-kubernetes-domain:oya-cloud-os-kubernetes-domain`:
#
#       Error running analysis for `root//cloud/cloud-os/crates/oya-cloud-os-kubernetes-domain:oya-cloud-os-kubernetes-domain`
#       1: `root//cloud/cloud-os/crates/oya-cloud-os-secrets-domain:oya-cloud-os-secrets-domain-modeled` is not visible to
#          `root//cloud/cloud-os/crates/oya-cloud-os-kubernetes-domain:oya-cloud-os-kubernetes-domain`
#
# Pick an unrelated package when re-running (1). Mutating a package the modeled
# target itself depends on (`//cloud/cloud-os/crates/oya-cloud-os-kernel`) reports a configured target CYCLE
# instead, which is a true failure for the wrong reason and does not prove
# visibility.
#
# The mutations are deliberately NOT committed: a permanently-broken target would
# redden `buck2 build //...` for every lane, which is what the affected-set FULL
# tier runs. Same reasoning as trap T2 in the lane mapping.
rust_library(
    name = "oya-cloud-os-secrets-domain-modeled",
    srcs = glob(["src/**/*.rs", "migrations/**/*.sql", "**/*.cedar", "**/*.sql", "**/*.json", "**/*.toml", "**/*.yaml", "**/*.yml", "**/*.proto", "**/*.html", "**/*.css", "**/*.txt"]),
    crate = "oya_cloud_os_secrets_domain",
    crate_root = "src/lib.rs",
    features = ["modeled-crypto"],
    visibility = [
        "//cloud/cloud-os/crates/oya-cloud-os-kubernetes-domain:oya-cloud-os-kubernetes-domain-unittest",
        "//cloud/cloud-os/crates/oya-cloud-os-difftest-app:oya-cloud-os-difftest-app-differential",
    ],
    deps = [
        "//os/core/kernel:os-kernel",
    ],
)

# `BUCK` is in srcs because the guard test reads this file: the barrier is half
# source (the crate-root cfg) and half build graph (no production target turning
# the feature on), and a test that only checked the source half would miss the
# way the barrier actually gets removed.
#
# It is a LITERAL PATTERN INSIDE the glob, not `glob([...]) + ["BUCK"]`. The
# concatenation builds the same file set for buck2 and an UNREADABLE one for
# ci/facade/embedded-asset-hermeticity: parse_srcs models `glob(...)` and a bare
# list, and a binary `+` of the two falls to its `_ => unparseable` arm, which
# fail-safes the whole target to a born-blocking `skip_buck_unparseable` rather
# than certifying a srcs set it cannot see. Keeping srcs a single glob call
# keeps the include site RESOLVED instead of skipped.
rust_test(
    name = "oya-cloud-os-secrets-domain-unittest",
    srcs = glob(["src/**/*.rs", "migrations/**/*.sql", "**/*.cedar", "**/*.sql", "**/*.json", "**/*.toml", "**/*.yaml", "**/*.yml", "**/*.proto", "**/*.html", "**/*.css", "**/*.txt", "testdata/**", "BUCK"]),
    crate = "oya_cloud_os_secrets_domain",
    crate_root = "src/lib.rs",
    visibility = ["PUBLIC"],
    deps = [
        "//os/core/kernel:os-kernel",
    ],
)
