# Cache-only execution platform target (ADR-0560). Selected ONLY by the opt-in CI
# overlays (infra/ci/buckconfig/warm-cache-{rw,ro}.buckconfig) via
# `[build] execution_platforms = toolchains//cache:cache-platform`; the root
# .buckconfig keeps `prelude//platforms:default`, so default builds never touch this.
#
# The [remote_cache] knobs are read at parse time: without an overlay both default to
# "false" and the executor config is byte-equivalent to the prelude default
# (local-only, no cache) — selecting this platform with no [remote_cache] section is
# itself a bypass.

load("@prelude//platforms:defs.bzl", "host_configuration")
load(":defs.bzl", "cache_execution_platform")

cache_execution_platform(
    name = "cache-platform",
    allow_cache_uploads = read_root_config("remote_cache", "allow_cache_uploads", "false") == "true",
    cpu_configuration = host_configuration.cpu,
    os_configuration = host_configuration.os,
    remote_cache_enabled = read_root_config("remote_cache", "remote_cache_enabled", "false") == "true",
    use_windows_path_separators = host_info().os.is_windows,
    visibility = ["PUBLIC"],
)
