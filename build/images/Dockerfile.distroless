# Distroless runtime image for Oya workspace binaries (M-CC-P06-IP-003).
#
# Stage 1 (builder) cross-compiles a target binary to musl so the
# resulting artifact is fully static and copies cleanly into a
# distroless final layer with no glibc / shell / package-manager
# surface area. The fitness-image-discipline kernel enforces these
# properties (no shell, no apt, no apk in the final layer).
#
# Build:
#   docker build \
#     --build-arg BIN_NAME=oya-intelligence-runtime \
#     --build-arg TARGET=x86_64-unknown-linux-musl \
#     -f build/images/Dockerfile.distroless -t oya-intelligence-runtime:dev .

ARG TARGET=x86_64-unknown-linux-musl
ARG BIN_NAME=oya-intelligence-runtime
ARG RUST_VERSION=1.97.1

# --- Stage 1: musl builder ------------------------------------------------
FROM rust:${RUST_VERSION}-alpine AS builder
ARG TARGET
ARG BIN_NAME

# musl-dev provides crt + libc headers; cmake + perl cover sys-deps that
# ring/aws-lc-sys etc. require. Build-time only; never copied into final.
RUN apk add --no-cache musl-dev cmake perl pkgconfig openssl-dev

RUN rustup target add ${TARGET}

WORKDIR /build
COPY . .

ENV CARGO_TARGET_X86_64_UNKNOWN_LINUX_MUSL_LINKER=musl-gcc \
    RUSTFLAGS="-C link-arg=-s"

RUN cargo build --release --target ${TARGET} --bin ${BIN_NAME} && \
    cp /build/target/${TARGET}/release/${BIN_NAME} /build/release-binary

# --- Stage 2: distroless final --------------------------------------------
# gcr.io/distroless/static-debian12 has no shell, no package manager, no
# libc — only ca-certs + tzdata + the binary we ship. Matches the
# allowlist in `oya-governance-image-discipline-kernel`.
FROM gcr.io/distroless/static-debian12:nonroot AS runtime

# Minimal labels: build metadata for SBOM / supply-chain lanes.
LABEL org.opencontainers.image.source="https://github.com/jason931225/oyatie"
LABEL org.opencontainers.image.licenses="Apache-2.0"
LABEL org.opencontainers.image.description="Static musl-linked Oya workspace binary on distroless-static-nonroot."

# Run as the distroless nonroot user (UID/GID 65532).
USER nonroot:nonroot

COPY --from=builder /build/release-binary /usr/local/bin/oya-binary

ENTRYPOINT ["/usr/local/bin/oya-binary"]
