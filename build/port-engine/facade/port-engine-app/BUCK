    name = "port-engine-app-bin",
    srcs = ["src/main.rs"],
    crate = "port_engine_app_bin",
    crate_root = "src/main.rs",
    visibility = ["PUBLIC"],
    deps = [
        ":port-engine-app",
    ],
)

