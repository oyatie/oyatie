# This crate owns the ENCODING of the engine axis, not the enumeration: every crate embeds the
# sources it owns and the facade joins them, so this target's inputs stay package-local.
rust_library(
    name = "port-engine-identity",
    srcs = glob(["src/**/*.rs", "src/**/*.json"]),
    crate = "port_engine_identity",
    crate_root = "src/lib.rs",
    visibility = ["PUBLIC"],
    deps = [
        "//build/port-engine/adapters/hash:port-engine-hash",
        "//build/port-engine/ports/api:port-engine-api",
    ],
)

