# Package-local src/rulepack-v0.json mirrors forever home specs/port-rules/** (integ/specs)
# so include_str! stays hermetic under buck2 (same-package asset pattern as source-pin).
rust_library(
    name = "port-engine-rulepack",
    srcs = glob(["src/**/*.rs", "src/**/*.json"]),
    crate = "port_engine_rulepack",
    crate_root = "src/lib.rs",
    visibility = ["PUBLIC"],
    deps = [
        "//build/port-engine/adapters/hash:port-engine-hash",
        "//build/port-engine/ports/api:port-engine-api",
        "third-party//:serde",
        "third-party//:serde_json",
    ],
)

