    crate = "port_engine_rulepack",
    crate_root = "src/lib.rs",
    visibility = ["PUBLIC"],
    deps = [
        "//build/port-engine/adapters/hash:port-engine-hash",
        "//build/port-engine/core/kernel:port-engine-kernel",
        "//build/port-engine/ports/api:port-engine-api",
        "third-party//:serde",
        "third-party//:serde_json",
    ],
)

