# Package-local corpus mirrors the live build/toolchains/** cell as *.txt so include_str! stays
# hermetic under buck2 (nested files named BUCK are excluded from rust srcs globs).
# The receipt axis digests these byte-identical mirrors of the canonical toolchain definitions.
rust_library(
    name = "port-engine-toolchain",
    srcs = glob(["src/**/*.rs", "src/corpus/**/*.txt"]),
    crate = "port_engine_toolchain",
    crate_root = "src/lib.rs",
    visibility = ["PUBLIC"],
    deps = [
        "//build/port-engine/adapters/port-engine-hash:port-engine-hash",
        "//build/port-engine/ports/port-engine-api:port-engine-api",
    ],
)

rust_test(
    name = "port-engine-toolchain-unittest",
    srcs = glob(["src/**/*.rs", "src/corpus/**/*.txt"]),
    crate = "port_engine_toolchain",
    crate_root = "src/lib.rs",
    visibility = ["PUBLIC"],
    deps = [
        "//build/port-engine/adapters/port-engine-hash:port-engine-hash",
        "//build/port-engine/ports/port-engine-api:port-engine-api",
    ],
)

rust_test(
    name = "port-engine-toolchain-readiness",
    srcs = glob(["tests/readiness.rs"]),
    crate = "port_engine_toolchain_readiness",
    crate_root = "tests/readiness.rs",
    visibility = ["PUBLIC"],
    deps = [
        ":port-engine-toolchain",
    ],
)
