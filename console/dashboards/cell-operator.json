{
  "__inputs": [{ "name": "DS_PROMETHEUS", "type": "datasource", "pluginId": "prometheus" }],
  "__requires": [{ "type": "grafana", "id": "grafana", "name": "Grafana", "version": "12.0.0" }],
  "title": "Ops Dashboard — Cell Operator",
  "uid": "oya-ops-cell-operator-v1",
  "description": "Cell-operator panel: cluster/node/cell/mesh health, bootstrap status, recovery posture, SPIFFE attestation state, Cilium L4 policy health. Glanceable: critical cell state visible without scrolling. Keyboard: G→C. Hyperscaler precedent: AWS Control Tower account vending + GCP Cloud Console fleet view.",
  "tags": ["ops", "cell", "cluster", "health", "mesh", "internal"],
  "timezone": "browser",
  "editable": false,
  "schemaVersion": 40,
  "version": 1,
  "refresh": "15s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Cell Health (All Regions)",
      "description": "Aggregate cell health. Green = all Tier-0/1/2/3 cells healthy. Red = any cell degraded.",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [{
        "expr": "min(oya_ops_control_center_cell_health_score) by (cell_tier)",
        "legendFormat": "Tier {{ cell_tier }}"
      }],
      "fieldConfig": {
        "defaults": {
          "thresholds": { "steps": [
            { "color": "red", "value": 0 },
            { "color": "yellow", "value": 0.8 },
            { "color": "green", "value": 0.95 }
          ]}
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Cluster Health Signal Freshness",
      "description": "SLO: ≤60s freshness. Alert on stale signals.",
      "gridPos": { "h": 4, "w": 4, "x": 6, "y": 0 },
      "targets": [{
        "expr": "max(oya_ops_control_center_cluster_health_age_seconds)",
        "legendFormat": "Max Staleness (s)"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": { "steps": [
            { "color": "green", "value": 0 },
            { "color": "yellow", "value": 30 },
            { "color": "red", "value": 60 }
          ]}
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "SPIFFE SVID Validity",
      "description": "All control-plane SPIFFE SVIDs valid. Any expiry < 1h = alert.",
      "gridPos": { "h": 4, "w": 4, "x": 10, "y": 0 },
      "targets": [{
        "expr": "min(oya_ops_control_center_spiffe_svid_ttl_seconds)",
        "legendFormat": "Min SVID TTL (s)"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": { "steps": [
            { "color": "red", "value": 0 },
            { "color": "yellow", "value": 3600 },
            { "color": "green", "value": 21600 }
          ]}
        }
      }
    },
    {
      "id": 4,
      "type": "table",
      "title": "Cell Health by Region",
      "description": "Per-cell health scores by region and tier. Drill-down to cell for incident.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [{
        "expr": "oya_ops_control_center_cell_health_score by (region, cell_tier, cell_id)",
        "legendFormat": "{{ region }} / Tier {{ cell_tier }} / {{ cell_id }}"
      }]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Service Mesh (Cilium) Policy Violations",
      "description": "Cilium L4 policy drops. Any value in prod = investigation needed.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [{
        "expr": "sum(rate(cilium_drop_count_total{direction=\"ingress\"}[5m])) by (reason, cell_id)",
        "legendFormat": "{{ reason }} / {{ cell_id }}"
      }]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Bootstrap / Recovery Workflow State",
      "description": "Bootstrap and recovery workflows: running, completed, failed.",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 12 },
      "targets": [
        {
          "expr": "sum(oya_ops_control_center_recovery_workflows_total{state=\"running\"})",
          "legendFormat": "Running"
        },
        {
          "expr": "sum(oya_ops_control_center_recovery_workflows_total{state=\"failed\"})",
          "legendFormat": "Failed"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Kubernetes Node Pressure",
      "description": "Node CPU/memory/disk pressure signals from cluster health BC.",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 12 },
      "targets": [
        {
          "expr": "sum(kube_node_status_condition{condition=\"MemoryPressure\",status=\"true\"})",
          "legendFormat": "MemoryPressure"
        },
        {
          "expr": "sum(kube_node_status_condition{condition=\"DiskPressure\",status=\"true\"})",
          "legendFormat": "DiskPressure"
        },
        {
          "expr": "sum(kube_node_status_condition{condition=\"PIDPressure\",status=\"true\"})",
          "legendFormat": "PIDPressure"
        }
      ]
    }
  ]
}
