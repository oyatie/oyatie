{
  "__inputs": [{ "name": "DS_PROMETHEUS", "type": "datasource", "pluginId": "prometheus" }],
  "__requires": [{ "type": "grafana", "id": "grafana", "name": "Grafana", "version": "12.0.0" }],
  "title": "Ops Dashboard — Overview",
  "uid": "oya-ops-overview-v1",
  "description": "Primary SRE ops overview: SLO burn, command availability, active incidents, step-up auth health, Cedar eval latency, audit completeness. Dark-mode default. Keyboard nav: G→O (ops-overview), G→T (tenant-admin), G→C (cell-operator). Hyperscaler precedent: AWS CloudWatch Ops Dashboard, Stripe internal admin overview.",
  "tags": ["ops", "sre", "slo", "cedar", "audit", "internal"],
  "timezone": "browser",
  "editable": false,
  "schemaVersion": 40,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-3h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Command Availability (30d)",
      "description": "SLO: 99.9% — error budget burn rate. Alert threshold: 5× burn.",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [{
        "expr": "sum(rate(oya_ops_control_center_requests_total{status!~\"5..\"}[30d])) / sum(rate(oya_ops_control_center_requests_total[30d]))",
        "legendFormat": "Availability"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": { "steps": [
            { "color": "red", "value": 0 },
            { "color": "yellow", "value": 0.998 },
            { "color": "green", "value": 0.999 }
          ]}
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Active Incidents",
      "description": "Count of open incidents declared via this surface.",
      "gridPos": { "h": 4, "w": 3, "x": 6, "y": 0 },
      "targets": [{
        "expr": "oya_ops_control_center_incidents_active_total",
        "legendFormat": "Active"
      }],
      "fieldConfig": {
        "defaults": {
          "thresholds": { "steps": [
            { "color": "green", "value": 0 },
            { "color": "yellow", "value": 3 },
            { "color": "red", "value": 5 }
          ]}
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Audit Completeness",
      "description": "100% target — every admin action must be audit-sealed. Any value < 1.0 is SEV1.",
      "gridPos": { "h": 4, "w": 3, "x": 9, "y": 0 },
      "targets": [{
        "expr": "sum(rate(oya_ops_control_center_operator_action_total{sealed=\"true\"}[5m])) / sum(rate(oya_ops_control_center_operator_action_total[5m]))",
        "legendFormat": "Completeness"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": { "steps": [
            { "color": "red", "value": 0 },
            { "color": "yellow", "value": 0.99 },
            { "color": "green", "value": 1.0 }
          ]}
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Request Latency P50/P95/P99",
      "description": "P99 target ≤500ms for mutations; ≤200ms for reads.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(oya_ops_control_center_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "P50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(oya_ops_control_center_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "P95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(oya_ops_control_center_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "P99"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Cedar Eval Latency P99",
      "description": "P99 budget ≤5ms. Alert at 10ms.",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 4 },
      "targets": [{
        "expr": "histogram_quantile(0.99, sum(rate(oya_ops_control_center_cedar_eval_duration_seconds_bucket[5m])) by (le, fragment))",
        "legendFormat": "{{ fragment }}"
      }],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Tenant Scope Violations",
      "description": "Zero tolerance — any value triggers immediate alert and investigation.",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 12 },
      "targets": [{
        "expr": "sum(rate(oya_ops_control_center_tenant_scope_violations_total[5m])) by (principal_role)",
        "legendFormat": "{{ principal_role }}"
      }],
      "fieldConfig": {
        "defaults": {
          "thresholds": { "steps": [
            { "color": "green", "value": 0 },
            { "color": "red", "value": 0.001 }
          ]}
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Step-Up Auth Failures",
      "description": "Step-up failure rate per principal role. Elevated rate → bypass attempt investigation.",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 12 },
      "targets": [{
        "expr": "sum(rate(oya_ops_control_center_step_up_auth_failures_total[5m])) by (step_up_class)",
        "legendFormat": "{{ step_up_class }}"
      }]
    },
    {
      "id": 8,
      "type": "table",
      "title": "Recent Admin Actions (last 50)",
      "description": "All recent admin actions with Cedar verdict, sealed status, and operator ID.",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "targets": [{
        "expr": "topk(50, oya_ops_control_center_admin_action_total) by (action, bc, status, sealed)",
        "legendFormat": "{{ action }} / {{ bc }} / {{ status }}"
      }]
    }
  ]
}
