{
  "__inputs": [{ "name": "DS_PROMETHEUS", "type": "datasource", "pluginId": "prometheus" }],
  "__requires": [{ "type": "grafana", "id": "grafana", "name": "Grafana", "version": "12.0.0" }],
  "title": "Ops Dashboard — Admin Action Audit Stream",
  "uid": "oya-ops-audit-stream-v1",
  "description": "Real-time admin action audit stream: every mutation, Cedar verdict, step-up auth event, scope violation, and audit-chain seal status. Primary surface for SOC 2 CC6.2 + ISO 27001 A.9.4 evidence. Keyboard: G→A. Hyperscaler precedent: AWS CloudTrail real-time stream, Stripe audit log dashboard.",
  "tags": ["ops", "audit", "cedar", "compliance", "soc2", "internal"],
  "timezone": "browser",
  "editable": false,
  "schemaVersion": 40,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Admin Actions (last 1h)",
      "gridPos": { "h": 3, "w": 4, "x": 0, "y": 0 },
      "targets": [{
        "expr": "sum(increase(oya_ops_control_center_admin_action_total[1h]))",
        "legendFormat": "Total Actions"
      }]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Cedar DENY Rate",
      "description": "Cedar DENY verdicts / total evaluations. Non-zero = policy working; high rate = investigate.",
      "gridPos": { "h": 3, "w": 4, "x": 4, "y": 0 },
      "targets": [{
        "expr": "sum(rate(oya_ops_control_center_admin_action_total{status=\"DENIED\"}[5m])) / sum(rate(oya_ops_control_center_admin_action_total[5m]))",
        "legendFormat": "DENY Rate"
      }],
      "fieldConfig": { "defaults": { "unit": "percentunit" } }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Audit Seal Failures",
      "description": "Count of actions where audit seal FAILED. Any non-zero is SEV1.",
      "gridPos": { "h": 3, "w": 4, "x": 8, "y": 0 },
      "targets": [{
        "expr": "sum(increase(oya_ops_control_center_audit_emission_failures_total[1h]))",
        "legendFormat": "Seal Failures"
      }],
      "fieldConfig": {
        "defaults": {
          "thresholds": { "steps": [
            { "color": "green", "value": 0 },
            { "color": "red", "value": 1 }
          ]}
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Admin Action Rate by Type",
      "description": "Breakdown by action class and BC. Spikes in T3 actions warrant investigation.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 3 },
      "targets": [{
        "expr": "sum(rate(oya_ops_control_center_admin_action_total[5m])) by (action, bc)",
        "legendFormat": "{{ action }} / {{ bc }}"
      }]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Cedar Verdict Distribution",
      "description": "PERMIT vs DENY rate over time. DENY spike = policy conflict or attack attempt.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 3 },
      "targets": [
        {
          "expr": "sum(rate(oya_ops_control_center_admin_action_total{status=\"PERMITTED\"}[5m]))",
          "legendFormat": "PERMITTED"
        },
        {
          "expr": "sum(rate(oya_ops_control_center_admin_action_total{status=\"DENIED\"}[5m]))",
          "legendFormat": "DENIED"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Step-Up Auth Events",
      "description": "Challenge issued, completed, failed per step-up class.",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 11 },
      "targets": [
        {
          "expr": "sum(rate(oya_ops_control_center_step_up_auth_challenges_issued_total[5m])) by (step_up_class)",
          "legendFormat": "Issued / {{ step_up_class }}"
        },
        {
          "expr": "sum(rate(oya_ops_control_center_step_up_auth_completions_total[5m])) by (step_up_class)",
          "legendFormat": "Completed / {{ step_up_class }}"
        },
        {
          "expr": "sum(rate(oya_ops_control_center_step_up_auth_failures_total[5m])) by (step_up_class)",
          "legendFormat": "Failed / {{ step_up_class }}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "UEBA Insider-Risk Score (Top 10 Operators)",
      "description": "Per-operator UEBA anomaly score. Score > 80 triggers AdminMfaCascade runbook.",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 11 },
      "targets": [{
        "expr": "topk(10, oya_ops_control_center_ueba_anomaly_score) by (operator_id)",
        "legendFormat": "{{ operator_id }}"
      }],
      "fieldConfig": {
        "defaults": {
          "thresholds": { "steps": [
            { "color": "green", "value": 0 },
            { "color": "yellow", "value": 60 },
            { "color": "red", "value": 80 }
          ]}
        }
      }
    }
  ]
}
