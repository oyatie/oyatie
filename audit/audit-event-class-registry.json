{
  "schema_version": "1.0",
  "registry_id": "audit-chain-local-event-class-registry",
  "microservice": "audit-chain",
  "status": "published",
  "date": "2026-05-20",
  "root_binding_adr": "ADR-0263",
  "canonical_sources": [
    "/specs/audit-chain-merkle-ed25519.json",
    "microservices/audit-chain/PRD.md",
    "audit/contracts/asyncapi/audit-events.yaml",
    "microservices/audit-chain/policy/seal-integrity.md",
    "microservices/audit-chain/decisions/ADR-AUD-001-per-cell-authoritative-audit-chain-roots.md"
  ],
  "notes": [
    "ADR-0263 remains the root cross-microservice emission contract.",
    "This local registry registers audit-chain-owned event classes and examples that this µservice emits or documents.",
    "Generic type names such as EventClass are schema identifiers, not event classes."
  ],
  "classes": [
    {
      "event_class": "AuditEmitted",
      "namespace": "audit-chain.workflow",
      "owner_bc": "emission",
      "source": "contracts/asyncapi/audit-events.yaml",
      "purpose": "Durable audit event receipt assigned event_id and period_id."
    },
    {
      "event_class": "SealMinted",
      "namespace": "audit-chain.workflow",
      "owner_bc": "sealing",
      "source": "contracts/asyncapi/audit-events.yaml",
      "purpose": "Merkle root signed and published for a pack/tenant_partition/period."
    },
    {
      "event_class": "VerificationFailed",
      "namespace": "audit-chain.workflow",
      "owner_bc": "verification",
      "source": "contracts/asyncapi/audit-events.yaml",
      "purpose": "Verification request returned verified=false or detected tamper-suspect proof material."
    },
    {
      "event_class": "RetentionApplied",
      "namespace": "audit-chain.workflow",
      "owner_bc": "retention-cascade",
      "source": "contracts/asyncapi/audit-events.yaml",
      "purpose": "Retention cascade or DSR redaction applied while preserving proof continuity."
    },
    {
      "event_class": "KeyRotated",
      "namespace": "audit-chain.workflow",
      "owner_bc": "sealing",
      "source": "contracts/asyncapi/audit-events.yaml",
      "purpose": "HSM signing key rotated and overlap window recorded."
    },
    {
      "event_class": "BundleExported",
      "namespace": "audit-chain.export",
      "owner_bc": "query",
      "source": "policy/data-residency.md",
      "purpose": "Regulator or tenant export bundle generated and sealed."
    },
    {
      "event_class": "audit_chain.regulator_export.emitted",
      "namespace": "audit-chain.export",
      "owner_bc": "query",
      "source": "faqs/compliance-officer-faq.md",
      "purpose": "Regulator export operation emitted into the chain for traceability."
    },
    {
      "event_class": "audit_chain.evidence_filed",
      "namespace": "audit-chain.export",
      "owner_bc": "query",
      "source": "tutorials/regulator-evidence-export.md",
      "purpose": "Governance evidence filing for an exported audit-chain bundle."
    },
    {
      "event_class": "audit_chain.emit_drift_detected",
      "namespace": "audit-chain.reconciliation",
      "owner_bc": "emission",
      "source": "migration-playbooks/from-splunk-audit.md",
      "purpose": "Dual-emit reconciliation detected source count drift."
    },
    {
      "event_class": "audit_chain.chain_fork_detected",
      "namespace": "audit-chain.integrity",
      "owner_bc": "verification",
      "source": "runbooks/merkle-root-discrepancy-investigation.md",
      "purpose": "Published root or chain head indicates a fork condition."
    },
    {
      "event_class": "hsm_sign_called",
      "namespace": "audit-chain.hsm",
      "owner_bc": "sealing",
      "source": "faqs/compliance-officer-faq.md",
      "purpose": "HSM signing operation audit-of-signing signal."
    },
    {
      "event_class": "iam.role.assigned",
      "namespace": "external-example",
      "owner_bc": "emission",
      "source": "tutorials/regulator-evidence-export.md",
      "purpose": "External IAM event class accepted as audit-chain payload; root-owning µservice remains IAM."
    },
    {
      "event_class": "marketplace.transaction.settled",
      "namespace": "external-example",
      "owner_bc": "emission",
      "source": "faqs/compliance-officer-faq.md",
      "purpose": "External marketplace event class used to document the dual-tenant seal pattern."
    },
    {
      "event_class": "tenant_class_downgrade",
      "namespace": "audit-chain.tenant_class",
      "owner_bc": "sealing",
      "source": "ADR-0329 + ADR-0330 + ADR-0331 tenant_class model",
      "purpose": "tenant_class downgrade recorded without reducing WORM retention."
    },
