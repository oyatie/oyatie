{
  "$schema": "https://schemas.grafana.com/dashboard.json",
  "_meta": {
    "doc_class": "GrafanaDashboard",
    "microservice": "audit-chain",
    "owner_team": "axis-audit-chain + ops-sre-reliability",
    "audience": "operators (cross-tenant; admin RBAC)",
    "tenant_scoped": false,
    "datasource": "Mimir self + aggregate"
  },
  "uid": "audit-chain-seal-latency",
  "title": "Seal Latency + Cross-Channel Publication",
  "tags": ["audit-chain", "sealing", "operator"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "templating": {
    "list": [
      {
        "name": "pack",
        "type": "custom",
        "options": [
          {"text": "pack-kr", "value": "pack-kr", "selected": true},
          {"text": "pack-eu", "value": "pack-eu"},
          {"text": "pack-us", "value": "pack-us"},
          {"text": "pack-us-healthcare", "value": "pack-us-healthcare"},
          {"text": "pack-jp", "value": "pack-jp"},
          {"text": "pack-sg", "value": "pack-sg"},
          {"text": "pack-au", "value": "pack-au"},
          {"text": "pack-in", "value": "pack-in"},
          {"text": "pack-br", "value": "pack-br"},
          {"text": "pack-ae", "value": "pack-ae"},
          {"text": "pack-ksa", "value": "pack-ksa"}
        ],
        "label": "Pack"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Seal latency p99",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "targets": [
        {"expr": "histogram_quantile(0.99, sum by (le) (rate(audit_chain_seal_duration_seconds_bucket{pack=\"$pack\"}[5m])))", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 0.5}, {"color": "red", "value": 1}]}}}
    },
    {
      "id": 2,
      "type": "stat",
      "title": "HSM signing-call rate",
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
      "targets": [
        {"expr": "rate(audit_chain_hsm_sign_total{pack=\"$pack\"}[5m])", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "ops"}}
    },
    {
      "id": 3,
      "type": "stat",
      "title": "HSM partition health",
      "gridPos": {"x": 0, "y": 4, "w": 6, "h": 4},
      "targets": [
        {"expr": "audit_chain_hsm_avail{pack=\"$pack\"}", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}, "1": {"text": "UP", "color": "green"}}}]}}
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Active signing key fingerprint",
      "gridPos": {"x": 6, "y": 4, "w": 6, "h": 4},
      "targets": [
        {"expr": "audit_chain_active_signing_key_fingerprint{pack=\"$pack\"}", "refId": "A"}
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Cross-channel root publication match rate",
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
      "targets": [
        {"expr": "oya:audit_chain_root_cross_channel_match:rate{pack=\"$pack\"}", "refId": "A"}
      ],
      "alert": {
        "name": "cross-channel-divergence-sev1",
        "conditions": [{"evaluator": {"params": [1.0], "type": "lt"}, "query": {"params": ["A", "1m", "now"]}, "type": "query"}],
        "notifications": [{"uid": "grafana-oncall-sev1"}]
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Root publication lag per channel (seconds)",
      "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8},
      "targets": [
        {"expr": "audit_chain_root_publication_lag_seconds{pack=\"$pack\", channel=\"s3\"}", "legendFormat": "s3", "refId": "A"},
        {"expr": "audit_chain_root_publication_lag_seconds{pack=\"$pack\", channel=\"mimir\"}", "legendFormat": "mimir", "refId": "B"},
        {"expr": "audit_chain_root_publication_lag_seconds{pack=\"$pack\", channel=\"github\"}", "legendFormat": "github", "refId": "C"}
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Periods sealed (per second)",
      "gridPos": {"x": 0, "y": 24, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum by (tenant_partition) (rate(audit_chain_seal_minted_total{pack=\"$pack\"}[1m]))", "legendFormat": "{{tenant_partition}}", "refId": "A"}
      ]
    }
  ]
}
