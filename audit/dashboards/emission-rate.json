{
  "$schema": "https://schemas.grafana.com/dashboard.json",
  "_meta": {
    "doc_class": "GrafanaDashboard",
    "microservice": "audit-chain",
    "owner_team": "ops-sre-reliability + axis-audit-chain",
    "audience": "internal operators (cross-tenant view; admin-only RBAC + Cedar)",
    "tenant_scoped": false,
    "datasource": "Mimir (self + aggregate); audit-chain self-SLI series"
  },
  "uid": "audit-chain-emission-rate",
  "title": "Audit-Chain Emission Rate",
  "tags": ["audit-chain", "emission", "operator"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "templating": {
    "list": [
      {
        "name": "pack",
        "type": "custom",
        "options": [
          {"text": "pack-kr", "value": "pack-kr", "selected": true},
          {"text": "pack-eu", "value": "pack-eu"},
          {"text": "pack-us", "value": "pack-us"},
          {"text": "pack-us-healthcare", "value": "pack-us-healthcare"},
          {"text": "pack-jp", "value": "pack-jp"},
          {"text": "pack-sg", "value": "pack-sg"},
          {"text": "pack-au", "value": "pack-au"},
          {"text": "pack-in", "value": "pack-in"},
          {"text": "pack-br", "value": "pack-br"},
          {"text": "pack-ae", "value": "pack-ae"},
          {"text": "pack-ksa", "value": "pack-ksa"}
        ],
        "label": "Pack"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Total events/sec (pack-wide)",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "sum by (source_microservice) (rate(audit_chain_emitted_total{pack=\"$pack\"}[1m]))",
          "legendFormat": "{{source_microservice}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Emission p99 latency",
      "gridPos": {"x": 0, "y": 8, "w": 6, "h": 4},
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(audit_chain_emit_duration_seconds_bucket{pack=\"$pack\"}[5m])))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 0.05}, {"color": "red", "value": 0.1}]}
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Rejection rate (rate-limit + spoofing + size + cross-pack)",
      "gridPos": {"x": 6, "y": 8, "w": 6, "h": 4},
      "targets": [
        {"expr": "rate(audit_chain_rate_limit_429_total{pack=\"$pack\"}[5m])", "legendFormat": "429", "refId": "A"},
        {"expr": "rate(audit_chain_tenant_spoofing_attempt_total{pack=\"$pack\"}[5m])", "legendFormat": "spoofing", "refId": "B"},
        {"expr": "rate(audit_chain_cross_pack_emission_rejected_total{pack=\"$pack\"}[5m])", "legendFormat": "cross-pack", "refId": "C"}
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Per-tenant top-10 emission rate",
      "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "topk(10, sum by (tenant_partition) (rate(audit_chain_emitted_total{pack=\"$pack\"}[5m])))",
          "legendFormat": "{{tenant_partition}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Per-event-class distribution",
      "gridPos": {"x": 0, "y": 20, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "sum by (event_class) (rate(audit_chain_emitted_total{pack=\"$pack\"}[5m]))",
          "legendFormat": "{{event_class}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Unsealed buffer depth (seconds)",
      "gridPos": {"x": 0, "y": 28, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "audit_chain_unsealed_buffer_depth_seconds{pack=\"$pack\"}",
          "legendFormat": "{{tenant_partition}}",
          "refId": "A"
        }
      ],
      "alert": {
        "name": "unsealed-buffer-depth-high",
        "conditions": [{"evaluator": {"params": [60], "type": "gt"}, "query": {"params": ["A", "5m", "now"]}, "type": "query"}],
        "notifications": [{"uid": "grafana-oncall"}]
      }
    }
  ]
}
