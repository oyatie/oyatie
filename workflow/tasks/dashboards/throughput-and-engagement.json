{
  "$schema": "https://schemas.grafana.com/dashboard.json",
  "_meta": {
    "doc_class": "GrafanaDashboard",
    "microservice": "tasks",
    "owner_team": "axis-tasks + ops-sre-reliability",
    "audience": "tenant operator + axis-tasks SRE",
    "tenant_scoped": true,
    "datasource": "per-pack Mimir; tenant-scoped via X-Scope-OrgID"
  },
  "uid": "tasks-throughput-engagement",
  "title": "tasks: throughput + engagement (per-tenant + per-pack)",
  "tags": ["tasks", "throughput", "engagement", "burn-rate"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "templating": {
    "list": [
      {"name": "pack", "type": "custom", "label": "Pack",
        "options": [
          {"text": "pack-kr", "value": "kr", "selected": true},
          {"text": "pack-eu", "value": "eu"},
          {"text": "pack-us", "value": "us"},
          {"text": "pack-us-healthcare", "value": "us-hc"},
          {"text": "pack-jp", "value": "jp"},
          {"text": "pack-sg", "value": "sg"},
          {"text": "pack-au", "value": "au"},
          {"text": "pack-in", "value": "in"},
          {"text": "pack-br", "value": "br"},
          {"text": "pack-ae", "value": "ae"},
          {"text": "pack-ksa", "value": "ksa"}
        ]},
      {"name": "tenant", "type": "query", "label": "Tenant",
        "query": "label_values(oya_tasks_task_create_total{pack=\"$pack\"}, tenant_id)"}
    ]
  },
  "panels": [
    {"id": 1, "type": "stat", "title": "Task creates/sec",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "sum(rate(oya_tasks_task_create_total{pack=\"$pack\",tenant_id=\"$tenant\"}[5m]))", "refId": "A"}]},

    {"id": 2, "type": "stat", "title": "Task updates/sec",
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "sum(rate(oya_tasks_task_update_total{pack=\"$pack\",tenant_id=\"$tenant\"}[5m]))", "refId": "A"}]},

    {"id": 3, "type": "stat", "title": "Task create p95 (s)",
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(oya_tasks_task_create_seconds_bucket{pack=\"$pack\",tenant_id=\"$tenant\"}[5m])))", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"mode": "absolute", "steps": [{"value": null, "color": "green"}, {"value": 0.08, "color": "yellow"}, {"value": 0.15, "color": "red"}]}}}},

    {"id": 4, "type": "stat", "title": "Task update p99 (s)",
      "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "histogram_quantile(0.99, sum by (le) (rate(oya_tasks_task_update_seconds_bucket{pack=\"$pack\",tenant_id=\"$tenant\"}[5m])))", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"mode": "absolute", "steps": [{"value": null, "color": "green"}, {"value": 0.05, "color": "yellow"}, {"value": 0.12, "color": "red"}]}}}},

    {"id": 5, "type": "timeseries", "title": "Task lifecycle (created / updated / state-changed / completed)",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum(rate(oya_tasks_task_create_total{pack=\"$pack\",tenant_id=\"$tenant\"}[5m]))", "legendFormat": "created", "refId": "A"},
        {"expr": "sum(rate(oya_tasks_task_update_total{pack=\"$pack\",tenant_id=\"$tenant\"}[5m]))", "legendFormat": "updated", "refId": "B"},
        {"expr": "sum(rate(oya_tasks_task_state_changed_total{pack=\"$pack\",tenant_id=\"$tenant\"}[5m]))", "legendFormat": "state-changed", "refId": "C"},
        {"expr": "sum(rate(oya_tasks_task_completed_total{pack=\"$pack\",tenant_id=\"$tenant\"}[5m]))", "legendFormat": "completed", "refId": "D"}
      ]},

    {"id": 6, "type": "timeseries", "title": "Webhook fanout (fires + retries + circuit-breaker-opens)",
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum(rate(oya_tasks_webhook_fire_total{pack=\"$pack\",tenant_id=\"$tenant\"}[5m]))", "legendFormat": "fires", "refId": "A"},
        {"expr": "sum(rate(oya_tasks_webhook_retry_total{pack=\"$pack\",tenant_id=\"$tenant\"}[5m]))", "legendFormat": "retries", "refId": "B"},
        {"expr": "sum(rate(oya_tasks_webhook_circuit_breaker_open_total{pack=\"$pack\",tenant_id=\"$tenant\"}[5m]))", "legendFormat": "circuit-opens", "refId": "C"}
      ]},

    {"id": 7, "type": "timeseries", "title": "Recurring-task materialisation (in-flight + p99)",
      "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum(rate(oya_tasks_recurrence_materialise_total{pack=\"$pack\",tenant_id=\"$tenant\"}[5m]))", "legendFormat": "materialised", "refId": "A"},
        {"expr": "histogram_quantile(0.99, sum by (le) (rate(oya_tasks_recurrence_materialise_seconds_bucket{pack=\"$pack\",tenant_id=\"$tenant\"}[5m])))", "legendFormat": "p99 (s)", "refId": "B"}
      ]},

    {"id": 8, "type": "timeseries", "title": "Bulk-edit ops (sizes + duration p95)",
      "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum by (batch_size) (rate(oya_tasks_bulk_update_total{pack=\"$pack\",tenant_id=\"$tenant\"}[5m]))", "legendFormat": "ops (batch_size={{batch_size}})", "refId": "A"},
        {"expr": "histogram_quantile(0.95, sum by (le, batch_size) (rate(oya_tasks_bulk_update_seconds_bucket{pack=\"$pack\",tenant_id=\"$tenant\"}[5m])))", "legendFormat": "p95 (batch_size={{batch_size}})", "refId": "B"}
      ]},

    {"id": 9, "type": "table", "title": "Top-10 tenants by task-creation QPS (last 1h)",
      "gridPos": {"x": 0, "y": 20, "w": 24, "h": 8},
      "targets": [
        {"expr": "topk(10, sum by (tenant_id) (rate(oya_tasks_task_create_total{pack=\"$pack\"}[1h])))", "format": "table", "refId": "A"}
      ]}
  ],
  "annotations": {
    "list": [
      {"name": "rollouts", "datasource": "argo-rollouts", "iconColor": "blue", "query": "{microservice=\"tasks\"}"},
      {"name": "policy-changes", "datasource": "prometheus", "iconColor": "purple", "expr": "changes(oya_tasks_policy_version[1h]) > 0"}
    ]
  }
}
