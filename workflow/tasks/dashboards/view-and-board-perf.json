{
  "$schema": "https://schemas.grafana.com/dashboard.json",
  "_meta": {
    "doc_class": "GrafanaDashboard",
    "microservice": "tasks",
    "owner_team": "axis-tasks + ops-sre-reliability",
    "audience": "tenant operator + axis-tasks SRE",
    "tenant_scoped": true,
    "datasource": "per-pack Mimir; tenant-scoped via X-Scope-OrgID"
  },
  "uid": "tasks-view-board-perf",
  "title": "tasks: view + board performance (list / board / gantt / calendar / timeline / table)",
  "tags": ["tasks", "view", "board", "dnd", "perf"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "templating": {
    "list": [
      {"name": "pack", "type": "custom", "label": "Pack",
        "options": [
          {"text": "pack-kr", "value": "kr", "selected": true},
          {"text": "pack-eu", "value": "eu"},
          {"text": "pack-us", "value": "us"}
        ]},
      {"name": "tenant", "type": "query", "label": "Tenant",
        "query": "label_values(oya_tasks_view_render_total{pack=\"$pack\"}, tenant_id)"},
      {"name": "view_kind", "type": "custom", "label": "View",
        "options": [
          {"text": "list", "value": "list", "selected": true},
          {"text": "board", "value": "board"},
          {"text": "gantt", "value": "gantt"},
          {"text": "calendar", "value": "calendar"},
          {"text": "timeline", "value": "timeline"},
          {"text": "table", "value": "table"}
        ]}
    ]
  },
  "panels": [
    {"id": 1, "type": "stat", "title": "View renders/sec",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "sum(rate(oya_tasks_view_render_total{pack=\"$pack\",tenant_id=\"$tenant\",view_kind=\"$view_kind\"}[5m]))", "refId": "A"}]},

    {"id": 2, "type": "stat", "title": "Task-list render p95 (s)",
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(oya_tasks_task_list_render_seconds_bucket{pack=\"$pack\",tenant_id=\"$tenant\",tasks_in_list=\"200\"}[5m])))", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"mode": "absolute", "steps": [{"value": null, "color": "green"}, {"value": 0.2, "color": "yellow"}, {"value": 0.5, "color": "red"}]}}}},

    {"id": 3, "type": "stat", "title": "Board DnD presence sessions",
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "sum(oya_tasks_board_dnd_active_sessions{pack=\"$pack\",tenant_id=\"$tenant\"})", "refId": "A"}]},

    {"id": 4, "type": "stat", "title": "Valkey view-cache hit ratio",
      "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "sum(rate(oya_tasks_view_cache_hit_total{pack=\"$pack\",tenant_id=\"$tenant\"}[5m])) / sum(rate(oya_tasks_view_render_total{pack=\"$pack\",tenant_id=\"$tenant\"}[5m]))", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "thresholds": {"mode": "absolute", "steps": [{"value": null, "color": "red"}, {"value": 0.6, "color": "yellow"}, {"value": 0.8, "color": "green"}]}}}},

    {"id": 5, "type": "timeseries", "title": "Per-view-kind render p50/p95/p99",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum by (le, view_kind) (rate(oya_tasks_view_render_seconds_bucket{pack=\"$pack\",tenant_id=\"$tenant\"}[5m])))", "legendFormat": "p50 {{view_kind}}", "refId": "A"},
        {"expr": "histogram_quantile(0.95, sum by (le, view_kind) (rate(oya_tasks_view_render_seconds_bucket{pack=\"$pack\",tenant_id=\"$tenant\"}[5m])))", "legendFormat": "p95 {{view_kind}}", "refId": "B"},
        {"expr": "histogram_quantile(0.99, sum by (le, view_kind) (rate(oya_tasks_view_render_seconds_bucket{pack=\"$pack\",tenant_id=\"$tenant\"}[5m])))", "legendFormat": "p99 {{view_kind}}", "refId": "C"}
      ]},

    {"id": 6, "type": "timeseries", "title": "Board DnD commit latency (client p95 perceived)",
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
      "targets": [
        {"expr": "histogram_quantile(0.95, sum by (le) (rate(oya_tasks_board_dnd_commit_seconds_bucket{pack=\"$pack\",tenant_id=\"$tenant\"}[5m])))", "legendFormat": "p95", "refId": "A"},
        {"expr": "histogram_quantile(0.99, sum by (le) (rate(oya_tasks_board_dnd_commit_seconds_bucket{pack=\"$pack\",tenant_id=\"$tenant\"}[5m])))", "legendFormat": "p99", "refId": "B"}
      ]},

    {"id": 7, "type": "timeseries", "title": "Search query p95 + Meilisearch cluster health",
      "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
      "targets": [
        {"expr": "histogram_quantile(0.95, sum by (le) (rate(oya_tasks_search_query_seconds_bucket{pack=\"$pack\",tenant_id=\"$tenant\"}[5m])))", "legendFormat": "search p95", "refId": "A"},
        {"expr": "sum(rate(oya_tasks_search_degraded_mode_active{pack=\"$pack\"}[5m]))", "legendFormat": "degraded-mode active", "refId": "B"}
      ]},

    {"id": 8, "type": "timeseries", "title": "Dependency-cycle-detection p99 (must stay < 50ms)",
      "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8},
      "targets": [
        {"expr": "histogram_quantile(0.99, sum by (le) (rate(oya_tasks_dependency_cycle_check_seconds_bucket{pack=\"$pack\",tenant_id=\"$tenant\"}[5m])))", "legendFormat": "p99", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"mode": "absolute", "steps": [{"value": null, "color": "green"}, {"value": 0.05, "color": "red"}]}}}}
  ],
  "annotations": {
    "list": [
      {"name": "rollouts", "datasource": "argo-rollouts", "iconColor": "blue", "query": "{microservice=\"tasks\"}"},
      {"name": "search-index-rebuild", "datasource": "prometheus", "iconColor": "orange", "expr": "changes(oya_tasks_search_index_rebuild_total[1h]) > 0"}
    ]
  }
}
