{
  "$schema": "https://schemas.grafana.com/dashboard.json",
  "_meta": {
    "doc_class": "GrafanaDashboard",
    "microservice": "forms",
    "owner_team": "axis-forms + ops-security + ops-sre-reliability + council-design-system",
    "audience": "internal operators + axis-forms + ops-security",
    "tenant_scoped": false,
    "datasource": "Mimir aggregate (oya-forms tenant)"
  },
  "uid": "forms-embed-and-distribution",
  "title": "oyatie Forms — Embed CSP + Bulk distribution",
  "tags": ["forms", "embed", "csp", "bulk-distribute"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "60s",
  "time": {"from": "now-24h", "to": "now"},
  "templating": {
    "list": [
      {
        "name": "pack",
        "type": "custom",
        "options": [
          {"text": "pack-kr", "value": "kr", "selected": true},
          {"text": "pack-eu", "value": "eu"},
          {"text": "pack-us", "value": "us"},
          {"text": "pack-us-healthcare", "value": "us-hc"},
          {"text": "pack-jp", "value": "jp"},
          {"text": "pack-sg", "value": "sg"},
          {"text": "pack-au", "value": "au"},
          {"text": "pack-in", "value": "in"},
          {"text": "pack-br", "value": "br"},
          {"text": "pack-ae", "value": "ae"},
          {"text": "pack-ksa", "value": "ksa"}
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Form render p95 (CDN TTI) (target ≤ 200ms GA)",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "targets": [
        {"expr": "histogram_quantile(0.95, sum by (le) (rate(oya_forms_render_tti_seconds_bucket{pack=\"$pack\"}[5m])))", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 0.15}, {"color": "red", "value": 0.20}]}}}
    },
    {
      "id": 2,
      "type": "stat",
      "title": "CSP violations rate (cluster)",
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
      "targets": [
        {"expr": "sum(rate(oya_forms_embed_csp_violation_total{pack=\"$pack\"}[1h]))", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 0.5}, {"color": "red", "value": 5}]}}}
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Trusted Types violations (MUST be 0)",
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
      "targets": [
        {"expr": "sum(rate(oya_forms_iframe_xss_attempt_total{pack=\"$pack\"}[24h]))", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "red", "value": 1}]}}}
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Bulk-distribute p95 latency (target ≤ 30s for 10k recipients)",
      "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
      "targets": [
        {"expr": "histogram_quantile(0.95, sum by (le) (rate(oya_forms_bulk_distribute_duration_seconds_bucket{pack=\"$pack\"}[1h])))", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 25}, {"color": "red", "value": 30}]}}}
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Embed renders by parent origin (top-20)",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "targets": [
        {"expr": "topk(20, sum by (parent_origin) (rate(oya_forms_embed_render_total{pack=\"$pack\"}[5m])))", "legendFormat": "{{parent_origin}}", "refId": "A"}
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "CSP violations by directive",
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum by (violated_directive) (rate(oya_forms_embed_csp_violation_total{pack=\"$pack\"}[5m]))", "legendFormat": "{{violated_directive}}", "refId": "A"}
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Bulk-distribute throughput (recipients/sec by tenant top-10)",
      "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
      "targets": [
        {"expr": "topk(10, sum by (tenant_id) (rate(oya_forms_bulk_distribute_recipient_total{pack=\"$pack\"}[5m])))", "legendFormat": "{{tenant_id}}", "refId": "A"}
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Bulk-distribute success vs failure by channel",
      "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum by (channel, outcome) (rate(oya_forms_bulk_distribute_recipient_total{pack=\"$pack\"}[5m]))", "legendFormat": "{{channel}}-{{outcome}}", "refId": "A"}
      ]
    },
    {
      "id": 9,
      "type": "table",
      "title": "Per-tenant active embed allow-list (last update)",
      "gridPos": {"x": 0, "y": 20, "w": 12, "h": 8},
      "targets": [
        {"expr": "oya_forms_embed_allow_list_size{pack=\"$pack\"}", "format": "table", "refId": "A"},
        {"expr": "oya_forms_embed_allow_list_last_update_timestamp{pack=\"$pack\"}", "format": "table", "refId": "B"}
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Form render p99 by pack-edge",
      "gridPos": {"x": 12, "y": 20, "w": 12, "h": 8},
      "targets": [
        {"expr": "histogram_quantile(0.99, sum by (le, cdn_edge) (rate(oya_forms_render_tti_seconds_bucket{pack=\"$pack\"}[5m])))", "legendFormat": "{{cdn_edge}} p99", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "s"}}
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Unsubscribe honour rate (target ≥ 99.9%)",
      "gridPos": {"x": 0, "y": 28, "w": 12, "h": 4},
      "targets": [
        {"expr": "sum(rate(oya_forms_unsubscribe_honoured_total{pack=\"$pack\"}[24h])) / sum(rate(oya_forms_unsubscribe_request_total{pack=\"$pack\"}[24h]))", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "percentunit", "thresholds": {"steps": [{"color": "red", "value": 0}, {"color": "yellow", "value": 0.99}, {"color": "green", "value": 0.999}]}}}
    },
    {
      "id": 12,
      "type": "stat",
      "title": "WCAG 2.2 AA conformance rate (publish-gate pass rate)",
      "gridPos": {"x": 12, "y": 28, "w": 12, "h": 4},
      "targets": [
        {"expr": "sum(rate(oya_forms_publish_wcag_pass_total{pack=\"$pack\"}[24h])) / sum(rate(oya_forms_publish_attempt_total{pack=\"$pack\"}[24h]))", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "percentunit", "thresholds": {"steps": [{"color": "red", "value": 0}, {"color": "yellow", "value": 0.95}, {"color": "green", "value": 1.0}]}}}
    }
  ]
}
