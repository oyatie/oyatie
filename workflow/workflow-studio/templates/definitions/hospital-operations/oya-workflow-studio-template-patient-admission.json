{
  "template_id": "oya-workflow-studio-template-patient-admission",
  "schema_version": "1.0.0",
  "name": "Patient admission -> EHR -> billing pre-auth",
  "description": "Admit a patient: registration, insurance verification, EHR record creation, billing pre-authorisation.",
  "persona": "hospital-admissions-clerk",
  "vertical": "hospital-operations",
  "node_graph": {
    "entry_node": "trigger-admission-request",
    "terminal_nodes": [
      "t-admission-complete"
    ],
    "nodes": [
      {
        "id": "trigger-admission-request",
        "kind": "trigger",
        "label": "Admission request"
      },
      {
        "id": "policy-admission",
        "kind": "policy-check",
        "label": "Cedar admission + HIPAA scope"
      },
      {
        "id": "verify-insurance",
        "kind": "connector-call",
        "label": "Verify insurance eligibility",
        "connector": "oya-shared-connector-payer-eligibility",
        "operation": "verify_eligibility"
      },
      {
        "id": "ehr-register",
        "kind": "connector-call",
        "label": "Create EHR record",
        "connector": "oya-shared-connector-ehr",
        "operation": "create_patient_encounter"
      },
      {
        "id": "pre-auth",
        "kind": "connector-call",
        "label": "Submit pre-auth",
        "connector": "oya-shared-connector-payer-claims",
        "operation": "submit_preauth"
      },
      {
        "id": "audit-admit",
        "kind": "audit-emit",
        "label": "Emit admission seal"
      },
      {
        "id": "t-admission-complete",
        "kind": "terminal",
        "label": "Admission complete"
      }
    ],
    "edges": [
      {
        "from": "trigger-admission-request",
        "to": "policy-admission"
      },
      {
        "from": "policy-admission",
        "to": "verify-insurance",
        "condition": "permit"
      },
      {
        "from": "verify-insurance",
        "to": "ehr-register"
      },
      {
        "from": "ehr-register",
        "to": "pre-auth"
      },
      {
        "from": "pre-auth",
        "to": "audit-admit"
      },
      {
        "from": "audit-admit",
        "to": "t-admission-complete"
      }
    ]
  },
  "input_parameters": [
    {
      "name": "patient_mrn",
      "type": "reference",
      "required": true,
      "description": "Patient MRN"
    },
    {
      "name": "encounter_type",
      "type": "enum",
      "required": true,
      "enum_values": [
        "inpatient",
        "outpatient",
        "emergency",
        "observation"
      ],
      "description": "Encounter type"
    },
    {
      "name": "payer_id",
      "type": "reference",
      "required": true,
      "description": "Payer id"
    }
  ],
  "runtime_expectations": {
    "expected_duration_seconds_p50": 900,
    "expected_duration_seconds_p99": 3600
  },
  "compliance_flags": [
    "hipaa",
    "hitech",
    "soc2-type-2"
  ],
  "audit_emission_points": [
    {
      "node_id": "verify-insurance",
      "seal_kind": "external-call-receipt"
    },
    {
      "node_id": "ehr-register",
      "seal_kind": "external-call-receipt"
    },
    {
      "node_id": "pre-auth",
      "seal_kind": "external-call-receipt"
    },
    {
      "node_id": "audit-admit",
      "seal_kind": "decision-recorded"
    }
  ],
  "cedar_policy": {
    "policy_id": "cedar:oya-workflow-studio-template:patient-admission",
    "effect": "permit",
    "principal_scope": "Workflow::Tenant",
    "resource_scope": "PatientEncounter",
    "action_scope": "admit",
    "conditions": [
      "principal.hipaa_role_attested == true"
    ]
  },
  "connector_dependencies": [
    {
      "connector_id": "oya-shared-connector-payer-eligibility",
      "operations": [
        "verify_eligibility"
      ],
      "criticality": "required"
    },
    {
      "connector_id": "oya-shared-connector-ehr",
      "operations": [
        "create_patient_encounter"
      ],
      "criticality": "required"
    },
    {
      "connector_id": "oya-shared-connector-payer-claims",
      "operations": [
        "submit_preauth"
      ],
      "criticality": "required"
    }
  ],
  "slo": {
    "max_duration_seconds": 3600,
    "min_success_rate": 0.995,
    "openslo_ref": "microservices/workflow-studio/slos/oya-workflow-studio-template-patient-admission.openslo.yaml"
  },
  "cost_model": {
    "estimated_usd_per_execution_p50": 1.85,
    "foundry_inference_usd": 0.05,
    "connector_call_usd": 1.6,
    "storage_usd": 0.2
  },
  "test_mode_supported": true,
  "live_mode_supported": true,
  "documentation": {
    "explainer_path": "microservices/workflow-studio/templates/explainers/oya-workflow-studio-template-patient-admission.md",
    "fixture_path": "microservices/workflow-studio/templates/fixtures/oya-workflow-studio-template-patient-admission.fixture.json"
  },
  "tags": [
    "hospital",
    "admission",
    "ehr",
    "hipaa"
  ]
}
