{
  "template_id": "oya-workflow-studio-template-discharge-planning",
  "schema_version": "1.0.0",
  "name": "Discharge planning",
  "description": "Discharge orchestration: transport, follow-up appointment, prescription, home health, family notification.",
  "persona": "hospital-discharge-planner",
  "vertical": "hospital-operations",
  "node_graph": {
    "entry_node": "trigger-discharge-ordered",
    "terminal_nodes": [
      "t-discharge-complete"
    ],
    "nodes": [
      {
        "id": "trigger-discharge-ordered",
        "kind": "trigger",
        "label": "Discharge ordered"
      },
      {
        "id": "policy-discharge",
        "kind": "policy-check",
        "label": "Cedar discharge policy + HIPAA"
      },
      {
        "id": "transport",
        "kind": "connector-call",
        "label": "Arrange transport",
        "connector": "oya-shared-connector-medical-transport",
        "operation": "book_transport"
      },
      {
        "id": "follow-up",
        "kind": "connector-call",
        "label": "Schedule follow-up",
        "connector": "oya-shared-connector-ehr",
        "operation": "schedule_followup"
      },
      {
        "id": "prescription",
        "kind": "connector-call",
        "label": "E-prescribe",
        "connector": "oya-shared-connector-pharmacy",
        "operation": "eprescribe"
      },
      {
        "id": "home-health",
        "kind": "connector-call",
        "label": "Refer home-health",
        "connector": "oya-shared-connector-home-health",
        "operation": "refer_patient"
      },
      {
        "id": "notify-family",
        "kind": "notify",
        "label": "Notify designated family"
      },
      {
        "id": "audit-discharge",
        "kind": "audit-emit",
        "label": "Emit discharge seal"
      },
      {
        "id": "t-discharge-complete",
        "kind": "terminal",
        "label": "Discharge complete"
      }
    ],
    "edges": [
      {
        "from": "trigger-discharge-ordered",
        "to": "policy-discharge"
      },
      {
        "from": "policy-discharge",
        "to": "transport",
        "condition": "permit"
      },
      {
        "from": "transport",
        "to": "follow-up"
      },
      {
        "from": "follow-up",
        "to": "prescription"
      },
      {
        "from": "prescription",
        "to": "home-health"
      },
      {
        "from": "home-health",
        "to": "notify-family"
      },
      {
        "from": "notify-family",
        "to": "audit-discharge"
      },
      {
        "from": "audit-discharge",
        "to": "t-discharge-complete"
      }
    ]
  },
  "input_parameters": [
    {
      "name": "encounter_id",
      "type": "reference",
      "required": true,
      "description": "Encounter id"
    },
    {
      "name": "discharge_disposition",
      "type": "enum",
      "required": true,
      "enum_values": [
        "home",
        "snf",
        "rehab",
        "hospice",
        "expired"
      ],
      "description": "Discharge disposition"
    }
  ],
  "runtime_expectations": {
    "expected_duration_seconds_p50": 7200,
    "expected_duration_seconds_p99": 21600
  },
  "compliance_flags": [
    "hipaa",
    "hitech",
    "soc2-type-2"
  ],
  "audit_emission_points": [
    {
      "node_id": "prescription",
      "seal_kind": "external-call-receipt"
    },
    {
      "node_id": "home-health",
      "seal_kind": "external-call-receipt"
    },
    {
      "node_id": "audit-discharge",
      "seal_kind": "decision-recorded"
    }
  ],
  "cedar_policy": {
    "policy_id": "cedar:oya-workflow-studio-template:discharge-planning",
    "effect": "permit",
    "principal_scope": "Workflow::Tenant",
    "resource_scope": "PatientEncounter",
    "action_scope": "discharge",
    "conditions": [
      "principal.hipaa_role_attested == true"
    ]
  },
  "connector_dependencies": [
    {
      "connector_id": "oya-shared-connector-medical-transport",
      "operations": [
        "book_transport"
      ],
      "criticality": "preferred"
    },
    {
      "connector_id": "oya-shared-connector-ehr",
      "operations": [
        "schedule_followup"
      ],
      "criticality": "required"
    },
    {
      "connector_id": "oya-shared-connector-pharmacy",
      "operations": [
        "eprescribe"
      ],
      "criticality": "required"
    },
    {
      "connector_id": "oya-shared-connector-home-health",
      "operations": [
        "refer_patient"
      ],
      "criticality": "preferred"
    }
  ],
  "slo": {
    "max_duration_seconds": 21600,
    "min_success_rate": 0.995,
    "openslo_ref": "microservices/workflow-studio/slos/oya-workflow-studio-template-discharge-planning.openslo.yaml"
  },
  "cost_model": {
    "estimated_usd_per_execution_p50": 2.4,
    "foundry_inference_usd": 0.1,
    "connector_call_usd": 2.1,
    "storage_usd": 0.2
  },
  "test_mode_supported": true,
  "live_mode_supported": true,
  "documentation": {
    "explainer_path": "microservices/workflow-studio/templates/explainers/oya-workflow-studio-template-discharge-planning.md",
    "fixture_path": "workflow/workflow-studio/templates/fixtures/oya-workflow-studio-template-discharge-planning.fixture.json"
  },
  "tags": [
    "hospital",
    "discharge",
    "ehr",
    "hipaa"
  ]
}
