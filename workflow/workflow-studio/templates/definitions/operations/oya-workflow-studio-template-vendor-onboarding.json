{
  "template_id": "oya-workflow-studio-template-vendor-onboarding",
  "schema_version": "1.0.0",
  "name": "Vendor onboarding (SOC 2 + DPA + MSA + terms)",
  "description": "Onboard a new vendor: SOC 2 attestation collection, DPA signature, MSA negotiation, payment terms registration, vendor master entry.",
  "persona": "procurement-lead",
  "vertical": "operations",
  "node_graph": {
    "entry_node": "trigger-vendor-request",
    "terminal_nodes": [
      "t-vendor-active"
    ],
    "nodes": [
      {
        "id": "trigger-vendor-request",
        "kind": "trigger",
        "label": "Vendor request submitted"
      },
      {
        "id": "policy-vendor",
        "kind": "policy-check",
        "label": "Cedar vendor-onboarding policy"
      },
      {
        "id": "soc2-collect",
        "kind": "connector-call",
        "label": "Collect SOC 2 report",
        "connector": "oya-shared-connector-document-store",
        "operation": "collect_soc2"
      },
      {
        "id": "dpa-sign",
        "kind": "connector-call",
        "label": "DPA e-signature",
        "connector": "oya-shared-connector-esign",
        "operation": "send_for_signature"
      },
      {
        "id": "msa-negotiate",
        "kind": "human-approval",
        "label": "MSA legal negotiation"
      },
      {
        "id": "payment-terms",
        "kind": "connector-call",
        "label": "Register payment terms",
        "connector": "oya-shared-connector-erp",
        "operation": "register_vendor_terms"
      },
      {
        "id": "vendor-master",
        "kind": "connector-call",
        "label": "Create vendor master",
        "connector": "oya-shared-connector-erp",
        "operation": "create_vendor"
      },
      {
        "id": "audit-vendor",
        "kind": "audit-emit",
        "label": "Emit vendor onboarding seal"
      },
      {
        "id": "t-vendor-active",
        "kind": "terminal",
        "label": "Vendor active"
      }
    ],
    "edges": [
      {
        "from": "trigger-vendor-request",
        "to": "policy-vendor"
      },
      {
        "from": "policy-vendor",
        "to": "soc2-collect",
        "condition": "permit"
      },
      {
        "from": "soc2-collect",
        "to": "dpa-sign"
      },
      {
        "from": "dpa-sign",
        "to": "msa-negotiate"
      },
      {
        "from": "msa-negotiate",
        "to": "payment-terms",
        "condition": "approved"
      },
      {
        "from": "payment-terms",
        "to": "vendor-master"
      },
      {
        "from": "vendor-master",
        "to": "audit-vendor"
      },
      {
        "from": "audit-vendor",
        "to": "t-vendor-active"
      }
    ]
  },
  "input_parameters": [
    {
      "name": "vendor_legal_name",
      "type": "string",
      "required": true,
      "description": "Vendor legal name"
    },
    {
      "name": "vendor_taxonomy",
      "type": "string",
      "required": true,
      "description": "Vendor taxonomy code"
    },
    {
      "name": "tax_id",
      "type": "string",
      "required": true,
      "description": "Vendor tax id"
    }
  ],
  "runtime_expectations": {
    "expected_duration_seconds_p50": 604800,
    "expected_duration_seconds_p99": 1814400
  },
  "compliance_flags": [
    "soc2-type-2",
    "gdpr",
    "iso-27001"
  ],
  "audit_emission_points": [
    {
      "node_id": "soc2-collect",
      "seal_kind": "external-call-receipt"
    },
    {
      "node_id": "dpa-sign",
      "seal_kind": "human-approval-signature"
    },
    {
      "node_id": "msa-negotiate",
      "seal_kind": "human-approval-signature"
    },
    {
      "node_id": "audit-vendor",
      "seal_kind": "decision-recorded"
    }
  ],
  "cedar_policy": {
    "policy_id": "cedar:oya-workflow-studio-template:vendor-onboarding",
    "effect": "permit",
    "principal_scope": "Workflow::Tenant",
    "resource_scope": "Vendor",
    "action_scope": "onboard",
    "conditions": []
  },
  "connector_dependencies": [
    {
      "connector_id": "oya-shared-connector-document-store",
      "operations": [
        "collect_soc2"
      ],
      "criticality": "required"
    },
    {
      "connector_id": "oya-shared-connector-esign",
      "operations": [
        "send_for_signature"
      ],
      "criticality": "required"
    },
    {
      "connector_id": "oya-shared-connector-erp",
      "operations": [
        "register_vendor_terms",
        "create_vendor"
      ],
      "criticality": "required"
    }
  ],
  "slo": {
    "max_duration_seconds": 1814400,
    "min_success_rate": 0.99,
    "openslo_ref": "microservices/workflow-studio/slos/oya-workflow-studio-template-vendor-onboarding.openslo.yaml"
  },
  "cost_model": {
    "estimated_usd_per_execution_p50": 4.6,
    "foundry_inference_usd": 0.2,
    "connector_call_usd": 3.8,
    "storage_usd": 0.6
  },
  "test_mode_supported": true,
  "live_mode_supported": true,
  "documentation": {
    "explainer_path": "microservices/workflow-studio/templates/explainers/oya-workflow-studio-template-vendor-onboarding.md",
    "fixture_path": "microservices/workflow-studio/templates/fixtures/oya-workflow-studio-template-vendor-onboarding.fixture.json"
  },
  "tags": [
    "operations",
    "vendor",
    "procurement",
    "soc2"
  ]
}
