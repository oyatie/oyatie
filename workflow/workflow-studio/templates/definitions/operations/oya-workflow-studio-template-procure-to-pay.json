{
  "template_id": "oya-workflow-studio-template-procure-to-pay",
  "schema_version": "1.0.0",
  "name": "Procurement requisition -> PO -> receiving -> invoice match",
  "description": "P2P pipeline: requisition approval, PO emission, receiving, 3-way invoice match, payment release.",
  "persona": "procurement-lead",
  "vertical": "operations",
  "node_graph": {
    "entry_node": "trigger-requisition-submitted",
    "terminal_nodes": [
      "t-paid"
    ],
    "nodes": [
      {
        "id": "trigger-requisition-submitted",
        "kind": "trigger",
        "label": "Requisition submitted"
      },
      {
        "id": "policy-req",
        "kind": "policy-check",
        "label": "Cedar req approval policy + budget envelope"
      },
      {
        "id": "approver",
        "kind": "human-approval",
        "label": "Budget owner approval"
      },
      {
        "id": "emit-po",
        "kind": "connector-call",
        "label": "Emit PO to vendor",
        "connector": "oya-shared-connector-erp",
        "operation": "emit_po"
      },
      {
        "id": "wait-receiving",
        "kind": "wait",
        "label": "Await receiving"
      },
      {
        "id": "receiving-record",
        "kind": "connector-call",
        "label": "Record receiving",
        "connector": "oya-shared-connector-erp",
        "operation": "record_receiving"
      },
      {
        "id": "wait-invoice",
        "kind": "wait",
        "label": "Await invoice"
      },
      {
        "id": "three-way-match",
        "kind": "transform",
        "label": "3-way match"
      },
      {
        "id": "payment",
        "kind": "connector-call",
        "label": "Schedule payment",
        "connector": "oya-shared-connector-banking",
        "operation": "schedule_payment"
      },
      {
        "id": "audit-p2p",
        "kind": "audit-emit",
        "label": "Emit P2P seal"
      },
      {
        "id": "t-paid",
        "kind": "terminal",
        "label": "Paid"
      }
    ],
    "edges": [
      {
        "from": "trigger-requisition-submitted",
        "to": "policy-req"
      },
      {
        "from": "policy-req",
        "to": "approver",
        "condition": "within-budget"
      },
      {
        "from": "approver",
        "to": "emit-po",
        "condition": "approved"
      },
      {
        "from": "emit-po",
        "to": "wait-receiving"
      },
      {
        "from": "wait-receiving",
        "to": "receiving-record"
      },
      {
        "from": "receiving-record",
        "to": "wait-invoice"
      },
      {
        "from": "wait-invoice",
        "to": "three-way-match"
      },
      {
        "from": "three-way-match",
        "to": "payment",
        "condition": "matched"
      },
      {
        "from": "payment",
        "to": "audit-p2p"
      },
      {
        "from": "audit-p2p",
        "to": "t-paid"
      }
    ]
  },
  "input_parameters": [
    {
      "name": "requisition_id",
      "type": "reference",
      "required": true,
      "description": "Requisition id"
    },
    {
      "name": "vendor_id",
      "type": "reference",
      "required": true,
      "description": "Vendor master id"
    },
    {
      "name": "amount_usd",
      "type": "number",
      "required": true,
      "description": "Requisition amount USD"
    }
  ],
  "runtime_expectations": {
    "expected_duration_seconds_p50": 1209600,
    "expected_duration_seconds_p99": 3628800
  },
  "compliance_flags": [
    "soc2-type-2",
    "sox-section-404"
  ],
  "audit_emission_points": [
    {
      "node_id": "approver",
      "seal_kind": "human-approval-signature"
    },
    {
      "node_id": "emit-po",
      "seal_kind": "external-call-receipt"
    },
    {
      "node_id": "payment",
      "seal_kind": "external-call-receipt"
    },
    {
      "node_id": "audit-p2p",
      "seal_kind": "decision-recorded"
    }
  ],
  "cedar_policy": {
    "policy_id": "cedar:oya-workflow-studio-template:procure-to-pay",
    "effect": "permit",
    "principal_scope": "Workflow::Tenant",
    "resource_scope": "Requisition",
    "action_scope": "approve_and_pay",
    "conditions": []
  },
  "connector_dependencies": [
    {
      "connector_id": "oya-shared-connector-erp",
      "operations": [
        "emit_po",
        "record_receiving"
      ],
      "criticality": "required"
    },
    {
      "connector_id": "oya-shared-connector-banking",
      "operations": [
        "schedule_payment"
      ],
      "criticality": "required"
    }
  ],
  "slo": {
    "max_duration_seconds": 3628800,
    "min_success_rate": 0.998,
    "openslo_ref": "microservices/workflow-studio/slos/oya-workflow-studio-template-procure-to-pay.openslo.yaml"
  },
  "cost_model": {
    "estimated_usd_per_execution_p50": 3.6,
    "foundry_inference_usd": 0.2,
    "connector_call_usd": 2.8,
    "storage_usd": 0.6
  },
  "test_mode_supported": true,
  "live_mode_supported": true,
  "documentation": {
    "explainer_path": "microservices/workflow-studio/templates/explainers/oya-workflow-studio-template-procure-to-pay.md",
    "fixture_path": "workflow/workflow-studio/templates/fixtures/oya-workflow-studio-template-procure-to-pay.fixture.json"
  },
  "tags": [
    "operations",
    "procurement",
    "p2p",
    "sox"
  ]
}
