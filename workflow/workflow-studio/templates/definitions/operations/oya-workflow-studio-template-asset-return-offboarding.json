{
  "template_id": "oya-workflow-studio-template-asset-return-offboarding",
  "schema_version": "1.0.0",
  "name": "Asset return on offboarding",
  "description": "Reclaim laptop + peripherals on exit: shipping label, return receipt, wipe + re-image, asset-state update.",
  "persona": "it-asset-admin",
  "vertical": "operations",
  "node_graph": {
    "entry_node": "trigger-exit-notified",
    "terminal_nodes": [
      "t-asset-reclaimed"
    ],
    "nodes": [
      {
        "id": "trigger-exit-notified",
        "kind": "trigger",
        "label": "Exit notified"
      },
      {
        "id": "policy-return",
        "kind": "policy-check",
        "label": "Cedar asset-return policy"
      },
      {
        "id": "ship-label",
        "kind": "connector-call",
        "label": "Issue prepaid shipping label",
        "connector": "oya-shared-connector-shipping",
        "operation": "issue_return_label"
      },
      {
        "id": "freeze-device",
        "kind": "connector-call",
        "label": "Freeze device via MDM",
        "connector": "oya-shared-connector-mdm",
        "operation": "freeze_device"
      },
      {
        "id": "wait-return",
        "kind": "wait",
        "label": "Await return receipt"
      },
      {
        "id": "wipe-reimage",
        "kind": "connector-call",
        "label": "Wipe + re-image",
        "connector": "oya-shared-connector-mdm",
        "operation": "wipe_and_reimage"
      },
      {
        "id": "update-asset",
        "kind": "connector-call",
        "label": "Update asset state",
        "connector": "oya-shared-connector-asset-management",
        "operation": "set_state"
      },
      {
        "id": "audit-return",
        "kind": "audit-emit",
        "label": "Emit asset return seal"
      },
      {
        "id": "t-asset-reclaimed",
        "kind": "terminal",
        "label": "Asset reclaimed"
      }
    ],
    "edges": [
      {
        "from": "trigger-exit-notified",
        "to": "policy-return"
      },
      {
        "from": "policy-return",
        "to": "ship-label",
        "condition": "permit"
      },
      {
        "from": "ship-label",
        "to": "freeze-device"
      },
      {
        "from": "freeze-device",
        "to": "wait-return"
      },
      {
        "from": "wait-return",
        "to": "wipe-reimage"
      },
      {
        "from": "wipe-reimage",
        "to": "update-asset"
      },
      {
        "from": "update-asset",
        "to": "audit-return"
      },
      {
        "from": "audit-return",
        "to": "t-asset-reclaimed"
      }
    ]
  },
  "input_parameters": [
    {
      "name": "employee_id",
      "type": "reference",
      "required": true,
      "description": "Departing employee"
    },
    {
      "name": "asset_ids",
      "type": "string",
      "required": true,
      "description": "Comma-separated asset ids"
    }
  ],
  "runtime_expectations": {
    "expected_duration_seconds_p50": 1209600,
    "expected_duration_seconds_p99": 2419200
  },
  "compliance_flags": [
    "soc2-type-2",
    "gdpr",
    "iso-27001"
  ],
  "audit_emission_points": [
    {
      "node_id": "freeze-device",
      "seal_kind": "external-call-receipt"
    },
    {
      "node_id": "wipe-reimage",
      "seal_kind": "external-call-receipt"
    },
    {
      "node_id": "audit-return",
      "seal_kind": "decision-recorded"
    }
  ],
  "cedar_policy": {
    "policy_id": "cedar:oya-workflow-studio-template:asset-return-offboarding",
    "effect": "permit",
    "principal_scope": "Workflow::Tenant",
    "resource_scope": "Asset",
    "action_scope": "return",
    "conditions": []
  },
  "connector_dependencies": [
    {
      "connector_id": "oya-shared-connector-shipping",
      "operations": [
        "issue_return_label"
      ],
      "criticality": "required"
    },
    {
      "connector_id": "oya-shared-connector-mdm",
      "operations": [
        "freeze_device",
        "wipe_and_reimage"
      ],
      "criticality": "required"
    },
    {
      "connector_id": "oya-shared-connector-asset-management",
      "operations": [
        "set_state"
      ],
      "criticality": "required"
    }
  ],
  "slo": {
    "max_duration_seconds": 2419200,
    "min_success_rate": 0.998,
    "openslo_ref": "microservices/workflow-studio/slos/oya-workflow-studio-template-asset-return-offboarding.openslo.yaml"
  },
  "cost_model": {
    "estimated_usd_per_execution_p50": 8.4,
    "foundry_inference_usd": 0.05,
    "connector_call_usd": 1.8,
    "storage_usd": 0.2
  },
  "test_mode_supported": true,
  "live_mode_supported": true,
  "documentation": {
    "explainer_path": "microservices/workflow-studio/templates/explainers/oya-workflow-studio-template-asset-return-offboarding.md",
    "fixture_path": "microservices/workflow-studio/templates/fixtures/oya-workflow-studio-template-asset-return-offboarding.fixture.json"
  },
  "tags": [
    "operations",
    "it",
    "asset",
    "offboarding"
  ]
}
