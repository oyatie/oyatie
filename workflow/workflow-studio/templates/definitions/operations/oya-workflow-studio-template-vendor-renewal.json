{
  "template_id": "oya-workflow-studio-template-vendor-renewal",
  "schema_version": "1.0.0",
  "name": "Vendor renewal (90-day lookback)",
  "description": "90-day lookback on vendor performance + spend, prep negotiation brief, route to procurement-lead, optionally trigger MSA amendment.",
  "persona": "procurement-lead",
  "vertical": "operations",
  "node_graph": {
    "entry_node": "trigger-renewal-window",
    "terminal_nodes": [
      "t-renewal-complete"
    ],
    "nodes": [
      {
        "id": "trigger-renewal-window",
        "kind": "trigger",
        "label": "T-90 days to renewal"
      },
      {
        "id": "pull-spend",
        "kind": "connector-call",
        "label": "Pull spend history",
        "connector": "oya-shared-connector-erp",
        "operation": "pull_vendor_spend"
      },
      {
        "id": "pull-performance",
        "kind": "connector-call",
        "label": "Pull vendor performance",
        "connector": "oya-shared-connector-vendor-perf",
        "operation": "pull_kpis"
      },
      {
        "id": "draft-brief",
        "kind": "transform",
        "label": "Draft negotiation brief"
      },
      {
        "id": "procurement-review",
        "kind": "human-approval",
        "label": "Procurement lead review"
      },
      {
        "id": "decision-renew",
        "kind": "decision",
        "label": "Renew / re-negotiate / terminate"
      },
      {
        "id": "amend-msa",
        "kind": "connector-call",
        "label": "Amend MSA",
        "connector": "oya-shared-connector-esign",
        "operation": "send_for_signature"
      },
      {
        "id": "audit-renewal",
        "kind": "audit-emit",
        "label": "Emit renewal seal"
      },
      {
        "id": "t-renewal-complete",
        "kind": "terminal",
        "label": "Renewal complete"
      }
    ],
    "edges": [
      {
        "from": "trigger-renewal-window",
        "to": "pull-spend"
      },
      {
        "from": "pull-spend",
        "to": "pull-performance"
      },
      {
        "from": "pull-performance",
        "to": "draft-brief"
      },
      {
        "from": "draft-brief",
        "to": "procurement-review"
      },
      {
        "from": "procurement-review",
        "to": "decision-renew"
      },
      {
        "from": "decision-renew",
        "to": "amend-msa",
        "condition": "renew-with-amendment"
      },
      {
        "from": "decision-renew",
        "to": "audit-renewal",
        "condition": "renew-as-is"
      },
      {
        "from": "decision-renew",
        "to": "audit-renewal",
        "condition": "terminate"
      },
      {
        "from": "amend-msa",
        "to": "audit-renewal"
      },
      {
        "from": "audit-renewal",
        "to": "t-renewal-complete"
      }
    ]
  },
  "input_parameters": [
    {
      "name": "vendor_id",
      "type": "reference",
      "required": true,
      "description": "Vendor master id"
    },
    {
      "name": "current_end_date",
      "type": "date",
      "required": true,
      "description": "Current contract end date"
    }
  ],
  "runtime_expectations": {
    "expected_duration_seconds_p50": 604800,
