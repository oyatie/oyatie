{
  "template_id": "oya-workflow-studio-template-voluntary-exit-offboarding",
  "schema_version": "1.0.0",
  "name": "Voluntary exit + offboarding",
  "description": "Employee-initiated resignation: notice period, knowledge transfer, exit interview, final paycheque, COBRA notice.",
  "persona": "people-ops-coordinator",
  "vertical": "hr-people",
  "node_graph": {
    "entry_node": "trigger-resignation-submitted",
    "terminal_nodes": [
      "t-exit-complete"
    ],
    "nodes": [
      {
        "id": "trigger-resignation-submitted",
        "kind": "trigger",
        "label": "Resignation submitted"
      },
      {
        "id": "policy-voluntary-exit",
        "kind": "policy-check",
        "label": "Cedar voluntary-exit policy"
      },
      {
        "id": "kt-task",
        "kind": "connector-call",
        "label": "Create KT task list",
        "connector": "oya-shared-connector-task-management",
        "operation": "create_kt"
      },
      {
        "id": "exit-interview",
        "kind": "human-approval",
        "label": "Exit interview"
      },
      {
        "id": "final-paycheque",
        "kind": "connector-call",
        "label": "Compute + issue final paycheque",
        "connector": "oya-shared-connector-workday",
        "operation": "final_pay"
      },
      {
        "id": "cobra-notice",
        "kind": "connector-call",
        "label": "Send COBRA notice",
        "connector": "oya-shared-connector-benefits",
        "operation": "cobra_notice"
      },
      {
        "id": "deprovision",
        "kind": "connector-call",
        "label": "Deprovision identity + assets",
        "connector": "oya-shared-connector-identity",
        "operation": "deprovision_user"
      },
      {
        "id": "audit-exit",
        "kind": "audit-emit",
        "label": "Emit termination record"
      },
      {
        "id": "t-exit-complete",
        "kind": "terminal",
        "label": "Voluntary exit complete"
      }
    ],
    "edges": [
      {
        "from": "trigger-resignation-submitted",
        "to": "policy-voluntary-exit"
      },
      {
        "from": "policy-voluntary-exit",
        "to": "kt-task",
        "condition": "permit"
      },
      {
        "from": "kt-task",
        "to": "exit-interview"
      },
      {
        "from": "exit-interview",
        "to": "final-paycheque"
      },
      {
        "from": "final-paycheque",
        "to": "cobra-notice"
      },
      {
        "from": "cobra-notice",
        "to": "deprovision"
      },
      {
        "from": "deprovision",
        "to": "audit-exit"
      },
      {
        "from": "audit-exit",
        "to": "t-exit-complete"
      }
    ]
  },
  "input_parameters": [
    {
      "name": "employee_id",
      "type": "reference",
      "required": true,
      "description": "Departing employee"
    },
    {
      "name": "last_day",
      "type": "date",
      "required": true,
      "description": "Final working day"
    }
  ],
