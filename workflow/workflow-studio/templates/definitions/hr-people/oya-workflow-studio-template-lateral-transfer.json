{
  "template_id": "oya-workflow-studio-template-lateral-transfer",
  "schema_version": "1.0.0",
  "name": "Lateral transfer between teams",
  "description": "Orchestrate lateral transfer: manager change, cost-centre reassignment, access scope diff, optional relocation.",
  "persona": "hr-business-partner",
  "vertical": "hr-people",
  "node_graph": {
    "entry_node": "trigger-transfer-approved",
    "terminal_nodes": [
      "t-transfer-complete"
    ],
    "nodes": [
      {
        "id": "trigger-transfer-approved",
        "kind": "trigger",
        "label": "Transfer approval event"
      },
      {
        "id": "policy-transfer",
        "kind": "policy-check",
        "label": "Cedar lateral-transfer policy"
      },
      {
        "id": "manager-change",
        "kind": "connector-call",
        "label": "Reassign manager",
        "connector": "oya-shared-connector-workday",
        "operation": "reassign_manager"
      },
      {
        "id": "cost-centre",
        "kind": "connector-call",
        "label": "Update cost centre",
        "connector": "oya-shared-connector-erp",
        "operation": "update_cost_center"
      },
      {
        "id": "access-diff",
        "kind": "transform",
        "label": "Compute access scope diff"
      },
      {
        "id": "access-apply",
        "kind": "connector-call",
        "label": "Apply access changes",
        "connector": "oya-shared-connector-identity",
        "operation": "apply_access_diff"
      },
      {
        "id": "audit-transfer",
        "kind": "audit-emit",
        "label": "Emit transfer seal"
      },
      {
        "id": "t-transfer-complete",
        "kind": "terminal",
        "label": "Transfer complete"
      }
    ],
    "edges": [
      {
        "from": "trigger-transfer-approved",
        "to": "policy-transfer"
      },
      {
        "from": "policy-transfer",
        "to": "manager-change",
        "condition": "permit"
      },
      {
        "from": "manager-change",
        "to": "cost-centre"
      },
      {
        "from": "cost-centre",
        "to": "access-diff"
      },
      {
        "from": "access-diff",
        "to": "access-apply"
      },
      {
        "from": "access-apply",
        "to": "audit-transfer"
      },
      {
        "from": "audit-transfer",
        "to": "t-transfer-complete"
      }
    ]
  },
  "input_parameters": [
    {
      "name": "employee_id",
      "type": "reference",
      "required": true,
      "description": "Employee being transferred"
    },
    {
      "name": "new_manager_id",
      "type": "reference",
      "required": true,
      "description": "Receiving manager"
    },
    {
      "name": "new_cost_center",
      "type": "string",
      "required": true,
      "description": "Receiving cost centre"
    }
  ],
  "runtime_expectations": {
    "expected_duration_seconds_p50": 900,
    "expected_duration_seconds_p99": 2400
  },
  "compliance_flags": [
    "soc2-type-2",
    "gdpr",
    "iso-27001"
  ],
  "audit_emission_points": [
    {
      "node_id": "manager-change",
      "seal_kind": "external-call-receipt"
    },
    {
      "node_id": "access-apply",
      "seal_kind": "policy-verdict"
    },
    {
      "node_id": "audit-transfer",
      "seal_kind": "decision-recorded"
    }
  ],
  "cedar_policy": {
    "policy_id": "cedar:oya-workflow-studio-template:lateral-transfer",
    "effect": "permit",
    "principal_scope": "Workflow::Tenant",
    "resource_scope": "EmployeeRecord",
    "action_scope": "transfer",
    "conditions": []
  },
  "connector_dependencies": [
    {
      "connector_id": "oya-shared-connector-workday",
      "operations": [
        "reassign_manager"
      ],
      "criticality": "required"
    },
    {
      "connector_id": "oya-shared-connector-erp",
      "operations": [
        "update_cost_center"
      ],
      "criticality": "required"
    },
    {
      "connector_id": "oya-shared-connector-identity",
      "operations": [
        "apply_access_diff"
      ],
      "criticality": "required"
    }
  ],
  "slo": {
    "max_duration_seconds": 3600,
    "min_success_rate": 0.997,
    "openslo_ref": "microservices/workflow-studio/slos/oya-workflow-studio-template-lateral-transfer.openslo.yaml"
  },
  "cost_model": {
    "estimated_usd_per_execution_p50": 0.32,
    "foundry_inference_usd": 0.02,
    "connector_call_usd": 0.25,
    "storage_usd": 0.05
  },
  "test_mode_supported": true,
  "live_mode_supported": true,
  "documentation": {
    "explainer_path": "microservices/workflow-studio/templates/explainers/oya-workflow-studio-template-lateral-transfer.md",
    "fixture_path": "microservices/workflow-studio/templates/fixtures/oya-workflow-studio-template-lateral-transfer.fixture.json"
  },
  "tags": [
    "hr",
    "transfer",
    "access-management"
  ]
}
