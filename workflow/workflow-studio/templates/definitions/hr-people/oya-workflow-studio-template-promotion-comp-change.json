{
  "template_id": "oya-workflow-studio-template-promotion-comp-change",
  "schema_version": "1.0.0",
  "name": "Promotion + compensation change",
  "description": "Promotion event: comp band validation, payroll update, equity grant, manager notification, audit.",
  "persona": "hr-business-partner",
  "vertical": "hr-people",
  "node_graph": {
    "entry_node": "trigger-promo-approved",
    "terminal_nodes": [
      "t-promo-complete"
    ],
    "nodes": [
      {
        "id": "trigger-promo-approved",
        "kind": "trigger",
        "label": "Promotion approval"
      },
      {
        "id": "policy-comp-band",
        "kind": "policy-check",
        "label": "Validate within comp band"
      },
      {
        "id": "payroll-update",
        "kind": "connector-call",
        "label": "Update salary",
        "connector": "oya-shared-connector-workday",
        "operation": "update_compensation"
      },
      {
        "id": "equity-grant",
        "kind": "connector-call",
        "label": "Issue equity grant",
        "connector": "oya-shared-connector-equity",
        "operation": "grant_award"
      },
      {
        "id": "notify-manager",
        "kind": "notify",
        "label": "Notify manager + employee"
      },
      {
        "id": "audit-promo",
        "kind": "audit-emit",
        "label": "Emit promotion seal"
      },
      {
        "id": "t-promo-complete",
        "kind": "terminal",
        "label": "Promotion complete"
      }
    ],
    "edges": [
      {
        "from": "trigger-promo-approved",
        "to": "policy-comp-band"
      },
      {
        "from": "policy-comp-band",
        "to": "payroll-update",
        "condition": "within-band"
      },
      {
        "from": "payroll-update",
        "to": "equity-grant"
      },
      {
        "from": "equity-grant",
        "to": "notify-manager"
      },
      {
        "from": "notify-manager",
        "to": "audit-promo"
      },
      {
        "from": "audit-promo",
        "to": "t-promo-complete"
      }
    ]
  },
  "input_parameters": [
    {
      "name": "employee_id",
      "type": "reference",
      "required": true,
      "description": "Promoted employee"
    },
    {
      "name": "new_level",
      "type": "string",
      "required": true,
      "description": "New level code"
    },
    {
      "name": "new_base_usd",
      "type": "number",
      "required": true,
      "description": "New annual base USD"
    },
    {
      "name": "equity_grant_units",
      "type": "number",
      "required": false,
      "description": "Equity units granted"
    }
  ],
  "runtime_expectations": {
    "expected_duration_seconds_p50": 600,
    "expected_duration_seconds_p99": 1800
  },
  "compliance_flags": [
    "soc2-type-2",
    "sox-section-404",
    "gdpr"
  ],
  "audit_emission_points": [
    {
      "node_id": "policy-comp-band",
      "seal_kind": "policy-verdict"
    },
    {
      "node_id": "payroll-update",
      "seal_kind": "external-call-receipt"
    },
    {
      "node_id": "equity-grant",
      "seal_kind": "external-call-receipt"
    },
    {
      "node_id": "audit-promo",
      "seal_kind": "decision-recorded"
    }
  ],
  "cedar_policy": {
    "policy_id": "cedar:oya-workflow-studio-template:promotion-comp-change",
    "effect": "permit",
    "principal_scope": "Workflow::Tenant",
    "resource_scope": "EmployeeRecord",
    "action_scope": "promote",
    "conditions": [
      "resource.comp_band_validated == true"
    ]
  },
  "connector_dependencies": [
    {
      "connector_id": "oya-shared-connector-workday",
      "operations": [
        "update_compensation"
      ],
      "criticality": "required"
    },
    {
      "connector_id": "oya-shared-connector-equity",
      "operations": [
        "grant_award"
      ],
      "criticality": "preferred"
    }
  ],
  "slo": {
    "max_duration_seconds": 1800,
    "min_success_rate": 0.995,
    "openslo_ref": "microservices/workflow-studio/slos/oya-workflow-studio-template-promotion-comp-change.openslo.yaml"
  },
  "cost_model": {
    "estimated_usd_per_execution_p50": 0.28,
    "foundry_inference_usd": 0.03,
    "connector_call_usd": 0.2,
    "storage_usd": 0.05
  },
  "test_mode_supported": true,
  "live_mode_supported": true,
  "documentation": {
    "explainer_path": "microservices/workflow-studio/templates/explainers/oya-workflow-studio-template-promotion-comp-change.md",
    "fixture_path": "microservices/workflow-studio/templates/fixtures/oya-workflow-studio-template-promotion-comp-change.fixture.json"
  },
  "tags": [
    "hr",
    "promotion",
    "compensation",
    "equity"
  ]
}
