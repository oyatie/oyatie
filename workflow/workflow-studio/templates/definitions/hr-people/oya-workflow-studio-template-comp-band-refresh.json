{
  "template_id": "oya-workflow-studio-template-comp-band-refresh",
  "schema_version": "1.0.0",
  "name": "Compensation band refresh cycle",
  "description": "Annual comp band refresh: pull market data, run regression, validate against budget, publish bands, notify managers.",
  "persona": "hr-business-partner",
  "vertical": "hr-people",
  "node_graph": {
    "entry_node": "trigger-annual-refresh",
    "terminal_nodes": [
      "t-bands-published"
    ],
    "nodes": [
      {
        "id": "trigger-annual-refresh",
        "kind": "trigger",
        "label": "Annual comp cycle"
      },
      {
        "id": "pull-market",
        "kind": "connector-call",
        "label": "Pull market data",
        "connector": "oya-shared-connector-market-data",
        "operation": "pull_comp_benchmarks"
      },
      {
        "id": "regression",
        "kind": "transform",
        "label": "Run regression"
      },
      {
        "id": "budget-check",
        "kind": "policy-check",
        "label": "Cedar budget envelope"
      },
      {
        "id": "publish-bands",
        "kind": "connector-call",
        "label": "Publish comp bands",
        "connector": "oya-shared-connector-workday",
        "operation": "publish_bands"
      },
      {
        "id": "notify-managers",
        "kind": "notify",
        "label": "Notify people managers"
      },
      {
        "id": "audit-bands",
        "kind": "audit-emit",
        "label": "Emit comp band seal"
      },
      {
        "id": "t-bands-published",
        "kind": "terminal",
        "label": "Bands published"
      }
    ],
    "edges": [
      {
        "from": "trigger-annual-refresh",
        "to": "pull-market"
      },
      {
        "from": "pull-market",
        "to": "regression"
      },
      {
        "from": "regression",
        "to": "budget-check"
      },
      {
        "from": "budget-check",
        "to": "publish-bands",
        "condition": "within-budget"
      },
      {
        "from": "publish-bands",
        "to": "notify-managers"
      },
      {
        "from": "notify-managers",
        "to": "audit-bands"
      },
      {
        "from": "audit-bands",
        "to": "t-bands-published"
      }
    ]
  },
  "input_parameters": [
    {
      "name": "fiscal_year",
      "type": "string",
      "required": true,
      "description": "Fiscal year code"
    },
    {
      "name": "budget_envelope_pct",
      "type": "number",
      "required": true,
      "description": "Budget envelope %"
    }
  ],
  "runtime_expectations": {
    "expected_duration_seconds_p50": 86400,
    "expected_duration_seconds_p99": 172800
  },
  "compliance_flags": [
    "soc2-type-2",
    "sox-section-404",
    "gdpr"
  ],
  "audit_emission_points": [
    {
      "node_id": "budget-check",
      "seal_kind": "policy-verdict"
    },
    {
      "node_id": "publish-bands",
      "seal_kind": "external-call-receipt"
    },
    {
      "node_id": "audit-bands",
      "seal_kind": "transform-attestation"
    }
  ],
  "cedar_policy": {
    "policy_id": "cedar:oya-workflow-studio-template:comp-band-refresh",
    "effect": "permit",
    "principal_scope": "Workflow::Tenant",
    "resource_scope": "CompBand",
    "action_scope": "refresh",
    "conditions": []
  },
  "connector_dependencies": [
    {
      "connector_id": "oya-shared-connector-market-data",
      "operations": [
        "pull_comp_benchmarks"
      ],
      "criticality": "required"
    },
    {
      "connector_id": "oya-shared-connector-workday",
      "operations": [
        "publish_bands"
      ],
      "criticality": "required"
    }
  ],
  "slo": {
    "max_duration_seconds": 172800,
    "min_success_rate": 0.99,
    "openslo_ref": "microservices/workflow-studio/slos/oya-workflow-studio-template-comp-band-refresh.openslo.yaml"
  },
  "cost_model": {
    "estimated_usd_per_execution_p50": 6.4,
    "foundry_inference_usd": 1.1,
    "connector_call_usd": 4.8,
    "storage_usd": 0.5
  },
  "test_mode_supported": true,
  "live_mode_supported": true,
  "documentation": {
    "explainer_path": "microservices/workflow-studio/templates/explainers/oya-workflow-studio-template-comp-band-refresh.md",
    "fixture_path": "workflow/workflow-studio/templates/fixtures/oya-workflow-studio-template-comp-band-refresh.fixture.json"
  },
  "tags": [
    "hr",
    "compensation",
    "annual-cycle"
  ]
}
