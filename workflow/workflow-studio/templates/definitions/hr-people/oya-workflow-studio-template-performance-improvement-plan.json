{
  "template_id": "oya-workflow-studio-template-performance-improvement-plan",
  "schema_version": "1.0.0",
  "name": "Performance Improvement Plan (PIP)",
  "description": "Initiate, track, and conclude a PIP with weekly check-ins, HR sign-off, and outcome routing.",
  "persona": "hr-business-partner",
  "vertical": "hr-people",
  "node_graph": {
    "entry_node": "trigger-pip-initiated",
    "terminal_nodes": [
      "t-pip-success",
      "t-pip-fail"
    ],
    "nodes": [
      {
        "id": "trigger-pip-initiated",
        "kind": "trigger",
        "label": "PIP initiated"
      },
      {
        "id": "policy-pip",
        "kind": "policy-check",
        "label": "Cedar PIP policy + legal review"
      },
      {
        "id": "hr-sign-off",
        "kind": "human-approval",
        "label": "HR + legal sign-off"
      },
      {
        "id": "weekly-checkins",
        "kind": "wait",
        "label": "60-day weekly check-ins"
      },
      {
        "id": "outcome-decision",
        "kind": "decision",
        "label": "PIP outcome"
      },
      {
        "id": "audit-pip-pass",
        "kind": "audit-emit",
        "label": "Seal PIP success"
      },
      {
        "id": "audit-pip-fail",
        "kind": "audit-emit",
        "label": "Seal PIP failure"
      },
      {
        "id": "t-pip-success",
        "kind": "terminal",
        "label": "PIP succeeded"
      },
      {
        "id": "t-pip-fail",
        "kind": "terminal",
        "label": "PIP failed \u2014 route to involuntary termination"
      }
    ],
    "edges": [
      {
        "from": "trigger-pip-initiated",
        "to": "policy-pip"
      },
      {
        "from": "policy-pip",
        "to": "hr-sign-off",
        "condition": "permit"
      },
      {
        "from": "hr-sign-off",
        "to": "weekly-checkins"
      },
      {
        "from": "weekly-checkins",
        "to": "outcome-decision"
      },
      {
        "from": "outcome-decision",
        "to": "audit-pip-pass",
        "condition": "succeeded"
      },
      {
        "from": "outcome-decision",
        "to": "audit-pip-fail",
        "condition": "failed"
      },
      {
        "from": "audit-pip-pass",
        "to": "t-pip-success"
      },
      {
        "from": "audit-pip-fail",
        "to": "t-pip-fail"
      }
    ]
  },
  "input_parameters": [
    {
      "name": "employee_id",
      "type": "reference",
      "required": true,
      "description": "Employee on PIP"
    },
    {
      "name": "duration_days",
      "type": "number",
      "required": true,
      "default": 60,
      "description": "PIP duration"
    },
    {
      "name": "goals",
      "type": "string",
      "required": true,
      "description": "Documented PIP goals"
    }
  ],
  "runtime_expectations": {
    "expected_duration_seconds_p50": 5184000,
    "expected_duration_seconds_p99": 5443200
  },
  "compliance_flags": [
    "soc2-type-2",
    "gdpr",
    "eeoc",
    "flsa"
  ],
  "audit_emission_points": [
    {
      "node_id": "hr-sign-off",
      "seal_kind": "human-approval-signature"
    },
    {
      "node_id": "audit-pip-pass",
      "seal_kind": "decision-recorded"
    },
    {
      "node_id": "audit-pip-fail",
      "seal_kind": "decision-recorded"
    }
  ],
  "cedar_policy": {
    "policy_id": "cedar:oya-workflow-studio-template:performance-improvement-plan",
    "effect": "permit",
    "principal_scope": "Workflow::Tenant",
    "resource_scope": "EmployeeRecord",
    "action_scope": "initiate_pip",
    "conditions": [
      "resource.legal_reviewed == true"
    ]
  },
  "connector_dependencies": [
    {
      "connector_id": "oya-shared-connector-workday",
      "operations": [
        "log_pip"
      ],
      "criticality": "required"
    },
    {
      "connector_id": "oya-shared-connector-document-store",
      "operations": [
        "store_pip_record"
      ],
      "criticality": "required"
    }
  ],
  "slo": {
    "max_duration_seconds": 5443200,
    "min_success_rate": 0.999,
    "openslo_ref": "microservices/workflow-studio/slos/oya-workflow-studio-template-performance-improvement-plan.openslo.yaml"
  },
  "cost_model": {
    "estimated_usd_per_execution_p50": 1.2,
    "foundry_inference_usd": 0.18,
    "connector_call_usd": 0.85,
    "storage_usd": 0.17
  },
  "test_mode_supported": true,
  "live_mode_supported": true,
  "documentation": {
    "explainer_path": "microservices/workflow-studio/templates/explainers/oya-workflow-studio-template-performance-improvement-plan.md",
    "fixture_path": "workflow/workflow-studio/templates/fixtures/oya-workflow-studio-template-performance-improvement-plan.fixture.json"
  },
  "tags": [
    "hr",
    "performance",
    "pip",
    "legal-flagged"
  ]
}
