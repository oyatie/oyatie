{
  "template_id": "oya-workflow-studio-template-interview-kit-scheduling",
  "schema_version": "1.0.0",
  "name": "Interview kit generation + scheduling + debrief",
  "description": "Generate interview kit from role spec, schedule loop, send prep, collect scorecards, debrief.",
  "persona": "recruiting-coordinator",
  "vertical": "hiring",
  "node_graph": {
    "entry_node": "trigger-candidate-advanced",
    "terminal_nodes": [
      "t-debrief-complete"
    ],
    "nodes": [
      {
        "id": "trigger-candidate-advanced",
        "kind": "trigger",
        "label": "Candidate advanced to onsite"
      },
      {
        "id": "policy-interview",
        "kind": "policy-check",
        "label": "Cedar interview-kit policy"
      },
      {
        "id": "generate-kit",
        "kind": "transform",
        "label": "Generate interview kit"
      },
      {
        "id": "schedule-loop",
        "kind": "connector-call",
        "label": "Schedule loop",
        "connector": "oya-shared-connector-calendar",
        "operation": "schedule_loop"
      },
      {
        "id": "send-prep",
        "kind": "notify",
        "label": "Send candidate prep"
      },
      {
        "id": "wait-interviews",
        "kind": "wait",
        "label": "Await interviews"
      },
      {
        "id": "collect-scorecards",
        "kind": "connector-call",
        "label": "Collect scorecards",
        "connector": "oya-shared-connector-ats",
        "operation": "collect_scorecards"
      },
      {
        "id": "debrief",
        "kind": "human-approval",
        "label": "Debrief decision"
      },
      {
        "id": "audit-interview",
        "kind": "audit-emit",
        "label": "Emit interview seal"
      },
      {
        "id": "t-debrief-complete",
        "kind": "terminal",
        "label": "Debrief complete"
      }
    ],
    "edges": [
      {
        "from": "trigger-candidate-advanced",
        "to": "policy-interview"
      },
      {
        "from": "policy-interview",
        "to": "generate-kit",
        "condition": "permit"
      },
      {
        "from": "generate-kit",
        "to": "schedule-loop"
      },
      {
        "from": "schedule-loop",
        "to": "send-prep"
      },
      {
        "from": "send-prep",
        "to": "wait-interviews"
      },
      {
        "from": "wait-interviews",
        "to": "collect-scorecards"
      },
      {
        "from": "collect-scorecards",
        "to": "debrief"
      },
      {
        "from": "debrief",
        "to": "audit-interview",
        "condition": "decided"
      },
      {
        "from": "audit-interview",
        "to": "t-debrief-complete"
      }
    ]
  },
  "input_parameters": [
    {
      "name": "candidate_id",
      "type": "reference",
      "required": true,
      "description": "Candidate id"
    },
    {
      "name": "req_id",
      "type": "reference",
      "required": true,
      "description": "Req id"
    },
    {
      "name": "interview_loop_template",
      "type": "string",
      "required": true,
      "description": "Loop template code"
    }
  ],
  "runtime_expectations": {
    "expected_duration_seconds_p50": 604800,
    "expected_duration_seconds_p99": 1209600
  },
  "compliance_flags": [
    "soc2-type-2",
    "eeoc",
    "gdpr"
  ],
  "audit_emission_points": [
    {
      "node_id": "generate-kit",
      "seal_kind": "transform-attestation"
    },
    {
      "node_id": "debrief",
      "seal_kind": "human-approval-signature"
    },
    {
      "node_id": "audit-interview",
      "seal_kind": "decision-recorded"
    }
  ],
  "cedar_policy": {
    "policy_id": "cedar:oya-workflow-studio-template:interview-kit-scheduling",
    "effect": "permit",
    "principal_scope": "Workflow::Tenant",
    "resource_scope": "CandidateInterview",
    "action_scope": "schedule_and_debrief",
    "conditions": []
  },
  "connector_dependencies": [
