      "operations": [
        "schedule_loop"
      ],
      "criticality": "required"
    },
    {
      "connector_id": "oya-shared-connector-ats",
      "operations": [
        "collect_scorecards"
      ],
      "criticality": "required"
    }
  ],
  "slo": {
    "max_duration_seconds": 1209600,
    "min_success_rate": 0.99,
    "openslo_ref": "microservices/workflow-studio/slos/oya-workflow-studio-template-interview-kit-scheduling.openslo.yaml"
  },
  "cost_model": {
    "estimated_usd_per_execution_p50": 2.2,
    "foundry_inference_usd": 0.85,
    "connector_call_usd": 1.2,
    "storage_usd": 0.15
  },
  "test_mode_supported": true,
  "live_mode_supported": true,
  "documentation": {
    "explainer_path": "microservices/workflow-studio/templates/explainers/oya-workflow-studio-template-interview-kit-scheduling.md",
