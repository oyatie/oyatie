{
  "template_id": "oya-workflow-studio-template-req-approval-posting-sourcing",
  "schema_version": "1.0.0",
  "name": "Req approval -> posting -> sourcing automation",
  "description": "Open a req: hiring-manager + finance approval, multi-board posting, automated sourcing pipelines.",
  "persona": "recruiting-coordinator",
  "vertical": "hiring",
  "node_graph": {
    "entry_node": "trigger-req-drafted",
    "terminal_nodes": [
      "t-pipeline-active"
    ],
    "nodes": [
      {
        "id": "trigger-req-drafted",
        "kind": "trigger",
        "label": "Req drafted"
      },
      {
        "id": "policy-req",
        "kind": "policy-check",
        "label": "Cedar req-approval policy"
      },
      {
        "id": "hm-approval",
        "kind": "human-approval",
        "label": "Hiring manager approval"
      },
      {
        "id": "finance-approval",
        "kind": "human-approval",
        "label": "Finance headcount approval"
      },
      {
        "id": "post-boards",
        "kind": "connector-call",
        "label": "Multi-board posting",
        "connector": "oya-shared-connector-job-boards",
        "operation": "post_multi_board"
      },
      {
        "id": "sourcing-pipelines",
        "kind": "connector-call",
        "label": "Kick off sourcing",
        "connector": "oya-shared-connector-ats",
        "operation": "enable_sourcing"
      },
      {
        "id": "audit-req",
        "kind": "audit-emit",
        "label": "Emit req approval seal"
      },
      {
        "id": "t-pipeline-active",
        "kind": "terminal",
        "label": "Pipeline active"
      }
    ],
    "edges": [
      {
        "from": "trigger-req-drafted",
        "to": "policy-req"
      },
      {
        "from": "policy-req",
        "to": "hm-approval",
        "condition": "permit"
      },
      {
        "from": "hm-approval",
        "to": "finance-approval",
        "condition": "approved"
      },
      {
        "from": "finance-approval",
        "to": "post-boards",
        "condition": "approved"
      },
      {
        "from": "post-boards",
        "to": "sourcing-pipelines"
      },
      {
        "from": "sourcing-pipelines",
        "to": "audit-req"
      },
      {
        "from": "audit-req",
        "to": "t-pipeline-active"
      }
    ]
  },
  "input_parameters": [
    {
      "name": "req_id",
      "type": "reference",
      "required": true,
      "description": "Req id"
    },
    {
      "name": "role_code",
      "type": "string",
      "required": true,
      "description": "Role code"
    },
    {
      "name": "level",
      "type": "string",
      "required": true,
      "description": "Level code"
    }
  ],
  "runtime_expectations": {
    "expected_duration_seconds_p50": 172800,
    "expected_duration_seconds_p99": 604800
  },
  "compliance_flags": [
    "soc2-type-2",
    "eeoc",
    "gdpr"
  ],
  "audit_emission_points": [
    {
      "node_id": "hm-approval",
      "seal_kind": "human-approval-signature"
    },
    {
      "node_id": "finance-approval",
      "seal_kind": "human-approval-signature"
    },
    {
      "node_id": "audit-req",
      "seal_kind": "decision-recorded"
    }
  ],
  "cedar_policy": {
    "policy_id": "cedar:oya-workflow-studio-template:req-approval-posting-sourcing",
    "effect": "permit",
    "principal_scope": "Workflow::Tenant",
    "resource_scope": "JobRequisition",
    "action_scope": "approve_and_post",
    "conditions": []
  },
  "connector_dependencies": [
    {
      "connector_id": "oya-shared-connector-job-boards",
      "operations": [
        "post_multi_board"
      ],
      "criticality": "required"
    },
    {
      "connector_id": "oya-shared-connector-ats",
      "operations": [
        "enable_sourcing"
      ],
      "criticality": "required"
    }
  ],
  "slo": {
    "max_duration_seconds": 604800,
    "min_success_rate": 0.995,
    "openslo_ref": "microservices/workflow-studio/slos/oya-workflow-studio-template-req-approval-posting-sourcing.openslo.yaml"
  },
  "cost_model": {
    "estimated_usd_per_execution_p50": 1.2,
    "foundry_inference_usd": 0.1,
    "connector_call_usd": 0.95,
    "storage_usd": 0.15
  },
  "test_mode_supported": true,
  "live_mode_supported": true,
  "documentation": {
    "explainer_path": "microservices/workflow-studio/templates/explainers/oya-workflow-studio-template-req-approval-posting-sourcing.md",
    "fixture_path": "workflow/workflow-studio/templates/fixtures/oya-workflow-studio-template-req-approval-posting-sourcing.fixture.json"
  },
  "tags": [
