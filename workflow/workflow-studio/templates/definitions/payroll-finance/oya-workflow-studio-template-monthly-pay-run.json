{
  "template_id": "oya-workflow-studio-template-monthly-pay-run",
  "schema_version": "1.0.0",
  "name": "Monthly pay run",
  "description": "End-to-end monthly payroll: time-attendance lock, gross-to-net, statutory deductions, ACH batch, payslip emission.",
  "persona": "payroll-controller",
  "vertical": "payroll-finance",
  "node_graph": {
    "entry_node": "trigger-payroll-cutoff",
    "terminal_nodes": [
      "t-payrun-complete"
    ],
    "nodes": [
      {
        "id": "trigger-payroll-cutoff",
        "kind": "trigger",
        "label": "Payroll cutoff event"
      },
      {
        "id": "lock-attendance",
        "kind": "connector-call",
        "label": "Lock time/attendance",
        "connector": "oya-shared-connector-time-attendance",
        "operation": "lock_period"
      },
      {
        "id": "gross-to-net",
        "kind": "transform",
        "label": "Compute gross-to-net"
      },
      {
        "id": "statutory",
        "kind": "transform",
        "label": "Apply statutory deductions"
      },
      {
        "id": "policy-treasury",
        "kind": "policy-check",
        "label": "Treasury approval"
      },
      {
        "id": "ach-batch",
        "kind": "connector-call",
        "label": "Submit ACH batch",
        "connector": "oya-shared-connector-banking",
        "operation": "submit_ach_batch"
      },
      {
        "id": "payslip-emit",
        "kind": "connector-call",
        "label": "Emit payslips",
        "connector": "oya-shared-connector-document-store",
        "operation": "emit_payslips"
      },
      {
        "id": "audit-payrun",
        "kind": "audit-emit",
        "label": "Emit payrun seal"
      },
      {
        "id": "t-payrun-complete",
        "kind": "terminal",
        "label": "Pay run complete"
      }
    ],
    "edges": [
      {
        "from": "trigger-payroll-cutoff",
        "to": "lock-attendance"
      },
      {
        "from": "lock-attendance",
        "to": "gross-to-net"
      },
      {
        "from": "gross-to-net",
        "to": "statutory"
      },
      {
        "from": "statutory",
        "to": "policy-treasury"
      },
      {
        "from": "policy-treasury",
        "to": "ach-batch",
        "condition": "approved"
      },
      {
        "from": "ach-batch",
        "to": "payslip-emit"
      },
      {
        "from": "payslip-emit",
        "to": "audit-payrun"
      },
      {
        "from": "audit-payrun",
        "to": "t-payrun-complete"
      }
    ]
  },
  "input_parameters": [
    {
      "name": "period_code",
      "type": "string",
      "required": true,
      "description": "Pay period code YYYY-MM"
    },
    {
      "name": "jurisdiction",
      "type": "string",
      "required": true,
      "description": "Jurisdiction code"
    }
  ],
  "runtime_expectations": {
    "expected_duration_seconds_p50": 10800,
    "expected_duration_seconds_p99": 21600
  },
  "compliance_flags": [
    "soc2-type-2",
    "sox-section-404",
    "flsa",
    "wage-act"
  ],
  "audit_emission_points": [
    {
      "node_id": "policy-treasury",
      "seal_kind": "policy-verdict"
    },
    {
      "node_id": "ach-batch",
      "seal_kind": "external-call-receipt"
    },
    {
      "node_id": "audit-payrun",
      "seal_kind": "decision-recorded"
    }
  ],
  "cedar_policy": {
    "policy_id": "cedar:oya-workflow-studio-template:monthly-pay-run",
    "effect": "permit",
    "principal_scope": "Workflow::Tenant",
    "resource_scope": "PayrollPeriod",
    "action_scope": "execute_payrun",
    "conditions": []
  },
  "connector_dependencies": [
    {
      "connector_id": "oya-shared-connector-time-attendance",
      "operations": [
        "lock_period"
      ],
      "criticality": "required"
    },
    {
      "connector_id": "oya-shared-connector-banking",
      "operations": [
        "submit_ach_batch"
      ],
      "criticality": "required"
    },
    {
      "connector_id": "oya-shared-connector-document-store",
      "operations": [
        "emit_payslips"
      ],
      "criticality": "required"
    }
  ],
  "slo": {
    "max_duration_seconds": 21600,
    "min_success_rate": 0.9995,
    "openslo_ref": "microservices/workflow-studio/slos/oya-workflow-studio-template-monthly-pay-run.openslo.yaml"
  },
  "cost_model": {
    "estimated_usd_per_execution_p50": 24.5,
    "foundry_inference_usd": 0.2,
    "connector_call_usd": 22.4,
    "storage_usd": 1.9
  },
  "test_mode_supported": true,
  "live_mode_supported": true,
  "documentation": {
    "explainer_path": "microservices/workflow-studio/templates/explainers/oya-workflow-studio-template-monthly-pay-run.md",
    "fixture_path": "workflow/workflow-studio/templates/fixtures/oya-workflow-studio-template-monthly-pay-run.fixture.json"
  },
  "tags": [
    "payroll",
    "finance",
    "monthly"
  ]
}
