{
  "template_id": "oya-workflow-studio-template-quarterly-variance-narrative",
  "schema_version": "1.0.0",
  "name": "Quarterly variance review with auto-narrative",
  "description": "Pull actuals + budget, compute variances, auto-draft narrative via Foundry inference, route to controller for sign-off.",
  "persona": "finance-controller",
  "vertical": "payroll-finance",
  "node_graph": {
    "entry_node": "trigger-quarter-end",
    "terminal_nodes": [
      "t-variance-published"
    ],
    "nodes": [
      {
        "id": "trigger-quarter-end",
        "kind": "trigger",
        "label": "Quarter end"
      },
      {
        "id": "pull-actuals",
        "kind": "connector-call",
        "label": "Pull actuals",
        "connector": "oya-shared-connector-erp",
        "operation": "pull_actuals"
      },
      {
        "id": "pull-budget",
        "kind": "connector-call",
        "label": "Pull budget",
        "connector": "oya-shared-connector-fpa",
        "operation": "pull_budget"
      },
      {
        "id": "compute-variance",
        "kind": "transform",
        "label": "Compute variance lines"
      },
      {
        "id": "draft-narrative",
        "kind": "transform",
        "label": "Foundry-draft narrative"
      },
      {
        "id": "controller-review",
        "kind": "human-approval",
        "label": "Controller sign-off"
      },
      {
        "id": "publish-variance",
        "kind": "connector-call",
        "label": "Publish to board pack",
        "connector": "oya-shared-connector-document-store",
        "operation": "publish_board_pack"
      },
      {
        "id": "audit-variance",
        "kind": "audit-emit",
        "label": "Emit variance seal"
      },
      {
        "id": "t-variance-published",
        "kind": "terminal",
        "label": "Variance published"
      }
    ],
    "edges": [
      {
        "from": "trigger-quarter-end",
        "to": "pull-actuals"
      },
      {
        "from": "pull-actuals",
        "to": "pull-budget"
      },
      {
        "from": "pull-budget",
        "to": "compute-variance"
      },
      {
        "from": "compute-variance",
        "to": "draft-narrative"
      },
      {
        "from": "draft-narrative",
        "to": "controller-review"
      },
      {
        "from": "controller-review",
        "to": "publish-variance",
        "condition": "approved"
      },
      {
        "from": "publish-variance",
        "to": "audit-variance"
      },
      {
        "from": "audit-variance",
        "to": "t-variance-published"
      }
    ]
  },
  "input_parameters": [
    {
      "name": "quarter_code",
      "type": "string",
      "required": true,
      "description": "Quarter code FYYYYY-Qn"
    }
  ],
  "runtime_expectations": {
    "expected_duration_seconds_p50": 86400,
    "expected_duration_seconds_p99": 172800
  },
  "compliance_flags": [
    "soc2-type-2",
    "sox-section-404"
  ],
  "audit_emission_points": [
    {
      "node_id": "draft-narrative",
      "seal_kind": "transform-attestation"
    },
    {
      "node_id": "controller-review",
      "seal_kind": "human-approval-signature"
    },
    {
      "node_id": "audit-variance",
      "seal_kind": "decision-recorded"
    }
  ],
  "cedar_policy": {
    "policy_id": "cedar:oya-workflow-studio-template:quarterly-variance-narrative",
    "effect": "permit",
    "principal_scope": "Workflow::Tenant",
    "resource_scope": "QuarterlyReport",
    "action_scope": "publish_variance",
    "conditions": []
  },
  "connector_dependencies": [
    {
      "connector_id": "oya-shared-connector-erp",
      "operations": [
        "pull_actuals"
      ],
      "criticality": "required"
    },
    {
      "connector_id": "oya-shared-connector-fpa",
      "operations": [
        "pull_budget"
      ],
      "criticality": "required"
    },
    {
      "connector_id": "oya-shared-connector-document-store",
      "operations": [
        "publish_board_pack"
      ],
      "criticality": "required"
    }
  ],
  "slo": {
    "max_duration_seconds": 172800,
    "min_success_rate": 0.99,
    "openslo_ref": "microservices/workflow-studio/slos/oya-workflow-studio-template-quarterly-variance-narrative.openslo.yaml"
  },
  "cost_model": {
    "estimated_usd_per_execution_p50": 5.8,
    "foundry_inference_usd": 3.2,
    "connector_call_usd": 2.2,
    "storage_usd": 0.4
  },
  "test_mode_supported": true,
  "live_mode_supported": true,
  "documentation": {
    "explainer_path": "microservices/workflow-studio/templates/explainers/oya-workflow-studio-template-quarterly-variance-narrative.md",
    "fixture_path": "workflow/workflow-studio/templates/fixtures/oya-workflow-studio-template-quarterly-variance-narrative.fixture.json"
  },
  "tags": [
    "finance",
    "variance",
    "quarterly",
    "narrative"
  ]
}
