    },
    {
      "node_id": "controller-approval",
      "seal_kind": "human-approval-signature"
    },
    {
      "node_id": "efile-irs",
      "seal_kind": "external-call-receipt"
    },
    {
      "node_id": "audit-y-end",
      "seal_kind": "decision-recorded"
    }
  ],
  "cedar_policy": {
    "policy_id": "cedar:oya-workflow-studio-template:year-end-w2-1099",
    "effect": "permit",
    "principal_scope": "Workflow::Tenant",
    "resource_scope": "StatutoryForms",
    "action_scope": "generate_efile",
    "conditions": []
  },
  "connector_dependencies": [
