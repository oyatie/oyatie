    "connector_call_usd": 38.4,
    "storage_usd": 2.4
  },
  "test_mode_supported": true,
  "live_mode_supported": true,
  "documentation": {
    "explainer_path": "microservices/workflow-studio/templates/explainers/oya-workflow-studio-template-year-end-w2-1099.md",
