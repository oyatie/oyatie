{
  "template_id": "oya-workflow-studio-template-year-end-w2-1099",
  "schema_version": "1.0.0",
  "name": "Year-end W-2 + 1099 generation",
  "description": "Year-end statutory forms: aggregate earnings, validate TINs, generate W-2 / 1099-NEC / 1099-MISC, e-file with IRS + SSA, distribute to recipients.",
  "persona": "payroll-controller",
  "vertical": "payroll-finance",
  "node_graph": {
    "entry_node": "trigger-year-end",
    "terminal_nodes": [
      "t-forms-distributed"
    ],
    "nodes": [
      {
        "id": "trigger-year-end",
        "kind": "trigger",
        "label": "Year-end event"
      },
      {
        "id": "aggregate-earnings",
        "kind": "transform",
        "label": "Aggregate earnings"
      },
      {
        "id": "validate-tins",
        "kind": "connector-call",
        "label": "Validate TINs",
        "connector": "oya-shared-connector-irs",
        "operation": "tin_match"
      },
      {
        "id": "generate-forms",
        "kind": "transform",
        "label": "Generate W-2/1099"
      },
      {
        "id": "controller-approval",
        "kind": "human-approval",
        "label": "Controller sign-off"
      },
      {
        "id": "efile-irs",
        "kind": "connector-call",
        "label": "E-file with IRS",
        "connector": "oya-shared-connector-irs",
        "operation": "efile_forms"
      },
      {
        "id": "efile-ssa",
        "kind": "connector-call",
        "label": "E-file with SSA",
        "connector": "oya-shared-connector-ssa",
        "operation": "efile_w2"
      },
      {
        "id": "distribute",
        "kind": "connector-call",
        "label": "Distribute to recipients",
        "connector": "oya-shared-connector-document-store",
        "operation": "distribute_forms"
      },
      {
        "id": "audit-y-end",
        "kind": "audit-emit",
        "label": "Emit year-end seal"
      },
      {
        "id": "t-forms-distributed",
        "kind": "terminal",
        "label": "Forms distributed"
      }
    ],
    "edges": [
      {
        "from": "trigger-year-end",
        "to": "aggregate-earnings"
      },
      {
        "from": "aggregate-earnings",
        "to": "validate-tins"
      },
      {
        "from": "validate-tins",
        "to": "generate-forms"
      },
      {
        "from": "generate-forms",
        "to": "controller-approval"
      },
      {
        "from": "controller-approval",
        "to": "efile-irs",
        "condition": "approved"
      },
      {
        "from": "efile-irs",
        "to": "efile-ssa"
      },
      {
        "from": "efile-ssa",
        "to": "distribute"
      },
      {
        "from": "distribute",
        "to": "audit-y-end"
      },
      {
        "from": "audit-y-end",
        "to": "t-forms-distributed"
      }
    ]
  },
  "input_parameters": [
    {
      "name": "tax_year",
      "type": "string",
      "required": true,
      "description": "Tax year YYYY"
    }
  ],
  "runtime_expectations": {
    "expected_duration_seconds_p50": 259200,
    "expected_duration_seconds_p99": 518400
  },
  "compliance_flags": [
    "soc2-type-2",
    "sox-section-404",
    "flsa"
  ],
  "audit_emission_points": [
    {
      "node_id": "validate-tins",
