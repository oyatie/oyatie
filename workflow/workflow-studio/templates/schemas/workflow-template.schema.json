{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oyatie.example/workflow/workflow-studio/templates/schemas/workflow-template.schema.json",
  "title": "WorkflowStudioTemplate",
  "description": "Canonical schema for a pre-built Workflow Studio template. Each template is a deployable workflow definition with persona, vertical, parameters, node graph, runtime metrics, compliance flags, audit-chain emission points, Cedar policy, and SLO declarations. Conforms to ADR-0131 (per-µservice flat layout) and ADR-0064 (canonical-base + localization).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "template_id",
    "schema_version",
    "name",
    "description",
    "persona",
    "vertical",
    "node_graph",
    "input_parameters",
    "runtime_expectations",
    "compliance_flags",
    "audit_emission_points",
    "cedar_policy",
    "connector_dependencies",
    "slo",
    "cost_model",
    "test_mode_supported",
    "live_mode_supported"
  ],
  "properties": {
    "template_id": {
      "type": "string",
      "pattern": "^oya-workflow-studio-template-[a-z0-9-]+$",
      "description": "Stable canonical id, prefixed oya-workflow-studio-template-* per ADR-0131."
    },
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "name": {
      "type": "string",
      "minLength": 4,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "minLength": 16,
      "maxLength": 1024
    },
    "persona": {
      "type": "string",
      "enum": [
        "hr-business-partner",
        "people-ops-coordinator",
        "payroll-controller",
        "finance-controller",
        "ops-manager",
        "procurement-lead",
        "it-asset-admin",
        "hospital-admissions-clerk",
        "hospital-discharge-planner",
        "hospital-bed-manager",
        "hospital-compliance-officer",
        "recruiting-coordinator",
        "hiring-manager",
        "talent-acquisition-lead"
      ]
    },
    "vertical": {
      "type": "string",
      "enum": [
        "hr-people",
        "payroll-finance",
        "operations",
        "hospital-operations",
        "hiring"
      ]
    },
    "node_graph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodes", "edges", "entry_node", "terminal_nodes"],
      "properties": {
        "entry_node": { "type": "string", "minLength": 1 },
        "terminal_nodes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "nodes": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "kind", "label"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "kind": {
                "type": "string",
                "enum": [
                  "trigger",
                  "connector-call",
                  "transform",
                  "decision",
                  "human-approval",
                  "policy-check",
                  "audit-emit",
                  "notify",
                  "wait",
                  "terminal"
                ]
              },
              "label": { "type": "string" },
              "connector": { "type": "string" },
              "operation": { "type": "string" },
              "parameters": { "type": "object" },
              "timeout_seconds": { "type": "integer", "minimum": 1 },
              "retry_policy": {
                "type": "object",
                "properties": {
                  "max_attempts": { "type": "integer", "minimum": 0, "maximum": 10 },
                  "backoff_seconds": { "type": "integer", "minimum": 0 }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "edges": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from", "to"],
            "properties": {
              "from": { "type": "string" },
              "to": { "type": "string" },
              "condition": { "type": "string" }
            }
          }
        }
      }
    },
    "input_parameters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "type", "required", "description"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "type": {
            "type": "string",
            "enum": ["string", "number", "boolean", "date", "duration", "enum", "reference"]
          },
          "required": { "type": "boolean" },
          "description": { "type": "string" },
          "default": {},
          "enum_values": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "runtime_expectations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected_duration_seconds_p50", "expected_duration_seconds_p99"],
      "properties": {
        "expected_duration_seconds_p50": { "type": "number", "minimum": 0 },
        "expected_duration_seconds_p99": { "type": "number", "minimum": 0 }
      }
    },
    "compliance_flags": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "soc2-type-2",
          "hipaa",
          "gdpr",
          "ccpa",
          "pci-dss",
          "sox-section-404",
          "iso-27001",
          "kr-pipa",
          "flsa",
          "fmla",
          "cobra",
          "wage-act",
          "joint-commission",
          "hitech",
          "eeoc",
          "i9-everify"
        ]
      }
    },
    "audit_emission_points": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["node_id", "seal_kind"],
        "properties": {
          "node_id": { "type": "string" },
          "seal_kind": {
            "type": "string",
            "enum": [
              "decision-recorded",
              "policy-verdict",
              "external-call-receipt",
              "human-approval-signature",
              "transform-attestation",
              "termination-record"
            ]
          }
        }
      }
    },
    "cedar_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_id", "effect", "principal_scope", "resource_scope", "action_scope"],
      "properties": {
        "policy_id": { "type": "string", "pattern": "^cedar:oya-workflow-studio-template:[a-z0-9-]+$" },
        "effect": { "type": "string", "enum": ["permit", "forbid"] },
        "principal_scope": { "type": "string" },
        "resource_scope": { "type": "string" },
        "action_scope": { "type": "string" },
        "conditions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "connector_dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["connector_id", "operations"],
        "properties": {
          "connector_id": {
            "type": "string",
            "pattern": "^oya-shared-connector-[a-z0-9-]+$"
          },
          "operations": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "criticality": {
            "type": "string",
            "enum": ["required", "preferred", "optional"],
            "default": "required"
          }
        }
      }
    },
    "slo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_duration_seconds", "min_success_rate"],
      "properties": {
        "max_duration_seconds": { "type": "number", "minimum": 1 },
        "min_success_rate": { "type": "number", "minimum": 0, "maximum": 1 },
        "openslo_ref": { "type": "string" }
      }
    },
    "cost_model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "estimated_usd_per_execution_p50",
        "foundry_inference_usd",
        "connector_call_usd",
        "storage_usd"
      ],
      "properties": {
        "estimated_usd_per_execution_p50": { "type": "number", "minimum": 0 },
        "foundry_inference_usd": { "type": "number", "minimum": 0 },
        "connector_call_usd": { "type": "number", "minimum": 0 },
        "storage_usd": { "type": "number", "minimum": 0 }
      }
    },
    "test_mode_supported": { "type": "boolean" },
    "live_mode_supported": { "type": "boolean" },
    "documentation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "explainer_path": { "type": "string" },
        "fixture_path": { "type": "string" }
      }
    },
    "tags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  }
}
