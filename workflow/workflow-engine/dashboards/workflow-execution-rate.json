{
  "$schema": "https://schemas.grafana.com/dashboard.json",
  "_meta": {
    "doc_class": "GrafanaDashboard",
    "microservice": "workflow-engine",
    "owner_team": "ops-sre-reliability + axis-workflow",
    "audience": "internal operators + tenant operators (per-tenant view via tenant-scope.cedar)",
    "tenant_scoped": true,
    "datasource": "Mimir per-pack endpoints"
  },
  "uid": "wf-engine-execution-rate",
  "title": "Workflow Engine — Execution Rate",
  "tags": ["workflow-engine", "operator", "execution"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "templating": {
    "list": [
      {
        "name": "pack",
        "type": "custom",
        "options": [
          {"text": "pack-kr", "value": "kr", "selected": true},
          {"text": "pack-eu", "value": "eu"},
          {"text": "pack-us", "value": "us"},
          {"text": "pack-us-healthcare", "value": "us-hc"},
          {"text": "pack-jp", "value": "jp"},
          {"text": "pack-sg", "value": "sg"},
          {"text": "pack-au", "value": "au"},
          {"text": "pack-in", "value": "in"},
          {"text": "pack-br", "value": "br"},
          {"text": "pack-ae", "value": "ae"},
          {"text": "pack-ksa", "value": "ksa"}
        ],
        "label": "Pack"
      },
      {
        "name": "tenant",
        "type": "query",
        "label": "Tenant (hashed)",
        "datasource": "Mimir"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Active workflow runs",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "sum(oya_workflow_engine_active_runs{pack=\"$pack\",tenant_id=\"$tenant\"})",
          "legendFormat": "active",
          "refId": "A"
        },
        {
          "expr": "sum(oya_workflow_engine_paused_runs{pack=\"$pack\",tenant_id=\"$tenant\"})",
          "legendFormat": "paused",
          "refId": "B"
        },
        {
          "expr": "sum(oya_workflow_engine_waiting_runs{pack=\"$pack\",tenant_id=\"$tenant\"})",
          "legendFormat": "waiting",
          "refId": "C"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Runs started / completed / failed / cancelled per minute",
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "rate(oya_workflow_engine_runs_started_total{pack=\"$pack\",tenant_id=\"$tenant\"}[5m]) * 60",
          "legendFormat": "started/min",
          "refId": "A"
        },
        {
          "expr": "rate(oya_workflow_engine_runs_completed_total{pack=\"$pack\",tenant_id=\"$tenant\"}[5m]) * 60",
          "legendFormat": "completed/min",
          "refId": "B"
        },
        {
          "expr": "rate(oya_workflow_engine_runs_failed_total{pack=\"$pack\",tenant_id=\"$tenant\"}[5m]) * 60",
          "legendFormat": "failed/min",
          "refId": "C"
        },
        {
          "expr": "rate(oya_workflow_engine_runs_cancelled_total{pack=\"$pack\",tenant_id=\"$tenant\"}[5m]) * 60",
          "legendFormat": "cancelled/min",
          "refId": "D"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Top 10 specs by run count (last 24h)",
      "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "topk(10, sum by (spec_id) (increase(oya_workflow_engine_runs_started_total{pack=\"$pack\",tenant_id=\"$tenant\"}[24h])))",
          "legendFormat": "{{spec_id}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Stuck-run count (run_stuck_seconds > 3600)",
      "gridPos": {"x": 0, "y": 24, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "count(oya_workflow_engine_run_stuck_seconds{pack=\"$pack\",tenant_id=\"$tenant\"} > 3600)",
          "legendFormat": "stuck",
          "refId": "A"
        }
      ]
    }
  ]
}
