# Live-corpus gate: drives the orchestrator's READ-ONLY planner (`plan_registration`) over the real
# checkout. GREEN = an already-registered crate still plans to an empty edit set; the RED-fixture leg
# swaps in an unrelated owning ADR and asserts the planner discriminates (not inert); the FLOOR leg
# rejects a collapsed tracked-path universe. This is `register_crate`'s only non-fixture caller.
rust_test(
    name = "ci-crate-registration-gate",
    srcs = glob(["tests/**/*.rs"]),
    crate = "ci_crate_registration_corpus",
    crate_root = "tests/born_accounting_liveness.rs",
    visibility = ["PUBLIC"],
    deps = [
        ":ci-crate-registration",
        "//libs/oya-crate-registrar-kernel:oya-crate-registrar-kernel",
    ],
)

