{
  "title": "Compliance — Audit-chain seal health",
  "uid": "compliance-seal-health",
  "schemaVersion": 39,
  "panels": [
    {"id": 1, "title": "Seal verify success rate", "type": "stat",        "targets": [{"expr": "rate(compliance_seal_verify_success_total[5m]) / rate(compliance_seal_verify_total[5m])"}]},
    {"id": 2, "title": "EVT-AUDIT-SEAL-VERIFY-FAILED (Sev-1)", "type": "stat", "targets": [{"expr": "increase(compliance_seal_verify_failed_total[1h])"}]},
    {"id": 3, "title": "Cold-tier re-seal chain depth", "type": "timeseries", "targets": [{"expr": "compliance_cold_reseal_chain_depth"}]},
    {"id": 4, "title": "Sigstore Fulcio reachability",  "type": "stat",        "targets": [{"expr": "up{job=\"sigstore-fulcio\"}"}]},
    {"id": 5, "title": "Rekor log gap detection",       "type": "stat",        "targets": [{"expr": "compliance_rekor_gap_total"}]}
  ]
}
