{
  "title": "Compliance — Regulator Engagement Activity",
  "uid": "compliance-regulator-engagement-activity",
  "schemaVersion": 39,
  "tags": ["compliance", "auditor", "ADR-0243"],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Active engagements",
      "targets": [{ "expr": "sum(oya_compliance_regulator_engagement_active)" }]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Engagement evidence reads / minute",
      "targets": [{ "expr": "sum(rate(oya_compliance_auditor_read_total[1m]))" }]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Engagement export bundles / hour",
      "targets": [{ "expr": "sum(rate(oya_compliance_auditor_export_total[1h]))" }]
    },
    {
      "id": 4,
      "type": "table",
      "title": "Engagements by tenant + framework",
      "targets": [{ "expr": "sum by (tenant_id, framework) (oya_compliance_regulator_engagement_active)" }]
    }
  ],
  "binding_adrs": ["ADR-0243", "ADR-0263"]
}
