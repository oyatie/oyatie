{
  "title": "Compliance — Evidence coverage per framework",
  "uid": "compliance-evidence-coverage",
  "schemaVersion": 39,
  "panels": [
    {"id": 1, "title": "SOC 2 coverage %",   "type": "gauge", "targets": [{"expr": "100 * sum(compliance_required_artifacts_emitted{framework=\"soc2-type-2\"}) / sum(compliance_required_artifacts_total{framework=\"soc2-type-2\"})"}]},
    {"id": 2, "title": "GDPR coverage %",    "type": "gauge", "targets": [{"expr": "100 * sum(compliance_required_artifacts_emitted{framework=\"gdpr\"}) / sum(compliance_required_artifacts_total{framework=\"gdpr\"})"}]},
    {"id": 3, "title": "HIPAA coverage %",   "type": "gauge", "targets": [{"expr": "100 * sum(compliance_required_artifacts_emitted{framework=\"hipaa\"}) / sum(compliance_required_artifacts_total{framework=\"hipaa\"})"}]},
    {"id": 4, "title": "PCI-DSS coverage %", "type": "gauge", "targets": [{"expr": "100 * sum(compliance_required_artifacts_emitted{framework=\"pci-dss\"}) / sum(compliance_required_artifacts_total{framework=\"pci-dss\"})"}]},
    {"id": 5, "title": "Per-µservice gaps (count)", "type": "barchart", "targets": [{"expr": "count by (microservice) (compliance_coverage_gap)"}]}
  ]
}
