{
  "title": "Compliance — Breach Notification SLA",
  "uid": "compliance-breach-notification-sla",
  "schemaVersion": 39,
  "tags": ["compliance", "breach", "GDPR-Art-33"],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Open breach records",
      "targets": [{ "expr": "sum(compliance_breach_open)" }]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "72h clock — closest to breach",
      "targets": [{ "expr": "min(compliance_breach_seconds_remaining)" }]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Notify-authority latency (P95)",
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(compliance_breach_notify_seconds_bucket[5m])) by (le))" }]
    },
    {
      "id": 4,
      "type": "table",
      "title": "Breach scope by data-class",
      "targets": [{ "expr": "sum by (data_class) (compliance_breach_records_total)" }]
    }
  ],
  "binding_adrs": ["ADR-0251", "ADR-0263"]
}
