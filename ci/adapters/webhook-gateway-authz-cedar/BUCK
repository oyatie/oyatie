# Hermetic embedded-asset mapping (ADR-0545 / FRIC-1781131000-webhook-cedar-buck2):
# src/lib.rs include_str!("../../../webhook-gateway/policy/ci-webhook-gateway.cedar")
# resolves, relative to the including source file inside the buck2 __srcs tree, to
# ADAPTER_ROOT/../../../webhook-gateway/policy/... . The shared cedar policy lives in
# ci/webhook-gateway/policy, so it MUST be mapped into the sandbox at exactly that
# include-relative location.
ADAPTER_ROOT = "ci/adapters/webhook-gateway-authz-cedar"
ADAPTER_SRCS = glob(["src/**/*.rs", "migrations/**/*.sql", "**/*.cedar", "**/*.sql", "**/*.json", "**/*.toml", "**/*.yaml", "**/*.yml", "**/*.proto", "**/*.html", "**/*.css", "**/*.txt"])
ADAPTER_MAPPED_SRCS = {src: ADAPTER_ROOT + "/" + src for src in ADAPTER_SRCS}
ADAPTER_MAPPED_SRCS["//ci/webhook-gateway/policy:ci-webhook-gateway.cedar"] = "ci/webhook-gateway/policy/ci-webhook-gateway.cedar"

rust_library(
    name = "ci-webhook-gateway-authz-cedar",
    srcs = [],
    crate = "ci_webhook_gateway_authz_cedar",
    crate_root = ADAPTER_ROOT + "/src/lib.rs",
    visibility = ["PUBLIC"],
    mapped_srcs = ADAPTER_MAPPED_SRCS,
    deps = [
        "//ci/core/webhook-gateway-kernel:ci-webhook-gateway-kernel",
        "third-party//:cedar-policy",
    ],
)

rust_test(
    name = "ci-webhook-gateway-authz-cedar-d6-cedar-authz-test",
    srcs = glob(["tests/d6_cedar_authz.rs"]),
    crate = "ci_webhook_gateway_authz_cedar_d6_cedar_authz_test",
    crate_root = "tests/d6_cedar_authz.rs",
    visibility = ["PUBLIC"],
    deps = [
        ":ci-webhook-gateway-authz-cedar",
        "//ci/core/webhook-gateway-kernel:ci-webhook-gateway-kernel",
    ],
)
