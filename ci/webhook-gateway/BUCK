


# Corpus graph extraction (ADR-0541).
genrule(
    name = "corpus-yaml-facts",
    srcs = glob(["**/*.yaml", "**/*.yml"]),
    out = "yaml-facts.json",
    cmd = "$(exe //governance/corpus/extract:yaml-facts) --target root//ci/webhook-gateway:corpus-yaml-facts --prefix ci/webhook-gateway --out $OUT $SRCS",
)
