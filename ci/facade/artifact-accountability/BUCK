# GATE-2 :total-accounting-gate — the fixture-corpus + born-blocking self-test gate.
# Globs specs/fixtures/total-accounting/tc-*.json (the data-under-test) and asserts
# report.violations == fixture.expected_violations. G-INTEGRITY track: no build-graph dep.
# (Named -gate to avoid a buck2 in-package collision with the rust_library above; the
# package //ci/facade/artifact-accountability carries the §5.3 :total-accounting identity.)
rust_test(
    name = "ci-artifact-accountability-gate",
    srcs = glob(["tests/**/*.rs"]),
    crate = "ci_artifact_accountability_corpus",
    crate_root = "tests/total_accounting.rs",
    # HERMETIC: the test execs the buck2-BUILT producer binary (no `env!("CARGO")`, no `cargo
    # run`). `$(exe ...)` makes buck2 build the producer and substitute its sandbox path here;
    # the producer reads the committed scm-facts face (a declared input) — no action calls git.
    env = {
        "OYA_CI_PRODUCER_BIN": "$(exe //ci/facade/artifact-inventory-registry:oya-cloud-ci-accounting-registry-app-bin)",
    },
    visibility = ["PUBLIC"],
    deps = [
        ":ci-artifact-accountability",
        "//ci/adapters/path-resolver:ci-path-resolver-adapters",
        "//ci/facade/artifact-inventory-registry:ci-artifact-inventory-registry",
        "third-party//:serde_json",
    ],
)
