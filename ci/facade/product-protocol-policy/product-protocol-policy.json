{
  "gate_id": "cloud-ci-product-protocol-policy",
  "schema_version": "1.0.0",
  "artifacts": {
    "product_contract": "specs/product-protocol-contract.json",
    "api_contract_ssot": "specs/api-contract-ssot-canonical.json",
    "transport_profile": "network/ports/transport-profile/endpoint-transport-profile.contract.json",
    "root_hub": "specs/root-hub-pointers.json"
  },
  "rules": [
    {"code": "PP-CONTRACT-ID", "artifact": "product_contract", "pointer": "/spec_id", "mode": "equals", "expected": "EXE-PRODUCT-PROTOCOL-CONTRACT"},
    {"code": "PP-CONTRACT-STATUS", "artifact": "product_contract", "pointer": "/status", "mode": "equals", "expected": "Accepted"},
    {"code": "PP-CONTRACT-AUTHORITY", "artifact": "product_contract", "pointer": "/authority/adr", "mode": "equals", "expected": "ADR-0632"},
    {"code": "PP-PUBLIC-ALLOWED", "artifact": "product_contract", "pointer": "/public_api/allowed_protocols", "mode": "unordered_equals", "expected": ["https-rest", "versioned-webhooks", "sse", "websocket"]},
    {"code": "PP-PUBLIC-FORBIDDEN", "artifact": "product_contract", "pointer": "/public_api/forbidden_protocols", "mode": "unordered_equals", "expected": ["graphql", "grpc", "grpc-web", "connect"]},
    {"code": "PP-OPENAPI-VERSION", "artifact": "product_contract", "pointer": "/public_api/contracts/openapi", "mode": "equals", "expected": "3.2.0"},
    {"code": "PP-ASYNCAPI-VERSION", "artifact": "product_contract", "pointer": "/public_api/contracts/asyncapi", "mode": "equals", "expected": "3.1.0"},
    {"code": "PP-CLOUDEVENTS-VERSION", "artifact": "product_contract", "pointer": "/public_api/contracts/cloudevents", "mode": "equals", "expected": "1.0.2"},
    {"code": "PP-CLOUDEVENTS-WEBSOCKET-NONCLAIM", "artifact": "product_contract", "pointer": "/public_api/contracts/cloudevents_websocket_binding", "mode": "equals", "expected": "not-claimed"},
    {"code": "PP-PUBLIC-EDGE-PREFERENCE", "artifact": "product_contract", "pointer": "/public_api/transport/edge_preference", "mode": "equals", "expected": "http3"},
    {"code": "PP-PUBLIC-EDGE-FALLBACK", "artifact": "product_contract", "pointer": "/public_api/transport/fallback", "mode": "equals", "expected": "http2"},
    {"code": "PP-PUBLIC-TLS", "artifact": "product_contract", "pointer": "/public_api/transport/tls_minimum", "mode": "equals", "expected": "1.3"},
    {"code": "PP-INTERNAL-EXPOSURE", "artifact": "product_contract", "pointer": "/internal_rpc/exposure", "mode": "equals", "expected": "internal-only"},
    {"code": "PP-INTERNAL-GRPC", "artifact": "product_contract", "pointer": "/internal_rpc/protocol", "mode": "equals", "expected": "grpc"},
    {"code": "PP-INTERNAL-H2", "artifact": "product_contract", "pointer": "/internal_rpc/http_transport", "mode": "equals", "expected": "http2"},
    {"code": "PP-INTERNAL-PROTOBUF", "artifact": "product_contract", "pointer": "/internal_rpc/schema_system", "mode": "equals", "expected": "protobuf"},
    {"code": "PP-INTERNAL-PROTO3", "artifact": "product_contract", "pointer": "/internal_rpc/language_profile", "mode": "equals", "expected": "proto3"},
    {"code": "PP-INTERNAL-MTLS", "artifact": "product_contract", "pointer": "/internal_rpc/identity_transport", "mode": "equals", "expected": "spiffe-mtls-tls13"},
    {"code": "PP-FLATBUFFERS-DERIVED", "artifact": "product_contract", "pointer": "/serialization/flatbuffers/status", "mode": "equals", "expected": "benchmark-gated-derived-adapter"},
    {"code": "PP-FLATBUFFERS-NONCANONICAL", "artifact": "product_contract", "pointer": "/serialization/flatbuffers/canonical", "mode": "equals", "expected": false},
    {"code": "PP-TELEMETRY-BASELINE", "artifact": "product_contract", "pointer": "/telemetry/baseline", "mode": "unordered_equals", "expected": ["opentelemetry", "cilium", "hubble"]},
    {"code": "PP-CUSTOM-EBPF-GATE", "artifact": "product_contract", "pointer": "/telemetry/custom_ebpf", "mode": "equals", "expected": "measured-gap-and-security-review-only"},
    {"code": "PP-FABRIC-PROVIDER-OWNED", "artifact": "product_contract", "pointer": "/fabric/provider_owned", "mode": "unordered_equals", "expected": ["bgp-clos", "evpn-vxlan", "physical-switching", "asic-programming"]},
    {"code": "PP-FABRIC-DEFERRED", "artifact": "product_contract", "pointer": "/fabric/deferred_owned_profiles", "mode": "unordered_equals", "expected": ["sonic", "sai", "gnmi-mutating", "gnoi-mutating", "uec", "rocev2", "nvme-rdma", "fibre-channel"]},
    {"code": "PP-NVME-TCP-FIRST", "artifact": "product_contract", "pointer": "/fabric/disaggregated_storage_first_profile", "mode": "equals", "expected": "nvme-tcp"},
    {"code": "PP-API-SSOT-PROTOCOL-REF", "artifact": "api_contract_ssot", "pointer": "/product_protocol_contract", "mode": "equals", "expected": "specs/product-protocol-contract.json"},
    {"code": "PP-API-SSOT-PUBLIC", "artifact": "api_contract_ssot", "pointer": "/exposure_policy/public", "mode": "unordered_equals", "expected": ["rest", "versioned-webhooks", "asyncapi-events", "sse", "websocket"]},
    {"code": "PP-API-SSOT-INTERNAL", "artifact": "api_contract_ssot", "pointer": "/exposure_policy/internal_only", "mode": "unordered_equals", "expected": ["grpc", "grpc-streaming", "proto3"]},
    {"code": "PP-API-SSOT-FORBIDDEN", "artifact": "api_contract_ssot", "pointer": "/exposure_policy/forbidden_public", "mode": "unordered_equals", "expected": ["graphql", "grpc", "grpc-web", "connect"]},
    {"code": "PP-TRANSPORT-PROTOCOL-REF", "artifact": "transport_profile", "pointer": "/product_protocol_contract", "mode": "equals", "expected": "specs/product-protocol-contract.json"},
    {"code": "PP-TRANSPORT-EXTERNAL-H3", "artifact": "transport_profile", "pointer": "/capability_classes/0/default_protocol", "mode": "equals", "expected": "http3"},
    {"code": "PP-TRANSPORT-EXTERNAL-H2-FALLBACK", "artifact": "transport_profile", "pointer": "/capability_classes/0/fallback_protocol", "mode": "equals", "expected": "http2"},
    {"code": "PP-TRANSPORT-INTERCELL-GRPC-H2", "artifact": "transport_profile", "pointer": "/capability_classes/1/default_protocol", "mode": "equals", "expected": "grpc_http2"},
    {"code": "PP-TRANSPORT-INTERNAL-GRPC-H2", "artifact": "transport_profile", "pointer": "/capability_classes/2/default_protocol", "mode": "equals", "expected": "grpc_http2"},
    {"code": "PP-ROOT-HUB", "artifact": "root_hub", "pointer": "/entry_points/product_protocol_contract/current_path", "mode": "equals", "expected": "/specs/product-protocol-contract.json"}
  ]
}
