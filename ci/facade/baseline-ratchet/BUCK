# Typed terminal-state ADAPTER. Fetches the run/jobs/annotations JSON from the Actions REST API
# and hands it to the pure kernel; it holds no classification logic of its own. It talks to the API
# directly rather than through `gh`, because `gh` is absent from the owned arm64 runner image (the
# reason the sibling trusted-baseline fast path is silently dead there). Wired as an additive step
# in the `oya-ci-required` fan-in: it never decides admission and always exits 0.
rust_binary(
    name = "oya-cloud-ci-run-terminal-state-bin",
    srcs = ["src/bin/oya-cloud-ci-run-terminal-state.rs"],
    crate = "oya_cloud_ci_run_terminal_state",
    crate_root = "src/bin/oya-cloud-ci-run-terminal-state.rs",
    visibility = ["PUBLIC"],
    deps = [
        ":ci-baseline-ratchet",
        "third-party//:reqwest",
        "third-party//:serde_json",
    ],
)

