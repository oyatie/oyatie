rust_library(
    name = "ci-layer-dependency-acyclicity",
    srcs = glob(["src/**/*.rs", "**/*.json"]),
    crate = "ci_layer_dependency_acyclicity",
    crate_root = "src/lib.rs",
    visibility = ["PUBLIC"],
    deps = [
        "third-party//:serde_json",
        # ADR-0563 rename-aware relabel: the frozen baseline is keyed on crate DIRS, so a
        # capability move+rename strands every subject naming a moved dir as a phantom.
        "//ci/adapters/path-resolver:ci-path-resolver-adapters",
    ],
)

# Gate binary (Phase-0 reorg; ADR-0245/0280/0562). Collects the live crate/dep/tier corpus, loads the
# policy + frozen baseline, evaluates, prints the report, and exits 0 (GREEN) / 1 (RED, a regression)
# / 2 (parse/io error). LOCAL BRIDGE feedback only (founder CLI-retirement directive): merge authority
# is the gate test below behind oya-ci-required, never this binary.
rust_binary(
    name = "oya-cloud-ci-tier-dependency-acyclicity-bin",
    srcs = glob(["src/**/*.rs", "**/*.json"]),
    crate_root = "src/main.rs",
    visibility = ["PUBLIC"],
    deps = [
        ":ci-layer-dependency-acyclicity",
        "third-party//:serde_json",
    ],
)

# Pure-kernel unit tests: tier-rule classification, S-rank inversion, Tarjan cycle detection,
# baseline split (baselined vs regression), cargo/buck dep extraction, and the false-green floor —
# all proven WITHOUT a filesystem.
rust_test(
    name = "ci-layer-dependency-acyclicity-unittest",
    srcs = glob(["src/**/*.rs", "**/*.json"]),
    crate = "ci_layer_dependency_acyclicity",
    crate_root = "src/lib.rs",
    visibility = ["PUBLIC"],
    deps = [
        "third-party//:serde_json",
        "//ci/adapters/path-resolver:ci-path-resolver-adapters",
    ],
)

# Phase-0 capability-first reorg (ADR-0245/0280/0562): the born-ADVISORY self-test over the REAL crate
# dependency graph (cargo path-deps + buck deps) projected through the live per-service manifest tier
# facets. Asserts the live tree is GREEN (zero REGRESSIONS vs the freshly-frozen baseline), that every
# baselined entry is still observed (the baseline is neither stale nor over-broad), plus the on-disk
# RED fixture (a synthetic substrate->product edge MUST fail) and the burn-down fixture (removing a
# baselined violation keeps the gate green).
rust_test(
    name = "ci-layer-dependency-acyclicity-gate",
    srcs = glob(["tests/**/*.rs", "**/*.json"]),
    crate = "ci_layer_dependency_acyclicity_gate",
    crate_root = "tests/tier_dependency_acyclicity.rs",
    visibility = ["PUBLIC"],
    deps = [
        ":ci-layer-dependency-acyclicity",
        "third-party//:serde_json",
    ],
)
