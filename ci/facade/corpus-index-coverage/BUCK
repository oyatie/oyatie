rust_library(
    name = "ci-corpus-index-coverage",
    srcs = glob(["src/**/*.rs", "**/*.json"]),
    crate = "ci_corpus_index_coverage",
    crate_root = "src/lib.rs",
    visibility = ["PUBLIC"],
    deps = [
        "third-party//:serde",
        "third-party//:serde_json",
    ],
)

# Pure-kernel unit tests: coverage is COMPUTED from observations, the ratchet blocks a new
# uncovered package, an empty scan fails closed instead of reporting perfect coverage, and slack in
# the ceiling is reported. All proven WITHOUT a filesystem.
rust_test(
    name = "ci-corpus-index-coverage-unittest",
    srcs = glob(["src/**/*.rs", "**/*.json"]),
    crate = "ci_corpus_index_coverage",
    crate_root = "src/lib.rs",
    visibility = ["PUBLIC"],
    deps = [
        "third-party//:serde",
        "third-party//:serde_json",
    ],
)

# Live-corpus gate: walks the real tree, attributes every YAML file to its owning buck2 package,
# computes coverage, and evaluates against the frozen ceiling. Carries the RED fixture proving a
# new uncovered package fails, so the gate is demonstrated capable of failing.
rust_test(
    name = "ci-corpus-index-coverage-gate",
    srcs = glob(["tests/**/*.rs", "**/*.json"]),
    crate = "ci_corpus_index_coverage_gate",
    crate_root = "tests/corpus_index_coverage.rs",
    visibility = ["PUBLIC"],
    deps = [
        ":ci-corpus-index-coverage",
        "third-party//:serde_json",
    ],
)
