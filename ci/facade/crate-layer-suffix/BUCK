# §2.5#4 :bnf-layer-suffix — the born-blocking self-test over the live corpus. Runs the producer
# `--face bnf-layer-suffix` to resolve the live oya-* crate names, then asserts the gate fires
# (non-canonical trailing segments exist today) and reports the measured count. G-INTEGRITY
# track: no build-graph dep. (Named -gate to avoid an in-package buck2 collision with the
# rust_library above; the package identity carries the §5.3 :bnf-layer-suffix gate.)
rust_test(
    name = "ci-crate-layer-suffix-gate",
    srcs = glob(["tests/**/*.rs"]),
    crate = "ci_crate_layer_suffix_corpus",
    crate_root = "tests/bnf_layer_suffix.rs",
    # HERMETIC: the test execs the buck2-BUILT producer binary (no `env!("CARGO")`, no `cargo
    # run`). `$(exe ...)` makes buck2 build the producer and substitute its sandbox path here;
    # the producer reads the committed scm-facts face (a declared input) — no action calls git.
    env = {
        "OYA_CI_PRODUCER_BIN": "$(exe //ci/facade/artifact-inventory-registry:oya-cloud-ci-accounting-registry-app-bin)",
    },
    visibility = ["PUBLIC"],
    deps = [
        ":ci-crate-layer-suffix",
        "//ci/adapters/corpus-census:ci-corpus-census-adapters",
        "//ci/adapters/path-resolver:ci-path-resolver-adapters",
        "//ci/facade/artifact-inventory-registry:ci-artifact-inventory-registry",
        "third-party//:serde_json",
    ],
)
