# ADR-0554 decision fixtures: pins the cf16525 false-green class (out-of-scope source must land
# in the decided set) + every fail-closed seam (escape->FULL, deletion->FULL, unowned->REFUSE).
# `.github/**` synthetic-seed completeness gate. `.github/**` has no buck2 owner() (it is a
# whole-tree-scanner INPUT, not a declared src), so the affected cone reaches its real consumers
# only through the synthetic_dependencies declaration. This target proves the declaration reaches
# the verdict end-to-end AND derives the consumer set from the tree, so the hand-maintained seed
# list cannot silently rot the way the reverted `[]`-inert declaration did.
rust_test(
    name = "ci-affected-target-set-github-consumer-coverage",
    srcs = glob(["tests/**/*.rs", "**/*.json"]),
    crate = "ci_affected_target_set_github_consumer_coverage",
    crate_root = "tests/github_consumer_coverage.rs",
    visibility = ["PUBLIC"],
    deps = [
        ":ci-affected-target-set",
    ],
)

