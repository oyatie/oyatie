# ADR-0554 round-3 build-health ratchet: compares the buck2 build-report failure set at the PR
# head against the merge-base, blocking only REGRESSIONS (grandfathering pre-existing build debt)
# so the FULL tier is a ratchet, not a flag-day requirement. Reuses the ADR-0551 merge-base
# frozen-baseline pattern; the merge-base report is materialized out-of-band (never candidate-controlled).
rust_binary(
    name = "oya-cloud-ci-build-health-bin",
    srcs = glob(["src/**/*.rs"]),
    crate_root = "src/bin/oya-cloud-ci-build-health.rs",
    visibility = ["PUBLIC"],
    deps = [
        ":ci-affected-target-set",
        "third-party//:serde_json",
    ],
)

# GH #1323 trusted-baseline fast path. This binary is deliberately network-free:
# the workflow supplies immutable GitHub API JSON and the owned Rust selector
# emits a deterministic SELECTED/FALLBACK/ERROR decision.
rust_binary(
    name = "oya-cloud-ci-trusted-baseline-selector-bin",
    srcs = glob(["src/**/*.rs"]),
    crate_root = "src/bin/oya-cloud-ci-trusted-baseline-selector.rs",
    visibility = ["PUBLIC"],
    deps = [
        ":ci-affected-target-set",
        "third-party//:serde_json",
    ],
)

