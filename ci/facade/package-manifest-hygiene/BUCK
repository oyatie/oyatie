# §2.5#7 :manifest-hygiene — the born-blocking self-test over the live corpus. Runs the producer
# `--face manifest-hygiene` to resolve the per-crate manifest flags, then asserts the gate fires
# (some first-party oya-* crates miss a §2.5#7 field today) and reports the measured count.
# G-INTEGRITY track: no build-graph dep. (Named -gate to avoid an in-package buck2 collision.)
rust_test(
    name = "ci-package-manifest-hygiene-gate",
    srcs = glob(["tests/**/*.rs"]),
    crate = "ci_package_manifest_hygiene_corpus",
    crate_root = "tests/manifest_hygiene.rs",
    # HERMETIC: the test execs the buck2-BUILT producer binary (no `env!("CARGO")`, no `cargo
    # run`). `$(exe ...)` makes buck2 build the producer and substitute its sandbox path here;
    # the producer reads the committed scm-facts face (a declared input) — no action calls git.
    env = {
        "OYA_CI_PRODUCER_BIN": "$(exe //ci/facade/artifact-inventory-registry:oya-cloud-ci-accounting-registry-app-bin)",
    },
    visibility = ["PUBLIC"],
    deps = [
        ":ci-package-manifest-hygiene",
        "//ci/adapters/corpus-census:ci-corpus-census-adapters",
        "//ci/adapters/path-resolver:ci-path-resolver-adapters",
        "//ci/facade/artifact-inventory-registry:ci-artifact-inventory-registry",
        "third-party//:serde_json",
    ],
)
