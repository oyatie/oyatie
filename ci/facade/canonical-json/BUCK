rust_library(
    name = "ci-canonical-json",
    srcs = glob(["src/**/*.rs", "**/*.json"]),
    crate = "ci_canonical_json",
    crate_root = "src/lib.rs",
    visibility = ["PUBLIC"],
    deps = [
        "third-party//:serde_json",
    ],
)

# Gate + fixer binary (ADR-0546). Default = check; `--fix` rewrites non-canonical files. LOCAL BRIDGE
# feedback only (founder CLI-retirement directive): merge authority is the gate test below, never this
# binary. `buck2 run ... -- --fix` is the one-command fixer the friction's enforcement_fix promises.
rust_binary(
    name = "oya-cloud-ci-canonical-json-bin",
    srcs = glob(["src/**/*.rs", "**/*.json"]),
    crate_root = "src/main.rs",
    visibility = ["PUBLIC"],
    deps = [
        ":ci-canonical-json",
        "third-party//:serde_json",
    ],
)

rust_test(
    name = "ci-canonical-json-unittest",
    srcs = glob(["src/**/*.rs", "**/*.json"]),
    crate = "ci_canonical_json",
    crate_root = "src/lib.rs",
    visibility = ["PUBLIC"],
    deps = [
        "third-party//:serde_json",
    ],
)

# ADR-0546 canonical-json: Buck2-native live-corpus self-test over the real governed JSON corpus. It
# collects the policy-declared roots, canonicalizes each committed file, and asserts the live corpus
# is born-blocking GREEN (zero baseline) so any NEW non-canonical governed json fails closed. RED
# fixtures (in the lib unittest) prove every violation class fails closed without a filesystem.
rust_test(
    name = "ci-canonical-json-gate",
    srcs = glob(["tests/**/*.rs", "**/*.json"]),
    crate = "ci_canonical_json_gate",
    crate_root = "tests/canonical_json.rs",
    visibility = ["PUBLIC"],
    deps = [
        ":ci-canonical-json",
        "third-party//:serde_json",
    ],
)
