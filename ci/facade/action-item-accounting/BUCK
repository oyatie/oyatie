rust_test(
    name = "fixuptask-v2-admission",
    # Exact durable composition: no recursive source glob and no legacy crate.
    srcs = [
        "src/fixuptask_v2.rs",
        "fixuptask-v2-schema.json",
    ],
    crate = "ci_fixuptask_v2",
    crate_root = "src/fixuptask_v2.rs",
    visibility = ["PUBLIC"],
    deps = [
        "third-party//:serde_json",
        "third-party//:sha2",
    ],
)

