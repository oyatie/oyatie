rust_library(
    name = "ci-action-item-accounting",
    srcs = glob(["src/**/*.rs", "**/*.json"]),
    crate = "ci_action_item_accounting",
    crate_root = "src/lib.rs",
    visibility = ["PUBLIC"],
    deps = [
        "third-party//:serde_json",
        "third-party//:sha2",
    ],
)

