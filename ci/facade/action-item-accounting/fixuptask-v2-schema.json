{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.oyatie.com/schemas/fixuptask-v2.schema.json",
  "title": "FixupTask v2 candidate-row contract",
  "description": "Strict contract for rows introduced or modified relative to a protected merge base. Unchanged legacy rows are evaluated only by merge-base equality, never a candidate-supplied baseline.",
  "type": "object",
  "required": ["id", "title", "priority", "status", "source_session", "source_change_id", "named_in", "created_at", "accountable_owner", "accountable_role", "acceptance_criteria", "verification_path", "blocker_for"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "priority": { "type": "string", "minLength": 1 },
    "status": { "enum": ["open", "in-progress", "blocked", "resolved", "accepted-risk"] },
    "source_session": { "type": "string", "minLength": 1 },
    "source_change_id": { "type": "string", "minLength": 1 },
    "named_in": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time", "minLength": 1 },
    "accountable_owner": { "type": "string", "minLength": 1 },
    "accountable_role": { "type": "string", "minLength": 1 },
    "acceptance_criteria": { "type": "string", "minLength": 1 },
    "verification_path": { "type": "string", "minLength": 1 },
    "blocker_for": { "type": "string", "minLength": 1 },
    "resolved_at": { "type": "string", "minLength": 1 },
    "resolved_in_change_id": { "type": "string", "minLength": 1 },
    "resolved_evidence": { "type": "string", "minLength": 1 },
    "qualified_human_decision_ref": { "type": "string", "minLength": 1 },
    "accepted_risk_expires_at": { "type": "string", "format": "date-time", "minLength": 1 },
    "accepted_risk_evidence": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "resolved" } } },
      "then": { "required": ["resolved_at", "resolved_in_change_id", "resolved_evidence"] }
    },
    {
      "if": { "properties": { "status": { "const": "accepted-risk" } } },
      "then": { "required": ["qualified_human_decision_ref", "accepted_risk_expires_at", "accepted_risk_evidence"] }
    },
    {
      "if": { "properties": { "status": { "const": "blocked" } } },
      "then": { "required": ["qualified_human_decision_ref"] }
    }
  ]
}
