# ADR-0017 :cargo-prefix — the born-blocking self-test over the live corpus. Reads the
# materialized scm-facts snapshot from the source tree, then runs the producer `--face cargo-prefix`
# to resolve the live workspace members + package names and asserts the gate's verdict matches the
# live corpus. Named -gate to avoid an in-package buck2 collision with the rust_library above; the
# package identity carries the :cargo-prefix gate.
rust_test(
    name = "ci-crate-name-prefix-gate",
    srcs = glob(["tests/**/*.rs"]),
    crate = "ci_crate_name_prefix_corpus",
    crate_root = "tests/cargo_prefix.rs",
    # HERMETIC: the test execs the buck2-built pure producer binary only. The scm-facts emitter is
    # the single ambient-git boundary and must run before gate tests via producer-regen/materialization,
    # not inside this rust_test.
    env = {
        "OYA_CI_PRODUCER_BIN": "$(exe //ci/facade/artifact-inventory-registry:oya-cloud-ci-accounting-registry-app-bin)",
    },
    visibility = ["PUBLIC"],
    deps = [
        ":ci-crate-name-prefix",
        "//ci/adapters/path-resolver:ci-path-resolver-adapters",
        "//ci/facade/artifact-inventory-registry:ci-artifact-inventory-registry",
        "third-party//:serde_json",
    ],
)
