# ADR-0109 lifecycle-status: Buck2-native live-corpus gate over EVERY config in
# specs/lifecycle-configs/. Two dimensions:
#   (1) COMPLETENESS — every config on disk is evaluated and every baselined lane still exists, so a
#       config can never be born dark (the exact failure the nine tools/ dev-CLIs represented);
#   (2) SHRINK-ONLY violation ratchet — per (lane, violation_kind) counts may not grow, and a NEW
#       (lane, kind) pair is born-blocking.
# RED fixtures in the lib unittest prove every violation class fails closed without a filesystem.
rust_test(
    name = "ci-lifecycle-status-gate",
    srcs = glob(["tests/**/*.rs", "**/*.json"]),
    crate = "ci_lifecycle_status_gate",
    crate_root = "tests/lifecycle_status.rs",
    visibility = ["PUBLIC"],
    deps = [
        ":ci-lifecycle-status",
        "//governance/check/lifecycle-kernel:check-lifecycle-kernel",
        "third-party//:serde_json",
    ],
)
