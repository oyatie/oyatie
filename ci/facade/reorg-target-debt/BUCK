# Gate + baseline-regeneration + interval-audit binary. LOCAL BRIDGE feedback only: merge
# authority is the gate test below behind oya-ci-required, never this binary.
# `buck2 run ... -- --regen-baseline` is the one-command regeneration the gate's shrink-only
# failure messages name; `--mode audit --commit-set <capture>` is the deterministic
# fail-closed interval audit (git I/O stays at the caller boundary; see policy audit_mode).
rust_binary(
    name = "ci-reorg-target-debt-bin",
    srcs = glob(["src/**/*.rs", "**/*.json"]),
    crate_root = "src/main.rs",
    visibility = ["PUBLIC"],
    deps = [
        ":ci-reorg-target-debt",
        "third-party//:serde_json",
    ],
)

