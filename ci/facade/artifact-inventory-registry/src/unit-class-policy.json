{
  "$comment": "DATA-TABLED carve-outs for the accounting-registry producer (Linus: the exception lives in the table, never in the scanner). Each rule maps a path predicate to a unit_class; the FIRST matching rule (top-to-bottom) wins, so order is significant. The classifier in producer code has ZERO special-case branches — it only walks this table. Adding/removing a carve-out is a DATA edit here, re-runnable by the producer; the registry-drift test makes any hand-edit to the generated face RED. unit_class enum (PHASE-0-FIREWALL-PLAN §5.1): code|doc|spec|registry|evidence|vendor|build_config|generated|ephemeral|husk|scratch. The `scratch` class is SHAPE-based (a build/test artifact identified by its name/location, NOT by registration): zero-tolerance, never grandfathered, and CANNOT be suppressed by registering owner/justification/reachability (that registration-laundering hole is exactly what the dedicated class closes; its admission code retired with the total-accounting gate, ADR-0718, but the class still drives the registry verdict). Scratch rules sit ABOVE the legitimate-class rules so a scratch shape wins regardless.",
  "match_kinds": {
    "prefix": "path starts with the given string",
    "suffix": "path ends with the given string (basename or extension)",
    "contains": "path contains the given substring",
    "exact": "path equals the given string",
    "root_suffix": "path is at repo root (carries no '/' separator) AND ends with the given string",
    "root_exact": "path is at repo root (carries no '/' separator) AND equals the given string"
  },
  "rules": [
    { "id": "scratch-root-log",            "kind": "root_suffix", "value": ".log",                                       "unit_class": "scratch" },
    { "id": "scratch-root-tmp",            "kind": "root_suffix", "value": ".tmp",                                       "unit_class": "scratch" },
    { "id": "scratch-root-run-sh",         "kind": "root_suffix", "value": "run-slice.sh",                               "unit_class": "scratch" },
    { "id": "scratch-root-retest-targets", "kind": "root_exact",  "value": "retest-targets.txt",                         "unit_class": "scratch" },
    { "id": "scratch-kernel-conformance",  "kind": "contains",    "value": "cloud-kernel/out/conformance/",              "unit_class": "scratch" },
    { "id": "scratch-kernel-stress",       "kind": "exact",       "value": "cloud/cloud-kernel/out/stress-summary.txt",  "unit_class": "scratch" },

    { "id": "ephemeral-omc-state",        "kind": "contains", "value": "/.omc/state/",          "unit_class": "ephemeral" },
    { "id": "ephemeral-omc-state-top",    "kind": "prefix",   "value": ".omc/state/",            "unit_class": "ephemeral" },
    { "id": "ephemeral-omc-sessions",     "kind": "prefix",   "value": ".omc/sessions/",         "unit_class": "ephemeral" },
    { "id": "ephemeral-jsonl",            "kind": "suffix",   "value": ".jsonl",                 "unit_class": "ephemeral" },

    { "id": "vendor-third-party",         "kind": "prefix",   "value": "third-party/",           "unit_class": "vendor" },
    { "id": "vendor-dir",                 "kind": "contains", "value": "/vendor/",               "unit_class": "vendor" },

    { "id": "generated-face",             "kind": "suffix",   "value": ".generated.json",        "unit_class": "generated" },
    { "id": "generated-cargo-lock",       "kind": "suffix",   "value": "Cargo.lock",             "unit_class": "generated" },
    { "id": "generated-machine-readable", "kind": "prefix",   "value": "docs/machine-readable/", "unit_class": "generated" },

    { "id": "build-config-buck",          "kind": "suffix",   "value": "BUCK",                   "unit_class": "build_config" },
    { "id": "build-config-buckconfig",    "kind": "suffix",   "value": ".buckconfig",            "unit_class": "build_config" },
    { "id": "build-config-cargo-toml",    "kind": "suffix",   "value": "Cargo.toml",             "unit_class": "build_config" },
    { "id": "build-config-toolchain",     "kind": "suffix",   "value": "rust-toolchain.toml",    "unit_class": "build_config" },

    { "id": "evidence-tree",             "kind": "prefix",   "value": "evidence/",              "unit_class": "evidence" },
    { "id": "evidence-multispectrum",    "kind": "contains", "value": "/multispectrum/",        "unit_class": "evidence" },

    { "id": "registry-tree",             "kind": "prefix",   "value": "registry/",              "unit_class": "registry" },
    { "id": "registry-fixtures",         "kind": "contains", "value": "specs/fixtures/",        "unit_class": "registry" },

    { "id": "spec-tree",                 "kind": "prefix",   "value": "specs/",                 "unit_class": "spec" },
    { "id": "spec-contracts",           "kind": "prefix",   "value": "contracts/",            "unit_class": "spec" },
    { "id": "spec-governance-capability-registry", "kind": "exact", "value": "governance/capability-registry.json", "unit_class": "spec" },

    { "id": "doc-decisions",            "kind": "prefix",   "value": "docs/decisions/",       "unit_class": "doc" },
    { "id": "doc-tree",                 "kind": "prefix",   "value": "docs/",                 "unit_class": "doc" },
    { "id": "doc-md",                   "kind": "suffix",   "value": ".md",                   "unit_class": "doc" },

    { "id": "code-rust",               "kind": "suffix",   "value": ".rs",                   "unit_class": "code" },

    { "id": "default-husk",            "kind": "prefix",   "value": "",                      "unit_class": "husk" }
  ]
}
