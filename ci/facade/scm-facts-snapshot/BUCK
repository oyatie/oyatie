    srcs = ["src/bin/adr-census-epoch-receipt-gate.rs"],
    crate_root = "src/bin/adr-census-epoch-receipt-gate.rs",
    visibility = ["PUBLIC"],
    deps = [":ci-scm-facts-snapshot-lib"],
)

rust_binary(
