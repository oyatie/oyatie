# The SINGLE out-of-graph git boundary (OYA-CI-HERMETIC-EXECUTION-DESIGN §1.5, Option C).
# buck2 BUILDS this rust_binary (so it is itself a hermetic, cacheable artifact), but it is
# RUN by the CI scm-facts-regen pre-step + the local regen hook — NEVER inside a cacheable
# buck2 action. It shells git ONCE at the build-graph edge and writes the
# registry-drift-protected scm-facts.generated.json face. ADR-0604 de-commit class: the face is
# NOT tracked in git and NOT a buck source member; the producer + every gate rust_test consume
# the materialized on-disk face from the repo root, so no buck2 action ever calls git.
rust_binary(
    name = "ci-scm-facts-snapshot",
    srcs = glob(["src/**/*.rs"]),
    crate_root = "src/main.rs",
    visibility = ["PUBLIC"],
    deps = [
        # Move-aware path resolution (keystone unblock): the candidate/current seed + the
        # manifest+history-driven merge-base name for the frozen ratchet reference.
        "//ci/ports/path-resolver:ci-path-resolver-ports",
        "//ci/adapters/path-resolver:ci-path-resolver-adapters",
        # Reuse the producer's exact canonicalizer so the scm-facts face is byte-formatted
        # identically to the other five faces.
        "//ci/facade/artifact-inventory-registry:ci-artifact-inventory-registry",
        # The firewall's baseline PARSER (ADR-0616 PR-1): the frozen-baseline regen cross-check
        # projects the committed reference AND the merge-base-source regeneration through the
        # firewall's own Baseline::from_value and compares {keys, mode, frozen_empty} per (gate,
        # code). Acyclic: the ratchet lib depends only on serde_json.
        "//ci/facade/baseline-ratchet:ci-baseline-ratchet",
        # Rename-aware path-keyed baseline relabel (task #64): the P4 content-subset guard reuses
        # the brand-residue census SSOT under the LIVE VocabPolicy from oya-ci.toml (config kernel),
        # so carve-outs + case-folding are byte-identical to the producer's collect_brand_residue.
        "//libs/oya-check-brand-residue:oya-check-brand-residue",
        "//libs/oya-ci-config:oya-ci-config-kernel",
        "third-party//:serde_json",
        "third-party//:sha2",
    ],
)


rust_test(
    name = "ci-scm-facts-snapshot-unittest",
    srcs = glob(["src/**/*.rs"]),
    crate_root = "src/main.rs",
    visibility = ["PUBLIC"],
    deps = [
        "//ci/ports/path-resolver:ci-path-resolver-ports",
        "//ci/adapters/path-resolver:ci-path-resolver-adapters",
        "//ci/facade/artifact-inventory-registry:ci-artifact-inventory-registry",
        # dev-only: the frozen-policy-wins RED pin (FRIC-1781280000) runs the firewall
        # predicates end-to-end over the resolved snapshot (#698 repoint attack goes RED).
        "//ci/facade/baseline-ratchet:ci-baseline-ratchet",
        # Rename-aware path-keyed baseline relabel (task #64) — census SSOT + VocabPolicy.
        "//libs/oya-check-brand-residue:oya-check-brand-residue",
        "//libs/oya-ci-config:oya-ci-config-kernel",
        # dev-only EFFICACY pin (task #64 BLOCKER A): the chained test derives the move-manifest
        # from a MovePlan over a candidate POST-move tree via the codemod's own
        # file_level_manifest + crate_dir_pairs + move_manifest_value, then drives the relabel —
        # proving it FIRES for a real move (and FAILS if file_level_manifest enumerates-old).
        "//tools/oya-reorg-codemod-app:oya-reorg-codemod-app",
        "third-party//:serde_json",
        "third-party//:sha2",
    ],
)
