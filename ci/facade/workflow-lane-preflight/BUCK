rust_library(
    name = "ci-workflow-lane-preflight",
    srcs = glob(["src/**/*.rs", "**/*.json"]),
    crate = "ci_workflow_lane_preflight",
    crate_root = "src/lib.rs",
    visibility = ["PUBLIC"],
    deps = [
        "third-party//:serde",
        "third-party//:serde_json",
    ],
)

# Pure-kernel unit tests: the commit rule, git-visibility, hotfile containment and pairwise
# collision are all proven WITHOUT a filesystem, a clock or a git binary.
rust_test(
    name = "ci-workflow-lane-preflight-unittest",
    srcs = glob(["src/**/*.rs", "**/*.json"]),
    crate = "ci_workflow_lane_preflight",
    crate_root = "src/lib.rs",
    visibility = ["PUBLIC"],
    deps = [
        "third-party//:serde",
        "third-party//:serde_json",
    ],
)

# Live gate: reads the frozen policy off the real tree, proves the hotfile set has not rotted into
# guarding paths that no longer exist, and carries the META-TEST that injects two colliding lanes
# plus a gitignored declaration and asserts both are caught. Without the meta-test the gate could
# rot into always-green and nobody would notice.
rust_test(
    name = "ci-workflow-lane-preflight-gate",
    srcs = glob(["tests/**/*.rs", "**/*.json"]),
    crate = "ci_workflow_lane_preflight_gate",
    crate_root = "tests/workflow_lane_preflight.rs",
    visibility = ["PUBLIC"],
    deps = [
        ":ci-workflow-lane-preflight",
        "third-party//:serde_json",
    ],
)

# The RUNNABLE detector. Without a binary the pure kernel is reachable only from test fixtures, so
# no real run can ever fail it and its green reports the absence of measurement as coverage. This
# target is what makes the gate invocable; REGISTERING it as a required context is a separate,
# deliberate step and is not done here.
rust_binary(
    name = "ci-workflow-lane-preflight-bin",
    srcs = glob(["src/**/*.rs", "**/*.json"]),
    crate_root = "src/main.rs",
    visibility = ["PUBLIC"],
    deps = [
        ":ci-workflow-lane-preflight",
        "third-party//:serde",
        "third-party//:serde_json",
    ],
)

# Argument parsing and the caller-facing wire format are logic, so they get their own proof: a
# binary that defaults to the wrong policy path, or silently swallows a flag missing its value,
# judges a run against a document nobody chose and still exits 0.
rust_test(
    name = "ci-workflow-lane-preflight-bin-unittest",
    srcs = glob(["src/**/*.rs", "**/*.json"]),
    crate = "ci_workflow_lane_preflight_bin_tests",
    crate_root = "src/main.rs",
    visibility = ["PUBLIC"],
    deps = [
        ":ci-workflow-lane-preflight",
        "third-party//:serde",
        "third-party//:serde_json",
    ],
)
