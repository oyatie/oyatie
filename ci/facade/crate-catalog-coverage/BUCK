rust_library(
    name = "ci-crate-catalog-coverage",
    srcs = glob(["src/**/*.rs", "**/*.json"]),
    crate = "ci_crate_catalog_coverage",
    crate_root = "src/lib.rs",
    visibility = ["PUBLIC"],
    deps = [
        "third-party//:serde_json",
    ],
)

# Pure-kernel unit tests: coverage verdict, baseline tolerance, the MOVE case
# (a renamed crate must not inherit the old name's baseline slack), stale-entry
# detection, and the false-green corpus floor — all proven WITHOUT a filesystem.
rust_test(
    name = "ci-crate-catalog-coverage-unittest",
    srcs = glob(["src/**/*.rs", "**/*.json"]),
    crate = "ci_crate_catalog_coverage",
    crate_root = "src/lib.rs",
    visibility = ["PUBLIC"],
    deps = [
        "third-party//:serde_json",
    ],
)

# Live-corpus gate: collects the real crate set from every tracked Cargo.toml and the
# real catalog row set from registry/catalog/, evaluates against the frozen baseline,
# and asserts GREEN. Also carries the RED fixture (an uncatalogued crate MUST fail) so
# the gate is proven to be capable of failing, not merely observed passing.
rust_test(
    name = "ci-crate-catalog-coverage-gate",
    srcs = glob(["tests/**/*.rs", "**/*.json"]),
    crate = "ci_crate_catalog_coverage_gate",
    crate_root = "tests/crate_catalog_coverage.rs",
    visibility = ["PUBLIC"],
    deps = [
        ":ci-crate-catalog-coverage",
        "third-party//:serde_json",
    ],
)
