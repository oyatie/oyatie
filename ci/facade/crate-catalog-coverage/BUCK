rust_library(
    name = "ci-crate-catalog-coverage",
    srcs = glob(["src/**/*.rs", "**/*.json"]),
    crate = "ci_crate_catalog_coverage",
    crate_root = "src/lib.rs",
    visibility = ["PUBLIC"],
    deps = [
        "third-party//:serde_json",
    ],
)

# Pure-kernel unit tests: optional catalog YAML, extra YAML ignored, and the
# false-green corpus floor — all proven WITHOUT a filesystem.
rust_test(
    name = "ci-crate-catalog-coverage-unittest",
    srcs = glob(["src/**/*.rs", "**/*.json"]),
    crate = "ci_crate_catalog_coverage",
    crate_root = "src/lib.rs",
    visibility = ["PUBLIC"],
    deps = [
        "third-party//:serde_json",
    ],
)

# Live-corpus gate: collects the real crate set from every tracked Cargo.toml.
# Missing catalog YAML is not born-blocking. The RED fixture is an implausibly
# small crate corpus so the gate is proven capable of failing.
rust_test(
    name = "ci-crate-catalog-coverage-gate",
    srcs = glob(["tests/**/*.rs", "**/*.json"]),
    crate = "ci_crate_catalog_coverage_gate",
    crate_root = "tests/crate_catalog_coverage.rs",
    visibility = ["PUBLIC"],
    deps = [
        ":ci-crate-catalog-coverage",
        "third-party//:serde_json",
    ],
)
