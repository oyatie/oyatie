# GATE-3 :staleness-reaper — the fixture-corpus + born-blocking self-test gate.
# Globs specs/fixtures/staleness-reaper/tc-*.json (the data-under-test) and asserts
# report.violations == fixture.expected_violations. G-INTEGRITY track: no build-graph dep.
# (Named -gate to avoid a buck2 in-package collision with the rust_library above; the
# package //ci/facade/stale-artifact-detection carries the §5.3 :staleness-reaper identity.)
rust_test(
    name = "ci-stale-artifact-detection-gate",
    srcs = glob(["tests/**/*.rs"]),
    crate = "ci_stale_artifact_detection_corpus",
