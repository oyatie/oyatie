{
  "slice_id": "compliance-001-contract-spec",
  "spec_path": "specs/compliance-001-contract-slice.json",
  "required_fields": [
    "_meta.spec_id"
  ],
  "required_true_fields": [
    "claim_boundary.contract_fixture_only",
    "claim_boundary.local_validation_only",
    "claim_boundary.metadata_only",
    "claim_boundary.no_product_or_cloud_runtime_mutation",
    "claim_boundary.no_soc2_certification_claim",
    "claim_boundary.no_auditor_acceptance_claim",
    "claim_boundary.no_runtime_evidence_collector_claim",
    "claim_boundary.no_cmp_deployment_claim",
    "claim_boundary.no_portability_api_or_export_job_claim",
    "claim_boundary.no_tenant_activation_claim",
    "claim_boundary.no_dsr_sla_claim",
    "claim_boundary.no_regulator_submission_claim",
    "claim_boundary.no_production_readiness_claim"
  ],
  "enum_constraints": [
    {
      "field": "_meta.spec_id",
      "allowed": [
        "COMPLIANCE-001-CONTRACT-SLICE"
      ]
    }
  ],
  "required_array_members": [
    {
      "field": "claim_boundary.can_claim_now",
      "members": [
        "The compliance-pack schema records optional COMPLIANCE-001 contract fields for signature verification, SOC2-style evidence collectors, cell certification state, CMP consent, and portability export metadata.",
        "Synthetic fixtures demonstrate SOC2/CMP/portability export shapes for local validation.",
        "The owned-Rust/Buck2 contract-slice-conformance gate (compliance-001-pack-schema slice) checks the compliance-pack schema's required fields, enums, and claim-boundary wording."
      ]
    },
    {
      "field": "claim_boundary.cannot_claim_yet",
      "members": [
        "SOC 2 certification or auditor acceptance exists",
        "runtime evidence collectors, CMP deployment, or portability export jobs/APIs exist",
        "a tenant can activate this pack in production",
        "DSR SLA, regulator submission, or production launch readiness is satisfied"
      ]
    }
  ],
  "required_object_array_members": [
    {
      "field": "governed_surfaces",
      "member_key": "path",
      "members": [
        "specs/compliance-pack-schema.json",
        "specs/fixtures/compliance-pack/compliance-001-soc2-cmp-portability.fixture.json",
        "specs/fixtures/compliance-pack/compliance-001-portability-export-manifest.fixture.json",
        "ci/facade/contract-slice-conformance/contract-slice-policy.json"
      ],
      "member_required_fields": [
        "path",
        "surface_kind",
        "authority",
        "runtime_authority"
      ],
      "conditional_assertions": [
        {
          "when_member": "specs/compliance-pack-schema.json",
          "field": "surface_kind",
          "must_equal": "schema"
        },
        {
          "when_member": "specs/compliance-pack-schema.json",
          "field": "authority",
          "must_equal": "contract-field shape for compliance-pack bundles"
        },
        {
          "when_member": "specs/fixtures/compliance-pack/compliance-001-soc2-cmp-portability.fixture.json",
          "field": "surface_kind",
          "must_equal": "fixture"
        },
        {
          "when_member": "specs/fixtures/compliance-pack/compliance-001-soc2-cmp-portability.fixture.json",
          "field": "authority",
          "must_equal": "synthetic SOC2/CMP/portability compliance-pack fixture"
        },
        {
          "when_member": "specs/fixtures/compliance-pack/compliance-001-portability-export-manifest.fixture.json",
          "field": "surface_kind",
          "must_equal": "fixture"
        },
        {
          "when_member": "specs/fixtures/compliance-pack/compliance-001-portability-export-manifest.fixture.json",
          "field": "authority",
          "must_equal": "synthetic portability-export manifest fixture"
        },
        {
          "when_member": "ci/facade/contract-slice-conformance/contract-slice-policy.json",
          "field": "surface_kind",
          "must_equal": "gate-policy"
        },
        {
          "when_member": "ci/facade/contract-slice-conformance/contract-slice-policy.json",
          "field": "authority",
          "must_equal": "owned-Rust/Buck2 contract-slice-conformance gate policy entries (compliance-001-pack-schema, compliance-001-contract-spec, compliance-001-pack-fixture, compliance-001-portability-manifest-fixture slices)"
        }
      ]
    }
  ]
}
