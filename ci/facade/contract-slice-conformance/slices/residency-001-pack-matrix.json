{
  "slice_id": "residency-001-pack-matrix",
  "spec_path": "specs/compliance-pack-residency-matrix.json",
  "required_fields": [
    "matrix_id",
    "strictest_tier_order",
    "claim_boundary",
    "matrix_rows"
  ],
  "required_true_fields": [
    "claim_boundary.no_pack_activation_claim"
  ],
  "enum_constraints": [
    {
      "field": "matrix_id",
      "allowed": [
        "compliance-pack-residency-matrix"
      ]
    }
  ],
  "array_cardinality": [
    {
      "field": "matrix_rows",
      "min": 7,
      "unique_by": "pack_id"
    }
  ],
  "forbidden_markers": [
    "pack activation is live"
  ],
  "exact_array_fields": [
    {
      "field": "strictest_tier_order",
      "values": [
        "multi_region",
        "single_region",
        "sovereign_cell",
        "airgapped_cell"
      ]
    }
  ],
  "required_object_array_members": [
    {
      "field": "matrix_rows",
      "member_key": "pack_id",
      "members": [
        "HIPAA-2024",
        "EU-GDPR-2018-baseline",
        "SOC2-T2",
        "KR-CSAP-v3.1",
        "KR-PIPA-2023-amendment",
        "PCI-DSS-L1-v4",
        "EU-AI-ACT-2024-HIGH-RISK"
      ],
      "member_required_fields": [
        "pack_id",
        "min_tier",
        "regulatory_regimes",
        "pack_binding_refusal_code"
      ],
      "member_enum_constraints": [
        {
          "field": "min_tier",
          "allowed": [
            "multi_region",
            "single_region",
            "sovereign_cell",
            "airgapped_cell"
          ]
        }
      ],
      "conditional_assertions": [
        {
          "when_member": "KR-CSAP-v3.1",
          "field": "min_tier",
          "must_equal": "sovereign_cell"
        },
        {
          "when_member": "KR-PIPA-2023-amendment",
          "field": "min_tier",
          "must_equal": "single_region"
        },
        {
          "when_member": "EU-GDPR-2018-baseline",
          "field": "min_tier",
          "must_equal": "single_region"
        },
        {
          "when_member": "SOC2-T2",
          "field": "min_tier",
          "must_equal": "multi_region"
        }
      ]
    }
  ]
}
