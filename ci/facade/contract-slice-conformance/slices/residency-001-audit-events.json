{
  "slice_id": "residency-001-audit-events",
  "spec_path": "specs/residency-placement-audit-events.json",
  "required_fields": [
    "event_classes",
    "sample_wire_payloads",
    "offline_sovereign_protocol"
  ],
  "array_cardinality": [
    {
      "field": "event_classes",
      "min": 13,
      "unique_by": "wire_class"
    }
  ],
  "forbidden_markers": [
    "audit-chain delivery is implemented"
  ],
  "required_object_array_members": [
    {
      "field": "event_classes",
      "member_key": "wire_class",
      "members": [
        "tenancy.residency.attestation.created",
        "tenancy.residency.attestation.refreshed",
        "tenancy.residency.attestation.expired",
        "tenancy.residency.attestation.signature.invalid",
        "tenancy.residency.attestation.missing",
        "tenancy.residency.placement.decided",
        "tenancy.residency.placement.refused",
        "tenancy.residency.cross_border.refused",
        "tenancy.residency.cross_border.permitted",
        "tenancy.residency.tier.upgraded",
        "tenancy.residency.tier.downgraded",
        "tenancy.residency.pack.binding_changed",
        "tenancy.residency.regulatory_attestor.engaged"
      ],
      "exact_members": true,
      "member_required_fields": [
        "wire_class",
        "registry_class",
        "originating_adr",
        "retention_class",
        "required_payload_fields",
        "severity"
      ],
      "member_enum_constraints": [
        {
          "field": "originating_adr",
          "allowed": [
            "ADR-0326"
          ]
        },
        {
          "field": "retention_class",
          "allowed": [
            "regulated"
          ]
        },
        {
          "field": "registry_class",
          "allowed": [
            "TenancyResidencyAttestationCreated",
            "TenancyResidencyAttestationRefreshed",
            "TenancyResidencyAttestationExpired",
            "TenancyResidencyAttestationSignatureInvalid",
            "TenancyResidencyAttestationMissing",
            "TenancyResidencyPlacementDecided",
            "TenancyResidencyPlacementRefused",
            "TenancyResidencyCrossBorderRefused",
            "TenancyResidencyCrossBorderPermitted",
            "TenancyResidencyTierUpgraded",
            "TenancyResidencyTierDowngraded",
            "TenancyResidencyPackBindingChanged",
            "TenancyResidencyRegulatoryAttestorEngaged"
          ]
        }
      ],
      "conditional_assertions": [
        {
          "field": "required_payload_fields",
          "must_contain": [
            "tenant_id"
          ]
        },
        {
          "when_member_in": [
            "tenancy.residency.attestation.signature.invalid",
            "tenancy.residency.attestation.missing",
            "tenancy.residency.placement.refused",
            "tenancy.residency.cross_border.refused"
          ],
          "field": "severity",
          "must_equal": "CRITICAL"
        },
        {
          "when_member_in": [
            "tenancy.residency.placement.decided",
            "tenancy.residency.placement.refused",
            "tenancy.residency.cross_border.refused",
            "tenancy.residency.cross_border.permitted",
            "tenancy.residency.pack.binding_changed"
          ],
          "field": "cedar_decision_event",
          "must_be_true": true
        },
        {
          "when_member": "tenancy.residency.cross_border.refused",
          "field": "required_payload_fields",
          "must_contain": [
            "requested_destination_cell",
            "requested_destination_region",
            "refusal_reason_codes"
          ]
        }
      ]
    }
  ]
}
