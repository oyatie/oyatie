{
  "slice_id": "residency-001-governance-artifact-registry",
  "spec_path": "registry/artifact-capabilities-registry.json",
  "skip_universal_markers": true,
  "required_fields": [
    "rows"
  ],
  "required_object_array_members": [
    {
      "field": "rows",
      "member_key": "artifact_id",
      "members": [
        "residency-attestation-schema",
        "residency-region-registry",
        "residency-regulatory-regime-registry",
        "compliance-pack-residency-matrix",
        "residency-placement-audit-events"
      ],
      "conditional_assertions": [
        {
          "when_member": "residency-attestation-schema",
          "field": "artifact_profile",
          "must_equal": "schema"
        },
        {
          "when_member": "residency-region-registry",
          "field": "artifact_profile",
          "must_equal": "registry"
        },
        {
          "when_member": "residency-regulatory-regime-registry",
          "field": "artifact_profile",
          "must_equal": "registry"
        },
        {
          "when_member": "compliance-pack-residency-matrix",
          "field": "artifact_profile",
          "must_equal": "schema"
        },
        {
          "when_member": "residency-placement-audit-events",
          "field": "artifact_profile",
          "must_equal": "schema"
        },
        {
          "when_member": "residency-attestation-schema",
          "field": "capability_overrides.enforcement.lane_id",
          "must_equal": "residency-attestation-contract-slice"
        },
        {
          "when_member": "residency-region-registry",
          "field": "capability_overrides.enforcement.lane_id",
          "must_equal": "residency-region-registry-contract-slice"
        },
        {
          "when_member": "residency-regulatory-regime-registry",
          "field": "capability_overrides.enforcement.lane_id",
          "must_equal": "residency-regulatory-regime-registry-contract-slice"
        },
        {
          "when_member": "compliance-pack-residency-matrix",
          "field": "capability_overrides.enforcement.lane_id",
          "must_equal": "residency-compliance-pack-matrix-contract-slice"
        },
        {
          "when_member": "residency-placement-audit-events",
          "field": "capability_overrides.enforcement.lane_id",
          "must_equal": "residency-placement-audit-events-contract-slice"
        }
      ]
    }
  ]
}
