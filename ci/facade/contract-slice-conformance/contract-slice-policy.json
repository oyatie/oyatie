{
  "gate_id": "cloud-ci-contract-slice-conformance",
  "primary_execution_path": "rust_buck2_cloud_ci_gate",
  "purpose": "Paved-road owned-Rust/Buck2 gate that replaces the scripts/tests/*_check.py contract-slice validators. A worker adds a slice entry here plus a committed spec JSON; no new Python, shell, CLI, or crate. See README.md for the instantiation recipe.",
  "related_adrs": [
    "ADR-0515",
    "ADR-0523",
    "ADR-0528"
  ],
  "slices": [
    {
      "slice_id": "contract-slice-conformance-exemplar",
      "spec_path": "ci/facade/contract-slice-conformance/fixtures/exemplar-slice.json",
      "required_fields": [
        "slice_id",
        "spec_kind",
        "cloud_ci_gate",
        "required_contract_fields",
        "non_claims"
      ],
      "enum_constraints": [
        { "field": "spec_kind", "allowed": ["contract-slice"] }
      ],
      "forbidden_markers": []
    },
    {
      "slice_id": "cell-002-promotion-automation",
      "spec_path": "specs/cell-002-promotion-automation-contract.json",
      "required_fields": [
        "spec_id",
        "title",
        "status",
        "authoring_task",
        "source_adrs",
        "authority.accepted_boundary_adr",
        "authority.runtime_mutation_authority",
        "claim_controls.no_runtime_mutation",
        "claim_controls.no_live_migration",
        "claim_controls.no_audit_chain_writer",
        "promotion_gate.gate_id",
        "cell_lifecycle_service_plan.service",
        "cell_lifecycle_service_plan.owns",
        "cell_rebalancer_service_plan.service",
        "cell_rebalancer_service_plan.owns",
        "cell_rebalancer_service_plan.residency_honoring_rebalance.refusal_behavior",
        "sharding_automation_manifest_contract.canonical_autosharding_mode",
        "rollback_audit_fixture.path",
        "nonclaims"
      ],
      "enum_constraints": [
        { "field": "spec_id", "allowed": ["CELL-002-PROMOTION-AUTOMATION-CONTRACT"] },
        { "field": "status", "allowed": ["Proposed-target"] },
        { "field": "authoring_task", "allowed": ["CELL-002"] },
        { "field": "authority.accepted_boundary_adr", "allowed": ["ADR-0351"] },
        { "field": "authority.runtime_mutation_authority", "allowed": ["none"] },
        { "field": "promotion_gate.gate_id", "allowed": ["cell_promotion_six_input_gate"] },
        { "field": "sharding_automation_manifest_contract.canonical_autosharding_mode", "allowed": ["control_plane_driven"] }
      ],
      "required_array_members": [
        { "field": "source_adrs", "members": ["ADR-0341", "ADR-0348", "ADR-0351"] },
        { "field": "claim_controls.blocked_claim_families", "members": ["no_runtime_cell_orchestrator", "no_live_tenant_migration", "no_audit_chain_writer", "no_provider_or_kubernetes_mutation", "no_production_readiness_claim", "no_measured_slo_claim"] },
        { "field": "cell_rebalancer_service_plan.residency_honoring_rebalance.candidate_filters", "members": ["residency_domain", "compliance_packs", "cell_placement_class", "capacity_headroom", "cedar_permit"] },
        { "field": "sharding_automation_manifest_contract.required_subblocks", "members": ["autosharding", "auto_rebalance", "dynamic_sharding"] }
      ],
      "forbidden_markers": [
        "is production ready",
        "runtime auto-rebalance is implemented",
        "live tenant migration is implemented"
      ],
      "source_migration_slice": [
        {
          "legacy_path": "scripts/tests/cell_002_promotion_automation_check.py",
          "replacement_target": "//ci/facade/contract-slice-conformance:ci-contract-slice-conformance-gate",
          "disposition": "retired_primary_path"
        }
      ]
    }
  ]
}
