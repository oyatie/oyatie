# GATE-1 :cross-artifact-agreement — the fixture-corpus + born-blocking self-test gate.
# Globs specs/fixtures/cross-artifact-agreement/tc-*.json (the data-under-test) and asserts
# report.violations == fixture.expected_violations. G-INTEGRITY track: no build-graph dep.
# (Named -gate to avoid a buck2 in-package collision with the rust_library above; the
# package //ci/facade/cross-artifact-agreement carries the §5.3
# :cross-artifact-agreement identity.)
rust_test(
    name = "ci-cross-artifact-agreement-gate",
    crate = "ci_cross_artifact_agreement_corpus",
    crate_root = "ci/facade/cross-artifact-agreement/tests/cross_artifact_agreement.rs",
    # ADR-0545 embedded-asset hermeticity: this gate reads `../BUCK` and
    # `../../../../.cargo/config.toml` through include_str! to assert the Buck/Cargo resource
    # bijection. Those literals resolve relative to the including file, so they only land on the
    # right bytes when the source sits at its true repo-relative depth. Shape the action's source
    # root like the repo root — a plain `tests/**` srcs glob puts the source at `tests/...`, from
    # which the four-level ascent escapes the sandbox and the build fails outright.
    mapped_srcs = {
        "BUCK": "ci/facade/cross-artifact-agreement/BUCK",
        "//.cargo:config.toml": ".cargo/config.toml",
        "tests/cross_artifact_agreement.rs": "ci/facade/cross-artifact-agreement/tests/cross_artifact_agreement.rs",
        "tests/idea_archive_transition/mod.rs": "ci/facade/cross-artifact-agreement/tests/idea_archive_transition/mod.rs",
    },
    # HERMETIC: the test execs buck2-BUILT producer binaries (no `env!("CARGO")`, no `cargo
    # run`). `$(exe ...)` makes buck2 build each producer and substitute its sandbox path here;
    # the accounting producer reads the committed scm-facts face — no action calls git — while
    # the ADR producer re-renders source decisions into a test-owned temporary directory.
    env = {
        "OYA_ADR_INDEX_PRODUCER_BIN": "$(exe //marketplace/facade/dev-cli:oya)",
        "OYA_CI_PRODUCER_BIN": "$(exe //ci/facade/artifact-inventory-registry:oya-cloud-ci-accounting-registry-app-bin)",
        "OYA_IDEA_ARCHIVE_POLICY": "$(location :idea-archive-policy.json)",
        # E7: exact controller-owned Git/object facts. Like the existing de-committed SCM-facts
        # boundary, this face is materialized out-of-graph and is never a Buck source member. The
        # consumer resolves this canonical repo-relative path and fails closed when bytes are
        # absent; no empty or candidate-authored fallback is permitted.
        "OYA_HISTORY_ONLY_RETIREMENT_FACTS": "ci/facade/scm-facts-snapshot/history-only-retirement-facts.generated.json",
    },
    resources = [
        "//docs/ideas:idea-archive-candidate-tree",
    ],
    visibility = ["PUBLIC"],
    deps = [
        ":ci-cross-artifact-agreement",
        "//ci/adapters/path-resolver:ci-path-resolver-adapters",
        "//ci/facade/artifact-inventory-registry:ci-artifact-inventory-registry",
        "//governance/check/adr-shape-kernel:check-adr-shape-kernel",
        "third-party//:serde_json",
        "third-party//:sha2",
        "third-party//:tempfile",
    ],
)
