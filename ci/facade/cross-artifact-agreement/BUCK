# GATE-1 :cross-artifact-agreement — the fixture-corpus + born-blocking self-test gate.
# Globs specs/fixtures/cross-artifact-agreement/tc-*.json (the data-under-test) and asserts
# report.violations == fixture.expected_violations. G-INTEGRITY track: no build-graph dep.
# (Named -gate to avoid a buck2 in-package collision with the rust_library above; the
# package //ci/facade/cross-artifact-agreement carries the §5.3
# :cross-artifact-agreement identity.)
rust_test(
    name = "ci-cross-artifact-agreement-gate",
    srcs = glob(["tests/**/*.rs"]),
    crate = "ci_cross_artifact_agreement_corpus",
    crate_root = "tests/cross_artifact_agreement.rs",
    # OUT-OF-GRAPH ADMISSION INPUTS: the producer executable is a declared Buck dependency, but
    # the two SCM faces are deliberately de-committed and therefore are NOT hermetic Buck source
    # inputs. The admission workflow and every registry verification command materialize both
    # files immediately before this target runs. Explicit env paths prevent a standalone test from
    # silently falling back to an old ambient face; this target must never be described as
    # independently hermetic until a future staged-input rule makes the same-run files graph inputs.
    env = {
        "OYA_CI_PRODUCER_BIN": "$(exe //ci/facade/artifact-inventory-registry:oya-cloud-ci-accounting-registry-app-bin)",
        "OYA_CI_SCM_FACTS_PATH": "ci/facade/artifact-inventory-registry/scm-facts.generated.json",
        "OYA_CI_SCM_VOLATILE_FACTS_PATH": "ci/facade/scm-facts-snapshot/scm-volatile-facts.generated.json",
    },
    visibility = ["PUBLIC"],
    deps = [
        ":ci-cross-artifact-agreement",
        "//ci/facade/artifact-inventory-registry:ci-artifact-inventory-registry",
        "third-party//:serde_json",
    ],
)
