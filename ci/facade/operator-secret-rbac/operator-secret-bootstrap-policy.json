{
  "gate_id": "cloud-ci-operator-secret-bootstrap",
  "_doc": "GH #980 + GH #988. Pack-shaped policy DATA. scoped_secret_verbs are the single-object Kubernetes RBAC verbs that unconditionally honor resourceNames (get/update/patch/delete) and so MUST be name-scoped to produced_secret_name when granted on secrets. join_token_values_ref is the Helm values path of the operator-internal bootstrap Secret the operator consumes; the chart must provision it declaratively or fail-close on its absence. external_secret_scan_roots bounds discovery of committed static ExternalSecret consumers for governed stores. external_secret_value_templates projects values-backed Helm ExternalSecrets into the same observed shape. external_secret_scopes binds OpenBao-backed stores to explicit namespace + remoteRef.key prefix tuples and the ClusterSecretStore Kubernetes auth role expected for that store. openbao_transport requires plaintext OpenBao listeners to be isolated by a concrete NetworkPolicy for the declared listener ports.",
  "scoped_secret_verbs": ["get", "update", "patch", "delete"],
  "operators": [
    {
      "name": "cloud-iam-pdp-svid-operator",
      "rbac_template": "cloud/cloud-iam/iac/k8s/helm/templates/svid-operator-rbac.yaml",
      "chart_templates_dir": "cloud/cloud-iam/iac/k8s/helm/templates",
      "produced_secret_name": "oya-cloud-iam-pdp-svid",
      "join_token_values_ref": "svidOperator.joinToken.secretName"
    }
  ],
  "external_secret_scan_roots": [
    "infra/external-secrets",
    "storage/adapters/nativelink",
    "cloud/cloud-k8s/iac/kustomize/base"
  ],
  "external_secret_value_templates": [
    {
      "path": "cloud/cloud-iam/iac/k8s/helm/templates/svid-operator-join-token-externalsecret.yaml",
      "values_path": "cloud/cloud-iam/iac/k8s/helm/values.yaml",
      "enabled_path": "svidOperator.joinToken.externalSecret.enabled",
      "name_path": "svidOperator.joinToken.secretName",
      "namespace_path": "svidOperator.watchedNamespace",
      "store_name_path": "svidOperator.joinToken.externalSecret.secretStoreRef.name",
      "store_kind_path": "svidOperator.joinToken.externalSecret.secretStoreRef.kind",
      "remote_key_paths": ["svidOperator.joinToken.externalSecret.openbaoPath"]
    }
  ],
  "external_secret_scopes": [
    {
      "store_name": "openbao-oya",
      "store_kind": "ClusterSecretStore",
      "allowed_namespaces": ["oya-ci"],
      "allowed_remote_key_prefixes": ["oya/ci/"],
      "manifest_paths": [
        "infra/external-secrets/externalsecret-github-ci-token.yaml",
        "storage/adapters/nativelink/nativelink-cas.k8s.yaml"
      ],
      "store_manifest_paths": ["infra/external-secrets/clustersecretstore-openbao-oya.yaml"],
      "openbao_role": "eso-oya-ci"
    },
    {
      "store_name": "openbao-cloud-k8s-csi",
      "store_kind": "ClusterSecretStore",
      "allowed_namespaces": ["cloud-k8s-system"],
      "allowed_remote_key_prefixes": ["cloud-k8s/csi/"],
      "manifest_paths": ["cloud/cloud-k8s/iac/kustomize/base/openbao-secret-references.yaml"],
      "store_manifest_paths": ["infra/external-secrets/clustersecretstore-openbao-oya.yaml"],
      "openbao_role": "eso-cloud-k8s-csi"
    },
    {
      "store_name": "openbao-cloud-iam-svid-operator",
      "store_kind": "ClusterSecretStore",
      "allowed_namespaces": ["cloud-iam"],
      "allowed_remote_key_prefixes": ["cloud-iam/pdp-svid-operator/"],
      "value_template_paths": ["cloud/cloud-iam/iac/k8s/helm/templates/svid-operator-join-token-externalsecret.yaml"],
      "store_manifest_paths": ["infra/external-secrets/clustersecretstore-openbao-oya.yaml"],
      "openbao_role": "eso-cloud-iam-svid-operator"
    }
  ],
  "openbao_transport": {
    "manifest_path": "infra/kms/openbao.k8s.yaml",
    "workload_namespace": "oya-kms",
    "workload_selector": {"app.kubernetes.io/name": "openbao"},
    "allowed_ingress_ports": [8200, 8201]
  }
}
