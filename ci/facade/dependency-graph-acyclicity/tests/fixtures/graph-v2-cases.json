{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "purpose": "Named mutation corpus consumed by the graph-v2 gate test. Mutations apply to the live canonical document so fixtures cannot drift into a second graph authority.",
  "cases": [
    { "id": "red-missing-kind", "mutation": "remove_graph_kind", "expected": "dag_graph_kind_set" },
    { "id": "red-extra-kind", "mutation": "append_unknown_graph_kind", "expected": "dag_graph_kind_set" },
    { "id": "red-duplicate-unit", "mutation": "duplicate_dependency_unit", "expected": "dag_duplicate_unit" },
    { "id": "red-18-units", "mutation": "remove_dependency_unit", "expected": "dag_dependency_unit_set" },
    { "id": "red-20-units", "mutation": "append_twentieth_dependency_unit", "expected": "dag_dependency_unit_set" },
    { "id": "red-unknown-capability", "mutation": "unknown_capability", "expected": "dag_unknown_capability" },
    { "id": "red-missing-runtime-face", "mutation": "remove_runtime_face", "expected": "dag_schema_violation" },
    { "id": "red-unknown-endpoint", "mutation": "unknown_endpoint", "expected": "dag_edge_unknown_unit" },
    { "id": "red-cross-kind-contamination", "mutation": "cross_kind_contamination", "expected": "dag_cross_kind_edge" },
    { "id": "red-graph3-self-loop", "mutation": "graph3_self_loop", "expected": "dag_cycle" },
    { "id": "red-graph3-cycle", "mutation": "graph3_cycle", "expected": "dag_cycle" },
    { "id": "red-malformed-failure-edge", "mutation": "remove_failure_impact_rule", "expected": "dag_failure_edge_malformed" },
    { "id": "red-missing-failure-closure-edge", "mutation": "remove_failure_closure_edge", "expected": "dag_failure_closure_mismatch" },
    { "id": "red-mismatched-failure-impact", "mutation": "change_failure_impact", "expected": "dag_failure_closure_mismatch" },
    { "id": "red-composition-sum", "mutation": "composition_sum", "expected": "dag_schema_violation" },
    { "id": "red-forward-closure-direction", "mutation": "forward_closure_direction", "expected": "dag_schema_violation" },
    { "id": "red-required-doctrine", "mutation": "remove_doctrine_adrs", "expected": "dag_schema_violation" },
    { "id": "red-required-path-rule", "mutation": "remove_path_rule", "expected": "dag_schema_violation" },
    { "id": "red-request-weight-type", "mutation": "request_weight_wrong_type", "expected": "dag_edge_malformed" },
    { "id": "red-request-weight-range", "mutation": "request_weight_out_of_range", "expected": "dag_edge_malformed" },
    { "id": "red-forbidden-reason", "mutation": "remove_forbidden_reason", "expected": "dag_schema_violation" },
    { "id": "green-reverse-direction-outside-graph3", "mutation": "reverse_direction_outside_graph3", "expected": "GREEN" },
    { "id": "green-exact-failure-closure", "mutation": "none", "expected": "GREEN" }
  ]
}
