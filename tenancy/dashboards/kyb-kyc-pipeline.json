{
  "title": "Tenancy — KYB/KYC Pipeline",
  "uid": "tenancy-kyb-kyc-pipeline",
  "schemaVersion": 39,
  "tags": ["tenancy", "kyb-kyc", "ADR-0244"],
  "panels": [
    {"id": 1, "type": "stat", "title": "KYB-KYC in flight",
     "targets": [{"expr": "sum(oya_tenancy_kyb_kyc_in_flight)"}]},
    {"id": 2, "type": "timeseries", "title": "Completion latency (P95)",
     "targets": [{"expr": "histogram_quantile(0.95, sum(rate(oya_tenancy_kyb_kyc_seconds_bucket[5m])) by (le))"}]},
    {"id": 3, "type": "table", "title": "KYB outcomes by tier",
     "targets": [{"expr": "sum by (tier, outcome) (oya_tenancy_kyb_kyc_completed_total)"}]},
    {"id": 4, "type": "stat", "title": "Minor-protection refusals",
     "targets": [{"expr": "sum(rate(oya_tenancy_kyb_kyc_minor_refused_total[24h]))"}]}
  ],
  "binding_adrs": ["ADR-0244", "ADR-0292"]
}
