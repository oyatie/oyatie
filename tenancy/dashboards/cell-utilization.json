{
  "$schema": "https://schemas.grafana.com/dashboard.json",
  "_meta": {
    "doc_class": "GrafanaDashboard",
    "microservice": "tenancy",
    "owner_team": "ops-sre-reliability + axis-tenancy",
    "audience": "platform operators (capacity + rebalance signals)",
    "tenant_scoped": false,
    "datasource": "Mimir aggregate (self tenant)"
  },
  "uid": "tenancy-cell-utilization",
  "title": "Cell Utilization + Citus Shard Distribution",
  "tags": ["tenancy", "citus", "patroni", "capacity"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "templating": {
    "list": [
      {"name": "pack", "type": "custom", "options": [
        {"text": "pack-kr", "value": "kr", "selected": true},
        {"text": "pack-eu", "value": "eu"},
        {"text": "pack-us", "value": "us"},
        {"text": "pack-us-healthcare", "value": "us-hc"},
        {"text": "pack-jp", "value": "jp"},
        {"text": "pack-sg", "value": "sg"},
        {"text": "pack-au", "value": "au"},
        {"text": "pack-in", "value": "in"},
        {"text": "pack-br", "value": "br"},
        {"text": "pack-ae", "value": "ae"},
        {"text": "pack-ksa", "value": "ksa"}
      ]}
    ]
  },
  "panels": [
    {"id": 1, "type": "stat", "title": "Active cells — $pack",
     "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
     "targets": [{"expr": "count(tenancy_cell_health{pack=\"$pack\",health=\"healthy\"})", "refId": "A"}]
    },
    {"id": 2, "type": "stat", "title": "Tenants per cell (max)",
     "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
     "targets": [{"expr": "max(tenancy_cell_tenant_count{pack=\"$pack\"})", "refId": "A"}],
     "fieldConfig": {"defaults": {"thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 8000}, {"color": "red", "value": 10000}]}}}
    },
    {"id": 3, "type": "timeseries", "title": "Per-cell load percentage",
     "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
     "targets": [{"expr": "tenancy_cell_load_pct{pack=\"$pack\"}", "legendFormat": "cell {{cell_id}}", "refId": "A"}]
    },
    {"id": 4, "type": "table", "title": "Cell health summary",
     "gridPos": {"x": 0, "y": 12, "w": 12, "h": 6},
     "targets": [{"expr": "tenancy_cell_health{pack=\"$pack\"}", "format": "table", "refId": "A"}],
     "transformations": [{"id": "organize", "options": {"includeByName": {"cell_id": true, "health": true, "tenant_count": true, "load_pct": true}}}]
    },
    {"id": 5, "type": "timeseries", "title": "Citus shard distribution skew (max - min)",
     "gridPos": {"x": 0, "y": 18, "w": 12, "h": 6},
     "targets": [
       {"expr": "max(tenancy_citus_shard_count{pack=\"$pack\"}) - min(tenancy_citus_shard_count{pack=\"$pack\"})", "legendFormat": "skew", "refId": "A"}
     ]
    },
    {"id": 6, "type": "timeseries", "title": "Patroni replication lag (sync + async)",
     "gridPos": {"x": 0, "y": 24, "w": 12, "h": 6},
     "targets": [
       {"expr": "tenancy_postgres_replication_lag_seconds{pack=\"$pack\",mode=\"sync\"}", "legendFormat": "sync replica {{node}}", "refId": "A"},
       {"expr": "tenancy_postgres_replication_lag_seconds{pack=\"$pack\",mode=\"async\"}", "legendFormat": "async replica {{node}}", "refId": "B"}
     ],
     "alert": {"name": "patroni-lag-page",
       "conditions": [{"evaluator": {"params": [60], "type": "gt"}, "query": {"params": ["A", "5m", "now"]}, "type": "query"}],
       "notifications": [{"uid": "grafana-oncall-tenancy-sev2"}]
     }
    },
    {"id": 7, "type": "timeseries", "title": "Citus rebalance progress",
     "gridPos": {"x": 0, "y": 30, "w": 12, "h": 6},
     "targets": [
       {"expr": "tenancy_citus_rebalance_in_flight{pack=\"$pack\"}", "legendFormat": "in-flight rebalances", "refId": "A"},
       {"expr": "rate(tenancy_citus_rebalance_completed_total{pack=\"$pack\"}[5m])", "legendFormat": "completed (rate)", "refId": "B"}
     ]
    }
  ]
}
