{
  "$schema": "https://schemas.grafana.com/dashboard.json",
  "_meta": {
    "doc_class": "GrafanaDashboard",
    "microservice": "tenancy",
    "owner_team": "axis-tenancy",
    "related_artifacts": [
      "microservices/tenancy/contracts/openapi/tenancy.yaml",
      "microservices/tenancy/policy/tenant-scope.cedar"
    ],
    "audience": "tenant operators + platform operators",
    "tenant_scoped": true,
    "datasource": "Mimir (per-pack); X-Scope-OrgID = principal.tenant_id"
  },
  "uid": "tenancy-lifecycle-ops",
  "title": "Tenant Lifecycle Ops",
  "tags": ["tenancy", "lifecycle", "tenant-facing"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-30d", "to": "now"},
  "templating": {
    "list": [
      {
        "name": "tenant",
        "type": "query",
        "datasource": "Mimir",
        "query": "label_values(tenancy_lifecycle_state, tenant_id)",
        "refresh": 1
      },
      {
        "name": "pack",
        "type": "custom",
        "options": [
          {"text": "pack-kr", "value": "kr", "selected": true},
          {"text": "pack-eu", "value": "eu"},
          {"text": "pack-us", "value": "us"},
          {"text": "pack-us-healthcare", "value": "us-hc"},
          {"text": "pack-jp", "value": "jp"},
          {"text": "pack-sg", "value": "sg"},
          {"text": "pack-au", "value": "au"},
          {"text": "pack-in", "value": "in"},
          {"text": "pack-br", "value": "br"},
          {"text": "pack-ae", "value": "ae"},
          {"text": "pack-ksa", "value": "ksa"}
        ]
      }
    ]
  },
  "panels": [
    {"id": 1, "type": "stat", "title": "Current lifecycle state — $tenant",
     "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
     "targets": [{"expr": "tenancy_lifecycle_state{tenant_id=\"$tenant\"}", "refId": "A"}],
     "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {
       "Created":  {"text": "CREATED",  "color": "blue"},
       "Activated": {"text": "ACTIVATED", "color": "green"},
       "Suspended": {"text": "SUSPENDED", "color": "yellow"},
       "DeletionRequested": {"text": "DELETING", "color": "orange"},
       "Deleted":  {"text": "DELETED", "color": "red"}}}]}}
    },
    {"id": 2, "type": "stat", "title": "Activation latency p99 (last 24h)",
     "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
     "targets": [{"expr": "histogram_quantile(0.99, sum by (le) (rate(tenancy_activation_duration_seconds_bucket{pack=\"$pack\"}[24h])))", "refId": "A"}],
     "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 240}, {"color": "red", "value": 300}]}}}
    },
    {"id": 3, "type": "timeseries", "title": "Tenant lifecycle event rate",
     "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
     "targets": [
       {"expr": "rate(tenancy_lifecycle_event_total{event=\"TenantCreated\",pack=\"$pack\"}[5m])", "legendFormat": "created", "refId": "A"},
       {"expr": "rate(tenancy_lifecycle_event_total{event=\"TenantActivated\",pack=\"$pack\"}[5m])", "legendFormat": "activated", "refId": "B"},
       {"expr": "rate(tenancy_lifecycle_event_total{event=\"TenantSuspended\",pack=\"$pack\"}[5m])", "legendFormat": "suspended", "refId": "C"},
       {"expr": "rate(tenancy_lifecycle_event_total{event=\"TenantDeletionRequested\",pack=\"$pack\"}[5m])", "legendFormat": "deletion requested", "refId": "D"},
       {"expr": "rate(tenancy_lifecycle_event_total{event=\"TenantDeletionCompleted\",pack=\"$pack\"}[5m])", "legendFormat": "deletion completed", "refId": "E"}
     ]
    },
    {"id": 4, "type": "stat", "title": "Active tenants by plan tier — $pack",
     "gridPos": {"x": 0, "y": 12, "w": 12, "h": 4},
     "targets": [
       {"expr": "count(tenancy_lifecycle_state{state=\"Activated\",plan_tier=\"trial\",pack=\"$pack\"})", "legendFormat": "trial", "refId": "A"},
       {"expr": "count(tenancy_lifecycle_state{state=\"Activated\",plan_tier=\"production\",pack=\"$pack\"})", "legendFormat": "production", "refId": "B"},
       {"expr": "count(tenancy_lifecycle_state{state=\"Activated\",plan_tier=\"sandbox\",pack=\"$pack\"})", "legendFormat": "sandbox", "refId": "C"},
       {"expr": "count(tenancy_lifecycle_state{state=\"Activated\",plan_tier=\"internal\",pack=\"$pack\"})", "legendFormat": "internal", "refId": "D"}
     ]
    },
    {"id": 5, "type": "timeseries", "title": "Validate-path p50/p99 latency",
     "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8},
     "targets": [
       {"expr": "histogram_quantile(0.50, sum by (le) (rate(tenancy_validate_duration_seconds_bucket{pack=\"$pack\"}[5m])))", "legendFormat": "p50", "refId": "A"},
       {"expr": "histogram_quantile(0.99, sum by (le) (rate(tenancy_validate_duration_seconds_bucket{pack=\"$pack\"}[5m])))", "legendFormat": "p99", "refId": "B"}
     ]
    },
    {"id": 6, "type": "table", "title": "Tenant lifecycle history — $tenant (last 24h)",
     "gridPos": {"x": 0, "y": 24, "w": 12, "h": 8},
     "targets": [{"expr": "tenancy_lifecycle_event_total{tenant_id=\"$tenant\"}", "format": "table", "refId": "A"}]
    }
  ]
}
