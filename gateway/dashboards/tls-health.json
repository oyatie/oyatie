{
  "title": "api-gateway — TLS Health",
  "schemaVersion": 39,
  "tags": ["api-gateway", "tls", "ech", "pqc"],
  "panels": [
    {"id": 1, "type": "stat", "title": "TLS handshake success ratio", "targets": [{"expr": "sum(rate(api_gateway_tls_handshake_total{status=\"success\"}[5m])) / sum(rate(api_gateway_tls_handshake_total[5m]))"}]},
    {"id": 2, "type": "graph", "title": "TLS handshake duration p50/p95/p99", "targets": [
      {"expr": "histogram_quantile(0.5, sum(rate(api_gateway_tls_handshake_duration_seconds_bucket[5m])) by (le))"},
      {"expr": "histogram_quantile(0.95, sum(rate(api_gateway_tls_handshake_duration_seconds_bucket[5m])) by (le))"},
      {"expr": "histogram_quantile(0.99, sum(rate(api_gateway_tls_handshake_duration_seconds_bucket[5m])) by (le))"}
    ]},
    {"id": 3, "type": "graph", "title": "Cipher suite distribution", "targets": [{"expr": "sum(rate(api_gateway_tls_handshake_total[5m])) by (cipher_suite)"}]},
    {"id": 4, "type": "graph", "title": "KEM group distribution (PQC adoption)", "targets": [{"expr": "sum(rate(api_gateway_tls_handshake_total{status=\"success\"}[5m])) by (kem_group)"}]},
    {"id": 5, "type": "graph", "title": "ECH applied ratio", "targets": [{"expr": "sum(rate(api_gateway_tls_handshake_total{ech_status=\"applied\"}[5m])) / sum(rate(api_gateway_tls_handshake_total{status=\"success\"}[5m]))"}]},
    {"id": 6, "type": "graph", "title": "Cert expiry timeline (per cell)", "targets": [{"expr": "min(api_gateway_cert_expiry_days_remaining) by (cell)"}]},
    {"id": 7, "type": "graph", "title": "TLS 1.3 vs older (should be 100% 1.3)", "targets": [{"expr": "sum(rate(api_gateway_tls_handshake_total[5m])) by (tls_version)"}]},
    {"id": 8, "type": "graph", "title": "OCSP staple status", "targets": [{"expr": "sum(rate(api_gateway_ocsp_staple_total[5m])) by (status)"}]}
  ]
}
