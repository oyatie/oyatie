{
  "title": "— Connector Usage by Tenant",
  "description": "Per-tenant connector invocation volume, error rate, latency, and circuit-breaker state. Precedent: Zapier usage analytics dashboard.",
  "uid": "connector-usage-by-tenant",
  "tags": ["connector", "connectors", "tenant", "per-tenant"],
  "microservice": "connector",
  "binding_adr": "ADR-0263",
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "tenant_id",
        "type": "query",
        "query": "label_values(connector_action_total, tenant_id)",
        "label": "Tenant"
      },
      {
        "name": "connector",
        "type": "query",
        "query": "label_values(connector_action_total{tenant_id=\"$tenant_id\"}, connector)",
        "label": "Connector"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Connector Action Rate (req/s)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (connector) (rate(connector_action_total{tenant_id=\"$tenant_id\"}[5m]))",
          "legendFormat": "{{connector}}"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "title": "Connector Error Rate (%)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "100 * sum by (connector) (rate(connector_action_total{tenant_id=\"$tenant_id\",result=\"error\"}[5m])) / sum by (connector) (rate(connector_action_total{tenant_id=\"$tenant_id\"}[5m]))",
          "legendFormat": "{{connector}} error %"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "thresholds": [
        { "value": 1, "color": "yellow" },
        { "value": 5, "color": "red" }
      ]
    },
    {
      "id": 3,
      "title": "Action Latency P99 (ms)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (connector, le) (rate(connector_action_duration_seconds_bucket{tenant_id=\"$tenant_id\"}[5m]))) * 1000",
          "legendFormat": "{{connector}} p99"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 }
    },
    {
      "id": 4,
      "title": "Circuit Breaker State",
      "type": "stat",
      "targets": [
        {
          "expr": "connector_circuit_breaker_open_total{tenant_id=\"$tenant_id\"}",
          "legendFormat": "{{connector}}"
        }
      ],
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 8 },
      "mappings": [
        { "value": "0", "text": "CLOSED", "color": "green" },
        { "value": "1", "text": "OPEN", "color": "red" }
      ]
    },
    {
      "id": 5,
      "title": "DLQ Depth by Connector",
      "type": "bargauge",
      "targets": [
        {
          "expr": "connector_dlq_depth{tenant_id=\"$tenant_id\"}",
          "legendFormat": "{{connector}}"
        }
      ],
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 8 },
      "thresholds": [
        { "value": 100, "color": "yellow" },
        { "value": 1000, "color": "red" }
      ]
    },
    {
      "id": 6,
      "title": "Top Connectors by Volume (30d)",
      "type": "table",
      "targets": [
        {
          "expr": "topk(20, sum by (connector) (increase(connector_action_total{tenant_id=\"$tenant_id\"}[30d])))",
          "legendFormat": "{{connector}}"
        }
      ],
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 }
    },
    {
      "id": 7,
      "title": "OAuth Grant Health",
      "type": "stat",
      "targets": [
        {
          "expr": "connector_oauth_grants_active{tenant_id=\"$tenant_id\"}",
          "legendFormat": "Active grants"
        },
        {
          "expr": "connector_oauth_grants_expired{tenant_id=\"$tenant_id\"}",
          "legendFormat": "Expired grants"
        }
      ],
      "gridPos": { "h": 4, "w": 12, "x": 0, "y": 24 }
    },
    {
      "id": 8,
      "title": "Abuse Defence Events (per tenant)",
      "type": "timeseries",
      "description": "Per ADR-0297: bot challenge issued, blocked requests, scrape-pattern detected. Transparent to tenant-admin per §3.2.3 UX-floor tenant-telemetry invariant.",
      "targets": [
        {
          "expr": "sum by (event_class) (rate(connector_abuse_defence_events_total{tenant_id=\"$tenant_id\"}[5m]))",
          "legendFormat": "{{event_class}}"
        }
      ],
      "gridPos": { "h": 4, "w": 12, "x": 12, "y": 24 }
    }
  ]
}
