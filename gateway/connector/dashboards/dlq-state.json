{
  "title": "— DLQ State",
  "description": "Dead-letter queue depth, age, replay outcomes, and per-connector error class breakdown. Precedent: AWS SQS DLQ CloudWatch dashboard.",
  "uid": "connector-dlq-state",
  "tags": ["connector", "dlq", "retry", "dead-letter"],
  "microservice": "connector",
  "binding_adr": "ADR-0263",
  "refresh": "1m",
  "time": { "from": "now-12h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "tenant_id",
        "type": "query",
        "query": "label_values(connector_dlq_depth, tenant_id)",
        "label": "Tenant"
      },
      {
        "name": "connector",
        "type": "query",
        "query": "label_values(connector_dlq_depth{tenant_id=\"$tenant_id\"}, connector)",
        "label": "Connector",
        "includeAll": true
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "DLQ Total Depth (all connectors)",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(connector_dlq_depth{tenant_id=\"$tenant_id\"})",
          "legendFormat": "Total DLQ entries"
        }
      ],
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "thresholds": [
        { "value": 100, "color": "yellow" },
        { "value": 1000, "color": "orange" },
        { "value": 9000, "color": "red" }
      ]
    },
    {
      "id": 2,
      "title": "DLQ Depth by Connector",
      "type": "bargauge",
      "targets": [
        {
          "expr": "connector_dlq_depth{tenant_id=\"$tenant_id\",connector=\"$connector\"}",
          "legendFormat": "{{connector}}"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 6, "y": 0 },
      "thresholds": [
        { "value": 100, "color": "yellow" },
        { "value": 1000, "color": "red" }
      ]
    },
    {
      "id": 3,
      "title": "Max Entry Age (oldest DLQ entry)",
      "type": "stat",
      "description": "Oldest unretried DLQ entry age. If >24h, manual intervention may be needed.",
      "targets": [
        {
          "expr": "max(time() - connector_dlq_oldest_entry_timestamp_seconds{tenant_id=\"$tenant_id\",connector=\"$connector\"}) / 3600",
          "legendFormat": "Hours since oldest entry"
        }
      ],
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 4 },
      "thresholds": [
        { "value": 1, "color": "yellow" },
        { "value": 24, "color": "red" }
      ]
    },
    {
      "id": 4,
      "title": "DLQ Ingest Rate vs Replay Rate",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (connector) (rate(connector_dlq_entries_added_total{tenant_id=\"$tenant_id\"}[5m]))",
          "legendFormat": "{{connector}} added/s"
        },
        {
          "expr": "sum by (connector) (rate(connector_dlq_entries_replayed_total{tenant_id=\"$tenant_id\"}[5m]))",
          "legendFormat": "{{connector}} replayed/s"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 }
    },
    {
      "id": 5,
      "title": "Error Class Breakdown",
      "type": "piechart",
      "targets": [
        {
          "expr": "sum by (error_class) (connector_dlq_entries_by_error_class{tenant_id=\"$tenant_id\",connector=\"$connector\"})",
          "legendFormat": "{{error_class}}"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 }
    },
    {
      "id": 6,
      "title": "Replay Success Rate",
      "type": "timeseries",
      "targets": [
        {
          "expr": "100 * sum(rate(connector_dlq_entries_replayed_total{tenant_id=\"$tenant_id\",result=\"success\"}[5m])) / sum(rate(connector_dlq_entries_replayed_total{tenant_id=\"$tenant_id\"}[5m]))",
          "legendFormat": "replay success %"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "thresholds": [
        { "value": 90, "color": "yellow" },
        { "value": 50, "color": "red" }
      ]
    },
    {
      "id": 7,
      "title": "DLQ Capacity Headroom (% of 10,000 cap)",
      "type": "gauge",
      "targets": [
        {
          "expr": "100 * sum(connector_dlq_depth{tenant_id=\"$tenant_id\"}) / 10000",
          "legendFormat": "% capacity used"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "thresholds": [
        { "value": 60, "color": "yellow" },
        { "value": 90, "color": "red" }
      ]
    }
  ]
}
