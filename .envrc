# .envrc — direnv configuration for oyatie repo
# Requires: direnv (https://direnv.net/). Run `direnv allow` once after cloning.
# If direnv is not installed, manually add the bin/ directory to your PATH:
#   export PATH="$PWD/bin:$PATH"  (add to ~/.bashrc or ~/.zshrc)

# Add bin/ to PATH so `oya` resolves without the full cargo invocation.
PATH_add bin
