# .terraform.lock.hcl is deliberately NOT ignored: a provider dependency lock
# exists to be committed. Ignoring it means every `tofu init` re-resolves the
# constraint and can pick a different provider version than the last apply used —
# in the one root fronting an internet-facing tunnel and DNS (ADR-0625).
.terraform/
terraform.tfstate
terraform.tfstate.backup
*.tfvars
*.tfvars.local
crash.log
.cf-api-token
