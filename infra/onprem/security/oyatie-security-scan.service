[Unit]
Description=Oyatie host security scan (gitleaks + trivy + debsecan + cargo-audit + trivy-k8s)
Documentation=https://github.com/jason931225/oyatie/blob/dev/infra/onprem/security/scan.sh
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/oyatie-security-scan
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
