# Self-hosted Omni — non-secret config. Copy to .env and fill in.
# SECRETS (TLS key, GPG etcd key, OIDC client secret) do NOT live here — see gen-secrets.sh
# (they go to macOS Keychain / OpenBao and are mounted at run time). ADR-0043 / ADR-0371-D5.

# --- Host (OCI Ampere A1, Ubuntu, Docker) ---
# Reserved OCI public IP (NOT a DNS name) — WireGuard advertises this literal address.
OMNI_PUBLIC_IP=203.0.113.10

# Public DNS name that resolves to OMNI_PUBLIC_IP (used for the UI/API + TLS SAN).
OMNI_ENDPOINT=omni.oyatie.dev
# OIDC issuer host (Dex, bundled). Usually the same host, port 5556.
AUTH_ENDPOINT=omni.oyatie.dev

# First admin user (must match an identity your OIDC provider will authenticate).
OMNI_USER_EMAIL=jason931225@gmail.com

# Pin a real release tag (NOT 'latest'); see https://github.com/siderolabs/omni/releases
OMNI_VERSION=v0.0.0-REPLACE-ME

# EULA acceptance (required by the Omni container).
EULA_NAME=Jason Lee
EULA_EMAIL=jason931225@gmail.com
