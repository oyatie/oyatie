{
  "schema_version": "1.0.0",
  "authority": "ADR-0630 D8",
  "purpose": "RETIRED tombstone \u2014 Credential-gated, exact-head bootstrap of the candidate-only ARC PostgreSQL cell before protected admission.",
  "blocked_until_issue_closed": 1504,
  "maximum_ttl_seconds": 7200,
  "preconditions": [
    "candidate_head_is_the_current_pull_request_head",
    "candidate_head_has_a_valid_ssh_signature",
    "issue_1504_capacity_is_verified",
    "argocd_root_current_revision_is_dev",
    "no_other_candidate_bootstrap_is_active"
  ],
  "application": {
    "api_version": "argoproj.io/v1alpha1",
    "kind": "Application",
    "namespace": "argocd",
    "name": "root"
  },
  "placeholders": {
    "candidate_head": "${CANDIDATE_HEAD}",
    "pull_request": "${PULL_REQUEST}",
    "expires_at": "${EXPIRES_AT_RFC3339}",
    "operator": "${OPERATOR}",
    "evidence_packet": "${EVIDENCE_PACKET}"
  },
  "apply_json_patch": [
    {
      "op": "test",
      "path": "/spec/source/targetRevision",
      "value": "dev"
    },
    {
      "op": "replace",
      "path": "/spec/source/targetRevision",
      "value": "${CANDIDATE_HEAD}"
    },
    {
      "op": "add",
      "path": "/spec/source/helm/valuesObject/targetRevision",
      "value": "${CANDIDATE_HEAD}"
    },
    {
      "op": "add",
      "path": "/metadata/annotations/oya.io~1ci-bootstrap-head",
      "value": "${CANDIDATE_HEAD}"
    },
    {
      "op": "add",
      "path": "/metadata/annotations/oya.io~1ci-bootstrap-pr",
      "value": "${PULL_REQUEST}"
    },
    {
      "op": "add",
      "path": "/metadata/annotations/oya.io~1ci-bootstrap-expires-at",
      "value": "${EXPIRES_AT_RFC3339}"
    },
    {
      "op": "add",
      "path": "/metadata/annotations/oya.io~1ci-bootstrap-operator",
      "value": "${OPERATOR}"
    },
    {
      "op": "add",
      "path": "/metadata/annotations/oya.io~1ci-bootstrap-evidence",
      "value": "${EVIDENCE_PACKET}"
    }
  ],
  "required_readback": [
    "root.status.sync.revision_equals_candidate_head",
    "live-postgres-network-policy.status.sync.revision_equals_candidate_head",
    "live-postgres-network-policy.status.health_is_healthy_before_scale_set",
    "live-postgres-arm64.values_source_revision_equals_candidate_head",
    "live-postgres-arm64.status.health_is_healthy",
    "both_live_postgres_jobs_execute_for_candidate_head"
  ],
  "rollback_json_patch": [
    {
      "op": "test",
      "path": "/spec/source/targetRevision",
      "value": "${CANDIDATE_HEAD}"
    },
    {
      "op": "replace",
      "path": "/spec/source/targetRevision",
      "value": "dev"
    },
    {
      "op": "remove",
      "path": "/spec/source/helm/valuesObject/targetRevision"
    },
    {
      "op": "remove",
      "path": "/metadata/annotations/oya.io~1ci-bootstrap-head"
    },
    {
      "op": "remove",
      "path": "/metadata/annotations/oya.io~1ci-bootstrap-pr"
    },
    {
      "op": "remove",
      "path": "/metadata/annotations/oya.io~1ci-bootstrap-expires-at"
    },
    {
      "op": "remove",
      "path": "/metadata/annotations/oya.io~1ci-bootstrap-operator"
    },
    {
      "op": "remove",
      "path": "/metadata/annotations/oya.io~1ci-bootstrap-evidence"
    }
  ],
  "rollback_required_on": [
    "candidate_superseded",
    "admission_failure",
    "expiry_reached",
    "operator_abort"
  ],
  "rollback_readback": [
    "root.status.sync.revision_is_dev",
    "candidate_annotations_absent",
    "candidate_only_children_pruned_if_not_merged",
    "rollback_evidence_packet_recorded"
  ],
  "non_claims": [
    "This file does not mutate a cluster.",
    "The patch request is not readback evidence.",
    "Expiry is an operator rollback deadline, not an autonomous cleanup controller."
  ],
  "status": "RETIRED",
  "retired_at": "2026-08-11",
  "retirement_note": "ARC live-postgres cell decommissioned. Live-PG gates use GitHub-hosted ubuntu-latest + postgres:16 services. Do not bootstrap this Application path."
}
