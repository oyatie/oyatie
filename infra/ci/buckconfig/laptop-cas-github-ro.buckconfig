# GitHub-hosted prelicense READ overlay — laptop CAS via Access TCP sidecar.
# See laptop-cas-github-rw.buckconfig header for path + BAN notes.

[buck2_re_client]
  engine_address = grpcs://127.0.0.1:55052
  cas_address = grpcs://127.0.0.1:55052
  action_cache_address = grpcs://127.0.0.1:55052
  instance_name = main
  tls = true

[oya_cache]
  remote_cache_enabled = true
  allow_cache_uploads = false

[build]
  execution_platforms = toolchains//cache:cache-platform
