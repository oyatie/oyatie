# Opt-in WARM READ-ONLY buck2 overlay — NativeLink CAS cache-first wiring (ADR-0560).
#
# Consumers: (a) the integrity-canary's WARM-PROBE step ONLY — the comparator fetch
# that retrieves the warm substrate's entries for the cold build's keys (ADR-0556 D2;
# the canary's own from-empty build runs with NO overlay at all — bypass, not
# read-only); (b) the future untrusted-author read-only relaxation, which is a
# separate reviewed policy edit per ADR-0556 D1 and is NOT enabled by this file's
# existence.
#
# Same dark-wiring + keyed-identity contract as warm-cache-rw.buckconfig: selected
# only by the controller under warm_reads_licensed=true; reader mTLS identity is
# materialized into private `.buckconfig.local` from secret-mounted env, never
# this file. allow_cache_uploads=false and the READER endpoint's Action Cache
# is served read_only=true at the service boundary, so even a misconfigured client
# cannot write through this path.

[buck2_re_client]
  engine_address = __CACHE_RE_ADDRESS__
  cas_address = __CACHE_RE_ADDRESS__
  action_cache_address = __CACHE_RE_ADDRESS__
  instance_name = __CACHE_INSTANCE_NAME__
  tls = true

[oya_cache]
  remote_cache_enabled = true
  allow_cache_uploads = false

[build]
  execution_platforms = toolchains//cache:cache-platform
