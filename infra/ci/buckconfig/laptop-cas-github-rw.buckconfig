# GitHub-hosted prelicense overlay — laptop CAS via Access TCP sidecar.
#
# Clients MUST first start:
#   infra/ci/laptop-cas/start-access-tcp.sh
# which listens on 127.0.0.1:55051 (write) / :55052 (read).
#
# Tunnel origin (:50151/:50152) is TLS without client-CA; Access Service Auth is
# the public belt. Do NOT point Buck2 at cw/cr.oyatie.dev:443 directly — this
# Cloudflare zone returns 403 for application/grpc on the HTTP proxy path.
#
# NEVER merged into root .buckconfig. NOT selected by the warm-license resolver
# while warm_reads_licensed=false. Used only by the dispatch-only
# laptop-cas-gha-proof workflow (outside oya-ci-required).

[buck2]
  default_allow_cache_upload = true

[buck2_re_client]
  engine_address = grpcs://127.0.0.1:55051
  cas_address = grpcs://127.0.0.1:55051
  action_cache_address = grpcs://127.0.0.1:55051
  instance_name = main
  tls = true
  # tls_ca_certs injected into .buckconfig.local by the proof workflow (lab CA)

[oya_cache]
  remote_cache_enabled = true
  allow_cache_uploads = true

[build]
  execution_platforms = toolchains//cache:cache-platform
