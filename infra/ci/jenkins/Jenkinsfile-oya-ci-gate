// ADR-0380 D3: oya-ci-gate pipeline body.
//
// Loaded via cpsScm from this repo (path: infra/ci/jenkins/Jenkinsfile-oya-ci-gate),
// referenced by the pipelineJob('oya-ci-gate') declared in JCasC
// (infra/ci/jenkins/values-local.yaml configScripts.oya-ci-gate-job).
//
// Trigger: the ci-webhook-gateway (ADR-0374) POSTs a FLAT JSON body
// {pr_number, head_sha, head_ref, kind, revalidation} to Jenkins' Generic
// Webhook Trigger endpoint with token=oya-ci-gate. The genericTrigger extracts
// PR_NUMBER ($.pr_number) / GIT_SHA ($.head_sha) / GIT_BRANCH ($.head_ref) and
// exposes them as env vars. The body carries no repo field, so the repo
// (oya-admin/oyatie) is hardcoded in postGitHubStatus below.
//
// Status posting uses the GitHub statuses API
// (POST /repos/{owner}/{repo}/statuses/{sha}) authed by the github-ci-token
// credential (declared in JCasC oya-ci-credentials; minted in ADR-0380 D4).
// The github-ci-token Secret may not exist before D4 ships; until then the
// withCredentials block will fail at the credential-not-found step and Jenkins
// will mark the build FAILED — that's the honest failure mode (we shouldn't
// silently skip status posting once the gate exists).

pipeline {
  agent {
    kubernetes {
      cloud 'oya-ci-kubernetes'
      label 'oya-rust-ci'
      defaultContainer 'rust'
    }
  }
  options {
    timeout(time: 60, unit: 'MINUTES')
    buildDiscarder(logRotator(numToKeepStr: '50'))
  }
  stages {
    stage('Checkout PR ref') {
      steps {
        // Private GitHub needs auth for the PR-ref fetch; the cpsScm clone's
        // transient askpass is gone by now. GIT_ASKPASS keeps creds out of argv/console.
        withCredentials([usernamePassword(credentialsId: 'github-clone', usernameVariable: 'GIT_USER', passwordVariable: 'GIT_PASS')]) {
          sh '''
            set -eu  # dash-compatible (rust-ci /bin/sh = dash; no `pipefail`)
            cd "${WORKSPACE}"
            ASKPASS="${WORKSPACE}/.ci-askpass.sh"
            printf '#!/bin/sh\ncase "$1" in Username*) printf "%%s" "$GIT_USER";; *) printf "%%s" "$GIT_PASS";; esac\n' > "$ASKPASS"
            chmod +x "$ASKPASS"; export GIT_ASKPASS="$ASKPASS"
            # Full history (the Jenkins SCM clone is shallow → git merge-base finds no
            # common ancestor → affected-detection fails). Unshallow once; the `|| true`
            # is a no-op if the repo is already complete. (cf. GitHub Actions fetch-depth: 0.)
            git fetch --unshallow origin 2>/dev/null || true
            git fetch origin "+refs/pull/${PR_NUMBER}/head:refs/remotes/origin/pr-${PR_NUMBER}"
            git fetch origin "+refs/heads/dev:refs/remotes/origin/dev"
            rm -f "$ASKPASS"
            git checkout "${GIT_SHA}"
            git --no-pager log --oneline -1
          '''
        }
      }
    }
    stage('Post pending status') {
      steps {
        withCredentials([string(credentialsId: 'github-ci-token', variable: 'GITHUB_TOKEN')]) {
          script { postGitHubStatus('pending', 'buck2 affected gate running') }
        }
      }
    }
    stage('buck2 affected gate') {
      steps {
        sh '''
          # NOTE: deliberately NO `set -e` here — we must capture the gate's real exit
          # code even on failure for diagnostics. rust-ci /bin/sh = dash (no pipefail /
          # PIPESTATUS), so the gate runs in a subshell that writes its rc to a file while
          # stdout is teed to .gate-output.log (post{failure} posts the tail as a PR
          # comment) and still streams to the Jenkins console. No oya-dev-cli.
          cd "${WORKSPACE}" || exit 1
          rm -f .gate-rc .gate-output.log .gate-summary.txt   # defense-in-depth: never read stale state
          ( sh infra/ci/buck2-affected-gate.sh origin/dev 2>&1; echo "$?" > .gate-rc ) | tee .gate-output.log
          # Normalize to a clean single integer; missing/garbage rc -> 1 (fail-closed).
          rc=$(cat .gate-rc 2>/dev/null | head -1 | tr -dc '0-9'); rc=${rc:-1}
          echo "buck2-affected-gate rc=${rc}"
          if [ "${rc}" != "0" ]; then
            # Distill the ROOT CAUSE into a one-line commit-status summary (the RELIABLE channel —
            # the best-effort PR comment often does not post). Prefer the target of the actual
            # failing ACTION (buck2 prints "Action failed: <cell>//...") over the top-level
            # "Failed to build root//..." target — the latter is just a binary that failed because
            # a dependency (e.g. third-party//:openssl-0.10) failed, so it hid the real culprit.
            # Match ANY cell (root//, third-party//, ...), not only root//. Then APPEND the first
            # substantive error message so the status shows what actually broke. Patterns use NO
            # quotes/backslashes (this is inside a Groovy triple-single-quote string that processes
            # escapes; bare brackets [] are fine, but a backslash or a stray triple-quote is not).
            TGT=$(grep -aE "Action failed:" .gate-output.log 2>/dev/null | grep -aoE "[a-z0-9_.-]+//[^ )]+" | head -1)
            [ -z "${TGT}" ] && TGT=$(grep -aE "Failed to build|Fail: " .gate-output.log 2>/dev/null | grep -aoE "[a-z0-9_.-]+//[^ )']+" | head -1)
            ERR=$(grep -aiE "cannot find|undefined reference|undefined symbol|error: linking|ld.lld: error|ld: error|multiple definition|relocation|panicked|aborting due to|mismatched types|TESTS FAILED" .gate-output.log 2>/dev/null | grep -avE "For more information|--explain|use -v|^warning:" | head -1)
            SUM=$(printf '%s | %s' "${TGT}" "${ERR}")
            printf '%s' "${SUM}" | tr -cd 'A-Za-z0-9 |/:._-' | tr -s ' ' | cut -c1-230 > .gate-summary.txt
          fi
          [ "${rc}" = "0" ] || exit "${rc}"
        '''
      }
    }
  }
  post {
    success {
      withCredentials([string(credentialsId: 'github-ci-token', variable: 'GITHUB_TOKEN')]) {
        script { postGitHubStatus('success', 'buck2 affected gate passed') }
      }
    }
    failure {
      withCredentials([string(credentialsId: 'github-ci-token', variable: 'GITHUB_TOKEN')]) {
        script {
          // Enrich the commit-status description with the failing target(s) — the RELIABLE
          // channel (status posting is proven; the PR comment may fail on token-scope/sandbox).
          def desc = 'buck2 affected gate failed'
          try {
            def sp = "${env.WORKSPACE}/.gate-summary.txt"
            if (fileExists(sp)) { def s = readFile(sp).trim(); if (s) { desc = ('gate: ' + s).take(240) } }
          } catch (err) { echo "summary read skipped: ${err}" }
          postGitHubStatus('failure', desc)
          // Best-effort: also post the full output tail as a PR comment (richer, but may fail).
          // Wrapped in try/catch so a diagnostics failure can NEVER change the verdict (above).
          try { postGitHubGateLog() } catch (err) { echo "gate-log comment skipped: ${err}" }
        }
      }
    }
    aborted {
      // A timeout/abort MUST still post a TERMINAL status, else the gate is stuck 'pending'
      // forever and the PR can never resolve. Bridge hardening (oya-ci #87).
      withCredentials([string(credentialsId: 'github-ci-token', variable: 'GITHUB_TOKEN')]) {
        script { postGitHubStatus('failure', 'buck2 affected gate aborted: timeout or abort') }
      }
    }
  }
}

// Post a commit-status to GitHub. Uses cluster-internal GitHub service URL
// (ADR-0363 GitHub canonical; ADR-0378 Talos substrate).
def postGitHubStatus(String state, String description) {
  httpRequest(
    url: "https://api.github.com/api/v1/repos/oya-admin/oyatie/statuses/${env.GIT_SHA}",
    httpMode: 'POST',
    customHeaders: [
      [name: 'Authorization', value: "token ${env.GITHUB_TOKEN}", maskValue: true],
      [name: 'Content-Type',  value: 'application/json']
    ],
    requestBody: """{"state":"${state}","context":"oya-ci-gate","description":"${description}"}""",
    validResponseCodes: '200,201',
    consoleLogResponseBody: true,
    ignoreSslErrors: true
  )
}

// Post the tail of the gate output (.gate-output.log, captured by the gate stage) as a
// GitHub PR comment, so a gate FAILURE is diagnosable without Jenkins console access.
// Best-effort: callers wrap this in try/catch — it must never affect the gate verdict.
def postGitHubGateLog() {
  if (!env.PR_NUMBER?.trim()) { echo 'postGitHubGateLog: no PR_NUMBER; skipping'; return }
  def path = "${env.WORKSPACE}/.gate-output.log"
  if (!fileExists(path)) { echo 'postGitHubGateLog: no .gate-output.log; skipping'; return }
  def lines = readFile(path).readLines()
  def keep = lines.size() > 150 ? lines[-150..-1] : lines
  def body = "**oya-ci-gate FAILED** — buck2 affected gate output (last ${keep.size()} of ${lines.size()} lines):\n\n```\n${keep.join('\n')}\n```"
  httpRequest(
    url: "https://api.github.com/api/v1/repos/oya-admin/oyatie/issues/${env.PR_NUMBER}/comments",
    httpMode: 'POST',
    customHeaders: [
      [name: 'Authorization', value: "token ${env.GITHUB_TOKEN}", maskValue: true],
      [name: 'Content-Type',  value: 'application/json']
    ],
    requestBody: groovy.json.JsonOutput.toJson([body: body]),
    validResponseCodes: '200,201',
    consoleLogResponseBody: false,
    ignoreSslErrors: true
  )
}
