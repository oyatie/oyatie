// ADR-0380 D3: oya-ci-gate pipeline body.
//
// Loaded via cpsScm from this repo (path: infra/ci/jenkins/Jenkinsfile-oya-ci-gate),
// referenced by the pipelineJob('oya-ci-gate') declared in JCasC
// (infra/ci/jenkins/values-local.yaml configScripts.oya-ci-gate-job).
//
// Trigger: the ci-webhook-gateway (ADR-0374) POSTs a FLAT JSON body
// {pr_number, head_sha, head_ref, kind, revalidation} to Jenkins' Generic
// Webhook Trigger endpoint with token=oya-ci-gate. The genericTrigger extracts
// PR_NUMBER ($.pr_number) / GIT_SHA ($.head_sha) / GIT_BRANCH ($.head_ref) and
// exposes them as env vars. The body carries no repo field, so the repo
// (oya-admin/oyatie) is hardcoded in postForgejoStatus below.
//
// Status posting uses the Forgejo statuses API
// (POST /repos/{owner}/{repo}/statuses/{sha}) authed by the forgejo-ci-token
// credential (declared in JCasC oya-ci-credentials; minted in ADR-0380 D4).
// The forgejo-ci-token Secret may not exist before D4 ships; until then the
// withCredentials block will fail at the credential-not-found step and Jenkins
// will mark the build FAILED — that's the honest failure mode (we shouldn't
// silently skip status posting once the gate exists).

pipeline {
  agent {
    kubernetes {
      cloud 'oya-ci-kubernetes'
      label 'oya-rust-ci'
      defaultContainer 'rust'
    }
  }
  options {
    timeout(time: 60, unit: 'MINUTES')
    buildDiscarder(logRotator(numToKeepStr: '50'))
  }
  stages {
    stage('Checkout PR ref') {
      steps {
        // Private Forgejo needs auth for the PR-ref fetch; the cpsScm clone's
        // transient askpass is gone by now. GIT_ASKPASS keeps creds out of argv/console.
        withCredentials([usernamePassword(credentialsId: 'forgejo-clone', usernameVariable: 'GIT_USER', passwordVariable: 'GIT_PASS')]) {
          sh '''
            set -eu  # dash-compatible (rust-ci /bin/sh = dash; no `pipefail`)
            cd "${WORKSPACE}"
            ASKPASS="${WORKSPACE}/.ci-askpass.sh"
            printf '#!/bin/sh\ncase "$1" in Username*) printf "%%s" "$GIT_USER";; *) printf "%%s" "$GIT_PASS";; esac\n' > "$ASKPASS"
            chmod +x "$ASKPASS"; export GIT_ASKPASS="$ASKPASS"
            # Full history (the Jenkins SCM clone is shallow → git merge-base finds no
            # common ancestor → affected-detection fails). Unshallow once; the `|| true`
            # is a no-op if the repo is already complete. (cf. GitHub Actions fetch-depth: 0.)
            git fetch --unshallow origin 2>/dev/null || true
            git fetch origin "+refs/pull/${PR_NUMBER}/head:refs/remotes/origin/pr-${PR_NUMBER}"
            git fetch origin "+refs/heads/dev:refs/remotes/origin/dev"
            rm -f "$ASKPASS"
            git checkout "${GIT_SHA}"
            git --no-pager log --oneline -1
          '''
        }
      }
    }
    stage('Post pending status') {
      steps {
        withCredentials([string(credentialsId: 'forgejo-ci-token', variable: 'FORGEJO_TOKEN')]) {
          script { postForgejoStatus('pending', 'buck2 affected gate running') }
        }
      }
    }
    stage('buck2 affected gate') {
      steps {
        sh '''
          set -eu  # dash-compatible (rust-ci /bin/sh = dash; no `pipefail`)
          cd "${WORKSPACE}"
          # buck2 stores its daemon state under $HOME/.buck; the pod runs as UID 1000
          # with HOME=/ (root, unwritable). Point HOME at a writable dir OUTSIDE the
          # repo (inside the repo, .buck interferes with buck2 project-root detection).
          export HOME=/tmp/buck2-home && mkdir -p "$HOME"
          # buck2-native affected gate: build+test the reverse-dep closure of the
          # PR's changed files (owner() + rdeps), via the hermetic toolchain cell.
          # No cargo, no oya-dev-cli. buck2 is provided by the rust-ci image.
          sh infra/ci/buck2-affected-gate.sh origin/dev
        '''
      }
    }
  }
  post {
    success {
      withCredentials([string(credentialsId: 'forgejo-ci-token', variable: 'FORGEJO_TOKEN')]) {
        script { postForgejoStatus('success', 'buck2 affected gate passed') }
      }
    }
    failure {
      withCredentials([string(credentialsId: 'forgejo-ci-token', variable: 'FORGEJO_TOKEN')]) {
        script { postForgejoStatus('failure', 'buck2 affected gate failed') }
      }
    }
  }
}

// Post a commit-status to Forgejo. Uses cluster-internal Forgejo service URL
// (ADR-0363 Forgejo canonical; ADR-0378 Talos substrate).
def postForgejoStatus(String state, String description) {
  httpRequest(
    url: "http://forgejo.oya-forge.svc.cluster.local:3000/api/v1/repos/oya-admin/oyatie/statuses/${env.GIT_SHA}",
    httpMode: 'POST',
    customHeaders: [
      [name: 'Authorization', value: "token ${env.FORGEJO_TOKEN}", maskValue: true],
      [name: 'Content-Type',  value: 'application/json']
    ],
    requestBody: """{"state":"${state}","context":"oya-ci-gate","description":"${description}"}""",
    validResponseCodes: '200,201',
    consoleLogResponseBody: true,
    ignoreSslErrors: true
  )
}
