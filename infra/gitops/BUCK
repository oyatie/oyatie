load("//governance/corpus/extract:yaml_facts.bzl", "corpus_yaml_facts_shards")

# Corpus graph extraction (ADR-0541). GitOps declarative inputs must be
# in-graph so new YAML does not raise the unpackaged ceiling.
corpus_yaml_facts_shards(
    srcs = glob(["**/*.yaml", "**/*.yml"]),
    shard_size = 256,
)
