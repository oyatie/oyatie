# The backup manifests are UNAPPLIED and unwired to GitOps by design (see README.md); this
# package puts them in the BUILD GRAPH so their YAML facts are a build output, which is a
# different question from whether anything reconciles them. Without it the corpus-index-coverage
# ratchet is correct to block: new YAML outside every buck2 package is new NORTHSTAR debt.
load("//governance/corpus/extract:yaml_facts.bzl", "corpus_yaml_facts_shards")

corpus_yaml_facts_shards(
    srcs = glob(["**/*.yaml", "**/*.yml"]),
    shard_size = 256,
)
