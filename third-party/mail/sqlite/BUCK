    name = "libsqlite3-source",
    urls = ["https://static.crates.io/crates/libsqlite3-sys/0.30.1/download"],
    sha256 = "2e99fb7a497b1e3339bc746195567ed8d3e24945ecd636e3619d20b9de9e9149",
