load("//:pinned.bzl", "pinned_crate")

# Stalwart Labs mail-auth 0.13.3: Apache-2.0 OR MIT. SPF, DKIM, DMARC and ARC
# evaluation for the inbound SMTP path. Archive checksums match Cargo.lock.
#
# Neither feature here is discretionary. The crate refuses to build without a
# DNS backend (`compile_error!` in src/lib.rs) and does not compile without a
# crypto backend either, so `dns-hickory` and a provider are both mandatory.
# `aws-lc-rs` is the provider rustls already uses in //mail/tls, and it and
# `ring` cost the same in the Cargo graph, so it adds no new crate here.
#
# Under Cargo, mail-auth's `aws-lc-rs` feature forwards tls, dnssec and
# rustls-platform-verifier on to hickory-resolver; Buck has no such
# forwarding, so this links the existing //mail/dns:hickory-resolver built
# with ["tokio"] and none of that tree is pulled in.
pinned_crate(
    name = "mail-auth",
    version = "0.13.3",
    sha256 = "8505122ba86e1f4adeb664196c1e787c3f29bb6e7c128e4a366d47d209911440",
    edition = "2024",
    features = ["aws-lc-rs", "dns-hickory"],
    deps = [
        ":flate2",
        ":similar",
        "//:serde",
        "//:serde_json",
        "//mail:hashify",
        "//mail:mail-builder",
        "//mail:mail-parser",
        "//mail:memchr",
        "//mail/dns:hickory-resolver",
        "//mail/dns:idna",
        "//mail/tls:aws-lc-rs",
        "//mail/tls:rustls-pki-types",
    ],
    visibility = ["PUBLIC"],
)

# MIT OR Apache-2.0. mail-auth takes flate2 unconditionally. Only the pure
# Rust backend is declared: `runtime_detection` reaches for zlib-rs, which
# nothing here needs.
pinned_crate(
    name = "flate2",
    version = "1.1.10",
    sha256 = "6e634e2e0ebac1ee034020da1ca582e17ffe4e0f5e985823721e168928136dcb",
    edition = "2018",
    features = ["any_impl", "miniz_oxide", "rust_backend"],
    deps = [":crc32fast", ":miniz_oxide"],
)

# MIT OR Apache-2.0.
pinned_crate(
