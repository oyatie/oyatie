#!/bin/bash
# Tracked pre-push. Does not compile (PORTABLE hard-ban 11 / ADR-0711 D-9).
# Agent-directory refuse lives in pre-commit; this hook only delegates to
# local untracked hooks so per-developer tooling survives.
set -uo pipefail
if [ -n "${SKIP_TRACKED_HOOKS:-}" ]; then exit 0; fi

for local_hook in .beads/hooks/pre-push .git/hooks/pre-push.local; do
    if [ -x "$local_hook" ]; then "$local_hook" "$@" || exit $?; fi
done
exit 0
