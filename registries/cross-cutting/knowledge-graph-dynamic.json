{
  "_schema_ref": "/specs/cross-cutting/knowledge-graph-schema.json#v1.0.0",
  "_artifact_id": "knowledge-graph-dynamic",
  "_layer": "dynamic",
  "_meta": {
    "doc_class": "Registry",
    "purpose": "DYNAMIC layer (Palantir Foundry 3-layer model): live state + telemetry pointers + audit-chain event stream. WHAT THINGS ARE RIGHT NOW. Real-time + time-series + recent activity.",
    "owner_team": "council-architecture + axis-foundry",
    "version": "1.0.0",
    "created_at": "2026-05-13T00:00:00Z",
    "sibling_layers": [
      "/registries/cross-cutting/knowledge-graph-semantic.json (type definitions)",
      "/registries/cross-cutting/knowledge-graph-kinetic.json (action types + workflows)"
    ],
    "palantir_analog": "Time-series + Streams + Live State in Palantir Foundry Ontology"
  },
  "live_state_sources": {
    "Artifact-current-capabilities": {
      "source_path": "/registries/cross-cutting/artifact-capabilities-registry.json",
      "shape": "rows[].artifact_profile + rows[].capability_overrides",
      "freshness": "manual-edit-on-state-change",
      "consumer": "oya-check-active-artifact-contract validator"
    },
    "Block-current-consumers": {
      "source_path": "/registries/cross-cutting/reusable-building-blocks-registry.json",
      "shape": "blocks[].consumer_refs + blocks[].consumer_selectors + blocks[].consumer_count_listed",
      "freshness": "manual-edit-on-edge-change; auto-compute deferred to drift-detector",
      "consumer": "DRY drift detector (planned)"
    },
    "Wave-current-status": {
      "source_path": "/evidence/ledger/ops-portal-ledger.json",
      "shape": "rows[].status + rows[].evidence_refs",
      "freshness": "per-commit (manual)",
      "consumer": "claim-matrix gate-coverage rows"
    },
    "Lane-current-status": {
      "source_path": "registry/quality/lanes.yaml",
      "shape": "lanes[].status (active|planned)",
      "freshness": "per-commit",
      "consumer": "all PR checks + ADR-0069 \u00a711 lifecycle rule (b)"
    },
    "Plan-current-version": {
      "source_path": ".omc/plans/ralplan-ops-wave-{N}-2026-05-13.json (instances of plan-schema.json)",
      "shape": "frontmatter.version + frontmatter.status + verification_status.rounds[*]",
      "freshness": "per-consensus-round (manual)",
      "consumer": "ledger row for that wave"
    },
    "Markdown-retirement-progress": {
      "source_path": "/evidence/ledger/markdown-retirement-ledger.json",
      "shape": "rows[].status + rows[].migration_date",
      "freshness": "per-migration",
      "consumer": "PHASE-N tracking + completion gate"
    },
    "ICM-scaffold-locks": {
      "source_path": "ICM (icm recall -t scaffold-locks-oyatie)",
      "shape": "memory records with agent_id + paths + window=open|closed",
      "freshness": "real-time (icm store on each transition)",
      "consumer": "grit-fallback transitions per ADR-0054"
    },
    "Grit-current-claims": {
      "source_path": "grit status (CLI; backed by SQLite + worktree state)",
      "shape": "active claims per agent + symbols + TTL",
      "freshness": "real-time",
      "consumer": "every state transition via grit-protocol",
      "known_failure_mode": "SQLite FK error; fallback to scaffold-locks ICM"
    },
    "Audit-chain-event-stream": {
      "source_path": "(foundation prerequisite; M01/M02 audit-chain runtime)",
      "shape": "per-tenant per-cell EVT-... events emitted from kinetic actions",
      "freshness": "real-time (target \u22642s ingestion)",
      "consumer": "EmitEvidenceBundle action target + audit-view BC (Wave 7)",
      "status": "blocked-by-foundation"
    },
    "OpenTelemetry-metrics": {
      "source_path": "(planned per capability.telemetry.metrics; not yet operational)",
      "shape": "oya_* counter/gauge/histogram metrics per artifact",
      "freshness": "real-time",
      "consumer": "drift-detector dashboards (Wave 7) + per-artifact telemetry capability"
    }
  },
  "real_time_observability": {
    "metric_naming_convention": "^oya_[a-z][a-z0-9_]*$",
    "observability_standard": "opentelemetry",
    "cardinality_budgets_authority": "/registries/cross-cutting/artifact-capabilities-registry.json rows[].capability_overrides.telemetry.metrics[].cardinality_budget",
    "dashboard_authority": "(planned; per-artifact capability_overrides.telemetry.dashboard)"
  },
  "honest_gaps": [
    "Audit-chain event stream blocked-by-foundation (M01/M02 prerequisite)",
    "OpenTelemetry metric exporters declared in capability registry but not yet operational",
    "Grit live state has known SQLite FK failure mode; ICM scaffold-lock fallback active",
    "Auto-compute of consumer_count from graph edges (DRY drift detector) is planned, not operational"
  ]
}
