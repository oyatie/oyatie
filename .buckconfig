[cells]
  root = .
  prelude = prelude
  toolchains = toolchains
  none = none
  third-party = third-party

[cell_aliases]
  config = prelude
  ovr_config = prelude
  fbcode = none
  fbsource = none
  fbcode_macros = none
  buck = none

# Uses a copy of the prelude bundled with the buck2 binary. You can alternatively delete this
# section and vendor a copy of the prelude to the `prelude` directory of your project.
[external_cells]
  prelude = bundled

[parser]
  target_platform_detector_spec = target:root//...->prelude//platforms:default \
    target:prelude//...->prelude//platforms:default \
    target:toolchains//...->prelude//platforms:default \
    target:third-party//...->prelude//platforms:default

[cache]
  # CI and laptop performance: keep Buck2 artifacts in a reusable local artifact cache.
  # This path is stable across runs when combined with CI-level restore keys, so
  # repeated action graph work can avoid re-downloading compiler outputs.
  mode = dir
  dir = ~/.cache/oya-buck2
  dir_mode = readwrite
  dir_max_size = 20GB

[build]
  execution_platforms = prelude//platforms:default
