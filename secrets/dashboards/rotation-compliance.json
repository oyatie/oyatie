{
  "$schema": "https://grafana.com/api/dashboards/json-schema",
  "title": "cloud-secrets — Rotation Compliance",
  "uid": "cloud-secrets-rotation-compliance",
  "tags": ["cloud-secrets", "rotation", "compliance"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {"from": "now-30d", "to": "now"},
  "templating": {
    "list": [
      {"name": "pack", "type": "custom", "label": "Pack", "options": [
        {"text": "kr", "value": "kr", "selected": true},
        {"text": "eu", "value": "eu"},
        {"text": "us", "value": "us"},
        {"text": "us-hc", "value": "us-hc"},
        {"text": "jp", "value": "jp"}, {"text": "sg", "value": "sg"},
        {"text": "au", "value": "au"}, {"text": "in", "value": "in"},
        {"text": "br", "value": "br"}, {"text": "ae", "value": "ae"},
        {"text": "ksa", "value": "ksa"}
      ]}
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Rotations completed (last 30d)",
      "type": "stat",
      "datasource": "mimir-cloud-secrets",
      "gridPos": {"x": 0, "y": 0, "w": 8, "h": 6},
      "targets": [
        {"expr": "sum(increase(cloud_secrets_rotation_completed_total{pack=\"$pack\"}[30d]))"}
      ]
    },
    {
      "id": 2,
      "title": "Rotations overdue NOW",
      "type": "stat",
      "datasource": "mimir-cloud-secrets",
      "gridPos": {"x": 8, "y": 0, "w": 8, "h": 6},
      "targets": [
        {"expr": "cloud_secrets_rotation_overdue_count{pack=\"$pack\"}"}
      ],
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [
        {"color": "green", "value": null}, {"color": "yellow", "value": 1}, {"color": "red", "value": 5}
      ]}}}
    },
    {
      "id": 3,
      "title": "Rotation SLA conformance (last 30d)",
      "type": "stat",
      "datasource": "mimir-cloud-secrets",
      "gridPos": {"x": 16, "y": 0, "w": 8, "h": 6},
      "targets": [
        {"expr": "1 - (sum(increase(cloud_secrets_rotation_sla_breach_total{pack=\"$pack\"}[30d])) / sum(increase(cloud_secrets_rotation_completed_total{pack=\"$pack\"}[30d])))"}
      ],
      "fieldConfig": {"defaults": {"unit": "percentunit", "thresholds": {"mode": "absolute", "steps": [
        {"color": "red", "value": null}, {"color": "yellow", "value": 0.99}, {"color": "green", "value": 0.995}
      ]}}}
    },
    {
      "id": 4,
      "title": "Rotation p99 latency (per secret)",
      "type": "timeseries",
      "datasource": "mimir-cloud-secrets",
      "gridPos": {"x": 0, "y": 6, "w": 12, "h": 8},
      "targets": [
        {"expr": "histogram_quantile(0.99, sum by (le, secret_class) (rate(cloud_secrets_rotation_duration_seconds_bucket{pack=\"$pack\"}[1h])))",
         "legendFormat": "p99 {{secret_class}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"mode": "absolute", "steps": [
        {"color": "green", "value": null}, {"color": "yellow", "value": 20}, {"color": "red", "value": 30}
      ]}}}
    },
    {
      "id": 5,
      "title": "Cascade rotation depth (max)",
      "type": "timeseries",
      "datasource": "mimir-cloud-secrets",
      "gridPos": {"x": 12, "y": 6, "w": 12, "h": 8},
      "targets": [
        {"expr": "max by (pack) (cloud_secrets_cascade_depth{pack=\"$pack\"})"}
      ]
    },
    {
      "id": 6,
      "title": "KEK age (days since last rotation, by pack)",
      "type": "table",
      "datasource": "mimir-cloud-secrets",
      "gridPos": {"x": 0, "y": 14, "w": 12, "h": 8},
      "targets": [
        {"expr": "(time() - cloud_secrets_kek_last_rotated_seconds{pack=\"$pack\"}) / 86400",
         "format": "table"}
      ],
      "fieldConfig": {"defaults": {"unit": "d", "thresholds": {"mode": "absolute", "steps": [
        {"color": "green", "value": null}, {"color": "yellow", "value": 300}, {"color": "red", "value": 360}
      ]}}}
    },
    {
      "id": 7,
      "title": "HSM attestation status (last 30d, by pack)",
      "type": "timeseries",
      "datasource": "mimir-cloud-secrets",
      "gridPos": {"x": 12, "y": 14, "w": 12, "h": 8},
      "targets": [
        {"expr": "cloud_secrets_hsm_attestation_verified{pack=\"$pack\"}",
         "legendFormat": "{{partition_id}}"}
      ],
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [
        {"color": "red", "value": null}, {"color": "green", "value": 1}
      ]}}}
    },
    {
      "id": 8,
      "title": "Rotation overdue by class (table)",
      "type": "table",
      "datasource": "mimir-cloud-secrets",
      "gridPos": {"x": 0, "y": 22, "w": 24, "h": 8},
      "targets": [
        {"expr": "cloud_secrets_rotation_overdue_count{pack=\"$pack\"} > 0",
         "format": "table"}
      ]
    }
  ]
}
