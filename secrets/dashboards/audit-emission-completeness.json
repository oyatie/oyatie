{
  "$schema": "https://grafana.com/api/dashboards/json-schema",
  "title": "cloud-secrets — Audit Emission Completeness",
  "uid": "cloud-secrets-audit-completeness",
  "tags": ["cloud-secrets", "audit", "compliance"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-24h", "to": "now"},
  "templating": {
    "list": [
      {"name": "pack", "type": "custom", "label": "Pack", "options": [
        {"text": "kr", "value": "kr", "selected": true},
        {"text": "eu", "value": "eu"}, {"text": "us", "value": "us"},
        {"text": "us-hc", "value": "us-hc"}, {"text": "jp", "value": "jp"},
        {"text": "sg", "value": "sg"}, {"text": "au", "value": "au"},
        {"text": "in", "value": "in"}, {"text": "br", "value": "br"},
        {"text": "ae", "value": "ae"}, {"text": "ksa", "value": "ksa"}
      ]}
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Audit emission backlog (seconds)",
      "type": "stat",
      "datasource": "mimir-cloud-secrets",
      "gridPos": {"x": 0, "y": 0, "w": 8, "h": 6},
      "targets": [
        {"expr": "cloud_secrets_audit_emission_backlog_seconds{pack=\"$pack\"}"}
      ],
      "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"mode": "absolute", "steps": [
        {"color": "green", "value": null},
        {"color": "yellow", "value": 60},
        {"color": "red", "value": 300}
      ]}}}
    },
    {
      "id": 2,
      "title": "Audit emission rate (events/sec)",
      "type": "timeseries",
      "datasource": "mimir-cloud-secrets",
      "gridPos": {"x": 8, "y": 0, "w": 16, "h": 6},
      "targets": [
        {"expr": "sum by (event_type) (rate(cloud_secrets_audit_emit_total{pack=\"$pack\"}[1m]))",
         "legendFormat": "{{event_type}}"}
      ]
    },
    {
      "id": 3,
      "title": "Audit emission completeness (24h sample)",
      "type": "stat",
      "datasource": "mimir-cloud-secrets",
      "gridPos": {"x": 0, "y": 6, "w": 8, "h": 6},
      "targets": [
        {"expr": "sum(increase(cloud_secrets_audit_chain_sealed_total{pack=\"$pack\"}[24h])) / sum(increase(cloud_secrets_audit_emitted_total{pack=\"$pack\"}[24h]))"}
      ],
      "fieldConfig": {"defaults": {"unit": "percentunit", "thresholds": {"mode": "absolute", "steps": [
        {"color": "red", "value": null}, {"color": "yellow", "value": 0.9995}, {"color": "green", "value": 0.9999}
      ]}}}
    },
    {
      "id": 4,
      "title": "Audit-chain seal latency p99",
      "type": "timeseries",
      "datasource": "mimir-cloud-secrets",
      "gridPos": {"x": 8, "y": 6, "w": 16, "h": 6},
      "targets": [
        {"expr": "histogram_quantile(0.99, sum by (le) (rate(cloud_secrets_audit_seal_duration_seconds_bucket{pack=\"$pack\"}[5m])))",
         "legendFormat": "p99"}
      ],
      "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"mode": "absolute", "steps": [
        {"color": "green", "value": null}, {"color": "yellow", "value": 0.8}, {"color": "red", "value": 1}
      ]}}}
    },
    {
      "id": 5,
      "title": "Local audit-device file size (per OpenBao pod)",
      "type": "timeseries",
      "datasource": "mimir-cloud-secrets",
      "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
      "targets": [
        {"expr": "cloud_secrets_audit_device_file_bytes{pack=\"$pack\"}",
         "legendFormat": "{{pod}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "bytes"}}
    },
    {
      "id": 6,
      "title": "Audit-bridge throughput (events/sec)",
      "type": "timeseries",
      "datasource": "mimir-cloud-secrets",
      "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8},
      "targets": [
        {"expr": "rate(cloud_secrets_audit_bridge_events_total{pack=\"$pack\"}[1m])"}
      ]
    },
    {
      "id": 7,
      "title": "Audit events by type (last 24h)",
      "type": "bargauge",
      "datasource": "mimir-cloud-secrets",
      "gridPos": {"x": 0, "y": 20, "w": 24, "h": 8},
      "targets": [
        {"expr": "sum by (event_type) (increase(cloud_secrets_audit_emit_total{pack=\"$pack\"}[24h]))",
         "legendFormat": "{{event_type}}"}
      ]
    }
  ]
}
