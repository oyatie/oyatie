{
  "dashboard": {
    "title": "Ontology — Read-Path Library Freshness",
    "uid": "ontology-read-path-library-freshness",
    "tags": ["ontology", "read-path", "library-first", "ADR-0257"],
    "panels": [
      {
        "id": 1,
        "title": "Freshness lag (P50/P95/P99 seconds)",
        "type": "timeseries",
        "targets": [
          {"expr": "histogram_quantile(0.5, sum(rate(oya_ontology_read_path_library_freshness_lag_seconds_bucket[5m])) by (le, tenant_tier))", "legendFormat": "P50 {{tenant_tier}}"},
          {"expr": "histogram_quantile(0.95, sum(rate(oya_ontology_read_path_library_freshness_lag_seconds_bucket[5m])) by (le, tenant_tier))", "legendFormat": "P95 {{tenant_tier}}"},
          {"expr": "histogram_quantile(0.99, sum(rate(oya_ontology_read_path_library_freshness_lag_seconds_bucket[5m])) by (le, tenant_tier))", "legendFormat": "P99 {{tenant_tier}}"}
        ]
      },
      {
        "id": 2,
        "title": "Fallback-to-network rate (count/min)",
        "type": "timeseries",
        "targets": [
          {"expr": "sum(rate(oya_ontology_read_path_fallback_network_total[1m])) by (tenant_id)", "legendFormat": "{{tenant_id}}"}
        ]
      },
      {
        "id": 3,
        "title": "Library cache hit ratio",
        "type": "stat",
        "targets": [
          {"expr": "sum(rate(oya_ontology_read_path_library_cache_hit_total[5m])) / sum(rate(oya_ontology_read_path_library_lookup_total[5m]))"}
        ]
      },
      {
        "id": 4,
        "title": "Per-tenant cache size (bytes)",
        "type": "timeseries",
        "targets": [
          {"expr": "sum(oya_ontology_read_path_library_cache_bytes) by (tenant_id)"}
        ]
      }
    ],
    "templating": {
      "list": [
        {"name": "tenant_tier", "type": "query", "query": "label_values(oya_ontology_read_path_library_lookup_total, tenant_tier)"}
      ]
    }
  }
}
