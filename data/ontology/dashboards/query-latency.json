{
  "title": "Ontology — Function & Action Query Latency",
  "uid": "ontology-query-latency",
  "schemaVersion": 38,
  "tags": ["ontology", "function-engine", "action-engine", "latency"],
  "timezone": "browser",
  "refresh": "10s",
  "panels": [
    {
      "type": "timeseries",
      "title": "Function read p99 (target ≤ 50ms per ADR-0107)",
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (function_type, le) (rate(oya_ontology_function_evaluation_duration_seconds_bucket[5m])))",
          "legendFormat": "{{function_type}}"
        }
      ],
      "alert": {
        "name": "Function read p99 > 50ms",
        "conditions": [{"type": "query", "evaluator": {"type": "gt", "params": [0.050]}}]
      }
    },
    {
      "type": "timeseries",
      "title": "Function read p50/p99/p999 (overall)",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(oya_ontology_function_evaluation_duration_seconds_bucket[5m])))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(oya_ontology_function_evaluation_duration_seconds_bucket[5m])))",
          "legendFormat": "p99"
        },
        {
          "expr": "histogram_quantile(0.999, sum by (le) (rate(oya_ontology_function_evaluation_duration_seconds_bucket[5m])))",
          "legendFormat": "p999"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Action invocation p99 (target ≤ 150ms)",
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (action_type, le) (rate(oya_ontology_action_invocation_duration_seconds_bucket[5m])))",
          "legendFormat": "{{action_type}}"
        }
      ],
      "alert": {
        "name": "Action invocation p99 > 150ms",
        "conditions": [{"type": "query", "evaluator": {"type": "gt", "params": [0.150]}}]
      }
    },
    {
      "type": "timeseries",
      "title": "Function-engine throughput (QPS by tenant)",
      "targets": [
        {
          "expr": "sum by (tenant_id_hashed) (rate(oya_ontology_function_evaluations_total[5m]))",
          "legendFormat": "{{tenant_id_hashed}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Function cache hit rate (Valkey hot cache)",
      "targets": [
        {
          "expr": "rate(oya_ontology_function_cache_hit_total[5m]) / (rate(oya_ontology_function_cache_hit_total[5m]) + rate(oya_ontology_function_cache_miss_total[5m]))"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "OLAP (ClickHouse) Function read p99 (target ≤ 500ms)",
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (function_type, le) (rate(oya_ontology_function_evaluation_duration_seconds_bucket{olap=\"true\"}[5m])))",
          "legendFormat": "{{function_type}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "ClickHouse mirror lag seconds (target ≤ 60s)",
      "targets": [
        {
          "expr": "clickhouse_mirror_lag_seconds"
        }
      ],
      "alert": {
        "name": "ClickHouse mirror lag > 60s",
        "conditions": [{"type": "query", "evaluator": {"type": "gt", "params": [60]}}]
      }
    },
    {
      "type": "timeseries",
      "title": "Per-tenant 429 rate (rate-limited Function reads)",
      "targets": [
        {
          "expr": "sum by (tenant_id_hashed) (rate(oya_ontology_function_rate_limited_total[5m]))",
          "legendFormat": "{{tenant_id_hashed}}"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Function-engine pod replicas (HPA)",
      "targets": [
        {
          "expr": "kube_deployment_status_replicas{deployment=\"function-engine\"}"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Postgres connection pool utilization (Function-engine clients)",
      "targets": [
        {
          "expr": "(pgbouncer_pools_cl_active{database=\"ontology\"} / pgbouncer_pools_max_client_conn) * 100"
        }
      ]
    }
  ]
}
