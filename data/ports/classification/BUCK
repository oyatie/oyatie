load("@prelude//rust:cargo_buildscript.bzl", "buildscript_run")

rust_binary(
    name = "data-classification-build-script",
    srcs = ["build.rs"],
    crate = "build_script_build",
    crate_root = "build.rs",
    visibility = [],
)

rust_test(
    name = "data-classification-build-script-test",
    srcs = ["build.rs"],
    crate = "data_classification_build_script_test",
    crate_root = "build.rs",
    visibility = ["PUBLIC"],
)

export_file(name = "build.rs", visibility = [])

genrule(
    name = "data-classification-source-items",
    srcs = glob(["src/items/*.rs"]),
    out = "source_items",
    cmd = "mkdir -p $OUT && if [ -n \"$SRCS\" ]; then cp $SRCS $OUT/; fi",
)

genrule(
    name = "data-classification-contract-test-items",
    srcs = glob(["tests/items/*.rs"]),
    out = "contract_test_items",
    cmd = "mkdir -p $OUT && if [ -n \"$SRCS\" ]; then cp $SRCS $OUT/; fi",
)

genrule(
    name = "data-classification-manifest-dir",
    srcs = [
        ":build.rs",
        ":data-classification-source-items",
        ":data-classification-contract-test-items",
    ],
    out = "manifest_dir",
    cmd = "mkdir -p $OUT/src/items $OUT/tests/items && cp $(location :build.rs) $OUT/ && cp -R $(location :data-classification-source-items)/. $OUT/src/items/ && cp -R $(location :data-classification-contract-test-items)/. $OUT/tests/items/",
)

buildscript_run(
    name = "data-classification-build-script-run",
    buildscript_rule = ":data-classification-build-script",
    package_name = "data-classification",
    version = "0.1.0",
    manifest_dir = ":data-classification-manifest-dir",
)

_BUILD_ENV = {"OUT_DIR": "$(location :data-classification-build-script-run[out_dir])"}

rust_library(
    name = "data-classification",
    srcs = glob(["src/**/*.rs"]),
    crate = "data_classification",
    crate_root = "src/lib.rs",
    env = _BUILD_ENV,
    visibility = ["PUBLIC"],
)

rust_test(
    name = "data-classification-classification",
    srcs = ["tests/classification.rs"] + glob(["tests/items/*.rs"]),
    crate = "data_classification_classification",
    crate_root = "tests/classification.rs",
    env = _BUILD_ENV,
    visibility = ["PUBLIC"],
    deps = [
        ":data-classification",
    ],
)
