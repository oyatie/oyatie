{
  "schemaVersion": 39,
  "title": "Data Warehouse local operator remediation",
  "tags": [
    "data-warehouse",
    "local-operational-primitive",
    "adr-0130"
  ],
  "timezone": "utc",
  "templating": {
    "list": [
      {
        "name": "tenant_id",
        "type": "query",
        "query": "label_values(oya_data_warehouse_schema_drift_detection_total, tenant_id)"
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Schema drift detected before serving stale partitions burn",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(rate(oya_data_warehouse_schema_drift_detection_good_total[30d])) by (tenant_id, cell_tier) / sum(rate(oya_data_warehouse_schema_drift_detection_total[30d])) by (tenant_id, cell_tier)",
          "legendFormat": "schema-drift-detection ratio"
        }
      ]
    },
    {
      "id": 2,
      "title": "Lineage captured for refreshed partitions burn",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(oya_data_warehouse_lineage_capture_completeness_good_total[30d])) by (tenant_id, cell_tier) / sum(rate(oya_data_warehouse_lineage_capture_completeness_total[30d])) by (tenant_id, cell_tier)",
          "legendFormat": "lineage-capture-completeness ratio"
        }
      ]
    },
    {
      "id": 3,
      "title": "SLA-tier breach alerts emitted within objective burn",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(rate(oya_data_warehouse_sla_tier_breach_alert_good_total[5m])) by (tenant_id, cell_tier) / sum(rate(oya_data_warehouse_sla_tier_breach_alert_total[5m])) by (tenant_id, cell_tier)",
          "legendFormat": "sla-tier-breach-alert ratio"
        }
      ]
    },
    {
      "id": 4,
      "title": "Warehouse tables refreshed inside assigned SLA tier burn",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(oya_data_warehouse_freshness_good_total[30d])) by (tenant_id, cell_tier) / sum(rate(oya_data_warehouse_freshness_total[30d])) by (tenant_id, cell_tier)",
          "legendFormat": "freshness ratio"
        }
      ]
    },
    {
      "id": 5,
      "title": "Warehouse partitions complete against source totals burn",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(rate(oya_data_warehouse_completeness_good_total[30d])) by (tenant_id, cell_tier) / sum(rate(oya_data_warehouse_completeness_total[30d])) by (tenant_id, cell_tier)",
          "legendFormat": "completeness ratio"
        }
      ]
    },
    {
      "id": 6,
      "title": "Interactive warehouse query latency burn",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(oya_data_warehouse_query_latency_good_total[5m])) by (tenant_id, cell_tier) / sum(rate(oya_data_warehouse_query_latency_total[5m])) by (tenant_id, cell_tier)",
          "legendFormat": "query-latency ratio"
        }
      ]
    }
  ]
}
