load("//governance/corpus/extract:yaml_facts.bzl", "corpus_yaml_facts_shards")

# Export the analytics public contracts so Buck2 test targets can declare them as inputs.
#
# `//data/ports/analytics-api:data-analytics-api-contract` reads these files. Buck2 runs it in a
# hermetic sandbox where the checkout tree is unreachable, so without an export_file here the
# contracts simply are not present and the test cannot reach its subject.
export_file(
    name = "openapi-v1.yaml",
    visibility = ["PUBLIC"],
)

export_file(
    name = "asyncapi-v1.yaml",
    visibility = ["PUBLIC"],
)

export_file(
    name = "analytics.proto",
    visibility = ["PUBLIC"],
)

# This package owns tracked YAML (openapi-v1.yaml, asyncapi-v1.yaml), which makes it a
# YAML-owning package under the corpus-index-coverage ratchet. Declaring the extraction
# target keeps that YAML a build-graph input rather than an unindexed blind spot, and keeps
# the uncovered count at the frozen ceiling of 18 instead of pushing it to 19.
corpus_yaml_facts_shards(
    srcs = glob(["**/*.yaml", "**/*.yml"]),
    shard_size = 256,
)
