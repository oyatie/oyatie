{
  "stores": [
    {
      "name": "CAS_MAIN_STORE",
      "verify": {
        "backend": {
          "fast_slow": {
            "fast": {
              "filesystem": {
                "content_path": "/cache/cas-content",
                "temp_path": "/cache/cas-tmp",
                "eviction_policy": {
                  "max_bytes": 8000000000
                }
              }
            },
            "slow": {
              "filesystem": {
                "content_path": "/data/cas-content",
                "temp_path": "/data/cas-tmp",
                "eviction_policy": {
                  "max_bytes": 40000000000
                }
              }
            }
          }
        },
        "verify_size": true,
        "verify_hash": true
      }
    },
    {
      "name": "AC_MAIN_STORE",
      "fast_slow": {
        "fast": {
          "filesystem": {
            "content_path": "/cache/ac-content",
            "temp_path": "/cache/ac-tmp",
            "eviction_policy": {
              "max_bytes": 1000000000
            }
          }
        },
        "slow": {
          "filesystem": {
            "content_path": "/data/ac-content",
            "temp_path": "/data/ac-tmp",
            "eviction_policy": {
              "max_bytes": 5000000000
            }
          }
        }
      }
    }
  ],
  "servers": [
    {
      "name": "writer",
      "listener": {
        "http": {
          "socket_address": "0.0.0.0:50051",
          "tls": {
            "cert_file": "/tls/tls.crt",
            "key_file": "/tls/tls.key",
            "client_ca_file": "/tls/ca-writer.crt"
          }
        }
      },
      "services": {
        "cas": [
          {
            "instance_name": "main",
            "cas_store": "CAS_MAIN_STORE"
          }
        ],
        "ac": [
          {
            "instance_name": "main",
            "ac_store": "AC_MAIN_STORE",
            "read_only": false
          }
        ],
        "capabilities": [
          {
            "instance_name": "main"
          }
        ],
        "bytestream": [
          {
            "instance_name": "main",
            "cas_store": "CAS_MAIN_STORE"
          }
        ]
      }
    },
    {
      "name": "reader",
      "listener": {
        "http": {
          "socket_address": "0.0.0.0:50052",
          "tls": {
            "cert_file": "/tls/tls.crt",
            "key_file": "/tls/tls.key",
            "client_ca_file": "/tls/ca-reader.crt"
          }
        }
      },
      "services": {
        "cas": [
          {
            "instance_name": "main",
            "cas_store": "CAS_MAIN_STORE"
          }
        ],
        "ac": [
          {
            "instance_name": "main",
            "ac_store": "AC_MAIN_STORE",
            "read_only": true
          }
        ],
        "capabilities": [
          {
            "instance_name": "main"
          }
        ],
        "bytestream": [
          {
            "instance_name": "main",
            "cas_store": "CAS_MAIN_STORE"
          }
        ]
      }
    },
    {
      "name": "ops",
      "listener": {
        "http": {
          "socket_address": "0.0.0.0:50061"
        }
      },
      "services": {
        "health": {},
        "admin": {}
      }
    }
  ],
  "global": {
    "max_open_files": 24576
  }
}