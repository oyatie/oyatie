let results = parallel(jobs);

phase("Synthesize");
let synth = agent(
    "Synthesize ADR decade disposition. Worktree: " + WT + "\n"
    + "Read all docs/decisions/_disposition/band-*-receipt.json if present.\n"
    + "Produce markdown: (1) bands completed (2) total ADRs reviewed (3) files changed table ADR|before|after|reason (4) high-risk false Accepted remaining (5) process_edits.\n"
    + "Fail-closed: list bands with no receipt.\n"
    + "Panel results:\n" + json_encode(results),
    #{ label: "synth", capability_mode: "read-only", agent_type: "explore" }
);
let report = "synth failed";
if synth != () && synth.success && synth.output != () { report = synth.output; }
complete(#{ report: report, bands: 55 });
