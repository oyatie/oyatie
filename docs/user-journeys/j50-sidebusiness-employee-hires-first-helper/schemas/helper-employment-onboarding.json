{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.oyatie.com/user-journeys/j50/helper-employment-onboarding.json",
  "title": "HelperEmploymentOnboarding",
  "version": "1.0.0",
  "description": "Shared journey object for j50-sidebusiness-employee-hires-first-helper. It lets Yejin Park hire a part-time helper, provision a sub-tenant, set role-scoped access, and prepare payroll while preserving tenant scope, auditability, and cross-service status.",
  "_meta": {
    "purpose": "Bind j50-sidebusiness-employee-hires-first-helper to a machine-readable object shared by all participating microservices.",
    "status": "Proposed",
    "binding_adr": "ADR-0244",
    "related_adrs": [
      "ADR-0105",
      "ADR-0131",
      "ADR-0244",
      "ADR-0263",
      "ADR-0273",
      "ADR-0292",
      "ADR-0297",
      "ADR-0299"
    ],
    "enforcement_status": "authoring-target",
    "industry_citations": [
      "Gusto employee onboarding plus Google Workspace delegated-role pattern"
    ],
    "contract_surfaces": [
      "OpenAPI 3.2.0",
      "AsyncAPI 3.1.0",
      "proto3",
      "BNF v4.1",
      "ADR-0105 13-layer"
    ],
    "microservice_count_authority": 45,
    "marketplace_settlement_invariant": "marketplace-settles-all-tenant-deals",
    "schema_version": "v1.0.0"
  },
  "type": "object",
  "required": [
    "journey_id",
    "tenant_id",
    "persona",
    "locale",
    "status",
    "correlation_id",
    "service_states",
    "audit",
    "contracts"
  ],
  "properties": {
    "journey_id": {
      "const": "j50-sidebusiness-employee-hires-first-helper",
      "description": "Stable journey identifier and collision guard for the j36-j50 range.",
      "examples": [
        "j50-sidebusiness-employee-hires-first-helper"
      ]
    },
    "tenant_id": {
      "type": "string",
      "description": "Tenant scope required by ADR-0244; every service must persist or forward it unchanged.",
      "examples": [
        "yejin-vintage-business"
      ]
    },
    "persona": {
      "const": "Yejin Park",
      "description": "The named persona whose continuity is preserved across the journey.",
      "examples": [
        "Yejin Park"
      ]
    },
    "locale": {
      "const": "ko-KR",
      "description": "Locale used for UX, notices, and regulated language variants.",
      "examples": [
        "ko-KR"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "waiting_on_human",
        "waiting_on_provider",
        "completed",
        "compensated",
        "denied"
      ],
      "description": "Journey state machine status observed by UX and tests.",
      "examples": [
        "completed"
      ]
    },
    "correlation_id": {
      "type": "string",
      "pattern": "^journey-j[0-9]{2}-[a-z0-9-]+$",
      "description": "Idempotency and trace correlation key shared by OpenAPI, AsyncAPI, and proto3 surfaces.",
      "examples": [
        "journey-j50-sidebusiness-employee-hires-first-helper"
      ]
    },
    "service_states": {
      "type": "object",
      "description": "Per-service status map; keys match the flat microservice path names used by ADR-0131.",
      "required": [
        "identity",
        "tenancy",
        "payments",
        "workflow_engine",
        "cell"
      ],
      "properties": {
        "identity": {
          "type": "object",
          "description": "identity owns the helper-provisioning role for this journey and records the status it contributes to the shared object.",
          "required": [
            "role",
            "status",
            "audit_event_class"
          ],
          "properties": {
            "role": {
              "const": "helper-provisioning",
              "description": "The identity role in the journey handshake.",
              "examples": [
                "helper-provisioning"
              ]
            },
            "status": {
              "type": "string",
              "enum": [
                "pending",
                "permitted",
                "denied",
                "degraded",
                "completed",
                "compensated"
              ],
              "description": "Typed service status used by the integration test plan and audit envelope.",
              "examples": [
                "completed"
              ]
            },
            "audit_event_class": {
              "type": "string",
              "description": "ADR-0263 audit event class emitted by this service when the status changes.",
              "examples": [
                "Journey50IdentityHelperProvisioningCommitted"
              ]
            }
          },
          "additionalProperties": false
        },
        "tenancy": {
          "type": "object",
          "description": "tenancy owns the sub-tenant-helper-scope role for this journey and records the status it contributes to the shared object.",
          "required": [
            "role",
            "status",
            "audit_event_class"
          ],
          "properties": {
            "role": {
              "const": "sub-tenant-helper-scope",
              "description": "The tenancy role in the journey handshake.",
              "examples": [
                "sub-tenant-helper-scope"
              ]
            },
            "status": {
              "type": "string",
              "enum": [
                "pending",
                "permitted",
                "denied",
                "degraded",
                "completed",
                "compensated"
              ],
              "description": "Typed service status used by the integration test plan and audit envelope.",
              "examples": [
                "completed"
              ]
            },
            "audit_event_class": {
              "type": "string",
              "description": "ADR-0263 audit event class emitted by this service when the status changes.",
              "examples": [
                "Journey50TenancySubTenantHelperScopeCommitted"
              ]
            }
          },
          "additionalProperties": false
        },
        "payments": {
          "type": "object",
          "description": "payments owns the helper-payroll-setup role for this journey and records the status it contributes to the shared object.",
          "required": [
            "role",
            "status",
            "audit_event_class"
          ],
          "properties": {
            "role": {
              "const": "helper-payroll-setup",
              "description": "The payments role in the journey handshake.",
              "examples": [
                "helper-payroll-setup"
              ]
            },
            "status": {
              "type": "string",
              "enum": [
                "pending",
                "permitted",
                "denied",
                "degraded",
                "completed",
                "compensated"
              ],
              "description": "Typed service status used by the integration test plan and audit envelope.",
              "examples": [
                "completed"
              ]
            },
            "audit_event_class": {
              "type": "string",
              "description": "ADR-0263 audit event class emitted by this service when the status changes.",
              "examples": [
                "Journey50PaymentsHelperPayrollSetupCommitted"
              ]
            }
          },
          "additionalProperties": false
        },
        "workflow_engine": {
          "type": "object",
          "description": "workflow-engine owns the hiring-onboarding-flow role for this journey and records the status it contributes to the shared object.",
          "required": [
            "role",
            "status",
            "audit_event_class"
          ],
          "properties": {
            "role": {
              "const": "hiring-onboarding-flow",
              "description": "The workflow-engine role in the journey handshake.",
              "examples": [
                "hiring-onboarding-flow"
              ]
            },
            "status": {
              "type": "string",
              "enum": [
                "pending",
                "permitted",
                "denied",
                "degraded",
                "completed",
                "compensated"
              ],
              "description": "Typed service status used by the integration test plan and audit envelope.",
              "examples": [
                "completed"
              ]
            },
            "audit_event_class": {
              "type": "string",
              "description": "ADR-0263 audit event class emitted by this service when the status changes.",
              "examples": [
                "Journey50WorkflowEngineHiringOnboardingFlowCommitted"
              ]
            }
          },
          "additionalProperties": false
        },
        "cell": {
          "type": "object",
          "description": "cell owns the role-isolated-cell-placement role for this journey and records the status it contributes to the shared object.",
          "required": [
            "role",
            "status",
            "audit_event_class"
          ],
          "properties": {
            "role": {
              "const": "role-isolated-cell-placement",
              "description": "The cell role in the journey handshake.",
              "examples": [
                "role-isolated-cell-placement"
              ]
            },
            "status": {
              "type": "string",
              "enum": [
                "pending",
                "permitted",
                "denied",
                "degraded",
                "completed",
                "compensated"
              ],
              "description": "Typed service status used by the integration test plan and audit envelope.",
              "examples": [
                "completed"
              ]
            },
            "audit_event_class": {
              "type": "string",
              "description": "ADR-0263 audit event class emitted by this service when the status changes.",
              "examples": [
                "Journey50CellRoleIsolatedCellPlacementCommitted"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "audit": {
      "type": "object",
      "description": "ADR-0263 audit envelope shared by all service transitions.",
      "required": [
        "audit_id",
        "trace_id",
        "event_classes",
        "sealed_at"
      ],
      "properties": {
        "audit_id": {
          "type": "string",
          "description": "Audit-chain identifier.",
          "examples": [
            "aud-j50-001"
          ]
        },
        "trace_id": {
          "type": "string",
          "description": "Distributed trace id for observability.",
          "examples": [
            "trace-j50-hero"
          ]
        },
        "event_classes": {
          "type": "array",
          "description": "Audit event classes emitted during this journey.",
          "items": {
            "type": "string"
          },
          "minItems": 5,
          "examples": [
            [
              "Journey50IdentityHelperProvisioningCommitted",
              "Journey50TenancySubTenantHelperScopeCommitted",
              "Journey50PaymentsHelperPayrollSetupCommitted",
              "Journey50WorkflowEngineHiringOnboardingFlowCommitted",
              "Journey50CellRoleIsolatedCellPlacementCommitted"
            ]
          ]
        },
        "sealed_at": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when the final audit bundle was sealed.",
          "examples": [
            "2026-06-01T12:00:00Z"
          ]
        }
      },
      "additionalProperties": false
    },
    "contracts": {
      "type": "array",
      "description": "Contract surface names that must remain in sync for this journey.",
      "items": {
        "type": "string",
        "enum": [
          "OpenAPI 3.2.0",
          "AsyncAPI 3.1.0",
          "proto3",
          "BNF v4.1",
          "ADR-0105 13-layer"
        ]
      },
      "minItems": 5,
      "examples": [
        [
          "OpenAPI 3.2.0",
          "AsyncAPI 3.1.0",
          "proto3",
          "BNF v4.1",
          "ADR-0105 13-layer"
        ]
      ]
    }
  },
  "additionalProperties": false
}
