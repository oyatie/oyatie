{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oyatie.dev/schemas/user-journeys/j143/ExportAttestationReceipt.json",
  "title": "ExportAttestationReceipt",
  "type": "object",
  "_meta": {
    "doc_class": "Schema",
    "journey_id": "j143",
    "status": "draft",
    "owner": "workflow-engine",
    "consumers": ["drive", "compliance", "audit-chain", "future-employer-verifier"],
    "adr_anchors": ["ADR-0145", "ADR-0247", "ADR-0251", "ADR-0311"]
  },
  "required": [
    "receipt_id",
    "subject_principal",
    "source_tenant_id",
    "dest_tenant_id",
    "bundle_sha256",
    "file_count_by_category",
    "dlp_pack_version_hash",
    "attestor_principal",
    "attestor_signature",
    "audit_chain_seal_source",
    "audit_chain_seal_dest",
    "issued_at_hlc"
  ],
  "properties": {
    "receipt_id":           { "type": "string", "pattern": "^XR-[A-Z0-9-]+$" },
    "subject_principal":    { "type": "string", "format": "uri" },
    "source_tenant_id":     { "type": "string" },
    "dest_tenant_id":       { "type": "string" },
    "bundle_sha256":        { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "file_count_by_category": {
      "type": "object",
      "required": ["portfolio_safe", "reference_letter", "non_confidential_work_sample"],
      "properties": {
        "portfolio_safe":               { "type": "integer", "minimum": 0 },
        "reference_letter":             { "type": "integer", "minimum": 0 },
        "non_confidential_work_sample": { "type": "integer", "minimum": 0 }
      }
    },
    "dlp_pack_version_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "manual_review_count":   { "type": "integer", "minimum": 0 },
    "redactions_applied":    { "type": "integer", "minimum": 0 },
    "attestor_principal":    { "type": "string", "format": "uri" },
    "attestor_signature": {
      "type": "object",
      "required": ["algorithm", "signature", "signed_payload_hash"],
      "properties": {
        "algorithm":            { "type": "string", "enum": ["ES256", "EdDSA"] },
        "signature":            { "type": "string", "contentEncoding": "base64" },
        "signed_payload_hash":  { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "audit_chain_seal_source": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "audit_chain_seal_dest":   { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "issued_at_hlc":           { "type": "string" },
    "verification_url": {
      "type": "string",
      "format": "uri",
      "description": "Public oyatie pack-registry URL that future employer can hit to verify the DLP-pack version_hash matches the stamped hash"
    }
  }
}
