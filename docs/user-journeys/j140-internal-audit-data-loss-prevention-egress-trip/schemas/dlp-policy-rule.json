{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.oyatie.dev/user-journeys/j140/dlp-policy-rule.json",
  "title": "DLPPolicyRule",
  "description": "DLP policy rule used at egress evaluation time. Composes file classification + destination class + Cedar policy gating.",
  "_meta": {"binding_adr": "ADR-0243", "related_adrs": ["ADR-0311","ADR-0307"], "schema_version": "v1.0.0"},
  "type": "object",
  "required": ["policy_id", "version", "content_class_pattern", "destination_class_pattern", "action", "effective_from"],
  "properties": {
    "policy_id": {"type": "string"},
    "version": {"type": "string"},
    "tenant_scope": {"type": "string"},
    "content_class_pattern": {
      "type": "object",
      "properties": {
        "content_class_in": {"type": "array", "items": {"type": "string"}},
        "sensitivity_tier_min": {"type": "integer"},
        "size_bytes_min": {"type": "integer"},
        "regex": {"type": "string"}
      }
    },
    "destination_class_pattern": {
      "type": "object",
      "properties": {
        "destination_class_in": {"type": "array", "items": {"type": "string"}},
        "cross_tenant_only": {"type": "boolean"}
      }
    },
    "subject_audience_type_scope": {"type": "array", "items": {"type": "string"}},
    "action": {"enum": ["BLOCK", "QUARANTINE", "AUDIT_ONLY", "REQUIRE_APPROVAL"]},
    "cedar_policy_ref": {"type": "string"},
    "user_visible_message": {"type": "string"},
    "appeal_url": {"type": "string"},
    "effective_from": {"type": "string", "format": "date-time"},
    "effective_to": {"type": "string", "format": "date-time"},
    "approved_by_principals": {"type": "array", "items": {"type": "string"}},
    "audit_seal_id": {"type": "string"}
  },
  "additionalProperties": false
}
