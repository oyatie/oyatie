{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.oyatie.dev/user-journeys/j140/dlp-egress-event.json",
  "title": "DLPEgressEvent",
  "description": "Envelope for a DLP egress evaluation event. Captured at the drive egress boundary; sealed regardless of outcome.",
  "_meta": {"binding_adr": "ADR-0307", "related_adrs": ["ADR-0311","ADR-0243","ADR-0028"], "schema_version": "v1.0.0"},
  "type": "object",
  "required": ["egress_event_id", "captured_at", "policy_id", "source_file", "attempt", "outcome"],
  "properties": {
    "egress_event_id": {"type": "string", "pattern": "^dlp-trip-[a-z0-9-]+$"},
    "captured_at": {"type": "string", "format": "date-time"},
    "policy_id": {"type": "string"},
    "source_file": {
      "type": "object",
      "required": ["uri", "size", "content_class", "sensitivity_tier"],
      "properties": {
        "uri": {"type": "string"},
        "size": {"type": "integer"},
        "content_class": {"type": "string"},
        "sensitivity_tier": {"type": "integer", "minimum": 1, "maximum": 5},
        "last_modified": {"type": "string", "format": "date-time"},
        "last_modifier_principal": {"type": "string"},
        "repo": {"type": "string"}
      }
    },
    "attempt": {
      "type": "object",
      "required": ["subject_principal", "source_tenant", "dest_tenant", "attempt_method"],
      "properties": {
        "subject_principal": {"type": "string", "format": "email"},
        "subject_audience_type": {"type": "string"},
        "source_tenant": {"type": "string"},
        "dest_tenant": {"type": "string"},
        "dest_principal_class": {"enum": ["work_tenant_owned", "personal_tenant_owned", "conglomerate_sibling_owned", "external_counterparty"]},
        "destination_uri": {"type": ["string", "null"], "description": "REDACTED when destination is personal_tenant_owned per ADR-0311"},
        "attempt_method": {"type": "string"},
        "user_agent": {"type": "string"},
        "source_ip": {"type": "string"}
      }
    },
    "outcome": {
      "type": "object",
      "required": ["decision", "audit_seal"],
      "properties": {
        "decision": {"enum": ["BLOCKED", "PERMITTED", "QUARANTINED"]},
        "block_reason": {"type": "string"},
        "cedar_policy": {"type": "string"},
        "user_visible_error": {"type": "string"},
        "audit_seal": {"type": "string"}
      }
    },
    "trace_id": {"type": "string"},
    "tenant_id": {"type": "string"}
  },
  "additionalProperties": false
}
