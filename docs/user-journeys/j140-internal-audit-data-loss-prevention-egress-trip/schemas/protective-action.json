{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.oyatie.com/user-journeys/j140/protective-action.json",
  "title": "ProtectiveAction",
  "description": "Envelope for protective actions taken in response to DLP / detection signals; supports light-touch + heavy-touch remediation classes.",
  "_meta": {"binding_adr": "ADR-0310", "related_adrs": ["ADR-0311","ADR-0307"], "schema_version": "v1.0.0"},
  "type": "object",
  "required": ["action_id", "action_class", "action_type", "target", "requestor_principal", "executed_at", "audit_seal_id"],
  "properties": {
    "action_id": {"type": "string"},
    "action_class": {"enum": ["LIGHT_TOUCH", "HEAVY_TOUCH"]},
    "action_type": {"enum": ["refresh_training", "update_ui", "create_preapproved_folder", "broadcast_team_channel", "revoke_permit", "suspend_role", "freeze_repo", "request_subpoena_preparation", "lock_repo"]},
    "target": {"type": "string"},
    "investigation_case_ref": {"type": "string"},
    "requestor_principal": {"type": "string", "format": "email"},
    "dual_control_signer": {"type": "string", "format": "email"},
    "executed_at": {"type": "string", "format": "date-time"},
    "audit_seal_id": {"type": "string"},
    "reversible": {"type": "boolean", "default": true},
    "reverted_at": {"type": "string", "format": "date-time"},
    "counsel_attestation": {"type": "boolean", "default": false}
  },
  "additionalProperties": false
}
