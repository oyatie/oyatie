{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.oyatie.com/user-journeys/j03/crisis-chat-entry.json",
  "title": "CrisisChatEntry",
  "_meta": {
    "binding_adr": "ADR-0292",
    "related_adrs": ["ADR-0298","ADR-0263","ADR-0297"],
    "schema_version": "v1.0.0",
    "audit_event_class": "CrisisChatSurfaceOpened",
    "cedar_fragment": "crisis-chat-bypass-parental.cedar"
  },
  "type": "object",
  "required": ["subject_pseudonym","crisis_line_code","entry_method","tenant_pack_set","timestamp"],
  "properties": {
    "subject_pseudonym": {"type": "string","pattern": "^pseudo-[A-Z0-9]+$"},
    "crisis_line_code": {"enum": ["kr-1393","us-988","crisis-text-line","eu-116123","jp-3-anjin"]},
    "entry_method": {"enum": ["lock-screen-button","app-banner","sms-shortcode","voice-call"]},
    "tenant_pack_set": {"type": "array","items": {"type": "string"}},
    "principal_class": {"enum": ["MINOR_WITH_SAFETY_VOICE","ADULT","HIGH_RISK_USER"]},
    "timestamp": {"type": "string","format": "date-time"},
    "device_attestation": {"type": "string"}
  },
  "additionalProperties": false
}
