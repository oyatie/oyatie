{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.oyatie.dev/user-journeys/j03/crisis-message.json",
  "title": "CrisisMessage",
  "_meta": {
    "binding_adr": "ADR-0292",
    "schema_version": "v1.0.0",
    "audit_event_class": "CrisisMessageSent",
    "cedar_fragment": "crisis-message-send.cedar"
  },
  "type": "object",
  "required": ["session_id","sender_pseudonym","body","sent_at"],
  "properties": {
    "session_id": {"type": "string","format": "uuid"},
    "sender_pseudonym": {"type": "string"},
    "body": {"type": "string","maxLength": 5000},
    "sent_at": {"type": "string","format": "date-time"},
    "acute_risk_score_at_send": {"type": "number","minimum": 0,"maximum": 1},
    "language": {"type": "string"}
  },
  "additionalProperties": false
}
