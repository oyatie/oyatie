{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.oyatie.dev/user-journeys/j177-migration-from-salesforce-sales-cloud-to-oyatie-crm/vendor-extract-schema.json",
  "title": "Salesforce Sales Cloud to Oyatie CRM pipeline migration vendor extract schema",
  "type": "object",
  "required": [
    "journey_id",
    "tenant_id",
    "source_system",
    "batch_id",
    "objects",
    "row_count_manifest",
    "source_hash_manifest"
  ],
  "properties": {
    "journey_id": {
      "const": "j177-migration-from-salesforce-sales-cloud-to-oyatie-crm"
    },
    "tenant_id": {
      "const": "cloudledger-saas"
    },
    "source_system": {
      "const": "salesforce-prod-na87"
    },
    "incumbent_system": {
      "const": "Salesforce Sales Cloud"
    },
    "target_system": {
      "const": "Oyatie CRM"
    },
    "extraction_mechanism": {
      "const": "Salesforce Bulk API 2.0 query jobs with signed CSV payloads"
    },
    "projection": {
      "const": "oyatie.crm.pipeline_projection_v1"
    },
    "batch_id": {
      "type": "string",
      "pattern": "^batch-J[0-9]{3}-[0-9]{2}$"
    },
    "extracted_at": {
      "type": "string",
      "format": "date-time"
    },
    "objects": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Account": {
          "type": "object",
          "description": "Customer and prospect account",
          "required": [
            "Id",
            "Name",
            "ParentId",
            "OwnerId"
          ],
          "properties": {
            "Id": {
              "type": "string"
            },
            "Name": {
              "type": "string"
            },
            "ParentId": {
              "type": "string"
            },
            "OwnerId": {
              "type": "string"
            },
            "Industry": {
              "type": "string"
            },
            "BillingCountry": {
              "type": "string"
            },
            "AnnualRevenue": {
              "type": "string"
            },
            "Type": {
              "type": "string"
            }
          }
        },
        "Contact": {
          "type": "object",
          "description": "Person at an account",
          "required": [
            "Id",
            "AccountId",
            "FirstName",
            "LastName"
          ],
          "properties": {
            "Id": {
              "type": "string"
            },
            "AccountId": {
              "type": "string"
            },
            "FirstName": {
              "type": "string"
            },
            "LastName": {
              "type": "string"
            },
            "Email": {
              "type": "string"
            },
            "Title": {
              "type": "string"
            },
            "HasOptedOutOfEmail": {
              "type": "string"
            }
          }
        },
        "Lead": {
          "type": "object",
          "description": "Unconverted demand record",
          "required": [
            "Id",
            "Company",
            "Email",
            "Status"
          ],
          "properties": {
            "Id": {
              "type": "string"
            },
            "Company": {
              "type": "string"
            },
            "Email": {
              "type": "string"
            },
            "Status": {
              "type": "string"
            },
            "LeadSource": {
              "type": "string"
            },
            "ConvertedAccountId": {
              "type": "string"
            },
            "ConvertedContactId": {
              "type": "string"
            }
          }
        },
        "Opportunity": {
          "type": "object",
          "description": "Pipeline object",
          "required": [
            "Id",
            "AccountId",
            "OwnerId",
            "StageName"
          ],
          "properties": {
            "Id": {
              "type": "string"
            },
            "AccountId": {
              "type": "string"
            },
            "OwnerId": {
              "type": "string"
            },
            "StageName": {
              "type": "string"
            },
            "Amount": {
              "type": "string"
            },
            "CloseDate": {
              "type": "string"
            },
            "ForecastCategoryName": {
              "type": "string"
            },
            "IsClosed": {
              "type": "string"
            }
          }
        },
        "Quote": {
          "type": "object",
          "description": "Commercial quote",
          "required": [
            "Id",
            "OpportunityId",
            "QuoteNumber",
            "Status"
          ],
          "properties": {
            "Id": {
              "type": "string"
            },
            "OpportunityId": {
              "type": "string"
            },
            "QuoteNumber": {
              "type": "string"
            },
            "Status": {
              "type": "string"
            },
            "GrandTotal": {
              "type": "string"
            },
            "ExpirationDate": {
              "type": "string"
            }
          }
        }
      }
    },
    "row_count_manifest": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "object_name",
          "source_count",
          "target_count",
          "delta_count"
        ],
        "properties": {
          "object_name": {
            "enum": [
              "Account",
              "Contact",
              "Lead",
              "Opportunity",
              "Quote"
            ]
          },
          "source_count": {
            "type": "integer",
            "minimum": 0
          },
          "target_count": {
            "type": "integer",
            "minimum": 0
          },
          "delta_count": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "source_hash_manifest": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "object_name",
          "hash_algorithm",
          "hash_value"
        ],
        "properties": {
          "object_name": {
            "enum": [
              "Account",
              "Contact",
              "Lead",
              "Opportunity",
              "Quote"
            ]
          },
          "hash_algorithm": {
            "const": "sha256"
          },
          "hash_value": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64
          }
        }
      }
    }
  },
  "additionalProperties": false
}
