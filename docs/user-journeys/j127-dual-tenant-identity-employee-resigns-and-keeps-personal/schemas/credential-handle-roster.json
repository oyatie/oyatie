{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oyatie.dev/specs/journey/j127/credential-handle-roster.json",
  "title": "CredentialHandleRoster",
  "version": "1.0.0",
  "_meta": {
    "purpose": "Per-credential-handle roster for a hardware-key. Each handle binds to a single tenant; revoking one handle does NOT affect the others.",
    "binding_adr": "ADR-0188-passkey-webauthn-as-canonical-auth",
    "related_adrs": ["ADR-0311", "ADR-0244"],
    "status": "Proposed",
    "enforcement_status": "advisory-until-2026-07-15"
  },
  "type": "object",
  "required": ["hardware_key_aaguid", "handles"],
  "properties": {
    "hardware_key_aaguid": {"type": "string", "description": "AAGUID per FIDO2 spec; identifies the make/model of the key but not the individual key."},
    "handles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["credential_handle_id", "tenant_id", "principal_id", "active", "enrolled_at"],
        "properties": {
          "credential_handle_id": {"type": "string", "description": "Unique opaque handle per credential."},
          "tenant_id": {"type": "string"},
          "principal_id": {"type": "string"},
          "active": {"type": "boolean"},
          "enrolled_at": {"type": "string", "format": "date-time"},
          "revoked_at": {"type": ["string", "null"], "format": "date-time"},
          "revocation_reason": {"type": ["string", "null"]}
        }
      }
    }
  }
}
