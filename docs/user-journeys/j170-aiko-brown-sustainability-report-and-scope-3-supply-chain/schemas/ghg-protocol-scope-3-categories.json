{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oyatie.cloud/schemas/j170/ghg-protocol-scope-3-categories.json",
  "title": "j170 GHG Protocol Scope 3 Categories",
  "description": "GHG Protocol Corporate Value Chain (Scope 3) Standard — 15 categories with MFI-specific calculation methodology + emission-factor sources.",
  "type": "object",
  "required": ["standard_version", "categories"],
  "properties": {
    "standard_version": {"type": "string", "const": "GHG-Protocol-Corporate-Value-Chain-2024-revision"},
    "categories": {
      "type": "array",
      "items": {"$ref": "#/$defs/Scope3Category"},
      "minItems": 15,
      "maxItems": 15
    }
  },
  "$defs": {
    "Scope3Category": {
      "type": "object",
      "required": ["category_number", "category_name", "boundary_methodology", "calculation_method"],
      "properties": {
        "category_number": {"type": "integer", "minimum": 1, "maximum": 15},
        "category_name": {"type": "string"},
        "category_short_code": {"type": "string"},
        "boundary_methodology": {"type": "string"},
        "calculation_method": {"type": "string", "enum": ["activity-data-based", "spend-based", "hybrid", "supplier-specific", "industry-average", "use-of-sold-products-direct"]},
        "primary_emission_factor_source": {"type": "string"},
        "alt_emission_factor_source": {"type": "string"},
        "data_quality_tier_assigned": {"type": "string"},
        "mfi_material": {"type": "boolean"},
        "mfi_pct_of_scope_3": {"type": "number"},
        "mfi_calculation_notes": {"type": "string"}
      }
    }
  },
  "examples": [
    {
      "standard_version": "GHG-Protocol-Corporate-Value-Chain-2024-revision",
      "categories": [
        {
          "category_number": 1,
          "category_name": "Purchased goods and services",
          "category_short_code": "PGS",
          "boundary_methodology": "cradle-to-gate-of-purchased-goods",
          "calculation_method": "hybrid",
          "primary_emission_factor_source": "supplier-activity-data-band-A",
          "alt_emission_factor_source": "EPA-Supply-Chain-GHG-Emission-Factors-v1.3-for-band-C",
          "data_quality_tier_assigned": "tier-1-measured-for-band-A; tier-4-spend-based-for-band-C",
          "mfi_material": true,
          "mfi_pct_of_scope_3": 68.0,
          "mfi_calculation_notes": "Largest category by far. Band A activity-data covers 50 of 412 suppliers but ~81% of category emissions. Band B partial activity-data covers ~12%. Band C spend-based uses EPA v1.3 mapped via NAICS code."
        },
        {
          "category_number": 2,
          "category_name": "Capital goods",
          "category_short_code": "CG",
          "boundary_methodology": "cradle-to-gate-of-capital-asset",
          "calculation_method": "spend-based",
          "primary_emission_factor_source": "EPA-Supply-Chain-GHG-Emission-Factors-v1.3",
          "data_quality_tier_assigned": "tier-4-spend-based",
          "mfi_material": false,
          "mfi_pct_of_scope_3": 0.4,
          "mfi_calculation_notes": "MFI's capital expenditure is modest relative to operating spend; not material."
        },
        {
          "category_number": 3,
          "category_name": "Fuel and energy related activities (not in Scope 1 or 2)",
          "category_short_code": "FERA",
          "boundary_methodology": "well-to-tank-and-T&D-losses",
          "calculation_method": "activity-data-based",
          "primary_emission_factor_source": "EPA-eGRID-2024-T&D-losses + DEFRA-2025-well-to-tank",
          "data_quality_tier_assigned": "tier-2-primary-estimated",
          "mfi_material": false,
          "mfi_pct_of_scope_3": 0.6,
          "mfi_calculation_notes": "Upstream fuel + T&D losses; modest."
        },
        {
          "category_number": 4,
          "category_name": "Upstream transportation and distribution",
          "category_short_code": "UTD",
          "boundary_methodology": "cradle-to-gate-transport-on-inbound",
          "calculation_method": "activity-data-based",
          "primary_emission_factor_source": "carrier-specific-from-BNSF-Norfolk-Southern-UnionPacific",
          "alt_emission_factor_source": "EPA-SmartWay-2024-truck-emission-factors",
          "data_quality_tier_assigned": "tier-1-measured-for-rail; tier-2-primary-for-truck",
          "mfi_material": true,
          "mfi_pct_of_scope_3": 14.0,
          "mfi_calculation_notes": "Heavy rail dominates inbound to MFI's Midwest plants. Truck dominates Mexico-bound and final-mile."
        },
        {
          "category_number": 5,
          "category_name": "Waste generated in operations",
          "category_short_code": "WGO",
          "boundary_methodology": "waste-treatment-or-disposal-cradle",
          "calculation_method": "activity-data-based",
          "primary_emission_factor_source": "EPA-WARM-v15-2024",
          "data_quality_tier_assigned": "tier-2-primary-estimated",
          "mfi_material": false,
          "mfi_pct_of_scope_3": 3.0,
          "mfi_calculation_notes": "Steel + aluminum mill scale + waste; mostly recycled; modest emissions."
        },
        {
          "category_number": 6,
          "category_name": "Business travel",
          "category_short_code": "BT",
          "boundary_methodology": "well-to-wheel-flight-or-hotel-stay",
          "calculation_method": "activity-data-based",
          "primary_emission_factor_source": "Amex-Concur-integration-DEFRA-2025",
          "data_quality_tier_assigned": "tier-1-measured",
          "mfi_material": false,
          "mfi_pct_of_scope_3": 1.0,
          "mfi_calculation_notes": "Modest after 2020 hybrid-work era."
        },
        {
          "category_number": 7,
          "category_name": "Employee commuting",
          "category_short_code": "EC",
          "boundary_methodology": "well-to-wheel-employee-commute",
          "calculation_method": "activity-data-based",
          "primary_emission_factor_source": "Annual-employee-commute-survey + EPA-eGRID + DEFRA",
          "data_quality_tier_assigned": "tier-2-primary-estimated",
          "mfi_material": false,
          "mfi_pct_of_scope_3": 2.0,
          "mfi_calculation_notes": "Plant workers commute; mostly Midwest with limited public transit."
        },
        {
          "category_number": 8,
          "category_name": "Upstream leased assets",
          "category_short_code": "ULA",
          "boundary_methodology": "lease-attribution-emissions",
          "calculation_method": "activity-data-based",
          "primary_emission_factor_source": "lessor-disclosure-when-available",
          "data_quality_tier_assigned": "tier-3-secondary",
          "mfi_material": false,
          "mfi_pct_of_scope_3": 0.5,
          "mfi_calculation_notes": "Small. Mostly office leases."
        },
        {
          "category_number": 9,
          "category_name": "Downstream transportation and distribution",
          "category_short_code": "DTD",
          "boundary_methodology": "outbound-transport-customer-bound",
          "calculation_method": "activity-data-based",
          "primary_emission_factor_source": "MFI-outbound-shipping-records + EPA-SmartWay",
          "data_quality_tier_assigned": "tier-1-measured",
          "mfi_material": false,
          "mfi_pct_of_scope_3": 2.0,
          "mfi_calculation_notes": "MFI sells FOB-shipping-point so downstream transport is reportable; modest in scope."
        },
        {
          "category_number": 10,
          "category_name": "Processing of sold products",
          "category_short_code": "PSP",
          "boundary_methodology": "processing-emissions-at-customer",
          "calculation_method": "activity-data-based",
          "primary_emission_factor_source": "OEM-disclosure-when-available + industry-avg-when-not",
          "data_quality_tier_assigned": "tier-3-secondary",
          "mfi_material": false,
          "mfi_pct_of_scope_3": 0.5,
          "mfi_calculation_notes": "Some processing happens at OEMs but MFI's products are already substantially finished."
        },
        {
          "category_number": 11,
          "category_name": "Use of sold products",
          "category_short_code": "USP",
          "boundary_methodology": "use-phase-emissions-of-products-incorporated-into-final-goods",
          "calculation_method": "use-of-sold-products-direct",
          "primary_emission_factor_source": "OEM-vehicle-fuel-economy-data + appliance-energy-use-data",
          "data_quality_tier_assigned": "tier-3-secondary-industry-avg",
          "mfi_material": true,
          "mfi_pct_of_scope_3": 8.0,
          "mfi_calculation_notes": "Allocated by MFI-content-weight to OEM final products; uses 10-year average vehicle lifetime; carry-forward to refine with OEM-specific lifetime data."
        },
        {
          "category_number": 12,
          "category_name": "End-of-life treatment of sold products",
          "category_short_code": "EOL",
          "boundary_methodology": "end-of-life-disposal-or-recycling",
          "calculation_method": "industry-average",
          "primary_emission_factor_source": "EPA-WARM-v15-2024 + industry-recycling-rates",
          "data_quality_tier_assigned": "tier-3-secondary",
          "mfi_material": false,
          "mfi_pct_of_scope_3": 4.0,
          "mfi_calculation_notes": "Steel + aluminum recycle rates are high (~88% scrap reuse in NA); end-of-life emissions modest."
        },
        {
          "category_number": 13,
          "category_name": "Downstream leased assets",
          "category_short_code": "DLA",
          "boundary_methodology": "lease-attribution-emissions",
          "calculation_method": "spend-based",
          "primary_emission_factor_source": "EPA-Supply-Chain-GHG-Emission-Factors-v1.3",
          "data_quality_tier_assigned": "tier-4-spend-based",
          "mfi_material": false,
          "mfi_pct_of_scope_3": 0.1,
          "mfi_calculation_notes": "Negligible."
        },
        {
          "category_number": 14,
          "category_name": "Franchises",
          "category_short_code": "F",
          "boundary_methodology": "franchise-emissions",
          "calculation_method": "n/a",
          "primary_emission_factor_source": "n/a",
          "data_quality_tier_assigned": "n/a",
          "mfi_material": false,
          "mfi_pct_of_scope_3": 0.0,
          "mfi_calculation_notes": "MFI has no franchise operations."
        },
        {
          "category_number": 15,
          "category_name": "Investments",
          "category_short_code": "I",
          "boundary_methodology": "financed-emissions-PCAF-aligned",
          "calculation_method": "industry-average",
          "primary_emission_factor_source": "PCAF-Global-GHG-Accounting-Standard",
          "data_quality_tier_assigned": "tier-3-secondary",
          "mfi_material": false,
          "mfi_pct_of_scope_3": 0.0,
          "mfi_calculation_notes": "MFI pension portfolio carry-forward for FY2027 ESRS-E1 E1-6.71 scope clarification."
        }
      ]
    }
  ]
}
