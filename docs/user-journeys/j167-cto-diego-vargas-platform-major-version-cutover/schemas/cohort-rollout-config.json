{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oyatie.cloud/schemas/j167/cohort-rollout-config.json",
  "title": "j167 Cohort Rollout Config",
  "description": "Per-cohort configuration for Aurelia Platform v3.x → v4.0 cutover. Defines traffic percentage, cell scope, SLO thresholds, alert routing, and stability window per cohort.",
  "type": "object",
  "required": ["change_record_id", "cohorts", "global_slo_thresholds", "quorum_members"],
  "properties": {
    "change_record_id": {"type": "string", "const": "CHG-V4-CUTOVER-2026-10-20"},
    "cohorts": {
      "type": "array",
      "items": {"$ref": "#/$defs/CohortConfig"},
      "minItems": 4,
      "maxItems": 4
    },
    "global_slo_thresholds": {"$ref": "#/$defs/GlobalSLOThresholds"},
    "quorum_members": {
      "type": "array",
      "items": {"$ref": "#/$defs/QuorumMember"},
      "minItems": 4
    },
    "default_truetime_uncertainty_max_ms": {"type": "number", "const": 10},
    "service_credit_target_mxn": {"type": "number", "const": 200000},
    "service_credit_actual_mxn": {"type": "number", "default": 0}
  },
  "$defs": {
    "CohortConfig": {
      "type": "object",
      "required": ["cohort_label", "percentage", "cell_scope", "slo_thresholds", "stability_window_hours", "alert_routing"],
      "properties": {
        "cohort_label": {"type": "string", "enum": ["cohort_a", "cohort_b", "cohort_c", "cohort_d"]},
        "percentage": {"type": "number", "minimum": 0, "maximum": 100},
        "cell_scope": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "slo_thresholds": {"$ref": "#/$defs/SLOThresholds"},
        "stability_window_hours": {"type": "integer", "minimum": 1},
        "alert_routing": {"$ref": "#/$defs/AlertRouting"},
        "scheduled_vote_at_utc": {"type": "string", "format": "date-time"},
        "scheduled_live_at_utc": {"type": "string", "format": "date-time"}
      }
    },
    "SLOThresholds": {
      "type": "object",
      "required": ["p99_latency_ms_max", "error_rate_max_pct", "error_budget_burn_rate_max"],
      "properties": {
        "p99_latency_ms_max": {"type": "number"},
        "error_rate_max_pct": {"type": "number"},
        "error_budget_burn_rate_max": {"type": "number"},
        "cedar_decision_latency_ms_max": {"type": "number", "default": 5},
        "audit_seal_latency_ms_max": {"type": "number", "default": 10}
      }
    },
    "AlertRouting": {
      "type": "object",
      "properties": {
        "primary_pagees": {"type": "array", "items": {"type": "string"}},
        "escalation_1_pagees": {"type": "array", "items": {"type": "string"}},
        "war_room_channel": {"type": "string"}
      }
    },
    "QuorumMember": {
      "type": "object",
      "required": ["principal", "role", "in_group"],
      "properties": {
        "principal": {"type": "string"},
        "role": {"type": "string", "enum": ["cto", "vp_eng", "coo", "svp_cs"]},
        "in_group": {"type": "string", "const": "aurelia-cutover-quorum-members"},
        "preferred_locale": {"type": "string", "enum": ["es-MX", "en-US"]},
        "passkey_required": {"type": "boolean", "const": true}
      }
    },
    "GlobalSLOThresholds": {
      "type": "object",
      "properties": {
        "cohort_a_slo_green_required_hours": {"type": "integer", "const": 24},
        "cohort_b_slo_green_required_hours": {"type": "integer", "const": 48},
        "cohort_c_slo_green_required_hours": {"type": "integer", "const": 96},
        "cohort_d_slo_green_required_hours": {"type": "integer", "const": 72},
        "rollback_window_minutes": {"type": "integer", "const": 240},
        "rollback_quorum_required": {"type": "integer", "const": 3},
        "forward_transition_quorum_required": {"type": "integer", "const": 4}
      }
    }
  },
  "examples": [
    {
      "change_record_id": "CHG-V4-CUTOVER-2026-10-20",
      "cohorts": [
        {
          "cohort_label": "cohort_a",
          "percentage": 1.0,
          "cell_scope": [
            "aws-cdmx-cell-tier-1-primary",
            "aws-aus-tx-cell-tier-1-secondary",
            "aws-qro-cell-tier-1-tertiary",
            "aws-gdl-cell-tier-1-quaternary"
          ],
          "slo_thresholds": {
            "p99_latency_ms_max": 200,
            "error_rate_max_pct": 0.05,
            "error_budget_burn_rate_max": 1.0,
            "cedar_decision_latency_ms_max": 5,
            "audit_seal_latency_ms_max": 10
          },
          "stability_window_hours": 24,
          "alert_routing": {
            "primary_pagees": ["sofia.ramirez@aurelia-robotics-internacional-sa-de-cv-mx"],
            "escalation_1_pagees": [
              "yamilet.solis@aurelia-robotics-internacional-sa-de-cv-mx",
              "diego.vargas@aurelia-robotics-internacional-sa-de-cv-mx"
            ],
            "war_room_channel": "#cutover-v4-warroom"
          },
          "scheduled_vote_at_utc": "2026-10-20T12:58:00Z",
          "scheduled_live_at_utc": "2026-10-20T13:00:00Z"
        },
        {
          "cohort_label": "cohort_b",
          "percentage": 10.0,
          "cell_scope": ["...12 cells..."],
          "slo_thresholds": {
            "p99_latency_ms_max": 180,
            "error_rate_max_pct": 0.04,
            "error_budget_burn_rate_max": 1.0,
            "cedar_decision_latency_ms_max": 5,
            "audit_seal_latency_ms_max": 10
          },
          "stability_window_hours": 48,
          "alert_routing": {
            "primary_pagees": ["sofia.ramirez@..."],
            "escalation_1_pagees": ["yamilet.solis@...", "diego.vargas@..."],
            "war_room_channel": "#cutover-v4-warroom"
          },
          "scheduled_vote_at_utc": "2026-10-21T12:58:00Z",
          "scheduled_live_at_utc": "2026-10-21T13:00:00Z"
        },
        {
          "cohort_label": "cohort_c",
          "percentage": 50.0,
          "cell_scope": ["...24 cells..."],
          "slo_thresholds": {
            "p99_latency_ms_max": 160,
            "error_rate_max_pct": 0.03,
            "error_budget_burn_rate_max": 1.0,
            "cedar_decision_latency_ms_max": 5,
            "audit_seal_latency_ms_max": 10
          },
          "stability_window_hours": 96,
          "alert_routing": {
            "primary_pagees": ["sofia.ramirez@..."],
            "escalation_1_pagees": ["yamilet.solis@...", "diego.vargas@..."],
            "war_room_channel": "#cutover-v4-warroom"
          },
          "scheduled_vote_at_utc": "2026-10-23T13:00:00Z",
          "scheduled_live_at_utc": "2026-10-23T13:00:00Z"
        },
        {
          "cohort_label": "cohort_d",
          "percentage": 100.0,
          "cell_scope": ["...47 cells..."],
          "slo_thresholds": {
            "p99_latency_ms_max": 150,
            "error_rate_max_pct": 0.025,
            "error_budget_burn_rate_max": 1.0,
            "cedar_decision_latency_ms_max": 5,
            "audit_seal_latency_ms_max": 10
          },
          "stability_window_hours": 72,
          "alert_routing": {
            "primary_pagees": ["sofia.ramirez@..."],
            "escalation_1_pagees": ["yamilet.solis@...", "diego.vargas@...", "brian.tate@..."],
            "war_room_channel": "#cutover-v4-warroom"
          },
          "scheduled_vote_at_utc": "2026-10-27T13:00:00Z",
          "scheduled_live_at_utc": "2026-10-27T13:00:00Z"
        }
      ],
      "global_slo_thresholds": {
        "cohort_a_slo_green_required_hours": 24,
        "cohort_b_slo_green_required_hours": 48,
        "cohort_c_slo_green_required_hours": 96,
        "cohort_d_slo_green_required_hours": 72,
        "rollback_window_minutes": 240,
        "rollback_quorum_required": 3,
        "forward_transition_quorum_required": 4
      },
      "quorum_members": [
        {"principal": "diego.vargas@aurelia-robotics-internacional-sa-de-cv-mx", "role": "cto", "in_group": "aurelia-cutover-quorum-members", "preferred_locale": "es-MX", "passkey_required": true},
        {"principal": "yamilet.solis@aurelia-robotics-internacional-sa-de-cv-mx", "role": "vp_eng", "in_group": "aurelia-cutover-quorum-members", "preferred_locale": "es-MX", "passkey_required": true},
        {"principal": "akira.watanabe@aurelia-robotics-internacional-sa-de-cv-mx", "role": "coo", "in_group": "aurelia-cutover-quorum-members", "preferred_locale": "en-US", "passkey_required": true},
        {"principal": "brian.tate@aurelia-robotics-internacional-sa-de-cv-mx", "role": "svp_cs", "in_group": "aurelia-cutover-quorum-members", "preferred_locale": "en-US", "passkey_required": true}
      ],
      "default_truetime_uncertainty_max_ms": 10,
      "service_credit_target_mxn": 200000,
      "service_credit_actual_mxn": 142000
    }
  ]
}
