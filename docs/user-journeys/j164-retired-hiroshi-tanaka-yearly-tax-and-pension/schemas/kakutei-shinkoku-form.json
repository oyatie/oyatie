          "bank_interest_jpy": 3200,
          "source_bank_name_utf8_nfc": "中国銀行"
        },
        "total_jpy": 2207200
      },
      "deductions": {
        "social_insurance_premium": {
          "national_health_insurance_jpy": 84000,
          "long_term_care_insurance_jpy": 48000,
          "subtotal_jpy": 132000
        },
        "medical_expense": {
          "total_medical_expense_jpy": 126400,
          "threshold_jpy": 100000,
          "eligible_deduction_jpy": 26400,
          "receipt_count": 12
        },
        "basic_deduction": {"amount_jpy": 480000},
        "spouse_deduction": {"amount_jpy": 0, "applicable": false, "reason": "死別 (bereavement)"},
