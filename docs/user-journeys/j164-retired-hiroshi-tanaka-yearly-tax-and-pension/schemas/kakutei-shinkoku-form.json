{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oyatie.dev/schemas/j164/kakutei-shinkoku-form.json",
  "title": "Japan 確定申告書B (Kakutei-Shinkoku Form B) — Individual Pensioner Subset",
  "description": "JSON schema for Japan's annual individual income tax filing form (Form B), scoped to the subset of fields applicable to a retired individual (pensioner) profile such as Hiroshi Tanaka. Schema covers income, deductions, withholding, computed tax, refund. Full form has more sections; this subset is the operational projection for j164.",
  "type": "object",
  "x-journey-id": "j164-retired-hiroshi-tanaka-yearly-tax-and-pension",
  "x-form-class": "kakutei_shinkoku_b",
  "x-form-class-japanese": "確定申告書B",
  "x-form-issuing-authority": "国税庁 (National Tax Agency)",
  "x-statute-references": [
    "所得税法 (Income Tax Act)",
    "国民年金法 (National Pension Act)",
    "厚生年金保険法 (Employees' Pension Insurance Act)",
    "復興特別所得税に関する法律 (Special Reconstruction Income Tax Act)",
    "マイナンバー法 (My-Number Act)"
  ],
  "required": [
    "form_metadata",
    "filer",
    "fiscal_year",
    "income",
    "deductions",
    "tax_calculation",
    "withholding",
    "refund_or_balance",
    "submission_metadata"
  ],
  "properties": {
    "form_metadata": {
      "type": "object",
      "required": ["form_class", "fiscal_year", "japanese_era", "form_version"],
      "properties": {
        "form_class": {"type": "string", "const": "kakutei_shinkoku_b"},
        "fiscal_year": {"type": "string", "example": "fy2026"},
        "japanese_era": {"type": "string", "example": "reiwa-8"},
        "form_version": {"type": "string", "example": "2027.1"},
        "tenant_id": {"type": "string", "const": "personal-hiroshi-tanaka-jp"},
        "draft_id": {"type": "string"},
        "draft_at": {"type": "string", "format": "date-time"}
      }
    },
    "filer": {
      "type": "object",
      "required": ["name_utf8_nfc", "address_utf8_nfc", "date_of_birth", "my_number_short"],
      "properties": {
        "name_utf8_nfc": {"type": "string", "example": "田中 浩"},
        "name_furigana": {"type": "string", "example": "たなか ひろし"},
        "name_romanized": {"type": "string", "example": "Tanaka Hiroshi"},
        "address_utf8_nfc": {"type": "string", "example": "岡山県倉敷市美和2丁目14-7"},
        "address_postal_code": {"type": "string", "pattern": "^[0-9]{3}-[0-9]{4}$", "example": "710-0801"},
        "date_of_birth": {"type": "string", "format": "date", "example": "1954-11-08"},
        "date_of_birth_japanese_era": {"type": "string", "example": "showa-29-11-08"},
        "my_number_short": {"type": "string", "pattern": "^\\*{4}-\\*{4}-[0-9]{4}$", "example": "****-****-1234", "description": "Last 4 digits only; full My-Number never serialized to the form artifact under PIPA + My-Number Act"},
        "phone": {"type": "string"},
        "marital_status_at_year_end": {"type": "string", "enum": ["未婚", "既婚", "死別", "離別"]},
        "occupation_at_year_end": {"type": "string", "example": "無職 (退職者)"}
      }
    },
    "fiscal_year": {
      "type": "object",
      "properties": {
        "start_date": {"type": "string", "const": "2026-01-01"},
        "end_date": {"type": "string", "const": "2026-12-31"},
        "japanese_era_label": {"type": "string", "const": "令和8年度"}
      }
    },
    "income": {
      "type": "object",
      "description": "Income section: public pension (公的年金), miscellaneous (雑所得), interest (利子所得)",
      "properties": {
        "public_pension": {
          "type": "object",
          "properties": {
            "national_pension_jpy": {"type": "integer", "description": "国民年金 (基礎年金)"},
            "employees_pension_jpy": {"type": "integer", "description": "厚生年金"},
            "subtotal_jpy": {"type": "integer", "example": 2184000},
            "monthly_breakdown": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "month": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$"},
                  "amount_jpy": {"type": "integer"},
                  "deposit_date_iso": {"type": "string", "format": "date"}
                }
              }
            }
          }
        },
        "miscellaneous_income": {
          "type": "object",
          "description": "雑所得 (e.g., honoraria, occasional writing fees)",
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "payer_name_utf8_nfc": {"type": "string", "example": "三菱重工OB会"},
                  "payer_address": {"type": "string"},
                  "date_iso": {"type": "string", "format": "date"},
                  "amount_jpy": {"type": "integer", "example": 20000},
                  "category": {"type": "string", "enum": ["原稿料", "講演料", "印税", "その他"]}
                }
              }
            },
            "subtotal_jpy": {"type": "integer", "example": 20000}
          }
        },
        "interest_income": {
          "type": "object",
          "description": "利子所得 (bank interest etc.)",
          "properties": {
            "bank_interest_jpy": {"type": "integer", "example": 3200},
            "source_bank_name_utf8_nfc": {"type": "string", "example": "中国銀行"}
          }
        },
        "total_jpy": {"type": "integer", "example": 2207200}
      }
    },
    "deductions": {
      "type": "object",
      "description": "所得控除 (income deductions)",
      "properties": {
        "social_insurance_premium": {
          "type": "object",
          "description": "社会保険料控除 (national health insurance + long-term care insurance)",
          "properties": {
            "national_health_insurance_jpy": {"type": "integer", "example": 84000},
            "long_term_care_insurance_jpy": {"type": "integer", "example": 48000},
            "subtotal_jpy": {"type": "integer", "example": 132000}
          }
        },
        "medical_expense": {
          "type": "object",
          "description": "医療費控除 (threshold ¥100,000; only excess is deductible)",
          "properties": {
            "total_medical_expense_jpy": {"type": "integer", "example": 126400},
            "threshold_jpy": {"type": "integer", "const": 100000},
            "eligible_deduction_jpy": {"type": "integer", "example": 26400},
            "receipt_count": {"type": "integer", "example": 12},
            "receipts_archived_drive_path": {"type": "string", "example": "personal-hiroshi-tanaka-jp/tax/fy2026/receipts"}
          }
        },
        "basic_deduction": {
          "type": "object",
          "description": "基礎控除 (basic personal deduction)",
          "properties": {
            "amount_jpy": {"type": "integer", "const": 480000, "description": "FY2026 basic deduction for income ≤ ¥24,000,000"}
          }
        },
        "spouse_deduction": {
          "type": "object",
          "description": "配偶者控除 (Hiroshi: ¥0 since Sachiko's death in 2023)",
          "properties": {
            "amount_jpy": {"type": "integer", "const": 0},
            "applicable": {"type": "boolean", "const": false},
            "reason": {"type": "string", "const": "死別 (bereavement)"}
          }
        },
        "total_jpy": {"type": "integer", "example": 638400}
      }
    },
    "tax_calculation": {
      "type": "object",
      "description": "Tax computation",
      "properties": {
        "income_total_jpy": {"type": "integer", "example": 2207200},
        "public_pension_deduction_jpy": {
          "type": "integer",
          "description": "公的年金等控除 — separate from 所得控除; applied before taxable income",
          "example": 0,
          "comment": "Hiroshi is age 65+ with pension income; subject to public-pension-deduction table per Income Tax Act §35"
        },
        "deductions_total_jpy": {"type": "integer", "example": 638400},
        "taxable_income_jpy": {"type": "integer", "example": 1568800},
        "income_tax_jpy": {"type": "integer", "example": 37400, "description": "Computed per progressive bracket"},
        "reconstruction_special_tax_rate": {"type": "number", "const": 0.021, "description": "復興特別所得税 2.1% surcharge"},
        "reconstruction_special_tax_jpy": {"type": "integer", "example": 785},
        "total_tax_jpy": {"type": "integer", "example": 38185}
      }
    },
    "withholding": {
      "type": "object",
      "properties": {
        "pension_withholding_jpy": {"type": "integer", "example": 56750},
        "estimated_tax_paid_jpy": {"type": "integer", "example": 55200, "description": "予定納税 quarterly payments"},
        "estimated_quarterly_breakdown": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "period": {"type": "string"},
              "amount_jpy": {"type": "integer"},
              "paid_at_iso": {"type": "string", "format": "date"}
            }
          }
        },
        "total_jpy": {"type": "integer", "example": 111950}
      }
    },
    "refund_or_balance": {
      "type": "object",
      "properties": {
        "balance_jpy": {"type": "integer", "example": -73765, "description": "Negative = refund owed to filer; positive = additional tax owed"},
        "is_refund": {"type": "boolean", "example": true},
        "refund_jpy": {"type": "integer", "example": 73765},
        "refund_bank_account": {
          "type": "object",
          "properties": {
            "bank_name_utf8_nfc": {"type": "string", "example": "中国銀行"},
            "branch_name_utf8_nfc": {"type": "string"},
            "account_number_last4": {"type": "string"},
            "account_holder_name_utf8_nfc": {"type": "string"}
          }
        },
        "refund_expected_date_iso": {"type": "string", "format": "date", "example": "2027-04-08"}
      }
    },
    "dependents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name_utf8_nfc": {"type": "string"},
          "relationship": {"type": "string"},
          "date_of_birth": {"type": "string", "format": "date"},
          "annual_income_jpy": {"type": "integer"}
        }
      },
      "description": "Hiroshi has no dependents (adult children both independent + earning above threshold)"
    },
    "submission_metadata": {
      "type": "object",
      "required": ["submission_channel", "signature_metadata", "review_complete"],
      "properties": {
        "submission_channel": {"type": "string", "const": "e-tax"},
        "etax_endpoint": {"type": "string"},
        "channel_cell": {"type": "string", "const": "jp-tokyo-etax-linkage-readonly"},
        "signature_metadata": {
          "type": "object",
          "properties": {
            "signature_alg": {"type": "string", "const": "JPKI-RSA-2048-with-passkey-counter-sign"},
            "my_number_card_certificate_serial": {"type": "string"},
            "passkey_assertion_id": {"type": "string"},
            "face_id_match_score": {"type": "number"},
            "signed_at": {"type": "string", "format": "date-time"}
          }
        },
        "review_complete": {"type": "boolean", "const": true},
        "review_sections": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "section": {"type": "string"},
              "confirmed": {"type": "boolean"},
              "voice_confirmation_utf8_nfc": {"type": "string"}
            }
          }
        },
        "year_over_year_comparison_reviewed": {"type": "boolean", "const": true},
        "submitted_at": {"type": "string", "format": "date-time"},
        "nta_receipt_number": {"type": "string", "pattern": "^[0-9]{8}-[0-9]{4}-[0-9]{3}-[A-Z]-[0-9]{7}$"},
        "accessibility_context_preserved": {
          "type": "object",
          "properties": {
            "talkback_active_during_submission": {"type": "boolean", "const": true},
            "high_contrast_theme_active": {"type": "boolean", "const": true},
            "large_text_active": {"type": "boolean", "const": true}
          }
        }
      }
    },
    "drive_archive": {
      "type": "object",
      "properties": {
        "drive_room": {"type": "string", "const": "personal-hiroshi-tanaka-jp/tax/fy2026/submission"},
        "filename": {"type": "string", "example": "etax-receipt-20270227-1414-008-T-7842965.pdf"},
        "worm_lock_engaged": {"type": "boolean", "const": true},
        "worm_until": {"type": "string", "format": "date-time", "example": "2034-02-27T00:00:00+09:00"},
        "retention_authority": {"type": "string", "const": "JP-Income-Tax-Act-148"}
      }
    },
    "audit_chain": {
      "type": "object",
      "properties": {
        "form_draft_audit_event": {"type": "string", "const": "EVT-J164-FORM-DRAFTED-006"},
        "form_review_audit_event": {"type": "string", "const": "EVT-J164-FORM-REVIEW-006a"},
        "etax_submitted_audit_event": {"type": "string", "const": "EVT-J164-ETAX-SUBMITTED-009"},
        "drive_archive_audit_event": {"type": "string", "const": "EVT-J164-ETAX-RECEIPT-ARCHIVED-009a"},
        "my_number_access_log_audit_event": {"type": "string", "const": "EVT-J164-MY-NUMBER-DAILY-SUMMARY-011"}
      }
    }
  },
  "examples": [
    {
      "form_metadata": {
        "form_class": "kakutei_shinkoku_b",
        "fiscal_year": "fy2026",
        "japanese_era": "reiwa-8",
        "form_version": "2027.1",
        "tenant_id": "personal-hiroshi-tanaka-jp",
        "draft_id": "kakutei-shinkoku-b-hiroshi-fy2026-draft-001",
        "draft_at": "2027-02-27T13:18:42+09:00"
      },
      "filer": {
        "name_utf8_nfc": "田中 浩",
        "name_furigana": "たなか ひろし",
