        "date_of_birth_japanese_era": "showa-29-11-08",
        "my_number_short": "****-****-1234",
        "marital_status_at_year_end": "死別",
        "occupation_at_year_end": "無職 (退職者)"
      },
      "income": {
        "public_pension": {
          "national_pension_jpy": 780000,
          "employees_pension_jpy": 1404000,
          "subtotal_jpy": 2184000
        },
        "miscellaneous_income": {
          "items": [
            {
              "payer_name_utf8_nfc": "三菱重工OB会",
              "date_iso": "2026-11-04",
              "amount_jpy": 20000,
              "category": "原稿料"
            }
          ],
          "subtotal_jpy": 20000
        },
