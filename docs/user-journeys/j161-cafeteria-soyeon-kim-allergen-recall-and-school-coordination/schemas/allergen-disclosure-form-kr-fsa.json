{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oya.cloud/journeys/j161/schemas/allergen-disclosure-form-kr-fsa-v1.json",
  "title": "KR-FSA + KR-SchoolMealsAct allergen disclosure form for school-meal menus",
  "description": "Structured allergen disclosure form per KR Food Sanitation Act + KR School Meals Act + KR-MFDS Notification 2021-95 (22-allergen mandatory disclosure). Per-dish allergen list + cross-contact disclosure + supplier lot trace. Hangul UTF-8 NFC strict mode.",
  "type": "object",
  "required": [
    "form_id",
    "form_version",
    "school_tenant",
    "menu_id",
    "menu_date",
    "responsible_nutritionist",
    "kr_mfds_22_allergen_list_reference",
    "dishes",
    "menu_level_declared_allergens",
    "menu_level_cross_contact_disclosures",
    "supplier_lot_traces",
    "diacritic_policy",
    "kr_fsa_article_compliance",
    "kr_school_meals_act_compliance"
  ],
  "properties": {
    "form_id": {
      "type": "string",
      "pattern": "^allergen-disclosure-[a-z0-9-]+$",
      "examples": ["allergen-disclosure-MENU-2026-05-13-Wednesday-Mediterranean-day"]
    },
    "form_version": {
      "type": "string",
      "const": "v1.0.0"
    },
    "school_tenant": {
      "type": "string",
      "examples": ["seonhwa-cho-yuseong-daejeon-kr"]
    },
    "menu_id": {
      "type": "string"
    },
    "menu_date": {
      "type": "string",
      "format": "date"
    },
    "menu_theme_ko": {
      "type": "string",
      "description": "Korean menu theme name; UTF-8 NFC",
      "examples": ["지중해 데이"]
    },
    "menu_theme_en": {
      "type": "string",
      "examples": ["Mediterranean Day"]
    },
    "responsible_nutritionist": {
      "type": "object",
      "required": ["principal", "legal_name_hangul", "kr_school_nutritionist_cert", "iso_22000_competency"],
      "properties": {
        "principal": {"type": "string"},
        "legal_name_hangul": {"type": "string", "examples": ["김소연"]},
        "legal_name_romanized": {"type": "string", "examples": ["Kim Soyeon"]},
        "kr_nutritionist_license_year": {"type": "integer", "examples": [2002]},
        "kr_school_nutritionist_cert": {"type": "string", "examples": ["KR-School-Nutritionist-2011"]},
        "iso_22000_competency": {"type": "string", "examples": ["ISO-22000-2018-Competency"]}
      }
    },
    "kr_mfds_22_allergen_list_reference": {
      "type": "string",
      "const": "KR-MFDS-Notification-2021-95-22-allergen-mandatory"
    },
    "dishes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/components/dish"
      }
    },
    "menu_level_declared_allergens": {
      "type": "array",
      "minItems": 0,
      "items": {
        "$ref": "#/components/allergen"
      },
      "description": "All allergens declared across the menu (union of per-dish declarations)"
    },
    "menu_level_cross_contact_disclosures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["allergen", "rationale", "supplier", "lot_reference", "bulletin_reference"],
        "properties": {
          "allergen": {"$ref": "#/components/allergen"},
          "rationale": {"type": "string", "description": "Why cross-contact is possible"},
          "supplier": {"type": "string"},
          "lot_reference": {"type": "string"},
          "bulletin_reference": {"type": "string"}
        }
      }
    },
    "supplier_lot_traces": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ingredient", "supplier_tenant", "lot", "received_at", "received_by", "bulletin_check_at"],
        "properties": {
          "ingredient": {"type": "string"},
          "supplier_tenant": {"type": "string"},
          "lot": {"type": "string"},
          "received_at": {"type": "string", "format": "date-time"},
          "received_by": {"type": "string"},
          "bulletin_check_at": {"type": "string", "format": "date-time"},
          "bulletin_check_result": {"type": "string", "enum": ["clear", "flagged", "pending"]},
          "bulletin_reference": {"type": "string"}
        }
      }
    },
    "diacritic_policy": {
      "type": "object",
      "required": ["unicode_normalization", "diacritics_preserved", "hangul_canonical"],
      "properties": {
        "unicode_normalization": {"type": "string", "const": "NFC"},
        "diacritics_preserved": {"type": "boolean", "const": true},
        "hangul_canonical": {"type": "boolean", "const": true},
        "romanize_to_ascii": {"type": "boolean", "default": false},
        "user_explicit_consent_to_romanize": {"type": "boolean", "default": false}
      }
    },
    "kr_fsa_article_compliance": {
      "type": "object",
      "required": ["article_44_operator_authority_attested", "article_86_regulator_notification_capability"],
      "properties": {
        "article_44_operator_authority_attested": {"type": "boolean", "const": true},
        "article_86_regulator_notification_capability": {"type": "boolean", "const": true}
      }
    },
    "kr_school_meals_act_compliance": {
      "type": "object",
      "required": ["article_17_incident_report_capability", "article_19_recall_protocols_attested"],
      "properties": {
        "article_17_incident_report_capability": {"type": "boolean", "const": true},
        "article_19_recall_protocols_attested": {"type": "boolean", "const": true}
      }
    },
    "haccp_compliance": {
      "type": "object",
      "properties": {
        "ccp_3_allergen_control_attested": {"type": "boolean"},
        "ccp_3_review_frequency_months": {"type": "integer", "default": 1}
      }
    },
    "iso_22000_compliance": {
      "type": "object",
      "properties": {
        "section_8_9_food_safety_incident_management_attested": {"type": "boolean"},
        "cert_id": {"type": "string"},
        "cert_valid_through": {"type": "string", "format": "date"}
      }
    },
    "kr_pipa_compliance": {
      "type": "object",
      "properties": {
        "student_allergy_database_consent_basis": {"type": "string", "enum": ["explicit_parent_consent_with_renewal", "lawful_safety_basis_only", "guardian_consent_special_education"]},
        "sensitive_info_handling_attested": {"type": "boolean"}
      }
    },
    "parent_disclosure_publication_path": {
      "type": "object",
      "required": ["per_family_privacy_preserving", "kakaotalk_crossover_supported", "translation_languages_supported"],
      "properties": {
        "per_family_privacy_preserving": {"type": "boolean", "const": true},
        "kakaotalk_crossover_supported": {"type": "boolean"},
        "translation_languages_supported": {"type": "array", "items": {"type": "string"}, "examples": [["ko-KR", "en-US", "vi-VN", "zh-CN", "mn-MN"]]}
      }
    }
  },
  "components": {
    "allergen": {
      "type": "string",
      "enum": [
        "peanut",
        "tree_nut_walnut",
        "tree_nut_almond",
        "tree_nut_cashew",
        "tree_nut_pecan",
        "tree_nut_pistachio",
        "tree_nut_macadamia",
        "milk",
        "egg",
        "wheat",
        "soy",
        "fish",
        "shellfish_shrimp",
        "shellfish_crab",
        "shellfish_lobster",
        "shellfish_squid",
        "buckwheat",
        "sesame",
        "peach",
        "tomato",
        "pork",
        "chicken",
        "beef",
        "mackerel",
        "sulfite"
      ],
      "description": "KR-MFDS 22-allergen mandatory disclosure list per Notification 2021-95"
    },
    "dish": {
      "type": "object",
      "required": ["dish_id", "dish_name_ko", "ingredients", "declared_allergens"],
      "properties": {
        "dish_id": {"type": "string"},
        "dish_name_ko": {"type": "string", "description": "Korean dish name; UTF-8 NFC"},
        "dish_name_en": {"type": "string"},
        "ingredients": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["ingredient_name_ko", "quantity_per_portion_g"],
            "properties": {
              "ingredient_name_ko": {"type": "string"},
              "ingredient_name_en": {"type": "string"},
              "quantity_per_portion_g": {"type": "number"},
              "supplier_lot_ref": {"type": "string"}
            }
          }
        },
        "declared_allergens": {
          "type": "array",
          "items": {"$ref": "#/components/allergen"}
        },
        "cross_contact_disclosures": {
          "type": "array",
          "items": {"$ref": "#/components/allergen"}
        }
      }
    }
  },
  "examples": [
    {
      "form_id": "allergen-disclosure-MENU-2026-05-13-Wednesday-Mediterranean-day",
      "form_version": "v1.0.0",
      "school_tenant": "seonhwa-cho-yuseong-daejeon-kr",
      "menu_id": "MENU-2026-05-13-Wednesday-Mediterranean-day",
