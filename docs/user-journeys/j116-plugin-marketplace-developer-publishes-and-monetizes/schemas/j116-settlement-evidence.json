{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.oyatie.com/schemas/user-journeys/j116/settlement-evidence.json",
  "title": "J116SettlementEvidenceSchema",
  "version": "1.0.0",
  "_meta": {
    "doc_class": "JourneySharedSchema",
    "purpose": "settlement-evidence object for Third-party developer publishes and monetizes a plugin.",
    "journey_id": "j116-plugin-marketplace-developer-publishes-and-monetizes",
    "binding_adrs": [
      "ADR-0244",
      "ADR-0297",
      "ADR-0299",
      "ADR-0292",
      "ADR-0263",
      "ADR-0307",
      "ADR-0308",
      "ADR-0311",
      "ADR-0312",
      "ADR-0313",
      "ADR-0105",
      "ADR-0131",
      "ADR-0249",
      "ADR-0257"
    ],
    "industry_citations": [
      "Stripe platform facilitator settlement",
      "AWS EventBridge event envelope",
      "Palantir Foundry ontology projection"
    ],
    "contract_versions": [
      "OpenAPI 3.2.0",
      "AsyncAPI 3.1.0",
      "proto3"
    ],
    "grammar": "BNF v4.1 + ADR-0105 13-layer",
    "layout": "ADR-0131 flat per-microservice layout",
    "marketplace_settles_all_tenant_deals": true,
    "status": "draft"
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "journey_id",
    "actor_principal_id",
    "active_tenant_id",
    "counterparty_tenant_ids",
    "services",
    "marketplace_settlement",
    "audit_event"
  ],
  "properties": {
    "journey_id": {
      "type": "string",
      "const": "j116",
      "description": "Stable journey id used by docs, tests, and trace fixtures.",
      "examples": [
        "j116"
      ],
      "oyatie.data_class": "internal_reference"
    },
    "actor_principal_id": {
      "type": "string",
      "description": "Principal for Nadia Park, third-party developer and micro-SaaS founder; must resolve through identity before any service call.",
      "examples": [
        "nadia-park-third-party-developer-and-micro-saas-founder"
      ],
      "oyatie.data_class": "tenant_identity"
    },
    "active_tenant_id": {
      "type": "string",
      "description": "Tenant context selected by the actor and shown in UX before command submission.",
      "examples": [
        "nadia-labs.dev"
      ],
      "oyatie.data_class": "tenant_scoped"
    },
    "counterparty_tenant_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "description": "Counterparty tenants that participate in the commercial or governance flow.",
      "examples": [
        [
          "50-installing-tenant-admins",
          "oyatie-platform-settlement-tenant"
        ]
      ],
      "oyatie.data_class": "tenant_scoped"
    },
    "services": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "plugin-app-store",
          "payments",
          "tenancy",
          "foundry",
          "community"
        ]
      },
      "description": "Microservices touched by this journey.",
      "examples": [
        [
          "plugin-app-store",
          "payments",
          "tenancy",
          "foundry",
          "community"
        ]
      ],
      "oyatie.data_class": "internal_reference"
    },
    "marketplace_settlement": {
      "type": "object",
      "description": "Marketplace facilitator settlement envelope; required for all tenant deals.",
      "required": [
        "surface",
        "deal",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "surface": {
          "type": "string",
          "const": "plugin-app-store"
        },
        "deal": {
          "type": "string",
          "const": "plugin revenue share with 50 installing tenants"
        },
        "status": {
          "type": "string",
          "enum": [
            "intent",
            "authorized",
            "settled",
            "reversed",
            "credited"
          ]
        }
      }
    },
    "audit_event": {
      "type": "string",
      "const": "PluginMarketplaceDealSettled",
      "description": "Primary ADR-0263 audit event emitted by this journey.",
      "examples": [
        "PluginMarketplaceDealSettled"
      ],
      "oyatie.data_class": "audit_metadata"
    }
  }
}
