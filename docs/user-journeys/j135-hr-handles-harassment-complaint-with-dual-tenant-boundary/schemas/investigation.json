{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oyatie.dev/schemas/j135/investigation.json",
  "title": "Investigation",
  "type": "object",
  "_meta": {
    "doc_class": "User-Journey-Schema",
    "journey_id": "j135-hr-handles-harassment-complaint-with-dual-tenant-boundary",
    "version": "1.0.0",
    "owners": ["workflow-engine", "compliance"]
  },
  "required": ["investigation_id", "complaint_id", "jurisdiction", "parties", "scope", "investigator_assigned", "opened_at"],
  "properties": {
    "investigation_id": {"type": "string", "format": "uuid"},
    "complaint_id": {"type": "string"},
    "jurisdiction": {"type": "string"},
    "labor_law_anchors": {
      "type": "array",
      "items": {"type": "string"}
    },
    "parties": {
      "type": "object",
      "properties": {
        "complainant_principal": {"type": "string"},
        "perpetrator_principal": {"type": "string"},
        "witnesses": {"type": "array", "items": {"type": "string"}}
      }
    },
    "scope": {
      "type": "object",
      "properties": {
        "data_classes_in_scope": {
          "type": "array",
          "items": {"type": "string", "enum": ["work-messenger", "work-mail", "work-drive", "work-calendar", "work-workflow-engine-logs"]}
        },
        "data_classes_out_of_scope": {
          "type": "array",
          "items": {"type": "string", "enum": ["personal-messenger", "personal-mail", "personal-drive", "personal-calendar", "personal-notes"]},
          "description": "Always populated with personal-* per ADR-0311"
        },
        "time_range": {
          "type": "object",
          "properties": {
            "starts_at": {"type": "string", "format": "date-time"},
            "ends_at": {"type": "string", "format": "date-time"}
          }
        }
      }
    },
    "investigator_assigned": {
      "type": "object",
      "properties": {
        "principal": {"type": "string"},
        "tenant_id": {"type": "string"},
        "audience_type": {"type": "string", "enum": ["B2B_HR_ADMIN", "B2B_LEGAL_ADMIN", "B2B_INVESTIGATOR"]}
      }
    },
    "third_party_engagement_id": {"type": "string"},
    "provisional_protections": {
      "type": "object",
      "properties": {
        "no_meet_with_perp": {"type": "boolean"},
        "calendar_read_blocked": {"type": "boolean"},
        "manager_chain_notified": {"type": "boolean", "default": false, "description": "Default false to prevent retaliation pre-investigation"}
      }
    },
    "opened_at": {"type": "string", "format": "date-time"},
    "closed_at": {"type": "string", "format": "date-time"},
    "status": {
      "type": "string",
      "enum": ["opened", "in_progress", "report_drafted", "report_finalized", "outcome_pending", "outcome_finalized", "remedy_implementing", "closed"]
    }
  }
}
