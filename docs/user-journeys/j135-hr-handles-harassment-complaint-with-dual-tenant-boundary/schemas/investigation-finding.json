{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oyatie.com/schemas/j135/investigation-finding.json",
  "title": "InvestigationFinding",
  "type": "object",
  "_meta": {
    "doc_class": "User-Journey-Schema",
    "journey_id": "j135-hr-handles-harassment-complaint-with-dual-tenant-boundary",
    "version": "1.0.0",
    "owners": ["workflow-engine", "compliance"]
  },
  "required": ["finding_id", "investigation_id", "investigator_principal", "verdict", "evidence_refs", "recommended_remedies", "finalized_at"],
  "properties": {
    "finding_id": {"type": "string", "format": "uuid"},
    "investigation_id": {"type": "string"},
    "investigator_principal": {"type": "string"},
    "verdict": {
      "type": "string",
      "enum": ["substantiated", "partially_substantiated", "not_substantiated", "inconclusive"]
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "data_class": {"type": "string"},
          "hash_pin": {"type": "string"},
          "description": {"type": "string"}
        }
      }
    },
    "recommended_remedies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {"type": "string", "enum": ["write_up", "training", "transfer", "pip", "demotion", "termination", "policy_change", "no_action"]},
          "target_principal": {"type": "string"},
          "duration_months": {"type": "integer"},
          "details": {"type": "string"}
        }
      }
    },
    "finalized_at": {"type": "string", "format": "date-time"},
    "report_drive_ref": {"type": "string"},
    "merkle_seal": {"type": "string"}
  }
}
