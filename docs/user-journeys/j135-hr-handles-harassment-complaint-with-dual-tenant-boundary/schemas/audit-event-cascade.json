      },
      "emitted_by": {"type": "string"},
      "emitted_at": {"type": "string", "format": "date-time"},
      "tenant_id": {"type": "string"},
      "actor": {"type": "string"},
      "subject_ref": {"type": "string"},
      "merkle_seal": {"type": "string"},
      "payload": {"type": "object"}
    }
  }
}
