          "WorkMessengerInvestigationRead",
          "WorkMessengerPatternSearchCompleted",
          "UnauthorizedCrossTenantPersonalMessengerReadAttempt",
          "ThirdPartyInvestigatorEngaged",
          "InvestigationInterviewScheduled",
          "InvestigationInterviewCompleted",
          "InvestigationReportFinalized",
          "InvestigationOutcomeFinalized",
          "RemedyImplemented",
          "InvestigationClosed",
          "InvestigationFinalSeal"
