{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oyatie.com/schemas/j135/audit-event-cascade.json",
  "title": "AuditEventCascade-j135",
  "type": "array",
  "_meta": {
    "doc_class": "User-Journey-Schema",
    "journey_id": "j135-hr-handles-harassment-complaint-with-dual-tenant-boundary",
    "version": "1.0.0",
