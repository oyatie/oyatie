{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oyatie.dev/schemas/j135/whistleblower-complaint.json",
  "title": "WhistleblowerComplaint",
  "type": "object",
  "_meta": {
    "doc_class": "User-Journey-Schema",
    "journey_id": "j135-hr-handles-harassment-complaint-with-dual-tenant-boundary",
    "version": "1.0.0",
    "owners": ["community", "compliance"],
    "related_adrs": ["ADR-0311", "ADR-0244", "ADR-0263"]
  },
  "required": ["complaint_id", "complainant_principal", "perpetrator_pseudo_id", "complaint_classification", "narrative_encrypted", "share_consent_ladder", "submitted_at", "jurisdiction"],
  "properties": {
    "complaint_id": {"type": "string", "format": "uuid"},
    "complainant_principal": {"type": "string"},
    "perpetrator_pseudo_id": {
      "type": "string",
      "pattern": "^pseu_[a-z0-9]{32}$"
    },
    "complaint_classification": {
      "type": "string",
      "enum": ["harassment", "discrimination", "retaliation", "fraud", "safety", "ethics-violation"]
    },
    "narrative_encrypted": {
      "type": "string",
      "description": "Per-complaint encrypted at rest"
    },
    "share_consent_ladder": {
      "type": "object",
      "properties": {
        "work_messenger_dms_with_perp": {"type": "boolean"},
        "work_mail_with_perp": {"type": "boolean"},
        "work_calendar_shared_with_perp": {"type": "boolean"},
        "personal_messenger": {"type": "boolean", "const": false, "description": "Default false; opt-in only"},
        "personal_mail": {"type": "boolean", "const": false},
        "personal_drive": {"type": "boolean", "const": false}
      }
    },
    "submitted_at": {"type": "string", "format": "date-time"},
    "jurisdiction": {"type": "string"},
    "investigation_id": {"type": "string", "description": "Set when investigation opens"},
    "status": {
      "type": "string",
      "enum": ["submitted", "routing", "investigation_open", "investigation_in_progress", "outcome_finalized", "closed"]
    }
  }
}
