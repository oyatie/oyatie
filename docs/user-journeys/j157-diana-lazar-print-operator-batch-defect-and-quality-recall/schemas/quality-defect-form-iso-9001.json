{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://oya.cloud/schemas/j157/quality-defect-form-iso-9001.json",
  "title": "Quality defect form — ISO 9001:2015 §10.2 + ISO 12647-2 + FOGRA-PSO",
  "description": "Schema for the quality-management defect record; consumed by the recall workflow and the CAPA process. All string fields are UTF-8 NFC; diacritics preserved at byte-level fidelity.",
  "type": "object",
  "required": [
    "defect_id",
    "tenant_id",
    "batch_id",
    "detected_at",
    "detected_by",
    "category",
    "iso_9001_severity",
    "fogra_pso_class",
    "telemetry",
    "regulatory_impact",
    "diacritic_policy"
  ],
  "properties": {
    "defect_id": {
      "type": "string",
      "pattern": "^defect-[a-z0-9-]+-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{3}$",
      "examples": ["defect-bch-2027-02-23-0612-001"]
    },
    "tenant_id": {
      "type": "string",
      "examples": ["tipografia-lazar-petrescu-ro"]
    },
    "batch_id": {
      "type": "string",
      "examples": ["BCH-2027-02-23-0612-pharma-leaflet-NSAID-RO"]
    },
    "detected_at": {"type": "string", "format": "date-time"},
    "detected_by": {
      "type": "object",
      "required": ["principal", "role", "certifications_active"],
      "properties": {
        "principal": {"type": "string", "examples": ["diana.lazăr@tipografia-lazar-petrescu-ro"]},
        "role": {"type": "string", "examples": ["press_operator_day_shift"]},
        "certifications_active": {
          "type": "array",
          "items": {"type": "string"},
          "examples": [["FOGRA-PSO-Operator-Level-2", "ISO-12647-2-Trained"]]
        }
      }
    },
    "category": {
      "type": "string",
      "enum": [
        "color_drift",
        "registration_shift",
        "registration_shift_legal_text_clipping",
        "ink_density",
        "substrate_defect",
        "binding_defect",
        "trim_size",
        "foil_or_emboss",
        "other"
      ]
    },
    "iso_9001_severity": {
      "type": "string",
      "enum": ["minor", "major", "critical"],
      "description": "Per ISO 9001:2015 §10.2 — critical means product unsafe for intended use"
    },
    "fogra_pso_class": {
      "type": "string",
      "enum": [
        "in_tolerance",
        "marginal_in_tolerance",
        "out_of_tolerance_solid",
        "out_of_tolerance_solid_plus_registration",
        "out_of_tolerance_solid_color_plus_registration",
        "out_of_tolerance_registration_only",
        "out_of_tolerance_ink_density"
      ]
    },
    "telemetry": {
      "type": "object",
      "required": ["delta_e_at_first_breach", "affected_sheet_range_start", "affected_sheet_range_end", "affected_sheet_count"],
      "properties": {
        "delta_e_at_first_breach": {"type": "number"},
        "delta_e_trajectory": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "sheet_index": {"type": "integer"},
              "delta_e_2000": {"type": "number"},
              "captured_at": {"type": "string", "format": "date-time"}
            }
          }
        },
        "registration_shift_mm_x": {"type": "number"},
        "registration_shift_mm_y": {"type": "number"},
        "affected_sheet_range_start": {"type": "integer"},
        "affected_sheet_range_end": {"type": "integer"},
        "affected_sheet_count": {"type": "integer"}
      }
    },
    "legal_text_clipping": {
      "type": "object",
      "description": "Present only if category includes legal-text-clipping",
      "properties": {
        "expected_text": {"type": "string", "description": "UTF-8 NFC diacritic-preserved approved text", "examples": ["Nu administrați copiilor sub 6 ani fără sfatul medicului"]},
        "rendered_text": {"type": "string", "examples": ["Nu administrați copiilor ub 6 ani fără sfatul medicului"]},
        "diff_summary": {
          "type": "object",
          "properties": {
            "missing_chars": {"type": "string"},
            "extra_chars": {"type": "string"},
            "structural_diff_class": {"type": "string", "enum": ["text_clipping_low", "text_clipping_high", "text_clipping_side", "text_overflow", "ink_drop_out"]}
          }
        },
        "clip_height_mm": {"type": "number"},
        "regulatory_class": {
          "type": "string",
          "enum": ["ANMDMR_approved_text_deviation", "EMA_PIL_deviation", "FDA_label_deviation", "non_regulatory"]
        }
      }
    },
    "regulatory_impact": {
      "type": "object",
      "required": ["impact_class", "regulator_anchor", "notification_obligation"],
      "properties": {
        "impact_class": {
          "type": "string",
          "enum": ["no_impact", "internal_quality_only", "customer_notify_only", "regulator_notify_required", "market_recall_required"]
        },
        "regulator_anchor": {
          "type": "string",
          "examples": ["ANMDMR-Hot-Brand-2023-12", "EU-GPSR-2023-988-Art-33", "RO-OUG-21-2021"]
        },
        "notification_obligation": {
          "type": "object",
          "properties": {
            "customer_required": {"type": "boolean"},
            "customer_sla_hours": {"type": "integer"},
            "regulator_required": {"type": "boolean"},
            "regulator_sla_hours": {"type": "integer"}
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "properties": {
        "press_camera_frames": {"type": "array", "items": {"type": "string"}},
        "operator_photos": {"type": "array", "items": {"type": "string"}, "minItems": 8},
        "spectrophotometer_log_id": {"type": "string", "examples": ["xrite-exact-2-log-2027-02-23-bch-0612"]},
        "color_history_export_id": {"type": "string"}
      }
    },
    "root_cause": {
      "type": "object",
      "properties": {
        "hypothesis_at_detection": {"type": "string"},
        "confirmed_category": {
          "type": "string",
          "enum": ["mechanical_wear", "mechanical_wear_dampener_roller_cylinder", "operator_error", "substrate_lot_variability", "ink_lot_variability", "environmental", "software_drift", "other"]
        },
        "confirmed_specific": {"type": "string"},
        "confirmed_at": {"type": "string", "format": "date-time"},
        "confirmed_by": {"type": "string"},
        "endorsed_by": {"type": "string"},
        "inspection_link": {"type": "string"}
      }
    },
    "capa": {
      "type": "object",
      "properties": {
        "capa_id": {"type": "string"},
        "correction": {"type": "array", "items": {"type": "string"}},
        "corrective_action": {"type": "array", "items": {"type": "string"}},
        "preventive_action": {"type": "array", "items": {"type": "string"}},
        "filed_at": {"type": "string", "format": "date-time"},
        "filed_by": {"type": "string"},
        "endorsed_by": {"type": "string"}
      }
    },
    "diacritic_policy": {
      "type": "object",
      "required": ["unicode_normalization", "diacritics_preserved"],
      "properties": {
        "unicode_normalization": {"type": "string", "enum": ["NFC"]},
        "diacritics_preserved": {"type": "boolean", "const": true},
        "locale_render": {"type": "string", "examples": ["ro-RO", "en-GB", "hu-HU"]}
      }
    },
    "audit": {
      "type": "object",
      "properties": {
        "event_class": {"type": "string"},
        "dual_seal_tenants": {"type": "array", "items": {"type": "string"}},
        "merkle_leaf_b64": {"type": "string"},
        "retention_years": {"type": "integer", "const": 15}
      }
    }
  }
}
