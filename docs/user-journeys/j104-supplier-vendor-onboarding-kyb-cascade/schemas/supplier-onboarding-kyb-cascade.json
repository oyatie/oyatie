{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.oyatie.com/user-journeys/j104-supplier-vendor-onboarding-kyb-cascade/schemas/supplier-onboarding-kyb-cascade.json",
  "title": "SupplierOnboardingKybCascade",
  "version": "1.0.0",
  "_meta": {
    "doc_class": "JourneyObjectSchema",
    "journey_id": "j104-supplier-vendor-onboarding-kyb-cascade",
    "binding_adr": "ADR-0244-tenant-as-universal-scoping-primitive",
    "related_adrs": [
      "ADR-0242-oyatie-is-a-tenant-doctrine",
      "ADR-0243-cedar-as-universal-gate",
      "ADR-0244-tenant-as-universal-scoping-primitive",
      "ADR-0249-multi-category-marketplace-doctrine",
      "ADR-0263-observability-emission-contract",
      "ADR-0297-abuse-defence-baseline-anti-bot-spoof-scrape",
      "ADR-0311-dual-tenant-identity-personal-vs-work-boundary",
      "ADR-0313-conglomerate-tenant-hierarchy",
      "ADR-0314-marketplace-universal-deal-settlement-substrate"
    ],
    "status": "draft",
    "enforcement_status": "advisory-until-journey-contract-validator-lands",
    "industry_citations": [
      "AWS Organizations",
      "Stripe platform facilitator",
      "Bloomberg Terminal entitlement hierarchy",
      "Microsoft 365 Cross-Tenant Sync"
    ],
    "purpose": "KrampusCorp onboards a new supplier through mutual KYB, Cedar trust grants, ontology projection sync, and a 14-day workflow with jurisdictional holds."
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "journey_id",
    "deal_set_id",
    "tenant_pair",
    "cedar_grants",
    "audit_events",
    "drmp_controls",
    "service_states"
  ],
  "properties": {
    "journey_id": {
      "type": "string",
      "const": "j104-supplier-vendor-onboarding-kyb-cascade",
      "description": "Stable journey identifier used by docs, tests, telemetry, and per-service implementation plans.",
      "examples": [
        "j104-supplier-vendor-onboarding-kyb-cascade"
      ]
    },
    "deal_set_id": {
      "type": "string",
      "pattern": "^dealset_[a-z0-9_]+$",
      "description": "Marketplace universal deal-set identifier for the economic relationship, even when the transaction is a workforce contract, material purchase, or API subscription.",
      "examples": [
        "dealset_j104_supplier_onboarding_kyb_cascade"
      ]
    },
    "tenant_pair": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_tenant_id",
        "counterparty_tenant_ids",
        "relationship_kind"
      ],
      "description": "Explicit tenant pair or tenant set. Authority never derives from corporate ownership.",
      "properties": {
        "source_tenant_id": {
          "type": "string",
          "examples": [
            "tenant-krampuscorp-seoul"
          ]
        },
        "counterparty_tenant_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "examples": [
            [
              "tenant-new-supplier-osaka",
              "tenant-acme-rawmaterials-hamburg"
            ]
          ]
        },
        "relationship_kind": {
          "type": "string",
          "enum": [
            "supplier",
            "buyer",
            "facilitator",
            "workforce",
            "api_customer",
            "logistics",
            "arbiter"
          ],
          "examples": [
            "supplier"
          ]
        }
      }
    },
    "cedar_grants": {
      "type": "array",
      "minItems": 1,
      "description": "Scoped Cedar permit rows with purpose, expiry, and revocation path.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "grant_id",
          "principal_tenant_id",
          "resource_tenant_id",
          "actions",
          "expires_at"
        ],
        "properties": {
          "grant_id": {
            "type": "string",
            "examples": [
              "grant_j104_001"
            ]
          },
          "principal_tenant_id": {
            "type": "string",
            "examples": [
              "tenant-krampuscorp-seoul"
            ]
          },
          "resource_tenant_id": {
            "type": "string",
            "examples": [
              "tenant-acme-rawmaterials-hamburg"
            ]
          },
          "actions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "examples": [
              [
                "journey.j104.read",
                "journey.j104.settle"
              ]
            ]
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "examples": [
              "2026-12-31T23:59:59Z"
            ]
          }
        }
      }
    },
    "audit_events": {
      "type": "array",
      "minItems": 1,
      "description": "ADR-0263-linked audit event classes emitted by this journey.",
      "items": {
        "type": "string",
        "enum": [
          "TenantGrantProposed",
          "CedarPermitEvaluated",
          "MarketplaceDealAccepted",
          "PaymentEscrowReserved",
          "WorkflowMilestoneAdvanced",
          "OntologyProjectionWritten",
          "CompliancePackAttested",
          "AuditDualSealCommitted",
          "CrossTenantBoundaryDenied",
          "DrmpSignalEmitted"
        ]
      },
      "examples": [
        [
          "TenantGrantProposed",
          "CedarPermitEvaluated",
          "MarketplaceDealAccepted"
        ]
      ]
    },
    "drmp_controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "detection",
        "risk_scoring",
        "mitigation",
        "prevention"
      ],
      "description": "Detection, Risk, Mitigation, and Prevention controls activated by the journey.",
      "properties": {
        "detection": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "examples": [
            [
              "policy_violation",
              "payment_fraud"
            ]
          ]
        },
        "risk_scoring": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "examples": [
            [
              "tenant_pair_score",
              "counterparty_velocity"
            ]
          ]
        },
        "mitigation": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "examples": [
            [
              "pause_workflow",
              "freeze_settlement"
            ]
          ]
        },
        "prevention": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "examples": [
            [
              "default_deny",
              "signed_webhook",
              "idempotency_key"
            ]
          ]
        }
      }
    },
    "service_states": {
      "type": "object",
      "description": "Per-service state handles keyed by microservice name.",
      "additionalProperties": {
        "type": "object"
      },
      "examples": [
        {
          "tenancy": {
            "status": "pending",
            "audit_id": "EVT-tenant-krampuscorp-seoul-j104-tenancy"
          },
          "identity": {
            "status": "pending",
            "audit_id": "EVT-tenant-krampuscorp-seoul-j104-identity"
          },
          "workflow-engine": {
            "status": "pending",
            "audit_id": "EVT-tenant-krampuscorp-seoul-j104-workflow-engine"
          }
        }
      ]
    }
  }
}
