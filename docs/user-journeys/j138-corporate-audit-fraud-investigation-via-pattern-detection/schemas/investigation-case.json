{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.oyatie.com/user-journeys/j138/investigation-case.json",
  "title": "InvestigationCase",
  "description": "Investigation case state envelope per ADR-0310 case-management. Used for both detection-driven and ad-hoc internal-audit investigations.",
  "_meta": {
    "binding_adr": "ADR-0310",
    "related_adrs": ["ADR-0311", "ADR-0307", "ADR-0028"],
    "schema_version": "v1.0.0"
  },
  "type": "object",
  "required": ["case_id", "tenant_id", "originating_alert_id", "status", "requestor_principal", "created_at"],
  "properties": {
    "case_id": {"type": "string", "pattern": "^ic-[a-z0-9-]+$"},
    "tenant_id": {"type": "string"},
    "originating_alert_id": {"type": "string"},
    "originating_detection_pattern_class": {"type": "string"},
    "status": {"enum": ["ALERT", "TRIAGE", "PERMIT_PENDING", "ACTIVE", "EVIDENCE", "INTERVIEW", "REMEDIATION", "EXTERNAL", "CLOSED", "EXPIRED"]},
    "requestor_principal": {"type": "string", "format": "email"},
    "dual_control_chair_principal": {"type": "string", "format": "email"},
    "dual_control_approved_at": {"type": ["string", "null"], "format": "date-time"},
    "permit_batch_ref": {"type": "string"},
    "classification_window": {
      "type": "object",
      "properties": {
        "start": {"type": "string", "format": "date-time"},
        "end": {"type": "string", "format": "date-time"}
      }
    },
    "subject_principals": {
      "type": "array",
      "items": {"type": "string", "format": "email"}
    },
    "subject_resources": {
      "type": "array",
      "items": {"type": "string"}
    },
    "evidence_sources": {
      "type": "array",
      "items": {"enum": ["payments", "mail", "messenger", "drive", "workflow_engine", "audit_chain", "identity", "public_records"]}
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "finding_id": {"type": "string"},
          "type": {"type": "string"},
          "severity": {"enum": ["LOW", "MED", "HIGH", "CRITICAL"]},
          "confidence_pct": {"type": "integer"},
          "sealed_at": {"type": "string", "format": "date-time"}
        }
      }
    },
    "actions_executed": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "action_type": {"type": "string"},
          "target": {"type": "string"},
          "executed_at": {"type": "string", "format": "date-time"},
          "audit_seal_id": {"type": "string"}
        }
      }
    },
    "personal_tenant_deny_count": {"type": "integer", "minimum": 0},
    "created_at": {"type": "string", "format": "date-time"},
    "closed_at": {"type": ["string", "null"], "format": "date-time"},
    "audit_chain_root": {"type": "string"},
    "pack_set": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
