{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.oyatie.com/user-journeys/j138/vendor-payment-anomaly.json",
  "title": "VendorPaymentAnomalyPattern",
  "description": "Pattern descriptor used by detection.payments_anomaly_detector_v3 to encode anomalies in vendor-payment data.",
  "_meta": {
    "binding_adr": "ADR-0307",
    "related_adrs": ["ADR-0028"],
    "schema_version": "v1.0.0"
  },
  "type": "object",
  "required": ["pattern_id", "vendor_id", "tenant_id", "indicators", "statistical_evidence", "computed_at"],
  "properties": {
    "pattern_id": {"type": "string"},
    "vendor_id": {"type": "string"},
    "tenant_id": {"type": "string"},
    "approver_principal": {"type": "string"},
    "onboarder_principal": {"type": "string"},
    "indicators": {
      "type": "array",
      "items": {"enum": [
        "round_amount_clustering_below_threshold",
        "same_approver_as_onboarder",
        "missing_due_diligence_file",
        "residential_billing_address",
        "no_public_records_pre_onboarding",
        "minimal_share_capital",
        "vendor_age_under_30_days_pre_onboarding",
        "single_counterparty_contact",
        "weekend_or_after_hours_invoice_submission",
        "duplicate_invoice_amounts",
        "approval_chain_skipped"
      ]}
    },
    "statistical_evidence": {
      "type": "object",
      "properties": {
        "invoice_count": {"type": "integer"},
        "total_approved_usd": {"type": "number"},
        "median_amount_usd": {"type": "number"},
        "std_dev_amount_usd": {"type": "number"},
        "escalation_threshold_usd": {"type": "number"},
        "percent_under_threshold": {"type": "number"},
        "approver_uniqueness_ratio": {"type": "number"}
      }
    },
    "confidence_pct": {"type": "integer"},
    "computed_at": {"type": "string", "format": "date-time"},
    "model_version": {"type": "string"}
  },
  "additionalProperties": false
}
