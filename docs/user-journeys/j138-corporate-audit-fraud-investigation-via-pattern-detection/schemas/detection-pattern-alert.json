{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.oyatie.com/user-journeys/j138/detection-pattern-alert.json",
  "title": "DetectionPatternAlert",
  "description": "Alert envelope emitted by detection substrate when a pattern matches against tenant data. Routed to internal-audit subscribers per Cedar.",
  "_meta": {
    "binding_adr": "ADR-0307",
    "related_adrs": ["ADR-0311", "ADR-0310", "ADR-0263"],
    "schema_version": "v1.0.0"
  },
  "type": "object",
  "required": ["alert_id", "pattern_class", "confidence_pct", "severity", "signal_source", "tenant_id", "subject_principals", "emitted_at"],
  "properties": {
    "alert_id": {"type": "string", "pattern": "^al-[a-z0-9-]+$"},
    "pattern_class": {"type": "string"},
    "confidence_pct": {"type": "integer", "minimum": 0, "maximum": 100},
    "severity": {"enum": ["LOW", "MED", "HIGH", "CRITICAL"]},
    "signal_source": {"type": "string"},
    "model_version": {"type": "string"},
    "tenant_id": {"type": "string"},
    "subject_principals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["principal_id", "role"],
        "properties": {
          "principal_id": {"type": "string"},
          "role": {"type": "string"},
          "principal_class": {"enum": ["work_tenant_owned", "external_counterparty", "system_internal"]}
        }
      }
    },
    "subject_resources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "resource_ref": {"type": "string"},
          "resource_class": {"type": "string"}
        }
      }
    },
    "window_start": {"type": "string", "format": "date-time"},
    "window_end": {"type": "string", "format": "date-time"},
    "indicators": {"type": "array", "items": {"type": "string"}},
    "recommendation": {"enum": ["DISMISS", "TRIAGE", "OPEN_INVESTIGATION", "OPEN_ADHOC_AUDIT"]},
    "emitted_at": {"type": "string", "format": "date-time"},
    "audit_seal_id": {"type": "string"},
    "trace_id": {"type": "string"}
  },
  "additionalProperties": false
}
