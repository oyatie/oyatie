{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.oyatie.dev/user-journeys/j176-migration-from-sap-s4hana-to-oyatie-finance-month-1/vendor-extract-schema.json",
  "title": "SAP S/4HANA to Oyatie Finance month-1 cutover vendor extract schema",
  "type": "object",
  "required": [
    "journey_id",
    "tenant_id",
    "source_system",
    "batch_id",
    "objects",
    "row_count_manifest",
    "source_hash_manifest"
  ],
  "properties": {
    "journey_id": {
      "const": "j176-migration-from-sap-s4hana-to-oyatie-finance-month-1"
    },
    "tenant_id": {
      "const": "brindleworks-manufacturing"
    },
    "source_system": {
      "const": "sap-s4hana-prd-100"
    },
    "incumbent_system": {
      "const": "SAP S/4HANA Finance"
    },
    "target_system": {
      "const": "Oyatie finance"
    },
    "extraction_mechanism": {
      "const": "ODP replication plus signed table export from S/4HANA client 100"
    },
    "projection": {
      "const": "oyatie.finance.universal_journal_projection_v1"
    },
    "batch_id": {
      "type": "string",
      "pattern": "^batch-J[0-9]{3}-[0-9]{2}$"
    },
    "extracted_at": {
      "type": "string",
      "format": "date-time"
    },
    "objects": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "BKPF": {
          "type": "object",
          "description": "Accounting document header",
          "required": [
            "MANDT",
            "BUKRS",
            "BELNR",
            "GJAHR"
          ],
          "properties": {
            "MANDT": {
              "type": "string"
            },
            "BUKRS": {
              "type": "string"
            },
            "BELNR": {
              "type": "string"
            },
            "GJAHR": {
              "type": "string"
            },
            "BLART": {
              "type": "string"
            },
            "BLDAT": {
              "type": "string"
            },
            "BUDAT": {
              "type": "string"
            },
            "WAERS": {
              "type": "string"
            },
            "XBLNR": {
              "type": "string"
            }
          }
        },
        "BSEG": {
          "type": "object",
          "description": "Accounting document segment",
          "required": [
            "BUZEI",
            "HKONT",
            "KUNNR",
            "LIFNR"
          ],
          "properties": {
            "BUZEI": {
              "type": "string"
            },
            "HKONT": {
              "type": "string"
            },
            "KUNNR": {
              "type": "string"
            },
            "LIFNR": {
              "type": "string"
            },
            "DMBTR": {
              "type": "string"
            },
            "WRBTR": {
              "type": "string"
            },
            "SHKZG": {
              "type": "string"
            },
            "ZUONR": {
              "type": "string"
            }
          }
        },
        "ACDOCA": {
          "type": "object",
          "description": "Universal Journal line item",
          "required": [
            "RCLNT",
            "RLDNR",
            "RBUKRS",
            "GJAHR"
          ],
          "properties": {
            "RCLNT": {
              "type": "string"
            },
            "RLDNR": {
              "type": "string"
            },
            "RBUKRS": {
              "type": "string"
            },
            "GJAHR": {
              "type": "string"
            },
            "BELNR": {
              "type": "string"
            },
            "DOCLN": {
              "type": "string"
            },
            "RACCT": {
              "type": "string"
            },
            "PRCTR": {
              "type": "string"
            },
            "SEGMENT": {
              "type": "string"
            }
          }
        },
        "SKAT": {
          "type": "object",
          "description": "G/L account text",
          "required": [
            "KTOPL",
            "SAKNR",
            "SPRAS",
            "TXT20"
          ],
          "properties": {
            "KTOPL": {
              "type": "string"
            },
            "SAKNR": {
              "type": "string"
            },
            "SPRAS": {
              "type": "string"
            },
            "TXT20": {
              "type": "string"
            },
            "TXT50": {
              "type": "string"
            }
          }
        },
        "T001": {
          "type": "object",
          "description": "Company code",
          "required": [
            "BUKRS",
            "BUTXT",
            "ORT01",
            "LAND1"
          ],
          "properties": {
            "BUKRS": {
              "type": "string"
            },
            "BUTXT": {
              "type": "string"
            },
            "ORT01": {
              "type": "string"
            },
            "LAND1": {
              "type": "string"
            },
            "WAERS": {
              "type": "string"
            },
            "KTOPL": {
              "type": "string"
            }
          }
        }
      }
    },
    "row_count_manifest": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "object_name",
          "source_count",
          "target_count",
          "delta_count"
        ],
        "properties": {
          "object_name": {
            "enum": [
              "BKPF",
              "BSEG",
              "ACDOCA",
              "SKAT",
              "T001"
            ]
          },
          "source_count": {
            "type": "integer",
            "minimum": 0
          },
          "target_count": {
            "type": "integer",
            "minimum": 0
          },
          "delta_count": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "source_hash_manifest": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "object_name",
          "hash_algorithm",
          "hash_value"
        ],
        "properties": {
          "object_name": {
            "enum": [
              "BKPF",
              "BSEG",
              "ACDOCA",
              "SKAT",
              "T001"
            ]
          },
          "hash_algorithm": {
            "const": "sha256"
          },
          "hash_value": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64
          }
        }
      }
    }
  },
  "additionalProperties": false
}
