{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oyatie.com/schemas/user-journeys/j142/AudienceTypeDelegationRequest.json",
  "title": "AudienceTypeDelegationRequest",
  "type": "object",
  "_meta": {
    "doc_class": "Schema",
    "journey_id": "j142",
    "status": "draft",
    "owner": "identity",
    "consumers": ["workflow-engine", "tenancy", "audit-chain"],
    "adr_anchors": ["ADR-0244", "ADR-0299", "ADR-0311", "ADR-0145"]
  },
  "required": ["request_id", "subject_principal_personal", "subject_principal_work", "passkey_continuity_proof", "requested_audience_type_change", "reason_code", "workflow_evidence_ref"],
  "properties": {
    "request_id":                  { "type": "string", "pattern": "^AT-DELEG-[A-Z0-9-]+$" },
    "subject_principal_personal":  { "type": "string", "format": "uri" },
    "subject_principal_work":      { "type": "string", "format": "uri" },
    "passkey_continuity_proof": {
      "type": "object",
      "required": ["credential_id", "signature", "algorithm"],
      "properties": {
        "credential_id": { "type": "string" },
        "signature":     { "type": "string", "contentEncoding": "base64" },
        "algorithm":     { "type": "string", "enum": ["ES256", "EdDSA"] }
      }
    },
    "requested_audience_type_change": {
      "type": "object",
      "required": ["from", "to"],
      "properties": {
        "from": { "type": "string" },
        "to":   { "type": "string", "enum": ["B2C_JOB_SEEKER_ACTIVE"] }
      }
    },
    "reason_code": { "type": "string", "enum": ["EMPLOYMENT_TERMINATED_RIF", "EMPLOYMENT_TERMINATED_VOLUNTARY", "EMPLOYMENT_TERMINATED_FOR_CAUSE"] },
    "workflow_evidence_ref": { "type": "string" },
    "personal_tenant_response": {
      "type": "string",
      "enum": ["accepted", "refused_consent_missing", "refused_policy_block", "pending_user_review"],
      "description": "The personal-tenant can always refuse; this is the critical autonomy bit per ADR-0311"
    }
  }
}
