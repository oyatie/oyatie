{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oyatie.dev/schemas/user-journeys/j142/OffboardingWorkflow.json",
  "title": "OffboardingWorkflow",
  "type": "object",
  "_meta": {
    "doc_class": "Schema",
    "journey_id": "j142",
    "status": "draft",
    "owner": "workflow-engine",
    "consumers": ["identity", "mail", "messenger", "drive", "calendar", "payments", "meet", "tenancy", "audit-chain"],
    "adr_anchors": ["ADR-0145", "ADR-0244", "ADR-0247", "ADR-0299", "ADR-0307", "ADR-0311"]
  },
  "required": ["workflow_id", "template", "subject_principal", "actor_principal", "tenant_id", "policy_overlay", "started_at_hlc"],
  "properties": {
    "workflow_id": { "type": "string", "pattern": "^OFFB-\\d{4}-\\d{2}-\\d{2}-[a-z]+$" },
    "template": {
      "type": "string",
      "enum": [
        "rif_offboarding_us_michigan_v3",
        "rif_offboarding_us_california_v3",
        "rif_offboarding_eu_de_v3",
        "rif_offboarding_kr_v3",
        "voluntary_resignation_v2"
      ]
    },
    "subject_principal": { "type": "string", "format": "uri" },
    "actor_principal":   { "type": "string", "format": "uri" },
    "tenant_id":         { "type": "string" },
    "policy_overlay":    { "type": "string" },
    "overlay_version_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "subject_passkey_continuity_proof": {
      "type": "object",
      "description": "Per ADR-0299 — proof that the same passkey credential authenticates both work-tenant and personal-tenant principals",
      "required": ["credential_id", "signature", "algorithm"],
      "properties": {
        "credential_id": { "type": "string" },
        "signature":     { "type": "string", "contentEncoding": "base64" },
        "algorithm":     { "type": "string", "enum": ["ES256", "EdDSA"] }
      }
    },
    "scheduled_checkpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["at_offset", "action"],
        "properties": {
          "at_offset": { "type": "string", "description": "ISO8601 duration relative to workflow start (e.g., P7D, P30D)" },
          "action": { "type": "string", "enum": ["reminder", "scope_revoke", "audit_seal", "summary_emit"] }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": ["in_progress", "completed_clean", "paused_on_audit_hold", "paused_on_leave", "failed_recoverable", "failed_terminal"]
    },
    "started_at_hlc": { "type": "string" },
    "completed_at_hlc": { "type": "string" },
    "labor_law_overlays_applied": {
      "type": "array",
      "items": { "type": "string" },
      "description": "e.g., US-WARN-Act-1988, US-COBRA, MI-Payment-of-Wages-Act"
    }
  }
}
