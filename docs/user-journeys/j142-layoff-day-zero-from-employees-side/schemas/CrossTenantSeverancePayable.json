{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oyatie.com/schemas/user-journeys/j142/CrossTenantSeverancePayable.json",
  "title": "CrossTenantSeverancePayable",
  "type": "object",
  "_meta": {
    "doc_class": "Schema",
    "journey_id": "j142",
    "status": "draft",
    "owner": "payments",
    "consumers": ["finops-portal", "audit-chain", "workflow-engine", "compliance"],
    "adr_anchors": ["ADR-0145", "ADR-0244", "ADR-0311"]
  },
  "required": ["payable_id", "source_tenant_id", "dest_tenant_id", "dest_principal_account", "amount", "jurisdiction", "scheduled_for", "purpose"],
  "properties": {
    "payable_id":              { "type": "string", "pattern": "^PAY-SEV-[A-Z0-9-]+$" },
    "source_tenant_id":        { "type": "string" },
    "dest_tenant_id":          { "type": "string" },
    "dest_principal_account":  { "type": "string" },
    "amount": {
      "type": "object",
      "required": ["currency", "base_severance", "accrued_pto", "cobra_bridge", "total"],
      "properties": {
        "currency":        { "type": "string", "pattern": "^[A-Z]{3}$" },
        "base_severance":  { "type": "string", "pattern": "^\\d+\\.\\d{2}$" },
        "accrued_pto":     { "type": "string", "pattern": "^\\d+\\.\\d{2}$" },
        "cobra_bridge":    { "type": "string", "pattern": "^\\d+\\.\\d{2}$" },
        "total":           { "type": "string", "pattern": "^\\d+\\.\\d{2}$" }
      }
    },
    "jurisdiction": { "type": "string", "enum": ["US-MI", "US-CA", "US-NY", "US-TX", "EU-DE", "EU-FR", "KR", "IN", "BR", "JP"] },
    "scheduled_for":          { "type": "string", "format": "date-time" },
    "purpose":                { "const": "rif_severance" },
    "audit_chain_seal_source": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "audit_chain_seal_dest":   { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "cedar_decision_id_source": { "type": "string" },
    "cedar_decision_id_dest":   { "type": "string" },
    "settlement_status":       { "type": "string", "enum": ["queued", "ach_submitted", "settled", "failed_retry", "failed_terminal"] }
  }
}
