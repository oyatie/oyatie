{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.oyatie.com/schemas/user-journeys/j34-b2b-team-channel-with-files.schema.json",
  "title": "j34 B2B team channel with files Journey Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "journey_id",
    "tenant_id",
    "principal_id",
    "audience_type",
    "home_cell",
    "traceparent",
    "service_steps",
    "audit_events",
    "recovery_policy"
  ],
  "_meta": {
    "doc_class": "Schema",
    "version": "1.0.0",
    "status": "Accepted",
    "purpose": "Marcus creates an engineering Messenger channel, shares Drive files, and enforces per-employee membership.",
    "binding_adrs": [
      "ADR-0105",
      "ADR-0131",
      "ADR-0244",
      "ADR-0263",
      "ADR-0273",
      "ADR-0297",
      "ADR-0299",
      "ADR-0311"
    ],
    "contract_surfaces": [
      "OpenAPI 3.2.0",
      "AsyncAPI 3.1.0",
      "proto3"
    ],
    "naming": "BNF v4.1",
    "layer_model": "ADR-0105 13-layer",
    "flat_layout": "ADR-0131"
  },
  "properties": {
    "journey_id": {
      "type": "string",
      "const": "j34",
      "description": "Stable journey id.",
      "examples": [
        "j34"
      ]
    },
    "tenant_id": {
      "type": "string",
      "minLength": 3,
      "description": "ADR-0244 tenant id.",
      "examples": [
        "tenant-b2b-work"
      ]
    },
    "principal_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]{7,127}$",
      "description": "Stable human or delegated principal id.",
      "examples": [
        "principal-marcus-chen"
      ]
    },
    "audience_type": {
      "type": "string",
      "description": "ADR-0244 audience type.",
      "examples": [
        "b2b-work"
      ]
    },
    "home_cell": {
      "type": "string",
      "description": "ADR-0248 home cell.",
      "examples": [
        "ap-seoul-1",
        "us-west-2"
      ]
    },
    "traceparent": {
      "type": "string",
      "description": "W3C trace root.",
      "examples": [
        "00-11111111111111111111111111111111-2222222222222222-01"
      ]
    },
    "service_steps": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "service",
          "role",
          "contract",
          "idempotency_key"
        ],
        "properties": {
          "service": {
            "type": "string",
            "enum": [
              "messenger",
              "drive",
              "identity",
              "tenancy",
              "observability"
            ],
            "description": "Service handling step."
          },
          "role": {
            "type": "string",
            "description": "Journey role."
          },
          "contract": {
            "type": "string",
            "enum": [
              "OpenAPI 3.2.0",
              "AsyncAPI 3.1.0",
              "proto3"
            ],
            "description": "Typed surface."
          },
          "idempotency_key": {
            "type": "string",
            "minLength": 16,
            "description": "Retry key."
          }
        }
      }
    },
    "audit_events": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_class",
          "producer",
          "hlc",
          "sealed"
        ],
        "properties": {
          "event_class": {
            "type": "string",
            "description": "ADR-0263 class."
          },
          "producer": {
            "type": "string",
            "enum": [
              "messenger",
              "drive",
              "identity",
              "tenancy",
              "observability"
            ],
            "description": "Producer."
          },
          "hlc": {
            "type": "string",
            "description": "Hybrid logical clock."
          },
          "sealed": {
            "type": "boolean",
            "const": true,
            "description": "Seal required."
          }
        }
      }
    },
    "recovery_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "critical_path_rows",
        "rollback_mode",
        "user_visible_copy_key"
      ],
      "properties": {
        "critical_path_rows": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "documentation-rigor 3.2.5 rows."
        },
        "rollback_mode": {
          "type": "string",
          "enum": [
            "compensating-event",
            "idempotent-retry",
            "fail-closed"
          ],
          "description": "Recovery family."
        },
        "user_visible_copy_key": {
          "type": "string",
          "description": "Locale copy key."
        }
      }
    }
  },
  "examples": [
    {
      "journey_id": "j34",
      "tenant_id": "tenant-b2b-work",
      "principal_id": "principal-marcus-chen",
      "audience_type": "b2b-work",
      "home_cell": "us-west-2",
      "traceparent": "00-11111111111111111111111111111111-2222222222222222-01",
      "service_steps": [
        {
          "service": "messenger",
          "role": "work-channel-membership",
          "contract": "OpenAPI 3.2.0",
          "idempotency_key": "j34-messenger-0001"
        },
        {
          "service": "drive",
          "role": "channel-file-share",
          "contract": "OpenAPI 3.2.0",
          "idempotency_key": "j34-drive-0001"
        },
        {
          "service": "identity",
          "role": "employee-principal-resolve",
          "contract": "OpenAPI 3.2.0",
          "idempotency_key": "j34-identity-0001"
        },
        {
          "service": "tenancy",
          "role": "work-tenant-acl",
          "contract": "OpenAPI 3.2.0",
          "idempotency_key": "j34-tenancy-0001"
        },
        {
          "service": "observability",
          "role": "channel-file-audit",
          "contract": "OpenAPI 3.2.0",
          "idempotency_key": "j34-observability-0001"
        }
      ],
      "audit_events": [
        {
          "event_class": "j34.messenger.work-channel-membership.sealed",
          "producer": "messenger",
          "hlc": "2026-05-20T00:00:00Z/0",
          "sealed": true
        },
        {
          "event_class": "j34.drive.channel-file-share.sealed",
          "producer": "drive",
          "hlc": "2026-05-20T00:00:00Z/0",
          "sealed": true
        },
        {
          "event_class": "j34.identity.employee-principal-resolve.sealed",
          "producer": "identity",
          "hlc": "2026-05-20T00:00:00Z/0",
          "sealed": true
        },
        {
          "event_class": "j34.tenancy.work-tenant-acl.sealed",
          "producer": "tenancy",
          "hlc": "2026-05-20T00:00:00Z/0",
          "sealed": true
        },
        {
          "event_class": "j34.observability.channel-file-audit.sealed",
          "producer": "observability",
          "hlc": "2026-05-20T00:00:00Z/0",
          "sealed": true
        }
      ],
      "recovery_policy": {
        "critical_path_rows": [
          "18",
          "23",
          "25",
          "30"
        ],
        "rollback_mode": "compensating-event",
        "user_visible_copy_key": "user_journey.j34.recovery"
      }
    }
  ]
}
