{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.oyatie.com/user-journeys/j46/prescription-renewal-request.json",
  "title": "PrescriptionRenewalRequest",
  "version": "1.0.0",
  "description": "Shared journey object for j46-healthcare-prescription-renewal-workflow. It lets Yejin Park request an Rx renewal in Workflow Studio, route to a prescribing doctor, then to a pharmacy while preserving tenant scope, auditability, and cross-service status.",
  "_meta": {
    "purpose": "Bind j46-healthcare-prescription-renewal-workflow to a machine-readable object shared by all participating microservices.",
    "status": "Proposed",
    "binding_adr": "ADR-0244",
    "related_adrs": [
      "ADR-0105",
      "ADR-0131",
      "ADR-0244",
      "ADR-0263",
      "ADR-0273",
      "ADR-0292",
      "ADR-0297",
      "ADR-0299"
    ],
    "enforcement_status": "authoring-target",
    "industry_citations": [
      "Epic MyChart refill request plus pharmacy eRx routing pattern"
    ],
    "contract_surfaces": [
      "OpenAPI 3.2.0",
      "AsyncAPI 3.1.0",
      "proto3",
      "BNF v4.1",
      "ADR-0105 13-layer"
    ],
    "microservice_count_authority": 45,
    "marketplace_settlement_invariant": "marketplace-settles-all-tenant-deals",
    "schema_version": "v1.0.0"
  },
  "type": "object",
  "required": [
    "journey_id",
    "tenant_id",
    "persona",
    "locale",
    "status",
    "correlation_id",
    "service_states",
    "audit",
    "contracts"
  ],
  "properties": {
    "journey_id": {
      "const": "j46-healthcare-prescription-renewal-workflow",
      "description": "Stable journey identifier and collision guard for the j36-j50 range.",
      "examples": [
        "j46-healthcare-prescription-renewal-workflow"
      ]
    },
    "tenant_id": {
      "type": "string",
      "description": "Tenant scope required by ADR-0244; every service must persist or forward it unchanged.",
      "examples": [
        "yejin-personal-health"
      ]
    },
    "persona": {
      "const": "Yejin Park",
      "description": "The named persona whose continuity is preserved across the journey.",
      "examples": [
        "Yejin Park"
      ]
    },
    "locale": {
      "const": "ko-KR",
      "description": "Locale used for UX, notices, and regulated language variants.",
      "examples": [
        "ko-KR"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "waiting_on_human",
        "waiting_on_provider",
        "completed",
        "compensated",
        "denied"
      ],
      "description": "Journey state machine status observed by UX and tests.",
      "examples": [
        "completed"
      ]
    },
    "correlation_id": {
      "type": "string",
      "pattern": "^journey-j[0-9]{2}-[a-z0-9-]+$",
      "description": "Idempotency and trace correlation key shared by OpenAPI, AsyncAPI, and proto3 surfaces.",
      "examples": [
        "journey-j46-healthcare-prescription-renewal-workflow"
      ]
    },
    "service_states": {
      "type": "object",
      "description": "Per-service status map; keys match the flat microservice path names used by ADR-0131.",
      "required": [
        "workflow_studio",
        "workflow_engine",
        "mail",
        "identity",
        "connect",
        "compliance"
      ],
      "properties": {
        "workflow_studio": {
          "type": "object",
          "description": "workflow-studio owns the rx-renewal-template role for this journey and records the status it contributes to the shared object.",
          "required": [
            "role",
            "status",
            "audit_event_class"
          ],
          "properties": {
            "role": {
              "const": "rx-renewal-template",
              "description": "The workflow-studio role in the journey handshake.",
              "examples": [
                "rx-renewal-template"
              ]
            },
            "status": {
              "type": "string",
              "enum": [
                "pending",
                "permitted",
                "denied",
                "degraded",
                "completed",
                "compensated"
              ],
              "description": "Typed service status used by the integration test plan and audit envelope.",
              "examples": [
                "completed"
              ]
            },
            "audit_event_class": {
              "type": "string",
              "description": "ADR-0263 audit event class emitted by this service when the status changes.",
              "examples": [
                "Journey46WorkflowStudioRxRenewalTemplateCommitted"
              ]
            }
          },
          "additionalProperties": false
        },
        "workflow_engine": {
          "type": "object",
          "description": "workflow-engine owns the prescriber-routing role for this journey and records the status it contributes to the shared object.",
          "required": [
            "role",
            "status",
            "audit_event_class"
          ],
          "properties": {
            "role": {
              "const": "prescriber-routing",
              "description": "The workflow-engine role in the journey handshake.",
              "examples": [
                "prescriber-routing"
              ]
            },
            "status": {
              "type": "string",
              "enum": [
                "pending",
                "permitted",
                "denied",
                "degraded",
                "completed",
                "compensated"
              ],
              "description": "Typed service status used by the integration test plan and audit envelope.",
              "examples": [
                "completed"
              ]
            },
            "audit_event_class": {
              "type": "string",
              "description": "ADR-0263 audit event class emitted by this service when the status changes.",
              "examples": [
                "Journey46WorkflowEnginePrescriberRoutingCommitted"
              ]
            }
          },
          "additionalProperties": false
        },
        "mail": {
          "type": "object",
          "description": "mail owns the rx-status-messaging role for this journey and records the status it contributes to the shared object.",
          "required": [
            "role",
            "status",
            "audit_event_class"
          ],
          "properties": {
            "role": {
              "const": "rx-status-messaging",
              "description": "The mail role in the journey handshake.",
              "examples": [
                "rx-status-messaging"
              ]
            },
            "status": {
              "type": "string",
              "enum": [
                "pending",
                "permitted",
                "denied",
                "degraded",
                "completed",
                "compensated"
              ],
              "description": "Typed service status used by the integration test plan and audit envelope.",
              "examples": [
                "completed"
              ]
            },
            "audit_event_class": {
              "type": "string",
              "description": "ADR-0263 audit event class emitted by this service when the status changes.",
              "examples": [
                "Journey46MailRxStatusMessagingCommitted"
              ]
            }
          },
          "additionalProperties": false
        },
        "identity": {
          "type": "object",
          "description": "identity owns the patient-prescriber-resolution role for this journey and records the status it contributes to the shared object.",
          "required": [
            "role",
            "status",
            "audit_event_class"
          ],
          "properties": {
            "role": {
              "const": "patient-prescriber-resolution",
              "description": "The identity role in the journey handshake.",
              "examples": [
                "patient-prescriber-resolution"
              ]
            },
            "status": {
              "type": "string",
              "enum": [
                "pending",
                "permitted",
                "denied",
                "degraded",
                "completed",
                "compensated"
              ],
              "description": "Typed service status used by the integration test plan and audit envelope.",
              "examples": [
                "completed"
              ]
            },
            "audit_event_class": {
              "type": "string",
              "description": "ADR-0263 audit event class emitted by this service when the status changes.",
              "examples": [
                "Journey46IdentityPatientPrescriberResolutionCommitted"
              ]
            }
          },
          "additionalProperties": false
        },
        "connect": {
          "type": "object",
          "description": "connect owns the pharmacy-adapter role for this journey and records the status it contributes to the shared object.",
          "required": [
            "role",
            "status",
            "audit_event_class"
          ],
          "properties": {
            "role": {
              "const": "pharmacy-adapter",
              "description": "The connect role in the journey handshake.",
              "examples": [
                "pharmacy-adapter"
              ]
            },
            "status": {
              "type": "string",
              "enum": [
                "pending",
                "permitted",
                "denied",
                "degraded",
                "completed",
                "compensated"
              ],
              "description": "Typed service status used by the integration test plan and audit envelope.",
              "examples": [
                "completed"
              ]
            },
            "audit_event_class": {
              "type": "string",
              "description": "ADR-0263 audit event class emitted by this service when the status changes.",
              "examples": [
                "Journey46ConnectPharmacyAdapterCommitted"
              ]
            }
          },
          "additionalProperties": false
        },
        "compliance": {
          "type": "object",
          "description": "compliance owns the rx-overlay role for this journey and records the status it contributes to the shared object.",
          "required": [
            "role",
            "status",
            "audit_event_class"
          ],
          "properties": {
            "role": {
              "const": "rx-overlay",
              "description": "The compliance role in the journey handshake.",
              "examples": [
                "rx-overlay"
              ]
            },
            "status": {
              "type": "string",
              "enum": [
                "pending",
                "permitted",
                "denied",
                "degraded",
                "completed",
                "compensated"
              ],
              "description": "Typed service status used by the integration test plan and audit envelope.",
              "examples": [
                "completed"
              ]
            },
            "audit_event_class": {
              "type": "string",
              "description": "ADR-0263 audit event class emitted by this service when the status changes.",
              "examples": [
                "Journey46ComplianceRxOverlayCommitted"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "audit": {
      "type": "object",
      "description": "ADR-0263 audit envelope shared by all service transitions.",
      "required": [
        "audit_id",
        "trace_id",
        "event_classes",
        "sealed_at"
      ],
      "properties": {
        "audit_id": {
          "type": "string",
          "description": "Audit-chain identifier.",
          "examples": [
            "aud-j46-001"
          ]
        },
        "trace_id": {
          "type": "string",
          "description": "Distributed trace id for observability.",
          "examples": [
            "trace-j46-hero"
          ]
        },
        "event_classes": {
          "type": "array",
          "description": "Audit event classes emitted during this journey.",
          "items": {
            "type": "string"
          },
          "minItems": 6,
          "examples": [
            [
              "Journey46WorkflowStudioRxRenewalTemplateCommitted",
              "Journey46WorkflowEnginePrescriberRoutingCommitted",
              "Journey46MailRxStatusMessagingCommitted",
              "Journey46IdentityPatientPrescriberResolutionCommitted",
              "Journey46ConnectPharmacyAdapterCommitted",
              "Journey46ComplianceRxOverlayCommitted"
            ]
          ]
        },
        "sealed_at": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when the final audit bundle was sealed.",
          "examples": [
            "2026-06-01T12:00:00Z"
          ]
        }
      },
      "additionalProperties": false
    },
    "contracts": {
      "type": "array",
      "description": "Contract surface names that must remain in sync for this journey.",
      "items": {
        "type": "string",
        "enum": [
          "OpenAPI 3.2.0",
          "AsyncAPI 3.1.0",
          "proto3",
          "BNF v4.1",
          "ADR-0105 13-layer"
        ]
      },
      "minItems": 5,
      "examples": [
        [
          "OpenAPI 3.2.0",
          "AsyncAPI 3.1.0",
          "proto3",
          "BNF v4.1",
          "ADR-0105 13-layer"
        ]
      ]
    }
  },
  "additionalProperties": false
}
