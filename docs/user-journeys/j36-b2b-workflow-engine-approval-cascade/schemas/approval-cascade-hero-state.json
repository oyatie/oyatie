{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.oyatie.dev/user-journeys/j36/approval-cascade-hero-state.json",
  "title": "ApprovalCascadeHeroState",
  "version": "1.0.0",
  "description": "Shared journey object for j36-b2b-workflow-engine-approval-cascade. It lets Marcus Chen route an expense request through three managers and schedule payment through Stripe Connect while preserving tenant scope, auditability, and cross-service status.",
  "_meta": {
    "purpose": "Bind j36-b2b-workflow-engine-approval-cascade to a machine-readable object shared by all participating microservices.",
    "status": "Proposed",
    "binding_adr": "ADR-0244",
    "related_adrs": [
      "ADR-0105",
      "ADR-0131",
      "ADR-0244",
      "ADR-0263",
      "ADR-0273",
      "ADR-0292",
      "ADR-0297",
      "ADR-0299"
    ],
    "enforcement_status": "authoring-target",
    "industry_citations": [
      "Temporal approval workflow plus Stripe Connect platform-facilitator pattern"
    ],
    "contract_surfaces": [
      "OpenAPI 3.2.0",
      "AsyncAPI 3.1.0",
      "proto3",
      "BNF v4.1",
      "ADR-0105 13-layer"
    ],
    "microservice_count_authority": 45,
    "marketplace_settlement_invariant": "marketplace-settles-all-tenant-deals",
    "schema_version": "v1.0.0"
  },
  "type": "object",
  "required": [
    "journey_id",
    "tenant_id",
    "persona",
    "locale",
    "status",
    "correlation_id",
    "service_states",
    "audit",
    "contracts"
  ],
  "properties": {
    "journey_id": {
      "const": "j36-b2b-workflow-engine-approval-cascade",
      "description": "Stable journey identifier and collision guard for the j36-j50 range.",
      "examples": [
        "j36-b2b-workflow-engine-approval-cascade"
      ]
    },
    "tenant_id": {
      "type": "string",
      "description": "Tenant scope required by ADR-0244; every service must persist or forward it unchanged.",
      "examples": [
        "acme-b2b"
      ]
    },
    "persona": {
      "const": "Marcus Chen",
      "description": "The named persona whose continuity is preserved across the journey.",
      "examples": [
        "Marcus Chen"
      ]
    },
    "locale": {
      "const": "en-US",
      "description": "Locale used for UX, notices, and regulated language variants.",
      "examples": [
        "en-US"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "waiting_on_human",
        "waiting_on_provider",
        "completed",
        "compensated",
        "denied"
      ],
      "description": "Journey state machine status observed by UX and tests.",
      "examples": [
        "completed"
      ]
    },
    "correlation_id": {
      "type": "string",
      "pattern": "^journey-j[0-9]{2}-[a-z0-9-]+$",
      "description": "Idempotency and trace correlation key shared by OpenAPI, AsyncAPI, and proto3 surfaces.",
      "examples": [
        "journey-j36-b2b-workflow-engine-approval-cascade"
      ]
    },
    "service_states": {
      "type": "object",
      "description": "Per-service status map; keys match the flat microservice path names used by ADR-0131.",
      "required": [
        "workflow_engine",
        "workflow_studio",
        "payments",
        "mail",
        "identity"
      ],
      "properties": {
        "workflow_engine": {
          "type": "object",
          "description": "workflow-engine owns the approval-cascade-runtime role for this journey and records the status it contributes to the shared object.",
          "required": [
            "role",
            "status",
            "audit_event_class"
          ],
          "properties": {
            "role": {
              "const": "approval-cascade-runtime",
              "description": "The workflow-engine role in the journey handshake.",
              "examples": [
                "approval-cascade-runtime"
              ]
            },
            "status": {
              "type": "string",
              "enum": [
                "pending",
                "permitted",
                "denied",
                "degraded",
                "completed",
                "compensated"
              ],
              "description": "Typed service status used by the integration test plan and audit envelope.",
              "examples": [
                "completed"
              ]
            },
            "audit_event_class": {
              "type": "string",
              "description": "ADR-0263 audit event class emitted by this service when the status changes.",
              "examples": [
                "Journey36WorkflowEngineApprovalCascadeRuntimeCommitted"
              ]
            }
          },
          "additionalProperties": false
        },
        "workflow_studio": {
          "type": "object",
          "description": "workflow-studio owns the manager-review-console role for this journey and records the status it contributes to the shared object.",
          "required": [
            "role",
            "status",
            "audit_event_class"
          ],
          "properties": {
            "role": {
              "const": "manager-review-console",
              "description": "The workflow-studio role in the journey handshake.",
              "examples": [
                "manager-review-console"
              ]
            },
            "status": {
              "type": "string",
              "enum": [
                "pending",
                "permitted",
                "denied",
                "degraded",
                "completed",
                "compensated"
              ],
              "description": "Typed service status used by the integration test plan and audit envelope.",
              "examples": [
                "completed"
              ]
            },
            "audit_event_class": {
              "type": "string",
              "description": "ADR-0263 audit event class emitted by this service when the status changes.",
              "examples": [
                "Journey36WorkflowStudioManagerReviewConsoleCommitted"
              ]
            }
          },
          "additionalProperties": false
        },
        "payments": {
          "type": "object",
          "description": "payments owns the stripe-connect-auto-pay role for this journey and records the status it contributes to the shared object.",
          "required": [
            "role",
            "status",
            "audit_event_class"
          ],
          "properties": {
            "role": {
              "const": "stripe-connect-auto-pay",
              "description": "The payments role in the journey handshake.",
              "examples": [
                "stripe-connect-auto-pay"
              ]
            },
            "status": {
              "type": "string",
              "enum": [
                "pending",
                "permitted",
                "denied",
                "degraded",
                "completed",
                "compensated"
              ],
              "description": "Typed service status used by the integration test plan and audit envelope.",
              "examples": [
                "completed"
              ]
            },
            "audit_event_class": {
              "type": "string",
              "description": "ADR-0263 audit event class emitted by this service when the status changes.",
              "examples": [
                "Journey36PaymentsStripeConnectAutoPayCommitted"
              ]
            }
          },
          "additionalProperties": false
        },
        "mail": {
          "type": "object",
          "description": "mail owns the approval-notification-thread role for this journey and records the status it contributes to the shared object.",
          "required": [
            "role",
            "status",
            "audit_event_class"
          ],
          "properties": {
            "role": {
              "const": "approval-notification-thread",
              "description": "The mail role in the journey handshake.",
              "examples": [
                "approval-notification-thread"
              ]
            },
            "status": {
              "type": "string",
              "enum": [
                "pending",
                "permitted",
                "denied",
                "degraded",
                "completed",
                "compensated"
              ],
              "description": "Typed service status used by the integration test plan and audit envelope.",
              "examples": [
                "completed"
              ]
            },
            "audit_event_class": {
              "type": "string",
              "description": "ADR-0263 audit event class emitted by this service when the status changes.",
              "examples": [
                "Journey36MailApprovalNotificationThreadCommitted"
              ]
            }
          },
          "additionalProperties": false
        },
        "identity": {
          "type": "object",
          "description": "identity owns the manager-role-resolution role for this journey and records the status it contributes to the shared object.",
          "required": [
            "role",
            "status",
            "audit_event_class"
          ],
          "properties": {
            "role": {
              "const": "manager-role-resolution",
              "description": "The identity role in the journey handshake.",
              "examples": [
                "manager-role-resolution"
              ]
            },
            "status": {
              "type": "string",
              "enum": [
                "pending",
                "permitted",
                "denied",
                "degraded",
                "completed",
                "compensated"
              ],
              "description": "Typed service status used by the integration test plan and audit envelope.",
              "examples": [
                "completed"
              ]
            },
            "audit_event_class": {
              "type": "string",
              "description": "ADR-0263 audit event class emitted by this service when the status changes.",
              "examples": [
                "Journey36IdentityManagerRoleResolutionCommitted"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "audit": {
      "type": "object",
      "description": "ADR-0263 audit envelope shared by all service transitions.",
      "required": [
        "audit_id",
        "trace_id",
        "event_classes",
        "sealed_at"
      ],
      "properties": {
        "audit_id": {
          "type": "string",
          "description": "Audit-chain identifier.",
          "examples": [
            "aud-j36-001"
          ]
        },
        "trace_id": {
          "type": "string",
          "description": "Distributed trace id for observability.",
          "examples": [
            "trace-j36-hero"
          ]
        },
        "event_classes": {
          "type": "array",
          "description": "Audit event classes emitted during this journey.",
          "items": {
            "type": "string"
          },
          "minItems": 5,
          "examples": [
            [
              "Journey36WorkflowEngineApprovalCascadeRuntimeCommitted",
              "Journey36WorkflowStudioManagerReviewConsoleCommitted",
              "Journey36PaymentsStripeConnectAutoPayCommitted",
              "Journey36MailApprovalNotificationThreadCommitted",
              "Journey36IdentityManagerRoleResolutionCommitted"
            ]
          ]
        },
        "sealed_at": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when the final audit bundle was sealed.",
          "examples": [
            "2026-06-01T12:00:00Z"
          ]
        }
      },
      "additionalProperties": false
    },
    "contracts": {
      "type": "array",
      "description": "Contract surface names that must remain in sync for this journey.",
      "items": {
        "type": "string",
        "enum": [
          "OpenAPI 3.2.0",
          "AsyncAPI 3.1.0",
          "proto3",
          "BNF v4.1",
          "ADR-0105 13-layer"
        ]
      },
      "minItems": 5,
      "examples": [
        [
          "OpenAPI 3.2.0",
          "AsyncAPI 3.1.0",
          "proto3",
          "BNF v4.1",
          "ADR-0105 13-layer"
        ]
      ]
    }
  },
  "additionalProperties": false
}
