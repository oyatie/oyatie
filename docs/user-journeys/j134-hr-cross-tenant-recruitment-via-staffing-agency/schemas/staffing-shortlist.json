{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oyatie.dev/schemas/j134/staffing-shortlist.json",
  "title": "StaffingShortlist",
  "type": "object",
  "_meta": {
    "doc_class": "User-Journey-Schema",
    "journey_id": "j134-hr-cross-tenant-recruitment-via-staffing-agency",
    "version": "1.0.0",
    "owners": ["community", "workflow-engine"]
  },
  "required": ["shortlist_id", "engagement_id", "req_id", "candidates", "posted_at", "posted_by_agency_tenant_id"],
  "properties": {
    "shortlist_id": {"type": "string", "format": "uuid"},
    "engagement_id": {"type": "string"},
    "req_id": {"type": "string"},
    "posted_at": {"type": "string", "format": "date-time"},
    "posted_by_agency_tenant_id": {"type": "string"},
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["candidate_pseudo_id_in_agency_tenant", "name_with_consent", "asked_salary", "availability"],
        "properties": {
          "candidate_pseudo_id_in_agency_tenant": {"type": "string"},
          "name_with_consent": {"type": "string"},
          "resume_drive_ref_in_agency_tenant": {"type": "string"},
          "agency_evaluation_notes": {"type": "string"},
          "asked_salary": {"type": "object"},
          "availability": {"type": "object", "properties": {"earliest_start_date": {"type": "string", "format": "date"}, "notice_period_weeks": {"type": "number"}}},
          "personal_tenant_principal_visible_to_employer": {"type": "boolean", "const": false, "description": "Per ADR-0311; employer sees agency-shared candidate metadata only"}
        }
      }
    }
  }
}
