{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oyatie.dev/schemas/j134/placement-fee-disbursement.json",
  "title": "PlacementFeeDisbursement",
  "type": "object",
  "_meta": {
    "doc_class": "User-Journey-Schema",
    "journey_id": "j134-hr-cross-tenant-recruitment-via-staffing-agency",
    "version": "1.0.0",
    "owners": ["payments"]
  },
  "required": ["disbursement_id", "engagement_id", "placed_candidate_principal", "fee_amount", "fee_currency", "candidate_start_date", "candidate_employment_status_at_90d", "stripe_connect_payment_intent_id"],
  "properties": {
    "disbursement_id": {"type": "string", "format": "uuid"},
    "engagement_id": {"type": "string"},
    "placed_candidate_principal": {"type": "string"},
    "fee_amount": {"type": "number", "minimum": 0},
    "fee_currency": {"type": "string"},
    "fee_percentage": {"type": "number"},
    "candidate_salary_base": {"type": "number"},
    "candidate_start_date": {"type": "string", "format": "date"},
    "disbursement_scheduled_at": {"type": "string", "format": "date-time"},
    "disbursement_completed_at": {"type": "string", "format": "date-time"},
    "stripe_connect_payment_intent_id": {"type": "string"},
    "candidate_employment_status_at_90d": {
      "type": "string",
      "enum": ["still_employed", "departed_voluntary", "departed_involuntary", "pending_check"]
    },
    "replacement_guarantee_invoked": {"type": "boolean"},
    "replacement_guarantee_refund_amount": {"type": "number"}
  }
}
