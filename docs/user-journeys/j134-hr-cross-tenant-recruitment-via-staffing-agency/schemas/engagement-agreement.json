{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oyatie.dev/schemas/j134/engagement-agreement.json",
  "title": "EngagementAgreement",
  "type": "object",
  "_meta": {
    "doc_class": "User-Journey-Schema",
    "journey_id": "j134-hr-cross-tenant-recruitment-via-staffing-agency",
    "version": "1.0.0",
    "owners": ["workplace-integration", "community"],
    "related_adrs": ["ADR-0311", "ADR-0244", "ADR-0249"]
  },
  "required": ["engagement_id", "employer_tenant_id", "staffing_agency_tenant_id", "engagement_period", "placement_fee_terms", "replacement_guarantee_terms", "data_sharing_terms", "signed_at"],
  "properties": {
    "engagement_id": {"type": "string", "format": "uuid"},
    "employer_tenant_id": {"type": "string"},
    "staffing_agency_tenant_id": {"type": "string"},
    "engagement_period": {
      "type": "object",
      "properties": {
        "starts_at": {"type": "string", "format": "date-time"},
        "ends_at": {"type": "string", "format": "date-time"}
      }
    },
    "scoped_reqs": {
      "type": "array",
      "items": {"type": "string"}
    },
    "placement_fee_terms": {
      "type": "object",
      "properties": {
        "fee_percentage": {"type": "number", "minimum": 0, "maximum": 1},
        "fee_due_on": {"type": "string", "enum": ["candidate_start_date", "offer_sign_date", "monthly"]},
        "currency": {"type": "string"}
      }
    },
    "replacement_guarantee_terms": {
      "type": "object",
      "properties": {
        "guarantee_window_days": {"type": "integer", "minimum": 0},
        "refund_percentage": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "data_sharing_terms": {
      "type": "object",
      "properties": {
        "agency_reads": {"type": "array", "items": {"type": "string"}, "description": "e.g., ['req_detail', 'offer_salary_for_fee_calc', 'employment_status_at_90d']"},
        "agency_does_NOT_read": {"type": "array", "items": {"type": "string"}, "description": "e.g., ['marcus_internal_messenger', 'marcus_internal_mail', 'salary_structures_of_existing_employees']"}
      }
    },
    "stripe_connect_escrow_account": {"type": "string"},
    "signed_at": {"type": "string", "format": "date-time"},
    "audit_chain_seal": {"type": "string"}
  }
}
