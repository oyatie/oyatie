{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oyatie.dev/schemas/gdpr/dsar-portability-export-v1.json",
  "title": "GDPR Art 20 Portability Bundle Manifest",
  "type": "object",
  "_meta": {
    "doc_class": "DsarPortabilityBundleManifest",
    "binding_adr": "ADR-0251",
    "binding_article": "GDPR Art 20",
    "media_type_root": "application/ld+json",
    "package_format": "ZIP with JSON-LD manifest + per-tenant directories + intelligence + ROPA + audit-chain-attestation"
  },
  "required": ["bundle_id", "subject_id", "generated_at", "expires_at", "manifest_signature", "audit_chain_root_at_generation", "per_tenant_bundles", "intelligence_bundle", "ropa_bundle", "audit_chain_attestation"],
  "properties": {
    "bundle_id": {"type": "string", "format": "uuid"},
    "subject_id": {"type": "string"},
    "dsar_id": {"type": "string"},
    "generated_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time", "description": "14d expiry; replayable from audit-event log"},
    "manifest_signature": {
      "type": "object",
      "required": ["signing_key_ref", "signature"],
      "properties": {
        "signing_key_ref": {"type": "string", "example": "oyatie-eu-sovereign-bundle-signing-key-v3"},
        "signature": {"type": "string", "format": "base64"}
      }
    },
    "audit_chain_root_at_generation": {"type": "string", "description": "Merkle root the bundle is anchored to"},
    "per_tenant_bundles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["tenant_id", "files"],
        "properties": {
          "tenant_id": {"type": "string"},
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["path", "sha256", "size_bytes", "data_class", "schema"],
              "properties": {
                "path": {"type": "string"},
                "sha256": {"type": "string"},
                "size_bytes": {"type": "integer", "minimum": 0},
                "data_class": {"type": "string", "enum": ["PI_EU_GDPR", "DERIVED_EU_GDPR", "ROPA_EU_GDPR"]},
                "schema": {"type": "string", "format": "uri"}
              }
            }
          }
        }
      }
    },
    "intelligence_bundle": {
      "type": "object",
      "properties": {
        "cohort_membership": {"type": "string", "description": "Path within bundle"},
        "feature_vector_derived": {"type": "string"},
        "per_class_metric_disclosure": {"type": "string"},
        "model_card_link": {"type": "string", "format": "uri"}
      }
    },
    "ropa_bundle": {
      "type": "object",
      "properties": {
        "art_30_records": {"type": "string"},
        "pseudonymized": {"type": "boolean", "const": true}
      }
    },
    "audit_chain_attestation": {
      "type": "object",
      "required": ["merkle_proof", "transparency_log_ref"],
      "properties": {
        "merkle_proof": {"type": "string"},
        "transparency_log_ref": {"type": "string", "example": "rekor://oyatie-eu-dsar-2026-05-31-001"}
      }
    }
  }
}
