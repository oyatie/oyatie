{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oyatie.com/schemas/gdpr/dsar-audit-event-cascade-v1.json",
  "title": "GDPR DSAR Audit Event Cascade",
  "_meta": {
    "doc_class": "AuditEventCascade",
    "binding_adr": "ADR-0263",
    "binding_seal_adr": "ADR-0028",
    "retention_min": "P6Y",
    "pack_overlay": "pack-eu-gdpr-2018-baseline"
  },
  "type": "object",
  "required": ["dsar_id", "events"],
  "properties": {
    "dsar_id": {"type": "string"},
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["event_class", "timestamp_hlc", "tenant_id", "principal_id", "cedar_decision", "seal"],
        "properties": {
          "event_class": {"type": "string", "enum": [
            "DsarReceived",
            "DsarSubjectResolved",
            "DsarWorkflowStarted",
            "DsarAckSent",
            "DsarIdentityRead",
            "DsarTenancyRead",
            "DsarConsentRead",
            "DsarMailRead",
            "DsarCalendarRead",
            "DsarMessengerRead",
            "DsarOntologyRead",
            "DsarIntelligenceCohortRead",
            "DsarIntelligenceCohortErased",
            "DsarAuditRead",
            "DsarGovernanceRead",
            "DsarComplianceRead",
            "DsarBundleAssembled",
            "DsarBundleSigned",
            "DsarBundleAvailable",
            "Art22ObjectionFiled",
            "IntelligenceScorerDisabledForSubject",
            "Art22ReviewerAssigned",
            "Art22VerdictIssued",
            "DsarErasureCompletePrimary",
            "DsarErasureCompleteTapeRotation",
            "DsarClosed",
            "CellPinningViolation",
            "DsarSubflowTimeoutPartial",
            "DsarDrainedAtCellMigration"
          ]},
          "timestamp_hlc": {"type": "string", "description": "Hybrid Logical Clock per ADR-0252"},
          "tenant_id": {"type": "string"},
          "principal_id": {"type": "string"},
          "cedar_decision": {"type": "object", "properties": {"fragment_id": {"type": "string"}, "decision": {"type": "string", "enum": ["permit", "forbid"]}, "evaluator_version": {"type": "string"}}},
          "seal": {"type": "object", "required": ["merkle_root", "tlog_ref"], "properties": {"merkle_root": {"type": "string"}, "tlog_ref": {"type": "string"}}},
          "payload_digest": {"type": "string", "description": "sha256 of canonical-JSON payload"}
        }
      }
    },
    "merkle_root_at_close": {"type": "string"},
    "expected_event_count": {"type": "integer", "description": "11 fan-out + 6 envelope = 17 minimum; appeal adds 3 more"}
  }
}
