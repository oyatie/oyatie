{
  "openapi": "3.2.0",
  "info": {
    "title": "GDPR DSAR Submission",
    "version": "1.0.0",
    "description": "Schema for submitting an Art 15/16/17/20/21/22 DSAR. Subject-authenticated via WebAuthn; cell-pinned to eu-sovereign per ADR-0251 §D-4."
  },
  "components": {
    "schemas": {
      "DsarRequest": {
        "type": "object",
        "required": ["subject_id", "rights_invoked", "tenants_in_scope", "authentication_assertion"],
        "properties": {
          "subject_id": {
            "type": "string",
            "format": "subject-principal-uri",
            "example": "anya@oyatie.me"
          },
          "rights_invoked": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["art15", "art16", "art17", "art20", "art21", "art22"]
            },
            "minItems": 1
          },
          "tenants_in_scope": {
            "type": "array",
            "items": {"type": "string", "format": "tenant-uri"},
            "minItems": 1
          },
          "authentication_assertion": {
            "type": "object",
            "required": ["method", "credential_id"],
            "properties": {
              "method": {"type": "string", "enum": ["webauthn"]},
              "credential_id": {"type": "string"},
              "assertion": {"type": "string", "description": "WebAuthn assertion JSON"}
            }
          },
          "delivery_preference": {
            "type": "object",
            "properties": {
              "channel": {"type": "string", "enum": ["mail", "in-app", "both"], "default": "both"},
              "locale": {"type": "string", "default": "de-DE"}
            }
          },
          "complex_request_extension_requested": {
            "type": "boolean",
            "default": false,
            "description": "If true and substrate determines complexity, Art 12(3) extension to 3 months may be granted with reason."
          },
          "_meta": {
            "type": "object",
            "properties": {
              "doc_class": {"const": "DsarRequest"},
              "binding_adr": {"const": "ADR-0251"},
              "pack_overlay": {"const": "pack-eu-gdpr-2018-baseline"},
              "cell_certification_required": {"const": "eu-sovereign"}
            }
          }
        }
      }
    }
  },
  "paths": {
    "/api/v1/gdpr/dsar": {
      "post": {
        "summary": "Submit a GDPR DSAR",
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"$ref": "#/components/schemas/DsarRequest"}}}
        },
        "responses": {
          "200": {"description": "DSAR accepted", "content": {"application/json": {"schema": {"type": "object", "properties": {"dsar_id": {"type": "string"}, "deadline": {"type": "string", "format": "date-time"}}}}}},
          "403": {"description": "Cell pinning violation or Cedar deny"},
          "429": {"description": "Rate limit (per ADR-0297, but DSAR submission is whitelisted)"}
        }
      }
    }
  }
}
