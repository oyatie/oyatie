{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oyatie.com/schemas/gdpr/article-22-appeal-v1.json",
  "title": "GDPR Article 22 Appeal Request",
  "type": "object",
  "_meta": {
    "doc_class": "Article22AppealRequest",
    "binding_adr": "ADR-0251",
    "binding_article": "GDPR Art 22",
    "human_review_required": true
  },
  "required": ["appeal_id", "dsar_id", "subject_id", "decision_under_appeal", "filed_at", "human_review_deadline"],
  "properties": {
    "appeal_id": {"type": "string", "format": "uuid"},
    "dsar_id": {"type": "string"},
    "subject_id": {"type": "string"},
    "decision_under_appeal": {
      "type": "object",
      "required": ["decision_id", "scorer_id", "decision_class", "applied_at", "effect"],
      "properties": {
        "decision_id": {"type": "string"},
        "scorer_id": {"type": "string", "example": "intelligence-engagement-scorer-v3"},
        "decision_class": {"type": "string", "enum": ["throttle", "ranking", "eligibility", "credit-limit", "content-moderation"]},
        "applied_at": {"type": "string", "format": "date-time"},
        "effect": {"type": "string", "description": "Plain-language description of what changed for the subject"},
        "explanation": {
          "type": "object",
          "description": "Per Art 22 + ADR-0255 §D-12 explainability",
          "properties": {
            "input_features": {"type": "array", "items": {"type": "object", "properties": {"name": {"type": "string"}, "value": {"oneOf": [{"type": "number"}, {"type": "string"}, {"type": "boolean"}]}, "weight": {"type": "number"}}}},
            "model_type": {"type": "string"},
            "threshold": {"type": "number"},
            "subject_score": {"type": "number"},
            "excluded_features_by_law": {"type": "array", "items": {"type": "string"}}
          }
        }
      }
    },
    "filed_at": {"type": "string", "format": "date-time"},
    "human_review_deadline": {"type": "string", "format": "date-time", "description": "Inherits the DSAR deadline (Art 12(3))"},
    "interim_remediation": {"type": "string", "enum": ["scorer_disabled_for_subject_pending_review", "no_interim", "manual_review_override"]},
    "reviewer_assigned": {"type": "string", "description": "Anonymized rota slot, e.g., council-legal-eu-rota-2026-Q2-3"},
    "verdict": {
      "type": "object",
      "properties": {
        "decision": {"type": "string", "enum": ["upheld", "overturned", "partial-remediation"]},
        "rationale": {"type": "string"},
        "verdict_at": {"type": "string", "format": "date-time"},
        "platform_wide_remediation_ref": {"type": "string", "description": "If the appeal exposed a platform defect, the remediation INC- id"}
      }
    }
  }
}
