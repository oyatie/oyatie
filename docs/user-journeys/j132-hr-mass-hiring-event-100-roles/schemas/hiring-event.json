{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oyatie.dev/schemas/j132/hiring-event.json",
  "title": "HiringEvent",
  "type": "object",
  "_meta": {
    "doc_class": "User-Journey-Schema",
    "journey_id": "j132-hr-mass-hiring-event-100-roles",
    "version": "1.0.0",
    "status": "draft",
    "owners": ["workflow-engine", "compliance"],
    "related_adrs": ["ADR-0311", "ADR-0308", "ADR-0244", "ADR-0292"]
  },
  "required": ["event_id", "tenant_id", "requested_by", "requested_at", "requisitions", "compliance_pack_overlays", "fairness_gate_active"],
  "properties": {
    "event_id": {
      "type": "string",
      "pattern": "^HIRE-EVENT-[0-9]{4}-Q[1-4]$",
      "description": "Stable hiring event identifier"
    },
    "tenant_id": {
      "type": "string",
      "description": "Owning tenant (Marcus's tenant in j132)"
    },
    "requested_by": {
      "type": "string",
      "description": "Principal who opened the headcount requisition (Marcus)"
    },
    "requested_at": {
      "type": "string",
      "format": "date-time"
    },
    "activated_by": {
      "type": "string",
      "description": "Principal who activated the event (Priya); set on activation"
    },
    "activated_at": {
      "type": "string",
      "format": "date-time"
    },
    "requisitions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5000,
      "items": {
        "type": "object",
        "required": ["req_id", "function", "level", "jurisdiction", "compliance_overlay_version", "salary_band"],
        "properties": {
          "req_id": {"type": "string"},
          "function": {"type": "string", "enum": ["SWE", "PM", "DS", "SRE", "EM", "DESIGN", "RESEARCH", "OPS", "HR", "FINANCE"]},
          "level": {"type": "string", "enum": ["I", "II", "III", "IV", "V", "STAFF", "PRINCIPAL", "DIRECTOR"]},
          "jurisdiction": {"type": "string", "enum": ["IN-BLR", "US-AUS", "DE-BER", "KR-SEO"]},
          "compliance_overlay_version": {"type": "string", "description": "Hash-pinned overlay version at activation time"},
          "salary_band": {
            "type": "object",
            "required": ["currency", "min", "max"],
            "properties": {
              "currency": {"type": "string", "enum": ["INR", "USD", "EUR", "KRW"]},
              "min": {"type": "number", "minimum": 0},
              "max": {"type": "number", "minimum": 0}
            }
          },
          "status": {"type": "string", "enum": ["awaiting_hr_activation", "active", "closed_filled", "closed_unfilled", "withdrawn"]}
        }
      }
    },
    "compliance_pack_overlays": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "jurisdiction": {"type": "string"},
          "pack_id": {"type": "string"},
          "pack_version": {"type": "string"}
        }
      }
    },
    "fairness_gate_active": {
      "type": "boolean",
      "const": true,
      "description": "Always true for EU-AI-Act covered events"
    },
    "ai_screening_model_ref": {
      "type": "string",
      "description": "Model reference; required when fairness_gate_active",
      "pattern": "^oyatie:intelligence:model:[a-z0-9-]+:v[0-9]+$"
    },
    "eu_ai_act_conformity_certificate": {
      "type": "string",
      "description": "BNetzA or equivalent certificate ID"
    }
  }
}
