{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oyatie.com/schemas/j132/offer-letter.json",
  "title": "OfferLetter",
  "type": "object",
  "_meta": {
    "doc_class": "User-Journey-Schema",
    "journey_id": "j132-hr-mass-hiring-event-100-roles",
    "version": "1.0.0",
    "owners": ["workplace-integration", "drive"],
    "related_adrs": ["ADR-0244", "ADR-0292"]
  },
  "required": ["offer_id", "req_id", "application_id", "candidate_pseudo_id", "jurisdiction", "salary", "start_date", "template_version", "esign_status"],
  "properties": {
    "offer_id": {"type": "string", "format": "uuid"},
    "req_id": {"type": "string"},
    "application_id": {"type": "string", "format": "uuid"},
    "candidate_pseudo_id": {"type": "string"},
    "jurisdiction": {"type": "string", "enum": ["IN-BLR", "US-AUS", "DE-BER", "KR-SEO"]},
    "template_version": {"type": "string"},
    "salary": {
      "type": "object",
      "required": ["currency", "annualized"],
      "properties": {
        "currency": {"type": "string"},
        "annualized": {"type": "number", "minimum": 0},
        "equity_grant_units": {"type": "number"},
        "signing_bonus": {"type": "number"}
      }
    },
    "start_date": {"type": "string", "format": "date"},
    "per_jurisdiction_clauses": {
      "type": "object",
      "description": "Jurisdiction-specific clauses (e.g., works-council for DE, at-will for US, severance for KR)"
    },
    "esign_status": {
      "type": "string",
      "enum": ["draft", "sent", "opened", "signed", "declined", "expired"]
    },
    "signed_pdf_drive_ref": {
      "type": "string",
      "description": "Drive ref to the signed PDF (hash-pinned)"
    },
    "audit_chain_seal": {
      "type": "string",
      "description": "Merkle seal reference"
    }
  }
}
