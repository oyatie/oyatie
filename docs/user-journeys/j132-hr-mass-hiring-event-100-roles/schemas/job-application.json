{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oyatie.com/schemas/j132/job-application.json",
  "title": "JobApplication",
  "type": "object",
  "_meta": {
    "doc_class": "User-Journey-Schema",
    "journey_id": "j132-hr-mass-hiring-event-100-roles",
    "version": "1.0.0",
    "owners": ["community", "workflow-engine"],
    "related_adrs": ["ADR-0311", "ADR-0244"]
  },
  "required": ["application_id", "req_id", "candidate_pseudo_id", "submitted_at", "candidate_audience_type", "candidate_jurisdiction", "status"],
  "properties": {
    "application_id": {"type": "string", "format": "uuid"},
    "req_id": {"type": "string"},
    "candidate_pseudo_id": {
      "type": "string",
      "description": "Stable pseudonym per ADR-0263 §applicant-pseudonymization",
      "pattern": "^pseu_[a-z0-9]{32}$"
    },
    "candidate_audience_type": {
      "type": "string",
      "enum": ["B2C_CONSUMER", "B2B_TENANT_MEMBER"]
    },
    "candidate_jurisdiction": {
      "type": "string",
      "description": "Candidate's residency jurisdiction (for protection-law overlay)"
    },
    "submitted_at": {"type": "string", "format": "date-time"},
    "resume_drive_ref": {
      "type": "string",
      "description": "Candidate's Drive ref in their personal tenant (cross-tenant link)"
    },
    "ai_screening_result": {
      "type": "object",
      "properties": {
        "scored_at": {"type": "string", "format": "date-time"},
        "model_ref": {"type": "string"},
        "match_score": {"type": "number", "minimum": 0, "maximum": 1},
        "confidence": {"type": "string", "enum": ["low", "medium", "high"]},
        "fairness_band": {"type": "string", "enum": ["green", "yellow", "red"]},
        "explanation_uri": {
          "type": "string",
          "description": "URI to the per-applicant Article 86 explanation"
        }
      }
    },
    "human_review": {
      "type": "object",
      "properties": {
        "reviewer_principal": {"type": "string"},
        "reviewed_at": {"type": "string", "format": "date-time"},
        "decision": {"type": "string", "enum": ["proceed_to_interview", "reject", "hold"]},
        "reject_reason_code": {
          "type": "string",
          "enum": [
            "mismatch.qualification.required",
            "mismatch.experience.years",
            "mismatch.technology.required",
            "mismatch.geography.work_authorization",
            "position.filled",
            "withdraw.candidate_initiated",
            "other.documented"
          ]
        },
        "reject_reason_text": {"type": "string", "maxLength": 4000}
      }
    },
    "status": {
      "type": "string",
      "enum": ["received", "ai_screened", "human_reviewed", "invited_to_interview", "in_interview", "offer_extended", "hired", "rejected", "withdrawn"]
    }
  }
}
