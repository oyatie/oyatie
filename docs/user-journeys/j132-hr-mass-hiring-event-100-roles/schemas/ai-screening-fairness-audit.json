{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oyatie.com/schemas/j132/ai-screening-fairness-audit.json",
  "title": "AiScreeningFairnessAudit",
  "type": "object",
  "_meta": {
    "doc_class": "User-Journey-Schema",
    "journey_id": "j132-hr-mass-hiring-event-100-roles",
    "version": "1.0.0",
    "owners": ["intelligence", "compliance"],
    "related_adrs": ["ADR-0308", "ADR-0311"],
    "regulatory_anchors": ["EU-AI-Act-Article-86", "US-EEOC-4-5ths", "US-NY-AEDT-Local-Law-144"]
  },
  "required": ["audit_id", "event_id", "model_ref", "audited_at", "auditor_principal", "verdict", "per_jurisdiction_findings"],
  "properties": {
    "audit_id": {"type": "string", "format": "uuid"},
    "event_id": {"type": "string"},
    "model_ref": {"type": "string"},
    "audited_at": {"type": "string", "format": "date-time"},
    "auditor_principal": {
      "type": "string",
      "description": "Internal scorer principal that ran the audit"
    },
    "applicant_count": {"type": "integer", "minimum": 1},
    "verdict": {"type": "string", "enum": ["green", "yellow", "red"]},
    "per_jurisdiction_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["jurisdiction", "passes_4_5ths_rule", "demographic_parity_delta", "sample_size"],
        "properties": {
          "jurisdiction": {"type": "string"},
          "passes_4_5ths_rule": {"type": "boolean"},
          "lowest_selection_rate_ratio": {"type": "number"},
          "demographic_parity_delta": {"type": "number"},
          "age_distribution_audited": {"type": "boolean"},
          "sample_size": {"type": "integer"},
          "verdict_per_jurisdiction": {"type": "string", "enum": ["green", "yellow", "red"]},
          "notes": {"type": "string"}
        }
      }
    },
    "follow_up_required": {
      "type": "boolean"
    },
    "follow_up_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "article_86_record_uri": {
      "type": "string",
      "description": "Article 86 filing in compliance µservice"
    }
  }
}
