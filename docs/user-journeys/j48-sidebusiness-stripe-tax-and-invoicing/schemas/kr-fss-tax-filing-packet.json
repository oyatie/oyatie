{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.oyatie.dev/user-journeys/j48/kr-fss-tax-filing-packet.json",
  "title": "KrFssTaxFilingPacket",
  "version": "1.0.0",
  "description": "Shared journey object for j48-sidebusiness-stripe-tax-and-invoicing. It lets Yejin Park detect the KR-FSS threshold, prepare tax filings, and export quarterly payroll rows to ADP-KR while preserving tenant scope, auditability, and cross-service status.",
  "_meta": {
    "purpose": "Bind j48-sidebusiness-stripe-tax-and-invoicing to a machine-readable object shared by all participating microservices.",
    "status": "Proposed",
    "binding_adr": "ADR-0244",
    "related_adrs": [
      "ADR-0105",
      "ADR-0131",
      "ADR-0244",
      "ADR-0263",
      "ADR-0273",
      "ADR-0292",
      "ADR-0297",
      "ADR-0299"
    ],
    "enforcement_status": "authoring-target",
    "industry_citations": [
      "Stripe Tax plus Toss Payments KR-FSS reporting pattern"
    ],
    "contract_surfaces": [
      "OpenAPI 3.2.0",
      "AsyncAPI 3.1.0",
      "proto3",
      "BNF v4.1",
      "ADR-0105 13-layer"
    ],
    "microservice_count_authority": 45,
    "marketplace_settlement_invariant": "marketplace-settles-all-tenant-deals",
    "schema_version": "v1.0.0"
  },
  "type": "object",
  "required": [
    "journey_id",
    "tenant_id",
    "persona",
    "locale",
    "status",
    "correlation_id",
    "service_states",
    "audit",
    "contracts"
  ],
  "properties": {
    "journey_id": {
      "const": "j48-sidebusiness-stripe-tax-and-invoicing",
      "description": "Stable journey identifier and collision guard for the j36-j50 range.",
      "examples": [
        "j48-sidebusiness-stripe-tax-and-invoicing"
      ]
    },
    "tenant_id": {
      "type": "string",
      "description": "Tenant scope required by ADR-0244; every service must persist or forward it unchanged.",
      "examples": [
        "yejin-vintage-business"
      ]
    },
    "persona": {
      "const": "Yejin Park",
      "description": "The named persona whose continuity is preserved across the journey.",
      "examples": [
        "Yejin Park"
      ]
    },
    "locale": {
      "const": "ko-KR",
      "description": "Locale used for UX, notices, and regulated language variants.",
      "examples": [
        "ko-KR"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "waiting_on_human",
        "waiting_on_provider",
        "completed",
        "compensated",
        "denied"
      ],
      "description": "Journey state machine status observed by UX and tests.",
      "examples": [
        "completed"
      ]
    },
    "correlation_id": {
      "type": "string",
      "pattern": "^journey-j[0-9]{2}-[a-z0-9-]+$",
      "description": "Idempotency and trace correlation key shared by OpenAPI, AsyncAPI, and proto3 surfaces.",
      "examples": [
        "journey-j48-sidebusiness-stripe-tax-and-invoicing"
      ]
    },
    "service_states": {
      "type": "object",
      "description": "Per-service status map; keys match the flat microservice path names used by ADR-0131.",
      "required": [
        "payments",
        "finops_portal",
        "mail",
        "compliance",
        "connect"
      ],
      "properties": {
        "payments": {
          "type": "object",
          "description": "payments owns the kr-fss-threshold-ledger role for this journey and records the status it contributes to the shared object.",
          "required": [
            "role",
            "status",
            "audit_event_class"
          ],
          "properties": {
            "role": {
              "const": "kr-fss-threshold-ledger",
              "description": "The payments role in the journey handshake.",
              "examples": [
                "kr-fss-threshold-ledger"
              ]
            },
            "status": {
              "type": "string",
              "enum": [
                "pending",
                "permitted",
                "denied",
                "degraded",
                "completed",
                "compensated"
              ],
              "description": "Typed service status used by the integration test plan and audit envelope.",
              "examples": [
                "completed"
              ]
            },
            "audit_event_class": {
              "type": "string",
              "description": "ADR-0263 audit event class emitted by this service when the status changes.",
              "examples": [
                "Journey48PaymentsKrFssThresholdLedgerCommitted"
              ]
            }
          },
          "additionalProperties": false
        },
        "finops_portal": {
          "type": "object",
          "description": "finops-portal owns the tax-filing-console role for this journey and records the status it contributes to the shared object.",
          "required": [
            "role",
            "status",
            "audit_event_class"
          ],
          "properties": {
            "role": {
              "const": "tax-filing-console",
              "description": "The finops-portal role in the journey handshake.",
              "examples": [
                "tax-filing-console"
              ]
            },
            "status": {
              "type": "string",
              "enum": [
                "pending",
                "permitted",
                "denied",
                "degraded",
                "completed",
                "compensated"
              ],
              "description": "Typed service status used by the integration test plan and audit envelope.",
              "examples": [
                "completed"
              ]
            },
            "audit_event_class": {
              "type": "string",
              "description": "ADR-0263 audit event class emitted by this service when the status changes.",
              "examples": [
                "Journey48FinopsPortalTaxFilingConsoleCommitted"
              ]
            }
          },
          "additionalProperties": false
        },
        "mail": {
          "type": "object",
          "description": "mail owns the tax-notice-delivery role for this journey and records the status it contributes to the shared object.",
          "required": [
            "role",
            "status",
            "audit_event_class"
          ],
          "properties": {
            "role": {
              "const": "tax-notice-delivery",
              "description": "The mail role in the journey handshake.",
              "examples": [
                "tax-notice-delivery"
              ]
            },
            "status": {
              "type": "string",
              "enum": [
                "pending",
                "permitted",
                "denied",
                "degraded",
                "completed",
                "compensated"
              ],
              "description": "Typed service status used by the integration test plan and audit envelope.",
              "examples": [
                "completed"
              ]
            },
            "audit_event_class": {
              "type": "string",
              "description": "ADR-0263 audit event class emitted by this service when the status changes.",
              "examples": [
                "Journey48MailTaxNoticeDeliveryCommitted"
              ]
            }
          },
          "additionalProperties": false
        },
        "compliance": {
          "type": "object",
          "description": "compliance owns the kr-fss-overlay role for this journey and records the status it contributes to the shared object.",
          "required": [
            "role",
            "status",
            "audit_event_class"
          ],
          "properties": {
            "role": {
              "const": "kr-fss-overlay",
              "description": "The compliance role in the journey handshake.",
              "examples": [
                "kr-fss-overlay"
              ]
            },
            "status": {
              "type": "string",
              "enum": [
                "pending",
                "permitted",
                "denied",
                "degraded",
                "completed",
                "compensated"
              ],
              "description": "Typed service status used by the integration test plan and audit envelope.",
              "examples": [
                "completed"
              ]
            },
            "audit_event_class": {
              "type": "string",
              "description": "ADR-0263 audit event class emitted by this service when the status changes.",
              "examples": [
                "Journey48ComplianceKrFssOverlayCommitted"
              ]
            }
          },
          "additionalProperties": false
        },
        "connect": {
          "type": "object",
          "description": "connect owns the adp-kr-export role for this journey and records the status it contributes to the shared object.",
          "required": [
            "role",
            "status",
            "audit_event_class"
          ],
          "properties": {
            "role": {
              "const": "adp-kr-export",
              "description": "The connect role in the journey handshake.",
              "examples": [
                "adp-kr-export"
              ]
            },
            "status": {
              "type": "string",
              "enum": [
                "pending",
                "permitted",
                "denied",
                "degraded",
                "completed",
                "compensated"
              ],
              "description": "Typed service status used by the integration test plan and audit envelope.",
              "examples": [
                "completed"
              ]
            },
            "audit_event_class": {
              "type": "string",
              "description": "ADR-0263 audit event class emitted by this service when the status changes.",
              "examples": [
                "Journey48ConnectAdpKrExportCommitted"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "audit": {
      "type": "object",
      "description": "ADR-0263 audit envelope shared by all service transitions.",
      "required": [
        "audit_id",
        "trace_id",
        "event_classes",
        "sealed_at"
      ],
      "properties": {
        "audit_id": {
          "type": "string",
          "description": "Audit-chain identifier.",
          "examples": [
            "aud-j48-001"
          ]
        },
        "trace_id": {
          "type": "string",
          "description": "Distributed trace id for observability.",
          "examples": [
            "trace-j48-hero"
          ]
        },
        "event_classes": {
          "type": "array",
          "description": "Audit event classes emitted during this journey.",
          "items": {
            "type": "string"
          },
          "minItems": 5,
          "examples": [
            [
              "Journey48PaymentsKrFssThresholdLedgerCommitted",
              "Journey48FinopsPortalTaxFilingConsoleCommitted",
              "Journey48MailTaxNoticeDeliveryCommitted",
              "Journey48ComplianceKrFssOverlayCommitted",
              "Journey48ConnectAdpKrExportCommitted"
            ]
          ]
        },
        "sealed_at": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when the final audit bundle was sealed.",
          "examples": [
            "2026-06-01T12:00:00Z"
          ]
        }
      },
      "additionalProperties": false
    },
    "contracts": {
      "type": "array",
      "description": "Contract surface names that must remain in sync for this journey.",
      "items": {
        "type": "string",
        "enum": [
          "OpenAPI 3.2.0",
          "AsyncAPI 3.1.0",
          "proto3",
          "BNF v4.1",
          "ADR-0105 13-layer"
        ]
      },
      "minItems": 5,
      "examples": [
        [
          "OpenAPI 3.2.0",
          "AsyncAPI 3.1.0",
          "proto3",
          "BNF v4.1",
          "ADR-0105 13-layer"
        ]
      ]
    }
  },
  "additionalProperties": false
}
