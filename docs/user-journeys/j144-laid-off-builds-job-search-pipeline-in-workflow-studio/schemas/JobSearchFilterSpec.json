{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oyatie.dev/schemas/user-journeys/j144/JobSearchFilterSpec.json",
  "title": "JobSearchFilterSpec",
  "type": "object",
  "_meta": {
    "doc_class": "Schema",
    "journey_id": "j144",
    "status": "draft",
    "owner": "intelligence",
    "consumers": ["workflow-studio", "workflow-engine"],
    "adr_anchors": ["ADR-0244", "ADR-0255", "ADR-0311"],
    "design_invariant": "CLOSED form; no field for protected characteristics (age, gender, race, religion, etc.). Enforcement of US-NY-AEDT and EU-AI-Act non-discrimination is structural."
  },
  "required": ["spec_id", "subject_principal", "role_family", "seniority_range", "locations", "comp_target_band", "tenant_id"],
  "properties": {
    "spec_id":           { "type": "string" },
    "subject_principal": { "type": "string", "format": "uri" },
    "tenant_id":         { "type": "string" },
    "role_family": {
      "type": "array",
      "items": { "type": "string", "enum": [
        "backend_distributed_systems", "frontend_web", "mobile_ios", "mobile_android",
        "data_engineering", "ml_research", "ml_applied", "sre_devops", "security",
        "product_management", "design_ux", "design_visual", "data_science",
        "engineering_manager", "principal_ic", "staff_ic", "founding_engineer"
      ]}
    },
    "seniority_range": {
      "type": "array",
      "items": { "type": "string", "enum": ["L3", "L4", "L5", "L6", "L7", "L8"] }
    },
    "locations": {
      "type": "array",
      "items": { "type": "string" }
    },
    "comp_target_band": {
      "type": "object",
      "required": ["currency", "base_amount", "tolerance_pct"],
      "properties": {
        "currency":       { "type": "string", "pattern": "^[A-Z]{3}$" },
        "base_amount":    { "type": "integer", "minimum": 0 },
        "tolerance_pct":  { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "industry_excludes": { "type": "array", "items": { "type": "string" } },
    "company_stage": { "type": "array", "items": { "type": "string", "enum": ["seed", "series_a", "series_b", "series_c_plus", "public", "pre_ipo"] } },
    "intelligence_model_id":  { "type": "string" },
    "prompt_template_hash":   { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "retraining_locality":    { "const": "on_personal_tenant" },
    "provider_credential_mode": { "type": "string", "enum": ["platform_default", "byok"] },
    "protected_characteristic_filters": {
      "type": "array",
      "maxItems": 0,
      "description": "MUST be empty — structural enforcement of non-discrimination law"
    }
  }
}
