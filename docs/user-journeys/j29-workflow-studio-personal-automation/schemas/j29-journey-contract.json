{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.oyatie.com/schemas/user-journeys/j29-workflow-studio-personal-automation.schema.json",
  "title": "j29 Workflow Studio personal automation Journey Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "journey_id",
    "tenant_id",
    "principal_id",
    "audience_type",
    "home_cell",
    "traceparent",
    "service_steps",
    "audit_events",
    "recovery_policy"
  ],
  "_meta": {
    "doc_class": "Schema",
    "version": "1.0.0",
    "status": "Accepted",
    "purpose": "Yejin builds an n8n-class workflow to auto-file shipping labels for marketplace sales.",
    "binding_adrs": [
      "ADR-0105",
      "ADR-0131",
      "ADR-0244",
      "ADR-0249",
      "ADR-0263",
      "ADR-0273",
      "ADR-0297",
      "ADR-0299"
    ],
    "contract_surfaces": [
      "OpenAPI 3.2.0",
      "AsyncAPI 3.1.0",
      "proto3"
    ],
    "naming": "BNF v4.1",
    "layer_model": "ADR-0105 13-layer",
    "flat_layout": "ADR-0131"
  },
  "properties": {
    "journey_id": {
      "type": "string",
      "const": "j29",
      "description": "Stable journey id.",
      "examples": [
        "j29"
      ]
    },
    "tenant_id": {
      "type": "string",
      "minLength": 3,
      "description": "ADR-0244 tenant id.",
      "examples": [
        "tenant-personal-seller"
      ]
    },
    "principal_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]{7,127}$",
      "description": "Stable human or delegated principal id.",
      "examples": [
        "principal-yejin-park"
      ]
    },
    "audience_type": {
      "type": "string",
      "description": "ADR-0244 audience type.",
      "examples": [
        "personal-seller"
      ]
    },
    "home_cell": {
      "type": "string",
      "description": "ADR-0248 home cell.",
      "examples": [
        "ap-seoul-1",
        "us-west-2"
      ]
    },
    "traceparent": {
      "type": "string",
      "description": "W3C trace root.",
      "examples": [
        "00-11111111111111111111111111111111-2222222222222222-01"
      ]
    },
    "service_steps": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "service",
          "role",
          "contract",
          "idempotency_key"
        ],
        "properties": {
          "service": {
            "type": "string",
            "enum": [
              "workflow-studio",
              "workflow-engine",
              "connect",
              "marketplace"
            ],
            "description": "Service handling step."
          },
          "role": {
            "type": "string",
            "description": "Journey role."
          },
          "contract": {
            "type": "string",
            "enum": [
              "OpenAPI 3.2.0",
              "AsyncAPI 3.1.0",
              "proto3"
            ],
            "description": "Typed surface."
          },
          "idempotency_key": {
            "type": "string",
            "minLength": 16,
            "description": "Retry key."
          }
        }
      }
    },
    "audit_events": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_class",
          "producer",
          "hlc",
          "sealed"
        ],
        "properties": {
          "event_class": {
            "type": "string",
            "description": "ADR-0263 class."
          },
          "producer": {
            "type": "string",
            "enum": [
              "workflow-studio",
              "workflow-engine",
              "connect",
              "marketplace"
            ],
            "description": "Producer."
          },
          "hlc": {
            "type": "string",
            "description": "Hybrid logical clock."
          },
          "sealed": {
            "type": "boolean",
            "const": true,
            "description": "Seal required."
          }
        }
      }
    },
    "recovery_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "critical_path_rows",
        "rollback_mode",
        "user_visible_copy_key"
      ],
      "properties": {
        "critical_path_rows": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "documentation-rigor 3.2.5 rows."
        },
        "rollback_mode": {
          "type": "string",
          "enum": [
            "compensating-event",
            "idempotent-retry",
            "fail-closed"
          ],
          "description": "Recovery family."
        },
        "user_visible_copy_key": {
          "type": "string",
          "description": "Locale copy key."
        }
      }
    }
  },
  "examples": [
    {
      "journey_id": "j29",
      "tenant_id": "tenant-personal-seller",
      "principal_id": "principal-yejin-park",
      "audience_type": "personal-seller",
      "home_cell": "ap-seoul-1",
      "traceparent": "00-11111111111111111111111111111111-2222222222222222-01",
      "service_steps": [
        {
          "service": "workflow-studio",
          "role": "personal-builder-ui",
          "contract": "OpenAPI 3.2.0",
          "idempotency_key": "j29-workflow-studio-0001"
        },
        {
          "service": "workflow-engine",
          "role": "label-filing-runner",
          "contract": "OpenAPI 3.2.0",
          "idempotency_key": "j29-workflow-engine-0001"
        },
        {
          "service": "connect",
          "role": "shipping-label-ingest",
          "contract": "OpenAPI 3.2.0",
          "idempotency_key": "j29-connect-0001"
        },
        {
          "service": "marketplace",
          "role": "sale-event-emitter",
          "contract": "OpenAPI 3.2.0",
          "idempotency_key": "j29-marketplace-0001"
        }
      ],
      "audit_events": [
        {
          "event_class": "j29.workflow-studio.personal-builder-ui.sealed",
          "producer": "workflow-studio",
          "hlc": "2026-05-20T00:00:00Z/0",
          "sealed": true
        },
        {
          "event_class": "j29.workflow-engine.label-filing-runner.sealed",
          "producer": "workflow-engine",
          "hlc": "2026-05-20T00:00:00Z/0",
          "sealed": true
        },
        {
          "event_class": "j29.connect.shipping-label-ingest.sealed",
          "producer": "connect",
          "hlc": "2026-05-20T00:00:00Z/0",
          "sealed": true
        },
        {
          "event_class": "j29.marketplace.sale-event-emitter.sealed",
          "producer": "marketplace",
          "hlc": "2026-05-20T00:00:00Z/0",
          "sealed": true
        }
      ],
      "recovery_policy": {
        "critical_path_rows": [
          "14",
          "25",
          "28"
        ],
        "rollback_mode": "compensating-event",
        "user_visible_copy_key": "user_journey.j29.recovery"
      }
    }
  ]
}
