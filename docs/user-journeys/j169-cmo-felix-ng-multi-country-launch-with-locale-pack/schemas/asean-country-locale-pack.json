{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oyatie.cloud/schemas/j169/asean-country-locale-pack.json",
  "title": "j169 ASEAN Country Locale Pack",
  "description": "Per-country locale-pack overlay schema. Auto-activates from tenant's country_residency_* attribute per ADR-0251.",
  "type": "object",
  "required": ["country_code", "rfc5646_language_tags", "iso4217_currency", "regulatory_anchors", "payment_processors", "cultural_adaptation_rules"],
  "properties": {
    "country_code": {"type": "string", "enum": ["SG", "ID", "TH", "VN", "PH", "MY"]},
    "country_name_local": {"type": "string"},
    "country_name_en": {"type": "string"},
    "iana_time_zone": {"type": "string"},
    "rfc5646_language_tags": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "default_language_tag": {"type": "string"},
    "iso4217_currency": {"type": "string", "minLength": 3, "maxLength": 3},
    "currency_decimal_places": {"type": "integer", "minimum": 0, "maximum": 4},
    "regulatory_anchors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "regulation_code": {"type": "string"},
          "regulation_name": {"type": "string"},
          "effective_date": {"type": "string", "format": "date"},
          "scope": {"type": "string"},
          "data_residency_required": {"type": "boolean"},
          "cross_border_transfer_consent_required": {"type": "boolean"}
        }
      }
    },
    "payment_processors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "processor_id": {"type": "string"},
          "processor_name": {"type": "string"},
          "priority": {"type": "integer"}
        }
      }
    },
    "cultural_adaptation_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "rule_id": {"type": "string"},
          "description": {"type": "string"},
          "auto_apply": {"type": "boolean"},
          "review_required_by_local_ambassador": {"type": "boolean"}
        }
      }
    },
    "cell_residency": {"type": "string"}
  },
  "examples": [
    {
      "country_code": "ID",
      "country_name_local": "Indonesia",
      "country_name_en": "Indonesia",
      "iana_time_zone": "Asia/Jakarta",
      "rfc5646_language_tags": ["id-ID"],
      "default_language_tag": "id-ID",
      "iso4217_currency": "IDR",
      "currency_decimal_places": 0,
      "regulatory_anchors": [
        {"regulation_code": "ID-PP-71-2019", "regulation_name": "Peraturan Pemerintah Nomor 71 Tahun 2019", "effective_date": "2019-10-10", "scope": "electronic_systems_and_transactions", "data_residency_required": false, "cross_border_transfer_consent_required": true},
        {"regulation_code": "ID-UU-PDP-27-2022", "regulation_name": "Undang-Undang Perlindungan Data Pribadi Nomor 27 Tahun 2022", "effective_date": "2024-10-17", "scope": "personal_data_protection", "data_residency_required": false, "cross_border_transfer_consent_required": true},
        {"regulation_code": "ASEAN-Privacy-Framework", "regulation_name": "ASEAN Framework on Personal Data Protection", "effective_date": "2016-11-01", "scope": "cross_border_data_transfer", "data_residency_required": false, "cross_border_transfer_consent_required": true}
      ],
      "payment_processors": [
        {"processor_id": "gopay-id", "processor_name": "GoPay (GoTo Financial)", "priority": 1},
        {"processor_id": "ovo-id", "processor_name": "OVO", "priority": 2},
        {"processor_id": "stripe-fallback", "processor_name": "Stripe", "priority": 99}
      ],
      "cultural_adaptation_rules": [
        {"rule_id": "halal-dietary-aware", "description": "Diabetes meal-planner respects halal dietary constraints (no pork, halal-certified ingredients preferred)", "auto_apply": true, "review_required_by_local_ambassador": false},
        {"rule_id": "lebaran-reset-aware", "description": "Post-Lebaran/Eid healthy-eating reset messaging culturally appropriate; non-judgemental tone", "auto_apply": true, "review_required_by_local_ambassador": true}
      ],
      "cell_residency": "apac-jkt-cell-tier-1-primary"
    },
    {
      "country_code": "TH",
      "country_name_local": "ประเทศไทย",
      "country_name_en": "Thailand",
      "iana_time_zone": "Asia/Bangkok",
      "rfc5646_language_tags": ["th-TH"],
      "default_language_tag": "th-TH",
      "iso4217_currency": "THB",
      "currency_decimal_places": 2,
      "regulatory_anchors": [
        {"regulation_code": "TH-PDPA-2019", "regulation_name": "พระราชบัญญัติคุ้มครองข้อมูลส่วนบุคคล พ.ศ. 2562", "effective_date": "2022-06-01", "scope": "personal_data_protection", "data_residency_required": false, "cross_border_transfer_consent_required": true}
      ],
      "payment_processors": [
        {"processor_id": "truemoney-th", "processor_name": "TrueMoney Wallet", "priority": 1},
        {"processor_id": "promptpay-th", "processor_name": "PromptPay", "priority": 2},
        {"processor_id": "stripe-fallback", "processor_name": "Stripe", "priority": 99}
      ],
      "cultural_adaptation_rules": [
        {"rule_id": "buddhist-uposatha-aware", "description": "Fasting reminders respect Buddhist uposatha days; Thai religious-affairs advisor reviews", "auto_apply": false, "review_required_by_local_ambassador": true}
      ],
      "cell_residency": "apac-bkk-cell-tier-1-primary"
    },
    {
      "country_code": "VN",
      "country_name_local": "Việt Nam",
      "country_name_en": "Vietnam",
      "iana_time_zone": "Asia/Ho_Chi_Minh",
      "rfc5646_language_tags": ["vi-VN"],
      "default_language_tag": "vi-VN",
      "iso4217_currency": "VND",
      "currency_decimal_places": 0,
      "regulatory_anchors": [
        {"regulation_code": "VN-PDPL-2023", "regulation_name": "Nghị định 13/2023/NĐ-CP về bảo vệ dữ liệu cá nhân", "effective_date": "2023-07-01", "scope": "personal_data_protection", "data_residency_required": true, "cross_border_transfer_consent_required": true}
      ],
      "payment_processors": [
        {"processor_id": "momo-vn", "processor_name": "MoMo", "priority": 1},
        {"processor_id": "zalopay-vn", "processor_name": "ZaloPay", "priority": 2},
        {"processor_id": "stripe-fallback", "processor_name": "Stripe", "priority": 99}
      ],
      "cultural_adaptation_rules": [
        {"rule_id": "coffee-culture-aware", "description": "Vietnamese cà phê sữa đá drinking is cultural ritual not addiction; tone is respectful + practical-timing-guidance", "auto_apply": true, "review_required_by_local_ambassador": true}
      ],
      "cell_residency": "apac-hcm-cell-tier-1-primary"
    }
  ]
}
