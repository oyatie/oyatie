{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oyatie.com/specs/journey/j129/warrant-submission.json",
  "title": "WarrantSubmission",
  "version": "1.0.0",
  "_meta": {
    "purpose": "Schema for a court-issued warrant submitted to oyatie's legal-process API. Validated by governance µservice.",
    "binding_adr": "ADR-0312-court-warrant-scoped-piercing",
    "related_adrs": ["ADR-0311", "ADR-0300", "ADR-0263"],
    "status": "Proposed",
    "enforcement_status": "advisory-until-2026-07-15"
  },
  "type": "object",
  "required": ["docket_number", "issuing_court", "magistrate_signature", "target_tenant_id", "scope_items", "effective_at", "expires_at"],
  "properties": {
    "docket_number": {"type": "string", "examples": ["2026-CR-EDV-001847"]},
    "issuing_court": {"type": "string"},
    "magistrate_signature": {
      "type": "object",
      "required": ["signing_principal", "signature_pem", "fulcio_chain_ref"],
      "properties": {
        "signing_principal": {"type": "string"},
        "signature_pem": {"type": "string"},
        "fulcio_chain_ref": {"type": "string", "description": "Reference to Fulcio trust-root chain per ADR-0295"}
      }
    },
    "target_tenant_id": {"type": "string"},
    "target_principal_id": {"type": "string"},
    "scope_items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["microservice", "action", "time_window_start", "time_window_end"],
        "properties": {
          "microservice": {"type": "string", "examples": ["marketplace", "payments", "messenger", "drive"]},
          "action": {"type": "string", "examples": ["read_listings", "read_purchases", "read_charges", "read_thread", "read_file"]},
          "time_window_start": {"type": "string", "format": "date-time"},
          "time_window_end": {"type": "string", "format": "date-time"},
          "sub_scope": {"type": "object", "description": "µservice-specific sub-scoping (e.g., category, member, path_prefix)"}
        }
      }
    },
    "effective_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "no_notice_provision": {"type": "boolean", "default": false, "description": "Per Stored Communications Act §2705(b)"},
    "out_of_scope_explicit_refusal": {"type": "array", "items": {"type": "string"}, "description": "Surfaces the court has EXPLICITLY refused to authorize"}
  }
}
