{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oyatie.com/specs/journey/j129/transparency-report-warrant-canary.json",
  "title": "TransparencyReportWarrantCanary",
  "version": "1.0.0",
  "_meta": {
    "purpose": "Quarterly aggregate counts of legal-process events published publicly by oyatie.",
    "binding_adr": "ADR-0312-court-warrant-scoped-piercing",
    "related_adrs": ["ADR-0300"],
    "status": "Proposed"
  },
  "type": "object",
  "required": ["quarter", "year", "counts", "published_at"],
  "properties": {
    "quarter": {"type": "integer", "minimum": 1, "maximum": 4},
    "year": {"type": "integer"},
    "counts": {
      "type": "object",
      "properties": {
        "court_warrants_personal_tenants": {"type": "integer", "minimum": 0},
        "court_warrants_b2b_tenants": {"type": "integer", "minimum": 0},
        "civil_discovery_subpoenas": {"type": "integer", "minimum": 0},
        "national_security_letters": {
          "type": "integer",
          "minimum": 0,
          "description": "Canary value. If absent or removed, indicates NSL received."
        },
        "gdpr_article_48_conflicting_requests_refused": {"type": "integer", "minimum": 0}
      }
    },
    "published_at": {"type": "string", "format": "date-time"},
    "methodology_ref": {"type": "string"},
    "audit_chain_verification_hash": {"type": "string"}
  }
}
