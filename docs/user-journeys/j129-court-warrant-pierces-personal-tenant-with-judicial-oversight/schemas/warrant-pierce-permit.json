{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oyatie.com/specs/journey/j129/warrant-pierce-permit.json",
  "title": "WarrantPiercePermit",
  "version": "1.0.0",
  "_meta": {
    "purpose": "Cedar-fragment-backed permit constructed from a validated warrant. Variant of the cross-tenant permit grammar with permit_class=COURT_WARRANT_SCOPE_BOUNDED.",
    "binding_adr": "ADR-0312-court-warrant-scoped-piercing",
    "related_adrs": ["ADR-0311", "ADR-0294"],
    "status": "Proposed"
  },
  "type": "object",
  "required": ["permit_id", "docket_number", "grantor_tenant_id", "grantee_tenant_id", "cedar_fragment_text", "soak_starts_at", "active_at", "expires_at"],
  "properties": {
    "permit_id": {"type": "string", "format": "uuid"},
    "docket_number": {"type": "string"},
    "grantor_tenant_id": {"type": "string", "description": "Pierced tenant (e.g., diana-reyes-personal-92381)"},
    "grantee_tenant_id": {"type": "string", "description": "Court/agency tenant (e.g., doj.federal-prosecution.us)"},
    "permit_class": {"const": "COURT_WARRANT_SCOPE_BOUNDED"},
    "cedar_fragment_text": {"type": "string"},
    "actions_permitted": {"type": "array", "items": {"type": "string"}},
    "soak_starts_at": {"type": "string", "format": "date-time"},
    "active_at": {"type": "string", "format": "date-time", "description": "soak_starts_at + 60s per ADR-0294"},
    "expires_at": {"type": "string", "format": "date-time"},
    "warrant_payload_ref": {"type": "string"}
  }
}
