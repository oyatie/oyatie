{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oyatie.dev/schemas/user-journeys/j145/CrossTenantPrincipalProvisioningRequest.json",
  "title": "CrossTenantPrincipalProvisioningRequest",
  "type": "object",
  "_meta": {
    "doc_class": "Schema",
    "journey_id": "j145",
    "status": "draft",
    "owner": "identity",
    "consumers": ["workflow-engine", "audit-chain", "community", "payments"],
    "adr_anchors": ["ADR-0145", "ADR-0244", "ADR-0299", "ADR-0311"]
  },
  "required": [
    "request_id",
    "source_tenant_id",
    "dest_tenant_id",
    "binding_to_credential_id",
    "proposed_principal",
    "audience_type_proposed",
    "purpose",
    "start_date"
  ],
  "properties": {
    "request_id":              { "type": "string", "pattern": "^CTPP-[A-Z0-9-]+$" },
    "source_tenant_id":        { "type": "string", "description": "The employer tenant requesting" },
    "dest_tenant_id":          { "type": "string", "description": "The candidate's personal tenant approving" },
    "binding_to_credential_id":{ "type": "string", "description": "WebAuthn credential_id of the user's passkey" },
    "proposed_principal":      { "type": "string", "format": "uri" },
    "audience_type_proposed":  { "type": "string", "enum": ["B2B_TENANT_EMPLOYEE", "B2B_TENANT_CONTRACTOR", "B2B_TENANT_INTERN", "B2B_VENDOR_ACCOUNT"] },
    "purpose":                 { "type": "string", "enum": ["pre_employment_onboarding", "vendor_account_provisioning", "contractor_account_provisioning"] },
    "start_date":              { "type": "string", "format": "date" },
    "status": {
      "type": "string",
      "enum": ["pending_user_approval", "approved", "refused_consent", "refused_policy_block", "expired"]
    },
    "approval_signature": {
      "type": "object",
      "description": "Present when status=approved",
      "properties": {
        "algorithm":  { "type": "string", "enum": ["ES256", "EdDSA"] },
        "signature":  { "type": "string", "contentEncoding": "base64" },
        "signed_at":  { "type": "string", "format": "date-time" }
      }
    },
    "expiry":                  { "type": "string", "format": "date-time", "description": "Defaults to start_date + 14d if not approved" }
  }
}
