{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.oyatie.com/user-journeys/j45/patient-record-correction.json",
  "title": "PatientRecordCorrection",
  "version": "1.0.0",
  "description": "Shared journey object for j45-healthcare-patient-portal-records. It lets Yejin Park read lab results through a patient portal composition and request a record correction while preserving tenant scope, auditability, and cross-service status.",
  "_meta": {
    "purpose": "Bind j45-healthcare-patient-portal-records to a machine-readable object shared by all participating microservices.",
    "status": "Proposed",
    "binding_adr": "ADR-0244",
    "related_adrs": [
      "ADR-0105",
      "ADR-0131",
      "ADR-0244",
      "ADR-0263",
      "ADR-0273",
      "ADR-0292",
      "ADR-0297",
      "ADR-0299"
    ],
    "enforcement_status": "authoring-target",
    "industry_citations": [
      "MyChart patient portal plus GDPR rectification request pattern"
    ],
    "contract_surfaces": [
      "OpenAPI 3.2.0",
      "AsyncAPI 3.1.0",
      "proto3",
      "BNF v4.1",
      "ADR-0105 13-layer"
    ],
    "microservice_count_authority": 45,
    "marketplace_settlement_invariant": "marketplace-settles-all-tenant-deals",
    "schema_version": "v1.0.0"
  },
  "type": "object",
  "required": [
    "journey_id",
    "tenant_id",
    "persona",
    "locale",
    "status",
    "correlation_id",
    "service_states",
    "audit",
    "contracts"
  ],
  "properties": {
    "journey_id": {
      "const": "j45-healthcare-patient-portal-records",
      "description": "Stable journey identifier and collision guard for the j36-j50 range.",
      "examples": [
        "j45-healthcare-patient-portal-records"
      ]
    },
    "tenant_id": {
      "type": "string",
      "description": "Tenant scope required by ADR-0244; every service must persist or forward it unchanged.",
      "examples": [
        "yejin-personal-health"
      ]
    },
    "persona": {
      "const": "Yejin Park",
      "description": "The named persona whose continuity is preserved across the journey.",
      "examples": [
        "Yejin Park"
      ]
    },
    "locale": {
      "const": "ko-KR",
      "description": "Locale used for UX, notices, and regulated language variants.",
      "examples": [
        "ko-KR"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "waiting_on_human",
        "waiting_on_provider",
        "completed",
        "compensated",
        "denied"
      ],
      "description": "Journey state machine status observed by UX and tests.",
      "examples": [
        "completed"
      ]
    },
    "correlation_id": {
      "type": "string",
      "pattern": "^journey-j[0-9]{2}-[a-z0-9-]+$",
      "description": "Idempotency and trace correlation key shared by OpenAPI, AsyncAPI, and proto3 surfaces.",
      "examples": [
        "journey-j45-healthcare-patient-portal-records"
      ]
    },
    "service_states": {
      "type": "object",
      "description": "Per-service status map; keys match the flat microservice path names used by ADR-0131.",
      "required": [
        "mail",
        "notes",
        "drive",
        "identity",
        "audit_chain",
        "compliance"
      ],
      "properties": {
        "mail": {
          "type": "object",
          "description": "mail owns the lab-result-notice role for this journey and records the status it contributes to the shared object.",
          "required": [
            "role",
            "status",
            "audit_event_class"
          ],
          "properties": {
            "role": {
              "const": "lab-result-notice",
              "description": "The mail role in the journey handshake.",
              "examples": [
                "lab-result-notice"
              ]
            },
            "status": {
              "type": "string",
              "enum": [
                "pending",
                "permitted",
                "denied",
                "degraded",
                "completed",
                "compensated"
              ],
              "description": "Typed service status used by the integration test plan and audit envelope.",
              "examples": [
                "completed"
              ]
            },
            "audit_event_class": {
              "type": "string",
              "description": "ADR-0263 audit event class emitted by this service when the status changes.",
              "examples": [
                "Journey45MailLabResultNoticeCommitted"
              ]
            }
          },
          "additionalProperties": false
        },
        "notes": {
          "type": "object",
          "description": "notes owns the record-correction-request role for this journey and records the status it contributes to the shared object.",
          "required": [
            "role",
            "status",
            "audit_event_class"
          ],
          "properties": {
            "role": {
              "const": "record-correction-request",
              "description": "The notes role in the journey handshake.",
              "examples": [
                "record-correction-request"
              ]
            },
            "status": {
              "type": "string",
              "enum": [
                "pending",
                "permitted",
                "denied",
                "degraded",
                "completed",
                "compensated"
              ],
              "description": "Typed service status used by the integration test plan and audit envelope.",
              "examples": [
                "completed"
              ]
            },
            "audit_event_class": {
              "type": "string",
              "description": "ADR-0263 audit event class emitted by this service when the status changes.",
              "examples": [
                "Journey45NotesRecordCorrectionRequestCommitted"
              ]
            }
          },
          "additionalProperties": false
        },
        "drive": {
          "type": "object",
          "description": "drive owns the lab-result-vault role for this journey and records the status it contributes to the shared object.",
          "required": [
            "role",
            "status",
            "audit_event_class"
          ],
          "properties": {
            "role": {
              "const": "lab-result-vault",
              "description": "The drive role in the journey handshake.",
              "examples": [
                "lab-result-vault"
              ]
            },
            "status": {
              "type": "string",
              "enum": [
                "pending",
                "permitted",
                "denied",
                "degraded",
                "completed",
                "compensated"
              ],
              "description": "Typed service status used by the integration test plan and audit envelope.",
              "examples": [
                "completed"
              ]
            },
            "audit_event_class": {
              "type": "string",
              "description": "ADR-0263 audit event class emitted by this service when the status changes.",
              "examples": [
                "Journey45DriveLabResultVaultCommitted"
              ]
            }
          },
          "additionalProperties": false
        },
        "identity": {
          "type": "object",
          "description": "identity owns the patient-portal-auth role for this journey and records the status it contributes to the shared object.",
          "required": [
            "role",
            "status",
            "audit_event_class"
          ],
          "properties": {
            "role": {
              "const": "patient-portal-auth",
              "description": "The identity role in the journey handshake.",
              "examples": [
                "patient-portal-auth"
              ]
            },
            "status": {
              "type": "string",
              "enum": [
                "pending",
                "permitted",
                "denied",
                "degraded",
                "completed",
                "compensated"
              ],
              "description": "Typed service status used by the integration test plan and audit envelope.",
              "examples": [
                "completed"
              ]
            },
            "audit_event_class": {
              "type": "string",
              "description": "ADR-0263 audit event class emitted by this service when the status changes.",
              "examples": [
                "Journey45IdentityPatientPortalAuthCommitted"
              ]
            }
          },
          "additionalProperties": false
        },
        "audit_chain": {
          "type": "object",
          "description": "audit-chain owns the record-correction-seal role for this journey and records the status it contributes to the shared object.",
          "required": [
            "role",
            "status",
            "audit_event_class"
          ],
          "properties": {
            "role": {
              "const": "record-correction-seal",
              "description": "The audit-chain role in the journey handshake.",
              "examples": [
                "record-correction-seal"
              ]
            },
            "status": {
              "type": "string",
              "enum": [
                "pending",
                "permitted",
                "denied",
                "degraded",
                "completed",
                "compensated"
              ],
              "description": "Typed service status used by the integration test plan and audit envelope.",
              "examples": [
                "completed"
              ]
            },
            "audit_event_class": {
              "type": "string",
              "description": "ADR-0263 audit event class emitted by this service when the status changes.",
              "examples": [
                "Journey45AuditChainRecordCorrectionSealCommitted"
              ]
            }
          },
          "additionalProperties": false
        },
        "compliance": {
          "type": "object",
          "description": "compliance owns the patient-record-overlay role for this journey and records the status it contributes to the shared object.",
          "required": [
            "role",
            "status",
            "audit_event_class"
          ],
          "properties": {
            "role": {
              "const": "patient-record-overlay",
              "description": "The compliance role in the journey handshake.",
              "examples": [
                "patient-record-overlay"
              ]
            },
            "status": {
              "type": "string",
              "enum": [
                "pending",
                "permitted",
                "denied",
                "degraded",
                "completed",
                "compensated"
              ],
              "description": "Typed service status used by the integration test plan and audit envelope.",
              "examples": [
                "completed"
              ]
            },
            "audit_event_class": {
              "type": "string",
              "description": "ADR-0263 audit event class emitted by this service when the status changes.",
              "examples": [
                "Journey45CompliancePatientRecordOverlayCommitted"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "audit": {
      "type": "object",
      "description": "ADR-0263 audit envelope shared by all service transitions.",
      "required": [
        "audit_id",
        "trace_id",
        "event_classes",
        "sealed_at"
      ],
      "properties": {
        "audit_id": {
          "type": "string",
          "description": "Audit-chain identifier.",
          "examples": [
            "aud-j45-001"
          ]
        },
        "trace_id": {
          "type": "string",
          "description": "Distributed trace id for observability.",
          "examples": [
            "trace-j45-hero"
          ]
        },
        "event_classes": {
          "type": "array",
          "description": "Audit event classes emitted during this journey.",
          "items": {
            "type": "string"
          },
          "minItems": 6,
          "examples": [
            [
              "Journey45MailLabResultNoticeCommitted",
              "Journey45NotesRecordCorrectionRequestCommitted",
              "Journey45DriveLabResultVaultCommitted",
              "Journey45IdentityPatientPortalAuthCommitted",
              "Journey45AuditChainRecordCorrectionSealCommitted",
              "Journey45CompliancePatientRecordOverlayCommitted"
            ]
          ]
        },
        "sealed_at": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when the final audit bundle was sealed.",
          "examples": [
            "2026-06-01T12:00:00Z"
          ]
        }
      },
      "additionalProperties": false
    },
    "contracts": {
      "type": "array",
      "description": "Contract surface names that must remain in sync for this journey.",
      "items": {
        "type": "string",
        "enum": [
          "OpenAPI 3.2.0",
          "AsyncAPI 3.1.0",
          "proto3",
          "BNF v4.1",
          "ADR-0105 13-layer"
        ]
      },
      "minItems": 5,
      "examples": [
        [
          "OpenAPI 3.2.0",
          "AsyncAPI 3.1.0",
          "proto3",
          "BNF v4.1",
          "ADR-0105 13-layer"
        ]
      ]
    }
  },
  "additionalProperties": false
}
