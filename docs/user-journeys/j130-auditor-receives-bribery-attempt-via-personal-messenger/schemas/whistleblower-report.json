{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oyatie.com/specs/journey/j130/whistleblower-report.json",
  "title": "WhistleblowerReport",
  "version": "1.0.0",
  "_meta": {
    "purpose": "Schema for a whistleblower report submitted via the Community whistleblower channel.",
    "binding_adr": "ADR-0300-whistleblower-press-freedom-anonymity",
    "related_adrs": ["ADR-0311", "ADR-0263"],
    "status": "Proposed"
  },
  "type": "object",
  "required": ["reference_number", "submitter_tenant_id", "authority_tenant_id", "submission_class", "evidence_ids", "submitted_at"],
  "properties": {
    "reference_number": {"type": "string", "examples": ["WB-DOJ-2026-7847"]},
    "submitter_tenant_id": {"type": "string"},
    "submitter_principal_id": {"type": ["string", "null"], "description": "Null when submission_class=Anonymous"},
    "authority_tenant_id": {"type": "string", "examples": ["doj.oig-federal.us", "sec.whistleblower.us", "fbi.tipline.us"]},
    "submission_class": {"type": "string", "enum": ["ATTRIBUTED", "ANONYMOUS", "PSEUDONYMOUS"]},
    "pseudonym_id": {"type": ["string", "null"]},
    "evidence_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1, "maxItems": 50, "description": "Specific evidence items the submitter is sharing; bounded to anti-abuse cap"},
    "evidence_bundle_id": {"type": "string"},
    "audit_chain_seal_hash": {"type": "string", "pattern": "^0x[0-9a-f]{64}$"},
    "submitted_at": {"type": "string", "format": "date-time"},
    "applicable_protections": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "18-USC-1513",
          "18-USC-1514A",
          "5-USC-2302",
          "SEC-DODD-FRANK-922",
          "SOX-806",
          "EU-DIRECTIVE-2019-1937"
        ]
      }
    }
  }
}
