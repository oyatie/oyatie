{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oyatie.dev/specs/journey/j130/evidence-bundle.json",
  "title": "WhistleblowerEvidenceBundle",
  "version": "1.0.0",
  "_meta": {
    "purpose": "Sealed evidence bundle for a whistleblower report. Strictly scoped to submitter-selected items.",
    "binding_adr": "ADR-0300-whistleblower-press-freedom-anonymity",
    "related_adrs": ["ADR-0028", "ADR-0263"],
    "status": "Proposed"
  },
  "type": "object",
  "required": ["bundle_id", "items", "merkle_root", "sealed_at"],
  "properties": {
    "bundle_id": {"type": "string", "format": "uuid"},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["item_id", "item_type", "source_microservice", "leaf_hash", "payload_ref"],
        "properties": {
          "item_id": {"type": "string"},
          "item_type": {"type": "string", "enum": ["messenger-thread", "mail-message", "drive-file", "attestation"]},
          "source_microservice": {"type": "string"},
          "leaf_hash": {"type": "string", "pattern": "^0x[0-9a-f]{64}$"},
          "payload_ref": {"type": "string", "format": "uri"}
        }
      }
    },
    "merkle_root": {"type": "string", "pattern": "^0x[0-9a-f]{64}$"},
    "sealed_at": {"type": "string", "format": "date-time"},
    "sealing_authority_spiffe_id": {"type": "string"}
  }
}
