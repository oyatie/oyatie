{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oyatie.com/specs/journey/j130/cross-tenant-attestation.json",
  "title": "CrossTenantAttestation",
  "version": "1.0.0",
  "_meta": {
    "purpose": "Identity attestation linking a submitter's principal across two tenants (e.g., personal + federal-employee), for whistleblower purposes.",
    "binding_adr": "ADR-0300-whistleblower-press-freedom-anonymity",
    "related_adrs": ["ADR-0311", "ADR-0188"],
    "status": "Proposed"
  },
  "type": "object",
  "required": ["attestation_id", "submitter_principal_id", "submitter_personal_tenant_id", "attested_secondary_tenant_id", "attestation_class", "issued_at"],
  "properties": {
    "attestation_id": {"type": "string", "format": "uuid"},
    "submitter_principal_id": {"type": "string"},
    "submitter_personal_tenant_id": {"type": "string"},
    "attested_secondary_tenant_id": {"type": "string", "description": "The work tenant the submitter is also a member of (e.g., gao.audit.fedramp-3pao)"},
    "attestation_class": {"type": "string", "enum": ["whistleblower", "press-source", "court-witness", "investigator-collaboration"]},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "issued_by_identity_microservice_signature": {"type": "string"},
    "audit_chain_seal_hash": {"type": "string"}
  }
}
