{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://oya.cloud/schemas/j156/refrigerant-disclosure-form-40cfr82-f.json",
  "title": "EPA Section 608 / 40 CFR Part 82 Subpart F — refrigerant release disclosure form",
  "description": "Schema for refrigerant release disclosure when ≥1 lb is released. Mandated by 40 CFR 82.156(i)(11). For j156, this form is populated by the workflow-engine + Cedar permit at workflow.epa608_disclose_release and submitted to EPA E-GGRT via the compliance µservice.",
  "type": "object",
  "required": [
    "disclosure_id",
    "regulator_anchor",
    "facility",
    "refrigerant",
    "release_estimate_lb",
    "cylinder_of_origin",
    "first_observed_at",
    "leak_cause",
    "recovery_action",
    "post_repair_verification",
    "signatures",
    "tenant_context"
  ],
  "properties": {
    "disclosure_id": {
      "type": "string",
      "pattern": "^disclosure-[a-z0-9-]+-[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "examples": ["disclosure-dc-phx-3-2026-10-17"]
    },
    "regulator_anchor": {
      "type": "string",
      "enum": ["40-CFR-82-F", "40-CFR-82-F-Section-608", "40-CFR-82-F-Section-608-i-11"]
    },
    "facility": {
      "type": "object",
      "required": ["facility_id", "address", "owner_tenant_id"],
      "properties": {
        "facility_id": {"type": "string", "examples": ["dc-phx-3"]},
        "address": {
          "type": "object",
          "required": ["street", "city", "state", "postal_code", "country"],
          "properties": {
            "street": {"type": "string"},
            "city": {"type": "string"},
            "state": {"type": "string"},
            "postal_code": {"type": "string"},
            "country": {"type": "string", "enum": ["US"]}
          }
        },
        "owner_tenant_id": {"type": "string", "examples": ["meridianstack-hosting-co-us"]},
        "epa_id": {"type": "string", "description": "EPA ID if facility is registered as a stationary source"}
      }
    },
    "refrigerant": {
      "type": "object",
      "required": ["ashrae_id", "gwp", "ozone_depletion_class"],
      "properties": {
        "ashrae_id": {"type": "string", "examples": ["R-454B", "R-410A", "R-32"]},
        "gwp": {"type": "number", "description": "100-yr global warming potential per AR6"},
        "ozone_depletion_class": {"type": "string", "enum": ["Class-I", "Class-II", "Non-Class"]}
      }
    },
    "release_estimate_lb": {
      "type": "number",
      "minimum": 1.0,
      "description": "Net release in lb; disclosure mandatory if ≥1 lb in any 24-hr period",
      "examples": [1.4]
    },
    "cylinder_of_origin": {
      "type": "object",
      "required": ["cylinder_id", "charge_date", "charge_tech_principal", "in_loop_estimated_lb"],
      "properties": {
        "cylinder_id": {"type": "string", "examples": ["R454B-CYL-DC-PHX-3-2026-Q3-007"]},
        "charge_date": {"type": "string", "format": "date"},
        "charge_tech_principal": {"type": "string"},
        "in_loop_estimated_lb": {"type": "number"},
        "vendor": {"type": "string", "examples": ["Honeywell", "Chemours", "Daikin"]}
      }
    },
    "first_observed_at": {"type": "string", "format": "date-time"},
    "leak_cause": {
      "type": "object",
      "required": ["category", "specific_component", "free_text"],
      "properties": {
        "category": {
          "type": "string",
          "enum": ["mechanical_seal_failure", "joint_leak", "valve_leak", "tube_rupture", "vibration_fatigue", "corrosion", "improper_brazing", "unknown"]
        },
        "specific_component": {"type": "string", "examples": ["7B-PUMP-04 shaft seal"]},
        "free_text": {"type": "string", "minLength": 32, "maxLength": 1024}
      }
    },
    "recovery_action": {
      "type": "object",
      "required": ["action", "recovery_unit_id", "destination_cylinder_id", "recovered_lb"],
      "properties": {
        "action": {"type": "string", "enum": ["recovered_to_destination_cylinder", "reclaim_facility_offsite", "destruction"]},
        "recovery_unit_id": {"type": "string", "examples": ["Yellow Jacket 95760"]},
        "destination_cylinder_id": {"type": "string"},
        "recovered_lb": {"type": "number"},
        "released_to_atmosphere_lb": {"type": "number", "description": "calculated as in_loop_estimated_lb - recovered_lb"}
      }
    },
    "post_repair_verification": {
      "type": "object",
      "required": ["pressure_test_psi", "decay_window_min", "decay_observed_psi", "verification_result"],
      "properties": {
        "pressure_test_psi": {"type": "number", "examples": [250.0]},
        "decay_window_min": {"type": "integer", "examples": [14]},
        "decay_observed_psi": {"type": "number", "examples": [0.0]},
        "verification_result": {"type": "string", "enum": ["pass", "fail"]}
      }
    },
    "evidence": {
      "type": "object",
      "required": ["photo_cylinder_label", "photo_leak_site", "photo_recovery_unit"],
      "properties": {
        "photo_cylinder_label": {"type": "string"},
        "photo_leak_site": {"type": "string"},
        "photo_recovery_unit": {"type": "string"},
        "thermal_image_post_repair": {"type": "string"}
      }
    },
    "signatures": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["role", "signer_principal", "signed_at", "passkey_assertion_b64"],
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "technician_epa_608",
              "cascade_tenant_attestation",
              "meridianstack_site_attestation",
              "host_facility_manager",
              "epa_608_class_iv_vendor"
            ]
          },
          "signer_principal": {"type": "string"},
          "signed_at": {"type": "string", "format": "date-time"},
          "passkey_assertion_b64": {"type": "string", "format": "byte"},
          "cert_id_at_sign": {"type": "string"},
          "cert_expiry": {"type": "string", "format": "date"}
        }
      }
    },
    "tenant_context": {
      "type": "object",
      "required": ["technician_home_tenant", "host_tenant", "cross_grant_id", "incident_link"],
      "properties": {
        "technician_home_tenant": {"type": "string"},
        "host_tenant": {"type": "string"},
        "cross_grant_id": {"type": "string"},
        "incident_link": {"type": "string"}
      }
    },
    "submission": {
      "type": "object",
      "required": ["submitted_at", "egrt_receipt_id"],
      "properties": {
        "submitted_at": {"type": "string", "format": "date-time"},
        "egrt_receipt_id": {"type": "string", "examples": ["egrt-receipt-2026-10-17-dc-phx-3-001"]},
        "regulator_response_signature_b64": {"type": "string", "format": "byte"}
      }
    },
    "audit": {
      "type": "object",
      "properties": {
        "event_class": {"type": "string", "examples": ["EVT-J156-EPA608-DISCLOSURE-006"]},
        "triple_seal_tenants": {
          "type": "array",
          "minItems": 3,
          "items": {"type": "string"},
          "examples": [["cascade-fm-services-llc-us", "meridianstack-hosting-co-us", "compliance-regulator-anchor-ledger"]]
        },
        "merkle_leaf_b64": {"type": "string"}
      }
    }
  }
}
