{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.oyatie.com/user-journeys/j02/code-blue-event.json",
  "title": "CodeBlueEvent",
  "_meta": {
    "binding_adr": "ADR-0247",
    "related_adrs": ["ADR-0263","ADR-0298"],
    "schema_version": "v1.0.0",
    "audit_event_class": "CodeBlueAlarmReceived",
    "cedar_fragment": "code-blue-ingest.cedar"
  },
  "type": "object",
  "required": ["event_id","tenant_id","ward","bed","alarm_type","alarm_timestamp","source_attestation"],
  "properties": {
    "event_id": {"type": "string", "format": "uuid"},
    "tenant_id": {"type": "string"},
    "ward": {"type": "string"},
    "bed": {"type": "string"},
    "alarm_type": {"enum": ["ventricular-fibrillation","asystole","ventricular-tachycardia","respiratory-arrest","other"]},
    "alarm_timestamp": {"type": "string","format": "date-time"},
    "monitor_source": {"type": "string"},
    "source_attestation": {
      "type": "object",
      "properties": {
        "spiffe_id": {"type": "string"},
        "device_serial": {"type": "string"}
      }
    }
  },
  "additionalProperties": false
}
