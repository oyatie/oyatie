{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.oyatie.dev/user-journeys/j02/break-glass-justification.json",
  "title": "BreakGlassJustification",
  "_meta": {
    "binding_adr": "ADR-0247",
    "schema_version": "v1.0.0",
    "audit_event_class": "BreakGlassJustificationSubmitted",
    "cedar_fragment": "break-glass-justification-submit.cedar"
  },
  "type": "object",
  "required": ["break_glass_audit_id","justification_text","submitted_at","submitter_principal"],
  "properties": {
    "break_glass_audit_id": {"type": "string","pattern": "^audit:[a-f0-9]+$"},
    "justification_text": {"type": "string","minLength": 50,"maxLength": 4000},
    "submitted_at": {"type": "string","format": "date-time"},
    "submitter_principal": {"type": "string"},
    "auto_collected_context": {
      "type": "object",
      "properties": {
        "code_blue_alarm_timestamp": {"type": "string","format": "date-time"},
        "code_team_arrival_timestamp": {"type": "string","format": "date-time"},
        "submitter_rfid_zone": {"type": "string"},
        "patient_rosc_timestamp": {"type": "string","format": "date-time"}
      }
    }
  },
  "additionalProperties": false
}
