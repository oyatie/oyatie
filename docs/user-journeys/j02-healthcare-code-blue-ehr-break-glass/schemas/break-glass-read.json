{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.oyatie.dev/user-journeys/j02/break-glass-read.json",
  "title": "BreakGlassReadRequest",
  "_meta": {
    "binding_adr": "ADR-0247",
    "related_adrs": ["ADR-0243","ADR-0244","ADR-0263"],
    "schema_version": "v1.0.0",
    "audit_event_class": "BreakGlassChartRead",
    "cedar_fragment": "ehr-break-glass-read.cedar"
  },
  "type": "object",
  "required": ["clinician_principal","patient_chart_id","clinician_location","attestation"],
  "properties": {
    "clinician_principal": {"type": "string"},
    "patient_chart_id": {"type": "string"},
    "clinician_location": {
      "type": "object",
      "properties": {
        "ward": {"type": "string"},
        "rfid_zone": {"type": "string"},
        "coords": {
          "type": "object",
          "properties": {
            "lat": {"type": "number"},
            "lng": {"type": "number"}
          }
        }
      }
    },
    "attestation": {
      "type": "object",
      "properties": {
        "passkey_assertion_hash": {"type": "string"},
        "spiffe_id": {"type": "string"},
        "device_attest_hash": {"type": "string"}
      }
    },
    "active_code_blue_event_id": {"type": "string"}
  },
  "additionalProperties": false
}
