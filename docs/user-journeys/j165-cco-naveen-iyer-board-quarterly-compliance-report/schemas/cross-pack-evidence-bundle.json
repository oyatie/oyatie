{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oyatie.com/schemas/j165/cross-pack-evidence-bundle.json",
  "title": "Tessellate Q1-2027 Cross-Pack Evidence Bundle",
  "description": "Cross-pack evidence bundle schema for the j165 board compliance report. Aggregates per-pack evidence ledgers + per-pack Merkle roots + cross-pack themes + super-Merkle-of-Merkles. Bundle is what gets archived to drive WORM + externally anchored.",
  "type": "object",
  "x-journey-id": "j165-cco-naveen-iyer-board-quarterly-compliance-report",
  "x-adrs": ["ADR-0251", "ADR-0263", "ADR-0250"],
  "required": [
    "bundle_metadata",
    "active_packs",
    "per_pack_ledgers",
    "per_pack_merkle_roots",
    "super_merkle_root",
    "cross_pack_themes",
    "sec_8k_trigger_evaluation",
    "regional_data_residency",
    "approval_chain"
  ],
  "properties": {
    "bundle_metadata": {
      "type": "object",
      "required": ["bundle_id", "tenant_id", "quarter", "computed_at"],
      "properties": {
        "bundle_id": {"type": "string", "example": "bundle-tessellate-q1-2027-quarterly"},
        "tenant_id": {"type": "string", "const": "tessellate-health-ai-inc"},
        "report_id": {"type": "string"},
        "quarter": {"type": "string", "example": "fy2027-q1"},
        "computed_at": {"type": "string", "format": "date-time"},
        "schema_version": {"type": "string", "const": "1.0.0"}
      }
    },
    "active_packs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["pack_id", "pack_class", "evidence_cell", "region"],
        "properties": {
          "pack_id": {"type": "string"},
          "pack_class": {"type": "string", "enum": ["soc2-type2", "hipaa-business-associate", "gdpr-mixed", "eu-ai-act-high-risk-medical", "kr-pipa-controller", "csap-tier-3", "pci-dss-saq-c", "sec-pre-ipo-s1"]},
          "evidence_cell": {"type": "string"},
          "region": {"type": "string", "enum": ["us-east", "eu-frankfurt", "kr-seoul"]}
        }
      },
      "examples": [
        [
          {"pack_id": "pack-soc2-type2-fy2026", "pack_class": "soc2-type2", "evidence_cell": "us-east-boston-tier-1-compliance", "region": "us-east"},
          {"pack_id": "pack-hipaa-business-associate", "pack_class": "hipaa-business-associate", "evidence_cell": "us-east-boston-tier-1-compliance", "region": "us-east"},
          {"pack_id": "pack-gdpr-controller-processor-mixed", "pack_class": "gdpr-mixed", "evidence_cell": "eu-frankfurt-evidence-mirror", "region": "eu-frankfurt"},
          {"pack_id": "pack-eu-ai-act-high-risk-medical", "pack_class": "eu-ai-act-high-risk-medical", "evidence_cell": "eu-frankfurt-evidence-mirror", "region": "eu-frankfurt"},
          {"pack_id": "pack-kr-pipa-controller", "pack_class": "kr-pipa-controller", "evidence_cell": "kr-seoul-evidence-mirror", "region": "kr-seoul"},
          {"pack_id": "pack-csap-naver-cloud-tier-3", "pack_class": "csap-tier-3", "evidence_cell": "kr-seoul-evidence-mirror", "region": "kr-seoul"},
          {"pack_id": "pack-pci-dss-saq-c", "pack_class": "pci-dss-saq-c", "evidence_cell": "us-east-boston-tier-1-compliance", "region": "us-east"},
          {"pack_id": "pack-sec-pre-ipo-s1-active", "pack_class": "sec-pre-ipo-s1", "evidence_cell": "us-east-boston-tier-1-compliance", "region": "us-east"}
        ]
      ]
    },
    "per_pack_ledgers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["pack_id", "evidence_count", "findings", "open_risks"],
        "properties": {
          "pack_id": {"type": "string"},
          "evidence_count": {"type": "integer"},
          "findings": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "finding_id": {"type": "string"},
                "severity": {"type": "string", "enum": ["P1", "P2", "P3"]},
                "subject": {"type": "string"},
                "remediation_status": {"type": "string", "enum": ["in_progress", "completed", "deferred"]},
                "remediation_owner": {"type": "string"},
                "target_quarter": {"type": "string"}
              }
            }
          },
          "open_risks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "risk_id": {"type": "string"},
                "description": {"type": "string"},
                "remediation_owner": {"type": "string"},
                "target": {"type": "string"},
                "material_to_disclose": {"type": "string", "enum": ["yes", "partial", "no"]}
              }
            }
          },
          "regulatory_articles_satisfied": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "per_pack_merkle_roots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["pack_id", "merkle_root", "evidence_count_committed"],
        "properties": {
          "pack_id": {"type": "string"},
          "merkle_root": {"type": "string", "pattern": "^0x[0-9a-f]{32,64}$"},
          "evidence_count_committed": {"type": "integer"},
          "evidence_artifact_ordering": {"type": "string", "const": "sha256_ascending"},
          "tree_construction": {"type": "string", "const": "rfc-6962-style"},
          "hash_function": {"type": "string", "const": "SHA-256"},
          "computed_at": {"type": "string", "format": "date-time"}
        }
      },
      "examples": [
        [
          {"pack_id": "pack-soc2-type2-fy2026", "merkle_root": "0x7a2f4b8c1e9d5f3a6b2c8e0f4d7a9b1c", "evidence_count_committed": 142},
          {"pack_id": "pack-hipaa-business-associate", "merkle_root": "0x3e8b2f9a6c4d1e7f5a8b3c0d6e9f2a4b", "evidence_count_committed": 87},
          {"pack_id": "pack-gdpr-controller-processor-mixed", "merkle_root": "0xb1d4f8c3a7e6b9c2d5f0a4e8b7c1d3f6", "evidence_count_committed": 64},
          {"pack_id": "pack-eu-ai-act-high-risk-medical", "merkle_root": "0x9c6e2a8b4d7f3c1e5a0b8d6c4f9e2b3a", "evidence_count_committed": 71},
          {"pack_id": "pack-kr-pipa-controller", "merkle_root": "0x5f8a1c7e9b3d6f2a4c8e0b5d7f3a9c1e", "evidence_count_committed": 42},
          {"pack_id": "pack-csap-naver-cloud-tier-3", "merkle_root": "0xe2b7d4a9c6f8e1b3a5d7c0f2b9e4a8c6", "evidence_count_committed": 38},
          {"pack_id": "pack-pci-dss-saq-c", "merkle_root": "0x4d8f1b6e9a3c7d2f5b8e0a1d4c7f9b3e", "evidence_count_committed": 28},
          {"pack_id": "pack-sec-pre-ipo-s1-active", "merkle_root": "0xa8c3e7b2f4d9a1c6e8b3f5d7a0c2e4b6", "evidence_count_committed": 24}
        ]
      ]
    },
    "super_merkle_root": {
      "type": "object",
      "required": ["root", "input_roots_ordering", "computed_at"],
      "properties": {
        "root": {"type": "string", "example": "0xf3a8c2e7b6d9f4a1c8e3b5d7f0a2c4e6b8d1f5a3c7e9b2d4f6a8c0e2b5d7f1a4"},
        "input_roots_ordering": {"type": "string", "const": "pack_id_ascending"},
        "input_count": {"type": "integer", "minimum": 1},
        "tree_construction": {"type": "string", "const": "rfc-6962-style"},
        "hash_function": {"type": "string", "const": "SHA-256"},
        "computed_at": {"type": "string", "format": "date-time"},
        "determinism_invariant_verified": {"type": "boolean", "const": true}
      }
    },
    "cross_pack_themes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "theme_id": {"type": "string"},
          "theme_name": {"type": "string"},
          "affected_packs": {"type": "array", "items": {"type": "string"}},
          "description": {"type": "string"},
          "recommended_remediation": {"type": "string"}
        }
      },
      "examples": [
        [
          {"theme_id": "audit-logging-completeness", "theme_name": "Audit logging completeness across packs", "affected_packs": ["pack-soc2-type2-fy2026", "pack-eu-ai-act-high-risk-medical", "pack-hipaa-business-associate"]},
          {"theme_id": "access-review-cadence", "theme_name": "User-access-review cadence", "affected_packs": ["pack-soc2-type2-fy2026"]},
          {"theme_id": "subprocessor-risk-assessment", "theme_name": "Subprocessor risk assessment", "affected_packs": ["pack-soc2-type2-fy2026", "pack-gdpr-controller-processor-mixed"]}
        ]
      ]
    },
    "sec_8k_trigger_evaluation": {
      "type": "object",
      "required": ["evaluation_mode", "items_evaluated", "triggers_fired"],
      "properties": {
        "evaluation_mode": {"type": "string", "enum": ["pre_ipo_shadow", "post_ipo_enforcement"]},
        "items_evaluated": {
          "type": "array",
          "items": {"type": "string"},
          "minItems": 1,
          "example": ["1.01-material-definitive-agreement", "1.02-termination-material-definitive-agreement", "2.02-results-of-operations", "2.04-triggering-events-financial-obligation", "4.02-non-reliance-on-financial-statements", "5.02-departure-directors-officers", "8.01-other-events"]
        },
        "triggers_fired": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "item_id": {"type": "string"},
              "trigger_subject": {"type": "string"},
              "fired_at": {"type": "string", "format": "date-time"}
            }
          }
        },
        "form_nt_evaluated": {"type": "boolean"},
        "form_nt_triggers": {"type": "array", "items": {"type": "object"}},
        "evaluated_at": {"type": "string", "format": "date-time"}
      }
    },
    "regional_data_residency": {
      "type": "object",
      "properties": {
        "regions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "region": {"type": "string"},
              "packs": {"type": "array", "items": {"type": "string"}},
              "evidence_count": {"type": "integer"},
              "cell": {"type": "string"}
            }
          }
        },
        "only_hashes_crossed_regions": {"type": "boolean", "const": true},
        "data_residency_invariant_held": {"type": "boolean", "const": true},
        "cross_region_transfers_log": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "source_region": {"type": "string"},
              "target_region": {"type": "string"},
              "transfer_class": {"type": "string", "const": "hash_only"},
              "merkle_root_transferred": {"type": "string"}
            }
          }
        }
      }
    },
    "approval_chain": {
      "type": "object",
      "required": ["cco_signoff", "counsel_review", "audit_committee_quorum"],
      "properties": {
        "cco_signoff": {
          "type": "object",
          "properties": {
            "principal": {"type": "string"},
            "signed_at": {"type": "string", "format": "date-time"},
            "passkey_assertion_present": {"type": "boolean", "const": true}
          }
        },
        "counsel_review": {
          "type": "object",
          "properties": {
            "reviewer_principal": {"type": "string"},
            "redline_count": {"type": "integer"},
            "completed_at": {"type": "string", "format": "date-time"},
            "passkey_assertion_present": {"type": "boolean", "const": true}
          }
        },
        "audit_committee_quorum": {
          "type": "object",
          "properties": {
            "quorum_threshold": {"type": "integer", "const": 3},
            "quorum_reached": {"type": "boolean"},
            "signoffs": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "principal": {"type": "string"},
                  "role": {"type": "string", "enum": ["audit_committee_chair", "audit_committee_independent", "audit_committee_NED"]},
                  "signed_at": {"type": "string", "format": "date-time"}
                }
              }
            }
          }
        }
      }
    },
    "llm_provenance_metadata": {
      "type": "object",
      "properties": {
        "exec_summary_assist_model": {"type": "string"},
        "model_card_reference": {"type": "string"},
        "human_edit_distance": {"type": "number"},
        "human_review_duration_minutes": {"type": "integer"},
        "human_signoff_principal": {"type": "string"},
        "eu_ai_act_article_50_declaration_present": {"type": "boolean", "const": true},
        "license": {"type": "string"}
      }
    },
    "external_transparency_anchor": {
      "type": "object",
      "properties": {
        "super_merkle_root": {"type": "string"},
        "external_batch_id": {"type": "string", "example": "external-transparency-log-batch-2027-04-11T1742"},
        "anchored_at": {"type": "string", "format": "date-time"},
        "independent_verifiability_confirmed": {"type": "boolean", "const": true}
      }
    },
    "drive_archive_reference": {
      "type": "object",
      "properties": {
        "drive_room": {"type": "string", "const": "tessellate/board/2027/q1/compliance-report"},
        "filename": {"type": "string"},
        "sha256": {"type": "string"},
        "worm_lock_engaged": {"type": "boolean", "const": true},
        "worm_until": {"type": "string", "format": "date-time"},
        "retention_authority": {"type": "string", "const": "SEC-pre-IPO-adapted-from-17-CFR-240-17a-4-7-year"}
      }
    },
    "audit_chain_events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "event_id": {"type": "string", "pattern": "^EVT-J165-"},
          "event_class": {"type": "string"},
          "observed_at": {"type": "string", "format": "date-time"}
        }
      }
    }
  },
  "additionalProperties": false
}
