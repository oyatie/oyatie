{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oyatie.dev/specs/journey/j126/audit-evidence-bundle.json",
  "title": "AuditEvidenceBundle",
  "version": "1.0.0",
  "_meta": {
    "purpose": "Sealed envelope delivered to the 3PAO containing requested control evidence. Merkle-rooted per ADR-0028.",
    "binding_adr": "ADR-0311-dual-tenant-identity-personal-vs-work-boundary",
    "related_adrs": ["ADR-0028", "ADR-0263", "ADR-0246"],
    "status": "Proposed",
    "enforcement_status": "advisory-until-2026-07-15"
  },
  "type": "object",
  "required": ["docket_id", "merkle_root", "sealed_at", "evidence", "transparency_emissions"],
  "properties": {
    "docket_id": {"type": "string"},
    "merkle_root": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$",
      "description": "SHA-256 Merkle root over all evidence entries per ADR-0028."
    },
    "sealed_at": {"type": "string", "format": "date-time"},
    "sealing_authority": {
      "type": "object",
      "properties": {
        "audit_chain_tenant": {"type": "string"},
        "spiffe_id": {"type": "string"},
        "signature": {"type": "string"}
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["evidence_id", "control", "source_microservice", "payload_ref", "leaf_hash"],
        "properties": {
          "evidence_id": {"type": "string", "format": "uuid"},
          "control": {"type": "string", "examples": ["AU-2"]},
          "source_microservice": {"type": "string", "examples": ["audit-chain", "compliance", "observability", "identity", "tenancy", "ops-dashboard-control-center"]},
          "payload_ref": {
            "type": "string",
            "format": "uri",
            "description": "S3-class URI to the evidence payload (encrypted at rest with FedRAMP-Mod-approved KMS)."
          },
          "leaf_hash": {"type": "string", "pattern": "^0x[0-9a-f]{64}$"}
        }
      }
    },
    "transparency_emissions": {
      "type": "object",
      "description": "Per ADR-0311 §B-9: cross-tenant operations emit to BOTH tenants' audit-chains. This block records the two emissions.",
      "required": ["principal_tenant_emission", "resource_tenant_emission"],
      "properties": {
        "principal_tenant_emission": {
          "type": "object",
          "properties": {
            "tenant_id": {"type": "string"},
            "audit_event_class": {"const": "CrossTenantAuditEvidencePulled"},
            "audit_event_id": {"type": "string", "format": "uuid"}
          }
        },
        "resource_tenant_emission": {
          "type": "object",
          "properties": {
            "tenant_id": {"type": "string"},
            "audit_event_class": {"const": "CrossTenantAuditEvidenceExported"},
            "audit_event_id": {"type": "string", "format": "uuid"}
          }
        }
      }
    }
  }
}
