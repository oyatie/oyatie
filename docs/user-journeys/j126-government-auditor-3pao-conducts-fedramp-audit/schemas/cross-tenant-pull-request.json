{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oyatie.com/specs/journey/j126/cross-tenant-pull-request.json",
  "title": "CrossTenantEvidencePullRequest",
  "version": "1.0.0",
  "_meta": {
    "purpose": "Initiates a cross-tenant FedRAMP audit evidence pull. Triggers Cedar evaluation against the cross-tenant permit grammar (ADR-0311 §B-4).",
    "industry_citations": ["FedRAMP ConMon SOP", "NIST SP 800-53 AU-2 evidence pull"],
    "binding_adr": "ADR-0311-dual-tenant-identity-personal-vs-work-boundary",
    "related_adrs": ["ADR-0243", "ADR-0244", "ADR-0263"],
    "status": "Proposed",
    "enforcement_status": "advisory-until-2026-07-15"
  },
  "type": "object",
  "required": ["docket_id", "csp_tenant_id", "controls_requested", "audit_period_start", "audit_period_end", "principal_attestation"],
  "properties": {
    "docket_id": {
      "type": "string",
      "pattern": "^3PAO-\\d{4}-[A-Z]{3}-[A-Z\\-]+-\\d{3}$",
      "examples": ["3PAO-2026-MAY-CHEN-AERO-001"]
    },
    "csp_tenant_id": {
      "type": "string",
      "description": "CSP tenant under audit.",
      "examples": ["chen-aerospace.federal-contractor.us"]
    },
    "controls_requested": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[A-Z]{2}-\\d+(\\(\\d+\\))?$",
        "examples": ["AU-2", "AU-12", "AC-3", "IA-2(1)", "CM-3"]
      },
      "description": "NIST SP 800-53 Rev 5 control identifiers. Each control determines which µservices contribute evidence."
    },
    "audit_period_start": {
      "type": "string",
      "format": "date-time",
      "description": "Inclusive start of the audit period."
    },
    "audit_period_end": {
      "type": "string",
      "format": "date-time",
      "description": "Inclusive end of the audit period. Per ADR-0311 cross-tenant fragment, this MUST be within the permitted time-window."
    },
    "principal_attestation": {
      "type": "object",
      "required": ["principal_id", "fedramp_3pao_accreditation_id", "accreditation_active"],
      "description": "Server snapshots this at evaluation time; clients send their current state which is overridden by identity µservice's live lookup.",
      "properties": {
        "principal_id": {"type": "string"},
        "fedramp_3pao_accreditation_id": {"type": "string", "examples": ["3PAO-2023-0147"]},
        "accreditation_active": {"type": "boolean"}
      }
    },
    "evidence_format": {
      "type": "string",
      "enum": ["oscal-v1.1.2", "fedramp-cra-v5.0", "json-merkle-sealed"],
      "default": "oscal-v1.1.2"
    }
  }
}
