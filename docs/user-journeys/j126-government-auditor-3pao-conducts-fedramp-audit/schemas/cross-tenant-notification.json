{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oyatie.com/specs/journey/j126/cross-tenant-notification.json",
  "title": "CrossTenantNotification",
  "version": "1.0.0",
  "_meta": {
    "purpose": "Tenant-admin notification dispatched when a cross-tenant audit pull occurs. Required by ADR-0311 §B-7 transparency invariant.",
    "binding_adr": "ADR-0311-dual-tenant-identity-personal-vs-work-boundary",
    "related_adrs": ["ADR-0263", "ADR-0273"],
    "status": "Proposed",
    "enforcement_status": "advisory-until-2026-07-15"
  },
  "type": "object",
  "required": ["notification_id", "to_tenant_id", "to_admin_principal", "from_tenant_id", "audit_event_id", "dispatched_at", "due_within"],
  "properties": {
    "notification_id": {"type": "string", "format": "uuid"},
    "to_tenant_id": {"type": "string", "examples": ["chen-aerospace.federal-contractor.us"]},
    "to_admin_principal": {"type": "string", "examples": ["marcus.chen@chen-aerospace.us"]},
    "from_tenant_id": {"type": "string", "examples": ["gao.audit.fedramp-3pao"]},
    "audit_event_id": {"type": "string", "format": "uuid"},
    "dispatched_at": {"type": "string", "format": "date-time"},
    "due_within": {
      "type": "string",
      "description": "Per ADR-0311 §B-7, MUST be ≤15 minutes for cross-tenant audit-pull class.",
      "examples": ["PT15M"]
    },
    "transport": {
      "type": "string",
      "enum": ["comms-email-tenant-admin", "messenger-tenant-admin-broadcast", "ops-dashboard-banner"]
    },
    "dkim_signature": {
      "type": "string",
      "description": "Per ADR-0273 per-tenant DKIM signature when transport is comms-email."
    }
  }
}
