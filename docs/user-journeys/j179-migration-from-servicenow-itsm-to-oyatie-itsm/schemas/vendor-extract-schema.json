{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.oyatie.com/user-journeys/j179-migration-from-servicenow-itsm-to-oyatie-itsm/vendor-extract-schema.json",
  "title": "ServiceNow ITSM to Oyatie ITSM cutover vendor extract schema",
  "type": "object",
  "required": [
    "journey_id",
    "tenant_id",
    "source_system",
    "batch_id",
    "objects",
    "row_count_manifest",
    "source_hash_manifest"
  ],
  "properties": {
    "journey_id": {
      "const": "j179-migration-from-servicenow-itsm-to-oyatie-itsm"
    },
    "tenant_id": {
      "const": "meridian-logistics"
    },
    "source_system": {
      "const": "servicenow-prod-itil"
    },
    "incumbent_system": {
      "const": "ServiceNow ITSM"
    },
    "target_system": {
      "const": "Oyatie ITSM"
    },
    "extraction_mechanism": {
      "const": "ServiceNow Table API export plus attachment and journal-field replay"
    },
    "projection": {
      "const": "oyatie.itsm.service_graph_projection_v1"
    },
    "batch_id": {
      "type": "string",
      "pattern": "^batch-J[0-9]{3}-[0-9]{2}$"
    },
    "extracted_at": {
      "type": "string",
      "format": "date-time"
    },
    "objects": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "incident": {
          "type": "object",
          "description": "Incident ticket table",
          "required": [
            "sys_id",
            "number",
            "short_description",
            "priority"
          ],
          "properties": {
            "sys_id": {
              "type": "string"
            },
            "number": {
              "type": "string"
            },
            "short_description": {
              "type": "string"
            },
            "priority": {
              "type": "string"
            },
            "state": {
              "type": "string"
            },
            "assignment_group": {
              "type": "string"
            },
            "caller_id": {
              "type": "string"
            },
            "cmdb_ci": {
              "type": "string"
            }
          }
        },
        "change_request": {
          "type": "object",
          "description": "Change ticket table",
          "required": [
            "sys_id",
            "number",
            "type",
            "risk"
          ],
          "properties": {
            "sys_id": {
              "type": "string"
            },
            "number": {
              "type": "string"
            },
            "type": {
              "type": "string"
            },
            "risk": {
              "type": "string"
            },
            "state": {
              "type": "string"
            },
            "planned_start_date": {
              "type": "string"
            },
            "planned_end_date": {
              "type": "string"
            },
            "cmdb_ci": {
              "type": "string"
            }
          }
        },
        "problem": {
          "type": "object",
          "description": "Problem and RCA table",
          "required": [
            "sys_id",
            "number",
            "known_error",
            "root_cause"
          ],
          "properties": {
            "sys_id": {
              "type": "string"
            },
            "number": {
              "type": "string"
            },
            "known_error": {
              "type": "string"
            },
            "root_cause": {
              "type": "string"
            },
            "workaround": {
              "type": "string"
            },
            "state": {
              "type": "string"
            }
          }
        },
        "cmdb_ci": {
          "type": "object",
          "description": "Configuration item base table",
          "required": [
            "sys_id",
            "name",
            "sys_class_name",
            "operational_status"
          ],
          "properties": {
            "sys_id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "sys_class_name": {
              "type": "string"
            },
            "operational_status": {
              "type": "string"
            },
            "owned_by": {
              "type": "string"
            },
            "support_group": {
              "type": "string"
            }
          }
        },
        "sys_user": {
          "type": "object",
          "description": "User and fulfiller table",
          "required": [
            "sys_id",
            "user_name",
            "email",
            "active"
          ],
          "properties": {
            "sys_id": {
              "type": "string"
            },
            "user_name": {
              "type": "string"
            },
            "email": {
              "type": "string"
            },
            "active": {
              "type": "string"
            },
            "department": {
              "type": "string"
            },
            "manager": {
              "type": "string"
            }
          }
        }
      }
    },
    "row_count_manifest": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "object_name",
          "source_count",
          "target_count",
          "delta_count"
        ],
        "properties": {
          "object_name": {
            "enum": [
              "incident",
              "change_request",
              "problem",
              "cmdb_ci",
              "sys_user"
            ]
          },
          "source_count": {
            "type": "integer",
            "minimum": 0
          },
          "target_count": {
            "type": "integer",
            "minimum": 0
          },
          "delta_count": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "source_hash_manifest": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "object_name",
          "hash_algorithm",
          "hash_value"
        ],
        "properties": {
          "object_name": {
            "enum": [
              "incident",
              "change_request",
              "problem",
              "cmdb_ci",
              "sys_user"
            ]
          },
          "hash_algorithm": {
            "const": "sha256"
          },
          "hash_value": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64
          }
        }
      }
    }
  },
  "additionalProperties": false
}
