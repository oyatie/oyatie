{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oya.cloud/journeys/j159/schemas/recommender-invitation-form-v1.json",
  "title": "Cross-tenant recommender invitation form (AACSB-compatible)",
  "description": "Structured form for inviting a recommender from a work tenant to author a recommendation letter into a personal-tenant slot. Anchored to ADR-0311 personal-vs-work boundary, ADR-0244 tenant scoping, AACSB Standard 9 records retention, and US-FERPA recommendation-letter confidentiality.",
  "type": "object",
  "required": [
    "form_id",
    "form_version",
    "applicant_tenant",
    "applicant_principal",
    "school_target",
    "recommender_invitee_email",
    "recommender_invitee_tenant_hint",
    "recommender_role_observed",
    "recommender_role_context",
    "letter_deadline",
    "letter_prompt",
    "capability_scope",
    "capability_auto_revoke_at",
    "retention_policy",
    "ferpa_confidentiality_acknowledged",
    "diacritic_policy"
  ],
  "properties": {
    "form_id": {
      "type": "string",
      "pattern": "^rec-invite-form-[a-z0-9-]+$",
      "description": "Stable form id for audit chain reference"
    },
    "form_version": {
      "type": "string",
      "const": "v1.0.0"
    },
    "applicant_tenant": {
      "type": "string",
      "enum": ["saanvi.mehta.personal"],
      "description": "Personal-tenant of the applicant (Saanvi Mehta)"
    },
    "applicant_principal": {
      "type": "string",
      "pattern": "^[a-z0-9._-]+:[a-z]+$",
      "description": "Personal-tenant principal id; UTF-8 NFC"
    },
    "school_target": {
      "type": "object",
      "required": ["school_id", "admissions_tenant", "round", "cycle", "deadline_for_recommender"],
      "properties": {
        "school_id": {
          "type": "string",
          "enum": ["wharton", "stanford_gsb", "hbs", "chicago_booth", "insead_sg_fr"]
        },
        "admissions_tenant": {
          "type": "string"
        },
        "round": {
          "type": "string",
          "enum": ["round_1", "round_2", "round_3", "round_4_consortium"]
        },
        "cycle": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{4}$",
          "examples": ["2026-2027"]
        },
        "deadline_for_recommender": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "recommender_invitee_email": {
      "type": "string",
      "format": "email"
    },
    "recommender_invitee_tenant_hint": {
      "type": "string",
      "description": "Best-guess work tenant of invitee (e.g. stripe-india-pvt-ltd); resolved at acceptance time"
    },
    "recommender_role_observed": {
      "type": "string",
      "enum": [
        "current_manager",
        "former_manager",
        "current_skip_manager",
        "former_skip_manager",
        "current_peer",
        "former_peer",
        "current_subordinate",
        "former_subordinate",
        "academic_advisor",
        "academic_professor",
        "client",
        "vendor",
        "mentor",
        "founder_co_founder",
        "other_professional"
      ]
    },
    "recommender_role_context": {
      "type": "object",
      "required": ["relationship_years", "primary_observation_period"],
      "properties": {
        "relationship_years": {
          "type": "number",
          "minimum": 0.25,
          "maximum": 40
        },
        "primary_observation_period": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{4}$",
          "examples": ["2022-2026", "2017-2019"]
        },
        "primary_role_at_observation": {
          "type": "string",
          "examples": ["Director of Product, Stripe Connect APAC", "VP Digital Transformation, Marico"]
        },
        "interaction_frequency": {
          "type": "string",
          "enum": ["daily", "weekly", "biweekly", "monthly", "quarterly", "occasional"]
        }
      }
    },
    "letter_deadline": {
      "type": "string",
      "format": "date-time"
    },
    "letter_prompt": {
      "type": "object",
      "required": ["prompt_text", "word_count_min", "word_count_max", "structured_questions"],
      "properties": {
        "prompt_text": {
          "type": "string",
          "minLength": 32,
          "maxLength": 4096,
          "description": "School-provided recommendation prompt; UTF-8 NFC preserved"
        },
        "word_count_min": {
          "type": "integer",
          "minimum": 200
        },
        "word_count_max": {
          "type": "integer",
          "maximum": 2500
        },
        "structured_questions": {
          "type": "array",
          "minItems": 0,
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": ["question_id", "question_text", "answer_type"],
            "properties": {
              "question_id": {"type": "string"},
              "question_text": {"type": "string"},
              "answer_type": {
                "type": "string",
                "enum": ["likert_5", "likert_7", "ranked_select", "free_text", "narrative_paragraph"]
              },
              "is_required": {"type": "boolean"}
            }
          }
        }
      }
    },
    "capability_scope": {
      "type": "object",
      "required": ["capability_class", "scope_label", "scope_actions_allowed", "scope_actions_forbidden", "is_propagable"],
      "properties": {
        "capability_class": {
          "type": "string",
          "const": "recommendation_letter_write_once"
        },
        "scope_label": {
          "type": "string",
          "const": "write_once_no_browse"
        },
        "scope_actions_allowed": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "drive.write_recommendation_letter_to_slot",
              "notes.cross_tenant_slot.append",
              "notes.cross_tenant_slot.final_submit"
            ]
          },
          "minItems": 3,
          "maxItems": 3
        },
        "scope_actions_forbidden": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "drive.list_folder",
              "drive.read_file",
              "drive.download_file",
              "drive.share_file",
              "tenancy.capability_propagate"
            ]
          },
          "minItems": 5
        },
        "is_propagable": {
          "type": "boolean",
          "const": false
        }
      }
    },
    "capability_auto_revoke_at": {
      "type": "string",
      "format": "date-time",
      "description": "Capability auto-revokes at this timestamp regardless of consumption state; typically end of application cycle"
    },
    "retention_policy": {
      "type": "object",
      "required": ["retention_years", "regulator_anchor"],
      "properties": {
        "retention_years": {
          "type": "integer",
          "minimum": 7,
          "maximum": 25,
          "default": 15,
          "description": "AACSB Standard 9 requires minimum 15 years for degree-applicant records"
        },
        "regulator_anchor": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "AACSB-Standard-9",
              "US-FERPA-34CFR99.31",
              "EU-GDPR-Article-17-retention-vs-erasure-balance",
              "IN-DPDP-2023-Section-12-data-fiduciary",
              "UK-DPA-2018"
            ]
          },
          "minItems": 1
        }
      }
    },
    "ferpa_confidentiality_acknowledged": {
      "type": "object",
      "required": ["acknowledged", "applicant_waived_right_to_inspect", "waiver_at"],
      "properties": {
        "acknowledged": {"type": "boolean", "const": true},
        "applicant_waived_right_to_inspect": {
          "type": "boolean",
          "description": "Per US-FERPA 34 CFR 99.31; applicant may waive right to inspect recommendation letter"
        },
        "waiver_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "diacritic_policy": {
      "type": "object",
      "required": ["unicode_normalization", "diacritics_preserved"],
      "properties": {
        "unicode_normalization": {
          "type": "string",
          "const": "NFC"
        },
        "diacritics_preserved": {
          "type": "boolean",
          "const": true
        },
        "devanagari_canonical": {
          "type": "boolean"
        },
        "applicant_legal_name_strict_form": {
          "type": "string",
          "description": "Strict legal name with diacritics; UTF-8 NFC"
        },
        "applicant_legal_name_devanagari_form": {
          "type": "string",
          "description": "Optional Devanagari form of applicant's legal name"
        },
        "applicant_passport_ascii_name": {
          "type": "string",
          "description": "ICAO 9303 passport ASCII form; used only where required (e.g., GMAC GMAT score-send)"
        }
      }
    },
    "audit_emission_class": {
      "type": "object",
      "required": ["invite_sent_class", "invite_accepted_class", "letter_drafted_class", "letter_final_class", "capability_revoked_class"],
      "properties": {
        "invite_sent_class": {
          "type": "string",
          "const": "EVT-J159-RECOMMENDER-INVITE-ARRIVED-002a"
        },
        "invite_accepted_class": {
          "type": "string",
          "const": "EVT-J159-RECOMMENDER-ACCEPT-002"
        },
        "letter_drafted_class": {
          "type": "string",
          "const": "EVT-J159-RECOMMENDER-PRIYA-DRAFT-002b"
        },
        "letter_final_class": {
          "type": "string",
          "const": "EVT-J159-RECOMMENDER-PRIYA-FINAL-002c"
        },
        "capability_revoked_class": {
          "type": "string",
          "const": "EVT-J159-RECOMMENDER-CAP-REVOKED-013-test"
        }
      }
    },
    "applicant_legal_name_devanagari": {
      "type": "string",
      "description": "Optional. The applicant's name in Devanagari (NFC); rendered where supported. Must NOT be normalized to ASCII unless ICAO 9303 exception applies.",
      "examples": ["सान्वी मेहता"]
    },
    "applicant_legal_name_latin": {
      "type": "string",
      "description": "The applicant's name in Latin (UTF-8 NFC); diacritics preserved.",
      "examples": ["Saanvi Mehta"]
    },
    "tenant_residency_invariants": {
      "type": "object",
      "required": ["applicant_personal_tenant_cell", "school_admissions_tenant_cell"],
      "properties": {
        "applicant_personal_tenant_cell": {
          "type": "string",
          "const": "ap-mumbai-primary"
        },
        "school_admissions_tenant_cell": {
          "type": "string",
          "enum": ["us-east-virginia-secondary", "sg-singapore-secondary", "eu-paris-tertiary"]
        },
        "cross_cell_audit_dual_seal": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "doctrine_anchor": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "ADR-0311",
          "ADR-0244",
          "ADR-0243",
          "ADR-0263",
          "ADR-0252",
          "ADR-0255",
          "AACSB-Standard-9",
          "US-FERPA-34CFR99.31",
          "EU-GDPR",
          "IN-DPDP-2023"
        ]
      },
      "minItems": 5
    }
  },
  "examples": [
    {
      "form_id": "rec-invite-form-saanvi-wharton-r2-2027-primary-priya",
      "form_version": "v1.0.0",
      "applicant_tenant": "saanvi.mehta.personal",
      "applicant_principal": "saanvi.mehta.personal:saanvi",
      "school_target": {
        "school_id": "wharton",
        "admissions_tenant": "wharton-mba-admissions-us",
        "round": "round_2",
        "cycle": "2026-2027",
        "deadline_for_recommender": "2026-12-22T23:59:59-05:00"
      },
      "recommender_invitee_email": "priya.krishnamurthy@stripe-india-pvt-ltd",
      "recommender_invitee_tenant_hint": "stripe-india-pvt-ltd",
      "recommender_role_observed": "current_manager",
      "recommender_role_context": {
        "relationship_years": 4.5,
        "primary_observation_period": "2022-2026",
        "primary_role_at_observation": "Director of Product, Stripe Connect APAC",
        "interaction_frequency": "weekly"
      },
      "letter_deadline": "2026-12-22T23:59:59-05:00",
      "letter_prompt": {
        "prompt_text": "Provide an honest assessment of the candidate's professional performance, leadership, and growth areas. Wharton seeks recommenders who can speak with specificity to the candidate's impact and development.",
        "word_count_min": 600,
        "word_count_max": 1200,
        "structured_questions": [
          {
            "question_id": "q1",
            "question_text": "How would you rate the candidate against peers at the same career stage?",
            "answer_type": "likert_7",
            "is_required": true
          },
          {
            "question_id": "q2",
            "question_text": "Describe a specific instance where the candidate demonstrated exceptional judgment.",
            "answer_type": "narrative_paragraph",
            "is_required": true
          }
        ]
      },
      "capability_scope": {
        "capability_class": "recommendation_letter_write_once",
        "scope_label": "write_once_no_browse",
        "scope_actions_allowed": [
          "drive.write_recommendation_letter_to_slot",
          "notes.cross_tenant_slot.append",
          "notes.cross_tenant_slot.final_submit"
        ],
        "scope_actions_forbidden": [
          "drive.list_folder",
          "drive.read_file",
          "drive.download_file",
          "drive.share_file",
          "tenancy.capability_propagate"
        ],
        "is_propagable": false
      },
      "capability_auto_revoke_at": "2027-01-06T23:59:59-05:00",
      "retention_policy": {
        "retention_years": 15,
        "regulator_anchor": [
          "AACSB-Standard-9",
          "US-FERPA-34CFR99.31",
          "EU-GDPR-Article-17-retention-vs-erasure-balance"
        ]
      },
      "ferpa_confidentiality_acknowledged": {
        "acknowledged": true,
        "applicant_waived_right_to_inspect": true,
        "waiver_at": "2026-12-06T21:42:00+05:30"
      },
      "diacritic_policy": {
        "unicode_normalization": "NFC",
        "diacritics_preserved": true,
        "devanagari_canonical": true,
        "applicant_legal_name_strict_form": "Saanvi Mehta",
        "applicant_legal_name_devanagari_form": "सान्वी मेहता",
        "applicant_passport_ascii_name": "SAANVI MEHTA"
      },
      "applicant_legal_name_latin": "Saanvi Mehta",
      "applicant_legal_name_devanagari": "सान्वी मेहता",
      "tenant_residency_invariants": {
        "applicant_personal_tenant_cell": "ap-mumbai-primary",
        "school_admissions_tenant_cell": "us-east-virginia-secondary",
        "cross_cell_audit_dual_seal": true
      },
      "doctrine_anchor": [
        "ADR-0311",
        "ADR-0244",
        "ADR-0263",
        "AACSB-Standard-9",
        "US-FERPA-34CFR99.31"
      ]
    }
  ]
}
