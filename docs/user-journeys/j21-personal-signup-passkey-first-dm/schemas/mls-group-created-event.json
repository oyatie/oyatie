{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oyatie.app/schemas/j21/mls-group-created-event.json",
  "title": "MLSGroupCreatedEvent",
  "version": "1.0.0",
  "_meta": {
    "purpose": "Event emitted by messenger µservice when a new MLS (RFC 9420) group is created — for j21, on Yejin's first send to Soyeon.",
    "binding_adr": "feedback_mls_rfc_9420_e2ee_personal_messenger",
    "industry_citations": [
      "RFC 9420 (MLS, July 2023) initial group genesis",
      "Signal Sealed Sender (2018)"
    ],
    "related_adrs": ["ADR-0243", "ADR-0244", "ADR-0252", "ADR-0263"],
    "status": "Accepted"
  },
  "type": "object",
  "required": ["event_class", "event_id", "group_id", "creator_principal_id", "member_principal_ids", "epoch", "cipher_suite", "created_at_hlc"],
  "properties": {
    "event_class": { "const": "oyatie.messenger.group.created" },
    "event_id": { "type": "string", "format": "uuidv7" },
    "group_id": { "type": "string", "format": "uuidv7" },
    "creator_principal_id": { "type": "string", "format": "uuidv7" },
    "member_principal_ids": {
      "type": "array",
      "items": { "type": "string", "format": "uuidv7" },
      "minItems": 2,
      "maxItems": 1000,
      "description": "Group members at genesis. MLS supports up to thousands of members; for direct-DM, exactly 2."
    },
    "epoch": { "type": "integer", "minimum": 0, "const": 0, "description": "MLS epoch at genesis is 0." },
    "cipher_suite": {
      "type": "string",
      "enum": [
        "MLS_128_DHKEMX25519_AES128GCM_SHA256_Ed25519",
        "MLS_128_DHKEMX25519_CHACHA20POLY1305_SHA256_Ed25519",
        "MLS_256_DHKEMP384_AES256GCM_SHA384_P384",
        "MLS_256_DHKEMX25519_AES256GCM_SHA512_Ed448"
      ],
      "description": "Per RFC 9420 §17.1 ciphersuite registry."
    },
    "created_at_hlc": { "type": "string" },
    "home_cell": { "type": "string", "pattern": "^[a-z]{2}-[a-z]+-[0-9]+$" },
    "tenant_id": { "type": "string", "const": "oyatie.b2c.personal" }
  },
  "additionalProperties": false
}
