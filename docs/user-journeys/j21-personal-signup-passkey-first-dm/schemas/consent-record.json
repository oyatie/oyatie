{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oyatie.app/schemas/j21/consent-record.json",
  "title": "ConsentRecord",
  "version": "1.0.0",
  "_meta": {
    "purpose": "Per-purpose consent record per ADR-0272 cookie/consent doctrine. For j21 Yejin grants service_operation only.",
    "binding_adr": "ADR-0272",
    "industry_citations": ["GDPR Article 7", "KR-PIPA Article 22"],
    "related_adrs": ["ADR-0244", "ADR-0272"],
    "status": "Accepted"
  },
  "type": "object",
  "required": ["consent_id", "principal_id", "tenant_id", "purpose", "granted_at_hlc", "granted_by", "withdrawal_url", "locale_at_grant", "pack_at_grant"],
  "properties": {
    "consent_id": { "type": "string", "format": "uuidv7" },
    "principal_id": { "type": "string", "format": "uuidv7" },
    "tenant_id": { "type": "string" },
    "purpose": {
      "type": "string",
      "enum": [
        "service_operation",
        "anonymous_analytics",
        "marketing_notifications",
        "recommendation_features",
        "third_party_sharing",
        "biometric_processing",
        "minor_parental_oversight",
        "research_participation"
      ],
      "description": "Per-purpose taxonomy from packs/_canonical/consent-purposes.yaml."
    },
    "granted_at_hlc": { "type": "string" },
    "granted_by": {
      "type": "string",
      "enum": ["principal_self", "parent_legal_guardian", "tenant_admin", "regulator_court_order"],
      "description": "Granting actor per ADR-0292 for minors; for j21 always principal_self."
    },
    "withdrawal_url": { "type": "string", "format": "uri" },
    "locale_at_grant": { "type": "string", "pattern": "^[a-z]{2}-[A-Z]{2}$" },
    "pack_at_grant": { "type": "string" },
    "revoked_at_hlc": { "type": ["string", "null"] },
    "revoked_by": { "type": ["string", "null"] }
  },
  "additionalProperties": false
}
