{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oya.cloud/journeys/j160/schemas/cleaning-bid-line-items-csn-en-13549-v1.json",
  "title": "Cleaning bid line-items (ČSN-EN-13549 + CZ-VAT-235/2004)",
  "description": "Structured per-zone × frequency × quality-grade line items for an industrial cleaning bid. ČSN-EN-13549:2001 cleaning-quality grade scoring + CZ-VAT-235/2004 line-level VAT handling. Per-zone m² × frequency × ČSN grade × CZK breakdown into labor, supplies, equipment-amortization.",
  "type": "object",
  "required": [
    "line_items_id",
    "schema_version",
    "vendor_tenant",
    "client_tenant",
    "bid_id",
    "currency",
    "vat_rate_pct",
    "contract_months",
    "zones",
    "monthly_total_excl_vat",
    "contract_total_excl_vat",
    "contract_total_with_vat",
    "year_2_escalation_pct",
    "csn_en_13549_compliance_attestation",
    "iso_9001_compliance_attestation"
  ],
  "properties": {
    "line_items_id": {
      "type": "string",
      "pattern": "^cleaning-bid-line-items-[a-z0-9-]+$",
      "examples": ["cleaning-bid-line-items-uklid-horak-polycraft-2027"]
    },
    "schema_version": {
      "type": "string",
      "const": "v1.0.0"
    },
    "vendor_tenant": {
      "type": "string",
      "examples": ["uklid-horak-sro-plzen-cz"]
    },
    "client_tenant": {
      "type": "string",
      "examples": ["polycraft-bohemia-as-plzen-cz"]
    },
    "bid_id": {
      "type": "string"
    },
    "currency": {
      "type": "string",
      "const": "CZK"
    },
    "vat_rate_pct": {
      "type": "number",
      "const": 21.0,
      "description": "Czech standard VAT rate (cleaning is standard-rated)"
    },
    "contract_months": {
      "type": "integer",
      "minimum": 1,
      "maximum": 60
    },
    "zones": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/components/zone"
      }
    },
    "monthly_total_excl_vat": {
      "type": "integer",
      "description": "Sum of all zones' monthly totals, in CZK (integer)"
    },
    "contract_total_excl_vat": {
      "type": "integer"
    },
    "contract_total_with_vat": {
      "type": "integer"
    },
    "year_2_escalation_pct": {
      "type": "number",
      "description": "Year-2 escalation indexed to Czech CPI; default 3.1%",
      "default": 3.1
    },
    "csn_en_13549_compliance_attestation": {
      "type": "object",
      "required": ["protocol_attached", "measurement_frequency_months", "ramp_up_weeks_to_grade_4", "claw_back_clause_present"],
      "properties": {
        "protocol_attached": {"type": "boolean", "enum": [true]},
        "measurement_frequency_months": {"type": "integer", "default": 1},
        "ramp_up_weeks_to_grade_4": {"type": "integer", "default": 12},
        "claw_back_clause_present": {"type": "boolean"},
        "claw_back_pct": {"type": "number", "examples": [15]},
        "independent_lab_verification": {"type": "boolean"}
      }
    },
    "iso_9001_compliance_attestation": {
      "type": "object",
      "required": ["cert_id", "cert_issuer", "cert_valid_through", "qms_audit_frequency"],
      "properties": {
        "cert_id": {"type": "string"},
        "cert_issuer": {"type": "string", "examples": ["TÜV SÜD Czech", "DNV Czech"]},
        "cert_valid_through": {"type": "string", "format": "date"},
        "qms_audit_frequency": {"type": "string", "enum": ["quarterly", "biannual", "annual"]}
      }
    },
    "additional_attestations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "attestation_class": {"type": "string", "enum": ["ISSA-CIMS-2024", "CSN-EN-407-glove-rating", "CSN-EN-374-chemical-protection", "EU-Ecolabel-product", "EMAS-environmental"]},
          "evidence_ref": {"type": "string"}
        }
      }
    },
    "supplies_inventory": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["product_name", "supplier", "monthly_quantity", "unit", "monthly_cost_czk"],
        "properties": {
          "product_name": {"type": "string"},
          "supplier": {"type": "string"},
          "monthly_quantity": {"type": "number"},
          "unit": {"type": "string"},
          "monthly_cost_czk": {"type": "integer"},
          "eu_ecolabel": {"type": "boolean"},
          "csn_compatible": {"type": "boolean"}
        }
      }
    },
    "equipment_amortization": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["equipment_name", "manufacturer", "purchase_or_lease", "monthly_amortization_czk"],
        "properties": {
          "equipment_name": {"type": "string", "examples": ["Tennant T7AMR autoscrubber", "Kärcher BD 50/50", "Vileda UltraSpeed Pro"]},
          "manufacturer": {"type": "string", "examples": ["Tennant", "Kärcher", "Vileda"]},
          "model": {"type": "string"},
          "purchase_or_lease": {"type": "string", "enum": ["purchase", "lease", "rental"]},
          "monthly_amortization_czk": {"type": "integer"},
          "operator_cert_required": {"type": "boolean"}
        }
      }
    },
    "crew_composition": {
      "type": "object",
      "required": ["total_dedicated_fte", "team_lead_count", "cleaner_count"],
      "properties": {
        "total_dedicated_fte": {"type": "integer", "examples": [5]},
        "team_lead_count": {"type": "integer", "examples": [1]},
        "cleaner_count": {"type": "integer", "examples": [4]},
        "named_assigned_employees": {
          "type": "array",
          "items": {"type": "string"},
          "description": "UTF-8 NFC names of assigned employees"
        },
        "new_hires_planned": {"type": "integer"},
        "internal_rotations_planned": {"type": "integer"}
      }
    },
    "weekend_cover_sla": {
      "type": "object",
      "properties": {
        "saturday_response_hours": {"type": "number", "examples": [4]},
        "sunday_response_hours": {"type": "number", "examples": [8]},
        "emergency_response_hours": {"type": "number", "examples": [2]}
      }
    },
    "holiday_pay_surcharge_pct": {
      "type": "number",
      "examples": [75],
      "description": "Czech labor code §115 minimum surcharge for state-holiday work"
    },
    "data_processor_obligations": {
      "type": "object",
      "required": ["gdpr_data_processor", "cz_110_2019_acknowledged", "facility_access_records_handling"],
      "properties": {
        "gdpr_data_processor": {"type": "boolean", "enum": [true]},
        "cz_110_2019_acknowledged": {"type": "boolean", "enum": [true]},
        "facility_access_records_handling": {"type": "string", "enum": ["sub_processor", "controller_at_client", "joint_controller_not_typical"]},
        "audit_chain_retention_years": {"type": "integer", "default": 7}
      }
    },
    "liability_cap_czk": {
      "type": "integer",
      "examples": [12000000]
    },
    "insurance_cover_czk_aggregate": {
      "type": "integer",
      "examples": [100000000]
    }
  },
  "components": {
    "zone": {
      "type": "object",
      "required": ["zone_id", "zone_name_cs", "area_m2", "frequency", "csn_en_13549_grade", "monthly_labor_cost_czk", "monthly_supplies_cost_czk", "monthly_equipment_amortization_czk", "monthly_total_czk"],
      "properties": {
        "zone_id": {"type": "string"},
        "zone_name_cs": {"type": "string", "description": "Czech UTF-8 NFC"},
        "zone_name_en": {"type": "string"},
        "area_m2": {"type": "integer"},
        "frequency": {
          "type": "string",
          "enum": [
            "nightly",
            "5_days_per_week",
            "nightly_plus_weekly_deep",
            "nightly_plus_biweekly_deep",
            "nightly_plus_monthly_deep",
            "5dpw_plus_monthly_deep",
            "weekly",
            "biweekly",
            "monthly",
            "quarterly"
          ]
        },
        "csn_en_13549_grade": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "description": "1 = casual, 5 = critical (food/pharma); 4 = standard industrial"
        },
        "monthly_labor_cost_czk": {"type": "integer"},
        "monthly_supplies_cost_czk": {"type": "integer"},
        "monthly_equipment_amortization_czk": {"type": "integer"},
        "monthly_total_czk": {"type": "integer"},
        "specific_protocol_notes_cs": {"type": "string"},
        "specific_equipment_required": {"type": "array", "items": {"type": "string"}}
      }
    }
  },
  "examples": [
