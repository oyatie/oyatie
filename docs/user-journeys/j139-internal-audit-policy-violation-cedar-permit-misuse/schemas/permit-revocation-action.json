{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.oyatie.dev/user-journeys/j139/permit-revocation-action.json",
  "title": "PermitRevocationAction",
  "description": "Envelope for revoking a Cedar permit overlay during investigation remediation.",
  "_meta": {"binding_adr": "ADR-0243", "related_adrs": ["ADR-0311","ADR-0310"], "schema_version": "v1.0.0"},
  "type": "object",
  "required": ["action_id", "overlay_id", "subject_principal", "revoked_by_principal", "revoked_at", "investigation_case_ref", "reason", "audit_seal_id"],
  "properties": {
    "action_id": {"type": "string"},
    "overlay_id": {"type": "string"},
    "subject_principal": {"type": "string", "format": "email"},
    "permit": {"type": "string"},
    "tenant_id": {"type": "string"},
    "revoked_by_principal": {"type": "string", "format": "email"},
    "dual_control_signer": {"type": "string", "format": "email"},
    "revoked_at": {"type": "string", "format": "date-time"},
    "investigation_case_ref": {"type": "string"},
    "reason": {"type": "string"},
    "audit_seal_id": {"type": "string"},
    "reversible": {"type": "boolean", "default": true}
  },
  "additionalProperties": false
}
