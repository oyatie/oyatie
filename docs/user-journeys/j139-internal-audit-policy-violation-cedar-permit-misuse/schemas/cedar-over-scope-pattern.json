{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.oyatie.com/user-journeys/j139/cedar-over-scope-pattern.json",
  "title": "CedarOverScopePattern",
  "description": "Pattern descriptor for cumulative Cedar permit scope-creep detection.",
  "_meta": {"binding_adr": "ADR-0307", "related_adrs": ["ADR-0311","ADR-0243"], "schema_version": "v1.0.0"},
  "type": "object",
  "required": ["pattern_id", "subject_principal", "tenant_id", "grants_observed", "cumulative_scope_estimate", "computed_at"],
  "properties": {
    "pattern_id": {"type": "string"},
    "subject_principal": {"type": "string", "format": "email"},
    "tenant_id": {"type": "string"},
    "subject_role": {"type": "string"},
    "window_start": {"type": "string", "format": "date-time"},
    "window_end": {"type": "string", "format": "date-time"},
    "grants_observed": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["permit", "granted_at", "granted_by"],
        "properties": {
          "permit": {"type": "string"},
          "granted_at": {"type": "string", "format": "date-time"},
          "granted_by": {"type": "string"},
          "expires_at": {"type": "string", "format": "date-time"},
          "use_count": {"type": "integer"},
          "concerns": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "cumulative_scope_estimate": {
      "type": "object",
      "properties": {
        "tier": {"enum": ["baseline", "elevated", "admin", "super_admin"]},
        "overlap_pct_with_admin": {"type": "integer", "minimum": 0, "maximum": 100}
      }
    },
    "confidence_pct": {"type": "integer", "minimum": 0, "maximum": 100},
    "severity": {"enum": ["LOW", "MED", "HIGH", "CRITICAL"]},
    "indicators": {"type": "array", "items": {"type": "string"}},
    "computed_at": {"type": "string", "format": "date-time"},
    "audit_seal_id": {"type": "string"}
  },
  "additionalProperties": false
}
