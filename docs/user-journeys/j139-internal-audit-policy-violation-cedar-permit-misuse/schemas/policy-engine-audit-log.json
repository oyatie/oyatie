{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.oyatie.dev/user-journeys/j139/policy-engine-audit-log.json",
  "title": "PolicyEngineAuditLog",
  "description": "Audit log entry for a single Cedar policy evaluation event; queryable by internal audit per ADR-0311.",
  "_meta": {"binding_adr": "ADR-0263", "related_adrs": ["ADR-0028","ADR-0243"], "schema_version": "v1.0.0"},
  "type": "object",
  "required": ["evaluation_id", "principal", "action", "resource_ref", "decision", "policy_id", "evaluated_at", "tenant_id"],
  "properties": {
    "evaluation_id": {"type": "string"},
    "principal": {
      "type": "object",
      "required": ["id", "audience_type"],
      "properties": {
        "id": {"type": "string"},
        "audience_type": {"type": "string"},
        "tenant_id": {"type": "string"}
      }
    },
    "action": {"type": "string"},
    "resource_ref": {"type": "string"},
    "resource_class": {"type": "string"},
    "decision": {"enum": ["PERMIT", "DENY", "FORBID"]},
    "decision_reason": {"type": "string"},
    "policy_id": {"type": "string"},
    "policy_version": {"type": "string"},
    "context_attributes": {"type": "object"},
    "evaluated_at": {"type": "string", "format": "date-time"},
    "tenant_id": {"type": "string"},
    "trace_id": {"type": "string"},
    "span_id": {"type": "string"},
    "audit_seal_id": {"type": "string"}
  },
  "additionalProperties": false
}
