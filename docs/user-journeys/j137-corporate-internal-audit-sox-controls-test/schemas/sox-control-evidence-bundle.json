{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.oyatie.com/user-journeys/j137/sox-control-evidence-bundle.json",
  "title": "SoxControlEvidenceBundle",
  "description": "Evidence pack envelope for a single SOX 404 sample. The bundle is sealed as one audit-chain leaf and aggregated into the quarterly evidence pack.",
  "_meta": {
    "binding_adr": "ADR-0028",
    "related_adrs": ["ADR-0311", "ADR-0263", "ADR-0310"],
    "schema_version": "v1.0.0"
  },
  "type": "object",
  "required": ["bundle_id", "audit_case_id", "sample_ref", "control_id", "evidence_leaves", "personal_tenant_deny_summary", "assembled_at", "sealed_at", "merkle_leaf_hash"],
  "properties": {
    "bundle_id": {"type": "string", "pattern": "^eb-[a-z0-9-]+$"},
    "audit_case_id": {"type": "string"},
    "sample_ref": {
      "type": "object",
      "required": ["sample_index", "invoice_id", "stratum"],
      "properties": {
        "sample_index": {"type": "integer"},
        "invoice_id": {"type": "string"},
        "stratum": {"enum": ["A", "B", "C", "D"]},
        "amount_usd": {"type": "number"}
      }
    },
    "control_id": {"enum": ["RC-01", "RC-02", "RC-03", "RC-04", "RC-05", "RC-06", "RC-07"]},
    "evidence_leaves": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["leaf_class", "leaf_hash", "source_microservice"],
        "properties": {
          "leaf_class": {"enum": ["payments_approval_chain", "messenger_thread", "mail_thread", "workflow_execution_log", "audit_chain_inner_seal"]},
          "leaf_hash": {"type": "string", "pattern": "^0x[a-f0-9]{64}$"},
          "source_microservice": {"type": "string"},
          "source_resource_id": {"type": "string"},
          "byte_count": {"type": "integer"},
          "sealed_at": {"type": "string", "format": "date-time"}
        }
      }
    },
    "personal_tenant_deny_summary": {
      "type": "object",
      "required": ["count", "principal_classes"],
      "properties": {
        "count": {"type": "integer", "minimum": 0},
        "principal_classes": {
          "type": "array",
          "items": {"enum": ["personal_tenant_owned", "conglomerate_sibling_owned"]}
        }
      }
    },
    "auto_flags": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "flag_type": {"type": "string"},
          "confidence_pct": {"type": "integer", "minimum": 0, "maximum": 100},
          "keyword_match": {"type": "string"},
          "needs_walkthrough": {"type": "boolean"}
        }
      }
    },
    "assembled_at": {"type": "string", "format": "date-time"},
    "sealed_at": {"type": "string", "format": "date-time"},
    "merkle_leaf_hash": {"type": "string", "pattern": "^0x[a-f0-9]{64}$"},
    "tenant_id": {"type": "string"},
    "cell_tier": {"type": "integer", "minimum": 0, "maximum": 4},
    "pack_set": {"type": "array", "items": {"type": "string"}},
    "trace_id": {"type": "string"}
  },
  "additionalProperties": false
}
