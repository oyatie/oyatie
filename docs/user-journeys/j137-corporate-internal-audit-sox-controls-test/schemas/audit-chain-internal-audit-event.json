{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.oyatie.com/user-journeys/j137/audit-chain-internal-audit-event.json",
  "title": "AuditChainInternalAuditEvent",
  "description": "Sealed audit-chain leaf emitted by every internal-audit-bound action. Extends the canonical AuditEventSealed envelope per ADR-0028 + ADR-0263.",
  "_meta": {
    "binding_adr": "ADR-0263",
    "related_adrs": ["ADR-0028", "ADR-0311", "ADR-0310"],
    "schema_version": "v1.0.0"
  },
  "type": "object",
  "required": ["audit_id", "class", "binding_adr", "actor", "subject", "action", "cedar_decision", "tenant_id", "audit_case_id", "cell_tier", "pack_set", "timestamp", "merkle_proof"],
  "properties": {
    "audit_id": {"type": "string", "pattern": "^audit:[a-f0-9]+$"},
    "class": {
      "enum": [
        "InternalAuditCaseCreated",
        "InternalAuditPrincipalResolved",
        "CedarPermitBatchDraftAllocated",
        "CedarPermitBatchDraftSealed",
        "DualControlNotificationSent",
        "DualControlNotificationDelivered",
        "CedarPermitCoSigned",
        "CedarPermitBatchActivated",
        "CedarPermitBatchActivatedSealed",
        "InternalAuditSamplePullRequested",
        "SamplePullJobStarted",
        "PaymentsApprovalChainExported",
        "MessengerArchiveRead",
        "MailArchiveRead",
        "WorkflowExecutionLogRead",
        "AuditChainSealEvidenceRead",
        "SamplePullEvidenceSealed",
        "MessengerPersonalTenantReadDenied",
        "MailPersonalTenantReadDenied",
        "ConglomerateSiblingTenantReadDenied",
        "AuditChainBatchRead",
        "EvidencePackManifestAssembled",
        "AuditPackSignedByDirector",
        "AuditPackCoSignedByChair",
        "EvidencePackRootSealed",
        "ExternalAuditorHandoffRequested",
        "SignedHandoffURLGenerated",
        "ExternalAuditorHandoffSealed",
        "ExternalAuditorPackFetched",
        "ExternalAuditorMerkleVerified",
        "AuditCaseCloseRequested",
        "AuditCaseClosed",
        "CedarPermitBatchRevoked",
        "AuditCaseClosureSealed",
        "AuditCaseExpired",
        "CedarPermitCoSignAttemptDenied",
        "InternalAuditCaseCreationAttemptDenied",
        "DirectPersonalTenantReadAttemptDenied",
        "MalformedAuditFilterRejected",
        "ExternalAuditorHandoffAttemptDenied"
      ]
    },
    "binding_adr": {"type": "string", "pattern": "^ADR-[0-9]{4}$"},
    "actor": {
      "type": "object",
      "properties": {
        "spiffe_id": {"type": "string"},
        "principal_slug": {"type": "string"},
        "audience_type": {"type": "string"},
        "attested_at": {"type": "string", "format": "date-time"}
      }
    },
    "subject": {
      "type": "object",
      "properties": {
        "user": {"type": "string"},
        "tenant": {"type": "string"},
        "principal_class": {"enum": ["work_tenant_owned", "personal_tenant_owned", "conglomerate_sibling_owned", "external_counterparty", "system_internal"]}
      }
    },
    "action": {"type": "string"},
    "cedar_decision": {"enum": ["PERMIT", "DENY", "FORBID"]},
    "cedar_fragment_hash": {"type": "string"},
    "tenant_id": {"type": "string"},
    "audit_case_id": {"type": "string"},
    "cell_tier": {"type": "integer"},
    "pack_set": {"type": "array", "items": {"type": "string"}},
    "timestamp": {"type": "string", "format": "date-time"},
    "merkle_proof": {
      "type": "object",
      "required": ["tree_root", "leaf_hash"],
      "properties": {
        "tree_root": {"type": "string"},
        "leaf_hash": {"type": "string"},
        "path": {"type": "array", "items": {"type": "string"}}
      }
    },
    "observability": {
      "type": "object",
      "properties": {
        "trace_id": {"type": "string"},
        "span_id": {"type": "string"},
        "metric_emission": {"type": "string"}
      }
    }
  },
  "additionalProperties": false
}
