{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.oyatie.com/user-journeys/j137/cedar-internal-audit-permit-decision.json",
  "title": "CedarInternalAuditPermitDecision",
  "description": "Cedar decision envelope emitted for every internal-audit-bound action. Every PERMIT and every DENY (including the 3,645 personal-tenant denies in j137) is recorded as one of these.",
  "_meta": {
    "binding_adr": "ADR-0243",
    "related_adrs": ["ADR-0311", "ADR-0244", "ADR-0028"],
    "schema_version": "v1.0.0"
  },
  "type": "object",
  "required": ["decision_id", "principal", "action", "resource_class", "decision", "tenant_id", "audit_case_id", "evaluated_at"],
  "properties": {
    "decision_id": {"type": "string", "pattern": "^cd:[a-f0-9]+$"},
    "principal": {
      "type": "object",
      "required": ["id", "audience_type"],
      "properties": {
        "id": {"type": "string", "format": "email"},
        "audience_type": {"type": "string"},
        "tenant_id": {"type": "string"},
        "audit_case_id": {"type": ["string", "null"]}
      }
    },
    "action": {"type": "string"},
    "resource_class": {"type": "string"},
    "resource_tenant_id": {"type": "string"},
    "resource_principal_class": {"enum": ["work_tenant_owned", "personal_tenant_owned", "conglomerate_sibling_owned", "external_counterparty", "system_internal"]},
    "decision": {"enum": ["PERMIT", "DENY", "FORBID"]},
    "decision_reason": {"type": "string"},
    "cedar_policy_id": {"type": "string"},
    "cedar_fragment_hash": {"type": "string"},
    "tenant_id": {"type": "string"},
    "audit_case_id": {"type": "string"},
    "evaluated_at": {"type": "string", "format": "date-time"},
    "evaluation_latency_us": {"type": "integer"},
    "context_attributes": {
      "type": "object",
      "properties": {
        "dual_control_approval_at": {"type": ["string", "null"], "format": "date-time"},
        "audit_charter_active": {"type": "boolean"},
        "permit_window_start": {"type": "string", "format": "date-time"},
        "permit_window_end": {"type": "string", "format": "date-time"}
      }
    },
    "audit_chain_seal_id": {"type": "string", "pattern": "^audit:[a-f0-9]+$"},
    "trace_id": {"type": "string"},
    "span_id": {"type": "string"}
  },
  "additionalProperties": false
}
