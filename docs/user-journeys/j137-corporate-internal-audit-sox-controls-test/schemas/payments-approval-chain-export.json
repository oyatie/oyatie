{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.oyatie.com/user-journeys/j137/payments-approval-chain-export.json",
  "title": "PaymentsApprovalChainExport",
  "description": "Payments approval-graph export for SOX 404 audit. Every node carries Cedar evaluation outcome, principal context, and Merkle-leaf provenance.",
  "_meta": {
    "binding_adr": "ADR-0028",
    "related_adrs": ["ADR-0311", "ADR-0145"],
    "schema_version": "v1.0.0"
  },
  "type": "object",
  "required": ["export_id", "invoice_id", "amount_usd", "tenant_id", "exported_at", "nodes", "edges", "merkle_root"],
  "properties": {
    "export_id": {"type": "string", "pattern": "^pae-[a-z0-9-]+$"},
    "invoice_id": {"type": "string"},
    "amount_usd": {"type": "number"},
    "currency": {"type": "string", "default": "USD"},
    "tenant_id": {"type": "string"},
    "exported_at": {"type": "string", "format": "date-time"},
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["node_id", "stage", "actor_principal", "decided_at", "decision"],
        "properties": {
          "node_id": {"type": "string"},
          "stage": {"enum": ["order_intake", "credit_check", "sales_manager_review", "chief_revenue_approval", "billing_generation", "payment_receipt", "rev_rec_booking", "period_close"]},
          "actor_principal": {"type": "string", "format": "email"},
          "actor_role": {"type": "string"},
          "decided_at": {"type": "string", "format": "date-time"},
          "decision": {"enum": ["approved", "rejected", "delegated", "reversed", "pending"]},
          "decision_rationale": {"type": "string"},
          "merkle_leaf_hash": {"type": "string", "pattern": "^0x[a-f0-9]{64}$"},
          "cedar_decision_ref": {"type": "string"}
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from_node", "to_node", "transition_at"],
        "properties": {
          "from_node": {"type": "string"},
          "to_node": {"type": "string"},
          "transition_at": {"type": "string", "format": "date-time"},
          "transition_kind": {"enum": ["sequential_approval", "delegation", "reversal", "escalation"]}
        }
      }
    },
    "merkle_root": {"type": "string", "pattern": "^0x[a-f0-9]{64}$"},
    "cell_tier": {"type": "integer"},
    "pack_set": {"type": "array", "items": {"type": "string"}},
    "trace_id": {"type": "string"},
    "audit_case_id": {"type": "string"}
  },
  "additionalProperties": false
}
