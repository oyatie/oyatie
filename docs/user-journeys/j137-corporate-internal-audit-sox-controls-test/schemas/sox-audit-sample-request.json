{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.oyatie.dev/user-journeys/j137/sox-audit-sample-request.json",
  "title": "SoxAuditSampleRequest",
  "description": "Request to pull a SOX 404 sample for one invoice/control. Sent by Sam's audit pane to api-gateway; fan-routes to workflow-engine.audit_sample_planner.",
  "_meta": {
    "binding_adr": "ADR-0311",
    "related_adrs": ["ADR-0310", "ADR-0307", "ADR-0243", "ADR-0244", "ADR-0028"],
    "schema_version": "v1.0.0",
    "owner_microservice": "workflow-engine",
    "consumer_microservices": ["api-gateway", "ops-dashboard-control-center", "messenger", "mail", "payments", "audit-chain"]
  },
  "type": "object",
  "required": ["audit_case_id", "control_id", "sample_index", "invoice_ref", "tenant_id", "requestor_principal", "requestor_audience_type", "requested_at"],
  "properties": {
    "audit_case_id": {"type": "string", "pattern": "^ac-[a-z0-9-]+$"},
    "control_id": {"enum": ["RC-01", "RC-02", "RC-03", "RC-04", "RC-05", "RC-06", "RC-07"]},
    "sample_index": {"type": "integer", "minimum": 1},
    "stratum": {"enum": ["A", "B", "C", "D"]},
    "invoice_ref": {
      "type": "object",
      "required": ["invoice_id", "amount_usd", "approver_principal"],
      "properties": {
        "invoice_id": {"type": "string"},
        "amount_usd": {"type": "number"},
        "approver_principal": {"type": "string", "format": "email"},
        "sales_rep_principal": {"type": "string", "format": "email"},
        "customer_principal": {"type": "string", "format": "email"},
        "issued_at": {"type": "string", "format": "date-time"},
        "approved_at": {"type": "string", "format": "date-time"}
      }
    },
    "tenant_id": {"type": "string"},
    "requestor_principal": {"type": "string", "format": "email"},
    "requestor_audience_type": {"const": "B2B_INTERNAL_AUDIT"},
    "permit_batch_ref": {"type": "string"},
    "classification_window": {
      "type": "object",
      "required": ["start", "end"],
      "properties": {
        "start": {"type": "string", "format": "date-time"},
        "end": {"type": "string", "format": "date-time"}
      }
    },
    "evidence_targets": {
      "type": "array",
      "items": {
        "enum": ["payments_approval_chain", "messenger_archive", "mail_archive", "workflow_engine_log", "audit_chain_seal"]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "requested_at": {"type": "string", "format": "date-time"},
    "trace_id": {"type": "string"},
    "span_id": {"type": "string"}
  },
  "additionalProperties": false
}
