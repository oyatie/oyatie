{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oyatie.dev/schemas/user-journeys/j147/VerifiedFormerEmployerAttestation.json",
  "title": "VerifiedFormerEmployerAttestation",
  "type": "object",
  "_meta": {
    "doc_class": "Schema",
    "journey_id": "j147",
    "status": "draft",
    "owner": "identity (former-employer-tenant) issues; community (alumni) verifies",
    "consumers": ["community", "workflow-engine", "future-employer-recruiter"],
    "adr_anchors": ["ADR-0244", "ADR-0249", "ADR-0292", "ADR-0299", "ADR-0307", "ADR-0311"]
  },
  "required": [
    "attestation_id",
    "subject_principal",
    "subject_credential_id",
    "former_employer_tenant_id",
    "employment_start",
    "employment_end",
    "separation_cause",
    "issued_by_principal",
    "signature",
    "issued_at_hlc"
  ],
  "properties": {
    "attestation_id":            { "type": "string", "pattern": "^VFE-ATTEST-[A-Z0-9-]+$" },
    "subject_principal":         { "type": "string", "format": "uri" },
    "subject_credential_id":     { "type": "string", "description": "WebAuthn credential_id; bridges the personal tenant" },
    "former_employer_tenant_id": { "type": "string" },
    "employment_start":          { "type": "string", "format": "date" },
    "employment_end":            { "type": "string", "format": "date" },
    "separation_cause":          { "type": "string", "enum": ["RIF", "voluntary_good_standing", "voluntary", "for_cause_eligible_for_alumni", "for_cause_not_eligible_for_alumni"] },
    "alumni_eligibility": {
      "type": "string",
      "enum": ["eligible", "not_eligible"]
    },
    "issued_by_principal":       { "type": "string", "format": "uri", "description": "HR-admin signer" },
    "signature": {
      "type": "object",
      "required": ["algorithm", "signature", "key_id"],
      "properties": {
        "algorithm":  { "type": "string", "enum": ["ES256", "EdDSA"] },
        "signature":  { "type": "string", "contentEncoding": "base64" },
        "key_id":     { "type": "string" }
      }
    },
    "issued_at_hlc":             { "type": "string" },
    "public_verify_url": {
      "type": "string",
      "format": "uri",
      "description": "Public endpoint on the former-employer's identity µservice for verification"
    },
    "revoked":                   { "type": "boolean", "default": false },
    "revocation_reason":         { "type": "string" }
  }
}
