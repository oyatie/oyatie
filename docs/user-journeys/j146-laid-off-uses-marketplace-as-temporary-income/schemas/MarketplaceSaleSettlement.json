{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oyatie.com/schemas/user-journeys/j146/MarketplaceSaleSettlement.json",
  "title": "MarketplaceSaleSettlement",
  "type": "object",
  "_meta": {
    "doc_class": "Schema",
    "journey_id": "j146",
    "status": "draft",
    "owner": "marketplace",
    "consumers": ["payments", "finops-portal", "identity", "audit-chain"],
    "adr_anchors": ["ADR-0145", "ADR-0244", "ADR-0249", "ADR-0252", "ADR-0292", "ADR-0311"]
  },
  "required": [
    "settlement_id",
    "seller_principal",
    "buyer_principal",
    "marketplace_tenant_id",
    "amount_gross",
    "amount_facilitator_collected_tax",
    "amount_marketplace_commission",
    "amount_net_to_seller",
    "currency_settlement",
    "category",
    "sale_class",
    "audit_chain_seal_marketplace",
    "audit_chain_seal_seller_tenant"
  ],
  "properties": {
    "settlement_id":                       { "type": "string", "pattern": "^MKT-SETT-[A-Z0-9-]+$" },
    "seller_principal":                    { "type": "string", "format": "uri" },
    "buyer_principal":                     { "type": "string", "format": "uri" },
    "marketplace_tenant_id":               { "type": "string" },
    "sale_class":                          { "type": "string", "enum": ["physical_goods", "consulting_service", "bespoke_service", "digital_goods", "subscription", "marketplace_template"] },
    "amount_gross":                        { "type": "string", "pattern": "^\\d+\\.\\d{2}$" },
    "amount_shipping":                     { "type": "string", "pattern": "^\\d+\\.\\d{2}$" },
    "amount_facilitator_collected_tax":    { "type": "string", "pattern": "^\\d+\\.\\d{2}$" },
    "amount_marketplace_commission":       { "type": "string", "pattern": "^\\d+\\.\\d{2}$" },
    "amount_net_to_seller":                { "type": "string", "pattern": "^\\d+\\.\\d{2}$" },
    "currency_settlement":                 { "type": "string", "pattern": "^[A-Z]{3}$" },
    "fx_record": {
      "type": "object",
      "description": "Present when buyer_currency != seller_currency",
      "properties": {
        "buyer_currency":  { "type": "string" },
        "seller_currency": { "type": "string" },
        "mid_rate":        { "type": "number" },
        "spread_pct":      { "type": "number" }
      }
    },
    "eu_vat_record": {
      "type": "object",
      "description": "Present for EU cross-border transactions",
      "properties": {
        "reverse_charge_applied": { "type": "boolean" },
        "vat_invoice_ref":        { "type": "string" }
      }
    },
    "category":                  { "type": "string", "enum": ["marketplace_sales_2026", "marketplace_consulting_2026", "marketplace_other_2026"] },
    "audit_chain_seal_marketplace":     { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "audit_chain_seal_seller_tenant":   { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "settled_at_hlc":                   { "type": "string" }
  }
}
