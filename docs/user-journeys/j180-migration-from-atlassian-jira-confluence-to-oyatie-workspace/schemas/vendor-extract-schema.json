{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.oyatie.com/user-journeys/j180-migration-from-atlassian-jira-confluence-to-oyatie-workspace/vendor-extract-schema.json",
  "title": "Atlassian Jira and Confluence to Oyatie Workspace cutover vendor extract schema",
  "type": "object",
  "required": [
    "journey_id",
    "tenant_id",
    "source_system",
    "batch_id",
    "objects",
    "row_count_manifest",
    "source_hash_manifest"
  ],
  "properties": {
    "journey_id": {
      "const": "j180-migration-from-atlassian-jira-confluence-to-oyatie-workspace"
    },
    "tenant_id": {
      "const": "atlasbridge-robotics"
    },
    "source_system": {
      "const": "atlassian-cloud-site-atlasbridge"
    },
    "incumbent_system": {
      "const": "Atlassian Jira Software plus Confluence"
    },
    "target_system": {
      "const": "Oyatie workspace"
    },
    "extraction_mechanism": {
      "const": "Jira Cloud REST export plus Confluence space export with attachment manifest"
    },
    "projection": {
      "const": "oyatie.workspace.delivery_graph_projection_v1"
    },
    "batch_id": {
      "type": "string",
      "pattern": "^batch-J[0-9]{3}-[0-9]{2}$"
    },
    "extracted_at": {
      "type": "string",
      "format": "date-time"
    },
    "objects": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Issue types": {
          "type": "object",
          "description": "Jira issue classification",
          "required": [
            "Epic",
            "Story",
            "Task",
            "Bug"
          ],
          "properties": {
            "Epic": {
              "type": "string"
            },
            "Story": {
              "type": "string"
            },
            "Task": {
              "type": "string"
            },
            "Bug": {
              "type": "string"
            },
            "Incident": {
              "type": "string"
            },
            "Change": {
              "type": "string"
            },
            "Spike": {
              "type": "string"
            }
          }
        },
        "Workflow schemes": {
          "type": "object",
          "description": "Project workflow binding",
          "required": [
            "To Do",
            "In Progress",
            "Code Review",
            "QA"
          ],
          "properties": {
            "To Do": {
              "type": "string"
            },
            "In Progress": {
              "type": "string"
            },
            "Code Review": {
              "type": "string"
            },
            "QA": {
              "type": "string"
            },
            "Blocked": {
              "type": "string"
            },
            "Done": {
              "type": "string"
            }
          }
        },
        "Permission schemes": {
          "type": "object",
          "description": "Project permission model",
          "required": [
            "Browse",
            "Create",
            "Edit",
            "Transition"
          ],
          "properties": {
            "Browse": {
              "type": "string"
            },
            "Create": {
              "type": "string"
            },
            "Edit": {
              "type": "string"
            },
            "Transition": {
              "type": "string"
            },
            "Administer": {
              "type": "string"
            },
            "Worklog": {
              "type": "string"
            }
          }
        },
        "Confluence space": {
          "type": "object",
          "description": "Knowledge-space container",
          "required": [
            "Space key",
            "page tree",
            "labels",
            "restrictions"
          ],
          "properties": {
            "Space key": {
              "type": "string"
            },
            "page tree": {
              "type": "string"
            },
            "labels": {
              "type": "string"
            },
            "restrictions": {
              "type": "string"
            },
            "attachments": {
              "type": "string"
            }
          }
        },
        "Project board": {
          "type": "object",
          "description": "Scrum/Kanban board",
          "required": [
            "Board id",
            "filter JQL",
            "sprint",
            "swimlane"
          ],
          "properties": {
            "Board id": {
              "type": "string"
            },
            "filter JQL": {
              "type": "string"
            },
            "sprint": {
              "type": "string"
            },
            "swimlane": {
              "type": "string"
            },
            "quick filters": {
              "type": "string"
            }
          }
        }
      }
    },
    "row_count_manifest": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "object_name",
          "source_count",
          "target_count",
          "delta_count"
        ],
        "properties": {
          "object_name": {
            "enum": [
              "Issue types",
              "Workflow schemes",
              "Permission schemes",
              "Confluence space",
              "Project board"
            ]
          },
          "source_count": {
            "type": "integer",
            "minimum": 0
          },
          "target_count": {
            "type": "integer",
            "minimum": 0
          },
          "delta_count": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "source_hash_manifest": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "object_name",
          "hash_algorithm",
          "hash_value"
        ],
        "properties": {
          "object_name": {
            "enum": [
              "Issue types",
              "Workflow schemes",
              "Permission schemes",
              "Confluence space",
              "Project board"
            ]
          },
          "hash_algorithm": {
            "const": "sha256"
          },
          "hash_value": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64
          }
        }
      }
    }
  },
  "additionalProperties": false
}
