{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oya.cloud/journeys/j162/schemas/lone-worker-dead-man-protocol-form-v1.json",
  "title": "Lone-worker dead-man protocol enrolment form (ISO-45001 + RO-Codul-Muncii §103)",
  "description": "Structured enrolment form for the lone-worker dead-man protocol. Couples biometric capture + check-in cadence + escalation chain + personal-tenant cross-tenant consent + family-emergency-route + equipment-state heartbeat + alarm-cooperative pre-arming. Anchored to ISO 45001:2018 §8.1.2 + RO-Codul-Muncii Law 53/2003 §103 + EU-GDPR Article 7.",
  "type": "object",
  "required": [
    "form_id",
    "form_version",
    "principal",
    "principal_tenant",
    "competency_unlock_link",
    "checkin_cadence",
    "biometric_method",
    "escalation_chain",
    "personal_tenant_consents",
    "equipment_state_heartbeat",
    "alarm_cooperative_pre_arming",
    "iso_45001_compliance",
    "ro_codul_muncii_compliance",
    "gdpr_consent_basis",
    "diacritic_policy"
  ],
  "properties": {
    "form_id": {
      "type": "string",
      "pattern": "^lwdm-enrolment-[a-z0-9-]+$",
      "examples": ["lwdm-enrolment-diana-lazar-night-shift-2027"]
    },
    "form_version": {
      "type": "string",
      "const": "v1.0.0"
    },
    "principal": {
      "type": "string",
      "description": "Operator principal id; UTF-8 NFC",
      "examples": ["diana.lazăr@tipografia-lazar-petrescu-ro"]
    },
    "principal_tenant": {
      "type": "string",
      "examples": ["tipografia-lazar-petrescu-ro"]
    },
    "competency_unlock_link": {
      "type": "object",
      "required": ["competency_id", "competency_valid_through"],
      "properties": {
        "competency_id": {"type": "string", "examples": ["night-shift-solo-authorization-2027"]},
        "competency_valid_through": {"type": "string", "format": "date-time"},
        "cross_journey_continuity_ref": {"type": "string", "description": "Link to j157 cert chain ref"}
      }
    },
    "checkin_cadence": {
      "type": "object",
      "required": ["interval_hours", "response_window_seconds", "method"],
      "properties": {
        "interval_hours": {"type": "integer", "minimum": 1, "maximum": 8, "default": 4},
        "response_window_seconds": {"type": "integer", "minimum": 30, "maximum": 120, "default": 60},
        "method": {"type": "string", "enum": ["tablet_tap_plus_face_id", "tablet_tap_plus_pin", "bracelet_press_plus_face_id"]},
        "soft_reminder_seconds_before_window": {"type": "integer", "default": 120, "description": "How many seconds before the 60s window the soft reminder fires"}
      }
    },
    "biometric_method": {
      "type": "object",
      "required": ["primary", "fallback"],
      "properties": {
        "primary": {"type": "string", "enum": ["face_id_low_light", "fingerprint_minutiae_iso_19794_2", "iris_iso_19794_6"]},
        "primary_match_threshold": {"type": "number", "minimum": 0.85, "maximum": 1.0, "default": 0.95},
        "fallback": {"type": "string", "enum": ["pin_6_digit", "pin_8_digit", "voice_phrase"]},
        "low_light_validated": {"type": "boolean", "const": true}
      }
    },
    "escalation_chain": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["order", "contact_principal", "contact_tenant", "method"],
        "properties": {
          "order": {"type": "integer", "minimum": 1, "maximum": 5},
          "contact_principal": {"type": "string"},
          "contact_tenant": {"type": "string"},
          "method": {"type": "string", "enum": [
            "personal_mobile_voice_call_plus_messenger_priority",
            "messenger_priority",
            "messenger_standard",
            "alarm_cooperative_security_dispatch"
          ]},
          "max_walk_seconds_before_next": {"type": "integer", "default": 30},
          "consent_captured": {"type": "boolean", "default": false},
          "consent_capture_at": {"type": "string", "format": "date-time"}
        }
      }
    },
    "personal_tenant_consents": {
      "type": "array",
      "description": "EU-GDPR-Article-7 explicit consent records from each personal-tenant principal in the escalation chain",
      "items": {
        "type": "object",
        "required": ["consenting_tenant", "consenting_principal", "consent_scope", "consented_at"],
        "properties": {
          "consenting_tenant": {"type": "string"},
          "consenting_principal": {"type": "string"},
          "consent_scope": {"type": "string"},
          "consented_at": {"type": "string", "format": "date-time"},
          "consent_revoke_at": {"type": "string", "format": "date-time", "nullable": true}
        }
      }
    },
    "family_emergency_route": {
      "type": "array",
      "description": "Routes for the operator to be reached for family emergency (cross-tenant to school, daycare, etc.)",
      "items": {
        "type": "object",
        "required": ["contact_tenant", "contact_label", "trigger_condition"],
        "properties": {
          "contact_tenant": {"type": "string"},
          "contact_label": {"type": "string"},
          "trigger_condition": {"type": "string", "enum": ["family_member_health_emergency", "family_member_safety", "school_pickup_required"]}
        }
      }
    },
    "equipment_state_heartbeat": {
      "type": "object",
      "description": "Equipment-state heartbeat coupled to dead-man check-in to detect press anomalies during operator quiet periods",
      "properties": {
        "press_telemetry_heartbeat_seconds": {"type": "integer", "default": 30},
        "bracelet_accelerometer_fall_detect": {"type": "boolean", "default": true},
        "sheet_count_drift_alert": {"type": "boolean", "default": true},
        "ink_density_drift_alert": {"type": "boolean", "default": true}
      }
    },
    "alarm_cooperative_pre_arming": {
      "type": "object",
      "description": "Cooperation with Securitas (or equivalent) alarm-cooperative tenant for emergency dispatch on dead-man miss",
      "required": ["cooperative_tenant", "auto_dispatch_on_dead_man_miss"],
      "properties": {
        "cooperative_tenant": {"type": "string", "examples": ["cz-securitas-alarm-cooperative-tenant-ro"]},
        "auto_dispatch_on_dead_man_miss": {"type": "boolean", "default": false, "description": "If true, Securitas dispatches a guard to depot on confirmed dead-man miss + escalation chain exhaustion"},
        "auto_dispatch_threshold_minutes": {"type": "integer", "default": 5},
        "alarm_zone_pre_armed": {"type": "string"}
      }
    },
    "iso_45001_compliance": {
      "type": "object",
      "required": ["section_8_1_2_attested", "risk_assessment_link"],
      "properties": {
        "section_8_1_2_attested": {"type": "boolean", "const": true},
        "risk_assessment_link": {"type": "string"},
        "training_module_completed": {"type": "boolean", "const": true},
        "training_completion_ref": {"type": "string"}
      }
    },
    "ro_codul_muncii_compliance": {
      "type": "object",
      "required": ["article_103_attested", "article_126_premium_attested"],
      "properties": {
        "article_103_attested": {"type": "boolean", "const": true, "description": "Night-work training obligations met"},
        "article_126_premium_attested": {"type": "boolean", "const": true, "description": "+25% night-shift premium configured"}
      }
    },
    "gdpr_consent_basis": {
      "type": "string",
      "enum": ["explicit_personal_tenant_principal_consent", "implicit_family_relationship_with_opt_out"],
      "default": "explicit_personal_tenant_principal_consent"
    },
    "diacritic_policy": {
      "type": "object",
      "required": ["unicode_normalization", "diacritics_preserved"],
      "properties": {
        "unicode_normalization": {"type": "string", "const": "NFC"},
        "diacritics_preserved": {"type": "boolean", "const": true},
        "romanian_diacritics_strict": {"type": "boolean", "const": true},
        "hungarian_diacritics_strict": {"type": "boolean", "const": true}
      }
    },
    "audit_emission_class": {
      "type": "object",
      "properties": {
        "enrollment_class": {"type": "string", "const": "EVT-J162-DEAD-MAN-ENROLLED-004"},
        "checkin_class": {"type": "string", "const": "EVT-J162-DEAD-MAN-CHECKIN-006b"},
        "missed_class": {"type": "string", "const": "EVT-J162-CEDAR-DENY-DEAD-MAN-MISS-014c"},
        "escalation_class": {"type": "string", "const": "EVT-J162-DEAD-MAN-ESCALATION-014c-walk"}
      }
    },
    "doctrine_anchor": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "ADR-0244",
          "ADR-0263",
          "ADR-0252",
          "ADR-0311",
          "ISO-45001-2018-§8.1.2",
          "RO-Codul-Muncii-Law-53-2003-§103",
          "RO-Codul-Muncii-Law-53-2003-§126",
          "EU-GDPR-Article-7"
        ]
      },
      "minItems": 4
    }
  },
  "examples": [
    {
      "form_id": "lwdm-enrolment-diana-lazar-night-shift-2027",
      "form_version": "v1.0.0",
      "principal": "diana.lazăr@tipografia-lazar-petrescu-ro",
      "principal_tenant": "tipografia-lazar-petrescu-ro",
      "competency_unlock_link": {
        "competency_id": "night-shift-solo-authorization-2027",
        "competency_valid_through": "2028-01-26T23:59:59+02:00",
        "cross_journey_continuity_ref": "j157-EVT-J157-LINE-STOP-001"
      },
      "checkin_cadence": {
        "interval_hours": 4,
        "response_window_seconds": 60,
        "method": "tablet_tap_plus_face_id",
        "soft_reminder_seconds_before_window": 120
      },
      "biometric_method": {
        "primary": "face_id_low_light",
        "primary_match_threshold": 0.95,
        "fallback": "pin_6_digit",
        "low_light_validated": true
      },
      "escalation_chain": [
        {
          "order": 1,
          "contact_principal": "mihai.lazăr-petrescu.personal:mihai",
          "contact_tenant": "mihai.lazar-petrescu.personal",
          "method": "personal_mobile_voice_call_plus_messenger_priority",
          "max_walk_seconds_before_next": 30,
          "consent_captured": true,
          "consent_capture_at": "2027-01-27T12:24:18+02:00"
        },
        {
          "order": 2,
          "contact_principal": "adriana.stanciu@adriana-stanciu-consulting-ro",
          "contact_tenant": "adriana-stanciu-consulting-ro",
          "method": "messenger_priority",
          "max_walk_seconds_before_next": 30,
          "consent_captured": true,
          "consent_capture_at": "2027-01-27T12:25:00+02:00"
        },
        {
          "order": 3,
          "contact_principal": "marius.iancu@heidelberg-romania-service-partner",
          "contact_tenant": "heidelberg-romania-service-partner",
          "method": "messenger_standard",
          "max_walk_seconds_before_next": 30,
          "consent_captured": true,
          "consent_capture_at": "2027-01-27T12:26:00+02:00"
        },
        {
          "order": 4,
          "contact_principal": "cz-securitas-alarm-cooperative-tenant-ro:dispatch",
          "contact_tenant": "cz-securitas-alarm-cooperative-tenant-ro",
