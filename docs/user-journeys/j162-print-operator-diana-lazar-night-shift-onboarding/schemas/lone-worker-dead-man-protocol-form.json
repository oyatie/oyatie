          "max_walk_seconds_before_next": 60,
          "consent_captured": true,
          "consent_capture_at": "2027-01-27T11:42:00+02:00"
        }
      ],
      "personal_tenant_consents": [
        {
          "consenting_tenant": "mihai.lazar-petrescu.personal",
          "consenting_principal": "mihai.lazăr-petrescu.personal:mihai",
          "consent_scope": "lone_worker_dead_man_miss_escalation_voice_plus_messenger",
          "consented_at": "2027-01-27T12:24:18+02:00"
        }
      ],
      "family_emergency_route": [
        {
          "contact_tenant": "scoala-internationala-cluj-ro",
