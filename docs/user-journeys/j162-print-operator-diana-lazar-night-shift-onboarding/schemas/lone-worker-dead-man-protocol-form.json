      },
      "doctrine_anchor": [
        "ADR-0244",
        "ADR-0263",
        "ADR-0252",
        "ADR-0311",
        "ISO-45001-2018-§8.1.2",
        "RO-Codul-Muncii-Law-53-2003-§103",
        "RO-Codul-Muncii-Law-53-2003-§126",
        "EU-GDPR-Article-7"
      ]
    }
  ]
}
