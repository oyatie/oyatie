      },
      "ro_codul_muncii_compliance": {
        "article_103_attested": true,
        "article_126_premium_attested": true
      },
      "gdpr_consent_basis": "explicit_personal_tenant_principal_consent",
      "diacritic_policy": {
        "unicode_normalization": "NFC",
        "diacritics_preserved": true,
        "romanian_diacritics_strict": true,
        "hungarian_diacritics_strict": true
      },
      "audit_emission_class": {
        "enrollment_class": "EVT-J162-DEAD-MAN-ENROLLED-004",
        "checkin_class": "EVT-J162-DEAD-MAN-CHECKIN-006b",
