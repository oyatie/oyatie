{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oyatie.dev/specs/journey/j131/region-local-pi-read-permit.json",
  "title": "RegionLocalPiReadPermit",
  "version": "1.0.0",
  "_meta": {
    "purpose": "Cross-tenant permit whose evaluation requires the principal's session cell to match the resource's residency cell.",
    "binding_adr": "ADR-0304-cross-jurisdiction-conflict-resolution",
    "related_adrs": ["ADR-0311", "ADR-0243"],
    "status": "Proposed"
  },
  "type": "object",
  "required": ["permit_id", "grantor_tenant_id", "grantee_tenant_id", "required_session_cell_id", "actions_permitted"],
  "properties": {
    "permit_id": {"type": "string", "format": "uuid"},
    "grantor_tenant_id": {"type": "string"},
    "grantee_tenant_id": {"type": "string"},
    "required_session_cell_id": {
      "type": "string",
      "description": "Principal's session MUST originate from this cell. Cedar evaluation fails otherwise.",
      "examples": ["eu-central-1-fedramp", "ap-northeast-2-csap"]
    },
    "actions_permitted": {"type": "array", "items": {"type": "string"}},
    "expires_at": {"type": "string", "format": "date-time"}
  }
}
