{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oyatie.com/specs/journey/j131/cell-routed-session.json",
  "title": "CellRoutedSession",
  "version": "1.0.0",
  "_meta": {
    "purpose": "Session whose browser is routed via a specific cell for region-local data access.",
    "binding_adr": "ADR-0304-cross-jurisdiction-conflict-resolution",
    "related_adrs": ["ADR-0311", "ADR-0248"],
    "status": "Proposed"
  },
  "type": "object",
  "required": ["session_id", "principal_id", "tenant_id", "session_cell_id", "established_at", "expires_at"],
  "properties": {
    "session_id": {"type": "string", "format": "uuid"},
    "principal_id": {"type": "string"},
    "tenant_id": {"type": "string", "description": "Tenant remains the same; cell changes."},
    "session_cell_id": {"type": "string", "examples": ["eu-central-1-fedramp", "ap-northeast-2-csap"]},
    "established_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time", "description": "Hard cap 4 hours per ADR-0304 §B-3"},
    "audit_event_id": {"type": "string", "format": "uuid"}
  }
}
