{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oyatie.com/specs/journey/j131/multi-region-evidence-manifest.json",
  "title": "MultiRegionEvidenceManifest",
  "version": "1.0.0",
  "_meta": {
    "purpose": "PI-free reconciliation manifest combining per-jurisdiction audit summaries into a single docket view.",
    "binding_adr": "ADR-0304-cross-jurisdiction-conflict-resolution",
    "related_adrs": ["ADR-0311", "ADR-0028", "ADR-0263"],
    "status": "Proposed"
  },
  "type": "object",
  "required": ["docket_id", "per_jurisdiction", "reconciliation_root", "sealed_at"],
  "properties": {
    "docket_id": {"type": "string"},
    "per_jurisdiction": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["tenant_id", "cell_id", "applicable_packs", "merkle_root", "events_sampled", "microservices_emitting", "contains_pi"],
        "properties": {
          "tenant_id": {"type": "string"},
          "cell_id": {"type": "string"},
          "applicable_packs": {"type": "array", "items": {"type": "string"}},
          "merkle_root": {"type": "string", "pattern": "^0x[0-9a-f]{64}$"},
          "events_sampled": {"type": "integer"},
          "microservices_emitting": {"type": "integer"},
          "control_attestations": {"type": "object"},
          "contains_pi": {
            "const": false,
            "description": "MUST always be false in this manifest; per ADR-0304, PI does not cross-region."
          },
          "permit_graph_hash": {"type": "string", "pattern": "^0x[0-9a-f]{64}$"}
        }
      }
    },
    "reconciliation_root": {"type": "string", "pattern": "^0x[0-9a-f]{64}$"},
    "sealed_at": {"type": "string", "format": "date-time"}
  }
}
