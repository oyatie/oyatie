{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.oyatie.dev/user-journeys/j39/meeting-transcript-archive.json",
  "title": "MeetingTranscriptArchive",
  "version": "1.0.0",
  "description": "Shared journey object for j39-b2b-meeting-with-transcription. It lets Marcus Chen host a large review meeting, transcribe it, archive the recording, and make the transcript searchable in Notes while preserving tenant scope, auditability, and cross-service status.",
  "_meta": {
    "purpose": "Bind j39-b2b-meeting-with-transcription to a machine-readable object shared by all participating microservices.",
    "status": "Proposed",
    "binding_adr": "ADR-0244",
    "related_adrs": [
      "ADR-0105",
      "ADR-0131",
      "ADR-0244",
      "ADR-0263",
      "ADR-0273",
      "ADR-0292",
      "ADR-0297",
      "ADR-0299"
    ],
    "enforcement_status": "authoring-target",
    "industry_citations": [
      "Google Meet recording plus Microsoft Teams transcript retention pattern"
    ],
    "contract_surfaces": [
      "OpenAPI 3.2.0",
      "AsyncAPI 3.1.0",
      "proto3",
      "BNF v4.1",
      "ADR-0105 13-layer"
    ],
    "microservice_count_authority": 45,
    "marketplace_settlement_invariant": "marketplace-settles-all-tenant-deals",
    "schema_version": "v1.0.0"
  },
  "type": "object",
  "required": [
    "journey_id",
    "tenant_id",
    "persona",
    "locale",
    "status",
    "correlation_id",
    "service_states",
    "audit",
    "contracts"
  ],
  "properties": {
    "journey_id": {
      "const": "j39-b2b-meeting-with-transcription",
      "description": "Stable journey identifier and collision guard for the j36-j50 range.",
      "examples": [
        "j39-b2b-meeting-with-transcription"
      ]
    },
    "tenant_id": {
      "type": "string",
      "description": "Tenant scope required by ADR-0244; every service must persist or forward it unchanged.",
      "examples": [
        "acme-b2b"
      ]
    },
    "persona": {
      "const": "Marcus Chen",
      "description": "The named persona whose continuity is preserved across the journey.",
      "examples": [
        "Marcus Chen"
      ]
    },
    "locale": {
      "const": "en-US",
      "description": "Locale used for UX, notices, and regulated language variants.",
      "examples": [
        "en-US"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "waiting_on_human",
        "waiting_on_provider",
        "completed",
        "compensated",
        "denied"
      ],
      "description": "Journey state machine status observed by UX and tests.",
      "examples": [
        "completed"
      ]
    },
    "correlation_id": {
      "type": "string",
      "pattern": "^journey-j[0-9]{2}-[a-z0-9-]+$",
      "description": "Idempotency and trace correlation key shared by OpenAPI, AsyncAPI, and proto3 surfaces.",
      "examples": [
        "journey-j39-b2b-meeting-with-transcription"
      ]
    },
    "service_states": {
      "type": "object",
      "description": "Per-service status map; keys match the flat microservice path names used by ADR-0131.",
      "required": [
        "meet",
        "intelligence",
        "recordings",
        "drive",
        "notes",
        "observability"
      ],
      "properties": {
        "meet": {
          "type": "object",
          "description": "meet owns the quarterly-review-room role for this journey and records the status it contributes to the shared object.",
          "required": [
            "role",
            "status",
            "audit_event_class"
          ],
          "properties": {
            "role": {
              "const": "quarterly-review-room",
              "description": "The meet role in the journey handshake.",
              "examples": [
                "quarterly-review-room"
              ]
            },
            "status": {
              "type": "string",
              "enum": [
                "pending",
                "permitted",
                "denied",
                "degraded",
                "completed",
                "compensated"
              ],
              "description": "Typed service status used by the integration test plan and audit envelope.",
              "examples": [
                "completed"
              ]
            },
            "audit_event_class": {
              "type": "string",
              "description": "ADR-0263 audit event class emitted by this service when the status changes.",
              "examples": [
                "Journey39MeetQuarterlyReviewRoomCommitted"
              ]
            }
          },
          "additionalProperties": false
        },
        "intelligence": {
          "type": "object",
          "description": "intelligence owns the transcription-summarization role for this journey and records the status it contributes to the shared object.",
          "required": [
            "role",
            "status",
            "audit_event_class"
          ],
          "properties": {
            "role": {
              "const": "transcription-summarization",
              "description": "The intelligence role in the journey handshake.",
              "examples": [
                "transcription-summarization"
              ]
            },
            "status": {
              "type": "string",
              "enum": [
                "pending",
                "permitted",
                "denied",
                "degraded",
                "completed",
                "compensated"
              ],
              "description": "Typed service status used by the integration test plan and audit envelope.",
              "examples": [
                "completed"
              ]
            },
            "audit_event_class": {
              "type": "string",
              "description": "ADR-0263 audit event class emitted by this service when the status changes.",
              "examples": [
                "Journey39IntelligenceTranscriptionSummarizationCommitted"
              ]
            }
          },
          "additionalProperties": false
        },
        "recordings": {
          "type": "object",
          "description": "recordings owns the immutable-recording role for this journey and records the status it contributes to the shared object.",
          "required": [
            "role",
            "status",
            "audit_event_class"
          ],
          "properties": {
            "role": {
              "const": "immutable-recording",
              "description": "The recordings role in the journey handshake.",
              "examples": [
                "immutable-recording"
              ]
            },
            "status": {
              "type": "string",
              "enum": [
                "pending",
                "permitted",
                "denied",
                "degraded",
                "completed",
                "compensated"
              ],
              "description": "Typed service status used by the integration test plan and audit envelope.",
              "examples": [
                "completed"
              ]
            },
            "audit_event_class": {
              "type": "string",
              "description": "ADR-0263 audit event class emitted by this service when the status changes.",
              "examples": [
                "Journey39RecordingsImmutableRecordingCommitted"
              ]
            }
          },
          "additionalProperties": false
        },
        "drive": {
          "type": "object",
          "description": "drive owns the archive-folder role for this journey and records the status it contributes to the shared object.",
          "required": [
            "role",
            "status",
            "audit_event_class"
          ],
          "properties": {
            "role": {
              "const": "archive-folder",
              "description": "The drive role in the journey handshake.",
              "examples": [
                "archive-folder"
              ]
            },
            "status": {
              "type": "string",
              "enum": [
                "pending",
                "permitted",
                "denied",
                "degraded",
                "completed",
                "compensated"
              ],
              "description": "Typed service status used by the integration test plan and audit envelope.",
              "examples": [
                "completed"
              ]
            },
            "audit_event_class": {
              "type": "string",
              "description": "ADR-0263 audit event class emitted by this service when the status changes.",
              "examples": [
                "Journey39DriveArchiveFolderCommitted"
              ]
            }
          },
          "additionalProperties": false
        },
        "notes": {
          "type": "object",
          "description": "notes owns the transcript-search-index role for this journey and records the status it contributes to the shared object.",
          "required": [
            "role",
            "status",
            "audit_event_class"
          ],
          "properties": {
            "role": {
              "const": "transcript-search-index",
              "description": "The notes role in the journey handshake.",
              "examples": [
                "transcript-search-index"
              ]
            },
            "status": {
              "type": "string",
              "enum": [
                "pending",
                "permitted",
                "denied",
                "degraded",
                "completed",
                "compensated"
              ],
              "description": "Typed service status used by the integration test plan and audit envelope.",
              "examples": [
                "completed"
              ]
            },
            "audit_event_class": {
              "type": "string",
              "description": "ADR-0263 audit event class emitted by this service when the status changes.",
              "examples": [
                "Journey39NotesTranscriptSearchIndexCommitted"
              ]
            }
          },
          "additionalProperties": false
        },
        "observability": {
          "type": "object",
          "description": "observability owns the meeting-telemetry role for this journey and records the status it contributes to the shared object.",
          "required": [
            "role",
            "status",
            "audit_event_class"
          ],
          "properties": {
            "role": {
              "const": "meeting-telemetry",
              "description": "The observability role in the journey handshake.",
              "examples": [
                "meeting-telemetry"
              ]
            },
            "status": {
              "type": "string",
              "enum": [
                "pending",
                "permitted",
                "denied",
                "degraded",
                "completed",
                "compensated"
              ],
              "description": "Typed service status used by the integration test plan and audit envelope.",
              "examples": [
                "completed"
              ]
            },
            "audit_event_class": {
              "type": "string",
              "description": "ADR-0263 audit event class emitted by this service when the status changes.",
              "examples": [
                "Journey39ObservabilityMeetingTelemetryCommitted"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "audit": {
      "type": "object",
      "description": "ADR-0263 audit envelope shared by all service transitions.",
      "required": [
        "audit_id",
        "trace_id",
        "event_classes",
        "sealed_at"
      ],
      "properties": {
        "audit_id": {
          "type": "string",
          "description": "Audit-chain identifier.",
          "examples": [
            "aud-j39-001"
          ]
        },
        "trace_id": {
          "type": "string",
          "description": "Distributed trace id for observability.",
          "examples": [
            "trace-j39-hero"
          ]
        },
        "event_classes": {
          "type": "array",
          "description": "Audit event classes emitted during this journey.",
          "items": {
            "type": "string"
          },
          "minItems": 6,
          "examples": [
            [
              "Journey39MeetQuarterlyReviewRoomCommitted",
              "Journey39IntelligenceTranscriptionSummarizationCommitted",
              "Journey39RecordingsImmutableRecordingCommitted",
              "Journey39DriveArchiveFolderCommitted",
              "Journey39NotesTranscriptSearchIndexCommitted",
              "Journey39ObservabilityMeetingTelemetryCommitted"
            ]
          ]
        },
        "sealed_at": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when the final audit bundle was sealed.",
          "examples": [
            "2026-06-01T12:00:00Z"
          ]
        }
      },
      "additionalProperties": false
    },
    "contracts": {
      "type": "array",
      "description": "Contract surface names that must remain in sync for this journey.",
      "items": {
        "type": "string",
        "enum": [
          "OpenAPI 3.2.0",
          "AsyncAPI 3.1.0",
          "proto3",
          "BNF v4.1",
          "ADR-0105 13-layer"
        ]
      },
      "minItems": 5,
      "examples": [
        [
          "OpenAPI 3.2.0",
          "AsyncAPI 3.1.0",
          "proto3",
          "BNF v4.1",
          "ADR-0105 13-layer"
        ]
      ]
    }
  },
  "additionalProperties": false
}
