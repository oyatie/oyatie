{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.oyatie.dev/schemas/user-journeys/j120/event.json",
  "title": "J120EventSchema",
  "version": "1.0.0",
  "_meta": {
    "doc_class": "JourneySharedSchema",
    "purpose": "event object for Tenant treasury multi-currency FX hedge.",
    "journey_id": "j120-tenant-treasury-multi-currency-fx-hedge",
    "binding_adrs": [
      "ADR-0244",
      "ADR-0297",
      "ADR-0299",
      "ADR-0292",
      "ADR-0263",
      "ADR-0307",
      "ADR-0308",
      "ADR-0311",
      "ADR-0312",
      "ADR-0313",
      "ADR-0105",
      "ADR-0131",
      "ADR-0249",
      "ADR-0257"
    ],
    "industry_citations": [
      "Stripe Connect platform facilitator settlement",
      "AWS EventBridge event envelope",
      "Palantir Foundry ontology projection"
    ],
    "contract_versions": [
      "OpenAPI 3.2.0",
      "AsyncAPI 3.1.0",
      "proto3"
    ],
    "grammar": "BNF v4.1 + ADR-0105 13-layer",
    "layout": "ADR-0131 flat per-microservice layout",
    "marketplace_settles_all_tenant_deals": true,
    "status": "draft"
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "journey_id",
    "actor_principal_id",
    "active_tenant_id",
    "counterparty_tenant_ids",
    "services",
    "marketplace_settlement",
    "audit_event"
  ],
  "properties": {
    "journey_id": {
      "type": "string",
      "const": "j120",
      "description": "Stable journey id used by docs, tests, and trace fixtures.",
      "examples": [
        "j120"
      ],
      "oyatie.data_class": "internal_reference"
    },
    "actor_principal_id": {
      "type": "string",
      "description": "Principal for Elena Rossi, group treasurer for Marcus company; must resolve through identity before any service call.",
      "examples": [
        "elena-rossi-group-treasurer-for-marcus-company"
      ],
      "oyatie.data_class": "tenant_identity"
    },
    "active_tenant_id": {
      "type": "string",
      "description": "Tenant context selected by the actor and shown in UX before command submission.",
      "examples": [
        "krampuscorp.global"
      ],
      "oyatie.data_class": "tenant_scoped"
    },
    "counterparty_tenant_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "description": "Counterparty tenants that participate in the commercial or governance flow.",
      "examples": [
        [
          "bank-liquidity-provider-tenant",
          "regional-subsidiaries"
        ]
      ],
      "oyatie.data_class": "tenant_scoped"
    },
    "services": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "payments",
          "connect",
          "finops-portal",
          "workflow-engine",
          "observability"
        ]
      },
      "description": "Microservices touched by this journey.",
      "examples": [
        [
          "payments",
          "connect",
          "finops-portal",
          "workflow-engine",
          "observability"
        ]
      ],
      "oyatie.data_class": "internal_reference"
    },
    "marketplace_settlement": {
      "type": "object",
      "description": "Marketplace facilitator settlement envelope; required for all tenant deals.",
      "required": [
        "surface",
        "deal",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "surface": {
          "type": "string",
          "const": "plugin-app-store"
        },
        "deal": {
          "type": "string",
          "const": "tenant-to-bank FX hedge and treasury service fee"
        },
        "status": {
          "type": "string",
          "enum": [
            "intent",
            "authorized",
            "settled",
            "reversed",
            "credited"
          ]
        }
      }
    },
    "audit_event": {
      "type": "string",
      "const": "TreasuryFxHedgeSettled",
      "description": "Primary ADR-0263 audit event emitted by this journey.",
      "examples": [
        "TreasuryFxHedgeSettled"
      ],
      "oyatie.data_class": "audit_metadata"
    }
  }
}
