{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.oyatie.com/user-journeys/j40/marketplace-seat-subscription.json",
  "title": "MarketplaceSeatSubscription",
  "version": "1.0.0",
  "description": "Shared journey object for j40-b2b-marketplace-vendor-billing. It lets Marcus Chen buy a SaaS plugin from the plugin app store, bill per seat, and settle through Stripe while preserving tenant scope, auditability, and cross-service status.",
  "_meta": {
    "purpose": "Bind j40-b2b-marketplace-vendor-billing to a machine-readable object shared by all participating microservices.",
    "status": "Proposed",
    "binding_adr": "ADR-0244",
    "related_adrs": [
      "ADR-0105",
      "ADR-0131",
      "ADR-0244",
      "ADR-0263",
      "ADR-0273",
      "ADR-0292",
      "ADR-0297",
      "ADR-0299"
    ],
    "enforcement_status": "authoring-target",
    "industry_citations": [
      "AWS Marketplace SaaS contract plus Stripe subscription pattern"
    ],
    "contract_surfaces": [
      "OpenAPI 3.2.0",
      "AsyncAPI 3.1.0",
      "proto3",
      "BNF v4.1",
      "ADR-0105 13-layer"
    ],
    "microservice_count_authority": 45,
    "marketplace_settlement_invariant": "marketplace-settles-all-tenant-deals",
    "schema_version": "v1.0.0"
  },
  "type": "object",
  "required": [
    "journey_id",
    "tenant_id",
    "persona",
    "locale",
    "status",
    "correlation_id",
    "service_states",
    "audit",
    "contracts"
  ],
  "properties": {
    "journey_id": {
      "const": "j40-b2b-marketplace-vendor-billing",
      "description": "Stable journey identifier and collision guard for the j36-j50 range.",
      "examples": [
        "j40-b2b-marketplace-vendor-billing"
      ]
    },
    "tenant_id": {
      "type": "string",
      "description": "Tenant scope required by ADR-0244; every service must persist or forward it unchanged.",
      "examples": [
        "acme-b2b"
      ]
    },
    "persona": {
      "const": "Marcus Chen",
      "description": "The named persona whose continuity is preserved across the journey.",
      "examples": [
        "Marcus Chen"
      ]
    },
    "locale": {
      "const": "en-US",
      "description": "Locale used for UX, notices, and regulated language variants.",
      "examples": [
        "en-US"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "waiting_on_human",
        "waiting_on_provider",
        "completed",
        "compensated",
        "denied"
      ],
      "description": "Journey state machine status observed by UX and tests.",
      "examples": [
        "completed"
      ]
    },
    "correlation_id": {
      "type": "string",
      "pattern": "^journey-j[0-9]{2}-[a-z0-9-]+$",
      "description": "Idempotency and trace correlation key shared by OpenAPI, AsyncAPI, and proto3 surfaces.",
      "examples": [
        "journey-j40-b2b-marketplace-vendor-billing"
      ]
    },
    "service_states": {
      "type": "object",
      "description": "Per-service status map; keys match the flat microservice path names used by ADR-0131.",
      "required": [
        "plugin_app_store",
        "payments",
        "tenancy",
        "mail"
      ],
      "properties": {
        "plugin_app_store": {
          "type": "object",
          "description": "plugin-app-store owns the vendor-subscription role for this journey and records the status it contributes to the shared object.",
          "required": [
            "role",
            "status",
            "audit_event_class"
          ],
          "properties": {
            "role": {
              "const": "vendor-subscription",
              "description": "The plugin-app-store role in the journey handshake.",
              "examples": [
                "vendor-subscription"
              ]
            },
            "status": {
              "type": "string",
              "enum": [
                "pending",
                "permitted",
                "denied",
                "degraded",
                "completed",
                "compensated"
              ],
              "description": "Typed service status used by the integration test plan and audit envelope.",
              "examples": [
                "completed"
              ]
            },
            "audit_event_class": {
              "type": "string",
              "description": "ADR-0263 audit event class emitted by this service when the status changes.",
              "examples": [
                "Journey40PluginAppStoreVendorSubscriptionCommitted"
              ]
            }
          },
          "additionalProperties": false
        },
        "payments": {
          "type": "object",
          "description": "payments owns the per-seat-billing role for this journey and records the status it contributes to the shared object.",
          "required": [
            "role",
            "status",
            "audit_event_class"
          ],
          "properties": {
            "role": {
              "const": "per-seat-billing",
              "description": "The payments role in the journey handshake.",
              "examples": [
                "per-seat-billing"
              ]
            },
            "status": {
              "type": "string",
              "enum": [
                "pending",
                "permitted",
                "denied",
                "degraded",
                "completed",
                "compensated"
              ],
              "description": "Typed service status used by the integration test plan and audit envelope.",
              "examples": [
                "completed"
              ]
            },
            "audit_event_class": {
              "type": "string",
              "description": "ADR-0263 audit event class emitted by this service when the status changes.",
              "examples": [
                "Journey40PaymentsPerSeatBillingCommitted"
              ]
            }
          },
          "additionalProperties": false
        },
        "tenancy": {
          "type": "object",
          "description": "tenancy owns the seat-entitlement role for this journey and records the status it contributes to the shared object.",
          "required": [
            "role",
            "status",
            "audit_event_class"
          ],
          "properties": {
            "role": {
              "const": "seat-entitlement",
              "description": "The tenancy role in the journey handshake.",
              "examples": [
                "seat-entitlement"
              ]
            },
            "status": {
              "type": "string",
              "enum": [
                "pending",
                "permitted",
                "denied",
                "degraded",
                "completed",
                "compensated"
              ],
              "description": "Typed service status used by the integration test plan and audit envelope.",
              "examples": [
                "completed"
              ]
            },
            "audit_event_class": {
              "type": "string",
              "description": "ADR-0263 audit event class emitted by this service when the status changes.",
              "examples": [
                "Journey40TenancySeatEntitlementCommitted"
              ]
            }
          },
          "additionalProperties": false
        },
        "mail": {
          "type": "object",
          "description": "mail owns the billing-receipts role for this journey and records the status it contributes to the shared object.",
          "required": [
            "role",
            "status",
            "audit_event_class"
          ],
          "properties": {
            "role": {
              "const": "billing-receipts",
              "description": "The mail role in the journey handshake.",
              "examples": [
                "billing-receipts"
              ]
            },
            "status": {
              "type": "string",
              "enum": [
                "pending",
                "permitted",
                "denied",
                "degraded",
                "completed",
                "compensated"
              ],
              "description": "Typed service status used by the integration test plan and audit envelope.",
              "examples": [
                "completed"
              ]
            },
            "audit_event_class": {
              "type": "string",
              "description": "ADR-0263 audit event class emitted by this service when the status changes.",
              "examples": [
                "Journey40MailBillingReceiptsCommitted"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "audit": {
      "type": "object",
      "description": "ADR-0263 audit envelope shared by all service transitions.",
      "required": [
        "audit_id",
        "trace_id",
        "event_classes",
        "sealed_at"
      ],
      "properties": {
        "audit_id": {
          "type": "string",
          "description": "Audit-chain identifier.",
          "examples": [
            "aud-j40-001"
          ]
        },
        "trace_id": {
          "type": "string",
          "description": "Distributed trace id for observability.",
          "examples": [
            "trace-j40-hero"
          ]
        },
        "event_classes": {
          "type": "array",
          "description": "Audit event classes emitted during this journey.",
          "items": {
            "type": "string"
          },
          "minItems": 4,
          "examples": [
            [
              "Journey40PluginAppStoreVendorSubscriptionCommitted",
              "Journey40PaymentsPerSeatBillingCommitted",
              "Journey40TenancySeatEntitlementCommitted",
              "Journey40MailBillingReceiptsCommitted"
            ]
          ]
        },
        "sealed_at": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when the final audit bundle was sealed.",
          "examples": [
            "2026-06-01T12:00:00Z"
          ]
        }
      },
      "additionalProperties": false
    },
    "contracts": {
      "type": "array",
      "description": "Contract surface names that must remain in sync for this journey.",
      "items": {
        "type": "string",
        "enum": [
          "OpenAPI 3.2.0",
          "AsyncAPI 3.1.0",
          "proto3",
          "BNF v4.1",
          "ADR-0105 13-layer"
        ]
      },
      "minItems": 5,
      "examples": [
        [
          "OpenAPI 3.2.0",
          "AsyncAPI 3.1.0",
          "proto3",
          "BNF v4.1",
          "ADR-0105 13-layer"
        ]
      ]
    }
  },
  "additionalProperties": false
}
