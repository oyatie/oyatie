                "PACK-AGNOSTIC",
                "HIPAA-WORKED-EXAMPLE"
              ]
            ]
          },
          "article_refs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "examples": [
              [
                "45 CFR 164.308 administrative safeguards",
                "45 CFR 164.310 physical safeguards",
                "45 CFR 164.312 technical safeguards",
                "45 CFR 164.316 policies, procedures, and documentation requirements",
                "45 CFR 164.502 uses and disclosures of protected health information",
                "45 CFR 164.514 de-identification and limited data set requirements",
                "45 CFR 164.524 access of individuals to protected health information",
                "45 CFR 164.530 administrative requirements",
