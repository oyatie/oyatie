          "cedar_decision_preview": {
            "type": "string",
            "enum": [
              "permit",
              "forbid",
              "abstain"
            ]
          },
          "idempotency_key": {
            "type": "string"
          },
          "evidence_hash": {
            "type": "string"
          }
