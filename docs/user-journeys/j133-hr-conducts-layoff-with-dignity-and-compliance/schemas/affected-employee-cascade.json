{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oyatie.com/schemas/j133/affected-employee-cascade.json",
  "title": "AffectedEmployeeCascade",
  "type": "object",
  "_meta": {
    "doc_class": "User-Journey-Schema",
    "journey_id": "j133-hr-conducts-layoff-with-dignity-and-compliance",
    "version": "1.0.0",
    "owners": ["workflow-engine"],
    "related_adrs": ["ADR-0311", "ADR-0244"]
  },
  "required": ["cascade_id", "rif_event_id", "employee_principal_id", "jurisdiction", "selection_rationale_code", "severance_packet", "outplacement_enrollment", "cohort_channel_enrollment", "access_revocation", "personal_tenant_continuity_assured"],
  "properties": {
    "cascade_id": {"type": "string", "format": "uuid"},
    "rif_event_id": {"type": "string"},
    "employee_principal_id": {"type": "string"},
    "personal_tenant_principal_id": {"type": "string", "description": "The same human's personal-tenant principal — Cedar default-deny holds against marcus-tenant"},
    "jurisdiction": {"type": "string"},
    "manager_principal_id": {"type": "string"},
    "selection_rationale_code": {
      "type": "string",
      "enum": [
        "role.redundancy",
        "team.consolidation",
        "performance.below_threshold",
        "skill.alignment_lost",
        "tenure.last_in_first_out",
        "social_selection.de_kschg"
      ]
    },
    "selection_rationale_text": {"type": "string", "maxLength": 4000},
    "announcement_state": {
      "type": "object",
      "properties": {
        "manager_1on1_scheduled_at": {"type": "string", "format": "date-time"},
        "manager_1on1_completed_at": {"type": "string", "format": "date-time"},
        "mail_sent_at": {"type": "string", "format": "date-time"},
        "mail_opened_at": {"type": "string", "format": "date-time"},
        "employee_acknowledged_at": {"type": "string", "format": "date-time"}
      }
    },
    "severance_packet": {
      "type": "object",
      "required": ["computed_amount", "currency", "per_jurisdiction_formula", "computed_at", "disbursement_scheduled_at"],
      "properties": {
        "computed_amount": {"type": "number", "minimum": 0},
        "currency": {"type": "string"},
        "per_jurisdiction_formula": {"type": "string"},
        "computed_at": {"type": "string", "format": "date-time"},
        "computed_by_scorer": {"type": "string", "const": "oyatie:foundry:scorer-severance-computer-v3"},
        "disbursement_scheduled_at": {"type": "string", "format": "date-time"},
        "disbursement_rail": {"type": "string", "enum": ["ACH", "SEPA", "Wire", "IMPS", "RTGS"]},
        "disbursed_at": {"type": "string", "format": "date-time"},
        "cobra_weeks_paid": {"type": "number", "description": "US-AUS only"},
        "notice_period_weeks": {"type": "number"}
      }
    },
    "outplacement_enrollment": {
      "type": "object",
      "properties": {
        "vendor_tenant_id": {"type": "string"},
        "enrolled_at": {"type": "string", "format": "date-time"},
        "status": {"type": "string", "enum": ["pending", "invited", "accepted", "active", "completed", "declined"]}
      }
    },
    "cohort_channel_enrollment": {
      "type": "object",
      "properties": {
        "channel_id": {"type": "string"},
        "enrolled_at": {"type": "string", "format": "date-time"},
        "former_employer_attestation": {"type": "string"}
      }
    },
    "access_revocation": {
      "type": "object",
      "properties": {
        "session_revoked_at": {"type": "string", "format": "date-time"},
        "scim_deprovisioned_at": {"type": "string", "format": "date-time"},
        "work_drive_transferred_at": {"type": "string", "format": "date-time"},
        "work_drive_transferred_to": {"type": "string"},
        "work_mail_archived_at": {"type": "string", "format": "date-time"},
        "work_messenger_archived_at": {"type": "string", "format": "date-time"},
        "passkey_tenant_binding_revoked_at": {"type": "string", "format": "date-time"}
      }
    },
    "personal_tenant_continuity_assured": {
      "type": "boolean",
      "const": true,
      "description": "Per ADR-0311; this MUST be true; verified by Cedar default-deny"
    },
    "litigation_hold_applied": {"type": "boolean"},
    "reference_letter_requested": {"type": "boolean"},
    "reference_letter_delivered_at": {"type": "string", "format": "date-time"}
  }
}
