{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oyatie.com/schemas/j133/severance-packet.json",
  "title": "SeverancePacket",
  "type": "object",
  "_meta": {
    "doc_class": "User-Journey-Schema",
    "journey_id": "j133-hr-conducts-layoff-with-dignity-and-compliance",
    "version": "1.0.0",
    "owners": ["finops-portal", "payments"],
    "related_adrs": ["ADR-0247", "ADR-0263"]
  },
  "required": ["packet_id", "cascade_id", "jurisdiction", "base_severance", "notice_period_pay", "computed_by_scorer", "regulatory_anchors"],
  "properties": {
    "packet_id": {"type": "string", "format": "uuid"},
    "cascade_id": {"type": "string"},
    "jurisdiction": {"type": "string"},
    "base_severance": {
      "type": "object",
      "properties": {
        "amount": {"type": "number"},
        "currency": {"type": "string"},
        "formula": {"type": "string", "description": "e.g., '2 weeks per year of service'"}
      }
    },
    "notice_period_pay": {
      "type": "object",
      "properties": {
        "weeks": {"type": "number"},
        "amount": {"type": "number"},
        "currency": {"type": "string"}
      }
    },
    "cobra_continuation": {
      "type": "object",
      "properties": {
        "weeks": {"type": "number"},
        "tenant_subsidy": {"type": "number"}
      },
      "description": "US-AUS only"
    },
    "gratuity": {
      "type": "object",
      "properties": {
        "applicable": {"type": "boolean"},
        "amount": {"type": "number"}
      },
      "description": "IN-BLR with ≥5 years tenure"
    },
    "owbpa_consider_window_days": {
      "type": "integer",
      "description": "US-AUS ≥40 cohort; 21 day default per OWBPA"
    },
    "owbpa_revoke_window_days": {
      "type": "integer",
      "description": "US-AUS ≥40 cohort; 7 day default per OWBPA"
    },
    "mutual_release_agreement_offered": {"type": "boolean"},
    "computed_by_scorer": {"type": "string", "const": "oyatie:foundry:scorer-severance-computer-v3"},
    "computed_at": {"type": "string", "format": "date-time"},
    "regulatory_anchors": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}
