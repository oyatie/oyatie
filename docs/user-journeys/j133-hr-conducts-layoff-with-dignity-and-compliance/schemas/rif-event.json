{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oyatie.com/schemas/j133/rif-event.json",
  "title": "RifEvent",
  "type": "object",
  "_meta": {
    "doc_class": "User-Journey-Schema",
    "journey_id": "j133-hr-conducts-layoff-with-dignity-and-compliance",
    "version": "1.0.0",
    "owners": ["workflow-engine", "compliance"],
    "related_adrs": ["ADR-0311", "ADR-0244", "ADR-0263"]
  },
  "required": ["event_id", "tenant_id", "approved_by", "approved_at", "affected_employee_count", "per_jurisdiction_breakdown", "disparate_impact_analysis", "works_council_clearances", "compliance_packs_active"],
  "properties": {
    "event_id": {"type": "string", "pattern": "^RIF-EVENT-[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "tenant_id": {"type": "string"},
    "approved_by": {"type": "string"},
    "approved_at": {"type": "string", "format": "date-time"},
    "executed_by": {"type": "string"},
    "executed_at": {"type": "string", "format": "date-time"},
    "affected_employee_count": {"type": "integer", "minimum": 1},
    "per_jurisdiction_breakdown": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["jurisdiction", "count", "announcement_time_local", "labor_law_anchors"],
        "properties": {
          "jurisdiction": {"type": "string", "enum": ["IN-BLR", "US-AUS", "DE-BER", "KR-SEO"]},
          "count": {"type": "integer", "minimum": 1},
          "announcement_time_local": {"type": "string", "format": "date-time"},
          "labor_law_anchors": {"type": "array", "items": {"type": "string"}},
          "severance_formula": {"type": "string"}
        }
      }
    },
    "disparate_impact_analysis": {
      "type": "object",
      "properties": {
        "verdict": {"type": "string", "enum": ["green", "yellow", "red"]},
        "analyzed_at": {"type": "string", "format": "date-time"},
        "analyzer_principal": {"type": "string"}
      }
    },
    "works_council_clearances": {
      "type": "object",
      "properties": {
        "DE_BER_betriebsrat_cleared": {"type": "boolean"},
        "KR_SEO_labor_management_council_cleared": {"type": "boolean"},
        "cleared_at": {"type": "string", "format": "date-time"}
      }
    },
    "compliance_packs_active": {
      "type": "array",
      "items": {"type": "string"}
    },
    "litigation_hold_employees": {
      "type": "array",
      "items": {"type": "string"}
    },
    "status": {
      "type": "string",
      "enum": ["planned", "in_works_council_consultation", "execute_ready", "executing", "executed", "disbursing", "completed", "retrospective_complete"]
    }
  }
}
