{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oyatie.dev/schemas/j133/cohort-channel.json",
  "title": "CohortChannel",
  "type": "object",
  "_meta": {
    "doc_class": "User-Journey-Schema",
    "journey_id": "j133-hr-conducts-layoff-with-dignity-and-compliance",
    "version": "1.0.0",
    "owners": ["community"],
    "related_adrs": ["ADR-0311", "ADR-0263"]
  },
  "required": ["channel_id", "channel_type", "provisioned_by_tenant_id", "provisioned_at", "former_employer_tenant_id", "owner", "moderator_authority", "forbid_owner_read"],
  "properties": {
    "channel_id": {"type": "string", "format": "uuid"},
    "channel_type": {"type": "string", "const": "verified-former-employer"},
    "channel_slug": {"type": "string"},
    "provisioned_by_tenant_id": {"type": "string"},
    "provisioned_at": {"type": "string", "format": "date-time"},
    "former_employer_tenant_id": {"type": "string"},
    "owner": {
      "type": "string",
      "const": "community",
      "description": "Community owns the channel, not the former employer"
    },
    "moderator_authority": {
      "type": "string",
      "const": "community-moderators",
      "description": "Marcus's tenant CANNOT moderate"
    },
    "forbid_owner_read": {
      "type": "boolean",
      "const": true,
      "description": "Marcus's tenant CANNOT read channel; only litigation subpoena pierces"
    },
    "enrolled_members": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "personal_tenant_principal_id": {"type": "string"},
          "former_employer_attestation": {"type": "string"},
          "enrolled_at": {"type": "string", "format": "date-time"}
        }
      }
    },
    "channel_status": {
      "type": "string",
      "enum": ["active", "archived"]
    }
  }
}
