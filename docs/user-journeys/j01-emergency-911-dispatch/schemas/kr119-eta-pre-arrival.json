{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.oyatie.dev/user-journeys/j01/kr119-eta-pre-arrival.json",
  "title": "Kr119EtaPreArrival",
  "description": "AsyncAPI event published by SeoulMFD dispatch backbone to oyatie's SNUH tenant when an ambulance ETA is committed. Triggers ER intake workflow.",
  "_meta": {
    "binding_adr": "ADR-0298",
    "related_adrs": ["ADR-0145", "ADR-0263"],
    "schema_version": "v1.0.0",
    "audit_event_class": "Kr119EtaPreArrivalReceived",
    "cedar_fragment": "kr119-eta-ingest.cedar"
  },
  "type": "object",
  "required": ["event_id", "dispatch_id", "target_facility", "eta_iso", "patient_demographics", "presenting_complaint", "source_attestation"],
  "properties": {
    "event_id": {"type": "string", "format": "uuid"},
    "dispatch_id": {"type": "string"},
    "target_facility": {"type": "string", "examples": ["snuh.org"]},
    "eta_iso": {"type": "string", "format": "date-time"},
    "patient_demographics": {
      "type": "object",
      "required": ["sex", "age_estimate"],
      "properties": {
        "sex": {"enum": ["M", "F", "U"]},
        "age_estimate": {"type": "integer"},
        "name_known": {"type": "boolean"},
        "name_redacted": {"type": "string"}
      }
    },
    "presenting_complaint": {"type": "string"},
    "suspected_diagnosis_codes": {"type": "array", "items": {"type": "string"}},
    "acute_severity_grade": {"type": "string", "enum": ["acute-cardiac-suspect", "acute-neuro-suspect", "acute-trauma", "acute-respiratory", "acute-obstetric", "other"]},
    "source_attestation": {
      "type": "object",
      "properties": {
        "spiffe_id": {"type": "string"},
        "psap_code": {"type": "string"}
      }
    },
    "is_acute_emergency": {"type": "boolean", "const": true}
  },
  "additionalProperties": false
}
