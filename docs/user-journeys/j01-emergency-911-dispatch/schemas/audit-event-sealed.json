{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.oyatie.dev/user-journeys/j01/audit-event-sealed.json",
  "title": "AuditEventSealed",
  "description": "Canonical sealed audit event shape per ADR-0028 + ADR-0263. Every state-changing emission carries this envelope.",
  "_meta": {
    "binding_adr": "ADR-0263",
    "related_adrs": ["ADR-0028", "ADR-0003", "ADR-0145"],
    "schema_version": "v1.0.0"
  },
  "type": "object",
  "required": ["audit_id", "class", "binding_adr", "actor", "subject", "action", "cedar_decision", "tenant_id", "cell_tier", "pack_set", "timestamp", "merkle_proof"],
  "properties": {
    "audit_id": {"type": "string", "pattern": "^audit:[a-f0-9]+$"},
    "class": {"type": "string"},
    "binding_adr": {"type": "string", "pattern": "^ADR-[0-9]{4}$"},
    "actor": {
      "type": "object",
      "properties": {
        "spiffe_id": {"type": "string"},
        "principal_slug": {"type": "string"},
        "attested_at": {"type": "string", "format": "date-time"},
        "attestation_chain_hash": {"type": "string"}
      }
    },
    "subject": {
      "type": "object",
      "properties": {
        "user": {"type": "string"},
        "tenant": {"type": "string"},
        "cell_tier": {"type": "integer", "minimum": 0, "maximum": 4},
        "compliance_packs": {"type": "array", "items": {"type": "string"}}
      }
    },
    "action": {"type": "string"},
    "cedar_decision": {"enum": ["PERMIT", "DENY", "FORBID"]},
    "cedar_fragment": {"type": "string"},
    "fields_returned": {"type": "array", "items": {"type": "string"}},
    "pii_class": {"type": "string"},
    "tenant_id": {"type": "string"},
    "cell_tier": {"type": "integer"},
    "pack_set": {"type": "array", "items": {"type": "string"}},
    "timestamp": {"type": "string", "format": "date-time"},
    "merkle_proof": {
      "type": "object",
      "properties": {
        "tree_root": {"type": "string"},
        "leaf_hash": {"type": "string"},
        "path": {"type": "array", "items": {"type": "string"}}
      }
    },
    "observability": {
      "type": "object",
      "properties": {
        "trace_id": {"type": "string"},
        "span_id": {"type": "string"},
        "metric_emission": {"type": "string"}
      }
    }
  },
  "additionalProperties": true
}
