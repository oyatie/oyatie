{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.oyatie.com/user-journeys/j01/sos-push-payload.json",
  "title": "SosPushPayload",
  "description": "Messenger push payload sent to each opted-in emergency contact when SOS fires.",
  "_meta": {
    "binding_adr": "ADR-0298",
    "related_adrs": ["ADR-0297", "ADR-0263"],
    "schema_version": "v1.0.0",
    "audit_event_class": "MessengerEmergencyPushDelivered",
    "cedar_fragment": "messenger-push-emergency.cedar"
  },
  "type": "object",
  "required": ["audience_type", "from", "kind", "coords", "timestamp", "render_hint"],
  "properties": {
    "audience_type": {"const": "EMERGENCY_SERVICES_SOS"},
    "from": {"type": "string"},
    "kind": {"const": "ios-emergency-sos-relay"},
    "coords": {"$ref": "ios-sos-relay.json#/properties/coords"},
    "timestamp": {"type": "string", "format": "date-time"},
    "render_hint": {
      "type": "object",
      "properties": {
        "banner_class": {"const": "EMERGENCY_SOS_BANNER"},
        "color_contrast_minimum": {"const": 9.2},
        "font_minimum_pt": {"const": 28},
        "haptic_pattern": {"const": "critical-alert"},
        "locale": {"type": "string", "default": "ko-KR"}
      }
    },
    "actions": {
      "type": "array",
      "items": {"enum": ["check-location", "call-back", "send-message"]}
    }
  },
  "additionalProperties": false
}
