{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.oyatie.com/user-journeys/j01/emergency-profile-response.json",
  "title": "EmergencyProfileResponse",
  "description": "Response shape returned to attested PSAP consoles. Field set strictly limited to opt-in fields per consent-graph.",
  "_meta": {
    "binding_adr": "ADR-0298",
    "related_adrs": ["ADR-0244", "ADR-0263", "consent-graph PRD"],
    "schema_version": "v1.0.0",
    "audit_event_class": "EmergencyServiceProfileRead",
    "cedar_fragment": "emergency-services-readonly-attested.cedar"
  },
  "type": "object",
  "required": ["subject_id", "fields_returned", "fields_redacted", "audit_id"],
  "properties": {
    "subject_id": {"type": "string", "description": "Opaque subject identifier; never the principal slug."},
    "name": {"type": "string"},
    "age": {"type": "integer", "minimum": 0, "maximum": 130},
    "medical_alerts": {
      "type": "array",
      "items": {"type": "string"},
      "description": "User-curated list of severe medical alerts (allergies, conditions)."
    },
    "emergency_contacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {"type": "string"},
          "phone_obfuscated": {"type": "string", "pattern": "^\\+[0-9]+-[0-9X-]+$"},
          "notified": {"type": "boolean"}
        }
      }
    },
    "language_pref": {"type": "string"},
    "last_known_location": {
      "type": "object",
      "properties": {
        "label": {"type": "string"},
        "stale_seconds": {"type": "integer"}
      }
    },
    "fields_returned": {"type": "array", "items": {"type": "string"}},
    "fields_redacted": {"type": "array", "items": {"type": "string"}},
    "audit_id": {"type": "string", "pattern": "^audit:[a-f0-9]+$"},
    "cedar_decision_trace": {"type": "string"}
  },
  "additionalProperties": false
}
