{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.oyatie.com/user-journeys/j01/ios-sos-relay.json",
  "title": "IosSosRelay",
  "description": "Payload posted by iOS Emergency SOS relay (Apple device → oyatie emergency-relay endpoint).",
  "_meta": {
    "binding_adr": "ADR-0298",
    "related_adrs": ["ADR-0297", "ADR-0263", "ADR-0292"],
    "compliance_packs_active": ["pack-kr-119-operational-mandate", "pack-kr-pipa-2023-amendment", "global-emergency-services-baseline"],
    "schema_version": "v1.0.0",
    "audit_event_class": "IosSosRelayReceived",
    "cedar_fragment": "emergency-relay-ios-sos.cedar"
  },
  "type": "object",
  "required": ["audience_type", "from", "kind", "device_attestation", "coords", "timestamp"],
  "properties": {
    "audience_type": {
      "type": "string",
      "const": "EMERGENCY_SERVICES_SOS",
      "description": "Per ADR-0297 §D-7 audience-type registry."
    },
    "from": {
      "type": "string",
      "pattern": "^[a-z0-9._-]+@[a-z0-9.-]+$",
      "description": "Subject's oyatie principal slug."
    },
    "kind": {
      "type": "string",
      "enum": ["ios-emergency-sos-relay", "android-emergency-sos-relay", "manual-sos-button"]
    },
    "device_attestation": {
      "type": "string",
      "description": "Apple DeviceCheck attest blob (base64) OR Android Play Integrity token."
    },
    "coords": {
      "type": "object",
      "required": ["lat", "lng", "accuracy_m"],
      "properties": {
        "lat": {"type": "number", "minimum": -90, "maximum": 90},
        "lng": {"type": "number", "minimum": -180, "maximum": 180},
        "accuracy_m": {"type": "number", "minimum": 0}
      }
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "RFC 3339 UTC timestamp with timezone offset."
    },
    "carrier_emergency_call_id": {
      "type": "string",
      "description": "Optional E112 call ID for correlation."
    }
  },
  "additionalProperties": false
}
