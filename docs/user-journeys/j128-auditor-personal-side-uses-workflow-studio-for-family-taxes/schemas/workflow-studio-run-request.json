{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oyatie.dev/specs/journey/j128/workflow-studio-run-request.json",
  "title": "WorkflowStudioRunRequest",
  "version": "1.0.0",
  "_meta": {
    "purpose": "Trigger payload for running a Workflow Studio workflow inside the user's personal tenant.",
    "binding_adr": "ADR-0311-dual-tenant-identity-personal-vs-work-boundary",
    "related_adrs": ["ADR-0246", "ADR-0263"],
    "status": "Proposed",
    "enforcement_status": "advisory-until-2026-07-15"
  },
  "type": "object",
  "required": ["workflow_id", "tenant_id", "principal_id", "inputs"],
  "properties": {
    "workflow_id": {"type": "string", "examples": ["family-tax-2025"]},
    "tenant_id": {"type": "string", "description": "The tenant inside which the workflow runs. Per ADR-0311 §B-3, the workflow's tenant_id MUST match the session's tenant_id."},
    "principal_id": {"type": "string"},
    "inputs": {"type": "object", "description": "Workflow-specific input parameters."},
    "pause_at_steps": {"type": "array", "items": {"type": "integer"}, "description": "Optional step indices to pause at for human review."}
  }
}
