{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oyatie.com/specs/journey/j128/cross-tenant-spouse-share.json",
  "title": "CrossTenantSpouseShare",
  "version": "1.0.0",
  "_meta": {
    "purpose": "Cross-tenant share for the spouse-tax-collaboration permit class. Limited-scope, revocable at any time by either spouse.",
    "binding_adr": "ADR-0311-dual-tenant-identity-personal-vs-work-boundary",
    "related_adrs": ["ADR-0276"],
    "status": "Proposed"
  },
  "type": "object",
  "required": ["share_id", "from_tenant_id", "to_tenant_id", "permit_class", "file_ids", "effective_at"],
  "properties": {
    "share_id": {"type": "string", "format": "uuid"},
    "from_tenant_id": {"type": "string", "description": "Spouse-1's personal tenant"},
    "to_tenant_id": {"type": "string", "description": "Spouse-2's personal tenant"},
    "permit_class": {"const": "spouse-tax-collaboration"},
    "file_ids": {"type": "array", "items": {"type": "string"}, "description": "Specific file IDs covered by the share."},
    "effective_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time", "description": "Default +1 year"},
    "revocable_by_either_party": {"const": true},
    "audit_event_class": {"const": "CrossTenantSpouseShareGranted"}
  }
}
