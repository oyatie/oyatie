{
  "openapi": "3.2.0",
  "info": {
    "title": "j91 US state money transmitter licensing for Yejin overlay action",
    "version": "1.0.0",
    "description": "OpenAPI contract for j91-us-state-money-transmitter-licensing. Exact articles: 31 CFR 1010.100(ff) money transmitter definition; 31 CFR 1022.210 money services business anti-money-laundering program; 31 CFR 1022.320 suspicious activity reporting for money services businesses; California Financial Code section 2030 license requirement and section 2037 surety/securities obligation; New York Banking Law Article 13-B sections 641 licensing and 643 security/bonding; Texas Finance Code Chapter 151 sections 151.302 license and 151.308 security; Florida Statutes Chapter 560 sections 560.125 licensure and 560.209 permissible investments/security; Washington RCW 19.230.030 license required and 19.230.050 surety bond"
  },
  "x-oyatie": {
    "journey_id": "j91",
    "binding_adrs": [
      "ADR-0251-compliance-pack-cell-certification-levels",
      "ADR-0242-oyatie-is-a-tenant-doctrine",
      "ADR-0243-cedar-as-universal-gate",
      "ADR-0244-tenant-as-universal-scoping-primitive",
      "ADR-0248-amazon-shape-cellular-architecture",
      "ADR-0263-observability-emission-contract",
      "ADR-0131-per-microservice-flat-layout",
      "ADR-0105-thirteen-layer-canonical-enum"
    ],
    "pack_overlays": [
      "US-MSB",
      "US-CA-MTL",
      "US-NY-MTL",
      "US-TX-MTL",
      "US-FL-MTL",
      "US-WA-MTL"
    ],
    "cell_certification_levels": [
      "us-general",
      "us-financial-services",
      "state-mtl-evidence-ready"
    ],
    "data_class": "REGULATED_COMPLIANCE_EVIDENCE"
  },
  "paths": {
    "/api/v1/journeys/j91/pack-overlay-actions": {
      "post": {
        "summary": "Execute j91 pack-aware action",
        "operationId": "executeJourneyJ91PackOverlayAction",
        "parameters": [
          {
            "name": "x-tenant-id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PackOverlayAction"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Accepted and audit-sealed"
          },
          "403": {
            "description": "Cedar deny or cell certification failure"
          },
          "409": {
            "description": "Higher-restriction floor conflict"
          },
          "503": {
            "description": "Dependency unavailable and workflow queued"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "PackOverlayAction": {
        "type": "object",
        "required": [
          "journey_id",
          "tenant_id",
          "principal_id",
          "pack_ids",
          "article_refs",
          "idempotency_key"
        ],
        "properties": {
          "journey_id": {
            "type": "string",
            "const": "j91",
            "description": "Journey identifier."
          },
          "tenant_id": {
            "type": "string",
            "description": "Tenant scope for ADR-0244 enforcement."
          },
          "principal_id": {
            "type": "string",
            "description": "WebAuthn-resolved principal."
          },
          "pack_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "examples": [
              [
                "US-MSB",
                "US-CA-MTL",
                "US-NY-MTL",
                "US-TX-MTL",
                "US-FL-MTL",
                "US-WA-MTL"
              ]
            ]
          },
          "article_refs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "examples": [
              [
                "31 CFR 1010.100(ff) money transmitter definition",
                "31 CFR 1022.210 money services business anti-money-laundering program",
                "31 CFR 1022.320 suspicious activity reporting for money services businesses",
                "California Financial Code section 2030 license requirement and section 2037 surety/securities obligation",
                "New York Banking Law Article 13-B sections 641 licensing and 643 security/bonding",
                "Texas Finance Code Chapter 151 sections 151.302 license and 151.308 security",
                "Florida Statutes Chapter 560 sections 560.125 licensure and 560.209 permissible investments/security",
                "Washington RCW 19.230.030 license required and 19.230.050 surety bond"
              ]
            ]
          },
          "cell_certification_level": {
            "type": "string",
            "enum": [
              "us-general",
              "us-financial-services",
              "state-mtl-evidence-ready"
            ]
          },
          "cedar_decision_preview": {
            "type": "string",
            "enum": [
              "permit",
              "forbid",
              "abstain"
            ]
          },
          "idempotency_key": {
            "type": "string"
          },
          "evidence_hash": {
            "type": "string"
          }
        }
      }
    }
  }
}
