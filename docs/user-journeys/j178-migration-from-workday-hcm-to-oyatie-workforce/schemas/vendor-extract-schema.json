{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.oyatie.dev/user-journeys/j178-migration-from-workday-hcm-to-oyatie-workforce/vendor-extract-schema.json",
  "title": "Workday HCM to Oyatie Workforce cutover vendor extract schema",
  "type": "object",
  "required": [
    "journey_id",
    "tenant_id",
    "source_system",
    "batch_id",
    "objects",
    "row_count_manifest",
    "source_hash_manifest"
  ],
  "properties": {
    "journey_id": {
      "const": "j178-migration-from-workday-hcm-to-oyatie-workforce"
    },
    "tenant_id": {
      "const": "northstar-clinics"
    },
    "source_system": {
      "const": "workday-prod-supervisory-org"
    },
    "incumbent_system": {
      "const": "Workday HCM"
    },
    "target_system": {
      "const": "Oyatie workforce"
    },
    "extraction_mechanism": {
      "const": "Workday EIB extract with signed integration-system-user handoff"
    },
    "projection": {
      "const": "oyatie.workforce.worker_position_projection_v1"
    },
    "batch_id": {
      "type": "string",
      "pattern": "^batch-J[0-9]{3}-[0-9]{2}$"
    },
    "extracted_at": {
      "type": "string",
      "format": "date-time"
    },
    "objects": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Worker": {
          "type": "object",
          "description": "Employee and contingent worker record",
          "required": [
            "Worker_ID",
            "Employee_ID",
            "Legal_Name",
            "Hire_Date"
          ],
          "properties": {
            "Worker_ID": {
              "type": "string"
            },
            "Employee_ID": {
              "type": "string"
            },
            "Legal_Name": {
              "type": "string"
            },
            "Hire_Date": {
              "type": "string"
            },
            "Worker_Type": {
              "type": "string"
            },
            "Supervisory_Org": {
              "type": "string"
            }
          }
        },
        "Position": {
          "type": "object",
          "description": "Position management object",
          "required": [
            "Position_ID",
            "Job_Profile",
            "Supervisory_Org",
            "Time_Type"
          ],
          "properties": {
            "Position_ID": {
              "type": "string"
            },
            "Job_Profile": {
              "type": "string"
            },
            "Supervisory_Org": {
              "type": "string"
            },
            "Time_Type": {
              "type": "string"
            },
            "Location": {
              "type": "string"
            },
            "FTE": {
              "type": "string"
            }
          }
        },
        "Compensation": {
          "type": "object",
          "description": "Compensation package",
          "required": [
            "Compensation_Plan",
            "Grade",
            "Base_Pay",
            "Allowance"
          ],
          "properties": {
            "Compensation_Plan": {
              "type": "string"
            },
            "Grade": {
              "type": "string"
            },
            "Base_Pay": {
              "type": "string"
            },
            "Allowance": {
              "type": "string"
            },
            "Effective_Date": {
              "type": "string"
            }
          }
        },
        "Performance": {
          "type": "object",
          "description": "Review and goal record",
          "required": [
            "Review_ID",
            "Period",
            "Rating",
            "Goal"
          ],
          "properties": {
            "Review_ID": {
              "type": "string"
            },
            "Period": {
              "type": "string"
            },
            "Rating": {
              "type": "string"
            },
            "Goal": {
              "type": "string"
            },
            "Manager_Comment": {
              "type": "string"
            },
            "Acknowledgement": {
              "type": "string"
            }
          }
        },
        "Benefit_Election": {
          "type": "object",
          "description": "Benefit plan election",
          "required": [
            "Plan_ID",
            "Coverage_Level",
            "Dependents",
            "Effective_Date"
          ],
          "properties": {
            "Plan_ID": {
              "type": "string"
            },
            "Coverage_Level": {
              "type": "string"
            },
            "Dependents": {
              "type": "string"
            },
            "Effective_Date": {
              "type": "string"
            },
            "Payroll_Deduction": {
              "type": "string"
            }
          }
        }
      }
    },
    "row_count_manifest": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "object_name",
          "source_count",
          "target_count",
          "delta_count"
        ],
        "properties": {
          "object_name": {
            "enum": [
              "Worker",
              "Position",
              "Compensation",
              "Performance",
              "Benefit_Election"
            ]
          },
          "source_count": {
            "type": "integer",
            "minimum": 0
          },
          "target_count": {
            "type": "integer",
            "minimum": 0
          },
          "delta_count": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "source_hash_manifest": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "object_name",
          "hash_algorithm",
          "hash_value"
        ],
        "properties": {
          "object_name": {
            "enum": [
              "Worker",
              "Position",
              "Compensation",
              "Performance",
              "Benefit_Election"
            ]
          },
          "hash_algorithm": {
            "const": "sha256"
          },
          "hash_value": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64
          }
        }
      }
    }
  },
  "additionalProperties": false
}
