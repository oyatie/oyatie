{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oyatie.cloud/schemas/j168/quarterly-ops-metric-snapshot.json",
  "title": "j168 Quarterly Ops Metric Snapshot",
  "description": "Immutable per-quarter snapshot of operational metrics. Sealed in audit-chain with Merkle root.",
  "type": "object",
  "required": ["quarter", "tenant", "snapshot_generated_at_utc", "cells", "headline_metrics", "audit_seal", "merkle_root", "sealed"],
  "properties": {
    "quarter": {
      "type": "string",
      "pattern": "^Q[1-4]-[0-9]{4}$",
      "description": "Quarter identifier (e.g., Q4-2026)"
    },
    "tenant": {
      "type": "string",
      "description": "Source tenant for this snapshot"
    },
    "snapshot_generated_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "snapshot_generated_at_local_iana": {
      "type": "string",
      "description": "Local time with IANA zone indicator (e.g., 2026-05-12T09:00:00+09:00)"
    },
    "snapshot_locale_default": {
      "type": "string",
      "enum": ["ja-JP", "es-MX", "en-US", "pt-BR", "de-DE"],
      "default": "es-MX"
    },
    "cells": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/CellSnapshot"}
    },
    "headline_metrics": {"$ref": "#/$defs/HeadlineMetrics"},
    "active_incidents": {"$ref": "#/$defs/IncidentCounts"},
    "audit_seal": {
      "type": "string",
      "pattern": "^EVT-J168-Q[0-9]+-METRIC-SNAPSHOT-[0-9]+$"
    },
    "merkle_root": {
      "type": "string",
      "pattern": "^sha384-[a-f0-9]{96}$"
    },
    "sealed": {"type": "boolean", "const": true},
    "sealed_by_principal": {"type": "string"},
    "sealed_at_utc": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "CellSnapshot": {
      "type": "object",
      "required": ["cell_id", "azs", "metrics", "region"],
      "properties": {
        "cell_id": {"type": "string"},
        "region": {"type": "string", "enum": ["amer", "eu", "apac"]},
        "tier": {"type": "integer", "minimum": 0, "maximum": 4},
        "certifications": {"type": "array", "items": {"type": "string"}},
        "azs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "metrics": {"$ref": "#/$defs/CellMetrics"},
        "per_az_breakdown": {"type": "array", "items": {"$ref": "#/$defs/AZMetrics"}}
      }
    },
    "CellMetrics": {
      "type": "object",
      "required": ["p99_latency_ms", "throughput_req_per_sec", "error_budget_burn_rate", "capacity_util_pct", "nps", "on_call_burnout_score"],
      "properties": {
        "p99_latency_ms": {"type": "number"},
        "p999_latency_ms": {"type": "number"},
        "throughput_req_per_sec": {"type": "number"},
        "error_budget_burn_rate": {"type": "number"},
        "error_rate_pct": {"type": "number"},
        "capacity_util_pct": {"type": "number"},
        "headcount_per_az": {"type": "number"},
        "nps": {"type": "number", "minimum": -100, "maximum": 100},
        "nps_baseline_pre_quarter": {"type": "number"},
        "on_call_burnout_score": {"type": "number", "minimum": 0, "maximum": 10},
        "on_call_pages_per_engineer_per_week": {"type": "number"},
        "cedar_decision_p99_ms": {"type": "number"},
        "audit_seal_p99_ms": {"type": "number"},
        "tenant_count": {"type": "integer"},
        "active_subscriptions_mxn_arr": {"type": "number"},
        "service_credit_mxn_quarter_total": {"type": "number"},
        "incidents": {"$ref": "#/$defs/IncidentCounts"},
        "data_residency_attestation": {"type": "string"},
        "iso_27001_attestation_id": {"type": "string"},
        "soc2_attestation_id": {"type": "string"},
        "regional_pack_overlay": {"type": "array", "items": {"type": "string"}}
      }
    },
    "AZMetrics": {
      "type": "object",
      "properties": {
        "az_id": {"type": "string"},
        "p99_latency_ms": {"type": "number"},
        "throughput_req_per_sec": {"type": "number"},
        "capacity_util_pct": {"type": "number"},
        "headcount": {"type": "integer"}
      }
    },
    "HeadlineMetrics": {
      "type": "object",
      "properties": {
        "cell_weighted_p99_latency_ms": {"type": "number"},
        "total_throughput_req_per_sec": {"type": "number"},
        "cell_weighted_error_budget_burn_rate": {"type": "number"},
        "cell_weighted_capacity_util_pct": {"type": "number"},
        "cell_weighted_nps": {"type": "number"},
        "cell_weighted_on_call_burnout_score": {"type": "number"},
        "total_arr_mxn": {"type": "number"},
        "total_service_credit_mxn": {"type": "number"}
      }
    },
    "IncidentCounts": {
      "type": "object",
      "properties": {
        "sev_1": {"type": "integer", "minimum": 0},
        "sev_2": {"type": "integer", "minimum": 0},
        "sev_3": {"type": "integer", "minimum": 0},
        "sev_4": {"type": "integer", "minimum": 0}
      }
    }
  },
  "examples": [
    {
      "quarter": "Q4-2026",
      "tenant": "aurelia-robotics-internacional-sa-de-cv-mx",
      "snapshot_generated_at_utc": "2026-05-12T00:00:00Z",
      "snapshot_generated_at_local_iana": "2026-05-12T09:00:00+09:00",
      "snapshot_locale_default": "ja-JP",
      "cells": [
        {
          "cell_id": "apac-tokyo-cell-tier-1-primary",
          "region": "apac",
          "tier": 1,
          "certifications": ["ISO-27001", "SOC2", "ISMS-PIA-Mark", "JP-PIPA"],
          "azs": ["apac-tokyo-az-a", "apac-tokyo-az-b", "apac-tokyo-az-c"],
          "metrics": {
            "p99_latency_ms": 94,
            "throughput_req_per_sec": 28400,
            "error_budget_burn_rate": 0.94,
            "capacity_util_pct": 64,
            "headcount_per_az": 4.3,
            "nps": 41,
            "nps_baseline_pre_quarter": 71,
            "on_call_burnout_score": 6.8,
            "on_call_pages_per_engineer_per_week": 8.4,
            "cedar_decision_p99_ms": 2.8,
            "audit_seal_p99_ms": 5.2,
            "tenant_count": 92,
            "active_subscriptions_mxn_arr": 218000000,
            "service_credit_mxn_quarter_total": 312000,
            "incidents": {"sev_1": 0, "sev_2": 1, "sev_3": 2, "sev_4": 7},
            "data_residency_attestation": "jp-data-residency-attested",
            "iso_27001_attestation_id": "iso-27001-att-apac-tokyo-2026-04-30",
            "soc2_attestation_id": "soc2-att-apac-tokyo-2026-04-30",
            "regional_pack_overlay": ["JP-PIPA", "JP-corporate-governance"]
          }
        }
      ],
      "headline_metrics": {
        "cell_weighted_p99_latency_ms": 94,
        "total_throughput_req_per_sec": 418000,
        "cell_weighted_error_budget_burn_rate": 0.74,
        "cell_weighted_capacity_util_pct": 62,
        "cell_weighted_nps": 68,
        "cell_weighted_on_call_burnout_score": 4.8,
        "total_arr_mxn": 7840000000,
        "total_service_credit_mxn": 312000
      },
      "active_incidents": {"sev_1": 0, "sev_2": 1, "sev_3": 4, "sev_4": 47},
      "audit_seal": "EVT-J168-Q4-METRIC-SNAPSHOT-001",
      "merkle_root": "sha384-7c2a8e4b1d9f3a6c8e2b4d6f8a1c3e5b7d9f2a4c6e8b1d3f5a7c9e2b4d6f8a1c3e5b7d9f2a4c6e8b1d3f5a",
      "sealed": true,
      "sealed_by_principal": "akira.watanabe@aurelia-robotics-internacional-sa-de-cv-mx",
      "sealed_at_utc": "2026-05-12T08:42:18Z"
    }
  ]
}
