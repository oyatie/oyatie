{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://oya.cloud/schemas/j158/creator-employer-disclosure-form.json",
  "title": "Creator-employer side-business disclosure form",
  "description": "Schema for the side-business disclosure record signed by an employee (acting in their personal tenant as a content creator or other side-business owner) and their employer (acting in the employer tenant). This record is the Cedar permit-precondition for the ADR-0311 §dual-tenant-boundary-with-creator-employer-disclosure permit class, which allows one-way info-only signals from the personal tenant to the employer tenant.",
  "type": "object",
  "required": [
    "disclosure_id",
    "subject_principal",
    "subject_tenant",
    "employer_tenant",
    "scope",
    "side_business_class",
    "signatures",
    "validity",
    "boundary_terms",
    "unicode_policy"
  ],
  "properties": {
    "disclosure_id": {
      "type": "string",
      "pattern": "^disclosure-[a-z0-9-]+-[a-z0-9-]+-[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "examples": ["disclosure-haewon-kim-sungkyul-sangsa-2024-08-12"]
    },
    "subject_principal": {
      "type": "string",
      "description": "The employee's personal-tenant principal (UTF-8 NFC)",
      "examples": ["haewon.kim@personal-haewon-kim-kr"]
    },
    "subject_tenant": {
      "type": "string",
      "examples": ["personal-haewon-kim-kr"]
    },
    "employer_tenant": {
      "type": "string",
      "examples": ["sungkyul-sangsa-print-co-kr"]
    },
    "scope": {
      "type": "string",
      "description": "Human-readable scope of the side business",
      "examples": ["personal_shorts_creator_business"]
    },
    "side_business_class": {
      "type": "string",
      "enum": [
        "content_creator_short_form_video",
        "content_creator_long_form_video",
        "content_creator_blog",
        "content_creator_podcast",
        "content_creator_streaming",
        "ecommerce_seller",
        "freelance_consulting",
        "marketplace_seller",
        "rideshare_or_delivery",
        "other"
      ]
    },
    "side_business_detail": {
      "type": "object",
      "properties": {
        "platform_handles_redacted": {
          "type": "array",
          "items": {"type": "string"},
          "description": "List of platform handles; redacted by default in employer-visible storage; full visibility requires explicit subject grant"
        },
        "content_themes": {
          "type": "array",
          "items": {"type": "string"},
          "examples": [["paper folding ASMR", "print shop behind-the-scenes"]]
        },
        "filming_location_overlap": {
          "type": "boolean",
          "description": "Does the side business involve filming at or referencing the employer's premises?"
        },
        "employer_brand_referenced": {
          "type": "boolean",
          "description": "Does the side business mention or visually reference the employer brand?"
        }
      }
    },
    "boundary_terms": {
      "type": "object",
      "required": ["personal_data_isolation", "disclosure_signal_class_allowed", "max_signal_payload_bytes"],
      "properties": {
        "personal_data_isolation": {
          "type": "string",
          "enum": ["strict_no_cross_tenant_data_flow", "strict_no_cross_tenant_data_flow_except_signals"]
        },
        "disclosure_signal_class_allowed": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "creator_spike_info_only",
              "creator_pause_info_only",
              "creator_milestone_info_only",
              "creator_employer_brand_mention_info_only"
            ]
          },
          "minItems": 1
        },
        "max_signal_payload_bytes": {
          "type": "integer",
          "maximum": 4096,
          "default": 1024
        },
        "employer_consent_for_premises_filming": {
          "type": "boolean",
          "description": "If side business involves filming at employer premises, this must be true"
        },
        "employer_brand_use_terms": {
          "type": "string",
          "description": "Free-text terms governing employer-brand use in content"
        }
      }
    },
    "signatures": {
      "type": "object",
      "required": ["subject_signature", "employer_signature"],
      "properties": {
        "subject_signature": {
          "type": "object",
          "required": ["signer_principal", "signed_at", "passkey_assertion_b64"],
          "properties": {
            "signer_principal": {"type": "string"},
            "signed_at": {"type": "string", "format": "date-time"},
            "passkey_assertion_b64": {"type": "string", "format": "byte"},
            "wet_signature_image_id": {"type": "string", "description": "Optional handwritten signature image for jurisdictions requiring it"}
          }
        },
        "employer_signature": {
          "type": "object",
          "required": ["signer_principal", "signer_role", "signed_at", "passkey_assertion_b64"],
          "properties": {
            "signer_principal": {"type": "string"},
            "signer_role": {"type": "string", "enum": ["owner", "managing_director", "hr_director", "ceo", "managing_partner"]},
            "signed_at": {"type": "string", "format": "date-time"},
            "passkey_assertion_b64": {"type": "string", "format": "byte"},
            "addendum_text": {"type": "string", "description": "Optional employer-side addendum (e.g. specific brand-use terms)"}
          }
        },
        "witness_signature": {
          "type": "object",
          "description": "Optional witness signature (required in some jurisdictions)",
          "properties": {
            "signer_principal": {"type": "string"},
            "signed_at": {"type": "string", "format": "date-time"},
            "passkey_assertion_b64": {"type": "string", "format": "byte"}
          }
        }
      }
    },
    "validity": {
      "type": "object",
      "required": ["effective_from", "expires_at", "renewal_required"],
      "properties": {
        "effective_from": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time", "description": "Default 3 years from signing"},
        "renewal_required": {"type": "boolean", "default": true},
        "renewal_notice_days": {"type": "integer", "default": 60}
      }
    },
    "revocation": {
      "type": "object",
      "description": "Present only if disclosure was revoked",
      "properties": {
        "revoked_at": {"type": "string", "format": "date-time"},
        "revoked_by_principal": {"type": "string"},
        "revoked_by_role": {"type": "string", "enum": ["subject", "employer", "regulator"]},
        "revocation_reason": {"type": "string"},
        "audit_class": {"type": "string"}
      }
    },
    "jurisdiction": {
      "type": "object",
      "properties": {
        "country_code": {"type": "string", "examples": ["KR", "US", "DE"]},
        "regulator_anchors": {
          "type": "array",
          "items": {"type": "string"},
          "examples": [["KR-Labour-Standards-Act-§17", "KR-PIPA-Art-18", "Workplace-Side-Business-Disclosure-Pack"]]
        }
      }
    },
    "unicode_policy": {
      "type": "object",
      "required": ["normalization", "hangul_preserved", "hanja_preserved"],
      "properties": {
        "normalization": {"type": "string", "enum": ["NFC"]},
        "hangul_preserved": {"type": "boolean", "const": true},
        "hanja_preserved": {"type": "boolean", "const": true},
        "locale_render": {"type": "string", "examples": ["ko-KR", "en-US", "ja-JP", "zh-CN"]}
      }
    },
    "audit": {
      "type": "object",
      "properties": {
        "event_class": {"type": "string", "examples": ["EVT-J158-DISCLOSURE-RECORD-CREATED-DAY-ZERO"]},
        "dual_seal_tenants": {
          "type": "array",
          "items": {"type": "string"},
          "minItems": 2,
          "maxItems": 3
        },
        "merkle_leaf_b64": {"type": "string"},
        "retention_years": {"type": "integer", "minimum": 6}
      }
    }
  }
}
