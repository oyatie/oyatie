{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.oyatie.com/schemas/user-journeys/j23-marketplace-listing-and-first-sale.schema.json",
  "title": "j23 Marketplace listing and first seller payout Journey Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "journey_id",
    "tenant_id",
    "principal_id",
    "audience_type",
    "home_cell",
    "traceparent",
    "service_steps",
    "audit_events",
    "recovery_policy"
  ],
  "_meta": {
    "doc_class": "Schema",
    "version": "1.0.0",
    "status": "Accepted",
    "purpose": "Yejin lists a vintage jacket, completes the first sale, and receives a Stripe payout to a Korean bank after marketplace settlement.",
    "binding_adrs": [
      "ADR-0105",
      "ADR-0131",
      "ADR-0244",
      "ADR-0249",
      "ADR-0263",
      "ADR-0273",
      "ADR-0297",
      "ADR-0299"
    ],
    "contract_surfaces": [
      "OpenAPI 3.2.0",
      "AsyncAPI 3.1.0",
      "proto3"
    ],
    "naming": "BNF v4.1",
    "layer_model": "ADR-0105 13-layer",
    "flat_layout": "ADR-0131"
  },
  "properties": {
    "journey_id": {
      "type": "string",
      "const": "j23",
      "description": "Stable journey id.",
      "examples": [
        "j23"
      ]
    },
    "tenant_id": {
      "type": "string",
      "minLength": 3,
      "description": "ADR-0244 tenant id.",
      "examples": [
        "tenant-personal-seller"
      ]
    },
    "principal_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]{7,127}$",
      "description": "Stable human or delegated principal id.",
      "examples": [
        "principal-yejin-park"
      ]
    },
    "audience_type": {
      "type": "string",
      "description": "ADR-0244 audience type.",
      "examples": [
        "personal-seller"
      ]
    },
    "home_cell": {
      "type": "string",
      "description": "ADR-0248 home cell.",
      "examples": [
        "ap-seoul-1",
        "us-west-2"
      ]
    },
    "traceparent": {
      "type": "string",
      "description": "W3C trace root.",
      "examples": [
        "00-11111111111111111111111111111111-2222222222222222-01"
      ]
    },
    "service_steps": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "service",
          "role",
          "contract",
          "idempotency_key"
        ],
        "properties": {
          "service": {
            "type": "string",
            "enum": [
              "marketplace",
              "payments",
              "identity",
              "mail",
              "community"
            ],
            "description": "Service handling step."
          },
          "role": {
            "type": "string",
            "description": "Journey role."
          },
          "contract": {
            "type": "string",
            "enum": [
              "OpenAPI 3.2.0",
              "AsyncAPI 3.1.0",
              "proto3"
            ],
            "description": "Typed surface."
          },
          "idempotency_key": {
            "type": "string",
            "minLength": 16,
            "description": "Retry key."
          }
        }
      }
    },
    "audit_events": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_class",
          "producer",
          "hlc",
          "sealed"
        ],
        "properties": {
          "event_class": {
            "type": "string",
            "description": "ADR-0263 class."
          },
          "producer": {
            "type": "string",
            "enum": [
              "marketplace",
              "payments",
              "identity",
              "mail",
              "community"
            ],
            "description": "Producer."
          },
          "hlc": {
            "type": "string",
            "description": "Hybrid logical clock."
          },
          "sealed": {
            "type": "boolean",
            "const": true,
            "description": "Seal required."
          }
        }
      }
    },
    "recovery_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "critical_path_rows",
        "rollback_mode",
        "user_visible_copy_key"
      ],
      "properties": {
        "critical_path_rows": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "documentation-rigor 3.2.5 rows."
        },
        "rollback_mode": {
          "type": "string",
          "enum": [
            "compensating-event",
            "idempotent-retry",
            "fail-closed"
          ],
          "description": "Recovery family."
        },
        "user_visible_copy_key": {
          "type": "string",
          "description": "Locale copy key."
        }
      }
    }
  },
  "examples": [
    {
      "journey_id": "j23",
      "tenant_id": "tenant-personal-seller",
      "principal_id": "principal-yejin-park",
      "audience_type": "personal-seller",
      "home_cell": "ap-seoul-1",
      "traceparent": "00-11111111111111111111111111111111-2222222222222222-01",
      "service_steps": [
        {
          "service": "marketplace",
          "role": "seller-listing",
          "contract": "OpenAPI 3.2.0",
          "idempotency_key": "j23-marketplace-0001"
        },
        {
          "service": "payments",
          "role": "stripe-connect-payout",
          "contract": "OpenAPI 3.2.0",
          "idempotency_key": "j23-payments-0001"
        },
        {
          "service": "identity",
          "role": "seller-kyc-lite",
          "contract": "OpenAPI 3.2.0",
          "idempotency_key": "j23-identity-0001"
        },
        {
          "service": "mail",
          "role": "sale-receipt",
          "contract": "OpenAPI 3.2.0",
          "idempotency_key": "j23-mail-0001"
        },
        {
          "service": "community",
          "role": "seller-reputation",
          "contract": "OpenAPI 3.2.0",
          "idempotency_key": "j23-community-0001"
        }
      ],
      "audit_events": [
        {
          "event_class": "j23.marketplace.seller-listing.sealed",
          "producer": "marketplace",
          "hlc": "2026-05-20T00:00:00Z/0",
          "sealed": true
        },
        {
          "event_class": "j23.payments.stripe-connect-payout.sealed",
          "producer": "payments",
          "hlc": "2026-05-20T00:00:00Z/0",
          "sealed": true
        },
        {
          "event_class": "j23.identity.seller-kyc-lite.sealed",
          "producer": "identity",
          "hlc": "2026-05-20T00:00:00Z/0",
          "sealed": true
        },
        {
          "event_class": "j23.mail.sale-receipt.sealed",
          "producer": "mail",
          "hlc": "2026-05-20T00:00:00Z/0",
          "sealed": true
        },
        {
          "event_class": "j23.community.seller-reputation.sealed",
          "producer": "community",
          "hlc": "2026-05-20T00:00:00Z/0",
          "sealed": true
        }
      ],
      "recovery_policy": {
        "critical_path_rows": [
          "3",
          "15",
          "23",
          "25",
          "29"
        ],
        "rollback_mode": "compensating-event",
        "user_visible_copy_key": "user_journey.j23.recovery"
      }
    }
  ]
}
