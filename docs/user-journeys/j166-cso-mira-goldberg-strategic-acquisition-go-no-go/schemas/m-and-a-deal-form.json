{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oyatie.com/schemas/j166/m-and-a-deal-form.json",
  "title": "Skylark + MRT M&A Deal Form (Q2-2027)",
  "description": "JSON schema for the strategic-acquisition decision form. Aggregates deal terms, target inputs, acquirer inputs, financial model scenarios, ML scenario results, pack cross-check, merger filings, counsel review, committee endorsement, board vote, decision record. This is what gets archived to drive WORM + super-Merkle anchored.",
  "type": "object",
  "x-journey-id": "j166-cso-mira-goldberg-strategic-acquisition-go-no-go",
  "x-adrs": ["ADR-0244", "ADR-0263", "ADR-0251", "ADR-0245", "ADR-0255"],
  "required": [
    "deal_metadata",
    "deal_terms",
    "target",
    "acquirer",
    "financial_model_scenarios",
    "ml_scenarios",
    "pack_cross_check",
    "merger_filings",
    "counsel_review",
    "cfo_signoff",
    "committee_endorsement",
    "board_vote",
    "decision_record"
  ],
  "properties": {
    "deal_metadata": {
      "type": "object",
      "required": ["deal_id", "acquirer_tenant_id", "target_tenant_id", "deal_class"],
      "properties": {
        "deal_id": {"type": "string", "const": "mrt-acquisition-2027-q2"},
        "acquirer_tenant_id": {"type": "string", "const": "skylark-logistics-solutions-inc"},
        "target_tenant_id": {"type": "string", "const": "mendelsohn-routing-technologies-inc-de"},
        "deal_class": {"type": "string", "const": "strategic_acquisition_saas_mid_market"},
        "board_decision_target": {"type": "string", "format": "date-time"},
        "signing_target": {"type": "string", "format": "date"},
        "closing_target": {"type": "string", "format": "date"},
        "schema_version": {"type": "string", "const": "1.0.0"}
      }
    },
    "deal_terms": {
      "type": "object",
      "properties": {
        "working_price_usd": {"type": "integer", "example": 186000000},
        "price_range_usd": {
          "type": "object",
          "properties": {
            "low": {"type": "integer", "example": 172000000},
            "high": {"type": "integer", "example": 202000000}
          }
        },
        "structure": {
          "type": "object",
          "properties": {
            "cash_pct": {"type": "number", "example": 0.60},
            "stock_pct": {"type": "number", "example": 0.40}
          }
        },
        "earnout": {
          "type": "object",
          "properties": {
            "amount_usd": {"type": "integer", "example": 30000000},
            "structure": {"type": "string", "enum": ["key_person_vest", "team_retention_pool"]},
            "vest_months": {"type": "integer", "example": 24},
            "key_person_principal": {"type": "string"},
            "conditions_for_vest": {"type": "string"}
          }
        }
      }
    },
    "target": {
      "type": "object",
      "properties": {
        "name_utf8_nfc": {"type": "string", "const": "Mendelsohn Routing Technologies Inc."},
        "tenant_id": {"type": "string"},
        "country_of_incorporation": {"type": "string", "const": "DE"},
        "headquarters_city": {"type": "string", "const": "Berlin"},
        "founder_principal": {"type": "string", "const": "bjorn.mendelsohn@mendelsohn-routing-technologies-inc-de"},
        "employee_count": {"type": "integer", "example": 138},
        "arr_ttm_usd": {"type": "integer", "example": 42000000},
        "arr_growth_yoy": {"type": "number", "example": 0.31},
        "gross_margin": {"type": "number", "example": 0.78},
        "customer_count": {"type": "integer", "example": 340},
        "avg_arr_per_customer_usd": {"type": "integer", "example": 123500},
        "cac_ltm_usd": {"type": "integer", "example": 48000},
        "ltv_cac_ratio": {"type": "number", "example": 4.2},
        "net_dollar_retention": {"type": "number", "example": 1.17},
        "gross_dollar_retention": {"type": "number", "example": 0.94},
        "customer_concentration_top10_pct": {"type": "number", "example": 0.31}
      }
    },
    "acquirer": {
      "type": "object",
      "properties": {
        "name_utf8_nfc": {"type": "string", "const": "Skylark Logistics Solutions Inc."},
        "tenant_id": {"type": "string"},
        "country_of_incorporation": {"type": "string", "const": "US"},
        "headquarters_city": {"type": "string", "const": "Boston"},
        "employee_count": {"type": "integer", "example": 480},
        "arr_ttm_usd": {"type": "integer", "example": 148000000},
        "customer_count": {"type": "integer", "example": 1820},
        "avg_arr_per_customer_usd": {"type": "integer", "example": 81300},
        "net_dollar_retention": {"type": "number", "example": 1.28},
        "last_round_post_money_usd": {"type": "integer", "example": 1100000000}
      }
    },
    "financial_model_scenarios": {
      "type": "object",
      "properties": {
        "model_template": {"type": "string", "const": "m-and-a-acquisition-saas-mid-market-v4"},
        "scenarios": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "properties": {
              "price_usd": {"type": "integer"},
              "revenue_multiple_arr": {"type": "number"},
              "ntm_accretive_months": {"type": "integer"},
              "year_3_irr": {"type": "number"},
              "year_5_irr": {"type": "number"},
              "year_3_cumulative_cash_usd": {"type": "integer"},
              "year_5_cumulative_cash_usd": {"type": "integer"},
              "dilution_to_acquirer_stock_pct": {"type": "number"}
            }
          }
        },
        "board_irr_threshold": {"type": "number", "const": 0.20},
        "threshold_evaluation_per_scenario": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "price_usd": {"type": "integer"},
              "passes_threshold": {"type": "boolean"}
            }
          }
        }
      }
    },
    "ml_scenarios": {
      "type": "object",
      "required": ["monte_carlo", "cohort_churn", "integration_cost", "provenance"],
      "properties": {
        "monte_carlo": {
          "type": "object",
          "properties": {
            "iterations": {"type": "integer", "const": 10000},
            "scenarios": {
              "type": "object",
              "properties": {
                "recession_p10": {"type": "object"},
                "neutral_p50": {"type": "object"},
                "tailwind_p90": {"type": "object"},
                "probability_weighted_irr_y5": {"type": "number", "example": 0.23}
              }
            }
          }
        },
        "cohort_churn": {
          "type": "object",
          "properties": {
            "horizon_years": {"type": "integer", "const": 5},
            "year_by_year": {"type": "array"}
          }
        },
        "integration_cost": {
          "type": "object",
          "properties": {
            "point_estimate_usd": {"type": "integer", "example": 14200000},
            "ci_95_lower_usd": {"type": "integer", "example": 9400000},
            "ci_95_upper_usd": {"type": "integer", "example": 19000000},
            "primary_drivers": {"type": "array", "items": {"type": "string"}}
          }
        },
        "provenance": {
          "type": "object",
          "properties": {
            "models": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "model_id": {"type": "string"},
                  "type": {"type": "string", "enum": ["generative_ai", "deterministic_forecast"]}
                }
              }
            },
            "eu_ai_act_article_50_declaration_present": {"type": "boolean", "const": true},
            "deterministic_seed": {"type": "string"},
            "reproducibility_verified": {"type": "boolean", "const": true}
          }
        }
      }
    },
    "pack_cross_check": {
      "type": "object",
      "properties": {
        "acquirer_packs": {"type": "array", "items": {"type": "string"}},
        "target_packs": {"type": "array", "items": {"type": "string"}},
        "overlap_analysis": {
          "type": "object",
          "properties": {
            "common": {"type": "array", "items": {"type": "string"}},
            "acquirer_only": {"type": "array", "items": {"type": "string"}},
            "target_only": {"type": "array", "items": {"type": "string"}}
          }
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "blocker_id": {"type": "string"},
              "description": {"type": "string"},
              "remediation_cost_usd": {"type": "integer"},
              "remediation_timeline_months": {"type": "integer"}
            }
          }
        },
        "strategic_positives": {"type": "array", "items": {"type": "object"}},
        "compatibility_score_pct": {"type": "number", "example": 0.84}
      }
    },
    "merger_filings": {
      "type": "object",
      "properties": {
        "filings_required": {"type": "array", "items": {"type": "string"}, "example": ["HSR-US", "Germany-BWB"]},
        "filings_voluntary": {"type": "array", "items": {"type": "string"}, "example": ["UK-CMA"]},
        "filings_not_required": {"type": "array", "items": {"type": "string"}, "example": ["EU-Merger-Control", "Israeli-IMC"]},
        "per_jurisdiction": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "jurisdiction": {"type": "string"},
              "filing_status": {"type": "string"},
              "filing_fee_usd": {"type": "integer"},
              "waiting_period_days": {"type": "integer"},
              "recommended_counsel": {"type": "string"}
            }
          }
        },
        "estimated_clearance_window_days": {"type": "integer", "example": 45}
      }
    },
    "counsel_review": {
      "type": "object",
      "properties": {
        "reviewer_principal": {"type": "string", "const": "daphne.harrowgate@skylark-logistics-solutions-inc"},
        "redline_count": {"type": "integer", "example": 4},
        "redlines": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "redline_id": {"type": "string", "pattern": "^R[0-9]+$"},
              "subject": {"type": "string"}
            }
          }
        },
        "deal_term_clarifications": {"type": "array", "items": {"type": "string"}},
        "review_duration_minutes": {"type": "integer"},
        "completed_at": {"type": "string", "format": "date-time"},
        "passkey_assertion_present": {"type": "boolean", "const": true}
      }
    },
    "cfo_signoff": {
      "type": "object",
      "properties": {
        "cfo_principal": {"type": "string", "const": "reginald.otis@skylark-logistics-solutions-inc"},
        "financial_model_review_complete": {"type": "boolean", "const": true},
        "ml_scenario_acknowledgment": {"type": "boolean", "const": true},
        "concerns_documented": {"type": "array", "items": {"type": "string"}},
        "signoff_at": {"type": "string", "format": "date-time"},
        "passkey_assertion_present": {"type": "boolean", "const": true}
      }
    },
    "committee_endorsement": {
      "type": "object",
      "properties": {
        "strategy_committee": {
          "type": "object",
          "properties": {
            "chair": {"type": "string", "const": "margarita.velasco-heim@skylark-logistics-solutions-inc"},
            "endorsement_count": {"type": "integer"},
            "committee_size": {"type": "integer", "const": 5},
            "endorsed": {"type": "boolean"},
            "votes": {"type": "array"}
          }
        },
        "audit_committee": {
          "type": "object",
          "properties": {
            "chair": {"type": "string", "const": "hannah.beauregard@skylark-logistics-solutions-inc"},
            "endorsement_count": {"type": "integer"},
            "committee_size": {"type": "integer", "const": 5},
            "endorsed": {"type": "boolean"},
            "votes": {"type": "array"}
          }
        }
      }
    },
    "board_vote": {
      "type": "object",
      "properties": {
        "meeting_at": {"type": "string", "format": "date-time"},
        "votes": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "items": {
            "type": "object",
            "properties": {
              "principal": {"type": "string"},
              "principal_display_name_utf8_nfc": {"type": "string"},
              "role": {"type": "string"},
              "vote": {"type": "string", "enum": ["yes", "no", "abstain"]},
              "passkey_asserted": {"type": "boolean", "const": true}
            }
          }
        },
        "yes_count": {"type": "integer"},
        "no_count": {"type": "integer"},
        "abstain_count": {"type": "integer"},
        "majority_threshold": {"type": "integer", "const": 5},
        "result": {"type": "string", "enum": ["GO", "NO_GO"]},
        "voted_at": {"type": "string", "format": "date-time"}
      }
    },
    "decision_record": {
      "type": "object",
      "properties": {
        "drive_archive": {
          "type": "object",
          "properties": {
            "drive_room": {"type": "string", "const": "skylark/board/2027/q2/mrt-acquisition"},
            "filename": {"type": "string"},
            "size_bytes": {"type": "integer"},
            "sha256": {"type": "string"},
            "worm_lock_engaged": {"type": "boolean", "const": true},
            "worm_until": {"type": "string", "format": "date-time"},
            "retention_authority": {"type": "string"}
          }
        },
        "super_merkle_root": {"type": "string", "example": "0xc2f8a4b7e1d6f3a9c4e7b2d5f8a1c6e9b3d7f0a4c8e2b5d9f3a7c0e4b8d2f6a1"},
        "bundle_components": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "role": {"type": "string"},
              "sha256": {"type": "string"}
            }
          }
        },
        "external_transparency_log_batch_id": {"type": "string"},
        "nda_bound_diligence_docs_excluded": {"type": "boolean", "const": true},
        "audit_event_id": {"type": "string", "const": "EVT-J166-DECISION-RECORDED-011"}
      }
    },
    "nda": {
      "type": "object",
      "properties": {
        "nda_record_id": {"type": "string", "const": "nda-skylark-mrt-2027-03-08"},
        "nda_active_at_decision": {"type": "boolean", "const": true},
        "nda_expires": {"type": "string", "format": "date"},
        "return_or_destroy_obligation_active_post_terminate": {"type": "boolean"}
      }
    },
    "next_actions_post_go": {
      "type": "object",
      "properties": {
        "signing_target": {"type": "string", "format": "date", "example": "2027-05-30"},
        "hsr_filing_within_days_of_signing": {"type": "integer", "example": 2},
        "german_bwb_filing_within_days_of_signing": {"type": "integer", "example": 5},
        "estimated_close": {"type": "string", "format": "date", "example": "2027-07-14"},
        "outside_counsel_us": {"type": "string", "example": "Cooley LLP"},
        "outside_counsel_germany": {"type": "string", "example": "Hengeler Mueller"}
      }
    }
  }
}
