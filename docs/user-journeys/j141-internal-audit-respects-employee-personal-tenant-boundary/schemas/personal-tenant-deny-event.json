{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oyatie.dev/schemas/user-journeys/j141/personal-tenant-deny-event.json",
  "title": "PersonalTenantDenyEvent",
  "version": "1.0.0",
  "_meta": {
    "doc_class": "Schema",
    "journey_id": "j141",
    "status": "draft-complete",
    "owner": "axis-internal-audit + council-privacy",
    "binding_adr": "ADR-0311-dual-tenant-identity-personal-vs-work-boundary",
    "related_adrs": [
      "ADR-0244",
      "ADR-0299",
      "ADR-0311",
      "ADR-0312",
      "ADR-0263"
    ],
    "enforcement_status": "advisory-until-2026-07-15"
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "case_id",
    "actor_principal",
    "resource_principal",
    "requested_surface",
    "deny_reason",
    "audit_chain_leaf"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique ADR-0263 event id for the default-deny decision."
    },
    "case_id": {
      "type": "string",
      "description": "Internal-audit case id for j141."
    },
    "actor_principal": {
      "type": "string",
      "description": "Sam Okafor work-tenant principal requesting access."
    },
    "resource_principal": {
      "type": "string",
      "description": "Employee personal-tenant principal whose Messenger remains private."
    },
    "requested_surface": {
      "type": "string",
      "enum": [
        "personal_messenger"
      ],
      "description": "The personal surface that must be denied absent ADR-0312 warrant scope."
    },
    "deny_reason": {
      "type": "string",
      "enum": [
        "cedar_default_deny_personal_tenant",
        "missing_judicial_scope",
        "purpose_not_work_tenant"
      ],
      "description": "Machine-actionable denial class."
    },
    "audit_chain_leaf": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$",
      "description": "Merkle leaf proving the denial was sealed without private content."
    }
  }
}
