{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oyatie.dev/schemas/user-journeys/j141/court-warrant-piercing-request.json",
  "title": "CourtWarrantPiercingRequest",
  "version": "1.0.0",
  "_meta": {
    "doc_class": "Schema",
    "journey_id": "j141",
    "status": "draft-complete",
    "owner": "axis-internal-audit + council-privacy",
    "binding_adr": "ADR-0311-dual-tenant-identity-personal-vs-work-boundary",
    "related_adrs": [
      "ADR-0244",
      "ADR-0299",
      "ADR-0311",
      "ADR-0312",
      "ADR-0263"
    ],
    "enforcement_status": "advisory-until-2026-07-15"
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "warrant_id",
    "case_id",
    "court_order_hash",
    "scope",
    "expires_at",
    "minimization_rules",
    "audit_recipients"
  ],
  "properties": {
    "warrant_id": {
      "type": "string",
      "description": "Court-issued warrant identifier accepted by governance."
    },
    "case_id": {
      "type": "string",
      "description": "Internal-audit or legal case id linked to the warrant."
    },
    "court_order_hash": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$",
      "description": "Hash of the signed order; the order itself stays in legal evidence storage."
    },
    "scope": {
      "type": "object",
      "description": "Bounded dates, parties, terms, and surfaces approved by the court."
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Hard expiry for the piercing grant."
    },
    "minimization_rules": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Rules that redact non-responsive private material."
    },
    "audit_recipients": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tenants and authorities that receive sealed notice events."
    }
  }
}
