{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oyatie.com/schemas/user-journeys/j141/subpoena-request.json",
  "title": "SubpoenaRequest",
  "version": "1.0.0",
  "_meta": {
    "doc_class": "Schema",
    "journey_id": "j141",
    "status": "draft-complete",
    "owner": "axis-internal-audit + council-privacy",
    "binding_adr": "ADR-0311-dual-tenant-identity-personal-vs-work-boundary",
    "related_adrs": [
      "ADR-0244",
      "ADR-0299",
      "ADR-0311",
      "ADR-0312",
      "ADR-0263"
    ],
    "enforcement_status": "advisory-until-2026-07-15"
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id",
    "case_id",
    "requesting_counsel",
    "target_personal_tenant",
    "scope_statement",
    "judicial_forum",
    "status"
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "description": "Governance-issued subpoena request id."
    },
    "case_id": {
      "type": "string",
      "description": "j141 internal-audit case id."
    },
    "requesting_counsel": {
      "type": "string",
      "description": "Outside counsel or legal authority preparing the request."
    },
    "target_personal_tenant": {
      "type": "string",
      "description": "Personal tenant identifier; content is not exposed by this request."
    },
    "scope_statement": {
      "type": "string",
      "description": "Natural-language scope that must become court-approved scope before piercing."
    },
    "judicial_forum": {
      "type": "string",
      "description": "Court or competent authority for ADR-0312 review."
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "submitted",
        "rejected",
        "court_order_required",
        "superseded"
      ],
      "description": "Lifecycle state before any content access can occur."
    }
  }
}
