{
  "openapi": "3.2.0",
  "info": {
    "title": "j95 Combined ISO 27001, ISO 22301, and SOC 2 annual audit for Marcus overlay action",
    "version": "1.0.0",
    "description": "OpenAPI contract for j95-iso-27001-soc-2-annual-audit. Exact articles: ISO/IEC 27001:2022 clauses 4 through 10 and Annex A controls A.5, A.6, A.7, A.8; ISO/IEC 27002:2022 Annex A implementation guidance for organizational, people, physical, and technological controls; ISO 22301:2019 clauses 8.4 incident response, 8.5 business continuity plans, and 8.6 exercise program; AICPA SOC 2 Trust Services Criteria CC1 through CC9; SOC 2 availability criteria A1.1 through A1.3; SOC 2 confidentiality criteria C1.1 through C1.2; SOC 2 processing integrity PI1.1 through PI1.5; SOC 2 privacy criteria P1.1 through P8.1"
  },
  "x-oyatie": {
    "journey_id": "j95",
    "binding_adrs": [
      "ADR-0251-compliance-pack-cell-certification-levels",
      "ADR-0242-oyatie-is-a-tenant-doctrine",
      "ADR-0243-cedar-as-universal-gate",
      "ADR-0244-tenant-as-universal-scoping-primitive",
      "ADR-0248-amazon-shape-cellular-architecture",
      "ADR-0263-observability-emission-contract",
      "ADR-0131-per-microservice-flat-layout",
      "ADR-0105-thirteen-layer-canonical-enum"
    ],
    "pack_overlays": [
      "ISO-27001-2022",
      "ISO-22301-2019",
      "SOC-2-TYPE-II"
    ],
    "cell_certification_levels": [
      "global-enterprise-assurance",
      "business-continuity-ready"
    ],
    "data_class": "REGULATED_COMPLIANCE_EVIDENCE"
  },
  "paths": {
    "/api/v1/journeys/j95/pack-overlay-actions": {
      "post": {
        "summary": "Execute j95 pack-aware action",
        "operationId": "executeJourneyJ95PackOverlayAction",
        "parameters": [
          {
            "name": "x-tenant-id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PackOverlayAction"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Accepted and audit-sealed"
          },
          "403": {
            "description": "Cedar deny or cell certification failure"
          },
          "409": {
            "description": "Higher-restriction floor conflict"
          },
          "503": {
            "description": "Dependency unavailable and workflow queued"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "PackOverlayAction": {
        "type": "object",
        "required": [
          "journey_id",
          "tenant_id",
          "principal_id",
          "pack_ids",
          "article_refs",
          "idempotency_key"
        ],
        "properties": {
          "journey_id": {
            "type": "string",
            "const": "j95",
            "description": "Journey identifier."
          },
          "tenant_id": {
            "type": "string",
            "description": "Tenant scope for ADR-0244 enforcement."
          },
          "principal_id": {
            "type": "string",
            "description": "WebAuthn-resolved principal."
          },
          "pack_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "examples": [
              [
                "ISO-27001-2022",
                "ISO-22301-2019",
                "SOC-2-TYPE-II"
              ]
            ]
          },
          "article_refs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "examples": [
              [
                "ISO/IEC 27001:2022 clauses 4 through 10 and Annex A controls A.5, A.6, A.7, A.8",
                "ISO/IEC 27002:2022 Annex A implementation guidance for organizational, people, physical, and technological controls",
                "ISO 22301:2019 clauses 8.4 incident response, 8.5 business continuity plans, and 8.6 exercise program",
                "AICPA SOC 2 Trust Services Criteria CC1 through CC9",
                "SOC 2 availability criteria A1.1 through A1.3",
                "SOC 2 confidentiality criteria C1.1 through C1.2",
                "SOC 2 processing integrity PI1.1 through PI1.5",
                "SOC 2 privacy criteria P1.1 through P8.1"
              ]
            ]
          },
          "cell_certification_level": {
            "type": "string",
            "enum": [
              "global-enterprise-assurance",
              "business-continuity-ready"
            ]
          },
          "cedar_decision_preview": {
            "type": "string",
            "enum": [
              "permit",
              "forbid",
              "abstain"
            ]
          },
          "idempotency_key": {
            "type": "string"
          },
          "evidence_hash": {
            "type": "string"
          }
        }
      }
    }
  }
}
