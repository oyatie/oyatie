{
  "openapi": "3.2.0",
  "info": {
    "title": "j93 India DPDPA and RBI financial overlay for Aiyana overlay action",
    "version": "1.0.0",
    "description": "OpenAPI contract for j93-in-dpdpa-rbi-financial-overlay. Exact articles: Digital Personal Data Protection Act 2023 section 4 grounds for processing personal data; DPDPA section 5 notice; DPDPA section 6 consent; DPDPA section 7 certain legitimate uses; DPDPA section 8 general obligations of Data Fiduciary; DPDPA section 10 Significant Data Fiduciary obligations; DPDPA sections 11 to 14 data principal access, correction, erasure, grievance redressal, and nomination rights; DPDPA section 16 processing personal data outside India; RBI Master Directions on Prepaid Payment Instruments 2021 paragraphs 9 and 10 for PPI type/limit controls; RBI Payment Aggregator/Payment Gateway Guidelines DPSS.CO.PD.No.1810/02.14.008/2019-20 paragraphs 7 merchant onboarding and 10 escrow account operations"
  },
  "x-oyatie": {
    "journey_id": "j93",
    "binding_adrs": [
      "ADR-0251-compliance-pack-cell-certification-levels",
      "ADR-0242-oyatie-is-a-tenant-doctrine",
      "ADR-0243-cedar-as-universal-gate",
      "ADR-0244-tenant-as-universal-scoping-primitive",
      "ADR-0248-amazon-shape-cellular-architecture",
      "ADR-0263-observability-emission-contract",
      "ADR-0131-per-microservice-flat-layout",
      "ADR-0105-thirteen-layer-canonical-enum"
    ],
    "pack_overlays": [
      "IN-DPDPA-2023",
      "IN-RBI-PAYMENTS"
    ],
    "cell_certification_levels": [
      "in-sovereign",
      "rbi-payment-evidence-ready"
    ],
    "data_class": "REGULATED_COMPLIANCE_EVIDENCE"
  },
  "paths": {
    "/api/v1/journeys/j93/pack-overlay-actions": {
      "post": {
        "summary": "Execute j93 pack-aware action",
        "operationId": "executeJourneyJ93PackOverlayAction",
        "parameters": [
          {
            "name": "x-tenant-id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PackOverlayAction"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Accepted and audit-sealed"
          },
          "403": {
            "description": "Cedar deny or cell certification failure"
          },
          "409": {
            "description": "Higher-restriction floor conflict"
          },
          "503": {
            "description": "Dependency unavailable and workflow queued"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "PackOverlayAction": {
        "type": "object",
        "required": [
          "journey_id",
          "tenant_id",
          "principal_id",
          "pack_ids",
          "article_refs",
          "idempotency_key"
        ],
        "properties": {
          "journey_id": {
            "type": "string",
            "const": "j93",
            "description": "Journey identifier."
          },
          "tenant_id": {
            "type": "string",
            "description": "Tenant scope for ADR-0244 enforcement."
          },
          "principal_id": {
            "type": "string",
            "description": "WebAuthn-resolved principal."
          },
          "pack_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "examples": [
              [
                "IN-DPDPA-2023",
                "IN-RBI-PAYMENTS"
              ]
            ]
          },
          "article_refs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "examples": [
              [
                "Digital Personal Data Protection Act 2023 section 4 grounds for processing personal data",
                "DPDPA section 5 notice",
                "DPDPA section 6 consent",
                "DPDPA section 7 certain legitimate uses",
                "DPDPA section 8 general obligations of Data Fiduciary",
                "DPDPA section 10 Significant Data Fiduciary obligations",
                "DPDPA sections 11 to 14 data principal access, correction, erasure, grievance redressal, and nomination rights",
                "DPDPA section 16 processing personal data outside India",
                "RBI Master Directions on Prepaid Payment Instruments 2021 paragraphs 9 and 10 for PPI type/limit controls",
                "RBI Payment Aggregator/Payment Gateway Guidelines DPSS.CO.PD.No.1810/02.14.008/2019-20 paragraphs 7 merchant onboarding and 10 escrow account operations"
              ]
            ]
          },
          "cell_certification_level": {
            "type": "string",
            "enum": [
              "in-sovereign",
              "rbi-payment-evidence-ready"
            ]
          },
          "cedar_decision_preview": {
            "type": "string",
            "enum": [
              "permit",
              "forbid",
              "abstain"
            ]
          },
          "idempotency_key": {
            "type": "string"
          },
          "evidence_hash": {
            "type": "string"
          }
        }
      }
    }
  }
}
