{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.oyatie.com/user-journeys/j47/healthcare-billing-claim.json",
  "title": "HealthcareBillingClaim",
  "version": "1.0.0",
  "description": "Shared journey object for j47-healthcare-billing-and-insurance. It lets Yejin Park review a hospital bill, pay the patient portion, and auto-submit the insurance claim while preserving tenant scope, auditability, and cross-service status.",
  "_meta": {
    "purpose": "Bind j47-healthcare-billing-and-insurance to a machine-readable object shared by all participating microservices.",
    "status": "Proposed",
    "binding_adr": "ADR-0244",
    "related_adrs": [
      "ADR-0105",
      "ADR-0131",
      "ADR-0244",
      "ADR-0263",
      "ADR-0273",
      "ADR-0292",
      "ADR-0297",
      "ADR-0299"
    ],
    "enforcement_status": "authoring-target",
    "industry_citations": [
      "Stripe healthcare payments plus X12 837 insurance-claim submission pattern"
    ],
    "contract_surfaces": [
      "OpenAPI 3.2.0",
      "AsyncAPI 3.1.0",
      "proto3",
      "BNF v4.1",
      "ADR-0105 13-layer"
    ],
    "microservice_count_authority": 45,
    "marketplace_settlement_invariant": "marketplace-settles-all-tenant-deals",
    "schema_version": "v1.0.0"
  },
  "type": "object",
  "required": [
    "journey_id",
    "tenant_id",
    "persona",
    "locale",
    "status",
    "correlation_id",
    "service_states",
    "audit",
    "contracts"
  ],
  "properties": {
    "journey_id": {
      "const": "j47-healthcare-billing-and-insurance",
      "description": "Stable journey identifier and collision guard for the j36-j50 range.",
      "examples": [
        "j47-healthcare-billing-and-insurance"
      ]
    },
    "tenant_id": {
      "type": "string",
      "description": "Tenant scope required by ADR-0244; every service must persist or forward it unchanged.",
      "examples": [
        "yejin-personal-health"
      ]
    },
    "persona": {
      "const": "Yejin Park",
      "description": "The named persona whose continuity is preserved across the journey.",
      "examples": [
        "Yejin Park"
      ]
    },
    "locale": {
      "const": "ko-KR",
      "description": "Locale used for UX, notices, and regulated language variants.",
      "examples": [
        "ko-KR"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "waiting_on_human",
        "waiting_on_provider",
        "completed",
        "compensated",
        "denied"
      ],
      "description": "Journey state machine status observed by UX and tests.",
      "examples": [
        "completed"
      ]
    },
    "correlation_id": {
      "type": "string",
      "pattern": "^journey-j[0-9]{2}-[a-z0-9-]+$",
      "description": "Idempotency and trace correlation key shared by OpenAPI, AsyncAPI, and proto3 surfaces.",
      "examples": [
        "journey-j47-healthcare-billing-and-insurance"
      ]
    },
    "service_states": {
      "type": "object",
      "description": "Per-service status map; keys match the flat microservice path names used by ADR-0131.",
      "required": [
        "payments",
        "connect",
        "mail",
        "tenancy",
        "compliance"
      ],
      "properties": {
        "payments": {
          "type": "object",
          "description": "payments owns the hospital-bill-payment role for this journey and records the status it contributes to the shared object.",
          "required": [
            "role",
            "status",
            "audit_event_class"
          ],
          "properties": {
            "role": {
              "const": "hospital-bill-payment",
              "description": "The payments role in the journey handshake.",
              "examples": [
                "hospital-bill-payment"
              ]
            },
            "status": {
              "type": "string",
              "enum": [
                "pending",
                "permitted",
                "denied",
                "degraded",
                "completed",
                "compensated"
              ],
              "description": "Typed service status used by the integration test plan and audit envelope.",
              "examples": [
                "completed"
              ]
            },
            "audit_event_class": {
              "type": "string",
              "description": "ADR-0263 audit event class emitted by this service when the status changes.",
              "examples": [
                "Journey47PaymentsHospitalBillPaymentCommitted"
              ]
            }
          },
          "additionalProperties": false
        },
        "connect": {
          "type": "object",
          "description": "connect owns the insurance-claim-submit role for this journey and records the status it contributes to the shared object.",
          "required": [
            "role",
            "status",
            "audit_event_class"
          ],
          "properties": {
            "role": {
              "const": "insurance-claim-submit",
              "description": "The connect role in the journey handshake.",
              "examples": [
                "insurance-claim-submit"
              ]
            },
            "status": {
              "type": "string",
              "enum": [
                "pending",
                "permitted",
                "denied",
                "degraded",
                "completed",
                "compensated"
              ],
              "description": "Typed service status used by the integration test plan and audit envelope.",
              "examples": [
                "completed"
              ]
            },
            "audit_event_class": {
              "type": "string",
              "description": "ADR-0263 audit event class emitted by this service when the status changes.",
              "examples": [
                "Journey47ConnectInsuranceClaimSubmitCommitted"
              ]
            }
          },
          "additionalProperties": false
        },
        "mail": {
          "type": "object",
          "description": "mail owns the bill-and-eob-thread role for this journey and records the status it contributes to the shared object.",
          "required": [
            "role",
            "status",
            "audit_event_class"
          ],
          "properties": {
            "role": {
              "const": "bill-and-eob-thread",
              "description": "The mail role in the journey handshake.",
              "examples": [
                "bill-and-eob-thread"
              ]
            },
            "status": {
              "type": "string",
              "enum": [
                "pending",
                "permitted",
                "denied",
                "degraded",
                "completed",
                "compensated"
              ],
              "description": "Typed service status used by the integration test plan and audit envelope.",
              "examples": [
                "completed"
              ]
            },
            "audit_event_class": {
              "type": "string",
              "description": "ADR-0263 audit event class emitted by this service when the status changes.",
              "examples": [
                "Journey47MailBillAndEobThreadCommitted"
              ]
            }
          },
          "additionalProperties": false
        },
        "tenancy": {
          "type": "object",
          "description": "tenancy owns the provider-patient-scope role for this journey and records the status it contributes to the shared object.",
          "required": [
            "role",
            "status",
            "audit_event_class"
          ],
          "properties": {
            "role": {
              "const": "provider-patient-scope",
              "description": "The tenancy role in the journey handshake.",
              "examples": [
                "provider-patient-scope"
              ]
            },
            "status": {
              "type": "string",
              "enum": [
                "pending",
                "permitted",
                "denied",
                "degraded",
                "completed",
                "compensated"
              ],
              "description": "Typed service status used by the integration test plan and audit envelope.",
              "examples": [
                "completed"
              ]
            },
            "audit_event_class": {
              "type": "string",
              "description": "ADR-0263 audit event class emitted by this service when the status changes.",
              "examples": [
                "Journey47TenancyProviderPatientScopeCommitted"
              ]
            }
          },
          "additionalProperties": false
        },
        "compliance": {
          "type": "object",
          "description": "compliance owns the healthcare-billing-overlay role for this journey and records the status it contributes to the shared object.",
          "required": [
            "role",
            "status",
            "audit_event_class"
          ],
          "properties": {
            "role": {
              "const": "healthcare-billing-overlay",
              "description": "The compliance role in the journey handshake.",
              "examples": [
                "healthcare-billing-overlay"
              ]
            },
            "status": {
              "type": "string",
              "enum": [
                "pending",
                "permitted",
                "denied",
                "degraded",
                "completed",
                "compensated"
              ],
              "description": "Typed service status used by the integration test plan and audit envelope.",
              "examples": [
                "completed"
              ]
            },
            "audit_event_class": {
              "type": "string",
              "description": "ADR-0263 audit event class emitted by this service when the status changes.",
              "examples": [
                "Journey47ComplianceHealthcareBillingOverlayCommitted"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "audit": {
      "type": "object",
      "description": "ADR-0263 audit envelope shared by all service transitions.",
      "required": [
        "audit_id",
        "trace_id",
        "event_classes",
        "sealed_at"
      ],
      "properties": {
        "audit_id": {
          "type": "string",
          "description": "Audit-chain identifier.",
          "examples": [
            "aud-j47-001"
          ]
        },
        "trace_id": {
          "type": "string",
          "description": "Distributed trace id for observability.",
          "examples": [
            "trace-j47-hero"
          ]
        },
        "event_classes": {
          "type": "array",
          "description": "Audit event classes emitted during this journey.",
          "items": {
            "type": "string"
          },
          "minItems": 5,
          "examples": [
            [
              "Journey47PaymentsHospitalBillPaymentCommitted",
              "Journey47ConnectInsuranceClaimSubmitCommitted",
              "Journey47MailBillAndEobThreadCommitted",
              "Journey47TenancyProviderPatientScopeCommitted",
              "Journey47ComplianceHealthcareBillingOverlayCommitted"
            ]
          ]
        },
        "sealed_at": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when the final audit bundle was sealed.",
          "examples": [
            "2026-06-01T12:00:00Z"
          ]
        }
      },
      "additionalProperties": false
    },
    "contracts": {
      "type": "array",
      "description": "Contract surface names that must remain in sync for this journey.",
      "items": {
        "type": "string",
        "enum": [
          "OpenAPI 3.2.0",
          "AsyncAPI 3.1.0",
          "proto3",
          "BNF v4.1",
          "ADR-0105 13-layer"
        ]
      },
      "minItems": 5,
      "examples": [
        [
          "OpenAPI 3.2.0",
          "AsyncAPI 3.1.0",
          "proto3",
          "BNF v4.1",
          "ADR-0105 13-layer"
        ]
      ]
    }
  },
  "additionalProperties": false
}
