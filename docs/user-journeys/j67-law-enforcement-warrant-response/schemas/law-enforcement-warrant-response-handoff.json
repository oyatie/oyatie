{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.oyatie.dev/user-journeys/j67/law-enforcement-warrant-response-handoff.json",
  "title": "J67LawEnforcementWarrantResponseHandoff",
  "description": "Shared law-enforcement-warrant-response-handoff schema for j67-law-enforcement-warrant-response. Fields are intentionally common across services so OpenAPI 3.2.0, AsyncAPI 3.1.0, and proto3 adapters cannot drift.",
  "_meta": {
    "binding_adrs": [
      "ADR-0105-13-layer-enum-and-check-family-patterns",
      "ADR-0131-per-microservice-flat-layout",
      "ADR-0253-http3-ech-pqc-amendment",
      "ADR-0244-tenant-as-universal-scoping-primitive",
      "ADR-0297-abuse-defence-baseline-anti-bot-spoof-scrape",
      "ADR-0299-account-recovery-resilience",
      "ADR-0292-minor-user-doctrine-coppa-kosa-eu-age-verification",
      "ADR-0263-observability-emission-contract",
      "ADR-0273-per-tenant-dkim-spf-dmarc-email-deliverability",
      "ADR-0307-detection-substrate-streaming-batch",
      "ADR-0308-ml-model-lifecycle-ai-act-compliance",
      "ADR-0311-dual-tenant-identity-personal-vs-work-boundary",
      "ADR-0313-conglomerate-tenant-hierarchy-sovereign-children"
    ],
    "journey_id": "j67",
    "schema_version": "v1.0.0",
    "contract_alignment": {
      "openapi": "3.2.0",
      "asyncapi": "3.1.0",
      "grpc": "proto3",
      "policy_bnf": "v4.1"
    },
    "transport_profile": "HTTP/3 + ECH + PQC hybrid where supported",
    "data_class": "journey-business-record"
  },
  "type": "object",
  "required": [
    "journey_id",
    "tenant_id",
    "principal_id",
    "audience_type",
    "service",
    "role",
    "state",
    "audit_event_class",
    "created_at"
  ],
  "properties": {
    "journey_id": {
      "const": "j67",
      "description": "Stable journey identifier for this cross-product workflow.",
      "examples": [
        "j67"
      ]
    },
    "tenant_id": {
      "type": "string",
      "description": "Tenant scope that owns this record under ADR-0244.",
      "examples": [
        "tenant-acme-work"
      ]
    },
    "principal_id": {
      "type": "string",
      "description": "Passkey-backed principal or service principal performing the action.",
      "examples": [
        "principal:marcus.chen"
      ]
    },
    "audience_type": {
      "type": "string",
      "description": "Cedar input that distinguishes work, personal, auditor, delegated-agent, plugin, or counterparty contexts.",
      "examples": [
        "B2B_WORK"
      ]
    },
    "service": {
      "type": "string",
      "enum": [
        "workflow-engine",
        "identity",
        "drive",
        "mail",
        "audit-chain",
        "compliance",
        "governance"
      ],
      "description": "Microservice currently owning this state transition."
    },
    "role": {
      "type": "string",
      "enum": [
        "legal-review",
        "scope-validation",
        "record-production",
        "user-and-court-notice",
        "chain-of-custody",
        "warrant-pack",
        "legal-authority"
      ],
      "description": "Journey-specific role slice for the owning service."
    },
    "state": {
      "type": "string",
      "enum": [
        "created",
        "authorized",
        "pending-human-review",
        "waiting-counterparty",
        "settling",
        "archived",
        "refused",
        "completed"
      ],
      "description": "Durable state-machine state shared by workflow-engine and service adapters."
    },
    "audit_event_class": {
      "type": "string",
      "description": "ADR-0263 class emitted for this transition.",
      "examples": [
        "J67LawEnforcementWarrantResponseHandoffRecorded"
      ]
    },
    "cedar_decision": {
      "type": "string",
      "enum": [
        "PERMIT",
        "DENY",
        "NOT_APPLICABLE"
      ],
      "description": "Policy result for the transition.",
      "examples": [
        "PERMIT"
      ]
    },
    "marketplace_settlement_ref": {
      "type": [
        "string",
        "null"
      ],
      "description": "Marketplace settlement reference when this workflow touches a tenant deal.",
      "examples": [
        "mkt-j67-settlement-0001"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "description": "Drive, audit-chain, and observability references proving the transition.",
      "items": {
        "type": "string"
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Creation timestamp in RFC 3339 form.",
      "examples": [
        "2026-05-20T12:00:00Z"
      ]
    }
  },
  "additionalProperties": false
}
