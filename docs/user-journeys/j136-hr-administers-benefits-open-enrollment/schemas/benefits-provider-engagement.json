{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oyatie.com/schemas/j136/benefits-provider-engagement.json",
  "title": "BenefitsProviderEngagement",
  "type": "object",
  "_meta": {
    "doc_class": "User-Journey-Schema",
    "journey_id": "j136-hr-administers-benefits-open-enrollment",
    "version": "1.0.0",
    "owners": ["tenancy", "workplace-integration"]
  },
  "required": ["engagement_id", "employer_tenant_id", "provider_tenant_id", "benefits_category", "annual_fee_per_employee", "effective_period", "data_sharing_terms"],
  "properties": {
    "engagement_id": {"type": "string", "format": "uuid"},
    "employer_tenant_id": {"type": "string"},
    "provider_tenant_id": {"type": "string"},
    "benefits_category": {
      "type": "string",
      "enum": ["medical", "dental", "vision", "retirement", "life", "disability", "hsa-fsa", "commuter"]
    },
    "jurisdiction_scope": {"type": "array", "items": {"type": "string"}},
    "annual_fee_per_employee": {"type": "number"},
    "fee_currency": {"type": "string"},
    "effective_period": {
      "type": "object",
      "properties": {"starts_at": {"type": "string", "format": "date"}, "ends_at": {"type": "string", "format": "date"}}
    },
    "data_sharing_terms": {
      "type": "object",
      "properties": {
        "data_classes_shared_to_provider": {"type": "array", "items": {"type": "string"}, "description": "e.g., ['employee_election', 'dependent_data', 'payroll_deduction_amount']"},
        "data_classes_provider_returns": {"type": "array", "items": {"type": "string"}, "description": "e.g., ['policy_id', 'effective_date', 'plan_doc_url']"},
        "data_minimization_principle": {"type": "boolean", "const": true},
        "hipaa_baa_signed": {"type": "boolean", "description": "US only — Business Associate Agreement"},
        "gdpr_data_processor_agreement_signed": {"type": "boolean", "description": "EU only"}
      }
    },
    "renewal_terms": {"type": "object"}
  }
}
