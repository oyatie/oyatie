{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oyatie.dev/schemas/j136/benefits-election.json",
  "title": "BenefitsElection",
  "type": "object",
  "_meta": {
    "doc_class": "User-Journey-Schema",
    "journey_id": "j136-hr-administers-benefits-open-enrollment",
    "version": "1.0.0",
    "owners": ["forms", "workflow-engine"]
  },
  "required": ["election_id", "employee_principal", "cycle_id", "jurisdiction", "elections", "submitted_at", "status"],
  "properties": {
    "election_id": {"type": "string", "format": "uuid"},
    "employee_principal": {"type": "string"},
    "cycle_id": {"type": "string"},
    "jurisdiction": {"type": "string"},
    "elections": {
      "type": "object",
      "properties": {
        "medical": {"type": "object", "properties": {"plan_tier_id": {"type": "string"}, "annual_premium": {"type": "number"}}},
        "dental": {"type": "object"},
        "vision": {"type": "object"},
        "retirement": {"type": "object", "properties": {"contribution_percent": {"type": "number"}, "roth_or_traditional": {"type": "string"}}},
        "life": {"type": "object"},
        "disability": {"type": "object"},
        "hsa_fsa": {"type": "object"},
        "commuter": {"type": "object"}
      }
    },
    "dependents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "dependent_id": {"type": "string"},
          "relationship": {"type": "string", "enum": ["spouse", "domestic_partner", "child", "stepchild", "adopted_child"]},
          "name": {"type": "string"},
          "dob": {"type": "string", "format": "date"},
          "proof_drive_ref": {"type": "string"},
          "applies_to_plans": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "beneficiaries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "beneficiary_id": {"type": "string"},
          "name": {"type": "string"},
          "relationship": {"type": "string"},
          "percentage": {"type": "number", "minimum": 0, "maximum": 100},
          "applies_to_plans": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "submitted_at": {"type": "string", "format": "date-time"},
    "submitted_by": {"type": "string"},
    "status": {"type": "string", "enum": ["draft", "submitted", "validated", "synced_to_providers", "payroll_set", "active", "passive_defaulted"]},
    "compliance_pack_versions": {"type": "object"}
  }
}
