{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oyatie.com/schemas/j136/payroll-deduction.json",
  "title": "PayrollDeduction",
  "type": "object",
  "_meta": {
    "doc_class": "User-Journey-Schema",
    "journey_id": "j136-hr-administers-benefits-open-enrollment",
    "version": "1.0.0",
    "owners": ["payments"]
  },
  "required": ["deduction_id", "employee_principal", "election_id", "category", "amount_per_period", "currency", "frequency", "effective_from"],
  "properties": {
    "deduction_id": {"type": "string", "format": "uuid"},
    "employee_principal": {"type": "string"},
    "election_id": {"type": "string"},
    "category": {"type": "string"},
    "amount_per_period": {"type": "number", "minimum": 0},
    "currency": {"type": "string"},
    "frequency": {"type": "string", "enum": ["weekly", "biweekly", "semimonthly", "monthly"]},
    "effective_from": {"type": "string", "format": "date"},
    "recipient": {
      "type": "object",
      "properties": {
        "type": {"type": "string", "enum": ["provider-tenant", "tax-authority", "employer-retained"]},
        "tenant_id": {"type": "string"},
        "policy_id": {"type": "string"}
      }
    },
    "pre_tax": {"type": "boolean"},
    "deductions_executed": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "pay_period_date": {"type": "string", "format": "date"},
          "amount_executed": {"type": "number"},
          "remitted_at": {"type": "string", "format": "date-time"}
        }
      }
    }
  }
}
