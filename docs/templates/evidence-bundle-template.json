{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.oyatie.com/schemas/evidence-bundle.schema.json",
  "title": "EvidenceBundle",
  "description": "Canonical evidence-bundle shape. Lifts the Phase-00 evidence shape from .omc/scratch/foundry-salvage-from-ultragoal-2026-05-12.md \u00a7D. Every Foundry capability invocation, runbook execution, and IP merge emits a bundle conforming to this schema. CI-validatable via the Buck2/cloud-ci evidence-bundle gate target.",
  "type": "object",
  "_meta": {
    "doc_class": "Template",
    "template_id": "TPL-EVB",
    "status": "Accepted",
    "date": "2026-05-12",
    "purpose": "Schema-valid evidence bundle for capability invocations, runbook executions, IP merges, and audit-chain replay.",
    "enforcing_fitness_lane": "oya-governance-audit-emission",
    "owner_team": "ops-compliance + axis-foundry",
    "adrs_cited": [
      "ADR-0052",
      "ADR-0053",
      "ADR-0054"
    ],
    "related": [
      "docs/decisions/ADR-0709-general-live-apex.md",
      "docs/decisions/ADR-0052-inventory-ledger.md",
      ".omc/scratch/foundry-salvage-from-ultragoal-2026-05-12.md"
    ]
  },
  "required": [
    "bundle_id",
    "schema_version",
    "emitted_at",
    "emitter",
    "topic",
    "tenant_scope",
    "data_classes_touched",
    "outcome",
    "audit_chain_ref",
    "signing"
  ],
  "properties": {
    "bundle_id": {
      "type": "string",
      "pattern": "^EVB-[0-9A-HJKMNP-TV-Z]{26}$",
      "description": "ULID-shaped bundle identifier."
    },
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "emitted_at": {
      "type": "string",
      "format": "date-time"
    },
    "emitter": {
      "type": "object",
      "required": [
        "kind",
        "id",
        "version"
      ],
      "properties": {
        "kind": {
          "enum": [
            "capability",
            "runbook",
            "ip-merge",
            "phase-handoff",
            "milestone-gate"
          ]
        },
        "id": {
          "type": "string",
          "description": "capability id | runbook id | IP-NNN-slug | phase id | milestone id"
        },
        "version": {
          "type": "string"
        },
        "agent_id": {
          "type": "string",
          "description": "agent that emitted, if agent-emitted"
        },
        "human_orchestrator_id": {
          "type": "string",
          "description": "human, if human-emitted"
        }
      }
    },
    "topic": {
      "type": "string",
      "pattern": "^oya\\.[a-z][a-z0-9.-]*$",
      "description": "Audit-chain topic per ADR-0003 (e.g., oya.foundry.capability.invoked). Inventory topic per ADR-0052."
    },
    "tenant_scope": {
      "type": "object",
      "required": [
        "tenant_id_hash",
        "residency_region"
      ],
      "properties": {
        "tenant_id_hash": {
          "type": "string",
          "description": "SHA-256 of tenant id; never PII in bundle"
        },
        "residency_region": {
          "type": "string",
          "examples": [
            "kr-1",
            "us-east-1",
            "eu-west-1"
          ]
        },
        "regional_pack_ref": {
          "type": "string"
        }
      }
    },
    "data_classes_touched": {
      "type": "array",
      "items": {
        "enum": [
          "PUBLIC",
          "INTERNAL",
          "PII_QUASI_IDENTIFIER",
          "PII_DIRECT_IDENTIFIER",
          "PHI",
          "PAYMENT_CARD_PAN",
          "GOVERNMENT_ISSUED_ID",
          "BEHAVIORAL_TENANT_PRODUCT",
          "TELEMETRY_AGGREGATE"
        ]
      },
      "uniqueItems": true
    },
    "inputs_hash": {
      "type": "string",
      "description": "SHA-256 hash of normalized inputs; raw inputs never inlined."
    },
    "outputs_hash": {
      "type": "string",
      "description": "SHA-256 hash of normalized outputs."
    },
    "latency_ms": {
      "type": "integer",
      "minimum": 0
    },
    "outcome": {
      "enum": [
        "success",
        "failure",
        "partial",
        "escalated",
        "rolled-back"
      ]
    },
    "failure_class": {
      "enum": [
        "timeout",
        "auth",
        "policy-denied",
        "schema-violation",
        "provider-error",
        "internal-error",
        "user-cancelled",
        null
      ]
    },
    "audit_chain_ref": {
      "type": "object",
      "required": [
        "event_id",
        "shard"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "pattern": "^EVT-[A-Z0-9-]+-[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "shard": {
          "type": "string",
          "description": "per-tenant per-cell shard id"
        },
        "prior_event_id": {
          "type": "string"
        }
      }
    },
    "regulatory_notifications": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "regulator",
          "obligation",
          "due_by"
        ],
        "properties": {
          "regulator": {
            "type": "string",
            "examples": [
              "KR-PIPC",
              "EU-SA",
              "US-HHS",
              "PCI-acquirer"
            ]
          },
          "obligation": {
            "type": "string",
            "examples": [
              "PIPA Art 34 / 72h",
              "GDPR Art 33 / 72h"
            ]
          },
          "due_by": {
            "type": "string",
            "format": "date-time"
          },
          "sent_at": {
            "type": "string",
            "format": "date-time"
          },
          "artifact_ref": {
            "type": "string"
          }
        }
      }
    },
    "signing": {
      "type": "object",
      "required": [
        "cosign_signature",
        "rekor_log_index"
      ],
      "properties": {
        "cosign_signature": {
          "type": "string"
        },
        "rekor_log_index": {
          "type": "string"
        },
        "cosign_certificate_identity": {
          "type": "string"
        },
        "slsa_provenance_level": {
          "enum": [
            1,
            2,
            3
          ]
        }
      }
    },
    "supersedes_bundle_id": {
      "type": "string",
      "description": "If this bundle replaces an earlier emission for the same event (rare; replay only)."
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true,
      "description": "Per-emitter extension payload; MUST NOT contain raw PII."
    }
  },
  "additionalProperties": false,
  "purpose": "Canonical evidence-bundle shape. Lifts the Phase-00 evidence shape from .omc/scratch/foundry-salvage-from-ultragoal-2026-05-12.md §D."
}
