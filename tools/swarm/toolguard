#!/usr/bin/env bash
# swarm toolguard — deny cargo/buck2 in worker lane shells.
#
# Invoked as `cargo` or `buck2` via shim-bin/ symlinks. Workers must read
# err.txt from the main checkout (written by check-daemon) instead of running
# slow builds. Orchestrator shells set SWARM_ORCHESTRATOR=1 to pass through.
set -euo pipefail

# Prefer invocation name (shim-bin/cargo symlink → basename cargo).
name="$(basename -- "$0")"
if [[ "$name" == "toolguard" ]]; then
  name="${SWARM_TOOLGUARD_AS:-}"
  if [[ -z "$name" && $# -ge 1 && ( "$1" == "cargo" || "$1" == "buck2" ) ]]; then
    name="$1"
    shift
  fi
  if [[ -z "$name" ]]; then
    echo "toolguard: invoke via shim-bin/cargo or shim-bin/buck2 (or SWARM_TOOLGUARD_AS=...)" >&2
    exit 2
  fi
fi

if [[ "$name" != "cargo" && "$name" != "buck2" ]]; then
  echo "toolguard: refusing unexpected tool name '$name'" >&2
  exit 2
fi

if [[ "${SWARM_ORCHESTRATOR:-}" == "1" ]]; then
  # Drop shim-bin from PATH so command -v finds the real binary.
  inv_dir="$(cd "$(dirname -- "$0")" && pwd)"
  path_scrub=""
  if [[ "$(basename -- "$inv_dir")" == "shim-bin" ]]; then
    path_scrub="$inv_dir"
  elif [[ -d "${inv_dir}/shim-bin" ]]; then
    path_scrub="${inv_dir}/shim-bin"
  fi
  cleaned=()
  IFS=':' read -r -a path_parts <<< "${PATH:-}"
  for p in "${path_parts[@]}"; do
    [[ -n "$p" ]] || continue
    if [[ -n "$path_scrub" && "$p" == "$path_scrub" ]]; then
      continue
    fi
    cleaned+=("$p")
  done
  export PATH="$(IFS=':'; echo "${cleaned[*]}")"
  real="$(command -v "$name" || true)"
  if [[ -z "${real:-}" ]]; then
    echo "toolguard: SWARM_ORCHESTRATOR=1 but cannot find real '$name' on PATH" >&2
    exit 127
  fi
  exec "$real" "$@"
fi

echo "toolguard: DENIED: '$name' is blocked in worker lane shells" >&2
echo "toolguard: read err.txt at repo root; use check daemon" >&2
echo "toolguard: (orchestrator override: SWARM_ORCHESTRATOR=1)" >&2
exit 1
