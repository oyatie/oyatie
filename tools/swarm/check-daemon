#!/usr/bin/env python3
"""swarm check-daemon — orchestrator-owned buck2 [check] → err.txt + .check/errors.json.

Runs only when SWARM_ORCHESTRATOR=1 from the main checkout. Workers never run
cargo or buck2; they read the human file at <main-checkout>/err.txt (absolute
convention on this machine: /Users/jasonlee/Developer/oyatie/err.txt).

Founder directive 2026-05-29 (tools/hooks/no-cargo-enforcer.sh): cargo
build|check|test|clippy|run|bench is retired. Blessed type-check is
`buck2 build //...[check]`. This daemon must never invoke cargo.

Modes (SWARM_CHECK_MODE):
  workspace (default) — `buck2 build //...[check]`
  per-target          — `buck2 build <target>` for each entry in
                        SWARM_CHECK_TARGETS (comma-separated buck labels,
                        typically ending in [check])

Beads escalation (stub):
  Persistent errors across two consecutive runs with no owning lane should become
  a bead. Wire-up (not executed here — stub only):

    bd create --title "check-daemon: <crate> <file> persists" \\
      --labels "swarm,check-daemon,root:<root>" \\
      --description "See .check/errors.json fingerprint=<fp>; err.txt at repo root."

  State for the two-run ratchet lives at .check/escalation-state.json (written
  when SWARM_BEADS_ESCALATE=1; default is dry-run documentation only).
"""

from __future__ import annotations

import json
import os
import re
import subprocess
import sys
import time
from collections import defaultdict
from datetime import datetime, timezone
from pathlib import Path
from typing import Any


DENY_MSG = "check-daemon: requires SWARM_ORCHESTRATOR=1 (main checkout only)"

# rustc-style: error[E0308]: …  /  warning: …  /  error: …
_DIAG_HEAD = re.compile(
    r"^(?P<level>error|warning)(?:\[(?P<code>[^\]]+)\])?:\s*(?P<message>.*)$"
)
#   --> path/to/file.rs:12:34
_DIAG_ARROW = re.compile(
    r"^\s*-->\s+(?P<file>.+?):(?P<line>\d+):(?P<col>\d+)\s*$"
)
# Building //pkg:name[check]  /  Action failed for … //pkg:name[check]
_BUCK_TARGET = re.compile(
    r"(?://[^\s:\]]+(?::[^\s\[]+)?)(?:\[[^\]]+\])?"
)
_TARGET_NAME = re.compile(r":(?P<name>[^/\s\[]+)(?:\[[^\]]+\])?\s*$")


def die(msg: str, code: int = 1) -> None:
    print(msg, file=sys.stderr)
    raise SystemExit(code)


def repo_root() -> Path:
    override = os.environ.get("SWARM_MAIN_CHECKOUT")
    if override:
        return Path(override).resolve()
    try:
        out = subprocess.check_output(
            ["git", "rev-parse", "--show-toplevel"],
            text=True,
            stderr=subprocess.DEVNULL,
        ).strip()
        return Path(out).resolve()
    except (subprocess.CalledProcessError, FileNotFoundError):
        return Path.cwd().resolve()


def is_allowed_checkout(root: Path) -> bool:
    """Main checkout, explicit candidate root, or a Swarm `.worktrees/` station."""
    if (root / ".git").is_dir():
        return True
    if os.environ.get("SWARM_ALLOW_WORKTREE") == "1":
        return True
    if os.environ.get("SWARM_CANDIDATE_ROOT", "").strip():
        return True
    # Linked integ/worker stations live under .worktrees/ per envelopes topology.
    return ".worktrees" in root.parts


def resolve_buck2() -> str:
    """Find real buck2, scrubbing tools/swarm/shim-bin so toolguard is not re-entered."""
    path_parts = [p for p in os.environ.get("PATH", "").split(":") if p]
    cleaned = [
        p for p in path_parts if not p.rstrip("/").endswith("tools/swarm/shim-bin")
    ]
    for d in cleaned:
        cand = Path(d) / "buck2"
        if cand.is_file() and os.access(cand, os.X_OK):
            return str(cand)
    die("check-daemon: cannot find real buck2 on PATH (shim-bin scrubbed)")


def crate_from_target(label: str | None) -> str:
    if not label:
        return "unknown"
    m = _TARGET_NAME.search(label)
    return m.group("name") if m else label


def run_buck2_check(root: Path, targets: list[str]) -> tuple[str, int]:
    """Run buck2 build on targets; return combined output + exit code.

    Non-zero is expected when there are compile errors; still parse diagnostics.
    """
    buck2 = resolve_buck2()
    env = os.environ.copy()
    env["SWARM_ORCHESTRATOR"] = "1"
    # Keep going so one failing crate does not hide the rest (surface-all).
    cmd = [buck2, "build", "--keep-going", *targets]
    print(f"check-daemon: {' '.join(cmd)}", file=sys.stderr)
    proc = subprocess.run(
        cmd,
        cwd=root,
        capture_output=True,
        text=True,
        env=env,
    )
    out, err = proc.stdout or "", proc.stderr or ""
    if out and err and not out.endswith("\n"):
        out += "\n"
    return out + err, proc.returncode


def parse_rustc_diagnostics(text: str) -> list[dict[str, Any]]:
    """Parse rustc-style diagnostics from buck2 stdout/stderr text."""
    diags: list[dict[str, Any]] = []
    current_crate = "unknown"
    pending: dict[str, Any] | None = None

    def flush() -> None:
        nonlocal pending
        if pending is not None:
            diags.append(pending)
            pending = None

    for raw in text.splitlines():
        line = raw.rstrip("\n")
        # Track buck target context for crate grouping.
        if "Building " in line or "Action failed" in line or "Failed to build" in line:
            found = _BUCK_TARGET.findall(line)
            if found:
                # Prefer a label that looks like a [check] subtarget when present.
                checkish = [t for t in found if "[check]" in t]
                current_crate = crate_from_target(
                    checkish[-1] if checkish else found[-1]
                )

        head = _DIAG_HEAD.match(line)
        if head:
            flush()
            pending = {
                "crate": current_crate,
                "file": "<unknown>",
                "level": head.group("level"),
                "message": head.group("message") or "",
                "code": head.group("code"),
                "span": {
                    "line_start": None,
                    "line_end": None,
                    "column_start": None,
                    "column_end": None,
                },
            }
            continue

        arrow = _DIAG_ARROW.match(line)
        if arrow and pending is not None:
            pending["file"] = arrow.group("file")
            line_n = int(arrow.group("line"))
            col_n = int(arrow.group("col"))
            pending["span"] = {
                "line_start": line_n,
                "line_end": line_n,
                "column_start": col_n,
                "column_end": col_n,
            }
            # If crate still unknown, derive a coarse name from the path stem.
            if pending["crate"] == "unknown":
                parts = Path(pending["file"]).parts
                if "crates" in parts:
                    idx = parts.index("crates")
                    if idx + 1 < len(parts):
                        pending["crate"] = parts[idx + 1]
                elif len(parts) >= 2:
                    pending["crate"] = parts[-2]

    flush()
    return diags


def group_by_crate_file(
    diags: list[dict[str, Any]],
) -> dict[str, dict[str, list[dict[str, Any]]]]:
    grouped: dict[str, dict[str, list[dict[str, Any]]]] = defaultdict(
        lambda: defaultdict(list)
    )
    for d in diags:
        grouped[d["crate"]][d["file"]].append(d)
    return {
        crate: dict(sorted(files.items()))
        for crate, files in sorted(grouped.items())
    }


def render_err_txt(
    grouped: dict[str, dict[str, list[dict[str, Any]]]],
    *,
    root: Path,
    mode: str,
    started: float,
    targets: list[str],
) -> str:
    lines: list[str] = []
    ts = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    elapsed = time.time() - started
    total = sum(len(v) for files in grouped.values() for v in files.values())
    lines.append("# swarm check-daemon err.txt")
    lines.append(f"# generated: {ts}  mode: {mode}  root: {root}")
    lines.append(f"# builder: buck2 build --keep-going {' '.join(targets)}")
    lines.append(f"# diagnostics: {total}  elapsed_s: {elapsed:.1f}")
    lines.append(f"# machine copy: {root / '.check' / 'errors.json'}")
    lines.append("# note: cargo check is retired; blessed path is buck2 //...[check]")
    lines.append("")
    if total == 0:
        lines.append("OK — no compiler errors/warnings from buck2 [check].")
        lines.append("")
        return "\n".join(lines)
    for crate, files in grouped.items():
        lines.append(f"## crate: {crate}")
        lines.append("")
        for file_name, items in files.items():
            lines.append(f"### {file_name}")
            for d in items:
                span = d.get("span") or {}
                loc = ""
                if span.get("line_start") is not None:
                    loc = f":{span['line_start']}"
                    if span.get("column_start") is not None:
                        loc += f":{span['column_start']}"
                code = d.get("code")
                code_s = f" [{code}]" if code else ""
                lines.append(f"  {d['level']}{code_s}{loc}: {d['message']}")
            lines.append("")
    return "\n".join(lines)


_BEADS_STUB = """# Beads escalation hook (stub)

When the same diagnostic fingerprint persists across **two consecutive**
check-daemon runs and no lane owns the crate/file, create a bead:

```bash
bd create \\
  --title "check-daemon: <crate> <file> persists" \\
  --labels "swarm,check-daemon,root:<root>" \\
  --description "fingerprint=<sha>; see .check/errors.json and err.txt at repo root."
```

Enable ratchet state writes with `SWARM_BEADS_ESCALATE=1`. This stub does not
call `bd` automatically — beads remain the durable cross-agent memory; GitHub
Issues stay out of the error loop.
"""


def beads_escalation_stub(
    root: Path, grouped: dict[str, dict[str, list[dict[str, Any]]]]
) -> None:
    """Document + optionally record fingerprints for a future `bd create` hook."""
    check_dir = root / ".check"
    check_dir.mkdir(parents=True, exist_ok=True)
    (check_dir / "beads-escalation.stub.md").write_text(_BEADS_STUB, encoding="utf-8")
    if os.environ.get("SWARM_BEADS_ESCALATE") != "1":
        return
    fps = sorted(
        {
            f"{d['crate']}|{d['file']}|{d.get('code')}|{d['message']}"
            for files in grouped.values()
            for items in files.values()
            for d in items
            if d.get("level") == "error"
        }
    )
    state_path = check_dir / "escalation-state.json"
    prev: dict[str, Any] = {}
    if state_path.is_file():
        try:
            prev = json.loads(state_path.read_text(encoding="utf-8"))
        except json.JSONDecodeError:
            prev = {}
    prev_fps = set(prev.get("fingerprints") or [])
    persistent = sorted(set(fps) & prev_fps)
    state_path.write_text(
        json.dumps(
            {
                "updated": datetime.now(timezone.utc).isoformat(),
                "fingerprints": fps,
                "persistent_across_two_runs": persistent,
                "bd_command_template": (
                    "bd create --title 'check-daemon: {crate} {file} persists' "
                    "--labels 'swarm,check-daemon' --description 'fingerprint={fp}'"
                ),
                "note": "Stub only — does not invoke bd. Operator/orchestrator wires the call.",
            },
            indent=2,
        )
        + "\n",
        encoding="utf-8",
    )


def csv_targets(raw: str) -> list[str]:
    return [t.strip() for t in raw.split(",") if t.strip()]


def parse_targets(mode: str) -> list[str]:
    raw = os.environ.get("SWARM_CHECK_TARGETS", "").strip()
    if mode == "per-target":
        if not raw:
            die(
                "check-daemon: SWARM_CHECK_MODE=per-target requires "
                "SWARM_CHECK_TARGETS=<buck labels, comma-separated>"
            )
        return csv_targets(raw)
    # workspace (default) — whole-graph [check] subtargets
    if raw:
        return csv_targets(raw)
    return ["//...[check]"]


def main() -> None:
    if os.environ.get("SWARM_ORCHESTRATOR") != "1":
        die(DENY_MSG)

    candidate = os.environ.get("SWARM_CANDIDATE_ROOT", "").strip()
    root = Path(candidate).resolve() if candidate else repo_root()
    if not is_allowed_checkout(root):
        die(
            "check-daemon: refusing unmarked linked worktree; "
            "run from main checkout, a `.worktrees/` station, "
            "or set SWARM_CANDIDATE_ROOT=/path/to/candidate "
            "(SWARM_ALLOW_WORKTREE=1 remains a test escape)"
        )

    mode = os.environ.get("SWARM_CHECK_MODE", "workspace").strip().lower()
    # Compatibility alias: old cargo per-crate mode → per-target.
    if mode == "per-crate":
        print(
            "check-daemon: SWARM_CHECK_MODE=per-crate is retired with cargo; "
            "using per-target (set SWARM_CHECK_TARGETS)",
            file=sys.stderr,
        )
        mode = "per-target"
    if mode not in ("workspace", "per-target", "dry-run"):
        print(
            f"check-daemon: unknown SWARM_CHECK_MODE={mode!r}, using workspace",
            file=sys.stderr,
        )
        mode = "workspace"

    started = time.time()
    all_diags: list[dict[str, Any]] = []
    targets: list[str] = ["//...[check]"]
    buck_exit: int | None = None

    if os.environ.get("SWARM_CHECK_DRY_RUN") == "1":
        print(
            "check-daemon: SWARM_CHECK_DRY_RUN=1 — skipping buck2 [check]",
            file=sys.stderr,
        )
        mode = "dry-run"
        targets = []
    else:
        targets = parse_targets(mode)
        text, buck_exit = run_buck2_check(root, targets)
        all_diags = parse_rustc_diagnostics(text)
        if buck_exit != 0 and not all_diags:
            # Any nonzero buck2 exit with zero rustc-style diagnostics is a hard
            # tooling/config/action failure — never publish a false-success OK.
            die(
                f"check-daemon: buck2 build failed (exit {buck_exit}) with no "
                f"parsable rustc diagnostics:\n{text[-4000:]}"
            )

    grouped = group_by_crate_file(all_diags)
    check_dir = root / ".check"
    check_dir.mkdir(parents=True, exist_ok=True)

    payload = {
        "generated_at": datetime.now(timezone.utc).isoformat(),
        "mode": mode,
        "builder": "buck2",
        "targets": targets,
        "buck2_exit": buck_exit,
        "root": str(root),
        "diagnostic_count": len(all_diags),
        "crates": grouped,
        "doctrine": (
            "cargo check retired (founder 2026-05-29 / no-cargo-enforcer); "
            "blessed type-check is buck2 build //...[check] (ADR-0711 Amendment A-2)"
        ),
    }
    errors_json = check_dir / "errors.json"
    errors_json.write_text(json.dumps(payload, indent=2) + "\n", encoding="utf-8")

    err_txt = root / "err.txt"
    err_txt.write_text(
        render_err_txt(
            grouped,
            root=root,
            mode=mode,
            started=started,
            targets=targets or ["(dry-run)"],
        ),
        encoding="utf-8",
    )

    beads_escalation_stub(root, grouped)

    print(f"check-daemon: wrote {err_txt}", file=sys.stderr)
    print(f"check-daemon: wrote {errors_json}", file=sys.stderr)
    # Exit 0 even with diagnostics — daemon's job is to publish, not gate CI.
    raise SystemExit(0)


if __name__ == "__main__":
    main()
