#compdef oya
# tools/completions/zsh/_oya — zsh completion for the oya CLI wrapper
#
# Installation (manual):
#   fpath+=($(pwd)/tools/completions/zsh)
#   autoload -Uz compinit && compinit
# Installation (system):
#   cp tools/completions/zsh/_oya /usr/local/share/zsh/site-functions/_oya

_oya() {
    local -a subcommands
    subcommands=(
        'git:Drop-in git surface with local ledger side channel'
        'vcs:Coordination ratchet compatibility surface'
        'gate:Run foundry quality gates'
        'governance-gates:Governance-layer gate checks'
        'foundation-audit-gates:Foundation audit gate set'
        'catalog:Crate and product catalog operations'
        'check:Run individual check validators'
        'demo:Demo scaffolding helpers'
        'doc:Documentation generation (ADR index, OpenAPI, mdBook, rustdoc)'
        'lint:Lint checks across workspace'
        'onprem:On-premises deployment helpers'
        'ops:Operations commands'
        'submit:Submit artifacts to the Foundry pipeline'
        'supply-chain:Supply chain verification'
        'verify:Verification suite'
        'help:Print help for a subcommand'
    )

    local -a git_subcommands
    git_subcommands=(
        'status:Show working tree status'
        'add:Add file contents to the index'
        'commit:Record changes'
        'diff:Show changes'
        'log:Show commit log'
        'show:Show objects'
        'branch:List or create branches'
        'checkout:Switch branches or restore paths'
        'switch:Switch branches'
        'restore:Restore working tree files'
        'stash:Stash changes'
        'fetch:Download objects and refs'
        'pull:Fetch and integrate'
        'push:Update remote refs'
        'merge:Join histories'
        'rebase:Reapply commits'
        'tag:Create or list tags'
        'remote:Manage remotes'
        'rev-parse:Pick out and massage parameters'
    )

    local -a vcs_subcommands
    vcs_subcommands=(
        'claim:Claim a policy-ratchet scope'
        'work:Start policy-ratchet work'
        'verify:Verify policy-ratchet evidence'
        'done:Emit a policy-ratchet ChangeBundle'
        'status:Read policy-ratchet status'
        'symbols:List policy-ratchet symbols'
        'queue:Read policy-ratchet queue projection'
        'watch:Watch policy-ratchet events'
        'promote:Promote a policy-ratchet bundle'
    )

    local -a doc_subcommands
    doc_subcommands=(
        'adr-index:Generate ADR index'
        'mdbook:Build mdBook documentation'
        'openapi:Generate OpenAPI spec'
        'rustdoc:Generate rustdoc'
        'milestone-audit:Audit milestone completion'
        'product-index:Generate product index'
    )

    _arguments -C \
        '1: :->subcommand' \
        '*: :->args'

    case $state in
        subcommand)
            _describe 'oya subcommand' subcommands
            ;;
        args)
            case ${words[2]} in
                git)
                    _describe 'git subcommand' git_subcommands
                    ;;
                vcs)
                    _describe 'vcs subcommand' vcs_subcommands
                    ;;
                doc)
                    _describe 'doc subcommand' doc_subcommands
                    ;;
                *)
                    _files
                    ;;
            esac
            ;;
    esac
}

_oya "$@"
