# What the driver writes and what it exits with are unit-testable; what GIT DOES with those two
# facts is not, and that is where the data loss lived. This target drives a real `git merge`.
rust_test(
    name = "cargo-lock-merge-driver-app-git-merge-e2e",
    srcs = ["tests/git_merge_e2e.rs"],
