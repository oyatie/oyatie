# task #125 fail-closed proof: a faces merge conflict resolves deterministically via the per-file
# driver (cosmetic) + the post-merge settle (authoritative), and ANY regen/determinism/drift/dirty-
# tree failure leaves the conflict and exits nonzero — NEVER a guessed or partial faces file. The
# settle reuses the doctrine-blessed `oya-cloud-ci-freshness-app::settle_regenerated_faces` engine
# over a FakeRegenPort so the integration tests run with NO buck2.
rust_test(
    name = "oya-faces-merge-driver-app-settle-fixtures",
    srcs = ["tests/settle.rs"],
    crate = "oya_faces_merge_driver_app_settle_fixtures",
    crate_root = "tests/settle.rs",
    visibility = ["PUBLIC"],
    deps = [
        ":oya-faces-merge-driver-app",
        "//cloud/cloud-ci/gates/oya-cloud-ci-freshness-app:oya-cloud-ci-freshness-app",
    ],
)

# Process-level fixtures for the merge-driver binary (`driver %O %A %B %P` + `settle`): the cosmetic
# per-file resolve writes theirs over %A and exits 0; a non-declared face declines (exit 1, %A
# untouched); usage errors exit 2. buck2 injects the binary path via $(location :…).
