{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.oyatie.com/schemas/microservices/calendar.schema.json",
  "title": "MicroservicePrd:Calendar",
  "_meta": {
    "doc_class": "Machine-Readable-Spec",
    "spec_id": "PRD-CALENDAR",
    "version": "1.0.0",
    "status": "Accepted",
    "owner_team": "communications-service-council",
    "created_at": "2026-05-16T14:30:00Z",
    "purpose": "Calendar microservice PRD: personal and professional scheduling, resource booking, action-card handoff, Workflow integration, retention/legal-hold overlays, and cross-pillar-safe availability semantics."
  },
  "identity": {
    "product_id": "calendar",
    "owning_axis": "workspace-communications",
    "product_class": "service",
    "user_facing_surface": true,
    "context_model": [
      "personal",
      "work"
    ],
    "crate_refs_planned": [
      "calendar-kernel",
      "calendar-domain",
      "calendar-app",
      "calendar-rest"
    ],
    "ops_surface": "managed through OpenTofu-owned infrastructure and root Makefile/oya ops targets; no manual SSH troubleshooting path"
  },
  "inherits": {
    "bominal_adrs": [
      "$ref:bominal/decisions/ADR-0208-connect-dual-context-unified-channel-hub.md",
      "$ref:bominal/decisions/ADR-0215-retention-legal-hold-dual-context.md",
      "$ref:bominal/decisions/ADR-0132-data-ownership-pillars.md",
      "$ref:bominal/decisions/ADR-0140-multi-jurisdiction-policy.md",
      "$ref:bominal/decisions/ADR-0111-ciphertext-property-type-and-envelope-encryption.md"
    ],
    "oyatie_specs": [
      "$ref:specs/agent-durable-goal.json",
      "$ref:specs/microservices/workflow.json",
      "$ref:specs/microservices/ontology.json",
      "$ref:specs/deployment-ops-contract.json"
    ],
    "source_docs": [
      "$ref:bominal/docs/products/communications-legacy/enterprise-readiness.md",
      "$ref:bominal/docs/products/communications-legacy/messaging.md",
      "$ref:bominal/docs/products/communications-legacy/internal-communications.md",
      "$ref:bominal/docs/roadmap/family-connect.md"
    ],
    "user_decisions": [
      "2026-05-16:D-13 one PRD per platform plus per-app sub-PRDs",
      "2026-05-16:D-15 canonical PRD form is JSON-with-pointers at specs/microservices/<id>.json"
    ]
  },
  "north_star_ref": "$ref:bominal/decisions/ADR-0208#symmetric-product-model + $ref:bominal/decisions/ADR-0215#four-committed-contracts",
  "target_users": [
    {
      "persona": "employee_end_user",
      "interface": "work calendar, invites, meeting actions",
      "billing": "workspace seat"
    },
    {
      "persona": "personal_user",
      "interface": "personal calendar and reminders",
      "billing": "personal tier"
    },
    {
      "persona": "manager_or_approver",
      "interface": "action cards and approval routing",
      "billing": "workflow execution units"
    },
    {
      "persona": "compliance_officer",
      "interface": "professional event hold/eDiscovery",
      "billing": "compliance entitlement"
    },
    {
      "persona": "scheduler_integrator",
      "interface": "calendar APIs and Workflow triggers",
      "billing": "API units"
    }
  ],
  "acceptance_criteria": [
    {
      "id": "AC-01",
      "given": "a work calendar event is created",
      "when": "attendees accept or change it",
      "then": "event is Org pillar, tenant-DEK encrypted, retention-classed, and audit logged",
      "test_ref": "crates/calendar-domain/tests/work_event.rs::test_work_event_org_pillar_audit"
    },
    {
      "id": "AC-02",
      "given": "a personal calendar event exists",
      "when": "an org admin queries availability details",
      "then": "policy returns only allowed free/busy projection or 403 for details",
      "test_ref": "crates/calendar-domain/tests/personal.rs::test_personal_details_not_org_visible"
    },
    {
      "id": "AC-03",
      "given": "a work event contains an approval action card",
      "when": "user approves inline",
      "then": "Workflow receives a policy-gated handoff and WorkflowHandoffAuditLog links event, action, consent/policy basis",
      "test_ref": "crates/calendar-domain/tests/action_card.rs::test_action_card_workflow_handoff_audited"
    },
    {
      "id": "AC-04",
      "given": "a professional calendar event is under legal hold",
      "when": "retention expiry runs",
      "then": "event, attendee history, action cards, and audit chain are preserved",
      "test_ref": "crates/calendar-domain/tests/legal_hold.rs::test_calendar_hold_preserves_attendee_history"
    },
    {
      "id": "AC-05",
      "given": "a tenant has KR/EU/US policy overlays",
      "when": "calendar retention is computed",
      "then": "the selected retention window stays inside jurisdiction bounds and is visible in admin UX",
      "test_ref": "crates/calendar-domain/tests/retention.rs::test_jurisdiction_bounds"
    }
  ],
  "scope": {
    "in_scope_per_wave": {
      "preview": [
        "event/attendee/resource model",
        "work/personal context separation",
        "basic invites",
        "action-card contract"
      ],
      "stable": [
        "Workflow handoff",
        "resource calendars",
        "recurring events",
        "retention/legal-hold overlays"
      ],
      "GA": [
        "availability federation",
        "calendar migration/coexistence adapters",
        "meeting room/device resources",
        "full mobile/desktop parity"
      ]
    },
    "out_of_scope": [
      {
        "item": "silent personal availability mining for work scheduling",
        "why": "ADR-0215 forbids cross-pillar inference without explicit projection"
      },
      {
        "item": "calendar-to-Workflow inference beyond explicit action cards",
        "why": "advanced optimization out-of-scope by ADR-CAL-0003; initial contract is explicit approvals only — implicit inference is rejected to keep audit chain deterministic"
      },
      {
        "item": "third-party calendar as source of truth",
        "why": "adapters are coexistence/migration only"
      }
    ]
  },
  "contracts": {
    "consumes": [
      "tenant_rbac.context.v1",
      "workflow.handoff.v1",
      "ontology.CalendarEvent",
      "regional.retention_policy.v1"
    ],
    "produces": [
      "calendar.event.v1",
      "calendar.availability_projection.v1",
      "calendar.action_card.v1",
      "calendar.workflow_handoff.v1"
    ]
  },
  "data_model": {
    "entities_ref": [
      {
        "entity": "CalendarEvent",
        "fields": [
          "event_id",
          "tenant_or_person_scope",
          "context_kind",
          "ownership_pillar",
          "title_ciphertext",
          "attendee_refs",
          "resource_refs",
          "retention_policy_id",
          "legal_hold_ids",
          "data_class",
          "starts_at",
          "ends_at"
        ],
        "invariants": [
          "context immutable",
          "details never cross pillar"
        ]
      },
      {
        "entity": "ActionCard",
        "fields": [
          "action_card_id",
          "event_id",
          "workflow_capability_ref",
          "recipient_ref",
          "policy_basis",
          "state",
          "audit_ref"
        ],
        "invariants": [
          "work context only for Workflow handoff"
        ]
      },
      {
        "entity": "AvailabilityProjection",
        "fields": [
          "projection_id",
          "source_event_ref",
          "recipient_scope",
          "granularity",
          "expires_at"
        ],
        "invariants": [
          "minimum necessary disclosure"
        ]
      }
    ],
    "events_emitted": [
      {
        "event": "CalendarEventCreated",
        "topic": "calendar.event",
        "idempotency_key": "event_id"
      },
      {
        "event": "CalendarActionCardCompleted",
        "topic": "calendar.action_card",
        "idempotency_key": "action_card_id+state"
      },
      {
        "event": "CalendarWorkflowHandoffCreated",
        "topic": "audit.calendar.workflow_handoff",
        "idempotency_key": "event_id+workflow_run_id"
      }
    ],
    "persistence": [
      {
        "aggregate": "CalendarEvent",
        "store": "Postgres/RLS",
        "sharding_key": "tenant_or_person_scope+date_bucket",
        "retention": "per jurisdiction/hold"
      },
      {
        "aggregate": "AvailabilityProjection",
        "store": "short-lived cache",
        "sharding_key": "recipient_scope+time_bucket",
        "retention": "minutes-hours only"
      }
    ],
    "audit_chain_emission_rule_ref": "$ref:docs/adr-archive/ADR-0003-audit-chain-and-evidence-emission.md + $ref:specs/agent-durable-goal.json#score_cards"
  },
  "optimization_practices": [
    {
      "practice": "recurrence expansion",
      "implementation": "bounded window expansion with cached occurrence IDs"
    },
    {
      "practice": "availability query",
      "implementation": "minimum-necessary projection; never joins personal details to work"
    },
    {
      "practice": "batch dispatch",
      "implementation": "invite updates and action-card notifications coalesced per event version"
    }
  ],
  "regional_packs": {
    "region_policy_ref": "$ref:docs/adr-archive/ADR-0140-cross-cutting-carriers-adapter-exemption.md (retired per ADR-0145) + $ref:bominal/decisions/ADR-0140",
    "packs": [
      {
        "pack": "KR",
        "required": true,
        "notes": "Korea-first UX, PIPA retention bounds, work-mail retention floor, Korean input/search/calendar locale rules"
      },
      {
        "pack": "US",
        "required": true,
        "notes": "employment discovery, HIPAA/GLBA overlays when vertical data enters professional context"
      },
      {
        "pack": "EU",
        "required": true,
        "notes": "GDPR storage limitation, lawful-basis disclosure, cross-border transfer controls"
      }
    ],
    "validation_lane_ref": "governance-regional-pack-contracts"
  },
  "deps": {
    "external_adopted": [
      {
        "name": "tokio",
        "maturity_tier": "kernel-grade",
        "license": "MIT",
        "decision": "runtime primitive only"
      },
      {
        "name": "serde",
        "maturity_tier": "kernel-grade",
        "license": "MIT OR Apache-2.0",
        "decision": "wire-format primitive only"
      },
      {
        "name": "rustls",
        "maturity_tier": "kernel-grade",
        "license": "Apache-2.0 OR ISC OR MIT",
        "decision": "TLS primitive only"
      }
    ],
    "external_rejected": [
      {
        "name": "Slack/Teams/Google/Microsoft APIs as product substrate",
        "reason": "is native product; third-party platforms may be import/coexistence adapters only"
      },
      {
        "name": "shell-script operational glue",
        "reason": "deployment and validation authority belongs to OpenTofu, Makefile targets, and Rust oya gates"
      }
    ]
  },
  "metrics": [
    {
      "name": "calendar_event_write_p99_ms",
      "targets": {
        "preview": 250,
        "stable": 180,
        "GA": 100
      },
      "verification_ref": "cargo bench -p calendar-domain -- event_write",
      "lane_ref": "perf-budget"
    },
    {
      "name": "availability_query_p99_ms",
      "targets": {
        "preview": 300,
        "stable": 200,
        "GA": 120
      },
      "verification_ref": "cargo bench -p calendar-app -- availability",
      "lane_ref": "perf-budget"
    },
    {
      "name": "workflow_handoff_audit_pct",
      "targets": {
        "preview": 100,
        "stable": 100,
        "GA": 100
      },
      "verification_ref": "oya gate validate calendar-workflow-handoff",
      "lane_ref": "audit-chain"
    },
    {
      "name": "personal_detail_leak_count",
      "targets": {
        "preview": 0,
        "stable": 0,
        "GA": 0
      },
      "verification_ref": "cargo nextest -p calendar-domain -- personal_details_not_visible",
      "lane_ref": "cargo-nextest"
    }
  ],
  "risks": [
    {
      "id": "R-01",
      "severity": "critical",
      "risk": "availability projection leaks personal details",
      "mitigation": "minimum-necessary projection tests and Cedar pillar guard",
      "owner": "communications-service-council"
    },
    {
      "id": "R-02",
      "severity": "high",
      "risk": "calendar Workflow handoff becomes silent automation",
      "mitigation": "explicit action-card and policy disclosure gate",
      "owner": "communications-service-council"
    },
    {
      "id": "R-03",
      "severity": "medium",
      "risk": "recurrence expansion creates unbounded workload",
      "mitigation": "bounded windows and backpressure on sync jobs",
      "owner": "communications-service-council"
    }
  ],
  "competitive": [
    {
      "competitor": "Google Calendar",
      "observed_strengths": [
        "ubiquity",
        "sharing model",
        "resource scheduling"
      ],
      "we_beat_on": [
        "pillar-safe availability",
        "Workflow-native action cards",
        "retention/legal-hold chain"
      ],
      "measurable_target": "personal detail leak count = 0; action handoff audited 100%"
    },
    {
      "competitor": "Outlook Calendar",
      "observed_strengths": [
        "enterprise admin",
        "Exchange integration"
      ],
      "we_beat_on": [
        "native Workflow/Ontology integration and four-eyes disclosure model"
      ],
      "measurable_target": "action-card completion under 30s and audit linked"
    },
    {
      "competitor": "Calendly/Linear integrations",
      "observed_strengths": [
        "scheduling convenience",
        "workflow-ish handoff"
      ],
      "we_beat_on": [
        "no third-party handoff needed; consent/policy basis in core"
      ],
      "measurable_target": "all handoffs have policy_basis and audit_ref"
    }
  ],
  "best_practices": [
    {
      "id": "BP-01",
      "rule": "calendar details are never used as implicit personal-to-work inference source",
      "enforced_by_lane_ref": "governance-calendar-pillar"
    },
    {
      "id": "BP-02",
      "rule": "Workflow handoff is explicit action card or documented tenant policy only",
      "enforced_by_lane_ref": "governance-calendar-workflow-handoff"
    },
    {
      "id": "BP-03",
      "rule": "recurrence expansion is bounded and observable",
      "enforced_by_lane_ref": "governance-calendar-scale"
    }
  ],
  "patterns": [
    {
      "pattern": "availability_projection",
      "when_to_use": "share only free/busy or policy-approved fields across boundaries",
      "reference": "$ref:bominal/decisions/ADR-0215#cross-pillar-boundary-table"
    },
    {
      "pattern": "action_card_handoff",
      "when_to_use": "inline approval from a professional event to Workflow with audit chain",
      "reference": "$ref:bominal/docs/roadmap/family-connect.md#calendar-and-action-card-handoff"
    },
    {
      "pattern": "jurisdiction_bounded_retention",
      "when_to_use": "tenant setting is clipped by KR/EU/US retention rules",
      "reference": "$ref:bominal/decisions/ADR-0215#contract-3"
    }
  ],
  "anti_patterns": [
    {
      "anti_pattern": "silent_calendar_mining",
      "why_forbidden": "turns scheduling into surveillance and violates consent boundary",
      "detection_lane": "governance-calendar-pillar"
    },
    {
      "anti_pattern": "unbounded_recurrence_materialization",
      "why_forbidden": "creates scale and cost runaway",
      "detection_lane": "governance-calendar-scale"
    },
    {
      "anti_pattern": "workflow_handoff_without_policy_basis",
      "why_forbidden": "breaks chain-of-custody and privacy notice",
      "detection_lane": "governance-calendar-workflow-handoff"
    }
  ],
  "goals": {
    "scalability": {
      "target": "10M active identities, 1M concurrent realtime sessions per region family, 100K tenant workspaces per control plane",
      "verification": "oya gate validate calendar-scale-model --repo-root ."
    },
    "security": {
      "target": "zero cross-pillar access, tenant-DEK professional encryption, personal E2E where declared, immutable audit chain for all privileged disclosure",
      "verification": "cargo nextest -p tenant-rbac-domain -- cross_pillar"
    },
    "performance": {
      "target": "interactive p95 under 150ms for inbox/thread/calendar state transitions; realtime fanout p99 under 500ms inside a region",
      "verification": "cargo bench -p calendar-bench -- calendar_hot_paths"
    },
    "efficiency": {
      "target": "per-seat monthly infra cost tracked by message, mailbox, and calendar-event unit economics with no unmetered background fanout",
      "verification": "oya gate validate calendar-finops-unit-economics"
    },
    "reliability": {
      "target": "99.95% GA availability, RPO <= 5m for professional data, RTO <= 30m for regional cell failover",
      "verification": "oya gate validate calendar-slo-coverage"
    }
  },
  "user_experience": {
    "ux_personas_ref": "$ref:specs/tenant-rbac-packaging.json#target_users",
    "accessibility_coverage": "WCAG 2.2 AA minimum; keyboard traversal 100% for inbox, thread, compose, calendar, legal-hold and approval flows",
    "responsive_breakpoints": [
      "mobile-portrait",
      "mobile-landscape",
      "tablet",
      "desktop",
      "wide-desktop"
    ],
    "internationalization_scope": "locale-aware-dynamic; KR and en-US are launch gates, EU locales follow regional-pack coverage",
    "design_system_components_used": "$ref:specs/tenant-rbac-packaging.json#frontend_components",
    "journey_critical_paths": [
      {
        "persona": "enterprise_it_admin",
        "journeys": [
          "configure retention policy",
          "open legal hold",
          "export eDiscovery package"
        ],
        "time_to_success_target": "< 5 minutes with policy warnings visible"
      },
      {
        "persona": "employee_end_user",
        "journeys": [
          "switch personal/work persona",
          "send message/mail/calendar invite",
          "act on approval card"
        ],
        "time_to_success_target": "< 30 seconds for routine send or approve"
      },
      {
        "persona": "compliance_officer",
        "journeys": [
          "search held artifacts",
          "verify chain-of-custody",
          "release or extend hold"
        ],
        "time_to_success_target": "< 10 minutes for scoped investigation packet"
      }
    ],
    "error_state_coverage": {
      "policy_denied": "inline plus audit-safe explanation",
      "network_partition": "offline queue with explicit sync status",
      "legal_hold_conflict": "blocking modal requiring authorized role",
      "delivery_failure": "per-recipient retry/error card"
    },
    "offline_behavior": "read cached non-sensitive state, queue user-owned drafts locally, never expose unwrapped professional plaintext offline without session-bound policy token",
    "keyboard_navigation_coverage_pct": 100,
    "loading_state_coverage": "skeleton for lists, progressive render for thread/calendar, no spinner-only critical paths"
  },
  "frontend_components": [
    {
      "component": "TenantContextSwitcher",
      "source": "planned design-system primitive",
      "design_system_ref": "$ref:specs/design-system/tenant-context-switcher.json",
      "variants": [
        "personal",
        "work",
        "admin-audit"
      ],
      "tested_at_breakpoints": [
        "mobile-portrait",
        "tablet",
        "desktop",
        "wide-desktop"
      ]
    },
    {
      "component": "CommunicationThreadList",
      "source": "planned design-system primitive",
      "design_system_ref": "$ref:specs/design-system/communication-thread-list.json",
      "variants": [
        "mail",
        "messenger",
        "calendar-agenda"
      ],
      "tested_at_breakpoints": [
        "mobile-portrait",
        "tablet",
        "desktop"
      ]
    },
    {
      "component": "PolicyDisclosureBanner",
      "source": "planned design-system primitive",
      "design_system_ref": "$ref:specs/design-system/policy-disclosure-banner.json",
      "variants": [
        "legal-hold",
        "retention",
        "consent-required",
        "audit-access"
      ],
      "tested_at_breakpoints": [
        "mobile-portrait",
        "desktop"
      ]
    }
  ],
  "decision_log": [
    {
      "date": "2026-05-16",
      "decision": "Canonical microservice PRDs are JSON under specs/microservices/<service>; Markdown is projection only",
      "drivers": [
        "user directive: machine optimized PRDs",
        "handoff F-PRD-COMMUNICATIONS-PLATFORM-AUTHOR",
        "shell-to-Rust consolidation"
      ]
    }
  ],
  "sources_scanned": [
    "$ref:bominal/decisions/ADR-0208-connect-dual-context-unified-channel-hub.md",
    "$ref:bominal/decisions/ADR-0215-retention-legal-hold-dual-context.md",
    "$ref:bominal/docs/roadmap/family-connect.md",
    "$ref:bominal/docs/products/communications-legacy/enterprise-readiness.md",
    "$ref:bominal/docs/products/communications-legacy/messaging.md",
    "$ref:bominal/docs/products/communications-legacy/internal-communications.md"
  ]
}
