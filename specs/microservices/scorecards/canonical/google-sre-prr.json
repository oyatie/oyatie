{
  "$schema": "https://oyatie.com/schemas/google-sre-prr.json",
  "canonical_base": true,
  "framework": "Google SRE Production Readiness Review",
  "framework_version": "2024",
  "evaluated_at": "2026-05-18",
  "canonical_authority": "ADR-0064",
  "overlay_consumers": "microservices/<ms>/scorecards/overrides.json#google_sre_prr",
  "_placeholders": {
    "<ms>": "microservice slug",
    "<chart>": "Helm chart subdirectory name (defaults to <ms>)"
  },
  "checklist": {
    "slos_defined": {
      "status": "green",
      "evidence_pattern": "microservices/<ms>/slos/*.openslo.yaml"
    },
    "error_budget_policy": {
      "status": "green",
      "evidence_pattern": "microservices/observability/iac/helm/observability/templates/hyperscaler-invariants-canonical-prometheusrule.yaml#OyaErrorBudgetFastBurn1h14x; microservices/<ms>/iac/helm/<chart>/templates/prometheusrule.yaml (per-SLO burn-rate alerts)"
    },
    "runbooks_complete": {
      "status": "green",
      "evidence_pattern": "microservices/<ms>/runbooks/"
    },
    "dashboards_complete": {
      "status": "green",
      "evidence_pattern": "microservices/<ms>/dashboards/"
    },
    "capacity_model_documented": {
      "status": "green",
      "evidence_pattern": "microservices/<ms>/capacity-model.md"
    },
    "incident_response_documented": {
      "status": "green",
      "evidence_pattern": "microservices/<ms>/incident-response.md"
    },
    "failure_modes_documented": {
      "status": "green",
      "evidence_pattern": "microservices/<ms>/failure-modes.md"
    },
    "blameless_postmortem_culture": {
      "status": "green",
      "evidence_pattern": "docs/standards/incident-postmortem.md (oyatie-wide standard); per-µservice postmortems land in evidence/postmortems/"
    },
    "on_call_rotation_documented": {
      "status": "green",
      "evidence_pattern": "microservices/<ms>/incident-response.md#on-call-rotation"
    },
    "deployment_strategy_documented": {
      "status": "green",
      "evidence_pattern": "microservices/<ms>/iac/helm/<chart>/values.yaml (rolling update + HPA); .github/workflows/promote-dev-to-staging.yml + promote-staging-to-production.yml"
    },
    "multi_region_strategy_documented": {
      "status": "green",
      "evidence_pattern": "microservices/<ms>/multi-region.md"
    }
  },
  "overall_status": "green"
}
