{
  "$schema": "https://oyatie.com/schemas/aws-well-architected.json",
  "canonical_base": true,
  "framework": "AWS Well-Architected (5 pillars)",
  "framework_version": "2024-12",
  "evaluated_at": "2026-05-18",
  "canonical_authority": "ADR-0064",
  "overlay_consumers": "microservices/<ms>/scorecards/overrides.json#aws_well_architected",
  "_placeholders": {
    "<ms>": "microservice slug (e.g. 'notes', 'meet', 'workflow-engine')",
    "<chart>": "Helm chart subdirectory name under iac/helm/ (per-µservice override; defaults to <ms>)"
  },
  "pillars": {
    "operational_excellence": {
      "status": "green",
      "controls": [
        {
          "id": "OPS-01",
          "name": "Runbooks for every recoverable failure mode",
          "evidence_pattern": "microservices/<ms>/runbooks/",
          "passing": true
        },
        {
          "id": "OPS-02",
          "name": "Failure modes catalogued",
          "evidence_pattern": "microservices/<ms>/failure-modes.md",
          "passing": true
        },
        {
          "id": "OPS-03",
          "name": "Incident-response procedure documented",
          "evidence_pattern": "microservices/<ms>/incident-response.md",
          "passing": true
        },
        {
          "id": "OPS-04",
          "name": "IaC-as-code (Helm + Kustomize per ADR-0131)",
          "evidence_pattern": "microservices/<ms>/iac/helm/<chart>/Chart.yaml",
          "passing": true
        },
        {
          "id": "OPS-05",
          "name": "Observability wiring (OTel + Prometheus)",
          "evidence_pattern": "microservices/<ms>/dashboards/",
          "passing": true
        },
        {
          "id": "OPS-06",
          "name": "CI-gated deployment (branch protection + status checks)",
          "evidence_pattern": ".github/branch-protection.yaml; .github/workflows/promote-dev-to-staging.yml; .github/workflows/promote-staging-to-production.yml",
          "passing": true
        }
      ]
    },
    "security": {
      "status": "green",
      "controls": [
        {
          "id": "SEC-01",
          "name": "Threat model authored",
          "evidence_pattern": "microservices/<ms>/threat-model.md",
          "passing": true
        },
        {
          "id": "SEC-02",
          "name": "Secrets via OpenBao SecretReference URI (per ADR-0123)",
          "evidence_pattern": "microservices/<ms>/iac/helm/<chart>/values.yaml#openbao",
          "passing": true
        },
        {
          "id": "SEC-03",
          "name": "Cedar policy gate (ABAC default-deny)",
          "evidence_pattern": "microservices/<ms>/policy/",
          "passing": true
        },
        {
          "id": "SEC-04",
          "name": "TLS in-transit (Istio mTLS mesh)",
          "evidence_pattern": "microservices/cloud-k8s/iac/helm/istio-base/Chart.yaml#mesh-mtls=STRICT",
          "passing": true
        },
        {
          "id": "SEC-05",
          "name": "Branch protection + reviewer-agent APPROVE required",
          "evidence_pattern": ".github/branch-protection.yaml",
          "passing": true
        },
        {
          "id": "SEC-06",
          "name": "DPIA + compliance posture documented",
          "evidence_pattern": "microservices/<ms>/dpia.md, microservices/<ms>/compliance.md",
          "passing": true
        }
      ]
    },
    "reliability": {
      "status": "green",
      "controls": [
        {
          "id": "REL-01",
          "name": "OpenSLO manifests authored",
          "evidence_pattern": "microservices/<ms>/slos/",
          "passing": true
        },
        {
          "id": "REL-02",
          "name": "Capacity model documented",
          "evidence_pattern": "microservices/<ms>/capacity-model.md",
          "passing": true
        },
        {
          "id": "REL-03",
          "name": "Multi-region failover plan",
          "evidence_pattern": "microservices/<ms>/multi-region.md",
          "passing": true
        },
        {
          "id": "REL-04",
          "name": "Backfill / replay procedure",
          "evidence_pattern": "microservices/<ms>/backfill-replay.md",
          "passing": true
        },
        {
          "id": "REL-05",
          "name": "HPA + PDB declared",
          "evidence_pattern": "microservices/<ms>/iac/helm/<chart>/values.yaml#hpa",
          "passing": true
        },
        {
          "id": "REL-06",
          "name": "ADR-0139 SLO-gated promotion",
          "evidence_pattern": "docs/decisions/ADR-0700-ci-admission-live-apex.md",
          "passing": true
        }
      ]
    },
    "performance_efficiency": {
      "status": "green",
      "controls": [
        {
          "id": "PERF-01",
          "name": "Resource requests + limits set",
          "evidence_pattern": "microservices/<ms>/iac/helm/<chart>/values.yaml#resources",
          "passing": true
        },
        {
          "id": "PERF-02",
          "name": "HPA targets cpu+memory utilization",
          "evidence_pattern": "microservices/<ms>/iac/helm/<chart>/values.yaml#hpa",
          "passing": true
        },
        {
          "id": "PERF-03",
          "name": "Capacity model w/ load projection",
          "evidence_pattern": "microservices/<ms>/capacity-model.md",
          "passing": true
        },
        {
          "id": "PERF-04",
          "name": "Caching tier (Valkey/Redis) declared",
          "evidence_pattern": "microservices/<ms>/iac/helm/<chart>/values.yaml (caching declared where applicable)",
          "passing": true
        },
        {
          "id": "PERF-05",
          "name": "Hyperscaler perf-budget lane (registry/quality/lanes.yaml)",
          "evidence_pattern": "registry/quality/lanes.yaml#perf-budget",
          "passing": true
        },
        {
          "id": "PERF-06",
          "name": "Statelessness + shardability validators",
          "evidence_pattern": "registry/quality/lanes.yaml#quality-statelessness, lanes.yaml#quality-shardability",
          "passing": true
        }
      ]
    },
    "cost_optimization": {
      "status": "green",
      "controls": [
        {
          "id": "COST-01",
          "name": "Cost budget documented",
          "evidence_pattern": "microservices/<ms>/cost-budget.md",
          "passing": true
        },
        {
          "id": "COST-02",
          "name": "HPA minReplicas right-sized",
          "evidence_pattern": "microservices/<ms>/iac/helm/<chart>/values.yaml#hpa.minReplicas",
          "passing": true
        },
        {
          "id": "COST-03",
          "name": "Image pinned by LTS policy (no :latest)",
          "evidence_pattern": "microservices/<ms>/iac/helm/<chart>/values.yaml#image.tag",
          "passing": true
        },
        {
          "id": "COST-04",
          "name": "Shared substrate (postgres-citus, redis, openbao) reused",
          "evidence_pattern": "microservices/<ms>/iac/helm/ (substrate sibling charts)",
          "passing": true
        },
        {
          "id": "COST-05",
          "name": "Per-pack overlays (kustomize) avoid per-tenant resource duplication",
          "evidence_pattern": "microservices/<ms>/iac/kustomize/overlays/",
          "passing": true
        }
      ]
    }
  },
  "overall_status": "green"
}
