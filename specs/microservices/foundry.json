  "bounded_contexts_detail": {
    "runtime": {
      "purpose": "Hosts the capability invocation hot path — capability executor, session state, invocation lifecycle orchestrator, runtime pod pool, capability registry cache.",
      "owner_sub_axis": "axis-foundry-runtime",
      "tenant_facing": true,
      "headline_nfr": {
        "metric": "dispatch_p99_ms",
        "target": 50,
        "envelope_note": "excludes LLM round-trip"
      },
      "contract_surface": {
        "openapi": "microservices/foundry/contracts/openapi/runtime-foundry-runtime.yaml",
        "asyncapi": "microservices/foundry/contracts/asyncapi/runtime-foundry-runtime-events.yaml",
        "proto": "microservices/foundry/contracts/proto/runtime-foundry-runtime.proto"
      },
      "ip_range": "IP-001..IP-015",
      "bc_archive": "microservices/foundry/bc-sources/runtime/"
    },
    "supervisor": {
      "purpose": "Control plane — fleet lifecycle, capability deployment, kill-switch + circuit-breaker, autonomy policy enforcement, supervision event bus.",
      "owner_sub_axis": "axis-foundry-supervisor",
      "tenant_facing": true,
      "headline_nfr": {
        "metric": "command_propagation_p99_s",
        "target": 5
      },
      "contract_surface": {
        "openapi": "microservices/foundry/contracts/openapi/supervisor-foundry-supervisor.yaml",
        "asyncapi": "microservices/foundry/contracts/asyncapi/supervisor-foundry-supervisor-events.yaml",
        "proto": "microservices/foundry/contracts/proto/supervisor-foundry-supervisor.proto"
      },
      "ip_range": "IP-016..IP-030",
      "bc_archive": "microservices/foundry/bc-sources/supervisor/"
    },
    "eval": {
      "purpose": "Eval harness — eval runner, parity analyzer, replay engine, golden-output store.",
      "owner_sub_axis": "axis-foundry-eval",
      "tenant_facing": true,
      "headline_nfr": {
        "metric": "eval_scheduling_p99_ms",
        "target": 500
      },
      "contract_surface": {
        "openapi": "microservices/foundry/contracts/openapi/eval-eval-runner.yaml",
        "asyncapi": "microservices/foundry/contracts/asyncapi/eval-eval-events.yaml",
        "proto": "microservices/foundry/contracts/proto/eval-eval_runner.proto"
      },
      "ip_range": "IP-031..IP-045",
      "bc_archive": "microservices/foundry/bc-sources/eval/"
    },
    "evidence": {
      "purpose": "Capability-invocation recorder, evidence pack builder, regulator export, audit-chain bridge.",
      "owner_sub_axis": "axis-foundry-evidence",
      "tenant_facing": true,
      "headline_nfr": {
        "metric": "pack_assembly_p99_s_per_100MB",
        "target": 2
      },
      "contract_surface": {
        "openapi": "microservices/foundry/contracts/openapi/evidence-foundry-evidence.yaml",
        "asyncapi": "microservices/foundry/contracts/asyncapi/evidence-foundry-evidence-events.yaml",
        "proto": "microservices/foundry/contracts/proto/evidence-foundry-evidence.proto"
      },
      "ip_range": "IP-046..IP-060",
      "bc_archive": "microservices/foundry/bc-sources/evidence/"
    },
    "guardrails": {
      "purpose": "Prompt classifier, output validator, autonomy-tier gate, content-safety rule engine, jailbreak detector, AI-slop detector.",
      "owner_sub_axis": "axis-foundry-guardrails",
      "tenant_facing": false,
      "headline_nfr": {
        "metric": "inline_check_p99_ms",
        "target": 20
      },
      "contract_surface": {
        "openapi": "microservices/foundry/contracts/openapi/guardrails-guardrails.yaml",
        "asyncapi": "microservices/foundry/contracts/asyncapi/guardrails-decision-events.yaml",
        "proto": "microservices/foundry/contracts/proto/guardrails-guardrails.proto"
      },
      "ip_range": "IP-061..IP-075",
      "bc_archive": "microservices/foundry/bc-sources/guardrails/"
    },
    "providers": {
      "purpose": "LLM provider router + 8 adapters (Anthropic API + Subscription, OpenAI API + Subscription, Gemini API + Subscription, in-house, OpenBao credential isolation).",
      "owner_sub_axis": "axis-foundry-providers",
      "tenant_facing": true,
      "headline_nfr": {
        "metric": "router_decision_p99_ms",
        "target": 5
      },
      "contract_surface": {
        "openapi": "microservices/foundry/contracts/openapi/providers-provider-router.yaml",
        "asyncapi": "microservices/foundry/contracts/asyncapi/providers-provider-events.yaml",
        "proto": "microservices/foundry/contracts/proto/providers-provider-invoke.proto"
      },
      "ip_range": "IP-076..IP-090",
      "bc_archive": "microservices/foundry/bc-sources/providers/"
    }
  },
  "cross_bc_invariants": [
    {
      "id": "FR-X1",
      "rule": "Every invocation traverses supervisor (admit) → runtime (dispatch) → guardrails (pre-check) → providers (LLM call) → guardrails (post-check) → evidence (seal) → runtime (return)."
    },
    {
      "id": "FR-X2",
      "rule": "Capability deployment by supervisor mirrors to runtime registry-cache within 30s."
    },
    {
      "id": "FR-X3",
      "rule": "Provider credential rotation drains in-flight invocations bound to old credential generation."
    },
    {
      "id": "FR-X4",
      "rule": "Autonomy-tier violation refuses dispatch + emits AutonomyViolationDetected."
    },
    {
      "id": "FR-X5",
      "rule": "Eval harness consumes capability descriptors from supervisor mirror; replays through runtime sandbox pool."
    },
    {
      "id": "FR-X6",
      "rule": "Evidence packs aggregate contributions from all 6 BCs."
    },
    {
      "id": "FR-X7",
      "rule": "Kill-switch by supervisor halts runtime fleets within 10s + emits audit-chain record."
    }
  ],
  "cross_bc_events": [
    {"event": "CapabilityRegistryUpdated", "producer": "supervisor", "consumers": ["runtime"]},
    {"event": "KillSwitchEngaged", "producer": "supervisor", "consumers": ["runtime", "evidence"]},
    {"event": "SupervisionCommandIssued", "producer": "supervisor", "consumers": ["evidence"]},
    {"event": "CapabilityVersionPromotionRequested", "producer": "supervisor", "consumers": ["eval"]},
    {"event": "ProviderCredentialRotated", "producer": "providers", "consumers": ["runtime"]},
    {"event": "ProviderReceiptEmitted", "producer": "providers", "consumers": ["evidence"]},
    {"event": "GuardrailRulesetUpdated", "producer": "guardrails", "consumers": ["runtime"]},
    {"event": "GuardrailDecisionEmitted", "producer": "guardrails", "consumers": ["evidence"]},
    {"event": "EvalRunCompleted", "producer": "eval", "consumers": ["supervisor"]},
    {"event": "EvalEvidenceEmitted", "producer": "eval", "consumers": ["evidence"]},
    {"event": "InvocationCompleted", "producer": "runtime", "consumers": ["evidence"]},
    {"event": "AutonomyViolationDetected", "producer": "runtime", "consumers": ["guardrails", "supervisor", "evidence"]},
    {"event": "RuntimePodDrainCompleted", "producer": "runtime", "consumers": ["supervisor"]}
  ],
