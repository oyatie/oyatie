    "microservice_id": "foundry",
    "owning_axis": "axis-foundry",
    "product_class": "shared-substrate-and-tenant-product",
    "user_facing_surface": true,
    "context_model": [
      "tenant-product",
      "internal-substrate"
    ],
    "bounded_contexts": [
      "runtime",
      "supervisor",
      "eval",
      "evidence",
      "guardrails",
      "providers"
    ],
    "directory": "microservices/foundry/",
    "bc_archive_directory": "microservices/foundry/bc-sources/",
    "ops_surface": "managed through OpenTofu/Helm subcharts under microservices/foundry/iac/helm/<bc>/; per-BC Kustomize overlays under microservices/foundry/iac/kustomize/{base,overlays/pack-<pack>}/<bc>/"
  },
