    }
  },
  "pipeline_stages": [
    {
      "stage_id": "DECLARE",
      "ordinal": 1,
      "payload_type": "DeclaredChangeUnit",
      "purpose": "Capture actor intent, tenant/repository scope, work-area selector, and scm-facts provenance before any admission or materialization work begins.",
      "required_inputs": [
        "tenant_id",
        "repository_id",
        "actor_ref",
        "work_area_selector",
        "scm_facts_ref",
        "toolchain_contract_versions"
      ],
      "emits": [
        "change_unit_id",
        "work_area_hash",
        "declared_dependency_edges",
        "change_intent_ref",
        "audit_chain_ref"
      ],
      "typed_payload_required_fields": [
        "change_unit_id",
        "work_area_hash",
        "actor_ref",
        "work_area_selector",
        "declared_dependency_edges",
        "scm_facts_ref"
      ],
      "handoff_to": "ADMIT",
      "acceptance_rules": [
        "change_unit_id MUST equal work_area_hash",
        "work_area_selector MUST resolve from tracked scm-facts data or explicitly declared generated-source refs",
        "untracked files, absolute host paths, local branch names, and author timestamps are forbidden contract inputs"
      ]
    },
    {
      "stage_id": "ADMIT",
      "ordinal": 2,
      "payload_type": "AdmissionDecision",
      "purpose": "Evaluate policy, ownership, conflict-class, cutover-gate, and candidate scope before any lease is granted.",
      "required_inputs": [
        "DeclaredChangeUnit",
        "tenant_policy_ref",
        "ownership_policy_ref",
        "conflict_class_ref",
        "current_bridge_authority_ref"
      ],
      "emits": [
        "admission_decision_ref",
        "admitted_conflict_classes",
        "required_gate_set_ref",
        "audit_chain_ref"
      ],
      "typed_payload_required_fields": [
        "decision",
        "policy_verdicts",
        "admitted_conflict_classes",
        "required_gate_set_ref",
        "cutover_gate_posture"
      ],
      "handoff_from": "DECLARE",
      "handoff_to": "LEASE",
      "acceptance_rules": [
        "decision MUST be GREEN before LEASE can issue",
        "ADMIT cannot treat affected-only, local-only, or candidate-authored status as merge authority",
        "W4 native cutover remains blocked unless ADR-0510 numeric triggers are separately green"
      ]
    },
    {
      "stage_id": "LEASE",
      "ordinal": 3,
      "payload_type": "LeaseGrant",
      "purpose": "Grant a bounded, sharded, renewable lease for the admitted conflict class; locks are not part of the destination contract.",
      "required_inputs": [
        "AdmissionDecision",
        "conflict_class_ref",
        "shard_key",
        "holder_workload_identity"
      ],
      "emits": [
        "lease_ref",
        "lease_scope",
        "fencing_token",
        "expires_at",
        "renewal_policy",
        "audit_chain_ref"
      ],
      "typed_payload_required_fields": [
        "lease_id",
        "scope",
        "holder",
        "fencing_token",
        "expires_at",
        "renewal_policy",
        "shard_key"
      ],
      "handoff_from": "ADMIT",
      "handoff_to": "ISOLATE",
      "acceptance_rules": [
        "lease_ref MUST be present on LEASE and every downstream stage",
        "lease expiry MUST be bounded and auditable",
        "global locks, unbounded locks, and leader-only mutexes are RED fixtures"
      ]
    },
    {
      "stage_id": "ISOLATE",
      "ordinal": 4,
      "payload_type": "VirtualWorkspaceFrame",
      "purpose": "Create a virtual isolated work area rooted in the admitted work-area hash and lease; materialization is lazy and not a runtime claim in this contract.",
      "required_inputs": [
        "LeaseGrant",
        "DeclaredChangeUnit",
        "work_area_hash",
        "base_tree_ref"
      ],
      "emits": [
        "virtual_workspace_ref",
        "overlay_ref",
        "materialization_policy",
        "audit_chain_ref"
      ],
      "typed_payload_required_fields": [
        "virtual_workspace_ref",
        "base_tree_ref",
        "overlay_ref",
        "materialization_policy",
        "lease_ref"
      ],
      "handoff_from": "LEASE",
      "handoff_to": "AUTHOR",
      "acceptance_rules": [
        "ISOLATE MUST cite the lease_ref and work_area_hash that were admitted",
        "virtual materialization MUST NOT mutate the canonical work_area_hash",
        "host temp dirs, local usernames, and process ids are forbidden identifiers"
      ]
    },
    {
      "stage_id": "AUTHOR",
      "ordinal": 5,
      "payload_type": "AuthoredPatchSet",
      "purpose": "Record content edits, AST deltas, generated-source refs, and declared dependency updates inside the isolated work area.",
      "required_inputs": [
        "VirtualWorkspaceFrame",
        "lease_ref",
        "actor_ref",
        "change_intent_ref"
      ],
      "emits": [
        "authored_patch_set_ref",
        "ast_delta_ref",
        "updated_work_area_hash",
        "declared_dependency_edges",
        "parent_change_unit_ref",
        "audit_chain_ref"
      ],
      "typed_payload_required_fields": [
        "authored_patch_set_ref",
        "content_delta_refs",
        "ast_delta_ref",
        "updated_work_area_hash",
        "parent_change_unit_ref",
        "declared_dependency_edges"
      ],
      "handoff_from": "ISOLATE",
      "handoff_to": "GATE",
      "acceptance_rules": [
        "AUTHOR may update the work_area_hash only by producing a new canonical content frame",
        "generated faces MUST cite their producer and cannot be hand-authored as part of the stage contract",
        "AUTHOR cannot bypass LEASE or ADMIT"
      ]
    },
    {
      "stage_id": "GATE",
      "ordinal": 6,
      "payload_type": "GateDecision",
      "purpose": "Run buck2, AST/practice gates, policy gates, and auto-remediation feedback while preserving full required authority semantics.",
      "required_inputs": [
        "AuthoredPatchSet",
        "required_gate_set_ref",
        "lease_ref",
        "current_bridge_authority_ref"
      ],
      "emits": [
        "gate_decision_ref",
        "gate_results_ref",
        "auto_remediation_ref",
        "affected_target_feedback_ref",
        "audit_chain_ref"
      ],
      "typed_payload_required_fields": [
        "decision",
        "required_context_ref",
        "gate_results_ref",
        "full_authority_backstop_ref",
        "candidate_bytes_trusted"
      ],
      "handoff_from": "AUTHOR",
      "handoff_to": "ATTEST",
      "acceptance_rules": [
        "GATE decision MUST be GREEN before ATTEST can claim readiness",
        "affected-target, cache-hit, or auto-remediation success is feedback only and cannot replace full required authority",
        "candidate PR/work-area bytes are untrusted inputs to gate definitions"
      ]
    },
    {
      "stage_id": "ATTEST",
      "ordinal": 7,
      "payload_type": "AttestationBundle",
      "purpose": "Bind the admitted/authored/gated change to provenance, audit-chain, reviewer, supply-chain, and evidence records.",
      "required_inputs": [
        "GateDecision",
        "authored_patch_set_ref",
        "work_area_hash",
        "lease_ref"
      ],
      "emits": [
        "attestation_ref",
        "provenance_bundle_ref",
        "review_evidence_ref",
        "supply_chain_evidence_ref",
        "audit_chain_ref"
      ],
      "typed_payload_required_fields": [
        "attestation_ref",
        "subject_change_unit_id",
        "subject_work_area_hash",
        "gate_decision_ref",
        "provenance_bundle_ref",
        "review_evidence_ref"
      ],
      "handoff_from": "GATE",
      "handoff_to": "INTEGRATE",
      "acceptance_rules": [
        "attestation subject MUST equal the current work_area_hash/change_unit_id",
        "review and gate evidence MUST name the same subject hash",
        "ATTEST cannot overwrite or omit prior audit-chain refs"
      ]
    },
    {
      "stage_id": "INTEGRATE",
      "ordinal": 8,
      "payload_type": "IntegratedChangeGraphNode",
      "purpose": "Integrate the attested change into projected and final change graph state under protected authority, preserving queue/fanout semantics.",
      "required_inputs": [
        "AttestationBundle",
        "gate_decision_ref",
        "lease_ref",
        "integration_queue_ref"
      ],
      "emits": [
        "integrated_change_ref",
        "projected_state_ref",
        "final_tree_ref",
        "status_fanout_ref",
        "audit_chain_ref"
      ],
      "typed_payload_required_fields": [
        "integrated_change_ref",
        "projected_state_ref",
        "final_tree_ref",
        "status_fanout_ref",
        "attestation_ref"
      ],
      "handoff_from": "ATTEST",
      "handoff_to": "PROPAGATE",
      "acceptance_rules": [
        "INTEGRATE requires GREEN GATE plus ATTEST evidence for the same change_unit_id",
        "integration queue state MUST be tenant/repository scoped and cannot use a global single leader as correctness dependency",
        "current bridge integration remains protected PR + oya-ci-required until native cutover is separately authorized"
      ]
    },
    {
      "stage_id": "PROPAGATE",
      "ordinal": 9,
      "payload_type": "PropagationPlan",
      "purpose": "Hand the integrated change to CD/release-ledger propagation semantics with rollout, rollback, and tenant/cell targeting metadata.",
      "required_inputs": [
        "IntegratedChangeGraphNode",
        "attestation_ref",
        "release_ledger_ref",
        "tenant_policy_ref"
      ],
      "emits": [
        "propagation_plan_ref",
        "release_ledger_entry_ref",
        "rollout_target_set_ref",
        "rollback_pointer_ref",
        "audit_chain_ref"
      ],
      "typed_payload_required_fields": [
        "propagation_plan_ref",
        "release_ledger_entry_ref",
        "rollout_target_set_ref",
        "rollback_pointer_ref",
        "attestation_ref"
      ],
      "handoff_from": "INTEGRATE",
      "handoff_to": "OBSERVE",
      "acceptance_rules": [
        "PROPAGATE MUST preserve tenant/cell isolation and rollback pointer evidence",
        "CD bridge/reference adapters cannot be described as permanent product authority",
        "propagation does not claim production rollout readiness until CD runtime evidence exists"
      ]
    },
    {
      "stage_id": "OBSERVE",
      "ordinal": 10,
      "payload_type": "ObservationBundle",
      "purpose": "Emit observability, audit, SLO, status fanout, and rollback/incident correlation evidence for the full change lifecycle.",
      "required_inputs": [
        "PropagationPlan",
        "release_ledger_entry_ref",
        "status_fanout_ref",
        "observability_contract_ref"
      ],
      "emits": [
        "observation_bundle_ref",
        "otel_trace_ref",
        "golden_signal_metric_refs",
        "status_fanout_ref",
        "rollback_observation_ref",
        "audit_chain_ref"
      ],
      "typed_payload_required_fields": [
        "observation_bundle_ref",
        "otel_trace_ref",
        "golden_signal_metric_refs",
        "status_fanout_ref",
        "audit_chain_ref"
      ],
      "handoff_from": "PROPAGATE",
      "acceptance_rules": [
        "OBSERVE MUST cite the same current change_unit_id/work_area_hash as INTEGRATE and preserve parent_change_unit_ref back to DECLARE when AUTHOR evolved the frame",
        "OBSERVE MUST include status fanout and at least one OpenTelemetry trace or metric reference",
        "observation evidence is required before any completed lifecycle claim"
      ]
    }
  ],
  "cross_stage_invariants": [
    {
      "id": "BSCM-STAGE-ORDER-001",
      "rule": "A valid lifecycle trace contains exactly the ten stage_ids in stage_order, in order, with monotonically increasing stage_ordinal values 1 through 10.",
      "severity": "error"
    },
    {
      "id": "BSCM-ID-ALIAS-001",
      "rule": "Every stage envelope carries the same current-frame byte string for change_unit_id and work_area_hash; if AUTHOR produces a new content frame, downstream stages use the new current frame and preserve parent_change_unit_ref to the prior frame so OBSERVE can cite both latest and parent lineage.",
      "severity": "error"
    },
    {
      "id": "BSCM-LEASE-001",
      "rule": "LEASE and every downstream stage carry a bounded lease_ref with expires_at, renewal_policy, shard_key, and fencing_token; global locks and unbounded locks are invalid.",
      "severity": "error"
    },
    {
      "id": "BSCM-GATE-AUTHORITY-001",
      "rule": "GATE cannot be satisfied by affected-only checks, cache hits, local mirror output, or candidate-authored gate definitions; full required authority remains the protected governance context until native cutover is separately proven.",
      "severity": "error"
    },
    {
      "id": "BSCM-ATTEST-INTEGRATE-001",
      "rule": "INTEGRATE requires ATTEST evidence and a GREEN GATE for the same subject change_unit_id/work_area_hash.",
      "severity": "error"
    },
    {
      "id": "BSCM-OBSERVE-001",
      "rule": "OBSERVE is part of the lifecycle contract, not an optional postscript; a trace without status fanout, OTel/golden-signal evidence, and audit-chain linkage is incomplete.",
      "severity": "error"
    },
    {
      "id": "BSCM-SCM-FACTS-001",
      "rule": "Stage provenance cites the VCS-agnostic scm-facts boundary from ADR-0526; bespoke SCM cutover is an adapter swap behind ScmFactsSource, not a change to stage envelope names.",
      "severity": "error"
    }
  ],
