{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.oyatie.com/schemas/reset-eligibility.schema.json",
  "title": "Infrastructure reset eligibility observation",
  "description": "Fail-closed, time-bounded observation contract. Unknown scope, active hard stops, incomplete recovery proof, incomplete approvals, or expired positive evidence make reset ineligible; absence of evidence is never deletion authority.",
  "type": "object",
  "required": [
    "$schema",
    "schema_version",
    "reset_id",
    "captured_at",
    "expires_at",
    "repository",
    "collector",
    "scope",
    "evidence_manifest",
    "sources",
    "inventory",
    "recovery",
    "hard_stops",
    "unknowns",
    "approvals",
    "decision"
  ],
  "properties": {
    "$schema": {
      "const": "https://docs.oyatie.com/schemas/reset-eligibility.schema.json"
    },
    "schema_version": {
      "const": 1
    },
    "reset_id": {
      "type": "string",
      "minLength": 1
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "repository": {
      "type": "object",
      "required": [
        "protected_commit_sha",
        "candidate_commit_sha"
      ],
      "properties": {
        "protected_commit_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "candidate_commit_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      },
      "additionalProperties": false
    },
    "collector": {
      "type": "object",
      "required": [
        "id",
        "method",
        "secret_values_excluded"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "const": "read-only"
        },
        "secret_values_excluded": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "required": [
        "providers",
        "accounts",
        "regions",
        "clusters"
      ],
      "properties": {
        "providers": {
          "$ref": "#/$defs/nonEmptyStrings"
        },
        "accounts": {
          "$ref": "#/$defs/nonEmptyStrings"
        },
        "regions": {
          "$ref": "#/$defs/nonEmptyStrings"
        },
        "clusters": {
          "$ref": "#/$defs/nonEmptyStrings"
        }
      },
      "additionalProperties": false
    },
    "evidence_manifest": {
      "type": "object",
      "required": [
        "uri",
        "sha256"
      ],
      "properties": {
        "uri": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "result",
          "redaction",
          "evidence_uri"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "enum": [
              "observed",
              "unknown",
              "denied",
              "error"
            ]
          },
          "redaction": {
            "const": "secret-values-excluded"
          },
          "evidence_uri": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          }
        },
        "additionalProperties": false
      }
    },
    "inventory": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "stable_id",
          "identity_hash",
          "lifecycle",
          "data_class",
          "retention",
          "billing",
          "deletion_semantics"
        ],
        "properties": {
          "stable_id": {
            "type": "string",
            "minLength": 1
          },
          "identity_hash": {
            "$ref": "#/$defs/sha256"
          },
          "lifecycle": {
            "type": "string",
            "minLength": 1
          },
          "data_class": {
            "type": "string",
            "minLength": 1
          },
          "retention": {
            "type": "string",
            "minLength": 1
          },
          "billing": {
            "type": "string",
            "minLength": 1
          },
          "deletion_semantics": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "recovery": {
      "type": "object",
      "required": [
        "backup_verified",
        "immutable_backup_location_verified",
        "rpo_verified",
        "restore_drill_verified",
        "key_recovery_verified"
      ],
      "properties": {
        "backup_verified": {
          "type": "boolean"
        },
        "immutable_backup_location_verified": {
          "type": "boolean"
        },
        "rpo_verified": {
          "type": "boolean"
        },
        "restore_drill_verified": {
          "type": "boolean"
        },
        "key_recovery_verified": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "hard_stops": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/blocker"
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "owner",
          "closure_probe"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "closure_probe": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "role",
          "approver",
          "approved",
          "approved_at"
        ],
        "properties": {
          "role": {
            "type": "string",
            "minLength": 1
          },
          "approver": {
            "type": "string",
            "minLength": 1
          },
          "approved": {
            "type": "boolean"
          },
          "approved_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      }
    },
    "decision": {
      "type": "object",
      "required": [
        "eligible",
        "mode",
        "default_if_unknown",
        "reason_codes"
      ],
      "properties": {
        "eligible": {
          "type": "boolean"
        },
        "mode": {
          "enum": [
            "authorized-reset",
            "preservation-migration"
          ]
        },
        "default_if_unknown": {
          "const": "ineligible"
        },
        "reason_codes": {
          "$ref": "#/$defs/uniqueStrings"
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "uniqueStrings": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "blocker": {
      "type": "object",
      "required": [
        "id",
        "class",
        "acceptance_criteria",
        "verification_path",
        "suggested_owner",
        "dependency_notes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "class": {
          "type": "string",
          "minLength": 1
        },
        "acceptance_criteria": {
          "type": "string",
          "minLength": 1
        },
        "verification_path": {
          "type": "string",
          "minLength": 1
        },
        "suggested_owner": {
          "type": "string",
          "minLength": 1
        },
        "dependency_notes": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
