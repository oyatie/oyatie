{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://oyatie.com/schemas/catalog-canonical-crate-record.json",
  "title": "Catalog canonical crate-record schema (SWEEP-I Slice 6)",
  "description": "Canonical shape for every per-µservice catalog entry. Authority: ADR-0064.",
  "canonical_authority": "ADR-0064",
  "consumer_pattern": "microservices/<ms>/catalog/oya-<ms>-<bc>-<role>[-<backend>].yaml",
  "type": "object",
  "required": [
    "name",
    "role",
    "context",
    "plane",
    "slo",
    "lifecycle",
    "traceability",
    "autonomy_tier_required"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^oya-[a-z0-9-]+$",
      "description": "Crate name; matches ADR-0056 BNF v4.1 pattern oya-<ms>-<bc>-<role>[-<backend>]"
    },
    "role": {
      "type": "string",
      "enum": [
        "kernel",
        "domain",
        "usecase",
        "adapter",
        "infra",
        "rest",
        "worker",
        "sdk",
        "app",
        "test-fixtures",
        "cli"
      ],
      "description": "Layer role per ADR-0105 13-layer enum"
    },
    "context": {
      "type": "string",
      "description": "µservice slug or shared-substrate slug"
    },
    "plane": {
      "type": "string",
      "enum": [
        "control",
        "data",
        "audit"
      ]
    },
    "slo": {
      "type": "string",
      "description": "SLO tier reference (e.g. preview-data-plane, ga-control-plane)"
    },
    "contracts_consumed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "contracts_exposed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "regulatory_packs_consumed": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^pack-[a-z-]+$"
      }
    },
    "lifecycle": {
      "type": "object",
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "scaffolded",
            "incubating",
            "preview",
            "GA",
            "deprecated"
          ]
        },
        "preview_since": {
          "type": "string",
          "format": "date"
        },
        "ga_since": {
          "type": "string",
          "format": "date"
        },
        "deprecated_since": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "traceability": {
      "type": "object",
      "required": [
        "source_adrs"
      ],
      "properties": {
        "github_issue": {
          "type": "string"
        },
        "source_adrs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^ADR-[0-9]{4}$"
          }
        },
        "spec_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ip_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "allowed_dependency_edges": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "kernel",
          "domain",
          "usecase",
          "adapter",
          "infra",
          "shared-type",
          "shared-trait"
        ]
      }
    },
    "data_classes_owned": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "PII_DIRECT_IDENTIFIER",
          "PII_QUASI_IDENTIFIER",
          "PHI",
          "PCI",
          "BEHAVIORAL_TENANT_PRODUCT",
          "INTERNAL_ONLY",
          "PUBLIC",
          "AUDIT"
        ]
      }
    },
    "operational_classes_owned": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "autonomy_tier_required": {
      "type": "string",
      "enum": [
        "T0",
        "T1",
        "T2"
      ]
    },
    "ports_declared": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "context_kind_invariant": {
      "type": "string"
    },
    "e2e_invariant": {
      "type": "string"
    },
    "backend": {
      "type": "string",
      "description": "Adapter-only field; per ADR-0105 Amendment 3 *-adapter-<backend>",
      "enum": [
        "redis",
        "postgres",
        "kafka",
        "nats",
        "s3",
        "oci-objectstorage",
        "rest",
        "grpc",
        "rocksdb",
        "lance",
        "duckdb",
        "qdrant",
        "elasticsearch",
        "openbao",
        "ed25519",
        "yubihsm",
        "valkey",
        "memcached",
        "in-memory"
      ]
    }
  }
}
