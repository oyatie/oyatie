  "strictest_tier_order": [
    "multi_region",
    "single_region",
    "sovereign_cell",
    "airgapped_cell"
  ],
  "combined_pack_resolution": {
    "tier_rule": "Select the strictest min_tier across active packs using strictest_tier_order.",
    "region_rule": "Intersect non-empty allowed_region_sets; an empty intersection blocks activation until a tenant-specific permit or pack amendment exists.",
    "attestor_rule": "If any implicated regime requires a regulatory attestor for the selected tier, the attestation must carry regulatory_attestor_signature.",
    "audit_rule": "Every pack-binding allow/refusal emits tenancy.residency.pack.binding_changed with the evaluated row ids and strictest-tier result."
