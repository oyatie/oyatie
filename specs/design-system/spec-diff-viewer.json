{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.oyatie.com/schemas/design-system/spec-diff-viewer.schema.json",
  "title": "DesignSystemComponent:SpecDiffViewer",
  "_meta": {
    "doc_class": "Machine-Readable-Spec",
    "spec_id": "DS-SPEC_DIFF_VIEWER",
    "version": "1.0.0",
    "status": "Accepted",
    "owner_team": "council-design-system + architecture-council",
    "created_at": "2026-05-16T17:45:00Z",
    "purpose": "Semantic diff viewer for canonical JSON specs, PR review, schema evolution, jurisdiction overlays, and LLM-authored patch review."
  },
  "component_id": "spec-diff-viewer",
  "purpose": "Semantic diff viewer for canonical JSON specs, PR review, schema evolution, jurisdiction overlays, and LLM-authored patch review.",
  "variants": [
    "json-patch",
    "semantic-entity-diff",
    "workflow-round-trip",
    "jurisdiction-overlay",
    "read-only-pr-review"
  ],
  "states": [
    "clean",
    "changed",
    "schema-breaking",
    "policy-breaking",
    "conflict",
    "loading-skeleton"
  ],
  "accessibility": {
    "wcag": "2.2 AA",
    "keyboard": "change list, next/previous hunk, expand/collapse, and copy-link shortcuts are keyboard reachable",
    "screen_reader": "announces path, change kind, severity, and review decision state for each hunk"
  },
  "security_invariants": [
    "breaking or policy-changing diffs cannot be visually collapsed by default",
    "LLM-authored diffs carry provenance badge and validation status",
    "copy/export omits hidden secrets and redacted fields"
  ],
  "test_refs": [
    "crates/oya-dev-cli/tests/product_prd_json.rs::product_prd_json_gate_accepts_repo_specs",
    "crates/oya-saas-workflow-studio-domain/tests/spec_load.rs::test_load_emit_byte_equal"
  ],
  "consumers": [
    "$ref:specs/microservices/workflow.json#frontend_components",
    "$ref:specs/microservices/workflow-studio.json#frontend_components",
    "$ref:specs/microservices/ontology.json#frontend_components"
  ],
  "verification_commands": [
    "target/debug/oya gate validate product-prd-json",
    "python3 -m json.tool specs/design-system/<component>.json",
    "target/debug/oya gate validate active-artifact-contract"
  ],
  "sources_scanned": [
