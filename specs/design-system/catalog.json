  "principles": {
    "accessibility_floor": "WCAG 2.2 AA; keyboard-first; visible focus; color is never the only signal; forced-colors mode must remain usable",
    "motion_policy": "motion clarifies state change only; no decorative idle motion; compositor-only properties; reduced motion collapses animations",
    "voice_policy": "precise, technical, honest, respectful of time; no cute/oops copy; every operational error has code, message, doc_url, remediation",
    "loading_policy": "skeleton/progressive rendering over spinner-only states; determinate progress for long-running operations",
    "ops_policy": "deployment remediation routes through OpenTofu, Makefile bootstrap/install, and oya ops; manual SSH troubleshooting is not a UI action"
  },
  "required_prd_fields": {
    "user_experience": [
      "ux_personas_ref",
      "accessibility_coverage",
      "responsive_breakpoints",
      "internationalization_scope",
      "design_system_components_used",
      "journey_critical_paths",
      "error_state_coverage",
      "offline_behavior",
      "keyboard_navigation_coverage_pct",
      "loading_state_coverage"
    ],
    "frontend_components": [
      "component",
      "source",
      "design_system_ref",
      "variants",
      "tested_at_breakpoints"
    ]
  },
