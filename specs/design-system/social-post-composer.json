{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.oyatie.com/schemas/design-system/social-post-composer.schema.json",
  "title": "DesignSystem:Social Post Composer",
  "doc_class": "Machine-Readable-Spec",
  "component_id": "social-post-composer",
  "owner_team": "communications-service-council",
  "product_ref": "$ref:specs/microservices/social.json",
  "component_name": "SocialPostComposer",
  "status": "planned-contract",
  "variants": [
    "photo",
    "video",
    "collab",
    "story"
