  "purpose": "Concrete deterministic score-card inventory consumed by oya gate validate loop-recovery-patterns and the canonical oya verify pre-push path. LLM judgment is forbidden in pass/fail.",
  "checks": [
    {
      "id": "score-card:pre-push:github-action-sha",
      "facet": "pipeline",
      "query": "grep -rhoE 'uses:[[:space:]]*[^[:space:]]+' .github/workflows | grep -vE '@[0-9a-f]{40}$'",
      "pass_criterion": "empty output; every third-party `uses:` reference in every workflow names a full 40-hex commit SHA. Executed natively (no shell) by require_third_party_actions_are_sha_pinned, which also refuses a walk that saw zero references.",
      "score": 10,
      "severity_tier": "BLOCKER"
    },
    {
      "id": "score-card:pre-push:nextest-profile-ci",
      "facet": "pipeline",
      "query": "grep -qF '[profile.ci]' .config/nextest.toml && cargo nextest list --profile ci --workspace",
      "pass_criterion": "exit 0; CI nextest profile exists before any nextest run command can be trusted",
      "score": 10,
      "severity_tier": "BLOCKER"
    },
    {
      "id": "score-card:pre-push:shell-shebang",
      "facet": "pipeline",
      "query": "find scripts -type f -perm -111 -exec grep -L '^#!' {} + | head -1",
      "pass_criterion": "stdout empty; executable transitional shell wrappers must be explicit while Rust replacement proceeds",
      "score": 8,
      "severity_tier": "CRITICAL"
    },
    {
      "id": "score-card:pre-push:loop-recovery-patterns",
      "facet": "pipeline",
      "query": "oya gate validate loop-recovery-patterns",
      "pass_criterion": "exit 0; active repeat-loop patterns are linked to deterministic score cards and mistakes-ledger rows",
      "score": 10,
      "severity_tier": "BLOCKER"
    },
    {
      "id": "score-card:industry-pattern:foundry-pr126",
      "facet": "industry-pattern-audit",
      "query": "oya gate validate industry-pattern-score-card --source-pr 126",
      "pass_criterion": "exit 0 only after the Foundry industry-pattern validator exists, has fixture coverage, and is branch-protected",
      "score": 9,
      "severity_tier": "CRITICAL",
