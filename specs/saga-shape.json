{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.oyatie.com/specs/saga-shape.schema.json",
  "_meta": {
    "doc_class": "Machine-Readable-Spec",
    "spec_id": "EXE-SAGA-SHAPE",
    "version": "1.0.0",
    "status": "Accepted",
    "enforcement_status": "advisory-until-cross-flow-recatalogued",
    "owner_team": "council-architecture",
    "created_at": "2026-05-18T00:00:00Z",
    "binding_adr": "ADR-0222",
    "purpose": "Canonical saga shape for cross-microservice writes. Every cross-microservice write is a saga consisting of an ordered list of steps; each step declares (forward_action, compensation_action, idempotency_key_strategy, timeout_budget_ms, retry_policy, audit_class).",
    "user_directive_2026_05_18": "Saga + compensating actions are the only sanctioned shape for cross-microservice writes."
  },
  "title": "Oyatie saga shape",
  "type": "object",
  "required": [
    "saga_id",
    "axis",
    "steps",
    "owner_team",
    "version"
  ],
  "properties": {
    "saga_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]+$",
      "description": "Unique saga identifier across the portfolio."
    },
    "axis": {
      "type": "string",
      "enum": [
        "workspace",
        "cloud",
        "foundry",
        "saas",
        "vertical",
        "ads",
        "search",
        "ontology",
        "connector",
        "ops",
        "platform"
      ],
      "description": "Axis owning the saga's primary use case."
    },
    "owner_team": {
      "type": "string",
      "pattern": "^(council|ops|axis|platform|gtm|crew)-[a-z0-9-]+$"
    },
    "version": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/SagaStep"
      }
    },
    "rollback_strategy": {
      "type": "string",
      "enum": [
        "reverse-order-compensation",
        "no-compensation-readonly",
        "best-effort-with-page"
      ],
      "default": "reverse-order-compensation"
    },
    "audit_chain_emit": {
      "type": "boolean",
      "default": true
    }
  },
  "$defs": {
    "SagaStep": {
      "type": "object",
      "required": [
        "step_id",
        "target_microservice",
        "forward_action",
        "compensation_action",
        "idempotency_key_strategy",
        "timeout_budget_ms",
        "retry_policy",
        "audit_class"
      ],
      "properties": {
        "step_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]+$"
        },
        "target_microservice": {
          "type": "string",
          "enum": [
            "anonymous",
            "application",
            "audit-chain",
            "calendar",
            "cell",
            "cloud-iac",
            "cloud-k8s",
            "cloud-secrets",
            "community",
            "connector",
            "drive",
            "forms",
            "foundry",
            "governance",
            "mail",
            "meet",
            "messenger",
            "network",
            "notes",
            "observability",
            "ontology",
            "recordings",
            "sheets",
            "shorts",
            "sites",
            "slides",
            "social",
            "tasks",
            "tenancy",
            "translate",
            "workflow-engine",
            "workflow-studio"
          ]
        },
        "forward_action": {
          "type": "object",
          "required": [
            "capability_ref",
            "input_schema_ref"
          ],
          "properties": {
            "capability_ref": {
              "type": "string"
            },
            "input_schema_ref": {
              "type": "string"
            }
          }
        },
        "compensation_action": {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "Cancel",
                "Refund",
                "Retry",
                "NoopWithEvidence",
                "Custom"
              ]
            },
            "capability_ref": {
              "type": "string"
            },
            "input_schema_ref": {
              "type": "string"
            },
            "evidence_class": {
              "type": "string"
            }
          }
        },
        "idempotency_key_strategy": {
          "type": "string",
          "enum": [
            "saga-step-attempt",
            "request-body-hash",
            "client-supplied"
          ]
        },
        "timeout_budget_ms": {
          "type": "integer",
          "minimum": 100,
          "maximum": 600000
        },
        "retry_policy": {
          "type": "object",
          "required": [
            "max_attempts",
            "backoff_ms"
          ],
          "properties": {
            "max_attempts": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            },
            "backoff_ms": {
              "type": "integer",
              "minimum": 100
            },
            "jitter": {
              "type": "boolean",
              "default": true
            }
          }
        },
        "audit_class": {
          "type": "string",
          "enum": [
            "ReadOnly",
            "WriteIdempotent",
            "WriteNonIdempotent",
            "SideEffectIrreversible"
          ]
        }
      },
      "allOf": [
        {
          "comment": "If audit_class is not ReadOnly, compensation_action.kind must not be NoopWithEvidence.",
          "if": {
            "properties": {
              "audit_class": {
                "const": "ReadOnly"
              }
            }
          },
          "else": {
            "properties": {
              "compensation_action": {
                "properties": {
                  "kind": {
                    "not": {
                      "const": "NoopWithEvidence"
                    }
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
