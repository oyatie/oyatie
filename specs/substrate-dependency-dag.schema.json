{
  "$id": "https://docs.oyatie.com/schemas/substrate-dependency-dag.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Oyatie runtime-face-aware substrate dependency graph v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema",
    "version",
    "doctrine_adrs",
    "external_anchors",
    "dependency_units",
    "failure_impact_composition",
    "graphs",
    "mandatory_follow_ups"
  ],
  "properties": {
    "_comment": {
      "type": "string"
    },
    "$schema": {
      "const": "https://json-schema.org/draft/2020-12/schema"
    },
    "schema": {
      "const": "specs/substrate-dependency-dag.schema.json"
    },
    "version": {
      "const": "2.0.0"
    },
    "doctrine_adrs": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^ADR-[0-9]{4}$"
      }
    },
    "external_anchors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/external_anchor"
      }
    },
    "dependency_units": {
      "type": "array",
      "minItems": 19,
      "items": {
        "$ref": "#/$defs/dependency_unit"
      },
      "maxItems": 19,
      "uniqueItems": true
    },
    "failure_impact_composition": {
      "$ref": "#/$defs/failure_composition"
    },
    "graphs": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "prefixItems": [
        {
          "$ref": "#/$defs/genesis_graph"
        },
        {
          "$ref": "#/$defs/provisioning_graph"
        },
        {
          "$ref": "#/$defs/request_graph"
        },
        {
          "$ref": "#/$defs/publication_graph"
        },
        {
          "$ref": "#/$defs/failure_graph"
        }
      ],
      "items": false
    },
    "mandatory_follow_ups": {
      "type": "array",
      "minItems": 3,
      "items": {
        "$ref": "#/$defs/follow_up"
      },
      "maxItems": 3,
      "uniqueItems": true
    }
  },
  "$defs": {
    "dependency_unit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "capability",
        "runtime_face",
        "plane",
        "purpose"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+(?:\\.[a-z0-9-]+)+$"
        },
        "capability": {
          "type": "string",
          "minLength": 1
        },
        "plane": {
          "enum": [
            "B0",
            "C0",
            "C1",
            "C2",
            "G",
            "R"
          ]
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "runtime_face": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "generic_edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "graph_kind",
        "from",
        "to"
      ],
      "properties": {
        "graph_kind": {
          "type": "string"
        },
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "rationale": {
          "type": "string"
        }
      }
    },
    "request_edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "graph_kind",
        "from",
        "to",
        "dependency_weight",
        "cascade_rule",
        "version_compatibility_range",
        "cedar_permit_fragment"
      ],
      "properties": {
        "graph_kind": {
          "const": "steady_state_request"
        },
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "dependency_weight": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "cascade_rule": {
          "$ref": "#/$defs/impact_rule"
        },
        "version_compatibility_range": {
          "type": "string",
          "minLength": 1
        },
        "cedar_permit_fragment": {
          "type": "string",
          "minLength": 1
        },
        "rationale": {
          "type": "string"
        }
      }
    },
    "failure_edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "graph_kind",
        "failed_unit",
        "impacted_unit",
        "impact_rule",
        "derivation"
      ],
      "properties": {
        "graph_kind": {
          "const": "failure_brownout_propagation"
        },
        "failed_unit": {
          "type": "string",
          "minLength": 1
        },
        "impacted_unit": {
          "type": "string",
          "minLength": 1
        },
        "impact_rule": {
          "$ref": "#/$defs/impact_rule"
        },
        "derivation": {
          "const": "max_min_reverse_transitive_closure"
        }
      }
    },
    "impact_rule": {
      "enum": [
        "INDEPENDENT",
        "BROWNOUT",
        "DEGRADED",
        "FULL"
      ]
    },
    "forbidden_edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "reason"
      ],
      "properties": {
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "base_graph_properties": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string"
        },
        "edge_semantics": {
          "type": "string",
          "minLength": 1
        },
        "edges": {
          "type": "array"
        }
      }
    },
    "genesis_graph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "edge_semantics",
        "edges"
      ],
      "properties": {
        "kind": {
          "const": "genesis"
        },
        "edge_semantics": {
          "type": "string",
          "minLength": 1
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/generic_edge"
          }
        }
      }
    },
    "provisioning_graph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "edge_semantics",
        "edges"
      ],
      "properties": {
        "kind": {
          "const": "new_cell_provisioning"
        },
        "edge_semantics": {
          "type": "string",
          "minLength": 1
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/generic_edge"
          }
        }
      }
    },
    "request_graph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "edge_semantics",
        "bootstrap_order",
        "forbidden_edges_assertion",
        "edges"
      ],
      "properties": {
        "kind": {
          "const": "steady_state_request"
        },
        "edge_semantics": {
          "type": "string",
          "minLength": 1
        },
        "bootstrap_order": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "forbidden_edges_assertion": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/forbidden_edge"
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/request_edge"
          }
        }
      }
    },
    "publication_graph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "edge_semantics",
        "edges"
      ],
      "properties": {
        "kind": {
          "const": "control_data_publication"
        },
        "edge_semantics": {
          "type": "string",
          "minLength": 1
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/generic_edge"
          }
        }
      }
    },
    "failure_graph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "edge_semantics",
        "composition",
        "edges"
      ],
      "properties": {
        "kind": {
          "const": "failure_brownout_propagation"
        },
        "edge_semantics": {
          "type": "string",
          "minLength": 1
        },
        "composition": {
          "const": "max_min"
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/failure_edge"
          }
        }
      }
    },
    "failure_composition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path_rule",
        "multi_path_rule",
        "severity_order",
        "closure_direction"
      ],
      "properties": {
        "path_rule": {
          "const": "minimum severity across every steady_state_request edge on a path; a weak propagation edge bounds that path"
        },
        "multi_path_rule": {
          "const": "maximum severity across all paths from impacted_unit to failed_unit; the strongest propagation path wins"
        },
        "severity_order": {
          "const": [
            "INDEPENDENT",
            "BROWNOUT",
            "DEGRADED",
            "FULL"
          ]
        },
        "closure_direction": {
          "const": "reverse_transitive_closure: request dependency A -> B yields failure propagation B -> A"
        }
      }
    },
    "follow_up": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "constraint"
      ],
      "properties": {
        "id": {
          "enum": [
            "W0-C-MODULE-MEMBERSHIP",
            "W0-C-LAYER-RANKS",
            "W0-C-TOPOLOGY-COVERAGE"
          ]
        },
        "status": {
          "const": "required-not-in-this-slice"
        },
        "tracking_issue": {
          "type": "string",
          "minLength": 1
        },
        "baseline_policy": {
          "const": "no-new-frozen-baseline"
        },
        "constraint": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "id": {
                "const": "W0-C-TOPOLOGY-COVERAGE"
              }
            },
            "required": [
              "id"
            ]
          },
          "then": {
            "required": [
              "tracking_issue",
              "baseline_policy"
            ],
            "properties": {
              "tracking_issue": {
                "const": "https://github.com/jason931225/oyatie/issues/1537"
              },
              "baseline_policy": {
                "const": "no-new-frozen-baseline"
              }
            }
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "tracking_issue"
                  ]
                },
                {
                  "required": [
                    "baseline_policy"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "external_anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "plane",
        "purpose"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^external\\.[a-z0-9-]+(?:\\.[a-z0-9-]+)*$"
        },
        "plane": {
          "const": "E0"
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
