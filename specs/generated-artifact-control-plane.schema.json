{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.oyatie.com/schemas/generated-artifact-control-plane.schema.json",
  "title": "GeneratedArtifactControlPlane",
  "description": "Portable oya-ci manifest for generated artifacts. A hermetic Rust gate consumes this manifest plus an SCM-facts snapshot to prove generated artifacts are declared, owned, and materialized by explicit policy rather than ad-hoc gitignore or merge-driver behavior.",
  "type": "object",
  "required": [
    "schema_version",
    "canonical_name",
    "ci_product_surface",
    "public_product_contract",
    "final_tree_materialization",
    "artifacts",
    "development_lifecycle_enforcement_layers"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": 1
    },
    "canonical_name": {
      "const": "generated-artifact-control-plane"
    },
    "ci_product_surface": {
      "const": "oya-ci"
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "public_product_contract": {
      "type": "string",
      "minLength": 1
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "development_lifecycle_enforcement_layers": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "required": [
          "layer_id",
          "name",
          "automation",
          "enforcement"
        ],
        "properties": {
          "layer_id": {
            "enum": [
              "project-creation",
              "local-authoring",
              "pre-commit-pre-push",
              "pull-request-presubmit",
              "merge-queue-projected-state",
              "postsubmit-main-materialization",
              "release-and-deployment",
              "operations-drift-repair"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "automation": {
            "type": "string",
            "minLength": 1
          },
          "enforcement": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      },
      "maxItems": 8,
      "allOf": [
        {
          "contains": {
            "type": "object",
            "required": [
              "layer_id"
            ],
            "properties": {
              "layer_id": {
                "const": "project-creation"
              }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "layer_id"
            ],
            "properties": {
              "layer_id": {
                "const": "local-authoring"
              }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "layer_id"
            ],
            "properties": {
              "layer_id": {
                "const": "pre-commit-pre-push"
              }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "layer_id"
            ],
            "properties": {
              "layer_id": {
                "const": "pull-request-presubmit"
              }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "layer_id"
            ],
            "properties": {
              "layer_id": {
                "const": "merge-queue-projected-state"
              }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "layer_id"
            ],
            "properties": {
              "layer_id": {
                "const": "postsubmit-main-materialization"
              }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "layer_id"
            ],
            "properties": {
              "layer_id": {
                "const": "release-and-deployment"
              }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "layer_id"
            ],
            "properties": {
              "layer_id": {
                "const": "operations-drift-repair"
              }
            }
          }
        }
      ]
    },
    "final_tree_materialization": {
      "type": "object",
      "required": [
        "controller_id",
        "presubmit_authority",
        "postsubmit_authority",
        "protected_branch_trigger",
        "manual_conflict_resolution_policy",
        "drift_repair_policy",
        "portable_runner_contract"
      ],
      "properties": {
        "controller_id": {
          "const": "oya-ci-generated-artifact-controller"
        },
        "presubmit_authority": {
          "enum": [
            "pull-request-presubmit",
            "merge-queue-projected-state"
          ]
        },
        "postsubmit_authority": {
          "const": "postsubmit-main-materialization"
        },
        "protected_branch_trigger": {
          "type": "string",
          "minLength": 1
        },
        "manual_conflict_resolution_policy": {
          "const": "reject-generated-json-conflict-hunks-regenerate-from-source-tree"
        },
        "drift_repair_policy": {
          "enum": [
            "fail-closed-and-open-generated-only-repair-pr",
            "fail-closed-manual-generated-only-repair"
          ]
        },
        "portable_runner_contract": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "artifact": {
      "type": "object",
      "required": [
        "artifact_id",
        "path",
        "artifact_class",
        "materialization_mode",
        "merge_policy",
        "owner_team",
        "generator_command",
        "source_inputs",
        "final_tree_validation",
        "public_product_contract"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "artifact_class": {
          "enum": [
            "authoritative-source",
            "sharded-projection",
            "main-materialized-aggregate",
            "append-only-ledger",
            "ephemeral-build-output",
            "review-artifact",
            "scm-facts-boundary-snapshot"
          ]
        },
        "materialization_mode": {
          "enum": [
            "source-authored",
            "branch-committed-regenerated-until-controller-materialization",
            "merge-candidate-regenerated",
            "main-branch-materialized",
            "ci-artifact-only"
          ]
        },
        "merge_policy": {
          "enum": [
            "normal-source-merge",
            "append-only-union-with-invariant-check",
            "never-manual-merge-regenerate-from-source-tree",
            "controller-owned-main-materialization",
            "not-tracked-in-git"
          ]
        },
        "owner_team": {
          "type": "string",
          "minLength": 1
        },
        "generator_command": {
          "type": "string",
          "minLength": 1
        },
        "source_inputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "final_tree_validation": {
          "type": "string",
          "minLength": 1
        },
        "public_product_contract": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
