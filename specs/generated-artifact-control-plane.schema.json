{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.oyatie.com/schemas/generated-artifact-control-plane.schema.json",
  "title": "GeneratedArtifactControlPlane",
  "description": "Portable ci manifest for generated artifacts. A hermetic Rust gate consumes this manifest plus an SCM-facts snapshot to prove generated artifacts are declared, owned, and materialized by explicit policy rather than ad-hoc gitignore or merge-driver behavior. Tracked generated outputs are matched by repo-declared generated_path_rules, so public adopters can encode conventions such as generated/, __generated__/, generated-sources/, .generated.ts, or .pb.go without changing the gate.",
  "type": "object",
  "required": [
    "schema_version",
    "canonical_name",
    "ci_product_surface",
    "public_product_contract",
    "final_tree_materialization",
    "generated_path_rules",
    "artifacts",
    "development_lifecycle_enforcement_layers"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": 1
    },
    "canonical_name": {
      "const": "generated-artifact-control-plane"
    },
    "ci_product_surface": {
      "const": "ci"
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "public_product_contract": {
      "type": "string",
      "minLength": 1
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "development_lifecycle_enforcement_layers": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "required": [
          "layer_id",
          "name",
          "automation",
          "enforcement"
        ],
        "properties": {
          "layer_id": {
            "enum": [
              "project-creation",
              "local-authoring",
              "pre-commit-pre-push",
              "pull-request-presubmit",
              "merge-queue-projected-state",
              "postsubmit-main-materialization",
              "release-and-deployment",
              "operations-drift-repair"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "automation": {
            "type": "string",
            "minLength": 1
          },
          "enforcement": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      },
      "maxItems": 8,
      "allOf": [
        {
          "contains": {
            "type": "object",
            "required": [
              "layer_id"
            ],
            "properties": {
              "layer_id": {
                "const": "project-creation"
              }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "layer_id"
            ],
            "properties": {
              "layer_id": {
                "const": "local-authoring"
              }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "layer_id"
            ],
            "properties": {
              "layer_id": {
                "const": "pre-commit-pre-push"
              }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "layer_id"
            ],
            "properties": {
              "layer_id": {
                "const": "pull-request-presubmit"
              }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "layer_id"
            ],
            "properties": {
              "layer_id": {
                "const": "merge-queue-projected-state"
              }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "layer_id"
            ],
            "properties": {
              "layer_id": {
                "const": "postsubmit-main-materialization"
              }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "layer_id"
            ],
            "properties": {
              "layer_id": {
                "const": "release-and-deployment"
              }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "layer_id"
            ],
            "properties": {
              "layer_id": {
                "const": "operations-drift-repair"
              }
            }
          }
        }
      ]
    },
    "final_tree_materialization": {
      "type": "object",
      "required": [
        "controller_id",
        "presubmit_authority",
        "postsubmit_authority",
        "protected_branch_trigger",
        "manual_conflict_resolution_policy",
        "drift_repair_policy",
        "portable_runner_contract"
      ],
      "properties": {
        "controller_id": {
          "const": "ci-generated-artifact-controller"
        },
        "presubmit_authority": {
          "enum": [
            "pull-request-presubmit",
            "merge-queue-projected-state"
          ]
        },
        "postsubmit_authority": {
          "const": "postsubmit-main-materialization"
        },
        "protected_branch_trigger": {
          "type": "string",
          "minLength": 1
        },
        "manual_conflict_resolution_policy": {
          "const": "reject-generated-output-conflict-hunks-regenerate-from-source-tree"
        },
        "drift_repair_policy": {
          "enum": [
            "fail-closed-and-open-generated-only-repair-pr",
            "fail-closed-manual-generated-only-repair"
          ]
        },
        "portable_runner_contract": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "generated_path_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/generated_path_rule"
      },
      "description": "Repo-declared generated-output match rules. A tracked path matching any rule is a generated output that must either be ignored or declared in artifacts with a non-source merge policy."
    }
  },
  "additionalProperties": false,
  "$defs": {
    "artifact": {
      "type": "object",
      "required": [
        "artifact_id",
        "path",
        "artifact_class",
        "materialization_mode",
        "merge_policy",
        "owner_team",
        "source_inputs",
        "final_tree_validation",
        "public_product_contract"
      ],
      "allOf": [
        {
          "description": "A generator is required for every artifact EXCEPT a hand-curated ratchet baseline, which is human-authored and has no machine producer.",
          "if": {
            "required": [
              "artifact_class"
            ],
            "properties": {
              "artifact_class": {
                "const": "hand-curated-ratchet"
              }
            }
          },
          "then": {
            "properties": {
              "materialization_mode": {
                "const": "hand-curated-committed"
              }
            }
          },
          "else": {
            "required": [
              "generator"
            ]
          }
        }
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "artifact_class": {
          "enum": [
            "authoritative-source",
            "sharded-projection",
            "main-materialized-aggregate",
            "append-only-ledger",
            "ephemeral-build-output",
            "review-artifact",
            "scm-facts-boundary-snapshot",
            "hand-curated-ratchet"
          ]
        },
        "materialization_mode": {
          "enum": [
            "source-authored",
            "branch-committed-regenerated-until-controller-materialization",
            "merge-candidate-regenerated",
            "main-branch-materialized",
            "ci-artifact-only",
            "not-tracked-in-git",
            "hand-curated-committed"
          ]
        },
        "merge_policy": {
          "enum": [
            "normal-source-merge",
            "append-only-union-with-invariant-check",
            "never-manual-merge-regenerate-from-source-tree",
            "controller-owned-main-materialization",
            "not-tracked-in-git"
          ]
        },
        "owner_team": {
          "type": "string",
          "minLength": 1
        },
        "generator": {
          "$ref": "#/$defs/generator"
        },
        "source_inputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "final_tree_validation": {
          "type": "string",
          "minLength": 1
        },
        "public_product_contract": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "generator": {
      "type": "object",
      "required": [
        "runner",
        "generator_target",
        "operation_id",
        "parameters",
        "input_contract",
        "output_mode"
      ],
      "properties": {
        "runner": {
          "enum": [
            "buck2",
            "ci-native-controller"
          ]
        },
        "generator_target": {
          "type": "string",
          "minLength": 1
        },
        "operation_id": {
          "type": "string",
          "minLength": 1
        },
        "parameters": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "input_contract": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "repo-root",
              "declared-source-inputs",
              "scm-facts-snapshot",
              "scm-event-identity",
              "full-depth-scm"
            ]
          }
        },
        "output_mode": {
          "enum": [
            "stdout-json",
            "declared-artifact-path-write",
            "controller-materialized"
          ]
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "runner": {
                "const": "buck2"
              }
            },
            "required": [
              "runner"
            ]
          },
          "then": {
            "properties": {
              "generator_target": {
                "pattern": "^//"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "runner": {
                "const": "ci-native-controller"
              }
            },
            "required": [
              "runner"
            ]
          },
          "then": {
            "properties": {
              "generator_target": {
                "pattern": "^ci://generated-artifact-controller/"
              },
              "output_mode": {
                "const": "controller-materialized"
              }
            }
          }
        }
      ]
    },
    "generated_path_rule": {
      "type": "object",
      "required": [
        "rule_id",
        "rule_kind",
        "pattern",
        "description"
      ],
      "properties": {
        "rule_id": {
          "type": "string",
          "minLength": 1
        },
        "rule_kind": {
          "enum": [
            "path_component",
            "path_prefix",
            "path_suffix",
            "file_name"
          ]
        },
        "pattern": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "exclude_file_names": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  }
}
