{
  "spec_id": "CELL-002-PROMOTION-AUTOMATION-CONTRACT",
  "title": "CELL-002 promotion, rebalancer, lifecycle, and sharding-automation contract",
  "status": "Proposed-target",
  "authoring_task": "CELL-002",
  "source_adrs": [
    "ADR-0341",
    "ADR-0348",
    "ADR-0351"
  ],
  "source_paths": {
    "ADR-0341": "docs/decisions/ADR-0700-ci-admission-live-apex.md",
    "ADR-0348": "docs/decisions/ADR-0700-ci-admission-live-apex.md",
    "ADR-0351": "docs/decisions/ADR-0701-monorepo-capability-live-apex.md",
    "cell_lifecycle_prd": "cell/cell-lifecycle/PRD.md",
    "cell_rebalancer_prd": "cell/cell-rebalancer/PRD.md",
    "cell_lifecycle_manifest": "cell/cell-lifecycle/manifest.json",
    "cell_rebalancer_manifest": "cell/cell-rebalancer/manifest.json"
  },
  "purpose": "Provides the first CELL-002 machine-readable service-plan and fixture-only contract tying the six-input cell-promotion gate, the ADR-0351 cell-lifecycle/cell-rebalancer split, existing sharding_automation manifest blocks, residency-honoring rebalance filters, and rollback audit-row fixture shape together without adding runtime handlers, migration execution, audit-chain writers, provider calls, or production-readiness claims.",
  "authority": {
    "accepted_boundary_adr": "ADR-0351",
    "proposed_adr_boundary": {
      "ADR-0341": "planning-context-only",
      "ADR-0348": "planning-context-only"
    },
    "runtime_mutation_authority": "none",
    "merge_authority": "plain git PR against dev plus protected presubmit context per ADR-0515",
    "conflict_class": "repo-governance-specs-docs",
    "scope_note": "This slice records contract, plan, and fixture surfaces only. It does not promote ADR-0341 or ADR-0348 from planning context to runtime authority. ADR-0351 is the accepted source for the service-boundary split."
  },
  "claim_controls": {
    "metadata_only": true,
    "service_plan_only": true,
    "fixture_only": true,
    "no_runtime_mutation": true,
    "no_live_migration": true,
    "no_audit_chain_writer": true,
    "strict_separation": true,
    "can_claim_now": [
      "CELL-002 has a machine-readable service-plan and fixture contract for promotion gate inputs, rebalancer/lifecycle boundaries, sharding_automation manifest checks, and rollback audit-row shape.",
      "The contract keeps ADR-0341 and ADR-0348 as planning-context inputs while using accepted ADR-0351 for cell-rebalancer and cell-lifecycle service boundaries."
    ],
    "blocked_claim_families": [
      "no_runtime_cell_orchestrator",
      "no_live_tenant_migration",
      "no_audit_chain_writer",
      "no_provider_or_kubernetes_mutation",
      "no_production_readiness_claim",
      "no_measured_slo_claim"
    ]
  },
  "promotion_gate": {
    "gate_id": "cell_promotion_six_input_gate",
    "owner_service": "cell-lifecycle",
    "decision_boundary": "promotion request validation only; transition execution remains downstream work",
    "six_inputs": [
      {
        "id": "G1_error_budget",
        "name": "Error budget intact",
        "source_adr": "ADR-0341",
        "evidence_authority": "observability",
        "required_evidence_fields": [
          "cell_id",
          "target_tier",
          "slo_budget_remaining_percent",
          "telemetry_window",
          "evidence_pack_id"
        ],
        "refusal_behavior": "fail_closed_no_promotion"
      },
      {
        "id": "G2_warm_soak",
        "name": "Warm-soak window clean",
        "source_adr": "ADR-0341",
        "evidence_authority": "cell-lifecycle",
        "required_evidence_fields": [
          "cell_id",
          "current_tier",
          "target_tier",
          "warm_soak_hours",
          "soak_regression_receipt"
        ],
        "refusal_behavior": "fail_closed_no_promotion"
      },
      {
        "id": "G3_canary_cohort",
        "name": "Canary cohort completed",
        "source_adr": "ADR-0341",
        "evidence_authority": "api-gateway",
        "required_evidence_fields": [
          "cell_id",
          "target_tier",
          "canary_cohort_id",
          "canary_success_percent",
          "routing_receipt_id"
        ],
        "refusal_behavior": "fail_closed_no_promotion"
      },
      {
        "id": "G4_cross_cell_mesh",
        "name": "Cross-cell mesh health",
        "source_adr": "ADR-0341",
        "evidence_authority": "api-gateway",
        "required_evidence_fields": [
          "cell_id",
          "target_tier",
          "cross_cell_call_success_percent",
          "mesh_policy_receipt_id",
          "telemetry_window"
        ],
        "refusal_behavior": "fail_closed_no_promotion"
      },
      {
        "id": "G5_tenant_class_coverage",
        "name": "Tenant-class coverage",
        "source_adr": "ADR-0341",
        "evidence_authority": "tenancy",
        "required_evidence_fields": [
          "cell_id",
          "target_tier",
          "tenant_classes_present",
          "demo_trial_sample_count",
          "paid_sample_count"
        ],
        "refusal_behavior": "fail_closed_no_promotion"
      },
      {
        "id": "G6_compliance_pack_coverage",
        "name": "Compliance-pack coverage",
        "source_adr": "ADR-0341",
        "evidence_authority": "policy-cedar",
        "required_evidence_fields": [
          "cell_id",
          "target_tier",
          "applicable_compliance_packs",
          "pack_receipt_ids",
          "cedar_decision_id"
        ],
        "refusal_behavior": "fail_closed_no_promotion"
      }
    ]
  },
  "cell_lifecycle_service_plan": {
    "service": "cell-lifecycle",
    "source_path": "cell/cell-lifecycle/PRD.md",
    "owns": "logical_cell_state_machine",
    "states": [
      "Registered",
      "Activated",
      "Promoted-T4",
      "Promoted-T3",
      "Promoted-T2",
      "Promoted-T1",
      "Promoted-T0",
      "Draining",
      "Decommissioned"
    ],
    "delegates_tenant_migration_to": "cell-rebalancer",
    "does_not_own": [
      "infrastructure_provisioning",
      "tenant_migration",
      "traffic_routing"
    ],
    "promotion_gate_binding": "promotion_gate.cell_promotion_six_input_gate",
    "accepted_boundary_adr": "ADR-0351"
  },
  "cell_rebalancer_service_plan": {
    "service": "cell-rebalancer",
    "source_path": "cell/cell-rebalancer/PRD.md",
    "owns": "across_cell_tenant_migration_workflow",
    "does_not_own": [
      "cell_lifecycle_state_machine",
      "first_time_placement",
      "within_cell_shuffle_sharding"
    ],
    "residency_honoring_rebalance": {
      "trigger": "auto_rebalance",
      "candidate_filters": [
        "residency_domain",
        "compliance_packs",
        "cell_placement_class",
        "capacity_headroom",
        "cedar_permit"
      ],
      "refusal_behavior": "fail_closed_operator_escalation",
      "audit_fixture": "specs/fixtures/cell-002-promotion-automation/rollback-audit-row.json",
      "rollback_path": "restore source epoch or freeze target activation, then emit/verify rollback audit row before terminal status is claimed"
    },
    "accepted_boundary_adr": "ADR-0351"
  },
  "sharding_automation_manifest_contract": {
    "canonical_autosharding_mode": "control_plane_driven",
    "required_subblocks": [
      "autosharding",
      "auto_rebalance",
      "dynamic_sharding"
    ],
    "service_manifest_inputs": [
      "cell/cell-lifecycle/manifest.json",
      "cell/cell-rebalancer/manifest.json"
    ],
    "default_thresholds": {
      "auto_rebalance_load_skew_threshold_percent": 30,
      "hot_split_threshold_p99_ms": 50,
      "hot_split_utilization_threshold_percent": 80,
      "cold_merge_utilization_threshold_percent": 20,
      "cold_merge_minimum_quiet_hours": 24
    },
    "manual_mode_refusal": "Any manifest mode=manual remains refused; control_plane_driven is the only canonical intent.",
    "enabled_runtime_rule": "If a later manifest enables auto_rebalance or dynamic_sharding, audit_chain_emit must be true on that enabled sub-block."
  },
  "rollback_audit_fixture": {
    "path": "specs/fixtures/cell-002-promotion-automation/rollback-audit-row.json",
    "required_fields": [
      "event_type",
      "tenant_id",
      "source_cell_id",
      "target_cell_id",
      "cell_id",
      "pre_state",
      "post_state",
      "residency_check_result",
      "compliance_pack_check_result",
      "cedar_permit_id",
      "initiated_by",
      "audit_chain_id",
      "rollback_pointer",
      "evidence_pack_id"
    ],
    "non_claim": "The fixture does not emit audit-chain events; it records the minimum row shape a later audit-chain writer must produce or verify."
  },
  "nonclaims": [
    {
      "id": "no_runtime_cell_orchestrator",
      "statement": "No control-loop worker, scheduler, or cell-orchestrator runtime is implemented by this contract."
    },
    {
      "id": "no_live_tenant_migration",
      "statement": "No tenant data movement, cell drain, rebalancing workflow execution, or routing cutover is performed."
    },
    {
      "id": "no_audit_chain_writer",
      "statement": "No audit-chain writer, Merkle seal persistence, or external evidence-store call is introduced."
    },
    {
      "id": "no_provider_or_kubernetes_mutation",
      "statement": "No provider API, Kubernetes API, OpenTofu plan/apply, database, broker, or storage API call is introduced."
    },
    {
      "id": "no_production_readiness_claim",
      "statement": "This target contract is not a product-readiness, launch-readiness, or availability claim."
    },
    {
      "id": "no_measured_slo_claim",
      "statement": "No measured SLO, SLI, burn-rate, or live observability evidence is claimed."
    }
  ]
}
