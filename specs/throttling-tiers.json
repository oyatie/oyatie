{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.oyatie.com/specs/throttling-tiers.schema.json",
  "_meta": {
    "doc_class": "Machine-Readable-Spec",
    "spec_id": "EXE-THROTTLING-TIERS",
    "version": "1.0.0",
    "status": "Accepted",
    "enforcement_status": "advisory-until-public-rpc-coverage-complete",
    "owner_team": "council-architecture",
    "created_at": "2026-05-18T00:00:00Z",
    "binding_adr": "ADR-0178",
    "purpose": "Four layered throttling tiers — per-IP, per-API-key, per-user, per-tenant — with per-layer counter store, denial code, headroom header."
  },
  "title": "Layered throttling tiers canonical schema",
  "type": "object",
  "required": [
    "layers",
    "evaluation_order",
    "denial_status_code"
  ],
  "properties": {
    "evaluation_order": {
      "type": "array",
      "default": [
        "per_ip",
        "per_api_key",
        "per_user",
        "per_tenant"
      ]
    },
    "denial_status_code": {
      "const": 429
    },
    "layers": {
      "type": "object",
      "required": [
        "per_ip",
        "per_api_key",
        "per_user",
        "per_tenant"
      ],
      "properties": {
        "per_ip": {
          "type": "object",
          "properties": {
            "counter_store": {
              "const": "redis-mesh-edge-cache"
            },
            "window": {
              "const": "rolling-1-min"
            },
            "default_anonymous_budget_per_min": {
              "const": 100
            },
            "default_mesh_internal_budget_per_min": {
              "const": 10000
            },
            "burst_capacity_tokens": {
              "const": 20
            },
            "headroom_header": {
              "const": "throttle-ip-headroom"
            },
            "denial_class_header_value": {
              "const": "ip-abuse"
            }
          }
        },
        "per_api_key": {
          "type": "object",
          "properties": {
            "counter_store": {
              "const": "envoy-ratelimit-service"
            },
            "window": {
              "const": "rolling-1-min-plus-1-hour"
            },
            "default_budget_per_min": {
              "const": 1000
            },
            "default_budget_per_hour": {
              "const": 50000
            },
            "burst_capacity_tokens": {
              "const": 200
            },
            "headroom_header": {
              "const": "throttle-key-headroom"
            },
            "denial_class_header_value": {
              "const": "api-key"
            }
          }
        },
        "per_user": {
          "type": "object",
          "properties": {
            "counter_store": {
              "const": "tenant-scope-redis-cluster-per-cell"
            },
            "window": {
              "const": "rolling-1-min"
            },
            "default_budget_per_min": {
              "const": 600
            },
            "burst_capacity_tokens": {
              "const": 60
            },
            "headroom_header": {
              "const": "throttle-user-headroom"
            },
            "denial_class_header_value": {
              "const": "user"
            }
          }
        },
        "per_tenant": {
          "type": "object",
          "properties": {
            "counter_store": {
              "const": "cell-level-postgres-plus-redis-lookaside"
            },
            "window": {
              "const": "rolling-1-min-plus-1-day"
            },
            "default_budget_per_min_by_tier": {
              "type": "object",
              "default": {
                "free": 1000,
                "pro": 10000,
                "enterprise": "negotiated"
              }
            },
            "burst_capacity_ratio": {
              "const": 0.2
            },
            "headroom_header": {
              "const": "throttle-tenant-headroom"
            },
            "denial_class_header_value": {
              "const": "tenant"
            }
          }
        }
      }
    },
    "headroom_to_brownout_class_threshold": {
      "const": 0.05
    },
    "denial_body_includes_retry_after_per_rfc": {
      "const": "RFC-6585"
    }
  }
}
