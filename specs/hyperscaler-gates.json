  "hyperscaler_mature_claim_rule": {
    "exact_claim": "we are hyperscaler mature",
    "claim_status": "blocked_until_required_evidence_is_green",
    "allowed_when": [
      "every gate in this file has current implementation evidence for the claimed surface",
      "every gate in this file has fresh verification evidence from repo-native gates or runtime probes",
      "every production-facing reliability and safety claim has operational evidence, not only plans",
      "Workflow Studio, Workflow engine, integration connector catalog, and Foundry pipeline have end-user UX evidence for critical journeys",
      "competitor claims have official-source references, observed strengths, observed weaknesses, adopt/adapt decisions, and improve-beyond-them actions",
      "ADR-0116 Oya VCS claim/verify/done/promote is the only agent transition authority",
      "review/fix loop, CI fix loop, conflict avoidance, and merge queue path are automated and controller-owned",
      "CI/CD required checks, branch protection context matching, release evidence packs, and rollback/progressive-delivery gates are green",
      "all planned-only product crates named in the claimed surface are implemented or explicitly excluded from the claim"
    ],
    "current_blockers": [
      "Workflow Studio crates are still planned and cannot prove end-user UX, accessibility, guardrail, or ease-of-use maturity yet",
      "the Foundry/Oya VCS pipeline still carries a documented Wave-B manual PR-entry seam",
      "pipeline maturity evidence predates ADR-0116 and must be refreshed against the Oya VCS closure authority",
      "workspace hygiene now inventories /tmp, user-home Oyatie spillover, repo-root scratch artifacts, build outputs, and ~/oyatie-worktrees, cleans configured temp/build artifacts with explicit cleanup flags, and exempts owned roots only with evidence refs, but strict cleanup evidence is not yet green",
      "some Workflow Studio competitor benchmark deltas were targets rather than measured external facts and have been converted into source-backed adopt/improve requirements",
      "M02/P22 readiness and downstream M03 transition remain separately gated by the master plan"
    ],
    "forbidden_claim_patterns": [
      "hyperscaler mature",
      "AWS-grade",
      "AWS-level",
      "production mature",
      "99.95% availability achieved",
      "beats <competitor> on latency",
      "better than <competitor> without source-backed evidence"
    ],
    "required_priority_surfaces": [
      "workflow-studio",
      "workflow-engine",
      "integration-connector-catalog",
      "governance-pipeline",
      "oya-vcs-admission",
      "ci-cd-toolchain",
      "development-cycle",
      "workspace-hygiene",
      "guardrails",
      "safety",
      "ease-of-use"
    ]
  },
