{
  "_schema": {
    "version": "1.0.0",
    "description": "Gate registry for honest hyperscaler-grade architecture claims. References repo standards; does not replace them.",
    "owner_team": "council-architecture + ops-sre-reliability + ops-security",
    "validation_check": "json-valid + referenced-paths-exist + claims-can-cannot-matrix-present"
  },
  "_metadata": {
    "sidecar_id": "EXE-HYPERSCALER-GATES",
    "status": "draft-sidecar",
    "claim_boundary": "May claim hyperscaler-grade architecture discipline only when gates have evidence. Must not claim hyperscaler scale, SLOs, compliance, or production maturity without proof.",
    "canonical_sources": [
      "docs/standards/hyperscaler-best-practices.md",
      "docs/standards/clean-architecture.md",
      "docs/standards/testing.md",
      "docs/standards/dependency-policy.md",
      "docs/standards/security-review.md",
      "docs/standards/observability.md",
      "docs/standards/release-management.md",
      "docs/standards/crate-naming-convention.md",
      "docs/checklists/wave-gate.md",
      "docs/checklists/release-readiness-checklist.md"
    ],
    "deduplicates_existing": [
      "docs/standards/hyperscaler-best-practices.md",
      "docs/checklists/wave-gate.md",
      "docs/checklists/release-readiness-checklist.md"
    ]
  },
  "gates": [
    {
      "id": "HG-ARCH",
      "name": "clean architecture and boundaries",
      "requires": [
        "inward_dependency_direction",
        "bounded_context_ownership",
        "no_framework_logic_in_core",
        "naming_justification"
      ],
      "evidence_classes": [
        "implementation",
        "verification",
        "documentation"
      ]
    },
    {
      "id": "HG-CONTRACT",
      "name": "contract and compatibility discipline",
      "requires": [
        "schema_contract_parity",
        "versioning_or_migration_note",
        "consumer_impact_review"
      ],
      "evidence_classes": [
        "implementation",
        "verification",
        "documentation"
      ]
    },
    {
      "id": "HG-SECURITY",
      "name": "tenant/principal/security boundary",
      "requires": [
        "threat_model_for_reachable_or_privileged_paths",
        "least_privilege",
        "secret_safe_handling",
        "authz_policy_tests_when_applicable"
      ],
      "evidence_classes": [
        "security",
        "verification",
        "documentation"
      ]
    },
    {
      "id": "HG-RELIABILITY",
      "name": "failure semantics",
      "requires": [
        "idempotency_or_reason_not_applicable",
        "retry_timeout_cancellation",
        "degraded_mode_or_rollback"
      ],
      "evidence_classes": [
        "implementation",
        "operational",
        "verification"
      ]
    },
    {
      "id": "HG-OBS",
      "name": "observability and auditability",
      "requires": [
        "structured_errors_or_logs",
        "metrics_or_metric_ready_boundary",
        "trace_or_trace_ready_boundary",
        "audit_event_when_required"
      ],
      "evidence_classes": [
        "operational",
        "implementation",
        "documentation"
      ]
    },
    {
      "id": "HG-TEST",
      "name": "test pyramid and quality gates",
      "requires": [
        "targeted_tests",
        "nextest_or_repo_native_tests",
        "clippy_or_lint",
        "doc_contract_gate_when_relevant"
      ],
      "evidence_classes": [
        "verification"
      ]
    },
    {
      "id": "HG-SUPPLY",
      "name": "supply-chain posture",
      "requires": [
        "dependency_policy_check",
        "license_advisory_check",
        "sbom_signing_provenance_when_artifacts_ship"
      ],
      "evidence_classes": [
        "supply_chain",
        "verification"
      ]
    },
    {
      "id": "HG-OPS",
      "name": "runtime readiness",
      "requires": [
        "runbook_or_operator_note",
        "smoke_test",
        "rollback_or_recovery_path"
      ],
      "evidence_classes": [
        "operational",
        "documentation",
        "verification"
      ]
    },
    {
      "id": "HG-DOCS",
      "name": "documentation truthfulness",
      "requires": [
        "doc_catalog_accounting",
        "adr_for_real_decisions",
        "docs_match_implementation"
      ],
      "evidence_classes": [
        "documentation",
        "verification"
      ]
    },
    {
      "id": "HG-GRIT",
      "name": "coordination minimalism",
      "requires": [
        "grit_claim_work_done_used",
        "new_coordination_kernel_justified_against_grit",
        "no_git_gh_agent_transition"
      ],
      "evidence_classes": [
        "closeout",
        "critic"
      ]
    }
  ],
  "claim_matrix_required": [
    "claims_we_can_make",
    "claims_we_cannot_make_yet",
    "evidence_required_to_make_remaining_claims"
  ],
  "purpose": "Gate registry for honest hyperscaler-grade architecture claims. References repo standards; does not replace them."
}
