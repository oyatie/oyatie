{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.oyatie.com/specs/finops-dimensional-model.schema.json",
  "title": "Oyatie FinOps + Sustainability Dimensional Model Schema",
  "description": "Canonical dimensional rollup contract owned by the finops-portal microservice per ADR-0344. Specifies six canonical axes (tenant / product / capability / provider / cell / compliance_pack), per-axis aggregation primitives (cost_usd_minor_units_sum + co2_grams_sum + watt_hours_sum + event_count), rollup freshness budget, retention, three regulator-export evidence file formats (CSRD ESRS E1 / SB-253 / SEC climate disclosure), and the per-microservice sustainability_emission_model manifest block shape.",
  "version": "1.0.0",
  "_meta": {
    "doc_class": "Machine-Readable-Spec",
    "spec_id": "EXE-FINOPS-DIMENSIONAL-MODEL",
    "status": "Proposed",
    "enforcement_status": "advisory-until-per-microservice-sustainability-emission-model-declared",
    "owner_team": "ops-finops + axis-observability + axis-audit-chain + ops-compliance",
    "created_at": "2026-05-21T00:00:00Z",
    "binding_adr": "ADR-0344",
    "related_adrs": [
      "ADR-0099",
      "ADR-0150",
      "ADR-0174",
      "ADR-0181",
      "ADR-0212",
      "ADR-0240",
      "ADR-0243",
      "ADR-0244",
      "ADR-0248",
      "ADR-0251",
      "ADR-0252",
      "ADR-0255",
      "ADR-0263",
      "ADR-0322",
      "ADR-0328",
      "ADR-0336",
      "ADR-0337",
      "ADR-0338",
      "ADR-0339",
      "ADR-0340",
      "ADR-0344"
    ],
    "purpose": "Define the six-axis dimensional rollup contract for sustainability + finops reporting. Per-axis aggregation, rollup freshness, retention, regulator-export evidence formats, and the per-microservice manifest block shape are normative."
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "model_id",
    "version",
    "dimensional_axes",
    "aggregation_primitives",
    "rollup_contract",
    "retention",
    "regulator_export_formats",
    "carbon_intensity_resolution",
    "sustainability_emission_model_manifest_block",
    "cedar_context_inputs",
    "chargeback_widening",
    "anomaly_thresholds_widening",
    "update_policy"
  ],
  "properties": {
    "model_id": {
      "type": "string",
      "const": "finops-dimensional-model",
      "description": "Stable model id for the ADR-0344 dimensional-rollup catalog."
    },
    "version": {
      "$ref": "#/definitions/semver",
      "description": "Semantic version of the dimensional model contract."
    },
    "dimensional_axes": {
      "type": "array",
      "description": "Six canonical dimensional axes for the finops-portal rollup per ADR-0344 D-3.1.",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "axis_id",
          "axis_name",
          "source_field",
          "cardinality_budget",
          "indexed",
          "rollup_partition_key"
        ],
        "properties": {
          "axis_id": {
            "type": "string",
            "enum": [
              "tenant",
              "product",
              "capability",
              "provider",
              "cell",
              "compliance_pack"
            ]
          },
          "axis_name": {
            "type": "string",
            "minLength": 3,
            "maxLength": 120
          },
          "source_field": {
            "type": "string",
            "description": "Audit-row field that supplies this axis at rollup time."
          },
          "cardinality_budget": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "max_distinct_per_cell_per_day",
              "high_cardinality_allowed"
            ],
            "properties": {
              "max_distinct_per_cell_per_day": {
                "type": "integer",
                "minimum": 1
              },
              "high_cardinality_allowed": {
                "type": "boolean"
              }
            }
          },
          "indexed": {
            "type": "boolean"
          },
          "rollup_partition_key": {
            "type": "boolean"
          }
        }
      },
      "default": [
        {
          "axis_id": "tenant",
          "axis_name": "Tenant",
          "source_field": "tenant_id",
          "cardinality_budget": {
            "max_distinct_per_cell_per_day": 1000000,
            "high_cardinality_allowed": true
          },
          "indexed": true,
          "rollup_partition_key": true
        },
        {
          "axis_id": "product",
          "axis_name": "Product",
          "source_field": "product",
          "cardinality_budget": {
            "max_distinct_per_cell_per_day": 200,
            "high_cardinality_allowed": false
          },
          "indexed": true,
          "rollup_partition_key": false
        },
        {
          "axis_id": "capability",
          "axis_name": "Capability",
          "source_field": "capability",
          "cardinality_budget": {
            "max_distinct_per_cell_per_day": 50000,
            "high_cardinality_allowed": true
          },
          "indexed": true,
          "rollup_partition_key": false
        },
        {
          "axis_id": "provider",
          "axis_name": "Provider",
          "source_field": "provider",
          "cardinality_budget": {
            "max_distinct_per_cell_per_day": 10,
            "high_cardinality_allowed": false
          },
          "indexed": true,
          "rollup_partition_key": false
        },
        {
          "axis_id": "cell",
          "axis_name": "Cell",
          "source_field": "cell_id",
          "cardinality_budget": {
            "max_distinct_per_cell_per_day": 1,
            "high_cardinality_allowed": false
          },
          "indexed": true,
          "rollup_partition_key": true
        },
        {
          "axis_id": "compliance_pack",
          "axis_name": "Compliance Pack",
          "source_field": "cell.compliance_pack",
          "cardinality_budget": {
            "max_distinct_per_cell_per_day": 20,
            "high_cardinality_allowed": false
          },
          "indexed": true,
          "rollup_partition_key": false
        }
      ]
    },
    "aggregation_primitives": {
      "type": "object",
      "description": "Per-axis aggregation primitives surfaced by the rollup per ADR-0344 D-3.3.",
      "additionalProperties": false,
      "required": [
        "cost_usd_minor_units_sum",
        "co2_grams_sum",
        "watt_hours_sum",
        "event_count"
      ],
      "properties": {
        "cost_usd_minor_units_sum": {
          "type": "object",
          "properties": {
            "type": {
              "const": "int64"
            },
            "description": {
              "const": "Sum of per-call USD cost in minor units (cents) over the axis bucket."
            }
          }
        },
        "co2_grams_sum": {
          "type": "object",
          "properties": {
            "type": {
              "const": "uint64"
            },
            "description": {
              "const": "Sum of per-call CO2-equivalent emissions in grams over the axis bucket."
            }
          }
        },
        "watt_hours_sum": {
          "type": "object",
          "properties": {
            "type": {
              "const": "uint64"
            },
            "description": {
              "const": "Sum of per-call energy consumption in whole watt-hours over the axis bucket."
            }
          }
        },
        "event_count": {
          "type": "object",
          "properties": {
            "type": {
              "const": "uint64"
            },
            "description": {
              "const": "Count of audit-chain rows folded into the axis bucket."
            }
          }
        }
      }
    },
    "rollup_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner_microservice",
        "compute_engine",
        "storage_substrate",
        "freshness_budget",
        "staleness_audit_class",
        "materialized_views"
      ],
      "properties": {
        "owner_microservice": {
          "const": "finops-portal"
        },
        "compute_engine": {
          "const": "clickhouse-26-3-lts-iceberg-engine"
        },
        "storage_substrate": {
          "const": "apache-iceberg-via-rest-catalog"
        },
        "freshness_budget": {
          "type": "object",
          "properties": {
            "p99_seconds": {
              "type": "integer",
              "const": 300,
              "description": "5-minute p99 freshness per (tenant, hour) tuple."
            }
          }
        },
        "staleness_audit_class": {
          "const": "rollup.staleness.exceeded"
        },
        "materialized_views": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "properties": {
              "view_id": {
                "type": "string"
              },
              "grain": {
                "type": "string",
                "enum": [
                  "per_minute",
                  "per_hour",
                  "per_day",
                  "per_month"
                ]
              },
              "partition_keys": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "default": [
            {
              "view_id": "rollup_tenant_minute",
              "grain": "per_minute",
              "partition_keys": [
                "tenant_id",
                "cell_id"
              ]
            },
            {
              "view_id": "rollup_tenant_hour",
              "grain": "per_hour",
              "partition_keys": [
                "tenant_id",
                "cell_id"
              ]
            },
            {
              "view_id": "rollup_tenant_day",
              "grain": "per_day",
              "partition_keys": [
                "tenant_id",
                "cell_id"
              ]
            }
          ]
        }
      }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "audit_row_retention_years",
        "rollup_table_retention_years",
        "regulator_export_pack_retention_years"
      ],
      "properties": {
        "audit_row_retention_years": {
          "type": "integer",
          "const": 7,
          "description": "7-year HIPAA / PCI / CSRD / SOC2 floor."
        },
        "rollup_table_retention_years": {
          "type": "integer",
          "const": 7
        },
        "regulator_export_pack_retention_years": {
          "type": "integer",
          "const": 10,
          "description": "Regulator pack retention exceeds raw retention to support late audits."
        }
      }
    },
    "regulator_export_formats": {
      "type": "array",
      "description": "Three regulator-export evidence file formats per ADR-0344 D-5.",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "format_id",
          "framework",
          "schema_version",
          "filing_cadence",
          "filing_authority",
          "signed_via",
          "hlc_ordered"
        ],
        "properties": {
          "format_id": {
            "type": "string",
            "enum": [
              "csrd-esrs-e1",
              "sb-253",
              "sec-climate-disclosure"
            ]
          },
          "framework": {
            "type": "string"
          },
          "schema_version": {
            "type": "string"
          },
          "filing_cadence": {
            "type": "string",
            "enum": [
              "annual",
              "fiscal-year"
            ]
          },
          "filing_authority": {
            "type": "string"
          },
          "signed_via": {
            "const": "cosign-per-ADR-0181"
          },
          "hlc_ordered": {
            "const": true
          }
        }
      },
      "default": [
        {
          "format_id": "csrd-esrs-e1",
          "framework": "EU CSRD ESRS E1 (Climate change)",
          "schema_version": "ESRS-2023-2772-XBRL-ESEF",
          "filing_cadence": "annual",
          "filing_authority": "EU national competent authorities",
          "signed_via": "cosign-per-ADR-0181",
          "hlc_ordered": true
        },
        {
          "format_id": "sb-253",
          "framework": "California Climate Corporate Data Accountability Act",
          "schema_version": "CARB-published-CSV-v1",
          "filing_cadence": "annual",
          "filing_authority": "California Air Resources Board",
          "signed_via": "cosign-per-ADR-0181",
          "hlc_ordered": true
        },
        {
          "format_id": "sec-climate-disclosure",
          "framework": "SEC Climate-Related Disclosures (17 CFR 210/229/232/239/249)",
          "schema_version": "SEC-XBRL-taxonomy-2024",
          "filing_cadence": "fiscal-year",
          "filing_authority": "U.S. Securities and Exchange Commission",
          "signed_via": "cosign-per-ADR-0181",
          "hlc_ordered": true
        }
      ]
    },
    "carbon_intensity_resolution": {
      "type": "object",
      "description": "Fallback chain for region carbon intensity per ADR-0344 D-7.",
      "additionalProperties": false,
      "required": [
        "canonical_provider",
        "cache_substrate",
        "cache_ttl_seconds",
        "fallback_chain",
        "carbon_intensity_source_enum"
      ],
      "properties": {
        "canonical_provider": {
          "type": "object",
          "properties": {
            "name": {
              "const": "electricityMaps"
            },
            "api_base": {
              "const": "https://api.electricitymaps.com/v3"
            },
            "endpoint": {
              "const": "/carbon-intensity/{zone}"
            },
            "client_path": {
              "const": "microservices/observability/src/carbon_intensity/electricitymaps_client.rs"
            },
            "language": {
              "const": "rust"
            }
          }
        },
        "cache_substrate": {
          "const": "valkey-per-ADR-0336"
        },
        "cache_ttl_seconds": {
          "type": "integer",
          "const": 3600
        },
        "fallback_chain": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "order": {
                "type": "integer"
              },
              "source_id": {
                "type": "string",
                "enum": [
                  "electricitymaps",
                  "provider_grid_avg",
                  "sovereign_published"
                ]
              },
              "activation_condition": {
                "type": "string"
              }
            }
          },
          "default": [
            {
              "order": 1,
              "source_id": "electricitymaps",
              "activation_condition": "cache hit or successful synchronous fetch"
            },
            {
              "order": 2,
              "source_id": "provider_grid_avg",
              "activation_condition": "3+ consecutive electricityMaps failures (circuit breaker open)"
            },
            {
              "order": 3,
              "source_id": "sovereign_published",
              "activation_condition": "sovereign compliance pack mandates override per ADR-0240/ADR-0251"
            }
          ]
        },
        "carbon_intensity_source_enum": {
          "type": "array",
          "minItems": 5,
          "items": {
            "type": "string"
          },
          "default": [
            "electricitymaps",
            "provider_grid_avg",
            "sovereign_published",
            "cache_hit",
            "cache_miss_fallback"
          ]
        }
      }
    },
    "sustainability_emission_model_manifest_block": {
      "type": "object",
      "description": "Per-microservice manifest.json sustainability_emission_model block shape per ADR-0344 D-2.",
      "additionalProperties": false,
      "required": [
        "required_fields",
        "tier_overhead_factor_defaults",
        "validation_baseline_tolerance_pct"
      ],
      "properties": {
        "required_fields": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "pod_runtime_tier_ref",
            "power_model.cpu_watts_per_vcpu_second",
            "power_model.memory_watts_per_gib_second",
            "power_model.storage_watts_per_gib_hour",
            "power_model.network_watts_per_gib",
            "power_model.tier_overhead_factor",
            "price_model.source",
            "price_model.binding",
            "price_model.pin_window_hours",
            "workload_signal_source",
            "emission_path_tests",
            "validation_baseline.expected_watt_hours_per_request_p50_mwh",
            "validation_baseline.expected_co2_grams_per_request_p50_at_grid_400gco2_per_kwh",
            "validation_baseline.tolerance_pct"
          ]
        },
        "tier_overhead_factor_defaults": {
          "type": "object",
          "properties": {
            "tier_0_kata_clh": {
              "type": "number",
              "const": 1.4
            },
            "tier_1_kata_clh": {
              "type": "number",
              "const": 1.4
            },
            "tier_2_runc": {
              "type": "number",
              "const": 1.0
            },
            "tier_3_runc_edge": {
              "type": "number",
              "const": 1.05
            }
          }
        },
        "validation_baseline_tolerance_pct": {
          "type": "integer",
          "const": 20,
          "description": "Default ±20 percent tolerance; per-µservice IPs may tighten per ADR-0344 I.5."
        }
      }
    },
    "cedar_context_inputs": {
      "type": "object",
      "description": "Cedar context inputs gained per ADR-0344 D-9 for provider routing and carbon-aware scheduling.",
      "additionalProperties": false,
      "required": [
        "provider_routing_inputs",
        "carbon_aware_scheduling_inputs",
        "tier_eligibility",
        "compliance_pack_exclusions"
      ],
      "properties": {
        "provider_routing_inputs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "context.region.carbon_intensity_g_co2e_per_kwh",
            "context.workload.carbon_budget_g_co2e_per_kwh",
            "context.providers.lowest_carbon_intensity_g_co2e_per_kwh",
            "context.providers.lowest_cost_usd_per_call"
          ]
        },
        "carbon_aware_scheduling_inputs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "resource.carbon_aware",
            "resource.pod_runtime_tier",
            "resource.compliance_pack",
            "resource.slo_error_budget_remaining",
            "resource.compliance_pack_rto_seconds",
            "context.next_low_carbon_window_starts_within_seconds"
          ]
        },
        "tier_eligibility": {
          "type": "object",
          "properties": {
            "eligible_for_deferral": {
              "type": "array",
              "items": {
                "type": "integer",
                "enum": [
                  2,
                  3
                ]
              },
              "default": [
                2,
                3
              ]
            },
            "ineligible_for_deferral": {
              "type": "array",
              "items": {
                "type": "integer",
                "enum": [
                  0,
                  1
                ]
              },
              "default": [
                0,
                1
              ],
              "description": "Tier 0 + Tier 1 ineligible per ADR-0344 B2.019."
            }
          }
        },
        "compliance_pack_exclusions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "eu-ai-act-annex-iii",
            "hipaa-em-incident-response",
            "pci-dss-realtime-fraud-detection"
          ],
          "description": "Realtime-mandated packs ineligible for carbon-aware deferral per ADR-0344 B2.020."
        }
      }
    },
    "chargeback_widening": {
      "type": "object",
      "description": "ADR-0174 chargeback formula widening per ADR-0344 D-10.",
      "additionalProperties": false,
      "required": [
        "formula",
        "carbon_cost"
      ],
      "properties": {
        "formula": {
          "const": "chargeback_period_total = labelled_spend + capability_invocation + audit_chain_emission + storage + credits + carbon_cost"
        },
        "carbon_cost": {
          "type": "object",
          "properties": {
            "default_usd": {
              "type": "number",
              "const": 0
            },
            "opt_in_tenant_class": {
              "type": "string",
              "enum": [
                "paid"
              ]
            },
            "formula": {
              "const": "co2_grams_sum_in_period * carbon_cost_per_gram_usd"
            },
            "carbon_cost_per_gram_usd_source": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": [
                "eu-ets-price",
                "california-cap-and-trade",
                "voluntary-verra",
                "voluntary-gold-standard"
              ]
            },
            "demo_trial_tenants": {
              "const": "always 0 USD; no opt-in"
            }
          }
        }
      }
    },
    "anomaly_thresholds_widening": {
      "type": "object",
      "description": "ADR-0174 anomaly thresholds widening per ADR-0344 D-10.3.",
      "additionalProperties": false,
      "required": [
        "carbon_spike",
        "watt_hours_creep"
      ],
      "properties": {
        "carbon_spike": {
          "type": "object",
          "properties": {
            "trigger": {
              "const": "tenant co2_grams > 3*MAD over rolling 14-day baseline AND co2_grams > 10000g/hr"
            },
            "severity": {
              "const": "SEV-2"
            },
            "audit_event_class": {
              "const": "carbon.spike.detected"
            }
          }
        },
        "watt_hours_creep": {
          "type": "object",
          "properties": {
            "trigger": {
              "const": "tenant watt_hours > 7-day rolling baseline by 25% sustained >= 24h"
            },
            "severity": {
              "const": "SEV-3"
            },
            "audit_event_class": {
              "const": "energy.watt_hours.creep.detected"
            }
          }
        }
      }
    },
    "update_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requires_originating_adr",
        "requires_reverse_reference_to_adr_0344",
        "requires_audit_event_schema_update",
        "requires_per_microservice_emission_model_block",
        "requires_validator_lane"
      ],
      "properties": {
        "requires_originating_adr": {
          "type": "boolean",
          "const": true
        },
        "requires_reverse_reference_to_adr_0344": {
          "type": "boolean",
          "const": true
        },
        "requires_audit_event_schema_update": {
          "type": "boolean",
          "const": true
        },
        "requires_per_microservice_emission_model_block": {
          "type": "boolean",
          "const": true
        },
        "requires_validator_lane": {
          "type": "string",
          "const": "cloud-ci/Rust gate packet: finops-dimensional-rollup"
        }
      }
    }
  },
  "definitions": {
    "semver": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$",
      "examples": [
        "1.0.0"
      ]
    }
  }
}
