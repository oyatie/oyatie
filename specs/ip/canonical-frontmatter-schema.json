{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://oyatie.com/schemas/ip-canonical-frontmatter.json",
  "title": "Implementation Plan canonical frontmatter schema (SWEEP-I Slice 6)",
  "description": "Canonical YAML frontmatter for every per-µservice IP markdown. Authority: ADR-0064.",
  "canonical_authority": "ADR-0064",
  "ip_authority": "ADR-0131 per-microservice flat layout + ADR-0132 no-grouping policy",
  "consumer_pattern": "microservices/<ms>/IP-NNN-<slug>.md",
  "type": "object",
  "required": [
    "doc_class",
    "template_id",
    "milestone",
    "phase",
    "impl_plan_id",
    "status",
    "execution_unit",
    "owner",
    "acceptance_lanes"
  ],
  "properties": {
    "doc_class": {
      "type": "string",
      "enum": [
        "ImplementationPlan"
      ]
    },
    "template_id": {
      "type": "string",
      "enum": [
        "TPL-IMPL",
        "TPL-IMPL-EXIT-GATE",
        "TPL-IMPL-MIGRATION"
      ]
    },
    "milestone": {
      "type": "string",
      "pattern": "^M[0-9]{2}[a-z]?(-[a-z0-9-]+)?$",
      "description": "Milestone identifier (e.g. M03-studio-preview)"
    },
    "phase": {
      "type": "string",
      "pattern": "^P[0-9]{2}[a-z]?(-[a-z0-9-]+)?$",
      "description": "Phase identifier (e.g. P01-visual-authoring-substrate)"
    },
    "impl_plan_id": {
      "type": "string",
      "pattern": "^IP-[0-9]{3}(-[a-z0-9-]+)?$",
      "description": "IP identifier with optional slug suffix"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "in-progress",
        "complete",
        "blocked",
        "deferred",
        "withdrawn"
      ]
    },
    "execution_unit": {
      "type": "string",
      "enum": [
        "ChangeSet"
      ]
    },
    "changeset_contract": {
      "type": "string",
      "enum": [
        "claimable-verifiable-bundleable-promotable"
      ]
    },
    "owner": {
      "type": "string"
    },
    "acceptance_lanes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "preceded_by": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "succeeded_by": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
