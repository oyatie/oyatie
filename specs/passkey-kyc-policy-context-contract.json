  "title": "Passkey KYC Policy Context Contract",
  "version": "0.1.0",
  "_meta": {
    "doc_class": "Machine-Readable-Spec",
    "spec_id": "REGID-004-PASSKEY-KYC-POLICY-CONTEXT-CONTRACT",
    "status": "Draft-Contract-Plan",
    "enforcement_status": "planning-contract-only-no-serving-code",
