  "decision_invariants": [
    {
      "id": "REGID-004-I01-PASSKEY-NOT-KYC",
      "rule": "passkey_auth_state=authenticated is never sufficient for a regulated allow decision unless proofing_state, due_diligence_state, screening_state, consent_state, residency_state, retention_state, purpose_state, risk_state, and pdp_audit_state also satisfy their action-specific floor."
    },
    {
      "id": "REGID-004-I02-SYNCABLE-AAL-CEILING",
      "rule": "credential_type=syncable_passkey with device_binding=syncable_multi_device must expose syncable_passkey_aal_ceiling=AAL2 and cannot satisfy critical/AAL3-like decisions without additional hardware-bound or approval evidence."
    },
    {
      "id": "REGID-004-I03-CRITICAL-HARDWARE",
      "rule": "critical actions require hardware_bound or FIDO-MDS3-L2+ authenticator assurance plus critical_operation_approval.required=true with approval_window_state=approved_in_window and an approval_ref, not merely a synced passkey."
    },
    {
      "id": "REGID-004-I04-SCREENING-FRESHNESS",
      "rule": "sanctions/PEP/adverse-media hit, unresolved, missing, stale, or expired states fail closed for proofing approval, pack activation, packet publication, and regulator export."
    },
    {
      "id": "REGID-004-I05-CONSENT-RESIDENCY-RETENTION",
      "rule": "missing/revoked consent, invalid lawful basis, forbidden residency target, unbound purpose, or missing retention rule produces deny obligations even when auth and proofing are otherwise strong."
    },
    {
      "id": "REGID-004-I06-AUDIT-OBLIGATIONS",
      "rule": "Every allow and deny on regulated KYC actions requires an audit-chain decision, determining policy ids, and obligations sufficient for evidence attachment, retention, residency, consent, and step-up when applicable."
    }
  ],
