    "kanban_task": "t_0d6973c9",
    "lane": "regulatory-identity/policy-context",
    "purpose": "Define the typed policy-context projection that PEP/PDP integrations must use for passkey-first authentication plus KYC/CDD/EDD proofing, screening, consent, residency, retention, purpose, risk, and audit obligations. This artifact is contract/schema only and does not implement a PDP, API route, service handler, CLI, accreditation packet, or readiness claim.",
    "source_contracts": [
      {
        "path": "docs/decisions/ADR-0188-passkey-webauthn-substrate.md",
        "contract": "WebAuthn Level 3/passkeys are the primary phishing-resistant authentication credential; regulated packs require attestation/AAGUID posture; SMS and weak recovery factors are forbidden."
      },
      {
        "path": "docs/decisions/ADR-0189-step-up-authentication-acr-classes.md",
        "contract": "ACR classes routine/elevated/sensitive/critical govern step-up decisions and every ACR grant emits audit evidence."
      },
      {
        "path": "specs/regulatory-identity-source-of-truth.json",
        "contract": "Source rows and source blockers define KYC/CDD/EDD, NIST, KR, US, EU, PCI, and PQC/WebAuthn claim ceilings."
      },
      {
        "path": "specs/regulatory-identity-kyc-policy-evidence-architecture.json",
        "contract": "REGID-002 separates authentication, statutory proofing, Cedar policy decisions, tenant state, evidence packets, consent, retention, residency, and accreditation evidence."
      }
    ],
    "non_claims": [
      "WebAuthn/passkeys do not by themselves satisfy statutory KYC, CDD, EDD, KISA/KMCC designation, PCI, US CIP/CDD, EU AMLR/eIDAS/GDPR, or regulator/auditor acceptance requirements.",
      "Syncable multi-device passkeys are capped at AAL2-equivalent authentication assurance unless a later reviewed source proves a higher posture; AAL3/critical requires hardware-bound/phishing-resistant authenticator posture plus policy-specific approval evidence.",
      "WebAuthn Level 4, browser/vendor PQC timelines, and PQC authenticator support remain watchlist-only via REGGOV-SB-007 and are not implementation floors or readiness claims.",
      "No serving code, runtime PDP/service mutation, CLI, API handler, generated artifact, production policy bundle, or certification/readiness assertion is created by this artifact."
    ]
  },
  "claim_ceiling": {
    "claim_status": "planning_contract_only_no_kyc_or_runtime_readiness_claim",
    "allowed_claims": [
      "The contract names the policy-context keys and invariants that downstream KYC/PDP implementations must preserve.",
      "Representative fixtures illustrate allow/deny expectations for future validators and reviews."
    ],
    "forbidden_claims": [
      "Passkey/WebAuthn alone satisfies KYC, CDD, EDD, or statutory proofing.",
      "Syncable passkey equals AAL3 or critical authentication assurance without hardware-bound/FIDO-MDS3-L2+ evidence.",
      "This contract implements Cedar policies, proofing services, runtime enforcement, accreditation packet completeness, production readiness, or regulator acceptance."
    ],
    "open_source_blockers_ref": [
      "REGGOV-SB-001",
      "REGGOV-SB-002",
      "REGGOV-SB-003",
      "REGGOV-SB-004",
      "REGGOV-SB-005",
      "REGGOV-SB-006",
      "REGGOV-SB-007"
    ]
  },
  "contract_surface": {
    "canonical_projection": "AuthorizationRequest.context.regulatory_identity_policy_context",
    "pdp_boundary": "Use the existing PDP AuthorizationRequest context map and AuthorizationResponse obligations; do not create a parallel PDP contract.",
    "raw_data_boundary": "Policy context carries handles, ids, states, timestamps, and freshness; it must not carry raw government documents, biometrics, full identifiers, raw sanctions payloads, or secrets.",
    "freshness_rule": "Regulated allow decisions fail closed when proofing, screening, consent, residency, retention, policy bundle, or source rows are absent, stale, revoked, unresolved, or beyond expiry."
  },
  "context_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "tenant_id",
      "subject_ref",
      "action_slug",
      "requested_capability",
      "auth_state",
      "proofing_state",
      "due_diligence_state",
      "screening_state",
      "consent_state",
      "residency_state",
      "retention_state",
      "purpose_state",
      "risk_state",
      "pdp_audit_state"
    ],
    "properties": {
      "tenant_id": {
        "type": "string"
      },
      "subject_ref": {
        "type": "string",
        "description": "Opaque tenant-scoped subject or proofing-case handle; never a raw national id."
      },
      "action_slug": {
        "type": "string"
      },
      "requested_capability": {
        "type": "string"
      },
      "auth_state": {
        "type": "object",
        "required": [
          "passkey_auth_state",
          "acr",
          "acr_event_at",
          "credential_type",
          "webauthn_level_floor",
          "authenticator_assurance",
          "syncable_passkey_aal_ceiling",
          "critical_operation_approval"
        ],
        "properties": {
          "passkey_auth_state": {
            "enum": [
              "not_present",
              "authenticated",
              "step_up_required",
              "failed",
              "recovery_fallback"
            ]
          },
          "acr": {
            "enum": [
              "routine",
              "elevated",
              "sensitive",
              "critical"
            ]
          },
          "acr_event_at": {
            "type": "string",
            "format": "date-time"
          },
          "credential_type": {
            "enum": [
              "syncable_passkey",
              "device_bound_passkey",
              "hardware_security_key",
              "password_totp_recovery_only"
            ]
          },
          "webauthn_level_floor": {
            "const": "WebAuthn-Level-3"
          },
          "authenticator_assurance": {
            "type": "object",
            "required": [
              "attestation_level",
              "fido_mds_level",
              "aaguid_ref",
              "backup_eligible",
              "backup_state",
              "device_binding",
              "phishing_resistant"
            ],
            "properties": {
              "attestation_level": {
                "enum": [
                  "none",
                  "indirect",
                  "direct"
                ]
              },
              "fido_mds_level": {
                "enum": [
                  "unknown",
                  "L1",
                  "L2",
                  "L3"
                ]
              },
              "aaguid_ref": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "backup_eligible": {
                "type": "boolean"
              },
              "backup_state": {
                "type": "boolean"
              },
              "device_binding": {
                "enum": [
                  "syncable_multi_device",
                  "device_bound",
                  "hardware_bound"
                ]
              },
              "phishing_resistant": {
                "type": "boolean"
              }
            }
          },
          "syncable_passkey_aal_ceiling": {
            "enum": [
              "AAL2",
              "not_applicable"
            ]
          },
          "critical_operation_approval": {
            "type": "object",
            "description": "Explicit JIT/manual approval evidence required by ADR-0189 for critical actions; not a substitute for hardware-bound/FIDO-MDS3-L2+ authenticator posture.",
            "required": [
              "required",
              "approval_ref",
              "approval_window_state",
              "approved_at"
            ],
            "properties": {
              "required": {
                "type": "boolean"
              },
              "approval_ref": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Opaque JIT IT/compliance approval token or audit handle; never raw approver PII."
              },
              "approval_window_state": {
                "enum": [
                  "not_required",
                  "approved_in_window",
                  "missing",
                  "expired",
                  "denied"
                ]
              },
              "approved_at": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              }
            }
          }
        }
      },
      "proofing_state": {
        "type": "object",
        "required": [
          "tenant_kyc_status",
          "proofing_status",
          "proofing_tier",
          "evidence_refs",
          "source_control_row_ids",
          "freshness_state"
