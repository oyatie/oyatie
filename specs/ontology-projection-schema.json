{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.oyatie.com/specs/ontology-projection-schema.schema.json",
  "title": "Oyatie Ontology Projection Contract",
  "description": "Canonical machine-readable schema for ontology projection manifests in Oyatie. ADR-0316 requires every capability tier to bind object types, relation types, actions, functions, schema revision pins, field visibility, computed properties, jurisdiction filters, pack filters, audit redaction, export policy, search index scope, and lineage policy through a named projection. ADR-0317 extends that model through role-based projections and cache partitioning for the unified UX shell. This contract prevents product-specific object copies and makes projections reviewable, replayable, and auditable.",
  "version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "projection_id",
    "capability_tier_id",
    "tenant_id",
    "status",
    "adr_refs",
    "object_type_refs",
    "relation_type_refs",
    "action_refs",
    "function_refs",
    "schema_revision_pins",
    "field_visibility_rules",
    "computed_property_rules",
    "jurisdiction_filters",
    "pack_filters",
    "audit_redaction_rules",
    "export_policy_ref",
    "search_index_scope",
    "lineage_policy_ref",
    "service_ownership_guards",
    "role_projection_bindings",
    "cache_partition",
    "observability",
    "promotion_gates"
  ],
  "properties": {
    "projection_id": {
      "$ref": "#/definitions/projectionId",
      "description": "Stable ontology projection id. ADR-0316 Section D-2 requires projection_id in every projection manifest."
    },
    "capability_tier_id": {
      "$ref": "#/definitions/capabilityTierId",
      "description": "Capability tier that consumes this projection. ADR-0316 binds projections through capability tiers instead of product-specific forks."
    },
    "tenant_id": {
      "$ref": "#/definitions/tenantId",
      "description": "Tenant scope for materialization and enforcement. Tenant-scoped projections are required for cache partitioning and audit emission."
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "review",
        "preview",
        "active",
        "deprecated",
        "retired"
      ],
      "description": "Lifecycle status for this projection manifest."
    },
    "adr_refs": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/adrRef"
      },
      "description": "ADRs that authorize this projection. Expected references include ADR-0316 and ADR-0317."
    },
    "object_type_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/ontologyObjectRef"
      },
      "description": "Ontology object types exposed by the projection. ADR-0316 requires these references and forbids service-specific object copies outside projection rules."
    },
    "relation_type_refs": {
      "type": "array",
      "minItems": 0,
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/ontologyRelationRef"
      },
      "description": "Ontology relation types exposed by the projection, including relationship edges used by role and workflow surfaces."
    },
    "action_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/actionRef"
      },
      "description": "Cedar action refs allowed through the projection. Authorization remains in Cedar, not in the projection manifest."
    },
    "function_refs": {
      "type": "array",
      "minItems": 0,
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/functionRef"
      },
      "description": "Ontology functions exposed to workflows, analytics, or shell surfaces."
    },
    "schema_revision_pins": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/schemaRevisionPin"
      },
      "description": "Pinned schema revisions for object, relation, action, and function refs. ADR-0316 requires pins before projection activation."
    },
    "field_visibility_rules": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/fieldVisibilityRule"
      },
      "description": "Field-level visibility, redaction, and omission rules applied before data reaches workflow or UX surfaces."
    },
    "computed_property_rules": {
      "type": "array",
      "minItems": 0,
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/computedPropertyRule"
      },
      "description": "Computed properties made available by the projection without duplicating canonical source objects."
    },
    "jurisdiction_filters": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/jurisdictionFilter"
      },
      "description": "Jurisdiction filters applied before projection materialization. ADR-0316 calls out data-residency conflicts as a projection failure mode."
    },
    "pack_filters": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/packFilter"
      },
      "description": "Compliance pack filters and overlay ids that constrain projection visibility."
    },
    "audit_redaction_rules": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/auditRedactionRule"
      },
      "description": "Audit redaction rules for projection-state and projection-read events. ADR-0317 requires projection decisions, switches, redactions, and shell loads to emit audit context."
    },
    "export_policy_ref": {
      "$ref": "#/definitions/exportPolicyRef",
      "description": "Export policy applied when projection data leaves the live request path."
    },
    "search_index_scope": {
      "$ref": "#/definitions/searchIndexScope",
      "description": "Search indexing boundaries for projected fields and relations."
    },
    "lineage_policy_ref": {
      "$ref": "#/definitions/lineagePolicyRef",
      "description": "Lineage policy that preserves source object provenance for derived projection fields."
    },
    "service_ownership_guards": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/serviceOwnershipGuard"
      },
      "description": "Guards proving the projection does not move write ownership or create product-specific object copies outside ontology rules."
    },
    "role_projection_bindings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/roleProjectionBinding"
      },
      "description": "Role projection bindings from ADR-0317 used by the unified UX shell."
    },
    "cache_partition": {
      "$ref": "#/definitions/cachePartition",
      "description": "Cache partitioning inputs. ADR-0317 requires tenant_id and role_projection_id to prevent cross-role leakage."
    },
    "observability": {
      "$ref": "#/definitions/observability",
      "description": "Metrics, traces, logs, and audit dimensions emitted for projection operations."
    },
    "promotion_gates": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/promotionGate"
      },
      "description": "Required gates before projection activation."
    },
    "deprecation": {
      "$ref": "#/definitions/deprecationPlan",
      "description": "Optional successor and replay plan for retiring this projection."
    }
  },
  "definitions": {
    "projectionId": {
      "type": "string",
      "pattern": "^projection:[a-z0-9][a-z0-9-]{2,96}:v[0-9]+$",
      "examples": [
        "projection:sales-account-manager:v1",
        "projection:care-team-handoff:v1"
      ]
    },
    "capabilityTierId": {
      "type": "string",
      "pattern": "^capability-tier:[a-z0-9][a-z0-9-]{2,96}:v[0-9]+$"
    },
    "tenantId": {
      "type": "string",
      "pattern": "^tenant_[a-z0-9][a-z0-9_-]{2,96}$"
    },
    "adrRef": {
      "type": "string",
      "pattern": "^ADR-[0-9]{4}:[A-Za-z0-9 ._/-]+$",
      "minLength": 14,
      "maxLength": 160
    },
    "ontologyObjectRef": {
      "type": "string",
      "pattern": "^ontology://[a-z0-9./_-]+#[A-Za-z][A-Za-z0-9_]*$",
      "examples": [
        "ontology://crm/sales#Account",
        "ontology://health/core#PatientRecord"
      ]
    },
    "ontologyRelationRef": {
      "type": "string",
      "pattern": "^ontology://[a-z0-9./_-]+#[A-Za-z][A-Za-z0-9_]*->[A-Za-z][A-Za-z0-9_]*$",
      "examples": [
        "ontology://crm/sales#Account->Opportunity"
      ]
    },
    "actionRef": {
      "type": "string",
      "pattern": "^[A-Z][A-Za-z0-9]*::Action::\\\"[A-Z][A-Za-z0-9]+\\\"$"
    },
    "functionRef": {
      "type": "string",
      "pattern": "^ontology-function://[a-z0-9./_-]+#[a-z][A-Za-z0-9_]{2,80}$"
    },
    "schemaRevisionPin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "revision",
        "digest"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 8,
          "maxLength": 220
        },
        "revision": {
          "type": "string",
          "pattern": "^rev-[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-f0-9]{8,16}$"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "fieldVisibilityRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "object_type_ref",
        "field_path",
        "visibility",
        "reason"
      ],
      "properties": {
        "rule_id": {
          "type": "string",
          "pattern": "^field-rule:[a-z0-9][a-z0-9-]{2,96}$"
        },
        "object_type_ref": {
          "$ref": "#/definitions/ontologyObjectRef"
        },
        "field_path": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
        },
        "visibility": {
          "type": "string",
          "enum": [
            "visible",
            "redacted",
            "omitted",
            "derived-only",
            "break-glass-only"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 20,
          "maxLength": 500
        }
      }
    },
    "computedPropertyRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "property_id",
        "object_type_ref",
        "output_field",
        "function_ref",
        "lineage_inputs"
      ],
      "properties": {
        "property_id": {
          "type": "string",
          "pattern": "^computed-property:[a-z0-9][a-z0-9-]{2,96}$"
        },
        "object_type_ref": {
          "$ref": "#/definitions/ontologyObjectRef"
        },
        "output_field": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{1,80}$"
        },
        "function_ref": {
          "$ref": "#/definitions/functionRef"
        },
        "lineage_inputs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
          }
        }
      }
    },
    "jurisdictionFilter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filter_id",
        "jurisdictions",
        "residency_regions",
        "mode"
      ],
      "properties": {
        "filter_id": {
          "type": "string",
          "pattern": "^jurisdiction-filter:[a-z0-9][a-z0-9-]{2,96}$"
        },
        "jurisdictions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z]{2}(-[A-Z0-9]{1,3})?$"
          }
        },
        "residency_regions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z]{2}-[a-z]+-[0-9]+|sovereign-[a-z0-9-]{2,40}$"
          }
        },
        "mode": {
          "type": "string",
          "enum": [
            "allow-only",
            "deny-egress",
            "redact-on-crossing",
            "require-human-review"
          ]
        }
      }
    },
    "packFilter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filter_id",
        "overlay_ids",
        "conflict_strategy"
      ],
      "properties": {
        "filter_id": {
          "type": "string",
          "pattern": "^pack-filter:[a-z0-9][a-z0-9-]{2,96}$"
        },
        "overlay_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^overlay:[a-z0-9][a-z0-9-]{2,80}:v[0-9]+$"
          }
        },
        "conflict_strategy": {
          "type": "string",
          "enum": [
            "most-restrictive-wins",
            "deny-on-conflict",
            "forbid-on-conflict"
          ]
        }
      }
    },
    "auditRedactionRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "event_classes",
        "redacted_fields",
        "profile_ref"
      ],
      "properties": {
        "rule_id": {
          "type": "string",
          "pattern": "^audit-redaction-rule:[a-z0-9][a-z0-9-]{2,96}$"
        },
        "event_classes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Za-z0-9]{2,120}$"
          }
        },
        "redacted_fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
          }
        },
        "profile_ref": {
          "type": "string",
          "pattern": "^audit-redaction:[a-z0-9][a-z0-9-]{2,80}:v[0-9]+$"
        }
      }
    },
    "exportPolicyRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_id",
        "allowed_destinations",
        "review_required"
      ],
      "properties": {
        "policy_id": {
          "type": "string",
          "pattern": "^export-policy:[a-z0-9][a-z0-9-]{2,96}:v[0-9]+$"
        },
        "allowed_destinations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "same-tenant",
              "same-region",
              "approved-external-processor",
              "human-reviewed-export",
              "none"
            ]
          }
        },
        "review_required": {
          "type": "boolean"
        }
      }
    },
    "searchIndexScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index_scope_id",
        "indexable_fields",
        "excluded_fields",
        "partition_keys"
      ],
      "properties": {
        "index_scope_id": {
          "type": "string",
          "pattern": "^search-scope:[a-z0-9][a-z0-9-]{2,96}:v[0-9]+$"
        },
        "indexable_fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
          }
        },
        "excluded_fields": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
          }
        },
        "partition_keys": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{1,64}$"
          }
        }
      }
    },
    "lineagePolicyRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_id",
        "source_refs_required",
        "derived_field_lineage_required"
      ],
      "properties": {
        "policy_id": {
          "type": "string",
          "pattern": "^lineage-policy:[a-z0-9][a-z0-9-]{2,96}:v[0-9]+$"
        },
        "source_refs_required": {
          "type": "boolean",
          "const": true
        },
        "derived_field_lineage_required": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "serviceOwnershipGuard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "service",
        "object_type_ref",
        "write_owner",
        "projection_may_write"
      ],
      "properties": {
        "service": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,63}$"
        },
        "object_type_ref": {
          "$ref": "#/definitions/ontologyObjectRef"
        },
        "write_owner": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,63}$"
        },
        "projection_may_write": {
          "type": "boolean",
          "const": false
        }
      }
    },
    "roleProjectionBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role_projection_id",
        "role_ref",
        "permit_set_refs",
        "ux_shell_ref",
        "workflow_template_library_refs"
      ],
      "properties": {
        "role_projection_id": {
          "type": "string",
          "pattern": "^role-projection:[a-z0-9][a-z0-9-]{2,96}:v[0-9]+$"
        },
        "role_ref": {
          "type": "string",
          "pattern": "^role:[a-z0-9][a-z0-9-]{2,96}$"
        },
        "permit_set_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^permit-set:[a-z0-9][a-z0-9-]{2,80}:v[0-9]+$"
          }
        },
        "ux_shell_ref": {
          "type": "string",
          "pattern": "^ux-shell:[a-z0-9][a-z0-9-]{2,96}:v[0-9]+$"
        },
        "workflow_template_library_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^workflow-library:[a-z0-9][a-z0-9-]{2,96}:v[0-9]+$"
          }
        }
      }
    },
    "cachePartition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "keys",
        "ttl_seconds",
        "cross_role_reuse_allowed"
      ],
      "properties": {
        "keys": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "contains": {
            "const": "role_projection_id"
          },
          "items": {
            "type": "string",
            "enum": [
              "tenant_id",
              "sub_scope_path",
              "role_projection_id",
              "capability_tier_id",
              "jurisdiction_code",
              "pack_overlay_id"
            ]
          }
        },
        "ttl_seconds": {
          "type": "integer",
          "minimum": 5,
          "maximum": 3600
        },
        "cross_role_reuse_allowed": {
          "type": "boolean",
          "const": false
        }
      }
    },
    "observability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric_dimensions",
        "trace_attributes",
        "audit_event_classes"
      ],
      "properties": {
        "metric_dimensions": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{1,64}$"
          }
        },
        "trace_attributes": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{1,64}$"
          }
        },
        "audit_event_classes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Za-z0-9]{2,120}$"
          }
        }
      }
    },
    "promotionGate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate_id",
        "command",
        "evidence_ref"
      ],
      "properties": {
        "gate_id": {
          "type": "string",
          "pattern": "^ontology-projection-[a-z0-9-]{3,96}$"
        },
        "command": {
          "type": "string",
          "minLength": 6,
          "maxLength": 240
        },
        "evidence_ref": {
          "type": "string",
          "pattern": "^evidence://[a-z0-9./_-]+$"
        }
      }
    },
    "deprecationPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "successor_projection_id",
        "replay_gate",
        "sunset_at"
      ],
      "properties": {
        "successor_projection_id": {
          "$ref": "#/definitions/projectionId"
        },
        "replay_gate": {
          "type": "string",
          "pattern": "^oya-governance-[a-z0-9-]{3,96}$"
        },
        "sunset_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  },
  "examples": {
    "sales_account_manager_projection": {
      "projection_id": "projection:sales-account-manager:v1",
      "capability_tier_id": "capability-tier:sales-cloud-core:v1",
      "tenant_id": "tenant_acme_corp",
      "status": "active",
      "adr_refs": [
        "ADR-0316:Capability Tier Over Product Fragmentation",
        "ADR-0317:Role-Based Projection Unified UX Shell"
      ],
      "object_type_refs": [
        "ontology://crm/sales#Account",
        "ontology://crm/sales#Opportunity",
        "ontology://crm/sales#Contact"
      ],
      "relation_type_refs": [
        "ontology://crm/sales#Account->Opportunity"
      ],
      "action_refs": [
        "Sales::Action::\"ReadOpportunity\"",
        "Sales::Action::\"UpdateOpportunity\""
      ],
      "function_refs": [
        "ontology-function://crm/sales#calculateForecastAmount"
      ],
      "schema_revision_pins": [
        {
          "ref": "ontology://crm/sales#Opportunity",
          "revision": "rev-2026-05-20-a1b2c3d4",
          "digest": "sha256:1234567890abcdef1234567890abcdef1234567890abcdef1234567890abcdef"
        }
      ],
      "field_visibility_rules": [
        {
          "rule_id": "field-rule:sales-contact-email",
