{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.oyatie.com/specs/finops-cost-attribution.schema.json",
  "_meta": {
    "doc_class": "Machine-Readable-Spec",
    "spec_id": "EXE-FINOPS-COST-ATTRIBUTION",
    "version": "1.0.0",
    "status": "Accepted",
    "enforcement_status": "advisory-until-per-microservice-cost-center-declared",
    "owner_team": "ops-finops",
    "created_at": "2026-05-18T00:00:00Z",
    "binding_adr": "ADR-0174",
    "related_adrs": [
      "ADR-0198",
      "ADR-0199",
      "ADR-0314",
      "ADR-0315"
    ],
    "authority_boundary": {
      "accepted_authority": [
        "ADR-0174",
        "ADR-0198",
        "ADR-0199"
      ],
      "proposed_context_only": [
        "ADR-0314",
        "ADR-0315"
      ],
      "scope": "cost-model-contract-only; no product/cloud/runtime mutation and no ERP or marketplace settlement authority is claimed from Proposed ADRs"
    },
    "purpose": "Canonical FinOps cost-attribution tag block + FOCUS/OpenCost rollup + chargeback formula + cost-anomaly fixture contract.",
    "user_directive_2026_05_18": "Make per-tenant cost attribution and chargeback first-class."
  },
  "title": "FinOps cost-attribution canonical schema",
  "type": "object",
  "required": [
    "tag_block",
    "canonical_label_block",
    "focus_opencost_rollup",
    "chargeback_formula",
    "anomaly_thresholds",
    "anomaly_detector_fixtures",
    "karpenter_workload_class_cost_labels",
    "regulator_evidence_cadence",
    "claim_controls",
    "nonclaims"
  ],
  "properties": {
    "tag_block": {
      "type": "object",
      "description": "Tags every cloud resource MUST carry, applied at provision time by microservices/cloud-iac/.",
      "required": [
        "tenant_id",
        "cell_id",
        "microservice",
        "plane",
        "environment",
        "cost_center",
        "sustainability_class"
      ],
      "properties": {
        "tenant_id": {
          "type": "string",
          "format": "uuid"
        },
        "cell_id": {
          "type": "string",
          "format": "uuid"
        },
        "microservice": {
          "type": "string",
          "enum": [
            "anonymous",
            "application",
            "audit-chain",
            "calendar",
            "cell",
            "cloud-iac",
            "cloud-k8s",
            "cloud-secrets",
            "community",
            "connector",
            "drive",
            "forms",
            "foundry",
            "governance",
            "mail",
            "meet",
            "messenger",
            "network",
            "notes",
            "observability",
            "ontology",
            "recordings",
            "sheets",
            "shorts",
            "sites",
            "slides",
            "social",
            "tasks",
            "tenancy",
            "translate",
            "workflow-engine",
            "workflow-studio"
          ]
        },
        "plane": {
          "type": "string",
          "enum": [
            "control",
            "data",
            "analytics"
          ]
        },
        "environment": {
          "type": "string",
          "enum": [
            "dev",
            "staging",
            "production",
            "dr"
          ]
        },
        "cost_center": {
          "type": "string",
          "enum": [
            "cc-foundry-runtime",
            "cc-cloud-substrate",
            "cc-workspace-runtime",
            "cc-search-runtime",
            "cc-ads-runtime",
            "cc-saas-runtime",
            "cc-vertical-runtime",
            "cc-shared-infra",
            "cc-ops-internal",
            "cc-rd-internal",
            "cc-marketing-internal",
            "cc-gtm-internal"
          ]
        },
        "sustainability_class": {
          "type": "string",
          "enum": [
            "pue-gte-1-2",
            "pue-1-2-to-1-1",
            "pue-lt-1-1"
          ]
        }
      }
    },
    "canonical_label_block": {
      "type": "object",
      "description": "Canonical ADR-0199 label/tag contract shared by Kubernetes workloads, Karpenter nodes, cloud resources, FOCUS rows, OpenCost allocation keys, billing invoices, and audit evidence.",
      "required": [
        "kubernetes_labels",
        "cloud_resource_tags",
        "bounded_cardinality",
        "legacy_adr_0174_aliases"
      ],
      "properties": {
        "kubernetes_labels": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": [
              "key",
              "source",
              "required",
              "data_class"
            ],
            "properties": {
              "key": {
                "type": "string",
                "enum": [
                  "oya.io/tenant-id",
                  "oya.io/cost-center",
                  "oya.io/workload-class",
                  "oya.io/regulatory-pack"
                ]
              },
              "source": {
                "type": "string"
              },
              "required": {
                "const": true
              },
              "data_class": {
                "type": "string",
                "enum": [
                  "non_pii_ulid",
                  "closed_enum"
                ]
              }
            }
          },
          "default": [
            {
              "key": "oya.io/tenant-id",
              "source": "tenancy microservice ULID; use shared for platform-owned shared resources",
              "required": true,
              "data_class": "non_pii_ulid"
            },
            {
              "key": "oya.io/cost-center",
              "source": "microservice manifest cost_center closed enum",
              "required": true,
              "data_class": "closed_enum"
            },
            {
              "key": "oya.io/workload-class",
              "source": "ADR-0198/ADR-0199 workload class closed enum",
              "required": true,
              "data_class": "closed_enum"
            },
            {
              "key": "oya.io/regulatory-pack",
              "source": "microservice manifest or per-pack overlay; default generic",
              "required": true,
              "data_class": "closed_enum"
            }
          ]
        },
        "cloud_resource_tags": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "string",
            "enum": [
              "oya:tenant-id",
              "oya:cost-center",
              "oya:workload-class",
              "oya:regulatory-pack"
            ]
          },
          "default": [
            "oya:tenant-id",
            "oya:cost-center",
            "oya:workload-class",
            "oya:regulatory-pack"
          ]
        },
        "bounded_cardinality": {
          "type": "object",
          "properties": {
            "tenant_id": {
              "const": "bounded by active tenant count; no human-readable tenant names"
            },
            "cost_center": {
              "const": "closed enum"
            },
            "workload_class": {
              "const": "app|batch|gpu|regulatory"
            },
            "regulatory_pack": {
              "const": "closed regional/compliance pack enum with generic default"
            }
          }
        },
        "legacy_adr_0174_aliases": {
          "type": "object",
          "description": "Read compatibility mapping for older ADR-0174 tags; emitters use canonical ADR-0199 labels/tags above.",
          "properties": {
            "tenant_id": {
              "const": "oya.io/tenant-id"
            },
            "cost_center": {
              "const": "oya.io/cost-center"
            },
            "environment": {
              "const": "FOCUS ChargePeriod/ServiceCategory dimension, not a high-cardinality Kubernetes cost label"
            },
            "sustainability_class": {
              "const": "specs/finops-dimensional-model.json sustainability emission model dimension"
            }
          }
        }
      }
    },
    "chargeback_formula": {
      "type": "object",
      "description": "Formula components combined by oya-cloud-billing-domain::chargeback::compute_period().",
      "required": [
        "formula_text",
        "source_rollup_ref",
        "currency",
        "rounding",
        "labelled_spend",
        "capability_invocation",
        "audit_chain_emission",
        "storage",
        "credits"
      ],
      "properties": {
        "formula_text": {
          "const": "tenant_charge_period = sum(labelled_spend * tenant_allocation_ratio) + sum(capability_invocations * per_invocation_cost) + sum(audit_chain_rows * audit_chain_cost_per_row) + sum(storage_bytes * per_byte_storage_cost) - applicable_credits"
        },
        "source_rollup_ref": {
          "const": "focus_opencost_rollup"
        },
        "currency": {
          "const": "USD minor units"
        },
        "rounding": {
          "const": "round-half-even at final invoice line aggregation; never round intermediate FOCUS/OpenCost rows"
        },
        "labelled_spend": {
          "type": "object",
          "properties": {
            "allocation_strategy_dedicated_cell": {
              "const": 1.0
            },
            "allocation_strategy_shared_cell": {
              "type": "string",
              "enum": [
                "cpu-sec-share",
                "gb-hr-share",
                "request-count-share",
                "weighted-composite"
              ]
            }
          }
        },
        "capability_invocation": {
          "type": "object",
          "properties": {
            "source": {
              "const": "registry/capability-templates"
            },
            "field": {
              "const": "per_invocation_cost"
            }
          }
        },
        "audit_chain_emission": {
          "type": "object",
          "properties": {
            "cost_per_row_usd": {
              "type": "number",
              "minimum": 0
            },
            "review_cadence": {
              "const": "quarterly-by-ops-finops"
            }
          }
        },
        "storage": {
          "type": "object",
          "properties": {
            "source": {
              "const": "registry/data-class"
            },
            "field": {
              "const": "per_byte_storage_cost_by_class"
            }
          }
        },
        "credits": {
          "type": "object",
          "description": "Applied credits subtracted from total.",
          "properties": {
            "source": {
              "const": "tenant credit ledger"
            },
            "idempotency_key": {
              "const": "tenant_id + period + credit_id"
            }
          }
        }
      }
    },
    "anomaly_thresholds": {
      "type": "object",
      "required": [
        "cost_spike",
        "cost_creep",
        "tenant_budget_headroom",
        "tenant_budget_exhausted",
        "provider_cost_deviation"
      ],
      "properties": {
        "cost_spike": {
          "type": "object",
          "properties": {
            "trigger": {
              "const": "tenant_spend > 3*MAD over rolling 14-day baseline AND spend > $1000/hr"
            },
            "severity": {
              "const": "SEV-2"
            }
          }
        },
        "cost_creep": {
          "type": "object",
          "properties": {
            "trigger": {
              "const": "tenant_spend > 7-day rolling baseline by 25% sustained >= 24h"
            },
            "severity": {
              "const": "SEV-3"
            }
          }
        },
        "tenant_budget_headroom": {
          "type": "object",
          "properties": {
            "trigger": {
              "const": "tenant < 10% of monthly budget remaining"
            },
            "severity": {
              "const": "SEV-3"
            }
          }
        },
        "tenant_budget_exhausted": {
          "type": "object",
          "properties": {
            "trigger": {
              "const": "tenant has spent 100% of monthly budget"
            },
            "severity": {
              "const": "SEV-2"
            }
          }
        },
        "provider_cost_deviation": {
          "type": "object",
          "properties": {
            "trigger": {
              "const": "foundry provider per-invocation cost deviates > 50% from registered cost"
            },
            "severity": {
              "const": "SEV-2"
            }
          }
        }
      }
    },
    "focus_opencost_rollup": {
      "type": "object",
      "description": "FOCUS 1.3 normalization and OpenCost 1.110 allocation rollup contract for the FinOps portal; this is a schema-backed contract, not a live exporter/runtime claim.",
      "required": [
        "focus_version",
        "opencost_version",
        "aggregation_keys",
        "input_streams",
        "focus_columns",
        "output_dataset",
        "consumer_contracts"
      ],
      "properties": {
        "focus_version": {
          "const": "1.3"
        },
        "opencost_version": {
          "const": "1.110.0"
        },
        "aggregation_keys": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "string",
            "enum": [
              "oya.io/tenant-id",
              "oya.io/cost-center",
              "oya.io/workload-class",
              "oya.io/regulatory-pack"
            ]
          },
          "default": [
            "oya.io/tenant-id",
            "oya.io/cost-center",
            "oya.io/workload-class",
            "oya.io/regulatory-pack"
          ]
        },
        "input_streams": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "required": [
              "stream_id",
              "source",
              "claim_status"
            ],
            "properties": {
              "stream_id": {
                "type": "string"
              },
              "source": {
                "type": "string"
              },
              "claim_status": {
                "const": "contract_only"
              }
            }
          },
          "default": [
            {
              "stream_id": "opencost-kubernetes-allocation",
              "source": "OpenCost allocation metrics joined on canonical Kubernetes labels",
              "claim_status": "contract_only"
            },
            {
              "stream_id": "cloud-provider-billing-export",
              "source": "provider bill rows normalized by canonical cloud resource tags",
              "claim_status": "contract_only"
            },
            {
              "stream_id": "on-prem-rate-card",
              "source": "per-pack custom-pricing rate card for sovereign/on-prem cells",
              "claim_status": "contract_only"
            }
          ]
        },
        "focus_columns": {
          "type": "array",
          "minItems": 10,
          "items": {
            "type": "string"
          },
          "default": [
            "ChargePeriodStart",
            "ChargePeriodEnd",
            "ProviderName",
            "ServiceName",
            "SubAccountId",
            "ResourceId",
            "ConsumedQuantity",
            "ConsumedUnit",
            "EffectiveCost",
            "BillingCurrency",
            "Tags.oya.io/tenant-id",
            "Tags.oya.io/cost-center",
            "Tags.oya.io/workload-class",
            "Tags.oya.io/regulatory-pack"
          ]
        },
        "output_dataset": {
          "type": "object",
          "properties": {
            "bucket_template": {
              "const": "oya-finops-focus-export-shared-<env>"
            },
            "formats": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "parquet",
                  "csv"
                ]
              },
              "default": [
                "parquet",
                "csv"
              ]
            },
            "partition_keys": {
              "type": "array",
              "default": [
                "tenant_id",
                "period",
                "cell_id"
              ]
            }
          }
        },
        "consumer_contracts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "billing/finops-portal/contracts/focus-export-internal.asyncapi.yaml",
            "billing/finops-portal/contracts/tenant-invoice-public.openapi.yaml",
            "billing/finops-portal/contracts/cost-allocation-policy-internal.proto"
          ]
        }
      }
    },
    "anomaly_detector_fixtures": {
      "type": "array",
      "description": "Machine-checkable examples for the ADR-0174/ADR-0199 anomaly detector; fixtures pin detector class and severity without implementing the runtime detector.",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": [
          "fixture_id",
          "detector_class",
          "input_window",
          "expected_alert",
          "expected_severity"
        ],
        "properties": {
          "fixture_id": {
            "type": "string"
          },
          "detector_class": {
            "type": "string",
            "enum": [
              "cost-spike",
              "cost-creep",
              "tenant-budget-headroom",
              "tenant-budget-exhausted",
              "provider-cost-deviation"
            ]
          },
          "input_window": {
            "type": "object"
          },
          "expected_alert": {
            "const": true
          },
          "expected_severity": {
            "type": "string",
            "enum": [
              "SEV-2",
              "SEV-3"
            ]
          }
        }
      },
      "default": [
        {
          "fixture_id": "FINOPS-ANOM-cost-spike-mad-14d",
          "detector_class": "cost-spike",
          "input_window": {
            "baseline_days": 14,
            "mad_multiplier": 3,
            "hourly_spend_usd": 1250
          },
          "expected_alert": true,
          "expected_severity": "SEV-2"
        },
        {
          "fixture_id": "FINOPS-ANOM-cost-creep-24h",
          "detector_class": "cost-creep",
          "input_window": {
            "baseline_days": 7,
            "sustained_hours": 24,
            "increase_ratio": 1.25
          },
          "expected_alert": true,
          "expected_severity": "SEV-3"
        },
        {
          "fixture_id": "FINOPS-ANOM-budget-headroom-low",
          "detector_class": "tenant-budget-headroom",
          "input_window": {
            "budget_remaining_ratio": 0.09
          },
          "expected_alert": true,
          "expected_severity": "SEV-3"
        },
        {
          "fixture_id": "FINOPS-ANOM-budget-exhausted",
          "detector_class": "tenant-budget-exhausted",
          "input_window": {
            "budget_remaining_ratio": 0
          },
          "expected_alert": true,
          "expected_severity": "SEV-2"
        },
        {
          "fixture_id": "FINOPS-ANOM-provider-cost-deviation",
          "detector_class": "provider-cost-deviation",
          "input_window": {
            "registered_cost_usd": 0.02,
            "observed_cost_usd": 0.031,
            "deviation_ratio": 0.55
          },
          "expected_alert": true,
          "expected_severity": "SEV-2"
        }
      ]
    },
    "karpenter_workload_class_cost_labels": {
      "type": "array",
      "description": "ADR-0198 NodePool classes mapped to ADR-0199 `oya.io/workload-class` and OpenCost allocation dimensions.",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "nodepool",
          "workload_class_label",
          "cost_center_label",
          "capacity_policy",
          "opencost_dimension"
        ],
        "properties": {
          "nodepool": {
            "type": "string",
            "enum": [
              "app-tier",
              "batch-tier",
              "gpu-tier",
              "regulatory-tier"
            ]
          },
          "workload_class_label": {
            "type": "string",
            "enum": [
              "app",
              "batch",
              "gpu",
              "regulatory"
            ]
          },
          "cost_center_label": {
            "const": "cc-cloud-substrate"
          },
          "capacity_policy": {
            "type": "string"
          },
          "opencost_dimension": {
            "const": "label:oya.io/workload-class"
          }
        }
      },
      "default": [
        {
          "nodepool": "app-tier",
          "workload_class_label": "app",
          "cost_center_label": "cc-cloud-substrate",
          "capacity_policy": "on-demand-biased with spot allowed by consolidation policy",
          "opencost_dimension": "label:oya.io/workload-class"
        },
        {
          "nodepool": "batch-tier",
          "workload_class_label": "batch",
          "cost_center_label": "cc-cloud-substrate",
          "capacity_policy": "spot-only for interruption-tolerant batch workloads",
          "opencost_dimension": "label:oya.io/workload-class"
        },
        {
          "nodepool": "gpu-tier",
          "workload_class_label": "gpu",
          "cost_center_label": "cc-cloud-substrate",
          "capacity_policy": "on-demand-only for non-interruptible GPU workloads",
          "opencost_dimension": "label:oya.io/workload-class"
        },
        {
          "nodepool": "regulatory-tier",
          "workload_class_label": "regulatory",
          "cost_center_label": "cc-cloud-substrate",
          "capacity_policy": "on-demand-only and sovereign-region pinned by pack overlay",
          "opencost_dimension": "label:oya.io/workload-class"
        }
      ]
    },
    "claim_controls": {
      "type": "object",
      "properties": {
        "contract_only": {
          "const": true
        },
        "no_runtime_focus_export": {
          "const": true
        },
        "no_opencost_mimir_federation_runtime": {
          "const": true
        },
        "no_karpenter_nodepool_runtime_mutation": {
          "const": true
        },
        "no_product_cloud_mutation": {
          "const": true
        },
        "proposed_adr_context_only": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "ADR-0314",
              "ADR-0315"
            ]
          },
          "default": [
            "ADR-0314",
            "ADR-0315"
          ]
        }
      }
    },
    "nonclaims": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [
        "no live FOCUS export data generator",
        "no OpenCost exporter deployment or Mimir federation runtime",
        "no Karpenter Helm chart, NodePool, or cloud resource mutation",
        "no tenant invoice PDF renderer, tenant portal UI, or public FinOps dashboard runtime",
        "no ERP or marketplace settlement authority is claimed from Proposed ADR-0314/ADR-0315"
      ]
    },
    "regulator_evidence_cadence": {
      "type": "object",
      "properties": {
        "frequency": {
          "const": "quarterly"
        },
        "audit_chain_class": {
          "const": "FinOpsQuarterlyReport"
        },
        "signer_team_key": {
          "const": "ops-finops"
        },
        "consumers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "KR-CSAP",
            "EU-GAIA-X",
            "KSA-NDMO",
            "US-FedRAMP",
            "SOC-2"
          ]
        }
      }
    }
  }
}
