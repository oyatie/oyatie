{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.oyatie.com/schemas/artifact-profile-defaults.schema.json",
  "title": "ArtifactProfileDefaults",
  "description": "Profile defaults for the 9-capability artifact contract. Reduces per-row authoring burden: each registry row declares `artifact_profile` + optional overrides; validator merges profile-defaults with row-overrides to produce the resolved capability declaration. Closes architect r17 finding #8 (9-capability contract too heavy to author manually at scale).",
  "_meta": {
    "doc_class": "Machine-Readable-Schema",
    "schema_id": "EXE-ARTIFACT-PROFILE-DEFAULTS",
    "version": "1.1.0",
    "status": "draft-sidecar",
    "owner_team": "council-architecture + axis-foundry",
    "created_at": "2026-05-13T00:00:00Z",
    "user_directive_2026_05_13": "don't defer anything",
    "linus_critique_anchor": "architect r17 finding #8 — collapse 35KB/10-row boilerplate to profile + overrides; hyperscaler precedent K8s CRD + admission controllers + AWS Config managed-rules defaults",
    "merge_semantics": "Validator walks profiles[<row.artifact_profile>].capabilities then applies row.capability_overrides as a per-capability partial override. Override resolution rules: (a) capability.status override REPLACES profile default; (b) string fields (evidence_ref, validator path, generator path) override REPLACE profile default; (c) array fields (prerequisite_for_operational, blocks_on, verifies, validates) APPEND row-overrides to profile defaults unless override declares replace_mode=true.",
    "validator_crate": "governance/check/active-artifact-contract",
    "purpose": "Profile defaults for the 9-capability artifact contract. Reduces per-row authoring burden: each registry row declares `artifact_profile` + optional overrides.",
    "updated_at": "2026-05-17T12:57:05Z",
    "profile_contract_defaults_note": "Every profile default capability must satisfy the active R04-R07 contract shape: operational requires evidence_ref, planned/blocked-by-foundation require prerequisite_for_operational, and not-applicable requires not_applicable_rationale."
  },
