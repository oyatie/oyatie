    {
      "fragment_id": "pack-hipaa-2024-intelligence-llm-chat",
      "version": "2.1.0",
      "scope": "pack/HIPAA-2024",
      "effective_at": "2026-05-20T00:00:00Z",
      "sunset_at": null,
