{
  "$id": "https://docs.oyatie.com/specs/stage1-protected-facts.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Stage1ProtectedFacts",
  "description": "Closed future authenticated-producer envelope. Shape validation is non-authoritative until signature and trust-root verification are implemented externally.",
  "type": "object", "additionalProperties": false,
  "required": ["schema_id", "protected_base_repository", "candidate_repository", "protected_base_branch", "candidate_branch", "protected_base_commit", "candidate_commit", "protected_base_tree", "candidate_tree", "source_epoch_binding", "candidate_epoch_binding", "program_binding", "parser_binding", "producer_binding", "evaluator_binding", "policy_binding", "schema_binding", "predecessor_epoch_binding", "transition_receipt_binding", "immutable_successor_bundle", "authority_chain_result", "source_app_identity", "run_identity", "receipt_bindings", "envelope_signature", "trust_root_binding"],
  "properties": {
    "schema_id": {"const": "oyatie/stage1-protected-facts/v1"},
    "protected_base_repository": {"$ref": "#/$defs/nonempty"}, "candidate_repository": {"$ref": "#/$defs/nonempty"}, "protected_base_branch": {"$ref": "#/$defs/nonempty"}, "candidate_branch": {"$ref": "#/$defs/nonempty"},
    "protected_base_commit": {"$ref": "#/$defs/git_oid"}, "candidate_commit": {"$ref": "#/$defs/git_oid"}, "protected_base_tree": {"$ref": "#/$defs/git_oid"}, "candidate_tree": {"$ref": "#/$defs/git_oid"},
    "source_epoch_binding": {"$ref": "#/$defs/binding"}, "candidate_epoch_binding": {"$ref": "#/$defs/binding"}, "program_binding": {"$ref": "#/$defs/binding"}, "parser_binding": {"$ref": "#/$defs/binding"}, "producer_binding": {"$ref": "#/$defs/binding"}, "evaluator_binding": {"$ref": "#/$defs/binding"}, "policy_binding": {"$ref": "#/$defs/binding"}, "schema_binding": {"$ref": "#/$defs/binding"}, "predecessor_epoch_binding": {"$ref": "#/$defs/binding"}, "transition_receipt_binding": {"$ref": "#/$defs/binding"}, "immutable_successor_bundle": {"$ref": "#/$defs/binding"}, "authority_chain_result": {"$ref": "#/$defs/binding"}, "source_app_identity": {"$ref": "#/$defs/binding"}, "run_identity": {"$ref": "#/$defs/binding"}, "receipt_bindings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/authority_receipt_binding"}}, "envelope_signature": {"$ref": "#/$defs/binding"}, "trust_root_binding": {"$ref": "#/$defs/binding"},
    "extensions": {"type": "object", "propertyNames": {"pattern": "^x-stage1-non-authoritative-"}, "additionalProperties": true}
  },
  "$defs": {
    "nonempty": {"type": "string", "minLength": 1}, "git_oid": {"type": "string", "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"},
    "binding": {"type": "object", "additionalProperties": false, "required": ["path", "blob_oid", "sha256"], "properties": {"path": {"$ref": "#/$defs/nonempty"}, "blob_oid": {"$ref": "#/$defs/git_oid"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "authority_receipt_binding": {"type": "object", "additionalProperties": false, "required": ["role", "control_id", "principal_identity_binding", "issuer_authority_class", "authority_source_ref", "qualification", "jurisdiction_scope", "independence_observation", "subject_binding", "program_binding", "epoch_binding", "decision", "validity", "expiry", "revocation_status", "conflict_status", "signature_trust_root_binding", "path", "blob_oid", "sha256"], "properties": {"role": {"enum": ["machine-evidence", "qualified-human", "qualified-affected-party", "qualified-operations", "qualified-custody", "authorized-veto", "independent-council", "independent-dissent", "independent-oracle"]}, "control_id": {"pattern": "^C(0[1-9]|1[0-5])$", "type": "string"}, "principal_identity_binding": {"$ref": "#/$defs/binding"}, "issuer_authority_class": {"$ref": "#/$defs/nonempty"}, "authority_source_ref": {"$ref": "#/$defs/binding"}, "qualification": {"$ref": "#/$defs/binding"}, "jurisdiction_scope": {"$ref": "#/$defs/binding"}, "independence_observation": {"$ref": "#/$defs/binding"}, "subject_binding": {"$ref": "#/$defs/binding"}, "program_binding": {"$ref": "#/$defs/binding"}, "epoch_binding": {"$ref": "#/$defs/binding"}, "decision": {"enum": ["satisfied", "blocked", "abstained", "dissent"]}, "validity": {"$ref": "#/$defs/binding"}, "expiry": {"$ref": "#/$defs/binding"}, "revocation_status": {"$ref": "#/$defs/binding"}, "conflict_status": {"$ref": "#/$defs/binding"}, "signature_trust_root_binding": {"$ref": "#/$defs/binding"}, "path": {"$ref": "#/$defs/nonempty"}, "blob_oid": {"$ref": "#/$defs/git_oid"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "allOf": [{"if": {"properties": {"role": {"const": "machine-evidence"}}}, "then": {"properties": {"issuer_authority_class": {"const": "machine-verifiable"}}}}, {"if": {"properties": {"role": {"const": "qualified-human"}}}, "then": {"properties": {"issuer_authority_class": {"const": "qualified-human"}}}}]}
  }
}
