{
  "$id": "https://docs.oyatie.com/specs/cloud-ci-run-observability-packet.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "_meta": {
    "created_at": "2026-06-29T00:00:00Z",
    "doc_class": "Machine-Readable-Spec",
    "owner_team": "platform-toolchain + platform-governance",
    "purpose": "Canonical machine-readable cloud-ci run observability packet/status contract for the single required cloud-ci/oya-ci admission context. The legacy cloud/cloud-ci gate path consumes this spec while the stable contract lives under specs/.",
    "related_issue": "GH-1003",
    "status": "Accepted",
    "version": "1.0.0"
  },
  "additionalProperties": false,
  "description": "A run packet is the status API payload a trusted cloud-ci producer emits for every required-context run. A failed or INFRA-RED gate must be diagnosable from this packet and its typed artifacts without scraping GitHub Actions logs; passed packets must not invent failed-gate diagnostics.",
  "properties": {
    "artifacts": {
      "items": {
        "$ref": "#/$defs/artifact"
      },
      "minItems": 1,
      "type": "array"
    },
    "diagnosability": {
      "additionalProperties": false,
      "properties": {
        "actions_log_scrape_required": {
          "const": false,
          "description": "False means the packet carries typed diagnostics and artifact pointers sufficient for first diagnosis."
        },
        "artifact_refs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "diagnostic_refs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "primary_failed_gate_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ],
          "description": "Required for failed/infra_red packets; null for passed/cancelled packets."
        }
      },
      "required": [
        "actions_log_scrape_required",
        "primary_failed_gate_id",
        "artifact_refs",
        "diagnostic_refs"
      ],
      "type": "object"
    },
    "diagnostics": {
      "items": {
        "$ref": "#/$defs/diagnostic"
      },
      "type": "array"
    },
    "packet_id": {
      "description": "Stable packet id tied to run.provider, run.run_id, and run.attempt: cloud-ci-run-packet:<provider>:<run-id>:attempt-<n>.",
      "minLength": 1,
      "pattern": "^cloud-ci-run-packet:[A-Za-z0-9._-]+:[A-Za-z0-9._-]+:attempt-[0-9]+$",
      "type": "string"
    },
    "producer": {
      "additionalProperties": false,
      "properties": {
        "control_plane": {
          "enum": [
            "trusted-cloud-ci-controller",
            "github-actions-bridge"
          ]
        },
        "merge_authority_context": {
          "enum": [
            "cloud-ci-required",
            "oya-ci-required"
          ]
        },
        "required_context": {
          "enum": [
            "cloud-ci-required",
            "oya-ci-required"
          ]
        },
        "retired_evidence_authority": {
          "const": false
        },
        "workflow": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "required_context",
        "merge_authority_context",
        "control_plane",
        "workflow",
        "retired_evidence_authority"
      ],
      "type": "object"
    },
    "retention": {
      "additionalProperties": false,
      "properties": {
        "expires_at": {
          "format": "date-time",
          "type": "string"
        },
        "packet_ttl_days": {
          "minimum": 1,
          "type": "integer"
        },
        "pii_policy": {
          "additionalProperties": false,
          "properties": {
            "diagnostics_pii": {
              "enum": [
                "redacted-or-none"
              ]
            },
            "raw_log_storage": {
              "enum": [
                "not-a-status-api-dependency"
              ]
            },
            "redaction_required": {
              "const": true
            }
          },
          "required": [
            "redaction_required",
            "diagnostics_pii",
            "raw_log_storage"
          ],
          "type": "object"
        }
      },
      "required": [
        "packet_ttl_days",
        "expires_at",
        "pii_policy"
      ],
      "type": "object"
    },
    "run": {
      "additionalProperties": false,
      "properties": {
        "attempt": {
          "minimum": 1,
          "type": "integer"
        },
        "completed_at": {
          "format": "date-time",
          "type": "string"
        },
        "conclusion": {
          "enum": [
            "passed",
            "failed",
            "cancelled",
            "infra_red"
          ]
        },
        "provider": {
          "enum": [
            "github-actions",
            "owned-cloud-ci"
          ]
        },
        "run_id": {
          "minLength": 1,
          "type": "string"
        },
        "started_at": {
          "format": "date-time",
          "type": "string"
        },
        "status_context": {
          "enum": [
            "cloud-ci-required",
            "oya-ci-required"
          ]
        }
      },
      "required": [
        "run_id",
        "attempt",
        "provider",
        "status_context",
        "started_at",
        "completed_at",
        "conclusion"
      ],
      "type": "object"
    },
    "schema_version": {
      "const": "cloud-ci-run-observability-packet/v1"
    },
    "subject": {
      "additionalProperties": false,
      "properties": {
        "base_ref": {
          "minLength": 1,
          "type": "string"
        },
        "base_sha": {
          "$ref": "#/$defs/git_sha"
        },
        "head_ref": {
          "minLength": 1,
          "type": "string"
        },
        "head_sha": {
          "$ref": "#/$defs/git_sha"
        },
        "merge_base_sha": {
          "$ref": "#/$defs/git_sha"
        },
        "pr_number": {
          "minimum": 1,
          "type": "integer"
        },
        "repository": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "repository",
        "pr_number",
        "head_ref",
        "head_sha",
        "base_ref",
        "base_sha",
        "merge_base_sha"
      ],
      "type": "object"
    },
    "transitions": {
      "items": {
        "$ref": "#/$defs/transition"
      },
      "minItems": 3,
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "packet_id",
    "producer",
    "run",
    "subject",
    "transitions",
    "artifacts",
    "diagnostics",
    "retention",
    "diagnosability"
  ],
  "title": "CloudCiRunObservabilityPacket",
  "type": "object",
  "$defs": {
    "artifact": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "minLength": 1,
          "type": "string",
          "pattern": "^artifact:(gate-report|step-report|redacted-diagnostics|status-packet):[A-Za-z0-9._:-]+$",
          "description": "Stable artifact id: artifact:<kind>:<stable-run-or-gate-key>; status-packet artifacts use artifact:status-packet:<run_id>."
        },
        "digest_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "kind": {
          "enum": [
            "gate-report",
            "step-report",
            "redacted-diagnostics",
            "status-packet"
          ]
        },
        "retention": {
          "additionalProperties": false,
          "properties": {
            "contains_pii": {
              "type": "boolean"
            },
            "expires_at": {
              "format": "date-time",
              "type": "string"
            },
            "pii_classes": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "policy": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "policy",
            "expires_at",
            "contains_pii",
            "pii_classes"
          ],
          "type": "object"
        },
        "uri": {
          "description": "Typed artifact pointer; not a GitHub Actions job log URL.",
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "uri",
        "digest_sha256",
        "retention"
      ],
      "type": "object"
    },
    "diagnostic": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "minLength": 1,
          "type": "string"
        },
        "diagnostic_id": {
          "minLength": 1,
          "type": "string",
          "pattern": "^diag:[A-Za-z0-9._-]+:[A-Za-z0-9._-]+$",
          "description": "Stable diagnostic id tied to gate_id: diag:<gate_id>:<stable-diagnostic-key>."
        },
        "gate_id": {
          "minLength": 1,
          "type": "string"
        },
        "message_redacted": {
          "minLength": 1,
          "type": "string"
        },
        "redaction": {
          "additionalProperties": false,
          "properties": {
            "applied": {
              "const": true
            },
            "redacted_fields": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "applied",
            "redacted_fields"
          ],
          "type": "object"
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "error"
          ]
        }
      },
      "required": [
        "diagnostic_id",
        "gate_id",
        "severity",
        "code",
        "message_redacted",
        "redaction"
      ],
      "type": "object"
    },
    "failure": {
      "additionalProperties": false,
      "properties": {
        "artifact_refs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "code": {
          "minLength": 1,
          "type": "string"
        },
        "diagnostic_refs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "remediation": {
          "minLength": 1,
          "type": "string"
        },
        "summary": {
          "minLength": 1,
          "type": "string"
        },
        "taxonomy": {
          "enum": [
            "code_regression",
            "policy_violation",
            "infra_red",
            "operator_waiver_required",
            "cancelled",
            "flake_suspected"
          ]
        }
      },
      "required": [
        "taxonomy",
        "code",
        "summary",
        "remediation",
        "artifact_refs",
        "diagnostic_refs"
      ],
      "type": "object"
    },
    "git_sha": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "transition": {
      "additionalProperties": false,
      "properties": {
        "at": {
          "format": "date-time",
          "type": "string"
        },
        "duration_ms": {
          "minimum": 0,
          "type": "integer"
        },
        "failure": {
          "$ref": "#/$defs/failure"
        },
        "gate_id": {
          "type": "string"
        },
        "state": {
          "enum": [
            "queued",
            "running",
            "passed",
            "failed",
            "skipped",
            "infra_red",
            "waived"
          ]
        },
        "step_id": {
          "type": "string"
        },
        "transition_id": {
          "minLength": 1,
          "type": "string",
          "pattern": "^(run|gate|step):[A-Za-z0-9._:-]+$",
          "description": "Stable transition id derived from run/gate/step fields: run:<run_id>:<state>, gate:<gate_id>:<state>, or step:<gate_id>:<step_id>:<state>."
        },
        "transition_type": {
          "enum": [
            "run",
            "gate",
            "step"
          ]
        }
      },
      "required": [
        "transition_id",
        "transition_type",
        "state",
        "at",
        "duration_ms"
      ],
      "type": "object"
    }
  },
  "allOf": [
    {
      "oneOf": [
        {
          "properties": {
            "producer": {
              "properties": {
                "required_context": {
                  "const": "cloud-ci-required"
                },
                "merge_authority_context": {
                  "const": "cloud-ci-required"
                }
              }
            },
            "run": {
              "properties": {
                "status_context": {
                  "const": "cloud-ci-required"
                }
              }
            }
          }
        },
        {
          "properties": {
            "producer": {
              "properties": {
                "required_context": {
                  "const": "oya-ci-required"
                },
                "merge_authority_context": {
                  "const": "oya-ci-required"
                }
              }
            },
            "run": {
              "properties": {
                "status_context": {
                  "const": "oya-ci-required"
                }
              }
            }
          }
        }
      ]
    },
    {
      "if": {
        "properties": {
          "run": {
            "properties": {
              "conclusion": {
                "enum": [
                  "failed",
                  "infra_red"
                ]
              }
            },
            "required": [
              "conclusion"
            ]
          }
        },
        "required": [
          "run"
        ]
      },
      "then": {
        "properties": {
          "diagnostics": {
            "minItems": 1
          },
          "diagnosability": {
            "properties": {
              "primary_failed_gate_id": {
                "type": "string",
                "minLength": 1
              },
              "artifact_refs": {
                "minItems": 1
              },
              "diagnostic_refs": {
                "minItems": 1
              }
            }
          }
        }
      }
    }
  ]
}
