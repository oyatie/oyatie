{
  "$schema": "https://oyatie.local/schemas/workspace-hygiene.schema.json",
  "schema_version": "1.0.0",
  "id": "workspace-hygiene",
  "status": "accepted-automated-gate",
  "purpose": "Inventory-by-default hygiene pass for agent-created spillover across temp space, user-home coordination files, the main checkout, build artifacts, and Oyatie worktrees before pipeline closeout.",
  "authority_refs": [
    "docs/AGENTS.md",
    "docs/decisions/ADR-0709-general-live-apex.md",
    "docs/decisions/ADR-0700-ci-admission-live-apex.md",
    "specs/hyperscaler-gates.json"
  ],
  "gate": {
    "command": "oya gate validate workspace-hygiene",
    "default_mode": "audit",
    "strict_mode": "release_or_hyperscaler_claim",
    "cleanup_commands": [
      "oya gate validate workspace-hygiene --clean-build-artifacts",
      "oya gate validate workspace-hygiene --clean-temp-artifacts"
    ],
    "side_effect_policy": "inventory_by_default_cleanup_requires_explicit_flag",
    "evidence_path_template": "evidence/workspace-hygiene/{change_id}.json"
  },
  "required_scan_surfaces": [
    "tmp",
    "home",
    "repo",
    "repo-runtime-state",
    "build-artifacts",
    "oyatie-worktrees"
  ],
  "external_inventory_targets": [
    {
      "id": "tmp",
      "runtime_roots": [
        "/tmp",
        "/private/tmp"
      ],
      "ci_policy": "Runtime cleanup may target host temp roots through an explicit override policy; the canonical repository policy stays repo-relative for deterministic CI."
    },
    {
      "id": "home",
      "runtime_roots": [
        "$HOME"
      ],
      "ci_policy": "Home-root inventory is an operator/session-close target, not a default CI scan root."
    },
    {
      "id": "oyatie-worktrees",
      "runtime_roots": [
        "$HOME/oyatie-worktrees"
      ],
      "ci_policy": "Worktree lifecycle cleanup is tracked as owned runtime inventory and injected by session tooling when that root exists."
    }
  ],
  "scan_surfaces": [
    {
      "id": "tmp",
      "roots": [
        ".hygiene/tmp"
      ],
      "missing_ok": true,
      "max_depth": 1,
      "match_globs": [
        "oya*",
        "oyatie*",
        "*pipeline*",
        "*m-cc*"
      ],
      "audit_finding_budget": 10000,
      "strict_finding_budget": 0,
      "cleanup_globs": [
        "oya*",
        "oyatie*",
        "*pipeline*",
        "*m-cc*"
      ],
      "action": "cleanable_temp_artifacts"
    },
    {
      "id": "home",
      "roots": [
        ".hygiene/home"
      ],
      "missing_ok": true,
      "max_depth": 1,
      "match_globs": [
        "oya*",
        "oyatie*",
        "*pipeline*",
        "*m-cc*"
      ],
      "exempt_globs": [
        "kernel",
        "oyadb",
        "oyatie",
        "oyatie-worktrees"
      ],
      "exemption_evidence_refs": [
        "docs/AGENTS.md#project-doc",
        "docs/decisions/ADR-0709-general-live-apex.md"
      ],
      "audit_finding_budget": 500,
      "strict_finding_budget": 0,
      "action": "inventory_only"
    },
    {
      "id": "repo",
      "roots": [
        "."
      ],
      "missing_ok": false,
      "max_depth": 1,
      "match_globs": [
        "target-*",
        "*.log",
        "*.out",
        "*.err",
        "*pipeline*"
      ],
      "audit_finding_budget": 500,
      "strict_finding_budget": 0,
      "action": "inventory_only"
    },
    {
      "id": "repo-runtime-state",
      "roots": [
        "."
      ],
      "missing_ok": false,
      "max_depth": 2,
      "match_globs": [
        ".omx/context",
        ".omx/logs",
        ".omc",
        ".cargo"
      ],
      "exempt_globs": [
        ".omx/ultragoal/**"
      ],
      "audit_finding_budget": 500,
      "strict_finding_budget": 0,
      "action": "inventory_only",
      "exemption_evidence_refs": [
        "docs/AGENTS.md#state_management",
        "evidence/wave-d-g003-g006/g003/runtime-state-classification.md"
      ]
    },
    {
      "id": "build-artifacts",
      "roots": [
        "."
      ],
      "missing_ok": true,
      "max_depth": 2,
      "match_globs": [
        "target",
        "buck-out",
        "target-*",
        "dist",
        "build",
        ".next",
        ".turbo",
        ".vite",
        "coverage",
        "lcov.info",
        "*.profraw",
        "*.profdata"
      ],
      "cleanup_globs": [
        "target",
        "buck-out",
        "target-*",
        "dist",
        ".next",
        ".turbo",
        ".vite",
        "coverage",
        "lcov.info",
        "*.profraw",
        "*.profdata"
      ],
      "audit_finding_budget": 1000,
      "strict_finding_budget": 0,
      "action": "cleanable_build_artifacts"
    },
    {
      "id": "oyatie-worktrees",
      "roots": [
        ".hygiene/oyatie-worktrees"
      ],
      "missing_ok": true,
      "max_depth": 1,
      "match_globs": [
        "*"
      ],
      "exempt_globs": [
        "*"
      ],
      "exemption_evidence_refs": [
        "docs/AGENTS.md#scaffold_protocol",
        "docs/decisions/ADR-0709-general-live-apex.md"
      ],
      "audit_finding_budget": 500,
      "strict_finding_budget": 0,
      "action": "inventory_only"
    }
  ],
  "hygiene_classes": [
    {
      "id": "temp_artifact_sprawl",
      "description": "Transient logs, copied metadata, generated review bodies, and scratch binaries left under /tmp or /private/tmp."
    },
    {
      "id": "home_coordination_spillover",
      "description": "Oyatie or Oya coordination files placed at the user-home root rather than a tracked evidence, memory, or worktree location."
    },
    {
      "id": "repo_root_ephemeral_artifacts",
      "description": "Root-level scratch targets, logs, or generated outputs that should be ignored, moved into evidence, or cleaned after closeout."
    },
    {
      "id": "repo_runtime_state_inventory",
      "description": "Repository-local runtime state roots such as .omx context/logs, .omc metadata, and tool configuration caches that should be inventoried before closeout without deleting leader-owned goal state."
    },
    {
      "id": "build_artifact_residue",
      "description": "Compiled targets, frontend build outputs, caches, coverage files, and profiler outputs that should be cleaned or explicitly exempted before release closeout."
    },
    {
      "id": "worktree_lifecycle_debt",
      "description": "Worktrees that need owner, branch, PR, and disposition accounting before a pipeline can be called clean."
    }
  ],
  "pipeline_contract": {
    "required_phases": [
      "session-start",
      "pre-pr",
      "post-merge",
      "session-close"
    ],
    "minimum_actions": [
      "inventory_all_required_scan_surfaces",
      "classify_findings_by_hygiene_class",
      "classify_build_artifacts_by_cleanup_or_exemption",
      "clean_configured_build_artifacts_with_explicit_cleanup_flag",
      "clean_configured_temp_artifacts_with_explicit_cleanup_flag",
      "classify_owned_roots_by_exemption_evidence",
      "link_each_keep_item_to_owner_or_evidence",
      "strict_mode_zero_untriaged_findings_before_release_or_hyperscaler_claim"
    ]
  }
}
