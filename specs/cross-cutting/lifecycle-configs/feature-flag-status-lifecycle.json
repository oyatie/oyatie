{
  "name": "feature-flag-status",
  "version": 1,
  "stages": [
    { "id": "proposed", "terminal": false, "requires_supersession_edge": false },
    { "id": "live", "terminal": false, "requires_supersession_edge": false },
    { "id": "ramped", "terminal": false, "requires_supersession_edge": false },
    { "id": "deprecated", "terminal": false, "requires_supersession_edge": false },
    { "id": "removed", "terminal": true, "requires_supersession_edge": false }
  ],
  "transitions": [
    { "from": "proposed", "to": "live" },
    { "from": "live", "to": "ramped" },
    { "from": "ramped", "to": "deprecated" },
    { "from": "deprecated", "to": "removed" },
    { "from": "live", "to": "removed" }
  ],
  "sources": [
    {
      "kind": "yaml_front_matter",
      "glob": "docs/feature-flags/**/*.md",
      "stage_field": "status",
      "supersession_field": null,
      "deadline_field": "removal_deadline",
      "milestone_field": "ramp_milestone_anchor"
    }
  ],
  "defaults": {
    "wave": "A",
    "case_insensitive_stage_match": true
  }
}
