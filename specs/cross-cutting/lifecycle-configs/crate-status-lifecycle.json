{
  "name": "crate-status",
  "version": 1,
  "stages": [
    {
      "id": "scaffolded",
      "terminal": false,
      "requires_supersession_edge": false
    },
    {
      "id": "live",
      "terminal": false,
      "requires_supersession_edge": false
    },
    {
      "id": "quiescent",
      "terminal": false,
      "requires_supersession_edge": false
    },
    {
      "id": "archived",
      "terminal": true,
      "requires_supersession_edge": false
    }
  ],
  "transitions": [
    {
      "from": "scaffolded",
      "to": "live"
    },
    {
      "from": "live",
      "to": "quiescent"
    },
    {
      "from": "quiescent",
      "to": "live"
    },
    {
      "from": "quiescent",
      "to": "archived"
    },
    {
      "from": "live",
      "to": "archived"
    }
  ],
  "sources": [
    {
      "kind": "cargo_metadata_table",
      "glob": "crates/*-domain/Cargo.toml",
      "stage_field": "package.metadata.oyatie.lifecycle_stage",
      "supersession_field": null,
      "deadline_field": "package.metadata.oyatie.lifecycle_deadline",
      "milestone_field": "package.metadata.oyatie.lifecycle_milestone_anchor"
    }
  ],
  "defaults": {
    "wave": "C",
    "case_insensitive_stage_match": true
  },
  "purpose": "Lifecycle state machine for workspace crate maturity, quiescence, and archival status."
}
