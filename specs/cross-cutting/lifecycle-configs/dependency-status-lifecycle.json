{
  "name": "dependency-status",
  "version": 1,
  "stages": [
    {
      "id": "added",
      "terminal": false,
      "requires_supersession_edge": false
    },
    {
      "id": "in-use",
      "terminal": false,
      "requires_supersession_edge": false
    },
    {
      "id": "deprecated",
      "terminal": false,
      "requires_supersession_edge": true
    },
    {
      "id": "removed",
      "terminal": true,
      "requires_supersession_edge": false
    }
  ],
  "transitions": [
    {
      "from": "added",
      "to": "in-use"
    },
    {
      "from": "in-use",
      "to": "deprecated"
    },
    {
      "from": "deprecated",
      "to": "removed"
    },
    {
      "from": "in-use",
      "to": "removed"
    }
  ],
  "sources": [
    {
      "kind": "yaml_front_matter",
      "glob": "docs/dependencies/**/*.md",
      "stage_field": "status",
      "supersession_field": "replaced_by",
      "deadline_field": "removal_deadline",
      "milestone_field": null
    }
  ],
  "defaults": {
    "wave": "B",
    "case_insensitive_stage_match": true
  },
  "purpose": "Lifecycle state machine for external dependency adoption, deprecation, and removal."
}
