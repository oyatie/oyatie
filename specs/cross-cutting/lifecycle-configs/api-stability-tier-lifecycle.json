{
  "name": "api-stability-tier",
  "version": 1,
  "stages": [
    {
      "id": "experimental",
      "terminal": false,
      "requires_supersession_edge": false
    },
    {
      "id": "stable",
      "terminal": false,
      "requires_supersession_edge": false
    },
    {
      "id": "deprecated",
      "terminal": false,
      "requires_supersession_edge": true
    },
    {
      "id": "removed",
      "terminal": true,
      "requires_supersession_edge": false
    }
  ],
  "transitions": [
    {
      "from": "experimental",
      "to": "stable"
    },
    {
      "from": "experimental",
      "to": "removed"
    },
    {
      "from": "stable",
      "to": "deprecated"
    },
    {
      "from": "deprecated",
      "to": "removed"
    }
  ],
  "sources": [
    {
      "kind": "yaml_front_matter",
      "glob": "docs/api-stability/**/*.md",
      "stage_field": "stability_tier",
      "supersession_field": "replaced_by_api",
      "deadline_field": "removal_deadline",
      "milestone_field": null
    }
  ],
  "defaults": {
    "wave": "C",
    "case_insensitive_stage_match": true
  },
  "purpose": "Lifecycle state machine for API stability tier transitions from experimental through removal."
}
