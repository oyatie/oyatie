{
  "name": "migration-status",
  "version": 1,
  "stages": [
    {
      "id": "pre-cutover",
      "terminal": false,
      "requires_supersession_edge": false
    },
    {
      "id": "in-cutover",
      "terminal": false,
      "requires_supersession_edge": false
    },
    {
      "id": "cleanup",
      "terminal": false,
      "requires_supersession_edge": false
    },
    {
      "id": "done",
      "terminal": true,
      "requires_supersession_edge": false
    }
  ],
  "transitions": [
    {
      "from": "pre-cutover",
      "to": "in-cutover"
    },
    {
      "from": "in-cutover",
      "to": "cleanup"
    },
    {
      "from": "cleanup",
      "to": "done"
    }
  ],
  "sources": [
    {
      "kind": "yaml_front_matter",
      "glob": ".omc/plans/milestones/**/*.md",
      "stage_field": "migration_status",
      "supersession_field": null,
      "deadline_field": "migration_deadline",
      "milestone_field": "migration_milestone_anchor",
      "filter": {
        "_doc": "In-scope predicate per ADR-0109 canonical sub-rule: migration-status applies ONLY to plan files that are themselves migrations (kind: migration in front-matter OR filename/path containing migration|cutover|rename|rewrite). Per feedback_no_exceptions_canonical: this is a canonical extension narrowing scope, not an exception clause exempting items.",
        "kind_field": "kind",
        "kind_value": "migration",
        "filename_contains_any": [
          "migration",
          "cutover",
          "rename",
          "rewrite"
        ]
      }
    }
  ],
  "defaults": {
    "wave": "B",
    "case_insensitive_stage_match": true
  },
  "purpose": "Lifecycle state machine for migration plans moving through cutover, cleanup, and completion."
}
