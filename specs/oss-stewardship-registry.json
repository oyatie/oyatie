{
  "_schema": {
    "version": "1.0.0",
    "description": "Canonical OSS stewardship registry per ADR-0345. Enumerates every direct upstream OSS dependency Oyatie consumes with stewardship class (maintainer | contributor | consumer), owner team, CVE-response SLA, resourcing commitment, license, source URL, and ADR provenance. The corpus-wide registry is the canonical aggregate; per-microservice manifest.json#consumes_upstream_oss references entries by dep_name.",
    "stewardship_class_enum": [
      "maintainer",
      "contributor",
      "consumer"
    ],
    "stewardship_class_definitions": {
      "maintainer": "Oyatie has commit + release authority on the upstream. Examples: every oya-* crate; intelligence-shuffle-sharding; oya-dev-cli; oya-shared-policy-engine-client; internal hooks + tools.",
      "contributor": "Oyatie actively patches upstream + commits staff time. CVE-response SLA: P0 patch within 7 days; P1 patch within 30 days.",
      "consumer": "Oyatie pins + audits without upstream contribution. CVE-response SLA: P0 patch upstream-monitored; pin update within 14 days of public CVE disclosure."
    },
    "per_entry_fields": {
      "dep_name": "canonical upstream identifier; matches Cargo.toml / Helm chart / OpenTofu provider name where applicable; unique across registry",
      "stewardship_class": "one of {maintainer, contributor, consumer}",
      "owner_team": "council / axis / ops taxonomy identifier",
      "secondary_owner_teams": "optional array; additional teams sharing accountability",
      "cve_sla_p0_days": "contributor-only; required when class=contributor (typically 7)",
      "cve_sla_p1_days": "contributor-only; required when class=contributor (typically 30)",
      "cve_sla_pin_update_days": "consumer-only; required when class=consumer (typically 14)",
      "contribution_budget_dev_days_per_quarter": "contributor-only; integer dev-days committed per quarter",
      "maintainer_engineering_time_percent": "maintainer-only; integer percent (0..100) of one FTE committed per crate per rolling quarter",
      "audit_subscription_cost_usd": "consumer-only; integer USD/year",
      "license": "SPDX identifier; must NOT contradict forbidden-license list at docs/standards/dependency-policy.md §2",
      "source_url": "upstream source URL",
      "adr_provenance": "array of ADR identifiers justifying the dependency inclusion",
      "mitigation_strategies": "array drawn from {upstream_patch, downstream_fork_patch, config_mitigation, dependency_replacement, sunset_and_retirement}",
      "first_added_adr": "ADR identifier that originally added the upstream",
      "last_class_change_adr": "most recent ADR that changed the stewardship_class; ADR-0345 for entries added by this ADR",
      "notes": "bespoke prose per ADR-0322 substance-bar; template-stamping refused per ADR-0324"
    },
    "validation_check": "json-valid + every entry has stewardship_class in enum + per-class-required-fields populated + license not in forbidden-license list + owner_team in council/axis/ops taxonomy",
    "authoring_authority": "ADR-0345 (this ADR)",
    "enforcement_lanes": [
      "oya-check-oss-stewardship-registry-presence",
      "oya-check-oss-stewardship-class-declaration",
      "oya-check-oss-stewardship-cve-sla",
      "oya-check-oss-stewardship-owner-team",
      "oya-check-oss-stewardship-resourcing-declaration",
      "oya-check-oss-stewardship-license-cross-check",
      "oya-governance-stewardship-class-vocabulary",
      "oya-check-oss-stewardship-adr-provenance"
    ]
  },
  "_metadata": {
    "registry_id": "OSS-STEWARDSHIP-REGISTRY",
    "status": "proposed-pending-adr-0345-acceptance",
    "version": "1.0.0",
    "last_updated": "2026-05-21",
    "owners": [
      "council-architecture",
      "council-security",
      "council-legal",
      "ops-supply-chain",
      "axis-compliance",
      "ops-platform"
    ],
    "terminology_binding": "OSS stewardship uses 'class' (relationship label), NOT 'tier'. The word 'tier' is reserved exclusively for ADR-0248 cellular tiers (Tier 0..4) and ADR-0338 pod runtime tiers (Tier 0..3). Vocabulary discipline enforced day-1 by oya-governance-stewardship-class-vocabulary lane.",
    "completeness_note": "Maintainer-class enumeration at landing time is REPRESENTATIVE (key oya-* crates by category); Wave 15X-OSS-stewardship completes the per-crate enumeration across ~200+ oya-* crates via Cargo workspace introspection + per-crate manifest authoring. Contributor + Consumer enumerations are FLOOR-COMPLETE per ADR-0345 §D-4 + §D-5.",
    "out_of_scope": "Transitive dependencies (covered by cargo-vet + cargo-deny + cargo-audit per dependency-policy §3); Bominal-corpus parallel registry (authored independently per feedback_bominal_inheritance_precedence)."
  },
