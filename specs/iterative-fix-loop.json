{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.oyatie.dev/specs/iterative-fix-loop.json",
  "title": "IterativeFixLoop",
  "description": "Protocol for the find \u2192 fix \u2192 re-review cycle invoked by the pre-PR multispectrum checklist. Defines the loop state machine, termination conditions, and the bounded depth of iterations before escalating to human review.",
  "_meta": {
    "doc_class": "Machine-Readable-Spec",
    "spec_id": "EXE-ITERATIVE-FIX-LOOP",
    "version": "1.0.0",
    "status": "Accepted",
    "owner_team": "council-architecture",
    "created_at": "2026-05-14T00:00:00Z",
    "human_companion": "/templates/checklists/pre-pr-multispectrum.md",
    "enforced_by": [
      "oya-check-dependency-seam (sub-check: iterative-loop-evidence)",
      "pre-PR checklist (manual sign-off on loop completion)"
    ],
    "related_specs": [
      "/specs/multispectrum-review.json"
    ],
    "purpose": "Protocol for the find → fix → re-review cycle invoked by the pre-PR multispectrum checklist. Defines the loop state machine, termination conditions, and the bounded depth of iterations before escalating to human review."
  },
  "loop_state_machine": {
    "states": [
      "initial-review",
      "facet-red",
      "applying-fix",
      "re-running-verification",
      "re-evaluating-facet",
      "all-facets-green",
      "human-escalation-required"
    ],
    "transitions": [
      {
        "from": "initial-review",
        "trigger": "any facet RED",
        "to": "facet-red"
      },
      {
        "from": "initial-review",
        "trigger": "all facets GREEN",
        "to": "all-facets-green"
      },
      {
        "from": "facet-red",
        "trigger": "pick highest-severity RED",
        "to": "applying-fix"
      },
      {
        "from": "applying-fix",
        "trigger": "fix applied",
        "to": "re-running-verification"
      },
      {
        "from": "re-running-verification",
        "trigger": "test/lane exits 0",
        "to": "re-evaluating-facet"
      },
      {
        "from": "re-running-verification",
        "trigger": "test/lane exits nonzero",
        "to": "applying-fix"
      },
      {
        "from": "re-evaluating-facet",
        "trigger": "facet now GREEN, others RED",
        "to": "facet-red"
      },
      {
        "from": "re-evaluating-facet",
        "trigger": "facet now GREEN, none RED",
        "to": "all-facets-green"
      },
      {
        "from": "re-evaluating-facet",
        "trigger": "facet still RED after N iterations",
        "to": "human-escalation-required"
      }
    ],
    "terminal_states": [
      "all-facets-green",
      "human-escalation-required"
    ]
  },
  "severity_priority_order": [
    {
      "rank": 1,
      "match": "F7 security severity=critical"
    },
    {
      "rank": 2,
      "match": "F7 security severity=high"
    },
    {
      "rank": 3,
      "match": "F1 linus finding tagged 'special-case-bug' or 'control-plane-before-scale'"
    },
    {
      "rank": 4,
      "match": "F3 adversarial failing_fixture_added=false on CC-1 or CC-7"
    },
    {
      "rank": 5,
      "match": "F5 quality finding tagged 'fake-enforcement-named-as-real' or 'silent-data-drop'"
    },
    {
      "rank": 6,
      "match": "F2 hyperscaler finding tagged 'single-mutex-hot-lock' on hot path"
    },
    {
      "rank": 7,
      "match": "F7 security severity=medium"
    },
    {
      "rank": 8,
      "match": "F6 alternatives <minItems:1>"
    },
    {
      "rank": 9,
      "match": "any other RED facet"
    }
  ],
  "iteration_budget": {
    "max_iterations_per_facet": 5,
    "max_iterations_per_changeset": 20,
    "exceed_action": "transition to human-escalation-required; do NOT mark done; emit FixupTask F-LOOP-EXHAUSTED-<n> citing the facet that failed to converge",
    "rationale": "Bounded depth prevents infinite loops on genuinely intractable issues. Human escalation is honest: 'this needs design conversation, not just more iterations.'"
  },
  "verification_commands_per_facet": {
    "F1_linus": [
      "cargo clippy -- -D warnings",
      "manual code review by human or peer agent"
    ],
    "F2_hyperscaler": [
      "cargo test --release with throughput probe (if applicable)",
      "manual scale review"
    ],
    "F3_adversarial": [
      "cargo test -p <lane-crate> -- failing_fixture",
      "cargo test -p <lane-crate> -- passing_fixture",
      "cargo test -p <lane-crate> -- fixture_pair_meta"
    ],
    "F4_ergonomic": [
      "new-contributor walkthrough (manual or simulated)",
      "lane: change-class-declared (machine)"
    ],
    "F5_quality": [
      "cargo clippy -- -D warnings",
      "cargo deny check",
      "manual code review"
    ],
    "F6_alternatives": [
      "alternatives_named length >= 1 in evidence JSON (machine)"
    ],
    "F7_security": [
      "cargo audit",
      "manual OWASP class review",
      "fuzz harness (if applicable)",
      "trivy scan (if container)"
    ]
  },
  "loop_evidence_schema": {
    "type": "object",
    "required": [
      "iteration_count",
      "states_visited",
      "final_state",
      "fixtures_added"
    ],
    "properties": {
      "iteration_count": {
        "type": "integer",
        "minimum": 0,
        "maximum": 20
      },
      "states_visited": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "final_state": {
        "enum": [
          "all-facets-green",
          "human-escalation-required"
        ]
      },
      "fixtures_added": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "facet_id": {
              "type": "string"
            },
            "fixture_path": {
              "type": "string"
            },
            "passes": {
              "type": "boolean"
            },
            "diagnostic": {
              "type": "string"
            }
          }
        }
      },
      "escalation_reason": {
        "type": "string",
        "description": "Required when final_state == human-escalation-required"
      },
      "duration_seconds": {
        "type": "integer",
        "minimum": 0
      }
    }
  },
  "examples": {
    "fast_path": {
      "change_class": "CC-4_refactor_pure (e.g., crate rename)",
      "typical_iterations": "1-2",
      "common_red_facets": [
        "F4 ergonomic (forgot to update doc), F1 linus (left dead identifier)"
      ]
    },
    "kernel_api_change": {
      "change_class": "CC-1_kernel_public_api",
      "typical_iterations": "5-10",
      "common_red_facets": [
        "F3 (need failing fixture), F7 (DoS class review), F6 (alternatives consider)"
      ],
      "minimum_required_artifacts": [
        "ADR cite",
        "failing fixture in lane tests"
      ]
    },
    "security_critical_fix": {
      "change_class": "CC-2_adapter_or_infrastructure with F7 severity=critical",
      "typical_iterations": "8-15",
      "loop_pattern": "F7 finding \u2192 fix \u2192 fuzz harness \u2192 fixture \u2192 re-test \u2192 F7 re-eval \u2192 done when severity drops to none and adversarial fixture exists"
    }
  },
  "anti_patterns_explicitly_forbidden": [
    "skip-loop-because-tests-pass \u2014 passing tests are necessary but not sufficient",
    "claim-converged-without-re-verification \u2014 every iteration requires fresh evidence",
    "edit-evidence-to-match-reality \u2014 evidence captures past state; new evidence files for new state",
    "iterate-without-emitting-state-transition \u2014 every state transition appears in states_visited array"
  ],
  "decision_log": [
    {
      "when": "2026-05-14",
      "who": "claude-mcc-p06-ip-002",
      "what_changed": "spec created",
      "why": "user directive 2026-05-14: 'act as a checklist before anything is declared done and makes to pr. iterative fixes and review.'"
    }
  ]
}
