{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.oyatie.com/specs/audit-event-class-registry.schema.json",
  "title": "Oyatie Audit Event Class Registry Schema",
  "description": "Canonical JSON Schema 2020-12 contract and known-class registry for audit-event classes governed by ADR-0263. The registry binds emitted event classes from ADR-0297 abuse defence, ADR-0313 conglomerate tenant hierarchy, ADR-0319 front/middle/back-office information barrier, and ADR-0326 residency attestation/placement/cross-border events into one machine-readable surface. Every new doctrine ADR that introduces audit events must extend this registry and keep ADR-0263 reverse references current.",
  "version": "1.1.0",
  "_meta": {
    "doc_class": "Machine-Readable-Spec",
    "spec_id": "EXE-AUDIT-EVENT-CLASS-REGISTRY",
    "status": "Proposed",
    "enforcement_status": "advisory-until-audit-event-class-registered-gate-lands",
    "owner_team": "axis-audit-chain + axis-observability + council-security",
    "created_at": "2026-05-20T00:00:00Z",
    "binding_adr": "ADR-0263",
    "related_adrs": [
      "ADR-0003",
      "ADR-0243",
      "ADR-0244",
      "ADR-0263",
      "ADR-0297",
      "ADR-0313",
      "ADR-0319",
      "ADR-0326"
    ],
    "purpose": "Define the registry row shape for every approved audit-event class and expose the current known class set from ADR-0263. The validator refuses OpenAPI, AsyncAPI, proto, Cedar, workflow, and observability contracts that emit free-form or unregistered classes."
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "registry_id",
    "version",
    "mandatory_envelope_fields",
    "cedar_decision_fields",
    "classes",
    "update_policy"
  ],
  "properties": {
    "example_name": {
      "type": "string",
      "description": "Optional example label used by named examples.",
      "minLength": 3,
      "maxLength": 120
    },
    "registry_id": {
      "type": "string",
      "const": "audit-event-class-registry",
      "description": "Stable registry id for the ADR-0263 audit-event-class catalog."
    },
    "version": {
      "$ref": "#/definitions/semver",
      "description": "Semantic version of the registry contract and class list."
    },
    "mandatory_envelope_fields": {
      "type": "array",
      "description": "ADR-0263 mandatory event envelope fields inherited by every registered class.",
      "items": {
        "$ref": "#/definitions/fieldName"
      },
      "contains": {
        "const": "tenant_id"
      },
      "minItems": 10,
      "uniqueItems": true
    },
    "cedar_decision_fields": {
      "type": "array",
      "description": "Additional fields required when an event class is produced by a Cedar decision.",
      "items": {
        "$ref": "#/definitions/fieldName"
      },
      "minItems": 6,
      "uniqueItems": true
    },
    "classes": {
      "type": "array",
      "description": "Registered audit-event classes. Every emitted class must appear here with origin, severity, payload, cardinality, and retention metadata.",
      "items": {
        "$ref": "#/definitions/eventClassEntry"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "update_policy": {
      "type": "object",
      "description": "Rules for extending the registry when a downstream ADR introduces new emitted classes.",
      "additionalProperties": false,
      "required": [
        "requires_originating_adr",
        "requires_reverse_reference_to_adr_0263",
        "requires_payload_schema",
        "requires_cardinality_budget",
        "requires_retention_class",
        "requires_validator_lane"
      ],
      "properties": {
        "requires_originating_adr": {
          "type": "boolean",
          "const": true
        },
        "requires_reverse_reference_to_adr_0263": {
          "type": "boolean",
          "const": true
        },
        "requires_payload_schema": {
          "type": "boolean",
          "const": true
        },
        "requires_cardinality_budget": {
          "type": "boolean",
          "const": true
        },
        "requires_retention_class": {
          "type": "boolean",
          "const": true
        },
        "requires_validator_lane": {
          "type": "string",
          "const": "oya gate validate audit-event-class-registered"
        }
      }
    }
  },
  "definitions": {
    "semver": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$",
      "examples": [
        "1.0.0",
        "1.1.0",
        "2.0.0-rc.1"
      ]
    },
    "fieldName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "minLength": 2,
      "maxLength": 80,
      "examples": [
        "tenant_id",
        "audit_id",
        "schema_version",
        "jurisdiction_code"
      ]
    },
    "adrId": {
      "type": "string",
      "pattern": "^ADR-[0-9]{4}$",
      "examples": [
        "ADR-0263",
        "ADR-0297",
        "ADR-0313",
        "ADR-0319"
      ]
    },
    "eventClassName": {
      "type": "string",
      "enum": [
        "AbuseDefenceBotBlocked",
        "AbuseDefenceSpoofDetected",
        "AbuseDefenceScrapeBlocked",
        "AbuseDefenceChallengeIssued",
        "AbuseDefenceChallengeSolved",
        "AbuseDefenceChallengeFailed",
        "AbuseDefenceRateLimitHit",
        "AbuseDefenceRateLimitFallback",
        "AbuseDefenceHoneypotHit",
        "AbuseDefenceCanaryRecovered",
        "AbuseDefenceQuotaExceeded",
        "AbuseDefenceCredentialPwned",
        "AbuseDefenceCredentialStuffing",
        "AbuseDefenceAttestationFailed",
        "AbuseDefenceVendorOutage",
        "AbuseDefenceFragmentActivated",
        "AbuseDefenceWatermarkRecovered",
        "AbuseDefenceSPIREOutage",
        "ConglomerateGrantCreated",
        "ConglomerateGrantRevoked",
        "ConglomerateParentReadAction",
        "ConglomerateCrossJurisdictionResidencyEnforced",
        "ConglomerateInformationBarrierCrossingRefused",
        "ConglomeratePersonalTenantBoundaryRefused",
        "OfficeScopeAssignmentCreated",
        "OfficeScopeAssignmentChanged",
        "OfficeScopeAssignmentRevoked",
        "OfficeBoundaryClearanceRequested",
        "OfficeBoundaryClearanceApproved",
        "OfficeBoundaryClearanceDenied",
        "OfficeBoundaryClearanceRevoked",
        "OfficeBoundaryAttemptEvaluated",
        "OfficeBoundaryAttemptDenied",
        "OfficeBoundaryAttemptAllowed",
        "InformationBarrierTaintAttached",
        "InformationBarrierTaintDerived",
        "InformationBarrierTaintReleased",
        "RestrictedDealCreated",
        "RestrictedDealParticipantAdded",
        "RestrictedDealParticipantRemoved",
        "RestrictedDealReleased",
        "AdvisorRelationshipBarrierCreated",
        "AdvisorRelationshipBarrierAttemptEvaluated",
        "OfficePackOverlayActivated",
        "OfficePackOverlayChanged",
        "OfficePackOverlayRetired",
        "TenancyResidencyAttestationCreated",
        "TenancyResidencyAttestationRefreshed",
        "TenancyResidencyAttestationExpired",
        "TenancyResidencyAttestationSignatureInvalid",
        "TenancyResidencyAttestationMissing",
        "TenancyResidencyPlacementDecided",
        "TenancyResidencyPlacementRefused",
        "TenancyResidencyCrossBorderRefused",
        "TenancyResidencyCrossBorderPermitted",
        "TenancyResidencyTierUpgraded",
        "TenancyResidencyTierDowngraded",
        "TenancyResidencyPackBindingChanged",
        "TenancyResidencyRegulatoryAttestorEngaged"
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "DEBUG",
        "INFO",
        "WARN",
        "ERROR",
        "CRITICAL"
      ],
      "examples": [
        "INFO",
        "WARN",
        "CRITICAL"
      ]
    },
    "retentionClass": {
      "type": "string",
      "enum": [
        "standard",
        "security",
        "regulated",
        "legal_hold_capable",
        "financial_control",
        "information_barrier"
      ],
      "examples": [
        "standard",
        "security",
        "information_barrier"
      ]
    },
    "emissionTarget": {
      "type": "string",
      "enum": [
        "audit-chain",
        "loki-log",
        "otel-trace",
        "prometheus-metric",
        "security-alert",
        "compliance-evidence-bundle"
      ],
      "examples": [
        "audit-chain",
        "otel-trace",
        "security-alert"
      ]
    },
    "cardinalityBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dimension_keys",
        "max_distinct_per_cell_per_day",
        "high_cardinality_allowed"
      ],
      "properties": {
        "dimension_keys": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/fieldName"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "max_distinct_per_cell_per_day": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000000
        },
        "high_cardinality_allowed": {
          "type": "boolean",
          "description": "True only when ADR text names the class as expected high-cardinality and the observability budget accounts for it."
        }
      }
    },
    "payloadField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type",
        "required",
        "pii_handling"
      ],
      "properties": {
        "name": {
          "$ref": "#/definitions/fieldName"
        },
        "type": {
          "type": "string",
          "enum": [
            "string",
            "integer",
            "number",
            "boolean",
            "array",
            "object",
            "uuid",
            "date-time",
            "enum"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "pii_handling": {
          "type": "string",
          "enum": [
            "none",
            "hashed",
            "redacted",
            "stable_identifier_only",
            "forbidden"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 12,
          "maxLength": 600
        }
      }
    },
    "eventClassEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_class",
        "originating_adr",
        "description",
        "severity",
        "retention_class",
        "emission_targets",
        "payload_fields",
        "cardinality_budget",
        "cedar_decision_event",
        "schema_version"
      ],
      "properties": {
        "event_class": {
          "$ref": "#/definitions/eventClassName"
        },
        "originating_adr": {
          "$ref": "#/definitions/adrId"
        },
        "description": {
          "type": "string",
          "minLength": 40,
          "maxLength": 1200
        },
        "severity": {
          "$ref": "#/definitions/severity"
        },
        "retention_class": {
          "$ref": "#/definitions/retentionClass"
        },
        "emission_targets": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/emissionTarget"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "payload_fields": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/payloadField"
          },
          "minItems": 1
        },
        "cardinality_budget": {
          "$ref": "#/definitions/cardinalityBudget"
        },
        "cedar_decision_event": {
          "type": "boolean"
        },
        "schema_version": {
          "$ref": "#/definitions/semver"
        }
      }
    }
  },
