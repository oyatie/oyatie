{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.oyatie.com/specs/pack-overlay-schema.schema.json",
  "title": "Oyatie Compliance Pack Overlay Schema",
  "description": "Canonical machine-readable contract for compliance pack overlays in Oyatie. ADR-0251 establishes pack overlays as the compliance layer evaluated during request handling, and ADR-0316 requires capability tiers to bind regulated product surfaces through compliance overlays rather than forked services. This schema defines overlay identity, jurisdiction scope, data classes, regulated decisions, Cedar bindings, ontology projection constraints, workflow constraints, audit obligations, evidence requirements, precedence, lifecycle, and promotion gates.",
  "version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "overlay_id",
    "pack_id",
    "overlay_version",
    "status",
    "adr_refs",
    "title",
    "description",
    "jurisdiction_scope",
    "tenant_scope",
    "data_class_scope",
    "regulated_decision_scope",
    "cedar_policy_overlays",
    "ontology_projection_constraints",
    "workflow_constraints",
    "audit_requirements",
    "evidence_requirements",
    "precedence",
    "lifecycle",
    "ownership",
    "promotion_gates"
  ],
  "properties": {
    "overlay_id": {
      "$ref": "#/definitions/overlayId",
      "description": "Stable overlay identifier. ADR-0251 requires pack overlays to be explicit inputs to compliance evaluation and audit emission."
    },
    "pack_id": {
      "$ref": "#/definitions/packId",
      "description": "Canonical compliance pack that owns this overlay. The pack itself remains governed by specs/compliance-pack-schema.json."
    },
    "overlay_version": {
      "$ref": "#/definitions/semver",
      "description": "Semantic version for the overlay. Breaking changes to data class, Cedar, or audit behavior require a major version."
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "review",
        "preview",
        "active",
        "suspended",
        "deprecated",
        "retired"
      ],
      "description": "Overlay lifecycle status. ADR-0316 allows capability tier promotion only after compliance overlay review passes."
    },
    "adr_refs": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/adrRef"
      },
      "description": "ADR references that authorize the overlay contract. Expected references include ADR-0251 and ADR-0316."
    },
    "title": {
      "type": "string",
      "minLength": 8,
      "maxLength": 160,
      "description": "Human-readable overlay title for review surfaces and registries."
    },
    "description": {
      "type": "string",
      "minLength": 80,
      "maxLength": 1200,
      "description": "Bespoke explanation of what legal, compliance, residency, data-class, or decision constraint the overlay enforces."
    },
    "jurisdiction_scope": {
      "$ref": "#/definitions/jurisdictionScope",
      "description": "Jurisdictions and residency regions where this overlay applies."
    },
    "tenant_scope": {
      "$ref": "#/definitions/tenantScope",
      "description": "Tenant eligibility and exclusion controls for overlay installation."
    },
    "data_class_scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/dataClassRule"
      },
      "description": "Data classes constrained by the overlay. ADR-0316 requires regulated data tiers to map to compliance overlays."
    },
    "regulated_decision_scope": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/regulatedDecisionRule"
      },
      "description": "Regulated decision classes constrained by the overlay, such as employment, credit, care, identity, or export decisions."
    },
    "cedar_policy_overlays": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/cedarOverlayBinding"
      },
      "description": "Cedar fragment and permit-set bindings that enforce the overlay at authorization time."
    },
    "ontology_projection_constraints": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/projectionConstraint"
      },
      "description": "Projection-level filters, redactions, and field visibility rules applied before workflow or UX access."
    },
    "workflow_constraints": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/workflowConstraint"
      },
      "description": "Workflow template constraints required by the overlay. Cedar does not encode workflow state machines; workflows consume overlay decisions."
    },
    "audit_requirements": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/auditRequirement"
      },
      "description": "Audit obligations emitted per pack and overlay. ADR-0251 requires pack-aware audit emission."
    },
    "evidence_requirements": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/evidenceRequirement"
      },
      "description": "Evidence objects that must exist for installation, activation, and continued operation."
    },
    "precedence": {
      "$ref": "#/definitions/precedenceRule",
      "description": "Conflict resolution for overlapping overlays. Most restrictive applicable overlay must win for regulated tier interactions."
    },
    "lifecycle": {
      "$ref": "#/definitions/lifecycle",
      "description": "Lifecycle control including effective dates, review windows, and sunset behavior."
    },
    "ownership": {
      "$ref": "#/definitions/ownership",
      "description": "Responsible owners, reviewers, and approvers for the overlay."
    },
    "promotion_gates": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/promotionGate"
      },
      "description": "Promotion gates that must pass before preview or active use."
    },
    "cost_controls": {
      "$ref": "#/definitions/costControls",
      "description": "Optional cost and FinOps constraints applied when overlays require extra logging, evidence retention, or sovereign routing."
    }
  },
  "definitions": {
    "overlayId": {
      "type": "string",
      "pattern": "^overlay:[a-z0-9][a-z0-9-]{2,80}:v[0-9]+$",
      "examples": [
        "overlay:gdpr-sales-core:v1",
        "overlay:hipaa-minimum-necessary:v1"
      ]
    },
    "packId": {
      "type": "string",
      "pattern": "^pack:[a-z0-9][a-z0-9-]{2,80}:v[0-9]+$",
      "examples": [
        "pack:gdpr:v1",
        "pack:hipaa:v1"
      ]
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
    },
    "adrRef": {
      "type": "string",
      "pattern": "^ADR-[0-9]{4}:[A-Za-z0-9 ._/-]+$",
      "minLength": 14,
      "maxLength": 160
    },
    "jurisdictionCode": {
      "type": "string",
      "pattern": "^[A-Z]{2}(-[A-Z0-9]{1,3})?$",
      "examples": [
        "US",
        "EU",
        "KR",
        "CA-QC"
      ]
    },
    "jurisdictionScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applies_in",
        "excludes",
        "residency_regions",
        "sovereign_mode"
      ],
      "properties": {
        "applies_in": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/jurisdictionCode"
          }
        },
        "excludes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/jurisdictionCode"
          }
        },
        "residency_regions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z]{2}-[a-z]+-[0-9]+|sovereign-[a-z0-9-]{2,40}$"
          }
        },
        "sovereign_mode": {
          "type": "string",
          "enum": [
            "none",
            "data-residency-only",
            "control-plane-isolated",
            "air-gapped"
          ]
        }
      }
    },
    "tenantScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenant_types",
        "requires_explicit_install",
        "ineligible_audience_types"
      ],
      "properties": {
        "tenant_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "enterprise",
              "regulated-enterprise",
              "public-sector",
              "consumer",
              "personal"
            ]
          }
        },
        "requires_explicit_install": {
          "type": "boolean"
        },
        "ineligible_audience_types": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z0-9_]{3,80}$"
          }
        }
      }
    },
    "dataClassRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data_class",
        "constraint",
        "redaction_profile",
        "retention_profile"
      ],
      "properties": {
        "data_class": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,80}$"
        },
        "constraint": {
          "type": "string",
          "enum": [
            "allow",
            "redact",
            "minimize",
            "forbid",
            "tenant-consent-required",
            "jurisdiction-consent-required"
          ]
        },
        "redaction_profile": {
          "type": "string",
          "pattern": "^redaction:[a-z0-9][a-z0-9-]{2,80}:v[0-9]+$"
        },
        "retention_profile": {
          "type": "string",
          "pattern": "^retention:[a-z0-9][a-z0-9-]{2,80}:v[0-9]+$"
        }
      }
    },
    "regulatedDecisionRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_class",
        "requires_explanation",
        "requires_human_review",
        "cedar_action_refs"
      ],
      "properties": {
        "decision_class": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,80}$"
        },
        "requires_explanation": {
          "type": "boolean"
        },
        "requires_human_review": {
          "type": "boolean"
        },
        "cedar_action_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Za-z0-9]*::Action::\\\"[A-Z][A-Za-z0-9]+\\\"$"
          }
        }
      }
    },
    "cedarOverlayBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_id",
        "permit_set_id",
        "fragment_refs",
        "context_keys",
        "default_decision"
      ],
      "properties": {
        "binding_id": {
          "type": "string",
          "pattern": "^cedar-overlay:[a-z0-9][a-z0-9-]{2,80}$"
        },
        "permit_set_id": {
          "type": "string",
          "pattern": "^permit-set:[a-z0-9][a-z0-9-]{2,80}:v[0-9]+$"
        },
        "fragment_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^fragment:[a-z0-9][a-z0-9-]{2,96}:v[0-9]+$"
          }
        },
        "context_keys": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{1,64}$"
          }
        },
        "default_decision": {
          "type": "string",
          "enum": [
            "deny",
            "forbid"
          ]
        }
      }
    },
    "projectionConstraint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "constraint_id",
        "object_type_refs",
        "field_visibility",
        "pack_filters",
        "audit_redaction_profile"
      ],
      "properties": {
        "constraint_id": {
          "type": "string",
          "pattern": "^projection-constraint:[a-z0-9][a-z0-9-]{2,80}$"
        },
        "object_type_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^ontology://[a-z0-9./_-]+#[A-Za-z][A-Za-z0-9_]*$"
          }
        },
        "field_visibility": {
          "type": "string",
          "enum": [
            "allow-listed-fields-only",
            "redact-sensitive-fields",
            "deny-object",
            "minimum-necessary"
          ]
        },
        "pack_filters": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/overlayId"
          }
        },
        "audit_redaction_profile": {
          "type": "string",
          "pattern": "^audit-redaction:[a-z0-9][a-z0-9-]{2,80}:v[0-9]+$"
        }
      }
    },
    "workflowConstraint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflow_template_ref",
        "constraint_type",
        "required_gate"
      ],
      "properties": {
        "workflow_template_ref": {
          "type": "string",
          "pattern": "^workflow-template:[a-z0-9][a-z0-9-]{2,80}:v[0-9]+$"
        },
        "constraint_type": {
          "type": "string",
          "enum": [
            "human-approval",
            "dual-control",
            "consent-check",
            "retention-check",
            "export-review",
            "minimum-necessary-attestation"
          ]
        },
        "required_gate": {
          "type": "string",
          "pattern": "^oya-governance-[a-z0-9-]{3,80}$"
        }
      }
    },
    "auditRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_class",
        "required_fields",
        "retention_days",
        "evidence_destination"
      ],
      "properties": {
        "event_class": {
          "type": "string",
          "pattern": "^[A-Z][A-Za-z0-9]{2,120}$"
        },
        "required_fields": {
          "type": "array",
          "minItems": 6,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{1,64}$"
          }
        },
        "retention_days": {
          "type": "integer",
          "minimum": 30,
          "maximum": 36500
        },
        "evidence_destination": {
          "type": "string",
          "pattern": "^evidence://[a-z0-9./_-]+$"
        }
      }
    },
    "evidenceRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "phase",
        "artifact_type",
        "required"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "pattern": "^evidence-required:[a-z0-9][a-z0-9-]{2,80}$"
        },
        "phase": {
          "type": "string",
          "enum": [
            "install",
            "preview",
            "active",
            "renewal",
            "retirement"
          ]
        },
        "artifact_type": {
          "type": "string",
          "enum": [
            "cedar-fixture",
            "projection-fixture",
            "workflow-test",
            "audit-sample",
            "legal-review",
            "tenant-approval"
          ]
        },
        "required": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "precedenceRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rank",
        "conflict_strategy",
        "more_restrictive_wins"
      ],
      "properties": {
        "rank": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "conflict_strategy": {
          "type": "string",
          "enum": [
            "deny-on-conflict",
            "forbid-on-conflict",
            "route-to-human-review"
          ]
        },
        "more_restrictive_wins": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "effective_at",
        "review_by",
        "renewal_period_days",
        "sunset_mode"
      ],
      "properties": {
        "effective_at": {
          "type": "string",
          "format": "date-time"
        },
        "review_by": {
          "type": "string",
          "format": "date-time"
        },
        "renewal_period_days": {
          "type": "integer",
          "minimum": 30,
          "maximum": 1095
        },
        "sunset_mode": {
          "type": "string",
          "enum": [
            "manual",
            "scheduled",
            "pack-superseded",
            "regulatory-withdrawal"
          ]
        }
      }
    },
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner_service",
        "policy_owner",
        "legal_reviewer",
        "technical_reviewer"
      ],
      "properties": {
        "owner_service": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,63}$"
        },
        "policy_owner": {
          "type": "string",
          "pattern": "^principal:[a-z0-9][a-z0-9._-]{2,120}$"
        },
        "legal_reviewer": {
          "type": "string",
          "pattern": "^principal:[a-z0-9][a-z0-9._-]{2,120}$"
        },
        "technical_reviewer": {
          "type": "string",
          "pattern": "^principal:[a-z0-9][a-z0-9._-]{2,120}$"
        }
      }
    },
    "promotionGate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate_id",
        "command",
        "evidence_ref"
      ],
      "properties": {
        "gate_id": {
          "type": "string",
          "pattern": "^pack-overlay-[a-z0-9-]{3,80}$"
        },
        "command": {
          "type": "string",
          "minLength": 6,
          "maxLength": 240
        },
        "evidence_ref": {
          "type": "string",
          "pattern": "^evidence://[a-z0-9./_-]+$"
        }
      }
    },
    "costControls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cost_profile_id",
        "metered_dimensions",
        "budget_alert_threshold_percent"
      ],
      "properties": {
        "cost_profile_id": {
          "type": "string",
          "pattern": "^cost-profile:[a-z0-9][a-z0-9-]{2,80}:v[0-9]+$"
        },
        "metered_dimensions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "audit-events",
              "evidence-retention-gb-days",
              "sovereign-routing",
              "human-review-minutes",
              "projection-materialization"
            ]
          }
        },
        "budget_alert_threshold_percent": {
          "type": "integer",
          "minimum": 50,
          "maximum": 100
        }
      }
    }
  },
  "examples": {
    "gdpr_sales_core_overlay": {
      "overlay_id": "overlay:gdpr-sales-core:v1",
      "pack_id": "pack:gdpr:v1",
      "overlay_version": "1.0.0",
      "status": "active",
      "adr_refs": [
        "ADR-0251:Compliance Pack Overlays",
        "ADR-0316:Capability Tier Over Product Fragmentation"
      ],
      "title": "GDPR Sales Core Overlay",
      "description": "Constrains CRM account, contact, opportunity, and campaign projections for EU data subjects. The overlay binds Cedar actions, ontology redaction rules, workflow consent checks, and audit retention so the same CRM services serve regulated and non-regulated tenants without product forks.",
      "jurisdiction_scope": {
        "applies_in": [
          "EU"
        ],
        "excludes": [],
        "residency_regions": [
          "eu-central-1"
        ],
        "sovereign_mode": "data-residency-only"
      },
      "tenant_scope": {
        "tenant_types": [
          "enterprise",
          "regulated-enterprise"
        ],
        "requires_explicit_install": true,
        "ineligible_audience_types": [
          "B2C_JOB_SEEKER_ACTIVE"
        ]
      },
      "data_class_scope": [
        {
          "data_class": "personal-data",
          "constraint": "tenant-consent-required",
          "redaction_profile": "redaction:gdpr-contact-minimal:v1",
          "retention_profile": "retention:gdpr-sales-standard:v1"
        }
      ],
      "regulated_decision_scope": [
        {
          "decision_class": "marketing-consent",
          "requires_explanation": true,
          "requires_human_review": false,
          "cedar_action_refs": [
            "Sales::Action::\"SendCampaign\""
          ]
        }
      ],
      "cedar_policy_overlays": [
        {
          "binding_id": "cedar-overlay:gdpr-sales-consent",
          "permit_set_id": "permit-set:sales-campaign-send:v1",
          "fragment_refs": [
            "fragment:pack-gdpr-sales-consent:v1"
          ],
          "context_keys": [
            "tenant_id",
            "jurisdiction_code",
            "consent_basis"
          ],
          "default_decision": "deny"
        }
      ],
      "ontology_projection_constraints": [
        {
          "constraint_id": "projection-constraint:gdpr-sales-contact",
          "object_type_refs": [
            "ontology://crm/sales#Contact"
          ],
          "field_visibility": "redact-sensitive-fields",
          "pack_filters": [
            "overlay:gdpr-sales-core:v1"
          ],
          "audit_redaction_profile": "audit-redaction:gdpr-contact:v1"
        }
      ],
      "workflow_constraints": [
        {
          "workflow_template_ref": "workflow-template:sales-consent-review:v1",
          "constraint_type": "consent-check",
          "required_gate": "oya-governance-gdpr-consent-check"
        }
      ],
      "audit_requirements": [
        {
          "event_class": "CompliancePackOverlayDecision",
          "required_fields": [
            "tenant_id",
            "event_id",
            "trace_id",
            "jurisdiction_code",
            "pack_id",
            "overlay_id"
          ],
          "retention_days": 2555,
          "evidence_destination": "evidence://compliance/gdpr/sales-core"
        }
      ],
      "evidence_requirements": [
        {
          "evidence_id": "evidence-required:gdpr-sales-legal-review",
          "phase": "active",
          "artifact_type": "legal-review",
          "required": true
        }
      ],
      "precedence": {
        "rank": 100,
        "conflict_strategy": "deny-on-conflict",
        "more_restrictive_wins": true
      },
      "lifecycle": {
        "effective_at": "2026-05-20T00:00:00Z",
        "review_by": "2027-05-20T00:00:00Z",
        "renewal_period_days": 365,
        "sunset_mode": "manual"
      },
      "ownership": {
