{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://oyatie.com/schemas/openslo-canonical-envelope.json",
  "title": "OpenSLO canonical envelope schema (SWEEP-I Slice 4)",
  "description": "Canonical envelope shape for every per-µservice OpenSLO. Authority: ADR-0064 canonical-base + localization-packs.",
  "canonical_authority": "ADR-0064",
  "canonical_authority_overlay": "ADR-0131 per-microservice flat layout",
  "consumer_pattern": "microservices/<ms>/slos/*.openslo.yaml",
  "openslo_version": "openslo/v1",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "type": "string",
      "enum": [
        "openslo/v1"
      ],
      "description": "OpenSLO v1.0 API version (mandatory)"
    },
    "kind": {
      "type": "string",
      "enum": [
        "SLO",
        "SLI",
        "AlertPolicy",
        "AlertCondition",
        "AlertNotificationTarget"
      ],
      "description": "OpenSLO resource kind"
    },
    "metadata": {
      "type": "object",
      "required": [
        "name",
        "displayName",
        "labels"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^oya-[a-z0-9-]+$",
          "description": "Slug-form name; must start with `oya-` (per ADR-0056 BNF v4.1)"
        },
        "displayName": {
          "type": "string"
        },
        "labels": {
          "type": "object",
          "required": [
            "microservice",
            "bounded_context",
            "tier",
            "plane"
          ],
          "properties": {
            "microservice": {
              "type": "string"
            },
            "bounded_context": {
              "type": "string"
            },
            "tier": {
              "type": "string",
              "enum": [
                "external-facing",
                "internal-substrate",
                "control-plane",
                "data-plane"
              ]
            },
            "plane": {
              "type": "string",
              "enum": [
                "control",
                "data",
                "audit"
              ]
            }
          }
        }
      }
    },
    "spec": {
      "type": "object",
      "required": [
        "service",
        "description",
        "indicator",
        "objectives",
        "timeWindow",
        "budgetingMethod"
      ],
      "properties": {
        "service": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "indicator": {
          "type": "object",
          "required": [
            "metadata",
            "spec"
          ],
          "properties": {
            "metadata": {
              "type": "object",
              "required": [
                "name"
              ],
              "properties": {
                "name": {
                  "type": "string"
                }
              }
            },
            "spec": {
              "type": "object"
            }
          }
        },
        "objectives": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "target"
            ],
            "properties": {
              "target": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "SLO target as a fraction (e.g. 0.99 for 99%)"
              },
              "displayName": {
                "type": "string"
              }
            }
          }
        },
        "timeWindow": {
          "type": "array",
          "minItems": 1,
          "description": "Canonical: rolling 30d unless documented exception",
          "items": {
            "type": "object",
            "required": [
              "duration",
              "isRolling"
            ],
            "properties": {
              "duration": {
                "type": "string",
                "description": "Canonical: 30d (rolling); other values require ADR justification"
              },
              "isRolling": {
                "type": "boolean"
              }
            }
          }
        },
        "budgetingMethod": {
          "type": "string",
          "enum": [
            "Occurrences",
            "Timeslices",
            "RatioTimeslices"
          ],
          "description": "Canonical default: Occurrences"
        }
      }
    }
  },
  "burn_rate_alert_pattern": {
    "$comment": "Canonical multi-window burn-rate alerting per Google SRE Workbook",
    "windows": [
      {
        "alert_window": "1h",
        "long_window": "1h",
        "short_window": "5m",
        "burn_rate": 14.4,
        "budget_consumed_pct": 2,
        "severity": "page"
      },
      {
        "alert_window": "6h",
        "long_window": "6h",
        "short_window": "30m",
        "burn_rate": 6.0,
        "budget_consumed_pct": 5,
        "severity": "page"
      },
      {
        "alert_window": "1d",
        "long_window": "1d",
        "short_window": "2h",
        "burn_rate": 3.0,
        "budget_consumed_pct": 10,
        "severity": "ticket"
      },
      {
        "alert_window": "3d",
        "long_window": "3d",
        "short_window": "6h",
        "burn_rate": 1.0,
        "budget_consumed_pct": 10,
        "severity": "ticket"
      }
    ]
  }
}
