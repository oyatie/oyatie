{
  "_comment": "Canonical face-aware substrate dependency graph v2. ADR-0631 amends ADR-0245, ADR-0280, ADR-0562, and ADR-0615. The five graph kinds are deliberately distinct; only steady_state_request is required to be acyclic. failure_brownout_propagation is derived exactly from steady_state_request by the declared max-min impact composition rule.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schema": "specs/substrate-dependency-dag.schema.json",
  "version": "2.0.0",
  "doctrine_adrs": [
    "ADR-0245",
    "ADR-0280",
    "ADR-0562",
    "ADR-0615",
    "ADR-0631"
  ],
  "dependency_units": [
    {
      "id": "external.genesis-roots",
      "capability": "external",
      "face": "genesis-roots",
      "plane": "E0",
      "purpose": "Hardware trust, signed bootstrap artifacts, organisation quorum, and bootstrap facts."
    },
    {
      "id": "cell.envelope",
      "capability": "cell",
      "face": "envelope",
      "plane": "B0",
      "purpose": "Empty cell hosting and liveness envelope."
    },
    {
      "id": "cell.genesis",
      "capability": "cell",
      "face": "genesis",
      "plane": "G",
      "purpose": "First-management-cell break-glass face."
    },
    {
      "id": "cell.lifecycle.cp",
      "capability": "cell",
      "face": "lifecycle.cp",
      "plane": "G",
      "purpose": "Cell identity, placement, and lifecycle control face."
    },
    {
      "id": "cell.router.dp",
      "capability": "cell",
      "face": "router.dp",
      "plane": "R",
      "purpose": "Cellularized routing data plane using signed cached snapshots."
    },
    {
      "id": "iam.admin.cp",
      "capability": "iam",
      "face": "admin.cp",
      "plane": "G",
      "purpose": "Identity administration and publication face."
    },
    {
      "id": "iam.local-verifier",
      "capability": "iam",
      "face": "local-verifier",
      "plane": "C0",
      "purpose": "Cell-local token, SVID, and JWK validation face."
    },
    {
      "id": "tenancy.directory.cp",
      "capability": "tenancy",
      "face": "directory.cp",
      "plane": "G",
      "purpose": "Tenant lifecycle and home-cell directory authority."
    },
    {
      "id": "tenancy.local-context",
      "capability": "tenancy",
      "face": "local-context",
      "plane": "C0",
      "purpose": "Signed cached tenant and routing context."
    },
    {
      "id": "policy.authoring.cp",
      "capability": "policy",
      "face": "authoring.cp",
      "plane": "G",
      "purpose": "Policy authoring, signing, and distribution face."
    },
    {
      "id": "policy.local-pdp",
      "capability": "policy",
      "face": "local-pdp",
      "plane": "C0",
      "purpose": "Cell-local PDP and versioned tenant policy store."
    },
    {
      "id": "secrets.root-control",
      "capability": "secrets",
      "face": "root-control",
      "plane": "G",
      "purpose": "External-root-backed root and intermediate management service."
    },
    {
      "id": "secrets.cell-issuer",
      "capability": "secrets",
      "face": "cell-issuer",
      "plane": "C0",
      "purpose": "Cell key partition and downstream workload issuer."
    },
    {
      "id": "audit.control-aggregation",
      "capability": "audit",
      "face": "control-aggregation",
      "plane": "G",
      "purpose": "Asynchronous fleet audit aggregation face."
    },
    {
      "id": "audit.cell-seal",
      "capability": "audit",
      "face": "cell-seal",
      "plane": "C1",
      "purpose": "Cell-local append and seal face."
    },
    {
      "id": "observability.cell-runtime",
      "capability": "observability",
      "face": "cell-runtime",
      "plane": "C1",
      "purpose": "Cell-local telemetry collection and runtime visibility."
    },
    {
      "id": "data.ontology-runtime",
      "capability": "data",
      "face": "ontology-runtime",
      "plane": "C1",
      "purpose": "Cell-local ontology and projection runtime."
    },
    {
      "id": "intelligence.runtime",
      "capability": "intelligence",
      "face": "runtime",
      "plane": "C2",
      "purpose": "Cell workload intelligence runtime."
    },
    {
      "id": "workflow.runtime",
      "capability": "workflow",
      "face": "runtime",
      "plane": "C2",
      "purpose": "Cell workload orchestration runtime."
    }
  ],
  "failure_impact_composition": {
    "path_rule": "minimum severity across every steady_state_request edge on a path; a weak propagation edge bounds that path",
    "multi_path_rule": "maximum severity across all paths from impacted_unit to failed_unit; the strongest propagation path wins",
    "severity_order": [
      "INDEPENDENT",
      "BROWNOUT",
      "DEGRADED",
      "FULL"
    ],
    "closure_direction": "reverse_transitive_closure: request dependency A -> B yields failure propagation B -> A"
  },
  "graphs": [
    {
      "kind": "genesis",
      "edge_semantics": "from precedes and enables to during first-ever bring-up; cycles are not evaluated by the graph-3 acyclicity invariant",
      "edges": [
        {
          "graph_kind": "genesis",
          "from": "external.genesis-roots",
          "to": "cell.envelope",
          "rationale": "External integrity and liveness facts establish the empty hosting envelope."
        },
        {
          "graph_kind": "genesis",
          "from": "cell.envelope",
          "to": "cell.genesis",
          "rationale": "The empty envelope hosts the first break-glass management cell."
        },
        {
          "graph_kind": "genesis",
          "from": "cell.genesis",
          "to": "secrets.root-control",
          "rationale": "Break-glass genesis activates external-root-backed secrets control."
        },
        {
          "graph_kind": "genesis",
          "from": "secrets.root-control",
          "to": "iam.admin.cp",
          "rationale": "Root-backed identity administration follows secrets genesis."
        }
      ]
    },
    {
      "kind": "new_cell_provisioning",
      "edge_semantics": "from must be available or complete before to in the reviewed new-cell workflow; this is not a request dependency graph",
      "edges": [
        {
          "graph_kind": "new_cell_provisioning",
          "from": "iam.admin.cp",
          "to": "cell.lifecycle.cp"
        },
        {
          "graph_kind": "new_cell_provisioning",
          "from": "tenancy.directory.cp",
          "to": "cell.lifecycle.cp"
        },
        {
          "graph_kind": "new_cell_provisioning",
          "from": "policy.authoring.cp",
          "to": "cell.lifecycle.cp"
        },
        {
          "graph_kind": "new_cell_provisioning",
          "from": "audit.control-aggregation",
          "to": "cell.lifecycle.cp"
        },
        {
          "graph_kind": "new_cell_provisioning",
          "from": "cell.lifecycle.cp",
          "to": "cell.envelope"
        },
        {
          "graph_kind": "new_cell_provisioning",
          "from": "cell.envelope",
          "to": "secrets.cell-issuer"
        },
        {
          "graph_kind": "new_cell_provisioning",
          "from": "secrets.cell-issuer",
          "to": "iam.local-verifier"
        },
        {
          "graph_kind": "new_cell_provisioning",
          "from": "iam.local-verifier",
          "to": "tenancy.local-context"
        },
        {
          "graph_kind": "new_cell_provisioning",
          "from": "tenancy.local-context",
          "to": "policy.local-pdp"
        },
        {
          "graph_kind": "new_cell_provisioning",
          "from": "policy.local-pdp",
          "to": "audit.cell-seal"
        },
        {
          "graph_kind": "new_cell_provisioning",
          "from": "audit.cell-seal",
          "to": "observability.cell-runtime"
        },
        {
          "graph_kind": "new_cell_provisioning",
          "from": "observability.cell-runtime",
          "to": "data.ontology-runtime"
        },
        {
          "graph_kind": "new_cell_provisioning",
          "from": "data.ontology-runtime",
          "to": "intelligence.runtime"
        },
        {
          "graph_kind": "new_cell_provisioning",
          "from": "intelligence.runtime",
          "to": "workflow.runtime"
        }
      ]
    },
    {
      "kind": "steady_state_request",
      "edge_semantics": "from synchronously depends on to; this graph alone must be acyclic and bootstrap_order must be a valid dependency-first topological order",
      "bootstrap_order": [
        "cell.envelope",
        "iam.local-verifier",
        "tenancy.local-context",
        "policy.local-pdp",
        "secrets.cell-issuer",
        "audit.cell-seal",
        "observability.cell-runtime",
        "data.ontology-runtime",
        "intelligence.runtime",
        "workflow.runtime"
      ],
      "forbidden_edges_assertion": [
        {
          "from": "cell.envelope",
          "to": "iam.local-verifier",
          "reason": "cell is the leaf substrate; nothing higher may be its dependency."
        },
        {
          "from": "cell.envelope",
          "to": "tenancy.local-context",
          "reason": "same"
        },
        {
          "from": "cell.envelope",
          "to": "policy.local-pdp",
          "reason": "same"
        },
        {
          "from": "cell.envelope",
          "to": "secrets.cell-issuer",
          "reason": "same"
        },
        {
          "from": "cell.envelope",
          "to": "audit.cell-seal",
          "reason": "same"
        },
        {
          "from": "cell.envelope",
          "to": "observability.cell-runtime",
          "reason": "same"
        },
        {
          "from": "cell.envelope",
          "to": "data.ontology-runtime",
          "reason": "same"
        },
        {
          "from": "cell.envelope",
          "to": "intelligence.runtime",
          "reason": "same"
        },
        {
          "from": "cell.envelope",
          "to": "workflow.runtime",
          "reason": "same"
        },
        {
          "from": "iam.local-verifier",
          "to": "tenancy.local-context",
          "reason": "identity precedes tenancy in bootstrap; reverse edge would cycle."
        },
        {
          "from": "iam.local-verifier",
          "to": "policy.local-pdp",
          "reason": "identity must bootstrap before Cedar can gate calls."
        },
        {
          "from": "policy.local-pdp",
          "to": "audit.cell-seal",
          "reason": "audit-chain depends on policy-engine, not the reverse; cycle forbidden."
        },
        {
          "from": "policy.local-pdp",
          "to": "observability.cell-runtime",
          "reason": "observability emits to its own audit-chain; policy-engine MUST NOT depend on observability for hot-path evaluation."
        },
        {
          "from": "policy.local-pdp",
          "to": "data.ontology-runtime",
          "reason": "policy-engine MUST NOT depend on ontology \u2014 Ontology depends on policy-engine for authorization (the historical inversion this ADR explicitly closes)."
        },
        {
          "from": "secrets.cell-issuer",
          "to": "iam.local-verifier",
          "reason": "cloud-secrets is bootstrap-step-3; identity is bootstrap-step-2. Cloud-secrets has a bootstrap-only seam to identity (Shamir-shared genesis) but no runtime dependency."
        },
        {
          "from": "audit.cell-seal",
          "to": "data.ontology-runtime",
          "reason": "audit-chain MUST NOT depend on ontology; Merkle log is self-contained."
        },
        {
          "from": "audit.cell-seal",
          "to": "intelligence.runtime",
          "reason": "audit-chain MUST NOT depend on intelligence \u2014 the audit substrate is the simplest possible."
        },
        {
          "from": "audit.cell-seal",
          "to": "workflow.runtime",
          "reason": "audit-chain MUST NOT depend on workflow-engine; audit emission is synchronous per-call."
        },
        {
          "from": "data.ontology-runtime",
          "to": "intelligence.runtime",
          "reason": "RAG reads flow Intelligence \u2192 Ontology, not the reverse."
        },
        {
          "from": "data.ontology-runtime",
          "to": "workflow.runtime",
          "reason": "Workflows read/write Ontology; Ontology MUST NOT depend on workflows."
        },
        {
          "from": "intelligence.runtime",
          "to": "workflow.runtime",
          "reason": "Workflows compose intelligence steps; intelligence MUST NOT depend on workflows."
        }
      ],
      "edges": [
        {
          "from": "iam.local-verifier",
          "to": "cell.envelope",
          "dependency_weight": 1.0,
          "cascade_rule": "FULL",
          "version_compatibility_range": "^1.0",
          "cedar_permit_fragment": "permit-identity-call-cell-v1",
          "rationale": "Identity issuance requires cell-local Postgres + KMS slot resolution.",
          "graph_kind": "steady_state_request"
        },
        {
          "from": "tenancy.local-context",
          "to": "cell.envelope",
          "dependency_weight": 1.0,
          "cascade_rule": "FULL",
          "version_compatibility_range": "^1.0",
          "cedar_permit_fragment": "permit-tenancy-call-cell-v1",
          "rationale": "Tenancy resolves home_cell on every tenant lookup.",
          "graph_kind": "steady_state_request"
        },
        {
          "from": "tenancy.local-context",
          "to": "iam.local-verifier",
          "dependency_weight": 1.0,
          "cascade_rule": "FULL",
          "version_compatibility_range": "^1.0",
          "cedar_permit_fragment": "permit-tenancy-call-identity-v1",
          "rationale": "Tenant admission verifies admin principals against identity.",
          "graph_kind": "steady_state_request"
        },
        {
          "from": "policy.local-pdp",
          "to": "cell.envelope",
          "dependency_weight": 0.5,
          "cascade_rule": "BROWNOUT",
          "version_compatibility_range": "^1.0",
          "cedar_permit_fragment": "permit-policy-engine-call-cell-v1",
          "rationale": "Cell-local Postgres + Valkey shared by fragment registry.",
          "graph_kind": "steady_state_request"
        },
        {
          "from": "policy.local-pdp",
          "to": "iam.local-verifier",
          "dependency_weight": 1.0,
          "cascade_rule": "FULL",
          "version_compatibility_range": "^1.0",
          "cedar_permit_fragment": "permit-policy-engine-call-identity-v1",
          "rationale": "Fragment publishers' principals resolved via identity.",
          "graph_kind": "steady_state_request"
        },
        {
          "from": "policy.local-pdp",
          "to": "tenancy.local-context",
          "dependency_weight": 1.0,
          "cascade_rule": "FULL",
          "version_compatibility_range": "^1.0",
          "cedar_permit_fragment": "permit-policy-engine-call-tenancy-v1",
          "rationale": "Tenant context required for tenant-overlay evaluation.",
          "graph_kind": "steady_state_request"
        },
        {
          "from": "secrets.cell-issuer",
          "to": "cell.envelope",
          "dependency_weight": 1.0,
          "cascade_rule": "FULL",
          "version_compatibility_range": "^1.0",
          "cedar_permit_fragment": "permit-cloud-secrets-call-cell-v1",
