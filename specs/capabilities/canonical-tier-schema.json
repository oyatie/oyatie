{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://oyatie.com/schemas/capabilities-canonical-tier.json",
  "title": "Capability T0/T1/T2 canonical tier schema (SWEEP-I Slice 5)",
  "description": "Canonical shape for every per-µservice capability YAML (T0-suggest, T1-assist, T2-auto). Authority: ADR-0064.",
  "canonical_authority": "ADR-0064",
  "canonical_authority_overlay": "ADR-0131 per-microservice flat layout",
  "tier_authority": "ADR-0022 (autonomy tiers); ADR-0164 (autonomy ceiling)",
  "consumer_pattern": "microservices/<ms>/capabilities/{T0,T1,T2}.yaml",
  "type": "object",
  "required": [
    "id",
    "name",
    "namespace",
    "display_name",
    "description",
    "owner_team",
    "maturity",
    "created_at",
    "autonomy_tier",
    "data_classes_touched",
    "regulatory_packs_consumed",
    "evidence_topic"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^cap:[a-z0-9-]+:(t0-suggest|t1-assist|t2-auto):v[0-9]+$",
      "description": "Form: cap:<microservice>:t<N>-<archetype>:v<version>"
    },
    "name": {
      "type": "string",
      "enum": [
        "t0-suggest",
        "t1-assist",
        "t2-auto"
      ]
    },
    "namespace": {
      "type": "string",
      "description": "µservice slug"
    },
    "display_name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "owner_team": {
      "type": "string"
    },
    "maturity": {
      "type": "string",
      "enum": [
        "alpha",
        "preview",
        "GA",
        "deprecated"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date"
    },
    "related_adrs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^ADR-[0-9]{4}$"
      }
    },
    "related_specs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "related_artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "autonomy_tier": {
      "type": "string",
      "enum": [
        "T0",
        "T1",
        "T2"
      ],
      "description": "T0 = suggest (human reads); T1 = assist (human accepts); T2 = auto (human supervises)"
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "type"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "max_length": {
            "type": "integer"
          },
          "values": {
            "type": "array"
          },
          "default": {},
          "description": {
            "type": "string"
          }
        }
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "type"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "schema": {
            "type": "string"
          }
        }
      }
    },
    "data_classes_touched": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "PII_DIRECT_IDENTIFIER",
          "PII_QUASI_IDENTIFIER",
          "PHI",
          "PCI",
          "BEHAVIORAL_TENANT_PRODUCT",
          "INTERNAL_ONLY",
          "PUBLIC",
          "AUDIT"
        ]
      }
    },
    "regulatory_packs_consumed": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "pack-kr",
          "pack-eu",
          "pack-us",
          "pack-us-healthcare",
          "pack-jp",
          "pack-sg",
          "pack-au",
          "pack-in",
          "pack-br",
          "pack-ae",
          "pack-ksa"
        ]
      }
    },
    "evidence_topic": {
      "type": "string",
      "pattern": "^oya\\.[a-z0-9.-]+$"
    },
    "cost_profile": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "per-invocation",
            "per-second",
            "per-month"
          ]
        },
        "estimated_cost_usd_per_call": {
          "type": "number"
        },
        "cost_drivers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "cedar_policy_fragments": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "eval_set": {
      "type": "object",
      "properties": {
        "golden_inputs_path": {
          "type": "string"
        },
        "pass_threshold": {
          "type": "number"
        },
        "eval_metric": {
          "type": "string"
        },
        "cadence": {
          "type": "string"
        },
        "reference": {
          "type": "string"
        }
      }
    },
    "regulatory_compliance": {
      "type": "object",
      "properties": {
        "ai_act_2024_1689": {
          "type": "object",
          "required": [
            "classification"
          ],
          "properties": {
            "classification": {
              "type": "string",
              "enum": [
                "prohibited",
                "high-risk-ai-system",
                "limited-risk-ai-system",
                "minimal-risk-ai-system"
              ]
            },
            "risk_anchor_section": {
              "type": "string"
            },
            "arts_applicable": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "transparency_obligation": {
              "type": "string"
            },
            "human_oversight": {
              "type": "string"
            }
          }
        }
      }
    },
    "sunset": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "none",
            "deprecated",
            "removed"
          ]
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
