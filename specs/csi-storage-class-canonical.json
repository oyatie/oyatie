{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "spec_id": "csi-storage-class-canonical",
  "spec_kind": "canonical-decision",
  "authoring_adr": "ADR-0161",
  "related_adrs": [
    "ADR-0009",
    "ADR-0028",
    "ADR-0043",
    "ADR-0049",
    "ADR-0121",
    "ADR-0143",
    "ADR-0158",
    "ADR-0164"
  ],
  "status": "Accepted",
  "date": "2026-05-18",
  "title": "CSI Driver + StorageClass Canonical Spec",
  "purpose": "Declares the canonical StorageClass naming scheme (oya-<kind>-<tier>), the per-pack CSI driver matrix, the CSI driver requirements, and the workload µservice contract.",
  "canonical_storage_class_names": {
    "pg-hot": {
      "kind": "pg",
      "tier": "hot",
      "iops_class": "sub-millisecond",
      "use_cases": [
        "PostgreSQL primary",
        "Redis primary",
        "audit-chain leaf storage"
      ],
      "reclaim_policy_default": "Retain"
    },
    "pg-warm": {
      "kind": "pg",
      "tier": "warm",
      "iops_class": "single-digit-ms",
      "use_cases": [
        "warm replicas",
        "observability long-term storage"
      ],
      "reclaim_policy_default": "Retain"
    },
    "pg-cold": {
      "kind": "pg",
      "tier": "cold",
      "iops_class": "tens-of-ms",
      "use_cases": [
        "backups",
        "archived data",
        "cold tenant exports"
      ],
      "reclaim_policy_default": "Delete"
    },
    "redis-hot": {
      "kind": "redis",
      "tier": "hot",
      "iops_class": "sub-millisecond",
      "use_cases": [
        "Redis primary"
      ],
      "reclaim_policy_default": "Retain"
    },
    "s3-warm": {
      "kind": "s3",
      "tier": "warm",
      "access_pattern": "S3-API (boto / aws-sdk-rust)",
      "use_cases": [
        "object storage standard tier"
      ]
    },
    "s3-cold": {
      "kind": "s3",
      "tier": "cold",
      "access_pattern": "S3-API archive tier",
      "use_cases": [
        "long-term audit anchors",
        "tenant exports",
        "backups"
      ]
    }
  },
  "per_pack_csi_driver_matrix": {
    "pack-aws-us": {
      "pg-hot": "ebs.csi.aws.com/io2",
      "pg-warm": "ebs.csi.aws.com/gp3",
      "pg-cold": "ebs.csi.aws.com/st1",
      "redis-hot": "ebs.csi.aws.com/io2",
      "s3-warm": "S3 (direct API)",
      "s3-cold": "S3 Glacier Instant Retrieval"
    },
    "pack-gcp-us": {
      "pg-hot": "pd.csi.storage.gke.io/pd-extreme",
      "pg-warm": "pd.csi.storage.gke.io/pd-ssd",
      "pg-cold": "pd.csi.storage.gke.io/pd-standard",
      "redis-hot": "pd.csi.storage.gke.io/pd-extreme",
      "s3-warm": "GCS (direct API)",
      "s3-cold": "GCS Coldline"
    },
    "pack-azure-us": {
      "pg-hot": "disk.csi.azure.com/Premium_LRS-NVMe-v2",
      "pg-warm": "disk.csi.azure.com/Premium_LRS-P30",
      "pg-cold": "disk.csi.azure.com/StandardSSD_LRS",
      "redis-hot": "disk.csi.azure.com/Premium_LRS-NVMe-v2",
      "s3-warm": "Azure Blob (direct API)",
      "s3-cold": "Azure Archive"
    },
    "pack-kr-nhn": {
      "pg-hot": "block.csi.nhncloud.com/NVMe",
      "pg-warm": "block.csi.nhncloud.com/SSD",
      "pg-cold": "block.csi.nhncloud.com/HDD",
      "redis-hot": "block.csi.nhncloud.com/NVMe",
      "s3-warm": "NHN Object Storage (S3-compat)",
      "s3-cold": "NHN Object Storage Cold"
    },
    "pack-kr-naver": {
      "pg-hot": "block.csi.ncloud.com/NVMe",
      "pg-warm": "block.csi.ncloud.com/SSD",
      "pg-cold": "block.csi.ncloud.com/HDD",
      "redis-hot": "block.csi.ncloud.com/NVMe",
      "s3-warm": "NCP Object Storage (S3-compat)",
      "s3-cold": "NCP Object Storage Cold"
    },
    "pack-eu-hetzner": {
      "pg-hot": "csi.hetzner.cloud/NVMe-local",
      "pg-warm": "csi.hetzner.cloud/SSD",
      "pg-cold": "csi.hetzner.cloud/StorageBox",
      "redis-hot": "csi.hetzner.cloud/NVMe-local",
      "s3-warm": "Hetzner Object Storage",
      "s3-cold": "Hetzner Storage Box"
    },
    "pack-onprem-ceph": {
      "pg-hot": "rook-ceph.rbd.csi.ceph.com/NVMe-pool",
      "pg-warm": "rook-ceph.rbd.csi.ceph.com/SSD-pool",
      "pg-cold": "rook-ceph.rbd.csi.ceph.com/HDD-pool",
      "redis-hot": "rook-ceph.rbd.csi.ceph.com/NVMe-pool",
      "s3-warm": "rook-ceph.rgw (S3-compat)",
      "s3-cold": "rook-ceph.rgw cold-pool"
    },
    "pack-ksa-stc": {
      "pg-hot": "block.csi.stccloud.sa/NVMe",
      "pg-warm": "block.csi.stccloud.sa/SSD",
      "pg-cold": "block.csi.stccloud.sa/HDD",
      "redis-hot": "block.csi.stccloud.sa/NVMe",
      "s3-warm": "STC Object Storage (S3-compat)",
      "s3-cold": "STC Object Storage Cold"
    },
    "pack-uae-g42": {
      "pg-hot": "block.csi.g42.ae/NVMe",
      "pg-warm": "block.csi.g42.ae/SSD",
      "pg-cold": "block.csi.g42.ae/HDD",
      "redis-hot": "block.csi.g42.ae/NVMe",
      "s3-warm": "G42 Object Storage (S3-compat)",
      "s3-cold": "G42 Object Storage Cold"
    },
    "pack-jp-sakura": {
      "pg-hot": "block.csi.sakura.ad.jp/NVMe",
      "pg-warm": "block.csi.sakura.ad.jp/SSD",
      "pg-cold": "block.csi.sakura.ad.jp/HDD",
      "redis-hot": "block.csi.sakura.ad.jp/NVMe",
      "s3-warm": "Sakura Object Storage (S3-compat)",
      "s3-cold": "Sakura Object Storage Cold"
    }
  },
  "csi_driver_requirements": {
    "csi_spec_minimum": "v1.8",
    "volume_snapshots": "VolumeSnapshot v1 CRD required",
    "encryption_at_rest": "StorageClass parameter encrypted: true + kmsKeyId referencing pack KMS/HSM (per ADR-0043)",
    "topology_aware_provisioning": "required (cell affinity)",
    "allow_volume_expansion": "required (true)",
    "reclaim_policy_hot": "Retain",
    "reclaim_policy_cold": "Delete (acceptable for ephemeral backups)"
  },
  "workload_microservice_contract": {
    "rule": "every µservice Helm chart references canonical StorageClass names only",
    "per_pack_binding_path": "microservices/<ms>/iac/kustomize/components/pack-{name}/",
    "no_csi_knowledge_at_workload": "workload µservices NEVER reference cloud-provider-specific volume types directly"
  },
  "ci_lane": "storage-class-canonical (oya gate validate storage-class-canonical)"
}
