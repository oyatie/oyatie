{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.oyatie.com/specs/tenant-lifecycle.schema.json",
  "_meta": {
    "doc_class": "Machine-Readable-Spec",
    "spec_id": "EXE-TENANT-LIFECYCLE",
    "version": "1.0.0",
    "status": "Accepted",
    "enforcement_status": "advisory-until-tenancy-microservice-implements",
    "owner_team": "council-architecture",
    "created_at": "2026-05-18T00:00:00Z",
    "binding_adr": "ADR-0175",
    "purpose": "Canonical six-state tenant lifecycle + saga catalog + per-microservice acknowledgment schema.",
    "user_directive_2026_05_18": "Tenant lifecycle becomes a saga (ADR-0222). Deletion confirmation requires erasure-receipt fan-out (ADR-0038)."
  },
  "title": "Tenant lifecycle canonical schema",
  "type": "object",
  "required": [
    "states",
    "transitions",
    "sagas",
    "acknowledgment_schema"
  ],
  "properties": {
    "states": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "required": [
          "state_id",
          "billable",
          "terminal"
        ],
        "properties": {
          "state_id": {
            "type": "string",
            "enum": [
              "Pending",
              "Active",
              "Suspended",
              "Migrating",
              "Offboarded",
              "DeletionConfirmed",
              "Cancelled"
            ]
          },
          "billable": {
            "type": "boolean"
          },
          "terminal": {
            "type": "boolean"
          }
        }
      },
      "default": [
        {
          "state_id": "Pending",
          "billable": false,
          "terminal": false
        },
        {
          "state_id": "Active",
          "billable": true,
          "terminal": false
        },
        {
          "state_id": "Suspended",
          "billable": true,
          "terminal": false
        },
        {
          "state_id": "Migrating",
          "billable": true,
          "terminal": false
        },
        {
          "state_id": "Offboarded",
          "billable": false,
          "terminal": false
        },
        {
          "state_id": "DeletionConfirmed",
          "billable": false,
          "terminal": true
        },
        {
          "state_id": "Cancelled",
          "billable": false,
          "terminal": true
        }
      ]
    },
    "transitions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to",
          "saga_id"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "saga_id": {
            "type": "string"
          }
        }
      },
      "default": [
        {
          "from": "Pending",
          "to": "Active",
          "saga_id": "onboard_saga"
        },
        {
          "from": "Pending",
          "to": "Cancelled",
          "saga_id": "onboard_saga_failure"
        },
        {
          "from": "Active",
          "to": "Suspended",
          "saga_id": "suspend_saga"
        },
        {
          "from": "Suspended",
          "to": "Active",
          "saga_id": "unsuspend_saga"
        },
        {
          "from": "Active",
          "to": "Migrating",
          "saga_id": "migrate_saga"
        },
        {
          "from": "Migrating",
          "to": "Active",
          "saga_id": "migrate_completion"
        },
        {
          "from": "Migrating",
          "to": "Suspended",
          "saga_id": "migrate_rollback"
        },
        {
          "from": "Active",
          "to": "Offboarded",
          "saga_id": "offboard_saga"
        },
        {
          "from": "Suspended",
          "to": "Offboarded",
          "saga_id": "offboard_saga"
        },
        {
          "from": "Offboarded",
          "to": "DeletionConfirmed",
          "saga_id": "delete_saga"
        }
      ]
    },
    "sagas": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "steps": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "required_audit_class": {
            "type": "string",
            "enum": [
              "TenantLifecycle",
              "TenantLifecycleAck",
              "TenantLifecycleCompensate"
            ]
          }
        }
      },
      "default": {
        "onboard_saga": {
          "steps": [
            {
              "id": "reserve_cell",
              "target": "cell",
              "audit_class": "WriteNonIdempotent"
            },
            {
              "id": "create_identity_entities",
              "target": "tenancy",
              "audit_class": "WriteIdempotent"
            },
            {
              "id": "provision_microservices",
              "target": "*opted-in*",
              "audit_class": "WriteIdempotent"
            },
            {
              "id": "emit_onboarded_event",
              "target": "audit-chain",
              "audit_class": "WriteIdempotent"
            }
          ]
        },
        "delete_saga": {
          "steps": [
            {
              "id": "trigger_dsr_cascade",
              "target": "*data-class-bearing*",
              "audit_class": "SideEffectIrreversible"
            },
            {
              "id": "collect_erasure_receipts",
              "target": "audit-chain",
              "audit_class": "ReadOnly"
            },
            {
              "id": "verify_all_received",
              "target": "audit-chain",
              "audit_class": "ReadOnly"
            },
            {
              "id": "mark_tombstone",
              "target": "tenancy",
              "audit_class": "SideEffectIrreversible"
            },
            {
              "id": "emit_deletion_confirmed",
              "target": "audit-chain",
              "audit_class": "WriteIdempotent"
            }
          ],
          "compensation_allowed": false
        }
      }
    },
    "acknowledgment_schema": {
      "type": "object",
      "properties": {
        "per_microservice_block": {
          "type": "object",
          "properties": {
            "required": {
              "type": "boolean"
            },
            "timeout_ms": {
              "type": "integer",
              "minimum": 1000,
              "maximum": 600000
            }
          }
        }
      }
    },
    "audit_chain_classes": {
      "type": "array",
      "default": [
        "TenantLifecycle",
        "TenantLifecycleAck",
        "TenantLifecycleCompensate"
      ]
    }
  }
}
