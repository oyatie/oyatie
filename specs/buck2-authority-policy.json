  "description": "P0.0 non-claim policy for preventing Cargo regression in active CI/CD/build/script lanes. This file is not a green readiness claim; it defines local/static enforcement and the target controller chain.",
  "forbidden_cargo_subcommands": [
    "fmt",
    "check",
    "clippy",
    "test",
    "nextest",
    "build",
    "run",
    "bench",
    "deny",
    "cyclonedx",
    "install",
    "chef",
    "leptos",
    "llvm-cov",
    "fuzz",
    "mutants",
    "pgo"
  ],
  "forbidden_status_contexts": [
    "cargo-fmt",
    "cargo-check",
    "cargo-clippy",
    "cargo-nextest",
    "cargo-deny",
    "oya-verify"
  ],
  "policy_summary": "Buck2 is the only CI/CD/build/script execution authority. Active Jenkins service CI lanes under cloud/*/ci and oya/*/ci are scanned and must invoke Buck2 policy/build/test targets, not Cargo. Active Dockerfile and client-manifest command surfaces are scanned and must be Buck2 artifact/runtime wrappers, not Cargo compile/test/install lanes. Cargo CLI build/test/run/check/fmt/clippy/nextest/bench/deny/cyclonedx/install/chef/leptos/llvm-cov/fuzz/mutants/pgo invocations are forbidden in active lanes. The only executable Cargo exception is production release image/binary optimization and must carry release evidence for binary-size, codegen, linking, PGO, or memory allocator measurements. Cargo metadata/vendor for Buck2/Reindeer graph generation is metadata-only and never build/test/merge authority.",
  "required_adr_amendment_text": "2026-06-02 Buck2 authority amendment",
