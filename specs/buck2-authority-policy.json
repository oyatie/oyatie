  "allowed_cargo_exceptions": [
    {
      "allowed_subcommands": [
        "build",
        "rustc"
      ],
      "authority_ceiling": "release-artifact optimization evidence only; cannot satisfy CI/CD/build verification, branch protection, or Phase-0 exit",
      "id": "production-release-image-binary-optimization",
      "required_markers": [
        "--release or --profile release-*",
        "target triple",
        "binary size before/after",
        "allocator or codegen setting under test",
        "commit SHA",
        "non-claim label that this is not CI merge authority",
        "representative workload or explicit non-representative label for PGO/allocator experiments",
        "debug-symbol/backtrace/profiling retention decision when strip or panic settings change",
        "Buck2 toolchain/target/OCI handoff plan for any selected optimization"
      ],
      "scope": "Production release images or binaries only, for optimized binary size, codegen, linking, PGO, and memory allocator measurements."
    },
    {
      "allowed_subcommands": [
        "metadata",
        "vendor"
      ],
      "authority_ceiling": "metadata input only; not executable build/test authority",
      "id": "buck2-graph-metadata-only",
      "required_markers": [
        "no binary/test/run/check/fmt/clippy output",
        "generated BUCK review",
        "Buck2 verification after regen"
      ],
      "scope": "Cargo.toml/Cargo.lock metadata extraction for Reindeer/Buck2 third-party graph generation only."
    }
  ],
