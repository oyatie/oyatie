{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.oyatie.com/specs/audit-event-schema.schema.json",
  "title": "Oyatie Audit Event Envelope Schema",
  "description": "Canonical envelope contract for every audit-chain row emitted under ADR-0263. Per ADR-0344 the envelope is extended with five sustainability + finops fields (cost_usd_minor_units, co2_grams, watt_hours, provider, region) plus the derived carbon_intensity_source enum. The envelope is HLC-timestamped per ADR-0252 and tenant-scoped per ADR-0244. This schema is the audit-row-shape spec; the per-class registry (audit-event-class-registry.json) consumes this envelope shape via mandatory_envelope_fields.",
  "version": "2.0.0",
  "_meta": {
    "doc_class": "Machine-Readable-Spec",
    "spec_id": "EXE-AUDIT-EVENT-SCHEMA",
    "status": "Proposed",
    "enforcement_status": "advisory-until-per-microservice-sustainability-emission-model-declared",
    "owner_team": "axis-audit-chain + axis-observability + council-security + ops-finops + ops-compliance",
    "created_at": "2026-05-21T00:00:00Z",
    "schema_version_log_label": "oyatie/log/v2",
    "previous_schema_version_log_label": "oyatie/log/v1",
    "schema_version_log_label_sunset": "2027-05-21",
    "binding_adr": "ADR-0263",
    "extends_adr": "ADR-0344",
    "related_adrs": [
      "ADR-0099",
      "ADR-0150",
      "ADR-0174",
      "ADR-0181",
      "ADR-0212",
      "ADR-0240",
      "ADR-0243",
      "ADR-0244",
      "ADR-0248",
      "ADR-0251",
      "ADR-0252",
      "ADR-0263",
      "ADR-0322",
      "ADR-0336",
      "ADR-0337",
      "ADR-0338",
      "ADR-0344"
    ],
    "purpose": "Define the canonical audit-row envelope. Extended at v2 with the five-field sustainability + finops tuple plus derived carbon_intensity_source methodology provenance per ADR-0344. Schema version oyatie/log/v1 deprecates one year post-ADR-0344 Acceptance."
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "envelope_fields",
    "sustainability_finops_fields",
    "hlc_timestamp_contract",
    "tenant_scoping_contract",
    "schema_version_transitions",
    "update_policy"
  ],
  "properties": {
    "schema_id": {
      "type": "string",
      "const": "audit-event-envelope",
      "description": "Stable schema id for the ADR-0263 + ADR-0344 audit envelope."
    },
    "schema_version": {
      "$ref": "#/definitions/semver",
      "const": "2.0.0",
      "description": "v2.0.0 reflects the ADR-0344 envelope extension."
    },
    "envelope_fields": {
      "type": "array",
      "description": "Mandatory envelope fields inherited by every audit-event class. Per ADR-0263 §D mandatory envelope is extended additively at v2.",
      "minItems": 17,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field_name",
          "type",
          "required",
          "introduced_in_version",
          "description"
        ],
        "properties": {
          "field_name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "type": {
            "type": "string",
            "enum": [
              "string",
              "int64",
              "uint64",
              "iso8601_datetime",
              "hlc_timestamp",
              "enum"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "introduced_in_version": {
            "type": "string",
            "enum": [
              "1.0.0",
              "2.0.0"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 5
          }
        }
      },
      "default": [
        {
          "field_name": "tenant_id",
          "type": "string",
          "required": true,
          "introduced_in_version": "1.0.0",
          "description": "Tenant scope per ADR-0244."
        },
        {
          "field_name": "audit_id",
          "type": "string",
          "required": true,
          "introduced_in_version": "1.0.0",
          "description": "ULID/UUID for this audit row."
        },
        {
          "field_name": "schema_version",
          "type": "string",
          "required": true,
          "introduced_in_version": "1.0.0",
          "description": "Envelope schema version (oyatie/log/v1 or oyatie/log/v2)."
        },
        {
          "field_name": "source_microservice",
          "type": "string",
          "required": true,
          "introduced_in_version": "1.0.0",
          "description": "Emitting microservice name."
        },
        {
          "field_name": "cell_id",
          "type": "string",
          "required": true,
          "introduced_in_version": "1.0.0",
          "description": "Cell where emission occurred per ADR-0248."
        },
        {
          "field_name": "jurisdiction_code",
          "type": "string",
          "required": true,
          "introduced_in_version": "1.0.0",
          "description": "Sovereign jurisdiction code per ADR-0240."
        },
        {
          "field_name": "trace_id",
          "type": "string",
          "required": true,
          "introduced_in_version": "1.0.0",
          "description": "W3C trace context."
        },
        {
          "field_name": "span_id",
          "type": "string",
          "required": true,
          "introduced_in_version": "1.0.0",
          "description": "W3C span id."
        },
        {
          "field_name": "event_id",
          "type": "string",
          "required": true,
          "introduced_in_version": "1.0.0",
          "description": "Per-event identifier within trace."
        },
        {
          "field_name": "sub_scope_path",
          "type": "string",
          "required": true,
          "introduced_in_version": "1.0.0",
          "description": "Per-µservice sub-scope path."
        },
        {
          "field_name": "hlc_timestamp",
          "type": "hlc_timestamp",
          "required": true,
          "introduced_in_version": "1.0.0",
          "description": "Hybrid Logical Clock timestamp per ADR-0252."
        },
        {
          "field_name": "cost_usd_minor_units",
          "type": "int64",
          "required": true,
          "introduced_in_version": "2.0.0",
          "description": "Per-call USD cost in minor units (cents). Computed at emission time per ADR-0344 D-1.1."
        },
        {
          "field_name": "co2_grams",
          "type": "uint64",
          "required": true,
          "introduced_in_version": "2.0.0",
          "description": "Per-call CO2-equivalent emissions in grams. Computed at emission time per ADR-0344 D-1.1."
        },
        {
          "field_name": "watt_hours",
          "type": "uint64",
          "required": true,
          "introduced_in_version": "2.0.0",
          "description": "Per-call energy consumption in watt-hours. Computed at emission time per ADR-0344 D-1.1."
        },
        {
          "field_name": "provider",
          "type": "enum",
          "required": true,
          "introduced_in_version": "2.0.0",
          "description": "Deployment provider serving the call. Enum: oyatie_own/aws/oci/gcp/azure/on_prem/colo/sovereign. Per ADR-0344 D-1.1."
        },
        {
          "field_name": "region",
          "type": "string",
          "required": true,
          "introduced_in_version": "2.0.0",
          "description": "Provider-canonical region identifier. Per ADR-0344 D-1.1."
        },
        {
          "field_name": "carbon_intensity_source",
          "type": "enum",
          "required": true,
          "introduced_in_version": "2.0.0",
          "description": "Derived methodology provenance. Enum: electricitymaps/provider_grid_avg/sovereign_published/cache_hit/cache_miss_fallback. Per ADR-0344 D-1.2."
        }
      ]
    },
    "sustainability_finops_fields": {
      "type": "object",
      "description": "Detailed contract for the five-field sustainability + finops tuple plus derived carbon_intensity_source methodology provenance added at envelope v2 per ADR-0344.",
      "additionalProperties": false,
      "required": [
        "cost_usd_minor_units",
        "co2_grams",
        "watt_hours",
        "provider",
        "region",
        "carbon_intensity_source"
      ],
      "properties": {
        "cost_usd_minor_units": {
          "type": "object",
          "properties": {
            "type": {
              "const": "int64"
            },
            "unit": {
              "const": "usd-cents-or-jurisdiction-minor-unit"
            },
            "computation_path": {
              "const": "microservices/cloud-billing/src/pricing/<provider>_client.rs"
            },
            "cache_substrate": {
              "const": "valkey"
            },
            "cache_key_pattern": {
              "const": "price:{provider}:{region}:{sku}:{hour}"
            },
            "cache_ttl_seconds": {
              "const": 3600
            },
            "adr_section": {
              "const": "ADR-0344 D-1.1 + D-8"
            }
          }
        },
        "co2_grams": {
          "type": "object",
          "properties": {
            "type": {
              "const": "uint64"
            },
            "unit": {
              "const": "grams-co2-equivalent"
            },
            "formula": {
              "const": "watt_hours * region_carbon_intensity_g_co2e_per_kwh / 1000"
            },
            "intensity_source_canonical": {
              "const": "electricityMaps API"
            },
            "intensity_source_fallback_chain": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": [
                "electricitymaps",
                "provider_grid_avg",
                "sovereign_published"
              ]
            },
            "adr_section": {
              "const": "ADR-0344 D-1.1 + D-7"
            }
          }
        },
        "watt_hours": {
          "type": "object",
          "properties": {
            "type": {
              "const": "uint64"
            },
            "unit": {
              "const": "whole-watt-hours"
            },
            "power_model_path": {
              "const": "microservices/<name>/manifest.json#sustainability_emission_model.power_model"
            },
            "workload_signal_source": {
              "const": "observability/per-call-resource-accounting"
            },
            "tier_overhead_factor_applied": {
              "const": true
            },
            "adr_section": {
              "const": "ADR-0344 D-1.1 + D-6"
            }
          }
        },
        "provider": {
          "type": "object",
          "properties": {
            "type": {
              "const": "enum"
            },
            "values": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": [
                "oyatie_own",
                "aws",
                "oci",
                "gcp",
                "azure",
                "on_prem",
                "colo",
                "sovereign"
              ]
            },
            "adr_section": {
              "const": "ADR-0344 D-1.1"
            }
          }
        },
        "region": {
          "type": "object",
          "properties": {
            "type": {
              "const": "string"
            },
            "format_pattern": {
              "const": "<provider>:<region-id> (e.g., aws:us-east-1, oci:ap-seoul-1, on_prem:dc-iad-1)"
            },
            "adr_section": {
              "const": "ADR-0344 D-1.1"
            }
          }
        },
        "carbon_intensity_source": {
          "type": "object",
          "properties": {
            "type": {
              "const": "enum"
            },
            "values": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": [
                "electricitymaps",
                "provider_grid_avg",
                "sovereign_published",
                "cache_hit",
                "cache_miss_fallback"
              ]
            },
            "adr_section": {
              "const": "ADR-0344 D-1.2 + D-7.7"
            }
          }
        }
      }
    },
    "hlc_timestamp_contract": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "binding_adr": {
          "const": "ADR-0252"
        },
        "format": {
          "const": "<iso8601_datetime>/lc=<logical_counter>"
        },
        "co_emission_invariant": {
          "const": "The five sustainability + finops fields share the same HLC tick as the audit row itself; no per-field-staggered emission."
        },
        "ordering_invariant": {
          "const": "Audit rows for the same (tenant_id, cell_id, sub_scope_path) tuple are HLC-monotonic; regulator-export evidence packs refuse out-of-order rows per ADR-0344 B2.029."
        }
      }
    },
    "tenant_scoping_contract": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "binding_adr": {
          "const": "ADR-0244"
        },
        "tenant_id_required": {
          "const": true
        },
        "per_tenant_visibility": {
          "type": "object",
          "properties": {
            "cost_usd_minor_units": {
              "const": "TENANT_VISIBLE for producing tenant; INTERNAL_ONLY for cross-tenant aggregate per ADR-0099 + ADR-0344 B2.012"
            },
            "co2_grams": {
              "const": "TENANT_VISIBLE for producing tenant; INTERNAL_ONLY for cross-tenant aggregate"
            },
            "watt_hours": {
              "const": "TENANT_VISIBLE for producing tenant; INTERNAL_ONLY for cross-tenant aggregate"
            },
            "provider": {
              "const": "TENANT_VISIBLE for producing tenant"
            },
            "region": {
              "const": "TENANT_VISIBLE for producing tenant"
            }
          }
        },
        "cross_tenant_gate": {
          "const": "Cedar per ADR-0243 + ADR-0244"
        }
      }
    },
    "schema_version_transitions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current_version",
        "previous_version",
        "deprecation_window_days",
        "blocker_promotion_day"
      ],
      "properties": {
        "current_version": {
          "const": "oyatie/log/v2"
        },
        "previous_version": {
          "const": "oyatie/log/v1"
        },
        "deprecation_window_days": {
          "type": "integer",
          "const": 365
        },
        "blocker_promotion_day": {
          "type": "integer",
          "const": 30,
          "description": "Day 30 post-ADR-0344 Acceptance: new authoring BLOCKER on v2; per-µservice migration follows ADR-0328 phase order."
        },
        "v1_sunset_audit_class": {
          "const": "audit.schema.v1.deprecated"
        },
        "binding_adr": {
          "const": "ADR-0344 G + ADR-0263 §D-13"
        }
      }
    },
    "update_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requires_originating_adr",
        "requires_reverse_reference_to_adr_0263",
        "requires_reverse_reference_to_adr_0344_when_envelope_extended",
        "requires_class_registry_update",
        "requires_validator_lane"
      ],
      "properties": {
        "requires_originating_adr": {
          "type": "boolean",
          "const": true
        },
        "requires_reverse_reference_to_adr_0263": {
          "type": "boolean",
          "const": true
        },
        "requires_reverse_reference_to_adr_0344_when_envelope_extended": {
          "type": "boolean",
          "const": true
        },
        "requires_class_registry_update": {
          "type": "boolean",
          "const": true,
          "description": "Each envelope-field change requires audit-event-class-registry.json mandatory_envelope_fields synchronization."
        },
        "requires_validator_lane": {
          "type": "string",
          "const": "cloud-ci/Rust gate packet: audit-row-envelope"
        }
      }
    }
  },
  "definitions": {
    "semver": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
    }
  }
}
