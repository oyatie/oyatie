{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.oyatie.com/schemas/master-plan-final-report.schema.json",
  "title": "MasterPlanFinalReport",
  "description": "Schema for the final autonomous master-plan completion report. Requires honest claim boundaries and evidence references.",
  "_meta": {
    "doc_class": "Machine-Readable-Report-Schema",
    "schema_id": "EXE-FINAL-REPORT",
    "status": "draft-sidecar",
    "owner_team": "council-architecture + axis-foundry",
    "related": [
      "/specs/evidence-taxonomy.json",
      "/specs/stop-conditions.json",
      "/specs/hyperscaler-gates.json",
      "docs/templates/postmortem-template.md",
      "docs/templates/mistakes-ledger-row-template.md",
      "docs/templates/evidence-bundle-template.json"
    ],
    "deduplicates_existing": [
      "docs/templates/evidence-bundle-template.json",
      "docs/templates/postmortem-template.md",
      "docs/templates/mistakes-ledger-row-template.md"
    ],
    "purpose": "Schema for the final autonomous master-plan completion report. Requires honest claim boundaries and evidence references."
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_id",
    "generated_at",
    "master_plan_source",
    "completion_summary",
    "ledger",
    "verification_results",
    "documentation_updates",
    "hyperscaler_claim_matrix",
    "critic_summary",
    "remaining_risks",
    "closeout"
  ],
  "properties": {
    "report_id": {
      "type": "string",
      "pattern": "^MPR-[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "master_plan_source": {
      "type": "string"
    },
    "completion_summary": {
      "type": "object",
      "required": [
        "status",
        "total_items",
        "complete_items",
        "blocked_items"
      ],
      "properties": {
        "status": {
          "enum": [
            "complete",
            "blocked"
          ]
        },
        "total_items": {
          "type": "integer",
          "minimum": 0
        },
        "complete_items": {
          "type": "integer",
          "minimum": 0
        },
        "blocked_items": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "ledger": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "item_id",
          "status",
          "evidence_refs"
        ],
        "properties": {
          "item_id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "complete",
              "blocked"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "verification_results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "command_or_lane",
          "status",
          "summary"
        ],
        "properties": {
          "command_or_lane": {
            "type": "string"
          },
          "status": {
            "enum": [
              "pass",
              "blocked",
              "not_applicable",
              "gap_accepted_with_reason"
            ]
          },
          "summary": {
            "type": "string"
          },
          "artifact_ref": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "documentation_updates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "summary"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "hyperscaler_claim_matrix": {
      "type": "object",
      "required": [
        "claims_we_can_make",
        "claims_we_cannot_make_yet",
        "evidence_required_to_make_remaining_claims"
      ],
      "properties": {
        "claims_we_can_make": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "claims_we_cannot_make_yet": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence_required_to_make_remaining_claims": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "critic_summary": {
      "type": "object",
      "required": [
        "findings",
        "fixes_made",
        "rejected_findings"
      ],
      "properties": {
        "findings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fixes_made": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rejected_findings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "remaining_risks": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "string",
          "const": "No known remaining risks"
        }
      ]
    },
    "closeout": {
      "type": "object",
      "required": [
        "oya_vcs_promotion_status",
        "vcs_completion_payload_id"
      ],
      "properties": {
        "oya_vcs_promotion_status": {
          "type": "string"
        },
        "vcs_completion_payload_id": {
          "type": "string"
        },
        "legacy_grit_or_scaffold_status": {
          "type": "string"
        },
        "legacy_icm_completion_memory_id": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  }
}
