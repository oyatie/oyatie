  "hubs": {
    "sole_owner_per_wave": true,
    "paths": [
      "specs/masterplan.json",
      "specs/capability-registry.json",
      "specs/root-hub-pointers.json",
      "docs/ADR-INDEX.md",
      "docs/DOC-CATALOG.md",
      "docs/CHANGELOG.md",
      "governance/check/adr-citation-closure/adr-citation-closure-policy.json",
      "Cargo.lock"
    ],
    "waiver_dir": "governance/check/integ-envelope/waivers/",
    "waiver_row_fields": [
      "branch",
      "hub",
      "reason"
    ],
    "active_waivers": [
      {
        "branch": "integ/specs",
        "hub": "docs/ADR-INDEX.md",
        "reason": "Index ADR-0711 in the same bootstrap PR that introduces the ADR and envelopes (sole-owner hub waiver).",
        "waiver_file": "governance/check/integ-envelope/waivers/integ-specs-adr-0711-bootstrap.yaml"
      },
      {
        "branch": "integ/specs",
        "hub": "governance/check/adr-citation-closure/adr-citation-closure-policy.json",
        "reason": "Absorb #1628+#1629 leaf residuals: files_scanned freeze coupled to lifecycle-config deletions on integ/specs (ADR-0711 dual-trunk closeout).",
        "waiver_file": "governance/check/integ-envelope/waivers/integ-specs-adr-citation-closure-1628-1629.yaml"
      }
    ]
  },
  "adjunct_claims": {
    "description": "A unit may touch paths outside envelope(R) only when an explicit adjunct claim is recorded for this wave. Claims are fail-closed: absent claim = refuse.",
    "required_fields": [
      "path_glob",
      "claiming_branch",
      "reason",
      "expires_at_or_wave"
    ],
    "rules": [
      "Adjunct leaves must be disjoint from every other open integ PR's claimed set.",
      "Hub paths are never adjuncts — they use hub waivers only.",
      "Concurrent-safe exemption paths do not require adjunct claims when the edit is append-only under the registered exemption.",
      "Cargo.lock may travel only with the integ that changed workspace membership (hub rule), never as a silent adjunct."
    ],
    "active": [
      {
        "path_glob": "tools/swarm/**",
        "claiming_branch": "integ/specs",
        "reason": "Bootstrap Swarm Delivery Law Phase A: land tools/swarm shims with the envelopes owner before a dedicated integ/tools wave; tools root registered in this same diff.",
        "expires_at_or_wave": "wave-after-integ-tools-first-land"
      },
      {
        "path_glob": ".claude/workflows/**",
        "claiming_branch": "integ/specs",
        "reason": "deliver.js Claim/Land harness is the primary consumer of envelopes; co-land with policy-as-data on integ/specs.",
        "expires_at_or_wave": "wave-after-integ-tools-first-land"
      },
      {
        "path_glob": ".grok/programs/delivery-fabric/evidence/PORTABLE-SWARM-CONTRACT.md",
        "claiming_branch": "integ/specs",
        "reason": "Portable Swarm Contract is concurrent-safe evidence for the delivery-fabric program and travels with the law bootstrap.",
        "expires_at_or_wave": "wave-after-integ-tools-first-land"
      },
      {
        "path_glob": "docs/decisions/ADR-0711-swarm-delivery-law-integ-branch-topology.md",
        "claiming_branch": "integ/specs",
        "reason": "Single PR preference: ADR-0711 co-lands with envelopes self-owner rather than splitting integ/docs for this bootstrap wave.",
        "expires_at_or_wave": "wave-after-integ-tools-first-land"
      },
      {
        "path_glob": "registry/vcs/concurrent-safe-paths.yaml",
        "claiming_branch": "integ/specs",
        "reason": "Register .beads/** and evidence/** concurrent-safe exemptions required by ADR-0711 D-2 in the same wave as envelopes.",
        "expires_at_or_wave": "wave-after-integ-tools-first-land"
      },
      {
        "path_glob": "governance/check/integ-envelope/waivers/**",
        "claiming_branch": "integ/specs",
        "reason": "Bootstrap hub-waiver directory for Phase A; gate check lands later under integ/governance.",
        "expires_at_or_wave": "wave-after-integ-envelope-gate"
      },
      {
        "path_glob": ".gitignore",
        "claiming_branch": "integ/specs",
        "reason": "Ignore .check/ daemon machine output colocated with tools/swarm check-daemon.",
        "expires_at_or_wave": "wave-after-integ-tools-first-land"
      },
      {
        "path_glob": "plan/**",
        "claiming_branch": "integ/governance",
        "reason": "W1 reorg_now: move plan/ into governance/corpus/ (Amendment B first_wave W1-plan-to-governance).",
        "expires_at_or_wave": "wave-after-plan-vacated"
      },
      {
        "path_glob": "scripts/**",
        "claiming_branch": "integ/ci",
        "reason": "W1 reorg_now: absorb/delete scripts/ into ci/build (Amendment B first_wave W1-scripts-absorb).",
        "expires_at_or_wave": "wave-after-scripts-vacated"
      },
      {
        "path_glob": ".omc/**",
        "claiming_branch": "integ/specs",
        "reason": "W1 delete_permanently: remove tracked OMC residue (Amendment B).",
        "expires_at_or_wave": "wave-after-omc-deleted"
      }
    ]
  },
  "claim_phase": {
    "required_steps": [
      "git fetch",
      "verify unit diff is subset of envelope(R) + claimed adjuncts + waivered hubs",
      "git merge-tree (read-only) against integ tip",
      "verify hub exclusivity against open PRs",
      "admit by cherry-pick",
      "re-verify at push time"
    ],
    "encoded_in": [
      ".claude/workflows/deliver.js#Claim"
    ]
  },
  "concurrent_safe_exemptions": {
    "registry": "registry/vcs/concurrent-safe-paths.yaml",
    "paths": [
      ".beads/**",
      "evidence/**",
      ".grok/programs/*/evidence/**"
    ],
    "note": "Exemptions reduce path-overlap refusal for append-only / per-lane evidence. They do not authorize envelope escape for product code."
  },
  "worker_git_discipline": {
    "allow": [
      "status",
      "diff",
      "log",
      "show",
      "fetch",
      "merge-base",
      "merge-tree",
      "rev-parse",
      "add <explicit paths>",
      "commit",
      "push (blessed script only)"
    ],
    "deny": [
      "stash",
      "reset",
      "clean",
      "restore",
      "checkout",
      "rebase",
      "merge",
      "branch -D/-f",
      "update-ref",
      "reflog expire",
      "gc",
      "push --force (bare)"
    ],
    "enforcement": "tools/swarm/git-shim (Phase A companion)"
  },
  "worktree_topology": {
    "main_checkout": "orchestrator + check daemon only",
    "integ_stations": ".worktrees/integ-<root>",
    "worker_lanes": ".worktrees/lane-<bead>",
    "worker_base_ref": "origin/dev"
  },
  "hyperscaler_monorepo_patterns": {
    "authority": "docs/decisions/ADR-0711-swarm-delivery-law-integ-branch-topology.md#D-9",
    "portable_contract": ".grok/programs/delivery-fabric/evidence/PORTABLE-SWARM-CONTRACT.md#Hyperscaler-monorepo-patterns-first-class",
    "note": "First-class hyperscaler / clean-architecture monorepo rules — not agent-swarm folklore alone. Envelopes, hubs, and worker discipline must stay consistent with these patterns.",
    "cites": [
      "ADR-0119 (flat cross-cutting specs/ hub; product colocation via ADR-0131 amendment)",
      "ADR-0131 (service colocation + product-owned specs; superseded as live apex by ADR-0701)",
      "ADR-0515 (single oya-ci-required; live restatement ADR-0700)",
      "ADR-0541 (g3doc-style owner-colocated docs / corpus liveness)",
      "ADR-0554 (binding affected-set / selective testing)",
      "ADR-0562 (capability-first faces; live apex ADR-0701)",
      "ADR-0700 (CI admission live apex)",
      "ADR-0701 (monorepo capability live apex)"
    ],
    "required": [
      "capability_first_layout_equals_ownership_equals_integ_scope",
      "clean_architecture_per_capability_core_ports_adapters_facade",
      "central_docs_specs_are_cross_cutting_hubs_only_prefer_owner_colocation",
      "trunk_based_scoped_parallel_lanes_serialize_only_at_trunk_and_hub_contention",
      "hermetic_policy_as_data_gates_under_single_oya_ci_required",
      "selective_affected_testing_no_full_monorepo_rebuild_in_worker_lanes",
      "owner_colocated_docs_g3doc_hubs_sole_owned_by_integ_docs_or_integ_specs",
      "concurrent_safe_paths_registry_for_true_concurrent_writers",
      "small_frequent_lands_squash_to_trunk_server_side_integ_reset",
      "codeowners_path_envelope_one_writer_queue_per_integ_tip"
    ],
    "forbidden": [
      "type_based_central_dumping_of_product_artifacts_into_root_specs_docs",
      "n_unit_prs_racing_trunk_under_slow_ci",
      "shared_working_directory_for_parallel_agents",
      "long_lived_divergent_topic_branches_with_date_suffix_durable_names",
      "editing_hub_files_from_every_code_pr_without_sole_owner_or_waiver",
      "agents_running_cargo_buck2_slow_commands_in_worker_lanes",
      "inventing_work_or_lanes_for_empty_verified_space",
      "birthing_new_paths_under_reorg_now_or_delete_prefixes",
      "treating_libs_cloud_oya_infra_toolchains_tools_as_keep_forever",
      "gradual_or_eventual_reorg_language"
    ],
    "docs_specs_planes": {
      "rule": "planes integ/docs and integ/specs own only cross-cutting hubs and indexes; capability product docs/specs colocate under the owning root and travel with that integ/<root>",
      "anti_pattern": "do not create docs/<root> or specs/<root> mirror dumps for product artifacts — that is dual-home debt"
    }
  },
