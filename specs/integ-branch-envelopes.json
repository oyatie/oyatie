    },
    "iam": {
      "branch": "integ/iam",
      "envelope_globs": [
        "iam/**"
      ],
      "note": "Top-level capability root (ADR-0701). Governed under Swarm Delivery Law — ownership = path = integ scope (ADR-0711 D-9)."
    },
