{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.oyatie.com/specs/brownout-degradation-signal.schema.json",
  "_meta": {
    "doc_class": "Machine-Readable-Spec",
    "spec_id": "EXE-BROWNOUT-DEGRADATION-SIGNAL",
    "version": "1.0.0",
    "status": "Accepted",
    "enforcement_status": "advisory-until-public-rpc-coverage-complete",
    "owner_team": "council-architecture",
    "created_at": "2026-05-18T00:00:00Z",
    "binding_adr": "ADR-0176",
    "purpose": "Canonical brown-out + degradation signal — response header + Prometheus gauge + mesh retry-budget contract.",
    "user_directive_2026_05_18": "Standardize graceful-degradation signaling so static-stability + retry-budget decisions have a canonical input."
  },
  "title": "Brown-out degradation signal canonical schema",
  "type": "object",
  "required": [
    "header_name",
    "classes",
    "gauge",
    "retry_budget_multipliers",
    "audit_chain_class"
  ],
  "properties": {
    "header_name": {
      "const": "oya-degradation-class"
    },
    "classes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "class",
          "caller_behavior"
        ],
        "properties": {
          "class": {
            "type": "string",
            "enum": [
              "nominal",
              "degraded",
              "brownout",
              "outage"
            ]
          },
          "caller_behavior": {
            "type": "string"
          },
          "default_when_header_missing": {
            "type": "boolean"
          }
        }
      },
      "default": [
        {
          "class": "nominal",
          "caller_behavior": "Continue normal traffic",
          "default_when_header_missing": true
        },
        {
          "class": "degraded",
          "caller_behavior": "Continue traffic; reduce retry budget; defer non-essential queries",
          "default_when_header_missing": false
        },
        {
          "class": "brownout",
          "caller_behavior": "Fall through to cached/local state if available; reduce non-essential reads to zero",
          "default_when_header_missing": false
        },
        {
          "class": "outage",
          "caller_behavior": "Fail fast; do not retry within the per-cell budget",
          "default_when_header_missing": false
        }
      ]
    },
    "gauge": {
      "type": "object",
      "required": [
        "metric_name",
        "labels",
        "value_mapping"
      ],
      "properties": {
        "metric_name": {
          "const": "oya_degradation_class"
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "microservice",
            "cell_id"
          ]
        },
        "value_mapping": {
          "type": "object",
          "default": {
            "nominal": 0,
            "degraded": 1,
            "brownout": 2,
            "outage": 3
          }
        }
      }
    },
    "retry_budget_multipliers": {
      "type": "object",
      "default": {
        "nominal": 1.0,
        "degraded": 0.5,
        "brownout": 0.1,
        "outage": 0.0
      }
    },
    "audit_chain_class": {
      "const": "DegradationStateChange"
    },
    "decision_logic": {
      "type": "object",
      "properties": {
        "slo_burn_rate_class": {
          "type": "object",
          "default": {
            "nominal_max": 1.0,
            "degraded_max": 2.0,
            "brownout_max": 14.0
          }
        },
        "resource_pressure_class": {
          "type": "object",
          "default": {
            "nominal_max": 0.7,
            "degraded_max": 0.85,
            "brownout_max": 0.95
          }
        },
        "dependency_brownout_class": {
          "type": "string",
          "default": "max_over_required_deps"
        }
      }
    }
  }
}
