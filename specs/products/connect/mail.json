        "messenger",
        "calendar-agenda"
      ],
      "tested_at_breakpoints": [
        "mobile-portrait",
        "tablet",
        "desktop"
      ]
    },
    {
      "component": "PolicyDisclosureBanner",
      "source": "planned design-system primitive",
      "design_system_ref": "$ref:specs/design-system/policy-disclosure-banner.json",
      "variants": [
