      "lane_ref": "compliance"
    }
  ],
  "risks": [
    {
      "id": "R-01",
      "severity": "critical",
      "risk": "KR payroll statutory calculation or filing mismatch",
      "mitigation": "effective-date rulepacks, regulator export hash evidence, parallel-run variance review",
      "owner": "enterprise-product-council"
    },
    {
      "id": "R-02",
      "severity": "critical",
      "risk": "payroll closes without balanced accounting bridge",
      "mitigation": "balanced journal voucher AC and GL bridge gate",
      "owner": "enterprise-product-council"
    },
    {
      "id": "R-03",
      "severity": "high",
      "risk": "group rollup leaks detached entity or personal data",
      "mitigation": "entity close boundary and redacted immutable history tests",
      "owner": "enterprise-product-council"
    }
  ],
  "competitive": [
    {
      "competitor": "Deel",
      "observed_strengths": [
        "global payroll compliance workflow",
        "contractor coverage"
      ],
      "we_beat_on": [
        "KR group legal-entity close evidence",
        "native accounting bridge"
      ],
      "measurable_target": "100% statutory export hash coverage"
    },
    {
      "competitor": "Rippling Payroll",
      "observed_strengths": [
