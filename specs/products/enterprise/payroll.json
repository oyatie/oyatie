        "admin UX"
      ],
      "we_beat_on": [
        "audit-chain close and entity isolation"
      ],
      "measurable_target": "0 entity-boundary violations"
    },
    {
      "competitor": "더존/WEHAGO payroll",
      "observed_strengths": [
        "KR payroll/accounting familiarity"
      ],
      "we_beat_on": [
