    },
    {
      "name": "payroll_to_gl_balance_errors",
      "targets": {
        "preview": 0,
        "stable": 0,
        "GA": 0
      },
      "verification_ref": "cargo nextest -p oya-enterprise-payroll-domain -- gl_bridge_balance",
      "lane_ref": "cargo-nextest"
    },
    {
      "name": "group_close_entity_boundary_violations",
      "targets": {
