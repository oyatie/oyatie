  "north_star_ref": "$ref:bominal/docs/products/corporate/corporate.md#target-shape + $ref:specs/agent-durable-goal.json#pipeline + $ref:specs/deployment-ops-contract.json",
  "target_users": [
    {
      "persona": "employee_end_user",
      "interface": "self-service web/mobile/desktop surfaces",
      "billing": "workspace or enterprise seat"
    },
    {
      "persona": "manager_operator",
      "interface": "approval queue, team dashboard, exception handling",
      "billing": "enterprise seat"
    },
    {
      "persona": "hr_finance_admin",
      "interface": "admin console, imports, policies, close workflow",
      "billing": "tenant admin entitlement"
    },
    {
      "persona": "compliance_officer",
      "interface": "legal hold, audit evidence, statutory filing and control evidence",
      "billing": "compliance module entitlement"
    },
    {
      "persona": "developer_integrator",
      "interface": "REST/gRPC/webhook/Workflow APIs",
      "billing": "API and workflow execution units"
    }
  ],
  "acceptance_criteria": [
    {
      "id": "AC-01",
      "given": "a KR payroll run is created",
      "when": "the run enters trial close",
      "then": "each payee has legal_entity_id, payee_class, rulepack_effective_date, wage ledger, and evidence digest",
      "test_ref": "crates/oya-enterprise-payroll-domain/tests/kr_close.rs::test_trial_close_requires_rulepack_and_evidence"
    },
    {
      "id": "AC-02",
      "given": "a group tenant has multiple legal entities",
      "when": "payroll closes for the group",
      "then": "each entity closes independently before group rollup and detachment history remains immutable/redacted",
      "test_ref": "crates/oya-enterprise-payroll-domain/tests/group.rs::test_entity_close_before_group_rollup"
    },
    {
      "id": "AC-03",
      "given": "KR statutory exports are generated",
      "when": "HomeTax/4대보험/withholding evidence is emitted",
      "then": "export hashes, receipts or rejection reasons, and rollback/repair plan are attached before promotion",
      "test_ref": "crates/oya-enterprise-payroll-domain/tests/filing.rs::test_kr_exports_require_hashes_and_receipts"
    },
    {
      "id": "AC-04",
      "given": "payroll is approved for posting",
      "when": "the accounting bridge runs",
      "then": "balanced GL journal vouchers are produced with source payroll digest and approval evidence",
      "test_ref": "crates/oya-enterprise-payroll-domain/tests/accounting_bridge.rs::test_payroll_posts_balanced_journals"
    },
    {
      "id": "AC-05",
      "given": "a production close canary or evidence gate fails",
      "when": "the controller evaluates launch health",
      "then": "close promotion stops, rollback/quarantine evidence is emitted, and repair routes through hotfix PR or OpenTofu/ops convergence",
      "test_ref": "crates/oya-enterprise-payroll-domain/tests/rollback.rs::test_failed_close_uses_rollback_first"
    }
  ],
  "scope": {
    "in_scope_per_wave": {
      "preview": [
        "payee abstraction",
        "KR wage ledger",
        "trial close",
        "basic tax/social-insurance calculations",
        "payroll evidence envelope"
      ],
      "stable": [
        "parallel-run variance review",
        "year-end settlement inputs",
        "statutory export hashes",
        "payroll-to-GL journal bridge"
      ],
      "GA": [
        "paid KR group client production close",
        "rulepack certification evidence",
        "multi-entity group rollup",
        "restore/rollback drills"
      ]
    },
    "out_of_scope": [
      {
        "item": "direct statutory agency submission without credentials/certification",
        "why": "regulator credentials and XSD certification remain external readiness gates"
      },
      {
        "item": "direct banking as baseline",
        "why": "payments adapter is a separate product integration after evidence-safe close"
      },
      {
        "item": "owner payroll for sole proprietorship",
        "why": "KR entity-kind semantics route owner income outside payroll"
      }
    ]
  },
  "contracts": {
    "consumes": [
      "enterprise.hr.employee.v1",
      "enterprise.hr.attendance.v1",
      "enterprise.accounting.journal.v1",
      "workflow.approval.v1",
      "ontology.Payee"
    ],
    "produces": [
      "enterprise.payroll.run.v1",
      "enterprise.payroll.wage_ledger.v1",
      "enterprise.payroll.kr_statutory_export.v1",
      "enterprise.payroll.gl_bridge.v1"
    ]
  },
  "data_model": {
    "entities_ref": [
      {
        "entity": "PayrollRun",
        "fields": [
          "run_id",
          "tenant_id",
          "legal_entity_id",
          "period",
          "state",
          "rulepack_ref",
          "variance_report_ref",
          "evidence_digest",
          "data_class"
        ],
        "invariants": [
          "trial close before production close",
          "rulepack effective date required"
        ]
      },
      {
        "entity": "Payee",
        "fields": [
          "payee_id",
          "tenant_id",
          "legal_entity_id",
          "payee_class",
          "person_or_vendor_ref",
          "tax_profile_ref",
          "data_class"
        ],
        "invariants": [
          "employee is one payee class",
          "sole proprietor owner is not payroll employee"
        ]
      },
      {
        "entity": "WageLedgerEntry",
        "fields": [
          "entry_id",
          "run_id",
          "payee_id",
          "line_kind",
          "amount",
          "currency",
          "source_ref",
          "audit_topic"
        ],
        "invariants": [
          "append-only",
          "corrections are compensating entries"
        ]
      }
    ],
    "events_emitted": [
      {
        "event": "PayrollTrialCloseCompleted",
        "topic": "audit.enterprise.payroll.close",
        "idempotency_key": "run_id+trial_version"
      },
      {
        "event": "PayrollStatutoryExportHashed",
        "topic": "audit.enterprise.payroll.filing",
        "idempotency_key": "run_id+export_kind+hash"
      },
      {
        "event": "PayrollGlJournalPosted",
        "topic": "enterprise.payroll.accounting",
        "idempotency_key": "run_id+journal_id"
      }
    ],
    "persistence": [
      {
        "aggregate": "PayrollRun",
        "store": "Postgres/RLS",
        "sharding_key": "tenant_id+legal_entity_id+period",
        "retention": "statutory payroll archive"
      },
      {
        "aggregate": "PayrollEvidence",
        "store": "audit-chain/WORM + object store digests",
        "sharding_key": "tenant_id+legal_entity_id+period",
        "retention": "jurisdiction bounded"
      }
    ],
    "audit_chain_emission_rule_ref": "$ref:docs/decisions/ADR-0003 + $ref:specs/agent-durable-goal.json#score_cards"
  },
  "optimization_practices": [
    {
      "practice": "legal-entity cell routing",
      "implementation": "tenant_id + legal_entity_id + region route every transactional write; group rollups are projections, not shared mutable ledgers"
    },
    {
      "practice": "approval backpressure",
      "implementation": "Workflow queues expose SLA and exception budgets before operator inboxes overload"
    },
    {
      "practice": "evidence-first close",
      "implementation": "payroll, accounting, compliance, and incident workflows emit immutable evidence paths before promotion/resume"
    }
  ],
  "regional_packs": {
    "region_policy_ref": "$ref:docs/decisions/ADR-0140 + $ref:bominal/decisions/ADR-0140",
    "packs": [
      {
        "pack": "KR",
        "required": true,
        "notes": "Korea-first HR/payroll/accounting fidelity: Labor Standards Act, 4대보험, HomeTax, K-GAAP/K-IFRS, PIPA, ISMS-P, SAPA, rules-of-employment and labor-management-council thresholds."
      },
      {
        "pack": "US",
        "required": true,
        "notes": "US expansion keeps payroll tax, benefits, FMLA/ADA/EEOC, GAAP, SOX-style controls, and multi-state employer obligations behind jurisdiction rulepacks."
      },
      {
        "pack": "EU",
        "required": true,
        "notes": "EU expansion covers GDPR, works-council/local labor overlays, VAT, statutory accounting exports, and data-residency policy."
      }
    ],
    "validation_lane_ref": "oya-foundry-fitness-regional-pack-contracts"
  },
  "deps": {
    "external_adopted": [
      {
        "name": "serde",
        "maturity_tier": "kernel-grade",
        "license": "MIT OR Apache-2.0",
        "decision": "wire-format primitive only"
      },
      {
        "name": "tokio",
        "maturity_tier": "kernel-grade",
        "license": "MIT",
        "decision": "async runtime primitive only"
      },
      {
        "name": "rustls",
        "maturity_tier": "kernel-grade",
        "license": "Apache-2.0 OR ISC OR MIT",
        "decision": "TLS primitive only"
      }
    ],
    "external_rejected": [
      {
        "name": "Workday/Oracle/SAP as product substrate",
        "reason": "Enterprise suite is native; external suites are migration/coexistence adapters only"
      },
      {
        "name": "manual shell/SSH operational glue",
        "reason": "deployment and day-2 authority belongs to OpenTofu, Makefile targets, Rust oya gates, and ops-managed controllers"
      },
      {
        "name": "AI-only compliance or close decisions",
        "reason": "deterministic rulepacks and audit-chain evidence remain closure authority"
      }
    ]
  },
  "metrics": [
    {
      "name": "kr_payroll_close_variance_bps",
      "targets": {
        "preview": 100,
        "stable": 25,
        "GA": 10
      },
      "verification_ref": "cargo nextest -p oya-enterprise-payroll-domain -- kr_close_variance",
      "lane_ref": "cargo-nextest"
