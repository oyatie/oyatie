  "north_star_ref": "$ref:bominal/docs/products/corporate/corporate.md#target-shape + $ref:specs/agent-durable-goal.json#pipeline + $ref:specs/deployment-ops-contract.json",
  "target_users": [
    {
      "persona": "employee_end_user",
      "interface": "self-service web/mobile/desktop surfaces",
      "billing": "workspace or enterprise seat"
    },
    {
      "persona": "manager_operator",
      "interface": "approval queue, team dashboard, exception handling",
      "billing": "enterprise seat"
    },
    {
      "persona": "hr_finance_admin",
      "interface": "admin console, imports, policies, close workflow",
      "billing": "tenant admin entitlement"
    },
    {
      "persona": "compliance_officer",
      "interface": "legal hold, audit evidence, statutory filing and control evidence",
      "billing": "compliance module entitlement"
    },
    {
      "persona": "developer_integrator",
      "interface": "REST/gRPC/webhook/Workflow APIs",
      "billing": "API and workflow execution units"
    }
  ],
  "acceptance_criteria": [
    {
      "id": "AC-01",
      "given": "a journal voucher is posted",
      "when": "the accounting service persists it",
      "then": "debits equal credits, legal_entity_id is present, period is open, and audit-chain evidence links source documents",
      "test_ref": "crates/oya-enterprise-accounting-domain/tests/journal.rs::test_post_requires_balanced_open_period"
    },
    {
      "id": "AC-02",
      "given": "a payroll run posts to accounting",
      "when": "the payroll bridge emits a journal",
      "then": "source payroll digest, wage ledger refs, approval evidence, and reversal path are recorded",
      "test_ref": "crates/oya-enterprise-accounting-domain/tests/payroll_bridge.rs::test_payroll_digest_required_for_posting"
    },
    {
      "id": "AC-03",
      "given": "a KR VAT period reaches filing date",
      "when": "deadline calendar evaluates the tenant",
      "then": "VAT return workflow opens with HomeTax export hash, review, and evidence requirements",
      "test_ref": "crates/oya-enterprise-accounting-domain/tests/vat.rs::test_kr_vat_deadline_opens_workflow"
    },
    {
      "id": "AC-04",
      "given": "a procurement/AP invoice needs approval",
      "when": "approval thresholds are evaluated",
      "then": "Workflow routes policy, budget, vendor, and evidence checks before posting liability or payment request",
      "test_ref": "crates/oya-enterprise-accounting-domain/tests/ap.rs::test_invoice_approval_before_liability_post"
    },
    {
      "id": "AC-05",
      "given": "financial close evidence is incomplete",
      "when": "close promotion is requested",
      "then": "close is refused, missing evidence paths are reported, and no manual shell/SSH workaround is offered",
      "test_ref": "crates/oya-enterprise-accounting-domain/tests/close.rs::test_close_refuses_missing_evidence"
    }
  ],
  "scope": {
    "in_scope_per_wave": {
      "preview": [
        "chart of accounts",
        "journal vouchers",
        "trial balance",
        "payroll bridge contract",
        "VAT deadline model"
      ],
      "stable": [
        "AP/AR invoices",
        "procurement approvals",
        "close checklist evidence",
        "K-GAAP/K-IFRS mapping"
      ],
      "GA": [
        "KR statutory close",
        "multi-entity consolidation projections",
        "auditor evidence pack",
        "restore/rollback drills"
      ]
    },
    "out_of_scope": [
      {
        "item": "manual spreadsheet close as production evidence",
        "why": "close evidence must be typed, hashed, and audit chained"
      },
      {
        "item": "banking/payment execution as required baseline",
        "why": "payments product adapter is a separate integration after liability/evidence is deterministic"
      },
      {
        "item": "single mutable consolidated ledger",
        "why": "legal entities remain durable ledger boundaries"
      }
    ]
  },
  "contracts": {
    "consumes": [
      "enterprise.payroll.gl_bridge.v1",
      "workflow.approval.v1",
      "ontology.Invoice",
      "enterprise.legal_entity_context.v1"
    ],
    "produces": [
      "enterprise.accounting.journal.v1",
      "enterprise.accounting.trial_balance.v1",
      "enterprise.accounting.vat_return.v1",
      "enterprise.accounting.close_evidence.v1"
    ]
  },
  "data_model": {
    "entities_ref": [
      {
        "entity": "JournalVoucher",
        "fields": [
          "journal_id",
          "tenant_id",
          "legal_entity_id",
          "period",
          "state",
          "lines",
          "source_ref",
          "approval_ref",
          "data_class"
        ],
        "invariants": [
          "debits equal credits",
          "period open before post"
        ]
      },
      {
        "entity": "Account",
        "fields": [
          "account_id",
          "tenant_id",
          "legal_entity_id",
          "code",
          "name",
          "standard_mapping",
          "normal_balance",
          "data_class"
        ],
        "invariants": [
          "code unique per legal entity"
        ]
      },
      {
        "entity": "VatReturnWorkflow",
        "fields": [
          "return_id",
          "tenant_id",
          "legal_entity_id",
          "period",
          "deadline",
          "state",
          "export_hash",
          "evidence_paths"
        ],
        "invariants": [
          "deadline calendar source required"
        ]
      }
    ],
    "events_emitted": [
      {
        "event": "JournalVoucherPosted",
        "topic": "audit.enterprise.accounting.journal",
        "idempotency_key": "journal_id+post_version"
      },
      {
        "event": "VatReturnEvidenceEmitted",
        "topic": "audit.enterprise.accounting.vat",
        "idempotency_key": "return_id+export_hash"
      },
      {
        "event": "AccountingClosePromoted",
        "topic": "audit.enterprise.accounting.close",
        "idempotency_key": "tenant_id+legal_entity_id+period+close_version"
      }
    ],
    "persistence": [
      {
        "aggregate": "JournalVoucher",
        "store": "Postgres/RLS",
        "sharding_key": "tenant_id+legal_entity_id+period",
        "retention": "statutory accounting archive"
      },
      {
        "aggregate": "AccountingCloseEvidence",
        "store": "audit-chain/WORM + object store digests",
        "sharding_key": "tenant_id+legal_entity_id+period",
        "retention": "jurisdiction bounded"
      }
    ],
    "audit_chain_emission_rule_ref": "$ref:docs/decisions/ADR-0003 + $ref:specs/agent-durable-goal.json#score_cards"
  },
  "optimization_practices": [
    {
      "practice": "legal-entity cell routing",
      "implementation": "tenant_id + legal_entity_id + region route every transactional write; group rollups are projections, not shared mutable ledgers"
    },
    {
      "practice": "approval backpressure",
      "implementation": "Workflow queues expose SLA and exception budgets before operator inboxes overload"
    },
    {
      "practice": "evidence-first close",
      "implementation": "payroll, accounting, compliance, and incident workflows emit immutable evidence paths before promotion/resume"
    }
  ],
  "regional_packs": {
    "region_policy_ref": "$ref:docs/decisions/ADR-0140 + $ref:bominal/decisions/ADR-0140",
    "packs": [
      {
        "pack": "KR",
        "required": true,
        "notes": "Korea-first HR/payroll/accounting fidelity: Labor Standards Act, 4대보험, HomeTax, K-GAAP/K-IFRS, PIPA, ISMS-P, SAPA, rules-of-employment and labor-management-council thresholds."
      },
      {
        "pack": "US",
        "required": true,
        "notes": "US expansion keeps payroll tax, benefits, FMLA/ADA/EEOC, GAAP, SOX-style controls, and multi-state employer obligations behind jurisdiction rulepacks."
      },
      {
        "pack": "EU",
        "required": true,
        "notes": "EU expansion covers GDPR, works-council/local labor overlays, VAT, statutory accounting exports, and data-residency policy."
      }
    ],
    "validation_lane_ref": "oya-foundry-fitness-regional-pack-contracts"
  },
  "deps": {
    "external_adopted": [
      {
        "name": "serde",
        "maturity_tier": "kernel-grade",
        "license": "MIT OR Apache-2.0",
        "decision": "wire-format primitive only"
      },
      {
        "name": "tokio",
        "maturity_tier": "kernel-grade",
        "license": "MIT",
        "decision": "async runtime primitive only"
      },
      {
        "name": "rustls",
        "maturity_tier": "kernel-grade",
        "license": "Apache-2.0 OR ISC OR MIT",
        "decision": "TLS primitive only"
      }
    ],
    "external_rejected": [
      {
        "name": "Workday/Oracle/SAP as product substrate",
        "reason": "Enterprise suite is native; external suites are migration/coexistence adapters only"
      },
      {
        "name": "manual shell/SSH operational glue",
        "reason": "deployment and day-2 authority belongs to OpenTofu, Makefile targets, Rust oya gates, and ops-managed controllers"
      },
      {
        "name": "AI-only compliance or close decisions",
        "reason": "deterministic rulepacks and audit-chain evidence remain closure authority"
      }
    ]
  },
