      "lane_ref": "audit-chain"
    }
  ],
  "risks": [
    {
      "id": "R-01",
      "severity": "critical",
      "risk": "unbalanced or cross-entity journal posting",
      "mitigation": "double-entry invariant and legal-entity-scoped accounts",
      "owner": "enterprise-product-council"
    },
    {
      "id": "R-02",
      "severity": "high",
      "risk": "KR VAT or close deadline missed",
      "mitigation": "deadline calendar workflow and evidence gate",
      "owner": "enterprise-product-council"
    },
    {
      "id": "R-03",
      "severity": "high",
      "risk": "payroll/accounting mismatch causes financial statement drift",
      "mitigation": "source payroll digest and reconciliation gate before close",
      "owner": "enterprise-product-council"
    }
  ],
  "competitive": [
    {
      "competitor": "NetSuite",
      "observed_strengths": [
        "ERP accounting breadth",
        "global close process"
      ],
      "we_beat_on": [
        "Workflow/Object Graph-native close evidence",
        "ops-managed deployment"
      ],
      "measurable_target": "0 missing-evidence close promotions"
    },
    {
      "competitor": "QuickBooks/Xero",
      "observed_strengths": [
        "SME accounting UX",
        "ecosystem integrations"
      ],
      "we_beat_on": [
        "enterprise legal-entity controls and KR statutory depth"
      ],
      "measurable_target": "VAT workflow coverage 100% by stable"
    },
    {
      "competitor": "더존 iCUBE/WEHAGO accounting",
      "observed_strengths": [
        "KR accounting/tax footprint"
      ],
      "we_beat_on": [
        "payroll/accounting audit digest and rollback-first launch evidence"
      ],
      "measurable_target": "payroll journal source digest coverage 100%"
    }
  ],
  "best_practices": [
    "double-entry invariant at persistence boundary",
    "legal-entity ledgers before group projections",
    "deadline calendars as workflows",
    "source digest for every imported posting",
    "evidence-gated close"
  ],
  "patterns": [
    "balanced voucher posting",
    "period open/close state machine",
    "AP approval through Workflow",
    "VAT return evidence envelope",
    "immutable close promotion"
  ],
  "anti_patterns": [
    "manual spreadsheet close as authority",
    "unscoped consolidated ledger",
    "posting to closed period without reversal workflow",
    "payroll posting without digest",
    "manual shell workaround for missing close evidence"
  ],
  "goals": {
    "scalability": {
      "target": "EnterpriseAccounting supports SME self-serve through conglomerate legal-entity groups without forked code paths",
      "verification": "oya gate validate enterprise-enterpriseaccounting-scale-model"
    },
    "security": {
      "target": "tenant, legal-entity, payroll, accounting, and evidence data remain RLS/policy isolated; privileged disclosure is audit chained",
      "verification": "cargo nextest -p oya-enterprise-security-domain -- cross_tenant"
    },
    "performance": {
      "target": "operator hot paths p95 <= 200ms for preview and <= 150ms for GA under representative tenant shape",
      "verification": "cargo bench -p oya-enterprise-bench -- enterprise_hot_paths"
    },
    "efficiency": {
      "target": "unit economics tracked per employee, pay run, journal posting, evidence item, and workflow action",
      "verification": "oya gate validate enterprise-finops-unit-economics"
    },
    "reliability": {
      "target": "GA availability 99.95%; RPO <= 5m for professional data; rollback evidence emitted before root-cause analysis",
      "verification": "oya gate validate enterprise-slo-coverage"
    }
  },
  "user_experience": {
    "primary_navigation": "suite shell with HR, Payroll, Accounting, approvals, evidence, and admin work queues; personal/work context boundaries inherited from the workspace shell where applicable",
    "critical_flows": [
