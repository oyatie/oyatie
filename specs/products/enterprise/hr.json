  "_meta": {
    "doc_class": "Machine-Readable-Spec",
    "spec_id": "PRD-ENTERPRISE-HR",
    "version": "1.0.0",
    "status": "Accepted",
    "owner_team": "enterprise-product-council",
    "created_at": "2026-05-16T16:15:00Z",
    "purpose": "Enterprise HR PRD: employee lifecycle, org hierarchy, time/attendance, leave, recruiting, performance, benefits hooks, and KR/US/EU labor-compliance evidence under Enterprise Suite governance."
  },
  "identity": {
    "product_id": "enterprise-hr",
    "suite_id": "enterprise",
    "owning_axis": "vertical-enterprise",
    "product_class": "suite-app",
    "user_facing_surface": true,
    "context_model": [
      "tenant-work"
    ],
    "crate_refs_planned": [
      "oya-enterprise-hr-kernel",
      "oya-enterprise-hr-domain",
      "oya-enterprise-hr-app",
      "oya-enterprise-hr-rest"
    ],
    "ops_surface": "managed through OpenTofu-owned infrastructure, root Makefile bootstrap/install/plan/apply targets, and oya ops surfaces; no manual SSH troubleshooting path"
  },
  "inherits": {
    "bominal_adrs": [
      "$ref:bominal/docs/products/corporate/corporate.md",
      "$ref:bominal/docs/products/corporate/hr-payroll-known-limits.md",
