      "$ref:specs/products/ontology.json",
      "$ref:specs/deployment-ops-contract.json",
      "$ref:specs/products/connect/suite.json"
    ],
    "source_docs": [
      "$ref:/Users/jasonlee/bominal/docs/products/corporate/corporate.md",
      "$ref:/Users/jasonlee/bominal/docs/products/corporate/hr-payroll-known-limits.md",
      "$ref:/Users/jasonlee/bominal/docs/products/corporate/sme-vs-conglomerate-coverage.md",
      "$ref:/Users/jasonlee/bominal/docs/products/corporate/m3-kr-group-payroll-mail-prd.md",
      "$ref:/Users/jasonlee/bominal/docs/products/corporate/corp-compliance-vertical-design.md"
    ],
    "user_decisions": [
      "2026-05-16:D-13 one PRD per suite plus per-app sub-PRDs",
      "2026-05-16:D-15 canonical PRD form is JSON-with-pointers at specs/products/<id>.json",
      "2026-05-16:enterprise scope starts with HR, Payroll, Accounting and remains extensible for every business SaaS module",
      "2026-05-16:deployment must be OpenTofu + Makefile + oya ops; no manual SSH troubleshooting",
      "2026-05-16:shell-script operations must move to Rust where logic exists"
    ]
  },
  "north_star_ref": "$ref:bominal/docs/products/corporate/corporate.md#target-shape + $ref:specs/agent-durable-goal.json#pipeline + $ref:specs/deployment-ops-contract.json",
  "target_users": [
    {
      "persona": "employee_end_user",
      "interface": "self-service web/mobile/desktop surfaces",
      "billing": "workspace or enterprise seat"
    },
    {
      "persona": "manager_operator",
      "interface": "approval queue, team dashboard, exception handling",
      "billing": "enterprise seat"
    },
    {
      "persona": "hr_finance_admin",
      "interface": "admin console, imports, policies, close workflow",
      "billing": "tenant admin entitlement"
    },
    {
      "persona": "compliance_officer",
      "interface": "legal hold, audit evidence, statutory filing and control evidence",
      "billing": "compliance module entitlement"
    },
    {
      "persona": "developer_integrator",
      "interface": "REST/gRPC/webhook/Workflow APIs",
      "billing": "API and workflow execution units"
    }
  ],
  "acceptance_criteria": [
    {
      "id": "AC-01",
      "given": "a tenant creates or updates an employee",
      "when": "the employment record is persisted",
      "then": "tenant_id, legal_entity_id, manager_id, employment_status, data_class, and audit evidence are present",
      "test_ref": "crates/oya-enterprise-hr-domain/tests/employment.rs::test_employment_requires_entity_and_audit"
    },
    {
      "id": "AC-02",
      "given": "a Korean entity crosses 10 employees",
      "when": "Rules of Employment obligation is evaluated",
      "then": "Workflow opens Drafted -> EmployeeReviewSent -> MajorityConsentObtained -> MoelFiled -> Active evidence path",
      "test_ref": "crates/oya-enterprise-hr-domain/tests/kr_rules.rs::test_rules_of_employment_threshold_opens_workflow"
    },
    {
      "id": "AC-03",
      "given": "a Korean entity crosses 30 employees",
      "when": "labor-management council obligation is evaluated",
      "then": "council roster, meeting cadence, and minutes evidence requirements activate",
      "test_ref": "crates/oya-enterprise-hr-domain/tests/kr_council.rs::test_labor_management_council_threshold"
    },
    {
      "id": "AC-04",
      "given": "an employee requests leave or attendance correction",
      "when": "a manager approves or rejects it",
      "then": "Workflow records delegation/escalation, labor-law rulepack basis, and payroll-impact evidence",
      "test_ref": "crates/oya-enterprise-hr-domain/tests/leave.rs::test_leave_approval_emits_payroll_impact"
    },
    {
      "id": "AC-05",
      "given": "an org admin attempts to access medical or sensitive HR data",
      "when": "policy evaluates the read",
      "then": "purpose-bound access, consent/legal basis, and sensitive-read logging are required",
      "test_ref": "crates/oya-enterprise-hr-domain/tests/privacy.rs::test_sensitive_hr_read_requires_basis"
    }
  ],
  "scope": {
    "in_scope_per_wave": {
      "preview": [
        "employee lifecycle",
        "org hierarchy",
        "basic attendance",
        "manager approvals",
        "KR threshold obligations"
      ],
      "stable": [
        "leave/PTO",
        "benefits hooks",
        "recruiting/performance shells",
        "rules-of-employment and council workflows"
      ],
      "GA": [
        "KR labor-law evidence",
        "US/EU rulepack expansion",
        "native client parity",
        "high-volume group HR operations"
      ]
    },
    "out_of_scope": [
      {
        "item": "employer access to personal context data",
        "why": "enterprise HR owns work/personnel records only"
      },
      {
        "item": "hardware access control as required MVP",
        "why": "badge/NFC integrations are adapter modules after core attendance is deterministic"
      },
      {
        "item": "AI-only HR decisions",
        "why": "employment, leave, and compliance decisions require deterministic policy/evidence"
      }
    ]
  },
  "contracts": {
    "consumes": [
      "enterprise.legal_entity_context.v1",
      "workflow.approval.v1",
      "ontology.Employee",
      "deployment.ops.v1"
    ],
    "produces": [
      "enterprise.hr.employee.v1",
      "enterprise.hr.attendance.v1",
      "enterprise.hr.leave.v1",
      "enterprise.hr.compliance_obligation.v1"
    ]
  },
  "data_model": {
    "entities_ref": [
      {
        "entity": "Employee",
        "fields": [
          "employee_id",
          "tenant_id",
          "legal_entity_id",
          "person_ref",
          "manager_id",
          "employment_status",
          "tenant_tier_snapshot",
          "data_class",
          "schema_version"
        ],
        "invariants": [
          "legal_entity_id required",
          "status transitions audit chained"
        ]
      },
      {
        "entity": "AttendanceSegment",
        "fields": [
          "segment_id",
          "employee_id",
          "legal_entity_id",
          "start_at",
          "end_at",
          "source",
          "approval_state",
          "payroll_impact_ref",
          "data_class"
        ],
        "invariants": [
          "approved segment required before payroll derivation"
        ]
      },
      {
        "entity": "LaborComplianceObligation",
        "fields": [
          "obligation_id",
          "jurisdiction",
          "trigger",
          "state",
          "workflow_ref",
          "evidence_paths",
          "effective_date"
        ],
        "invariants": [
          "effective-date rulepack required"
        ]
      }
    ],
    "events_emitted": [
      {
        "event": "EmployeeLifecycleChanged",
        "topic": "audit.enterprise.hr.employee",
        "idempotency_key": "employee_id+version"
      },
      {
        "event": "AttendanceApproved",
        "topic": "enterprise.hr.attendance",
        "idempotency_key": "segment_id+approval_version"
      },
      {
        "event": "LaborComplianceWorkflowOpened",
        "topic": "audit.enterprise.hr.compliance",
        "idempotency_key": "tenant_id+legal_entity_id+obligation_id"
      }
    ],
    "persistence": [
      {
        "aggregate": "Employee",
        "store": "Postgres/RLS",
        "sharding_key": "tenant_id+legal_entity_id",
        "retention": "employment lifecycle + jurisdiction archive"
      },
      {
        "aggregate": "LaborComplianceEvidence",
        "store": "audit-chain/WORM",
        "sharding_key": "tenant_id+legal_entity_id+obligation_id",
        "retention": "jurisdiction bounded"
      }
    ],
    "audit_chain_emission_rule_ref": "$ref:docs/decisions/ADR-0003 + $ref:specs/agent-durable-goal.json#score_cards"
  },
  "optimization_practices": [
    {
      "practice": "legal-entity cell routing",
      "implementation": "tenant_id + legal_entity_id + region route every transactional write; group rollups are projections, not shared mutable ledgers"
    },
    {
      "practice": "approval backpressure",
      "implementation": "Workflow queues expose SLA and exception budgets before operator inboxes overload"
    },
    {
      "practice": "evidence-first close",
      "implementation": "payroll, accounting, compliance, and incident workflows emit immutable evidence paths before promotion/resume"
    }
  ],
  "regional_packs": {
    "region_policy_ref": "$ref:docs/decisions/ADR-0140 + $ref:bominal/decisions/ADR-0140",
    "packs": [
      {
        "pack": "KR",
        "required": true,
        "notes": "Korea-first HR/payroll/accounting fidelity: Labor Standards Act, 4대보험, HomeTax, K-GAAP/K-IFRS, PIPA, ISMS-P, SAPA, rules-of-employment and labor-management-council thresholds."
      },
      {
        "pack": "US",
        "required": true,
        "notes": "US expansion keeps payroll tax, benefits, FMLA/ADA/EEOC, GAAP, SOX-style controls, and multi-state employer obligations behind jurisdiction rulepacks."
      },
      {
        "pack": "EU",
        "required": true,
        "notes": "EU expansion covers GDPR, works-council/local labor overlays, VAT, statutory accounting exports, and data-residency policy."
      }
    ],
    "validation_lane_ref": "oya-foundry-fitness-regional-pack-contracts"
  },
  "deps": {
    "external_adopted": [
      {
        "name": "serde",
        "maturity_tier": "kernel-grade",
        "license": "MIT OR Apache-2.0",
        "decision": "wire-format primitive only"
      },
      {
        "name": "tokio",
        "maturity_tier": "kernel-grade",
        "license": "MIT",
        "decision": "async runtime primitive only"
      },
      {
        "name": "rustls",
        "maturity_tier": "kernel-grade",
        "license": "Apache-2.0 OR ISC OR MIT",
        "decision": "TLS primitive only"
      }
    ],
    "external_rejected": [
      {
        "name": "Workday/Oracle/SAP as product substrate",
        "reason": "Enterprise suite is native; external suites are migration/coexistence adapters only"
      },
      {
        "name": "manual shell/SSH operational glue",
        "reason": "deployment and day-2 authority belongs to OpenTofu, Makefile targets, Rust oya gates, and ops-managed controllers"
      },
      {
        "name": "AI-only compliance or close decisions",
        "reason": "deterministic rulepacks and audit-chain evidence remain closure authority"
      }
    ]
  },
  "metrics": [
    {
      "name": "employee_lifecycle_policy_bypass_count",
      "targets": {
        "preview": 0,
        "stable": 0,
        "GA": 0
      },
      "verification_ref": "cargo nextest -p oya-enterprise-hr-domain -- lifecycle_policy",
      "lane_ref": "cargo-nextest"
    },
    {
      "name": "kr_obligation_trigger_coverage_pct",
      "targets": {
        "preview": 90,
        "stable": 100,
        "GA": 100
      },
      "verification_ref": "oya gate validate enterprise-hr-kr-obligations",
      "lane_ref": "compliance"
    },
    {
      "name": "attendance_to_payroll_derivation_accuracy_pct",
      "targets": {
        "preview": 99,
        "stable": 99.9,
        "GA": 99.99
      },
      "verification_ref": "cargo nextest -p oya-enterprise-hr-domain -- attendance_payroll_bridge",
      "lane_ref": "cargo-nextest"
    },
    {
      "name": "sensitive_hr_read_audit_coverage_pct",
      "targets": {
        "preview": 100,
        "stable": 100,
        "GA": 100
      },
      "verification_ref": "oya gate validate enterprise-hr-sensitive-read-audit",
      "lane_ref": "audit-chain"
    }
  ],
  "risks": [
    {
      "id": "R-01",
      "severity": "critical",
      "risk": "labor-law threshold obligations silently missed",
      "mitigation": "TenantTier/legal-entity rulepack gates and obligation workflows",
      "owner": "enterprise-product-council"
    },
    {
      "id": "R-02",
      "severity": "high",
      "risk": "sensitive HR data accessed without purpose/legal basis",
      "mitigation": "purpose-bound policy + sensitive-read audit events",
      "owner": "enterprise-product-council"
    },
    {
      "id": "R-03",
      "severity": "medium",
      "risk": "attendance data insufficient for payroll accuracy",
      "mitigation": "approved segment requirement before payroll derivation",
      "owner": "enterprise-product-council"
    }
  ],
  "competitive": [
    {
      "competitor": "Workday HCM",
      "observed_strengths": [
        "enterprise HR breadth",
        "workflow maturity"
      ],
      "we_beat_on": [
        "KR threshold evidence",
        "Workflow/Object Graph cohesion"
      ],
      "measurable_target": "100% threshold-triggered obligations open workflow within 1 controller tick"
    },
    {
      "competitor": "Rippling HRIS",
      "observed_strengths": [
        "employee lifecycle automation",
        "device/app admin linkage"
      ],
      "we_beat_on": [
        "audit-chain labor evidence",
        "legal-entity close coupling"
      ],
      "measurable_target": "0 lifecycle policy bypasses"
    },
    {
      "competitor": "WEHAGO HR",
      "observed_strengths": [
        "Korean SME HR/payroll coupling"
      ],
      "we_beat_on": [
        "group legal-entity model and ops-managed deployment"
      ],
      "measurable_target": "KR obligations trigger coverage 100% by GA"
    }
  ],
  "best_practices": [
    "purpose-bound sensitive access",
    "jurisdiction-effective-dated HR rulepacks",
    "attendance before pay derivation",
    "employee lifecycle as audit chain",
    "manager approvals through Workflow"
  ],
  "patterns": [
    "TenantTier threshold triggers",
    "legal-entity-scoped employee records",
    "sensitive-read audit",
    "compensating status changes",
    "rulepack-backed leave/attendance"
  ],
  "anti_patterns": [
    "hidden HR admin bypasses",
    "free-form sensitive reads",
    "global employee records without legal entity",
    "AI-driven employment decisions without deterministic policy",
    "manual spreadsheet payroll bridges"
  ],
  "goals": {
    "scalability": {
      "target": "EnterpriseHr supports SME self-serve through conglomerate legal-entity groups without forked code paths",
      "verification": "oya gate validate enterprise-enterprisehr-scale-model"
    },
    "security": {
      "target": "tenant, legal-entity, payroll, accounting, and evidence data remain RLS/policy isolated; privileged disclosure is audit chained",
      "verification": "cargo nextest -p oya-enterprise-security-domain -- cross_tenant"
    },
    "performance": {
      "target": "operator hot paths p95 <= 200ms for preview and <= 150ms for GA under representative tenant shape",
      "verification": "cargo bench -p oya-enterprise-bench -- enterprise_hot_paths"
    },
    "efficiency": {
      "target": "unit economics tracked per employee, pay run, journal posting, evidence item, and workflow action",
      "verification": "oya gate validate enterprise-finops-unit-economics"
    },
    "reliability": {
      "target": "GA availability 99.95%; RPO <= 5m for professional data; rollback evidence emitted before root-cause analysis",
      "verification": "oya gate validate enterprise-slo-coverage"
    }
  },
  "user_experience": {
    "primary_navigation": "suite shell with HR, Payroll, Accounting, approvals, evidence, and admin work queues; personal/work context boundaries inherited from the workspace shell where applicable",
    "critical_flows": [
      "tenant onboarding",
      "employee lifecycle",
      "payroll trial close",
      "GL posting review",
      "statutory filing evidence",
      "incident/rollback evidence review"
    ],
    "accessibility": {
      "baseline": "WCAG 2.1 AA",
      "keyboard_required": true,
      "screen_reader_required": true
    },
    "localization": {
      "default_locale": "ko-KR",
      "required_locales": [
        "ko-KR",
        "en-US"
      ],
      "currency_handling": [
        "KRW",
        "USD",
        "EUR"
      ]
    }
  },
  "frontend_components": [
    {
      "component": "EnterprisePolicyDisclosureBanner",
      "design_system_ref": "$ref:specs/design-system/policy-disclosure-banner.json",
      "tested_at_breakpoints": [
        "mobile-360",
        "tablet-768",
        "desktop-1440"
      ]
    },
    {
      "component": "EnterpriseWorkQueueList",
      "design_system_ref": "$ref:specs/design-system/communication-thread-list.json",
      "tested_at_breakpoints": [
        "mobile-360",
        "tablet-768",
        "desktop-1440"
      ]
    }
  ],
  "decision_log": [
    {
      "id": "D-01",
      "decision": "Machine-readable PRD JSON is canonical; no new Markdown PRD is introduced.",
      "date": "2026-05-16"
    },
    {
      "id": "D-02",
      "decision": "OpenTofu + Makefile + oya ops are the deployment/ops path; manual SSH troubleshooting is explicitly out of scope.",
