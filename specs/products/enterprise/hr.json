      "$ref:bominal/docs/products/corporate/m3-kr-group-payroll-mail-prd.md",
      "$ref:bominal/docs/products/corporate/corp-compliance-vertical-design.md"
    ],
    "oyatie_specs": [
      "$ref:specs/agent-durable-goal.json",
