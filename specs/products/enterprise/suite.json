    "version": "1.0.0",
    "status": "Accepted",
    "owner_team": "enterprise-product-council",
    "created_at": "2026-05-16T16:15:00Z",
    "purpose": "Enterprise suite PRD: native business operating system bundling HR, Payroll, Accounting, compliance evidence, approvals, and operating intelligence under shared Workflow/Object Graph/ops contracts."
  },
  "identity": {
    "product_id": "enterprise-suite",
    "suite_id": "enterprise",
    "owning_axis": "vertical-enterprise",
    "product_class": "suite",
    "user_facing_surface": true,
    "context_model": [
      "tenant-work",
      "legal-entity-group"
    ],
    "crate_refs_planned": [
      "oya-enterprise-suite-kernel",
      "oya-enterprise-suite-domain",
      "oya-enterprise-suite-app",
      "oya-enterprise-suite-rest"
    ],
    "ops_surface": "managed through OpenTofu-owned infrastructure, root Makefile bootstrap/install/plan/apply targets, and oya ops surfaces; no manual SSH troubleshooting path",
    "children": [
      "$ref:specs/products/enterprise/hr.json",
      "$ref:specs/products/enterprise/payroll.json",
      "$ref:specs/products/enterprise/accounting.json"
    ],
    "suite_boundary": "business operating system shell; child products own runtime domains while sharing identity, policy, approval, Workflow, Object Graph, audit-chain, and ops seams"
  },
  "inherits": {
