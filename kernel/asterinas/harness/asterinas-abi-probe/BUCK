# A1 ABI-matrix probe harness (skeleton). Pure matrix load + stub probe plan are
# hermetic (buck2/cargo unit-tested). Live QEMU guest probing is a later impure
# path — preferred evidence is QEMU-TCG against the pinned Asterinas ISO
# (no live hardware required).
#
# The rust_binary target is a local-bridge harness receipt emitter (retirement-
# marked; same class as asterinas-real-boot bins), not a product CLI capability.
# The rust_library is the sanctioned automation surface.

_MATRIX = "//kernel/asterinas/core/asterinas-abi-matrix:kernel-asterinas-abi-matrix"
_BOUNDARY = "//kernel/asterinas/core/asterinas-boundary:kernel-asterinas-boundary"
_TP = ["third-party//:serde_json"]

rust_library(
    name = "kernel-asterinas-abi-probe",
    srcs = glob(["src/lib.rs"]),
    crate = "kernel_asterinas_abi_probe",
    crate_root = "src/lib.rs",
    visibility = ["PUBLIC"],
    deps = [_MATRIX, _BOUNDARY] + _TP,
)

# Local-bridge only — not a product CLI surface (CLI retirement).
rust_binary(
    name = "kernel-asterinas-abi-probe-bin",
    srcs = ["src/main.rs"],
    crate_root = "src/main.rs",
    visibility = ["PUBLIC"],
    deps = [":kernel-asterinas-abi-probe", _MATRIX, _BOUNDARY] + _TP,
)

rust_test(
    name = "kernel-asterinas-abi-probe-unittest",
    srcs = glob(["src/lib.rs"]),
    crate = "kernel_asterinas_abi_probe",
    crate_root = "src/lib.rs",
    visibility = ["PUBLIC"],
    deps = [_MATRIX, _BOUNDARY] + _TP,
)

rust_test(
    name = "kernel-asterinas-abi-probe-integration",
    srcs = ["tests/probe_plan_integration.rs"],
    crate_root = "tests/probe_plan_integration.rs",
    visibility = ["PUBLIC"],
    deps = [":kernel-asterinas-abi-probe", _MATRIX] + _TP,
)
