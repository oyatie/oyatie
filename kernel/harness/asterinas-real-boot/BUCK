# Owned-Rust real-boot harness (ADR-0523 no-shell/no-python/no-CLI). The pure fetch+verify
# logic + receipt shape live in the library (buck2-unit-tested, network-free); the binary
# performs the single permitted external surface: the release-asset download via the typed
# reqwest HTTP client (rustls => aws-lc-rs, ADR-0506; ring is never activated).

# Shared dependency sets — declared once so the common deps stay in sync across every target
# (DRY; a bump edits one list, not five). `_BOUNDARY` = the compile-time upstream pin + closed
# marker set; `_TP_CORE` = serde_json + sha2 (receipts + digests), used by every target;
# `_REGEX` = the marker-scan regex, used only where boot-verdict logic compiles.
_BOUNDARY = "//kernel/core/asterinas-boundary:kernel-asterinas-boundary"
_TP_CORE = ["third-party//:serde_json", "third-party//:sha2"]
_REGEX = ["third-party//:regex"]

rust_library(
    name = "kernel-asterinas-real-boot",
    srcs = glob(["src/lib.rs"]),
    crate = "kernel_asterinas_real_boot",
    crate_root = "src/lib.rs",
    visibility = ["PUBLIC"],
    deps = [_BOUNDARY] + _REGEX + _TP_CORE,
)

rust_binary(
    name = "kernel-asterinas-real-boot-fetch-verify",
    srcs = ["src/main.rs"],
    crate_root = "src/main.rs",
    visibility = ["PUBLIC"],
    deps = [":kernel-asterinas-real-boot", _BOUNDARY, "third-party//:reqwest"] + _TP_CORE,
)

rust_binary(
    # AC2/AC3 boot orchestration binary: the permitted std::process external-tool surface
    # (invokes qemu-system-x86_64). Boots the ISO once, captures the raw serial log by
    # redirection, derives the boot verdict from the closed marker set, and writes the receipts.
    name = "kernel-asterinas-real-boot-boot",
    srcs = ["src/boot.rs"],
    crate_root = "src/boot.rs",
    visibility = ["PUBLIC"],
    deps = [":kernel-asterinas-real-boot", _BOUNDARY] + _REGEX + _TP_CORE,
)

rust_test(
    name = "kernel-asterinas-real-boot-unittest",
    srcs = glob(["src/lib.rs"]),
    crate = "kernel_asterinas_real_boot",
    crate_root = "src/lib.rs",
    visibility = ["PUBLIC"],
    deps = [_BOUNDARY] + _REGEX + _TP_CORE,
)

rust_test(
    # AC3 integration test: exercises the boot-receipt assembly + honest fail-path escalation
    # (finalize_boot_evidence) end-to-end against on-disk serial-log fixtures, covering BOTH the
    # boot-reached and non-boot outcomes. No QEMU / no network — deterministic file-only fixtures.
    name = "kernel-asterinas-real-boot-integration",
    srcs = ["tests/boot_finalize_integration.rs"],
    crate_root = "tests/boot_finalize_integration.rs",
    visibility = ["PUBLIC"],
    deps = [":kernel-asterinas-real-boot", _BOUNDARY] + _TP_CORE,
)

rust_binary(
    # SHARD-2 SOAK orchestration binary: the permitted std::process external-tool surface
    # (invokes qemu-system-x86_64). Verifies the ISO once, then runs up to 3 whole-soak attempts
    # of 10 fresh-VM cold boots each, and writes the per-attempt + aggregate receipts (honest-fail
    # gap-register on exhaustion). The soak loop + receipt assembly are the pure harness::soak lib.
    name = "kernel-asterinas-real-boot-soak",
    srcs = ["src/soak.rs"],
    crate_root = "src/soak.rs",
    visibility = ["PUBLIC"],
    # soak.rs scans no markers itself (it delegates to the lib, which owns _REGEX transitively),
    # so the binary carries no direct regex dep — matches the -soak-integration/-integration sets.
    deps = [":kernel-asterinas-real-boot", _BOUNDARY] + _TP_CORE,
)

rust_test(
    # SHARD-2 SOAK integration test: exercises the PURE soak loop + attempt/aggregate/honest-fail
    # assembly (run_soak_with_boot_runner) end-to-end against on-disk serial-log fixtures, covering
    # a clean 10/10 pass, a failed-attempt retry with no cross-attempt aggregation, and the
    # exhausted honest-fail gap-register. No QEMU / no network — deterministic file-only fixtures.
    name = "kernel-asterinas-real-boot-soak-integration",
    srcs = ["tests/soak_integration.rs"],
    crate_root = "tests/soak_integration.rs",
    visibility = ["PUBLIC"],
    deps = [":kernel-asterinas-real-boot", _BOUNDARY] + _TP_CORE,
)
