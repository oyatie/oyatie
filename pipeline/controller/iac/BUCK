# Package the controller Helm surface so its YAML is a build-graph input
# (corpus-index unpackaged ratchet). Content forever tip remains integ/ci.
filegroup(
    name = "ci-controller-iac",
    srcs = glob(["**/*"]),
    visibility = ["PUBLIC"],
)

# Index this package's YAML into the corpus liveness graph (ADR-0541).
genrule(
    name = "corpus-yaml-facts",
    srcs = glob(["**/*.yaml", "**/*.yml"]),
    out = "yaml-facts.json",
    cmd = "$(exe //governance/corpus/extract:yaml-facts) --target root//pipeline/controller/iac:corpus-yaml-facts --prefix ci/controller/iac --out $OUT $SRCS",
)
