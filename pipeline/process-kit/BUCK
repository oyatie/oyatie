    name = "process-kit-check-daemon",
    srcs = glob(["src/**/*.rs"]),
    crate_root = "src/bin/check_daemon.rs",
    visibility = ["PUBLIC"],
    deps = [
        ":process-kit",
    ],
)

rust_test(
    name = "process-kit-unittest",
    srcs = glob(["src/**/*.rs"]),
    crate = "process_kit",
    crate_root = "src/lib.rs",
    visibility = ["PUBLIC"],
    deps = [],
)
