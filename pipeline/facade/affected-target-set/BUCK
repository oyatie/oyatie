# ADR-0554 round-3 build-health ratchet: compares the buck2 build-report failure set at the PR
# head against the merge-base, blocking only REGRESSIONS (grandfathering pre-existing build debt)
# so the FULL tier is a ratchet, not a flag-day requirement. Reuses the ADR-0551 merge-base
# frozen-baseline pattern; the merge-base report is materialized out-of-band (never candidate-controlled).
rust_binary(
    name = "cloud-ci-build-health-bin",
    srcs = glob(["src/**/*.rs"]),
    crate_root = "src/bin/cloud-ci-build-health.rs",
    visibility = ["PUBLIC"],
    deps = [
        ":ci-affected-target-set",
        # Owned GitHub REST adapter. This binary previously shelled out to `gh`, which is absent
        # from the owned arm64 runner image, so the trusted-baseline fast path was dark on the
        # whole fleet and every FULL-tier run paid the cold merge-base rebuild.
        "third-party//:reqwest",
        "third-party//:serde_json",
        "third-party//:sha2",
    ],
)

# GH #1323/#899 trusted-baseline selector coverage: pins every fail-closed seam of the cross-run
# baseline consumer (provenance selection, kind scoping, expiry, malformed payloads) so the FULL
# tier can only skip its cold merge-base rebuild on a fully validated push-to-dev baseline.
rust_test(
    name = "cloud-ci-build-health-unittest",
    srcs = glob(["src/**/*.rs"]),
    crate = "cloud_ci_build_health_unittest",
    crate_root = "src/bin/cloud-ci-build-health.rs",
    visibility = ["PUBLIC"],
    deps = [
        ":ci-affected-target-set",
        "third-party//:reqwest",
        "third-party//:serde_json",
        "third-party//:sha2",
    ],
)

