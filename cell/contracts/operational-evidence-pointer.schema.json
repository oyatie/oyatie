{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.oyatie.com/schemas/operational-evidence-pointer.schema.json",
  "title": "Public Operational Evidence Pointer",
  "description": "Closed, data-minimized pointer to privately custodied operational evidence. Validity proves only persistence and verified remote readback.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "artifact_class",
    "digest_algorithm",
    "content_digest",
    "custody_boundary",
    "remote_readback",
    "claim_ceiling"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "const": "../contracts/operational-evidence-pointer.schema.json",
      "oyatie.data_class": "PUBLIC"
    },
    "artifact_class": {
      "type": "string",
      "const": "internal_operational_receipt",
      "oyatie.data_class": "PUBLIC"
    },
    "digest_algorithm": {
      "type": "string",
      "const": "sha256",
      "oyatie.data_class": "PUBLIC"
    },
    "content_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "oyatie.data_class": "PUBLIC"
    },
    "custody_boundary": {
      "type": "string",
      "const": "private_operational_evidence",
      "oyatie.data_class": "PUBLIC"
    },
    "remote_readback": {
      "type": "string",
      "const": "verified",
      "oyatie.data_class": "PUBLIC"
    },
    "claim_ceiling": {
      "type": "string",
      "const": "persistence_and_remote_readback_only",
      "description": "Does not prove current health, authorization, placement, software versions, topology, failures, recovery-artifact hashes, provider or object location, or secret state.",
      "oyatie.data_class": "PUBLIC"
    }
  },
  "_meta": {
    "doc_class": "Machine-Readable-Schema",
    "status": "source-authored",
    "purpose": "Publish a content digest and remote-readback fact without publishing operational receipt metadata or location.",
    "binding_authority": "/specs/active-machine-readable-artifact-contract.json",
    "enforcement_status": "JSON Schema validation is required; digest-to-filename binding awaits an owned Rust validator."
  }
}
