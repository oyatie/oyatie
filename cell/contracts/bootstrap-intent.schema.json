{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.oyatie.com/schemas/bootstrap-intent.schema.json",
  "title": "BootstrapIntent",
  "description": "Provider-neutral desired state for creating, adopting, reconciling, recovering, or quiescing Genesis and cell targets through owned ports and adapter bindings.",
  "version": "1.0.0",
  "_meta": {
    "doc_class": "Machine-Readable-Schema",
    "status": "source-authored",
    "purpose": "Give one API request a portable, resumable, receipt-driven bootstrap contract without provider primitives or credential values.",
    "binding_authority": "/specs/substrate-dependency-dag.json#dependency_units[id=cell.genesis]",
    "implementation_state": "specified_not_implemented",
    "semantic_validator_requirements": [
      "reject provider names, provider identifiers, shapes, instance types, raw regions, raw network identifiers, and credential values outside adapter-owned bindings",
      "require every phase dependency to resolve and the phase graph to be acyclic",
      "require homogeneous production control-plane architecture and a qualified image release for every node pool",
      "reject riscv64 production placement until its release profile is independently qualified",
      "enforce both directions between adopted_protected ownership and compute lifecycle protection: safe existing-resource strategies only, termination protection enabled, and replacement and retirement disabled",
      "treat compute lifecycle protection and payload data disposition as orthogonal; approved_discard may discard old payload data without authorizing resource termination, replacement, or retirement",
      "bind every apply to a fresh observation digest, authorization-decision receipt, intent digest, adapter-plan digest, and idempotency key"
    ],
    "engineering_rigor": {
      "maintainability": "Logical profiles and capability contracts remain stable while adapters and implementations change.",
      "observability": "Every operation and phase emits a redacted immutable receipt with success and failure state.",
      "scalability": "One intent can contain independent targets while preserving per-target failure domains and lifecycle.",
      "performance": "Reconciliation is asynchronous and bounded by per-target concurrency, never a serving hot path.",
      "optimization": "Observe-before-mutate and exact resume semantics avoid duplicate work and needless recreation.",
      "code_quality": "Closed fields, semantic gates, fault injection, and independent review are required before qualification."
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "api_version",
    "kind",
    "metadata",
    "authorization",
    "operation",
    "targets",
    "evidence"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "const": "../contracts/bootstrap-intent.schema.json",
      "oyatie.data_class": "PUBLIC"
    },
    "api_version": {
      "type": "string",
      "const": "cell.oyatie.com/v1alpha1",
      "oyatie.data_class": "PUBLIC"
    },
    "kind": {
      "type": "string",
      "const": "BootstrapIntent",
      "oyatie.data_class": "PUBLIC"
    },
    "metadata": {
      "$ref": "#/$defs/metadata",
      "oyatie.data_class": "INTERNAL_ONLY"
    },
    "authorization": {
      "$ref": "#/$defs/authorization",
      "oyatie.data_class": "INTERNAL_ONLY"
    },
    "operation": {
      "$ref": "#/$defs/operation",
      "oyatie.data_class": "INTERNAL_ONLY"
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/target"
      },
      "oyatie.data_class": "INTERNAL_ONLY"
    },
    "evidence": {
      "$ref": "#/$defs/evidence",
      "oyatie.data_class": "INTERNAL_ONLY"
    }
  },
  "$defs": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intent_id",
        "revision",
        "idempotency_key",
        "supersedes_intent_digest"
      ],
      "properties": {
        "intent_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,95}$",
          "oyatie.data_class": "INTERNAL_ONLY"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "oyatie.data_class": "INTERNAL_ONLY"
        },
        "idempotency_key": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9._:-]{16,128}$",
          "oyatie.data_class": "INTERNAL_ONLY"
        },
        "supersedes_intent_digest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$",
          "oyatie.data_class": "INTERNAL_ONLY"
        }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "principal_ref",
        "purpose",
        "decision_receipt_ref",
        "credential_handle_ref",
        "credential_expires_at",
        "one_time",
        "revocable",
        "fail_closed"
      ],
      "properties": {
        "principal_ref": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9:._/-]{2,191}$",
          "description": "Opaque caller identity reference; never a raw external identity identifier.",
          "oyatie.data_class": "INTERNAL_ONLY"
        },
        "purpose": {
          "type": "string",
          "enum": [
            "genesis_bootstrap",
            "cell_bootstrap",
            "reconcile",
            "recover",
            "quiesce"
          ],
          "oyatie.data_class": "INTERNAL_ONLY"
        },
        "decision_receipt_ref": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9:._/-]{2,191}$",
          "description": "Opaque fail-closed policy-decision receipt reference.",
          "oyatie.data_class": "INTERNAL_ONLY"
        },
        "credential_handle_ref": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9:._/-]{2,191}$",
          "description": "SecretAuthority handle only; credential values are forbidden.",
          "oyatie.data_class": "INTERNAL_ONLY"
        },
        "credential_expires_at": {
          "type": "string",
          "format": "date-time",
          "oyatie.data_class": "INTERNAL_ONLY"
        },
        "one_time": {
          "type": "boolean",
          "const": true,
          "oyatie.data_class": "INTERNAL_ONLY"
        },
        "revocable": {
          "type": "boolean",
          "const": true,
          "oyatie.data_class": "INTERNAL_ONLY"
        },
        "fail_closed": {
          "type": "boolean",
          "const": true,
          "oyatie.data_class": "INTERNAL_ONLY"
        }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "dry_run_first",
        "resume_policy",
        "cleanup_policy",
        "max_parallel_targets"
      ],
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "plan",
            "reconcile",
            "resume",
            "verify",
            "rollback",
            "quiesce"
          ],
          "description": "Request-level state-machine action; create-versus-adopt is target-local.",
          "oyatie.data_class": "INTERNAL_ONLY"
        },
        "dry_run_first": {
          "type": "boolean",
          "const": true,
          "oyatie.data_class": "INTERNAL_ONLY"
        },
        "resume_policy": {
          "type": "string",
          "const": "first_incomplete_receipted_phase",
          "oyatie.data_class": "INTERNAL_ONLY"
        },
        "cleanup_policy": {
          "type": "string",
          "const": "current_operation_owned_resources_only",
          "oyatie.data_class": "INTERNAL_ONLY"
        },
        "max_parallel_targets": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2,
          "oyatie.data_class": "INTERNAL_ONLY"
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_id",
        "role",
        "lifecycle",
        "placement",
        "node_pools",
        "profiles",
        "trust",
        "connectivity",
        "protection"
      ],
      "properties": {
        "target_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,95}$",
          "oyatie.data_class": "INTERNAL_ONLY"
        },
        "role": {
          "type": "string",
          "enum": [
            "genesis_dr",
            "development_cell",
            "fleet_management_cell",
            "serving_cell"
          ],
          "oyatie.data_class": "INTERNAL_ONLY"
        },
        "lifecycle": {
          "$ref": "#/$defs/lifecycle",
          "oyatie.data_class": "INTERNAL_ONLY"
        },
        "placement": {
          "$ref": "#/$defs/placement",
          "oyatie.data_class": "INTERNAL_ONLY"
        },
        "node_pools": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/nodePool"
          },
          "oyatie.data_class": "INTERNAL_ONLY"
        },
        "profiles": {
          "$ref": "#/$defs/profiles",
          "oyatie.data_class": "INTERNAL_ONLY"
        },
        "trust": {
          "$ref": "#/$defs/trust",
          "oyatie.data_class": "INTERNAL_ONLY"
        },
        "connectivity": {
          "$ref": "#/$defs/connectivity",
          "oyatie.data_class": "INTERNAL_ONLY"
        },
        "protection": {
          "$ref": "#/$defs/protection",
          "oyatie.data_class": "INTERNAL_ONLY"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "protection": {
                "properties": {
                  "protected_from_termination": {
                    "const": true,
                    "oyatie.data_class": "INTERNAL_ONLY"
                  }
                },
                "required": [
                  "protected_from_termination"
                ],
                "oyatie.data_class": "INTERNAL_ONLY"
              }
            },
            "required": [
              "protection"
            ]
          },
          "then": {
            "properties": {
              "lifecycle": {
                "properties": {
                  "strategy": {
                    "enum": [
                      "must_adopt",
                      "reconcile_existing",
                      "recover",
                      "quiesce"
                    ],
                    "oyatie.data_class": "INTERNAL_ONLY"
                  },
                  "ownership": {
                    "const": "adopted_protected",
                    "oyatie.data_class": "INTERNAL_ONLY"
                  }
                },
                "required": [
                  "strategy",
                  "ownership"
                ],
                "oyatie.data_class": "INTERNAL_ONLY"
              },
              "protection": {
                "properties": {
                  "replace_allowed": {
                    "const": false,
                    "oyatie.data_class": "INTERNAL_ONLY"
                  },
                  "retire_allowed": {
                    "const": false,
                    "oyatie.data_class": "INTERNAL_ONLY"
                  }
                },
                "required": [
                  "replace_allowed",
                  "retire_allowed"
                ],
                "oyatie.data_class": "INTERNAL_ONLY"
              }
            },
            "required": [
              "lifecycle",
              "protection"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "lifecycle": {
                "properties": {
                  "ownership": {
                    "const": "adopted_protected",
                    "oyatie.data_class": "INTERNAL_ONLY"
                  }
                },
                "required": [
                  "ownership"
                ],
                "oyatie.data_class": "INTERNAL_ONLY"
              }
            },
            "required": [
              "lifecycle"
            ]
          },
          "then": {
            "properties": {
              "lifecycle": {
                "properties": {
                  "strategy": {
                    "enum": [
                      "must_adopt",
                      "reconcile_existing",
                      "recover",
                      "quiesce"
                    ],
                    "oyatie.data_class": "INTERNAL_ONLY"
                  }
                },
                "required": [
                  "strategy"
                ],
                "oyatie.data_class": "INTERNAL_ONLY"
              },
              "protection": {
                "properties": {
                  "protected_from_termination": {
                    "const": true,
                    "oyatie.data_class": "INTERNAL_ONLY"
                  },
                  "replace_allowed": {
                    "const": false,
                    "oyatie.data_class": "INTERNAL_ONLY"
                  },
                  "retire_allowed": {
                    "const": false,
                    "oyatie.data_class": "INTERNAL_ONLY"
                  }
                },
                "required": [
                  "protected_from_termination",
                  "replace_allowed",
                  "retire_allowed"
                ],
                "oyatie.data_class": "INTERNAL_ONLY"
              }
            },
            "required": [
              "lifecycle",
              "protection"
            ]
          }
        }
      ]
    },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jurisdiction",
        "site_ref",
        "failure_domain_count",
        "residency_profile_ref",
        "adapter_binding_ref"
      ],
      "properties": {
        "jurisdiction": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,63}$",
          "oyatie.data_class": "INTERNAL_ONLY"
        },
        "site_ref": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,127}$",
          "oyatie.data_class": "INTERNAL_ONLY"
        },
        "failure_domain_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32,
          "oyatie.data_class": "INTERNAL_ONLY"
        },
        "residency_profile_ref": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,127}$",
          "oyatie.data_class": "INTERNAL_ONLY"
        },
        "adapter_binding_ref": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z][a-z0-9-]{2,127}$",
          "description": "Opaque execution binding; provider mechanisms remain outside intent.",
          "oyatie.data_class": "INTERNAL_ONLY"
        }
      }
    },
    "nodePool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pool_id",
        "role",
        "architecture",
        "support_tier",
        "replicas",
        "resource_envelope",
        "image_release_ref"
      ],
      "properties": {
        "pool_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,95}$",
          "oyatie.data_class": "INTERNAL_ONLY"
        },
        "role": {
          "type": "string",
          "enum": [
            "control_plane",
            "worker"
          ],
          "oyatie.data_class": "INTERNAL_ONLY"
        },
        "architecture": {
          "type": "string",
          "enum": [
            "amd64",
            "arm64",
            "riscv64"
          ],
          "oyatie.data_class": "INTERNAL_ONLY"
        },
        "support_tier": {
          "type": "string",
          "enum": [
            "production",
            "lab",
            "unavailable"
          ],
          "oyatie.data_class": "INTERNAL_ONLY"
        },
        "replicas": {
          "type": "integer",
          "minimum": 0,
          "maximum": 99,
          "oyatie.data_class": "INTERNAL_ONLY"
        },
        "resource_envelope": {
          "$ref": "#/$defs/resourceEnvelope",
          "oyatie.data_class": "INTERNAL_ONLY"
        },
        "image_release_ref": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,159}$",
          "oyatie.data_class": "INTERNAL_ONLY"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "architecture": {
                "const": "riscv64",
                "oyatie.data_class": "INTERNAL_ONLY"
              }
            },
            "required": [
              "architecture"
            ]
          },
          "then": {
            "properties": {
              "support_tier": {
                "enum": [
                  "lab",
                  "unavailable"
                ],
                "oyatie.data_class": "INTERNAL_ONLY"
              }
            }
          }
        }
      ]
    },
    "resourceEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vcpu",
        "memory_gib",
        "system_storage_gib",
        "data_storage_gib"
      ],
      "properties": {
        "vcpu": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024,
          "oyatie.data_class": "INTERNAL_ONLY"
        },
        "memory_gib": {
          "type": "integer",
          "minimum": 2,
          "maximum": 32768,
          "oyatie.data_class": "INTERNAL_ONLY"
        },
        "system_storage_gib": {
          "type": "integer",
          "minimum": 8,
          "maximum": 1048576,
          "oyatie.data_class": "INTERNAL_ONLY"
        },
        "data_storage_gib": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1048576,
          "oyatie.data_class": "INTERNAL_ONLY"
        }
      }
    },
    "profiles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cluster_runtime_ref",
        "network_datapath_ref",
        "storage_ref",
        "identity_ref",
        "secret_authority_ref",
        "telemetry_ref",
        "configuration_projection_ref",
        "module_delivery_ref"
      ],
      "properties": {
        "cluster_runtime_ref": {
          "$ref": "#/$defs/profileRef",
          "oyatie.data_class": "INTERNAL_ONLY"
        },
        "network_datapath_ref": {
          "$ref": "#/$defs/profileRef",
          "oyatie.data_class": "INTERNAL_ONLY"
        },
        "storage_ref": {
          "$ref": "#/$defs/profileRef",
          "oyatie.data_class": "INTERNAL_ONLY"
        },
        "identity_ref": {
          "$ref": "#/$defs/profileRef",
          "oyatie.data_class": "INTERNAL_ONLY"
        },
        "secret_authority_ref": {
          "$ref": "#/$defs/profileRef",
          "oyatie.data_class": "INTERNAL_ONLY"
        },
        "telemetry_ref": {
          "$ref": "#/$defs/profileRef",
          "oyatie.data_class": "INTERNAL_ONLY"
        },
        "configuration_projection_ref": {
          "$ref": "#/$defs/profileRef",
          "oyatie.data_class": "INTERNAL_ONLY"
        },
        "module_delivery_ref": {
          "$ref": "#/$defs/profileRef",
          "oyatie.data_class": "INTERNAL_ONLY"
        }
      }
    },
    "profileRef": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,159}$"
    },
    "trust": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root_trust_profile_ref",
        "external_kms_role",
        "credential_values_forbidden",
        "cell_local_runtime_authority"
      ],
      "properties": {
        "root_trust_profile_ref": {
          "$ref": "#/$defs/profileRef",
          "oyatie.data_class": "INTERNAL_ONLY"
        },
        "external_kms_role": {
          "type": "string",
          "enum": [
            "none",
            "auto_unseal_only"
          ],
          "oyatie.data_class": "INTERNAL_ONLY"
        },
        "credential_values_forbidden": {
          "type": "boolean",
          "const": true,
          "oyatie.data_class": "INTERNAL_ONLY"
        },
        "cell_local_runtime_authority": {
          "type": "boolean",
          "const": true,
          "oyatie.data_class": "INTERNAL_ONLY"
        }
      }
    },
    "connectivity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dns_profile_ref",
        "mesh_profile_ref",
        "control_surfaces_private",
        "service_export_profile_refs"
      ],
      "properties": {
        "dns_profile_ref": {
          "$ref": "#/$defs/profileRef",
          "oyatie.data_class": "INTERNAL_ONLY"
        },
        "mesh_profile_ref": {
          "$ref": "#/$defs/profileRef",
          "oyatie.data_class": "INTERNAL_ONLY"
        },
        "control_surfaces_private": {
          "type": "boolean",
          "const": true,
          "oyatie.data_class": "INTERNAL_ONLY"
        },
        "service_export_profile_refs": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/profileRef"
          },
          "oyatie.data_class": "INTERNAL_ONLY"
        }
      }
    },
    "protection": {
      "type": "object",
      "description": "Compute lifecycle protection is independent of whether old payload data is preserved, quarantined, or explicitly discarded.",
      "additionalProperties": false,
      "required": [
        "protected_from_termination",
        "replace_allowed",
        "retire_allowed",
        "data_disposition"
      ],
      "properties": {
        "protected_from_termination": {
          "type": "boolean",
          "oyatie.data_class": "INTERNAL_ONLY"
        },
        "replace_allowed": {
          "type": "boolean",
          "oyatie.data_class": "INTERNAL_ONLY"
        },
        "retire_allowed": {
          "type": "boolean",
          "oyatie.data_class": "INTERNAL_ONLY"
        },
        "data_disposition": {
          "type": "string",
          "enum": [
            "preserve",
            "quarantine",
            "approved_discard"
          ],
          "description": "Payload-retention decision only. approved_discard never authorizes compute termination, replacement, or retirement.",
          "oyatie.data_class": "INTERNAL_ONLY"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_store_ref",
        "off_target",
        "immutable",
        "content_addressed",
        "redacted",
        "readback_required"
      ],
      "properties": {
        "receipt_store_ref": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,159}$",
          "oyatie.data_class": "INTERNAL_ONLY"
        },
        "off_target": {
          "type": "boolean",
          "const": true,
          "oyatie.data_class": "INTERNAL_ONLY"
        },
        "immutable": {
          "type": "boolean",
          "const": true,
          "oyatie.data_class": "INTERNAL_ONLY"
        },
        "content_addressed": {
          "type": "boolean",
          "const": true,
          "oyatie.data_class": "INTERNAL_ONLY"
        },
        "redacted": {
          "type": "boolean",
          "const": true,
          "oyatie.data_class": "INTERNAL_ONLY"
        },
        "readback_required": {
          "type": "boolean",
          "const": true,
          "oyatie.data_class": "INTERNAL_ONLY"
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy",
        "ownership"
      ],
      "properties": {
        "strategy": {
          "type": "string",
          "enum": [
            "must_adopt",
            "create_if_absent",
            "reconcile_existing",
            "recover",
            "quiesce"
          ],
          "description": "Target-local lifecycle strategy evaluated independently within one BootstrapIntent.",
          "oyatie.data_class": "INTERNAL_ONLY"
        },
        "ownership": {
          "type": "string",
          "enum": [
            "adopted_protected",
            "operation_owned",
            "externally_managed"
          ],
          "description": "Compute-substrate ownership class constraining cleanup and rollback independently of payload data disposition.",
          "oyatie.data_class": "INTERNAL_ONLY"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "strategy": {
                "const": "create_if_absent",
                "oyatie.data_class": "INTERNAL_ONLY"
              }
            },
            "required": [
              "strategy"
            ]
          },
          "then": {
            "properties": {
              "ownership": {
                "const": "operation_owned",
                "oyatie.data_class": "INTERNAL_ONLY"
              }
            },
            "required": [
              "ownership"
            ]
          }
        }
      ]
    }
  }
}
