    },
    {
      "name": "docs-save-latency",
      "target": "0.99",
      "sli": "histogram_quantile(0.99, sum(rate(oya_docs_save_seconds_bucket[5m])) by (le))",
      "file": "microservices/docs/slos/save-latency.openslo.yaml"
