      "file": "microservices/recordings/slos/retention-policy-correctness.openslo.yaml"
    },
    {
      "name": "recordings-transcript-render-latency",
      "target": "0.99",
      "sli": "sum(rate(oya_recordings_transcript_render_duration_seconds_bucket{recording_duration_bucket=\"10min\",le=\"0.5\"}[5m]))",
      "file": "microservices/recordings/slos/transcript-render-latency.openslo.yaml"
    },
    {
      "name": "recordings-transcript-search-latency",
      "target": "0.99",
      "sli": "sum(rate(oya_recordings_search_duration_seconds_bucket{le=\"0.3\"}[5m]))",
      "file": "microservices/recordings/slos/transcript-search-latency.openslo.yaml"
    }
  ],
