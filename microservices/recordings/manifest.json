    {
      "name": "recordings",
      "description": "Bounded context 'recordings' within recordings (data plane)",
      "crates": [
        "oya-recordings-app",
        "oya-recordings-export-adapter-pandoc",
        "oya-recordings-legal-hold-kernel",
        "oya-recordings-media-segment-adapter-cdn-cloudfront-stub-or-self",
        "oya-recordings-media-segment-adapter-ffmpeg",
        "oya-recordings-recording-adapter-postgres",
        "oya-recordings-recording-adapter-s3",
        "oya-recordings-recording-ingest-adapter-clamav",
        "oya-recordings-recording-kernel",
        "oya-recordings-retention-policy-kernel",
        "oya-recordings-search-adapter-meilisearch",
        "oya-recordings-share-link-adapter-redis",
        "oya-recordings-transcript-adapter-postgres",
        "oya-recordings-transcript-adapter-pyannote",
        "oya-recordings-transcript-adapter-whisper",
        "oya-recordings-transcript-kernel"
      ]
    }
  ],
  "layers": [
    "adapter",
    "app",
    "kernel"
  ],
  "contracts": {
    "openapi": [
      "microservices/recordings/contracts/openapi/recordings.yaml"
    ],
