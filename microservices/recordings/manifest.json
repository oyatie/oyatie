    {
      "tier": "T0",
      "name": "chapter-marker-suggest",
      "file": "microservices/recordings/capabilities/T0-suggest.yaml",
      "eu_ai_act_risk_class": "none"
    },
    {
      "tier": "T1",
      "name": "transcription-diarization-summary-pii-redact",
