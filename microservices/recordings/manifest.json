      "name": "auto-translate-and-auto-publish",
      "file": "microservices/recordings/capabilities/T2-auto.yaml",
      "eu_ai_act_risk_class": "limited"
    }
  ],
  "slos": [
    {
      "name": "recordings-export-mp4-latency",
      "target": "0.99",
      "sli": "sum(rate(oya_recordings_export_mp4_duration_ratio_bucket{le=\"0.3\"}[5m]))",
      "file": "microservices/recordings/slos/export-mp4-latency.openslo.yaml"
    },
    {
      "name": "recordings-export-transcript-pdf-latency",
      "target": "0.99",
      "sli": "sum(rate(oya_recordings_export_pdf_duration_seconds_bucket{le=\"3.0\"}[5m]))",
      "file": "microservices/recordings/slos/export-transcript-pdf-latency.openslo.yaml"
    },
    {
      "name": "recordings-legal-hold-chain-of-custody-correctness",
      "target": "1.0",
      "sli": "sum(rate(oya_recordings_legal_hold_chain_of_custody_event_total{result=\"correct\"}[30d]))",
      "file": "microservices/recordings/slos/legal-hold-chain-of-custody-correctness.openslo.yaml"
