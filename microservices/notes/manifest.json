      "name": "auto-organize-vault",
      "file": "microservices/notes/capabilities/T2-auto.yaml",
      "eu_ai_act_risk_class": "limited"
    }
  ],
  "slos": [
    {
      "name": "notes-e2e-privacy-correctness",
      "target": "1.0",
      "sli": "sum(rate(oya_notes_ai_assist_call_total{result=\"success\",context_kind=\"Professional\"}[5m]))",
      "file": "microservices/notes/slos/e2e-privacy-correctness.openslo.yaml"
    },
    {
      "name": "notes-full-text-search-latency",
      "target": "0.95",
      "sli": "sum(rate(oya_notes_full_text_search_duration_seconds_bucket{le=\"0.2\"}[5m]))",
      "file": "microservices/notes/slos/full-text-search-latency.openslo.yaml"
    },
    {
      "name": "notes-graph-render-latency",
      "target": "0.95",
      "sli": "sum(rate(oya_notes_graph_render_duration_seconds_bucket{vault_size_class=\"5k\",le=\"1.0\"}[5m]))",
      "file": "microservices/notes/slos/graph-render-latency.openslo.yaml"
    },
    {
