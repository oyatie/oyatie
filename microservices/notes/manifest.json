    {
      "name": "notes-sync-latency",
      "target": "0.99",
      "sli": "sum(rate(oya_notes_sync_after_edit_duration_seconds_bucket{le=\"0.5\"}[5m]))",
      "file": "microservices/notes/slos/sync-latency.openslo.yaml"
    },
    {
      "name": "notes-tag-search-latency",
      "target": "0.95",
      "sli": "sum(rate(oya_notes_tag_search_duration_seconds_bucket{le=\"0.1\"}[5m]))",
