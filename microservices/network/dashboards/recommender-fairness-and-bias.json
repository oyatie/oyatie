{
  "$schema": "https://schemas.grafana.com/dashboard.json",
  "_meta": {
    "doc_class": "GrafanaDashboard",
    "microservice": "network",
    "owner_team": "axis-network + ops-compliance + council-privacy + axis-foundry-runtime",
    "audience": "compliance officer + council-privacy + EU AI Act notified body + NYC DCWP auditor + EEOC examiner + tenant operator",
    "tenant_scoped": true,
    "datasource": "per-pack Mimir; tenant-scoped via X-Scope-OrgID",
    "regulatory_scope": [
      "EU AI Act Annex III §4 + Art. 12 + Art. 15 + Art. 27 + Art. 72 + Art. 73",
      "US Title VII + ADA + ADEA + EEOC UGESP 29 CFR §1607",
      "NYC LL144 §§20-870, 20-871, 20-872",
      "CA AB-331 §22756",
      "CO SB 24-205",
      "UK Equality Act 2010 + ICO ADM code",
      "EU Equal Treatment Directives 2000/43/EC + 2000/78/EC",
      "EU Pay Transparency Directive 2023/970"
    ]
  },
  "uid": "network-recommender-fairness-and-bias",
  "title": "network: recommender fairness + bias audit (EU AI Act + EEOC + NYC LL144 monitoring)",
  "tags": ["network", "eu-ai-act", "eeoc", "ll144", "bias-audit", "high-risk"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "300s",
  "time": {"from": "now-30d", "to": "now"},
  "templating": {
    "list": [
      {"name": "pack", "type": "custom", "label": "Pack",
        "options": [
          {"text": "pack-eu", "value": "eu", "selected": true},
          {"text": "pack-us", "value": "us"},
          {"text": "pack-us-nyc", "value": "us-nyc"},
          {"text": "pack-us-ca", "value": "us-ca"},
          {"text": "pack-us-co", "value": "us-co"},
          {"text": "pack-uk", "value": "uk"},
          {"text": "pack-kr", "value": "kr"},
          {"text": "pack-au", "value": "au"},
          {"text": "pack-in", "value": "in"}
        ]},
      {"name": "tenant", "type": "query", "label": "Tenant",
        "query": "label_values(oya_network_recruiter_search_invoked_total{pack=\"$pack\"}, tenant_id)"},
      {"name": "ranker_kind", "type": "custom", "label": "Ranker",
        "options": [
          {"text": "people-you-may-know", "value": "pymk", "selected": true},
          {"text": "jobs-ranker", "value": "jobs"},
          {"text": "recruiter-stub", "value": "recruiter"},
          {"text": "endorsement-aggregation", "value": "endorsement-aggregation"}
        ]}
    ]
  },
  "panels": [
    {"id": 1, "type": "stat", "title": "4/5-rule passes (current rolling 30d)",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "min(oya_network_bias_audit_disparity_ratio{pack=\"$pack\",tenant_id=\"$tenant\",ranker_kind=\"$ranker_kind\"})", "refId": "A"}],
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"value": null, "color": "red"}, {"value": 0.8, "color": "green"}]}}}},

    {"id": 2, "type": "stat", "title": "Latest model card version",
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "oya_network_bias_audit_model_version{pack=\"$pack\",ranker_kind=\"$ranker_kind\"}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "string"}}},

    {"id": 3, "type": "stat", "title": "Days since last NYC LL144 audit (when NYC tenant)",
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "(time() - oya_network_ll144_last_audit_timestamp{pack=\"$pack\",tenant_id=\"$tenant\"}) / 86400", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "d", "thresholds": {"mode": "absolute", "steps": [{"value": null, "color": "green"}, {"value": 330, "color": "yellow"}, {"value": 365, "color": "red"}]}}}},

    {"id": 4, "type": "stat", "title": "EU AI Act FRIA attested?",
      "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "oya_network_eu_ai_act_fria_attested{pack=\"$pack\",tenant_id=\"$tenant\"}", "refId": "A"}],
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"value": null, "color": "red"}, {"value": 1, "color": "green"}]}}}},

    {"id": 5, "type": "timeseries", "title": "Disparity ratio per protected group (4/5-rule; ≥ 0.8 = pass)",
      "gridPos": {"x": 0, "y": 4, "w": 24, "h": 10},
      "targets": [
        {"expr": "oya_network_bias_audit_disparity_ratio{pack=\"$pack\",tenant_id=\"$tenant\",ranker_kind=\"$ranker_kind\",group=\"race\"}", "legendFormat": "race", "refId": "A"},
        {"expr": "oya_network_bias_audit_disparity_ratio{pack=\"$pack\",tenant_id=\"$tenant\",ranker_kind=\"$ranker_kind\",group=\"gender\"}", "legendFormat": "gender", "refId": "B"},
        {"expr": "oya_network_bias_audit_disparity_ratio{pack=\"$pack\",tenant_id=\"$tenant\",ranker_kind=\"$ranker_kind\",group=\"age\"}", "legendFormat": "age", "refId": "C"},
        {"expr": "oya_network_bias_audit_disparity_ratio{pack=\"$pack\",tenant_id=\"$tenant\",ranker_kind=\"$ranker_kind\",group=\"disability\"}", "legendFormat": "disability", "refId": "D"},
        {"expr": "oya_network_bias_audit_disparity_ratio{pack=\"$pack\",tenant_id=\"$tenant\",ranker_kind=\"$ranker_kind\",group=\"locale\"}", "legendFormat": "locale", "refId": "E"},
        {"expr": "0.8", "legendFormat": "4/5-rule threshold", "refId": "F"}
      ],
      "fieldConfig": {"defaults": {"min": 0, "max": 1.2, "custom": {"axisLabel": "disparity ratio"}}}},

    {"id": 6, "type": "timeseries", "title": "Recruiter-search invocation rate + outcome distribution",
      "gridPos": {"x": 0, "y": 14, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum(rate(oya_network_recruiter_search_invoked_total{pack=\"$pack\",tenant_id=\"$tenant\"}[1h]))", "legendFormat": "invocations / h", "refId": "A"},
        {"expr": "sum by (outcome_group) (rate(oya_network_recruiter_search_outcome_total{pack=\"$pack\",tenant_id=\"$tenant\"}[1h]))", "legendFormat": "outcome={{outcome_group}}", "refId": "B"}
      ]},

    {"id": 7, "type": "timeseries", "title": "Recommender drift detector",
      "gridPos": {"x": 12, "y": 14, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum(rate(oya_network_recommender_output_drift_total{pack=\"$pack\",ranker_kind=\"$ranker_kind\"}[15m]))", "legendFormat": "drift events / 15m", "refId": "A"}
      ]},

    {"id": 8, "type": "timeseries", "title": "Appeal submissions + resolution (GDPR Art. 22 + EU DSA Art. 20)",
      "gridPos": {"x": 0, "y": 22, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum(rate(oya_network_appeal_opened_total{pack=\"$pack\",tenant_id=\"$tenant\"}[1h]))", "legendFormat": "opened / h", "refId": "A"},
        {"expr": "sum(rate(oya_network_appeal_resolved_total{pack=\"$pack\",tenant_id=\"$tenant\",verdict=\"upheld\"}[1h]))", "legendFormat": "upheld / h", "refId": "B"},
        {"expr": "sum(rate(oya_network_appeal_resolved_total{pack=\"$pack\",tenant_id=\"$tenant\",verdict=\"overturned\"}[1h]))", "legendFormat": "overturned / h", "refId": "C"}
      ]},

    {"id": 9, "type": "timeseries", "title": "GDPR Art. 22 opt-out adoption (per 1000 active users)",
      "gridPos": {"x": 12, "y": 22, "w": 12, "h": 8},
      "targets": [
        {"expr": "1000 * sum(oya_network_users_with_automated_decision_opt_out{pack=\"$pack\",tenant_id=\"$tenant\"}) / sum(oya_network_active_professional_users{pack=\"$pack\",tenant_id=\"$tenant\"})", "legendFormat": "opt-out rate per 1000", "refId": "A"}
      ]},

    {"id": 10, "type": "stat", "title": "Recruiter-stub: bias-audit failures (rolling 7d; Sev-1 trigger)",
      "gridPos": {"x": 0, "y": 30, "w": 6, "h": 4},
      "targets": [{"expr": "sum(increase(oya_network_recruiter_bias_audit_failure_total{pack=\"$pack\",tenant_id=\"$tenant\"}[7d]))", "refId": "A"}],
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"value": null, "color": "green"}, {"value": 1, "color": "red"}]}}}},

    {"id": 11, "type": "stat", "title": "Recruiter-stub activated for tenant",
      "gridPos": {"x": 6, "y": 30, "w": 6, "h": 4},
      "targets": [{"expr": "oya_network_recruiter_stub_activated{pack=\"$pack\",tenant_id=\"$tenant\"}", "refId": "A"}],
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"value": null, "color": "blue"}]}}}},

    {"id": 12, "type": "stat", "title": "Latest CA AB-331 impact assessment days-old",
      "gridPos": {"x": 12, "y": 30, "w": 6, "h": 4},
      "targets": [{"expr": "(time() - oya_network_ab331_impact_assessment_timestamp{pack=\"$pack\",tenant_id=\"$tenant\"}) / 86400", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "d"}}},

    {"id": 13, "type": "stat", "title": "Latest CO SB 24-205 risk-management policy days-old",
      "gridPos": {"x": 18, "y": 30, "w": 6, "h": 4},
      "targets": [{"expr": "(time() - oya_network_co_sb_205_policy_timestamp{pack=\"$pack\",tenant_id=\"$tenant\"}) / 86400", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "d"}}},

    {"id": 14, "type": "table", "title": "Recent BiasAuditCompleted events (per release)",
      "gridPos": {"x": 0, "y": 34, "w": 24, "h": 10},
      "targets": [{"expr": "oya_network_bias_audit_event_metadata{pack=\"$pack\"}", "format": "table", "refId": "A"}]}
  ]
}
