{
  "$schema": "https://schemas.grafana.com/dashboard.json",
  "_meta": {
    "doc_class": "GrafanaDashboard",
    "microservice": "network",
    "owner_team": "axis-network + ops-security",
    "audience": "tenant operator + axis-network SRE + ops-security",
    "tenant_scoped": true,
    "datasource": "per-pack Mimir; tenant-scoped via X-Scope-OrgID"
  },
  "uid": "network-professional-graph-health",
  "title": "network: Professional graph health (connections + endorsements + integrity)",
  "tags": ["network", "graph", "endorsements", "integrity"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "60s",
  "time": {"from": "now-6h", "to": "now"},
  "templating": {
    "list": [
      {"name": "pack", "type": "custom", "label": "Pack",
        "options": [
          {"text": "pack-kr", "value": "kr", "selected": true},
          {"text": "pack-eu", "value": "eu"},
          {"text": "pack-us", "value": "us"},
          {"text": "pack-us-healthcare", "value": "us-hc"},
          {"text": "pack-jp", "value": "jp"},
          {"text": "pack-sg", "value": "sg"},
          {"text": "pack-au", "value": "au"},
          {"text": "pack-in", "value": "in"},
          {"text": "pack-br", "value": "br"},
          {"text": "pack-ae", "value": "ae"},
          {"text": "pack-ksa", "value": "ksa"}
        ]},
      {"name": "tenant", "type": "query", "label": "Tenant",
        "query": "label_values(oya_network_connection_action_total{pack=\"$pack\"}, tenant_id)"}
    ]
  },
  "panels": [
    {"id": 1, "type": "stat", "title": "Total 1st-degree edges",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "sum(oya_network_connection_edges_total{pack=\"$pack\",tenant_id=\"$tenant\",degree=\"1\"})", "refId": "A"}]},

    {"id": 2, "type": "stat", "title": "Connection-action p99 (s)",
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "histogram_quantile(0.99, sum by (le) (rate(oya_network_connection_action_duration_seconds_bucket{pack=\"$pack\",tenant_id=\"$tenant\"}[5m])))", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"mode": "absolute", "steps": [{"value": null, "color": "green"}, {"value": 0.1, "color": "yellow"}, {"value": 0.15, "color": "red"}]}}}},

    {"id": 3, "type": "stat", "title": "Endorsement add p99 (s)",
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "histogram_quantile(0.99, sum by (le) (rate(oya_network_endorsement_add_duration_seconds_bucket{pack=\"$pack\",tenant_id=\"$tenant\"}[5m])))", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"mode": "absolute", "steps": [{"value": null, "color": "green"}, {"value": 0.08, "color": "yellow"}, {"value": 0.12, "color": "red"}]}}}},

    {"id": 4, "type": "stat", "title": "Endorsement-chain integrity verify (rolling 24h)",
      "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "sum(increase(oya_network_endorsement_chain_integrity_failure_total{pack=\"$pack\",tenant_id=\"$tenant\"}[24h]))", "refId": "A"}],
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"value": null, "color": "green"}, {"value": 1, "color": "red"}]}}}},

    {"id": 5, "type": "timeseries", "title": "Connection request rate (open / accepted / rejected / ignored / withdrawn)",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum by (status) (rate(oya_network_connection_request_total{pack=\"$pack\",tenant_id=\"$tenant\"}[5m]))", "legendFormat": "{{status}}", "refId": "A"}
      ]},

    {"id": 6, "type": "timeseries", "title": "Endorsement + recommendation rate",
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum(rate(oya_network_endorsement_added_total{pack=\"$pack\",tenant_id=\"$tenant\"}[5m]))", "legendFormat": "endorsement add", "refId": "A"},
        {"expr": "sum(rate(oya_network_endorsement_revoked_total{pack=\"$pack\",tenant_id=\"$tenant\"}[5m]))", "legendFormat": "endorsement revoke", "refId": "B"},
        {"expr": "sum(rate(oya_network_recommendation_published_total{pack=\"$pack\",tenant_id=\"$tenant\"}[5m]))", "legendFormat": "recommendation", "refId": "C"}
      ]},

    {"id": 7, "type": "timeseries", "title": "Endorsement-chain Merkle integrity verification cadence",
      "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum(rate(oya_network_endorsement_chain_verified_total{pack=\"$pack\",tenant_id=\"$tenant\"}[1h]))", "legendFormat": "verified records / h", "refId": "A"},
        {"expr": "sum(rate(oya_network_endorsement_signature_verify_failure_total{pack=\"$pack\",tenant_id=\"$tenant\"}[1h]))", "legendFormat": "signature failures / h", "refId": "B"}
      ]},

    {"id": 8, "type": "timeseries", "title": "Connection-graph drift detector",
      "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum(rate(oya_network_connection_graph_drift_total{pack=\"$pack\",tenant_id=\"$tenant\"}[15m]))", "legendFormat": "drift events / 15m", "refId": "A"}
      ]},

    {"id": 9, "type": "timeseries", "title": "Degree-of-separation cache hit ratio",
      "gridPos": {"x": 0, "y": 20, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum(rate(oya_network_degree_cache_hit_total{pack=\"$pack\",tenant_id=\"$tenant\"}[5m])) / sum(rate(oya_network_degree_cache_request_total{pack=\"$pack\",tenant_id=\"$tenant\"}[5m]))", "legendFormat": "hit ratio", "refId": "A"}
      ]},

    {"id": 10, "type": "table", "title": "Top 10 endorsers (rate; 1h)",
      "gridPos": {"x": 12, "y": 20, "w": 12, "h": 8},
      "targets": [{"expr": "topk(10, sum by (endorser_ref) (rate(oya_network_endorsement_added_total{pack=\"$pack\",tenant_id=\"$tenant\"}[1h])))", "format": "table", "refId": "A"}]},

    {"id": 11, "type": "stat", "title": "Professional-context violation (Sev-1 if > 0)",
      "gridPos": {"x": 0, "y": 28, "w": 6, "h": 4},
      "targets": [{"expr": "sum(increase(oya_network_professional_context_violation_total{pack=\"$pack\"}[24h]))", "refId": "A"}],
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"value": null, "color": "green"}, {"value": 1, "color": "red"}]}}}},

    {"id": 12, "type": "stat", "title": "Cross-tenant leak detector (Sev-1 if > 0)",
      "gridPos": {"x": 6, "y": 28, "w": 6, "h": 4},
      "targets": [{"expr": "sum(increase(oya_network_cross_tenant_leak_detector_total{pack=\"$pack\"}[24h]))", "refId": "A"}],
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"value": null, "color": "green"}, {"value": 1, "color": "red"}]}}}},

    {"id": 13, "type": "stat", "title": "Four-eyes pairing violations (Sev-1 if > 0)",
      "gridPos": {"x": 12, "y": 28, "w": 6, "h": 4},
      "targets": [{"expr": "sum(increase(oya_network_four_eyes_pairing_violation_total{pack=\"$pack\"}[24h]))", "refId": "A"}],
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"value": null, "color": "green"}, {"value": 1, "color": "red"}]}}}},

    {"id": 14, "type": "stat", "title": "Pack residency violations (Sev-1 if > 0)",
      "gridPos": {"x": 18, "y": 28, "w": 6, "h": 4},
      "targets": [{"expr": "sum(increase(oya_network_pack_residency_violation_total{pack=\"$pack\"}[24h]))", "refId": "A"}],
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"value": null, "color": "green"}, {"value": 1, "color": "red"}]}}}}
  ]
}
