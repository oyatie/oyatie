{
  "manifest_schema_version": "1.0",
  "microservice": "analytics",
  "owner": "council-analytics",
  "rationale": "Analytics µservice — tenant-facing OLAP analytics warehouse per ADR-0193. Serves tenant-facing dashboards, ops portal rollups, audit-log query, and billing rollups. Distinct from observability (ops/SRE telemetry per ADR-0186) and foundry (vector retrieval per ADR-0192). Introduced 2026-05-18 by the data-substrate batch.",
  "introducing_phase": "M02-data-substrate",
  "adr_anchors": [
    "ADR-0131-per-microservice-flat-layout",
    "ADR-0184-storage-tier-layering",
    "ADR-0193-olap-analytics-warehouse-clickhouse",
    "ADR-0194-tenant-facing-timeseries-timescaledb",
    "ADR-0195-stream-processing-tier"
  ],
  "layout": "flat-per-adr-0131",
  "status": "planned",
  "bounded_contexts": [
    "tenant-dashboard-query",
    "billing-rollup",
    "audit-log-search",
    "data-export"
  ],
  "data_substrates": {
    "primary_olap": "clickhouse-26.3-lts",
    "primary_olap_adapter_crate": "oya-shared-olap-clickhouse-adapter",
    "primary_olap_kernel_crate": "oya-shared-olap-client-kernel",
    "stream_processing_default": "clickhouse_mv",
    "stream_processing_escalation": "flink-2.2-via-adr-amendment"
  },
  "lts_pins": {
    "clickhouse": "26.3.10.60-lts",
    "clickhouse_keeper": "26.3.10.60-lts",
    "postgres": "18.4",
    "valkey": "8.1",
    "meilisearch": "1.9"
  },
  "tenancy": {
    "model": "per-tenant-database",
    "isolation_primitive": "tenant_{tenant_id} ClickHouse database + row-level policy fallback",
    "quota_authority": "ADR-0155-per-tenant-resource-quotas"
  },
  "residency": {
    "kr_pack": "microservices/analytics/iac/kustomize/overlays/pack-kr",
    "eu_pack": "microservices/analytics/iac/kustomize/overlays/pack-eu",
    "data_class_taxonomy": "ADR-0008-DUBO"
  },
  "observability": {
    "openslo_manifests": ["microservices/analytics/slos/clickhouse-query-latency.openslo.yaml"],
    "dashboards": ["microservices/analytics/dashboards/clickhouse-overview.json"],
    "prometheus_rules": "rendered via sloth from openslo source per ADR-0186 Stage 5"
  },
  "framework_scorecards": {
    "aws_well_architected": "microservices/analytics/scorecards/aws-well-architected.json",
    "google_sre_prr": "microservices/analytics/scorecards/google-sre-prr.json",
    "cis_k8s_1_10": "microservices/analytics/scorecards/cis-k8s-1-10.json",
    "slsa_l3": "microservices/analytics/scorecards/slsa-l3.json"
  },
  "ip_pack": [
    {"id": "IP-001", "title": "ClickHouse cluster IaC (operator + 3-shard × 2-replica + Keeper)"},
    {"id": "IP-002", "title": "Per-tenant database bootstrap + row-level policies"},
    {"id": "IP-003", "title": "OLAP client kernel wiring + adapter crate scaffold"},
    {"id": "IP-004", "title": "Outbox → ClickHouse CDC ingest pipeline"},
    {"id": "IP-005", "title": "Materialized View canon (per ADR-0195 default tier)"},
    {"id": "IP-006", "title": "Cold-tier S3 disk + TTL retention"},
    {"id": "IP-007", "title": "Tenant-facing dashboard API (REST + GraphQL)"},
    {"id": "IP-008", "title": "Audit-log query API (per-axis filter + cursor pagination)"},
    {"id": "IP-009", "title": "Billing rollup pipeline (daily + monthly partitions)"},
    {"id": "IP-010", "title": "Cross-cell federation via Distributed table engine"},
    {"id": "IP-011", "title": "Per-tenant quota enforcement (ClickHouse QUOTA → Cedar)"},
    {"id": "IP-012", "title": "Backup tool (BACKUP TABLE → S3-compat) + restore drill"},
    {"id": "IP-013", "title": "ClickHouse data-export evidence pack (regulator export)"},
    {"id": "IP-014", "title": "Self-SLO authoring + 4-window burn-rate alerts"},
    {"id": "IP-015", "title": "App composition root + REST/gRPC adapters"}
  ],
  "phases": ["PHASE-01-ANALYTICS-OLAP-BOOTSTRAP"],
  "deferred_doc_artifacts": "see /Users/jasonlee/oyatie/evidence/parent-wiring-todo-data-batch.json"
}
