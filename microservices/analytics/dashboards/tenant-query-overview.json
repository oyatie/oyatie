{
  "title": "Analytics — Tenant Query Overview",
  "uid": "analytics-tenant-query-overview",
  "tags": ["analytics", "tenant-facing", "adr-0193"],
  "timezone": "UTC",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "templating": {
    "list": [
      {"name": "cluster", "type": "query", "query": "label_values(ClickHouseAsyncMetrics_Uptime, cluster)", "datasource": "Prometheus"},
      {"name": "tenant_id", "type": "query", "query": "label_values(oya_analytics_query_duration_seconds_count{cluster=\"$cluster\"}, tenant_id)", "datasource": "Prometheus", "includeAll": true}
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "QPS — fleet",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "sum(rate(oya_analytics_query_duration_seconds_count{cluster=\"$cluster\"}[5m]))", "legendFormat": "qps"}]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "p99 latency",
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "histogram_quantile(0.99, sum by (le) (rate(oya_analytics_query_duration_seconds_bucket{cluster=\"$cluster\"}[5m])))", "legendFormat": "p99"}],
      "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"steps": [{"value": 0.0, "color": "green"}, {"value": 0.5, "color": "yellow"}, {"value": 1.0, "color": "red"}]}}}
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Error rate",
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "sum(rate(oya_analytics_query_errors_total{cluster=\"$cluster\"}[5m])) / sum(rate(oya_analytics_query_duration_seconds_count{cluster=\"$cluster\"}[5m]))", "legendFormat": "err"}],
      "fieldConfig": {"defaults": {"unit": "percentunit"}}
    },
    {
      "id": 4,
      "type": "stat",
      "title": "SLO budget remaining",
      "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "slo_budget_remaining{slo=\"analytics-dashboard-api-latency\"}", "legendFormat": "budget"}]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Query latency percentiles (p50, p95, p99)",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum by (le) (rate(oya_analytics_query_duration_seconds_bucket{cluster=\"$cluster\"}[5m])))", "legendFormat": "p50"},
        {"expr": "histogram_quantile(0.95, sum by (le) (rate(oya_analytics_query_duration_seconds_bucket{cluster=\"$cluster\"}[5m])))", "legendFormat": "p95"},
        {"expr": "histogram_quantile(0.99, sum by (le) (rate(oya_analytics_query_duration_seconds_bucket{cluster=\"$cluster\"}[5m])))", "legendFormat": "p99"}
      ],
      "fieldConfig": {"defaults": {"unit": "s"}}
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "QPS by route",
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum by (route) (rate(oya_analytics_query_duration_seconds_count{cluster=\"$cluster\"}[5m]))", "legendFormat": "{{route}}"}
      ]
    },
    {
      "id": 7,
      "type": "table",
      "title": "Top 10 tenants by query rate",
      "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
      "targets": [
        {"expr": "topk(10, sum by (tenant_id) (rate(oya_analytics_query_duration_seconds_count{cluster=\"$cluster\"}[15m])))"}
      ]
    },
    {
      "id": 8,
      "type": "table",
      "title": "Top 10 tenants by 429 quota_exceeded",
      "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8},
      "targets": [
        {"expr": "topk(10, sum by (tenant_id) (rate(oya_analytics_quota_exceeded_total{cluster=\"$cluster\"}[15m])))"}
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Burn rate — dashboard-api SLO",
      "gridPos": {"x": 0, "y": 20, "w": 24, "h": 6},
      "targets": [
        {"expr": "slo_burn_rate{slo=\"analytics-dashboard-api-latency\",window=\"1h\"}", "legendFormat": "1h fast"},
        {"expr": "slo_burn_rate{slo=\"analytics-dashboard-api-latency\",window=\"6h\"}", "legendFormat": "6h medium"},
        {"expr": "slo_burn_rate{slo=\"analytics-dashboard-api-latency\",window=\"1d\"}", "legendFormat": "1d slow"},
        {"expr": "slo_burn_rate{slo=\"analytics-dashboard-api-latency\",window=\"3d\"}", "legendFormat": "3d trickle"}
      ]
    }
  ]
}
