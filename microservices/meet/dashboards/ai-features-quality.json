{
  "$schema": "https://schemas.grafana.com/dashboard.json",
  "_meta": {
    "doc_class": "GrafanaDashboard",
    "microservice": "meet",
    "owner_team": "axis-meet + axis-foundry-runtime + council-privacy",
    "audience": "tenant compliance officer + axis-meet SRE + axis-foundry-runtime",
    "tenant_scoped": true,
    "datasource": "per-pack Mimir + Whisper GPU pool metrics",
    "reference_standards": ["EU AI Act Art. 50", "ADR-MEET-0002", "ADR-MEET-0006", "ITU-T G.107", "OpenAI Whisper paper"]
  },
  "uid": "meet-ai-features-quality",
  "title": "meet: AI features (transcription + translation + summary) quality + EU AI Act compliance",
  "tags": ["meet", "transcription", "whisper", "translation", "summary", "eu-ai-act"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {"from": "now-24h", "to": "now"},
  "templating": {
    "list": [
      {"name": "pack", "type": "custom", "label": "Pack",
        "options": [
          {"text": "pack-kr", "value": "kr", "selected": true},
          {"text": "pack-eu", "value": "eu"},
          {"text": "pack-us", "value": "us"},
          {"text": "pack-us-healthcare", "value": "us-hc"},
          {"text": "pack-us-financial", "value": "us-fin"},
          {"text": "pack-jp", "value": "jp"},
          {"text": "pack-sg", "value": "sg"},
          {"text": "pack-au", "value": "au"},
          {"text": "pack-in", "value": "in"},
          {"text": "pack-br", "value": "br"},
          {"text": "pack-ae", "value": "ae"},
          {"text": "pack-ksa", "value": "ksa"}
        ]}
    ]
  },
  "panels": [
    {"id": 1, "type": "stat", "title": "Live caption sessions active",
      "gridPos": {"x": 0, "y": 0, "w": 4, "h": 4},
      "targets": [{"expr": "sum(oya_meet_live_caption_sessions_active{pack=\"$pack\"})", "refId": "A"}]},

    {"id": 2, "type": "stat", "title": "Live caption lag p99 (s) — target ≤ 0.5",
      "gridPos": {"x": 4, "y": 0, "w": 4, "h": 4},
      "targets": [{"expr": "histogram_quantile(0.99, sum by (le) (rate(oya_meet_live_caption_lag_seconds_bucket{pack=\"$pack\"}[5m])))", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"mode": "absolute", "steps": [{"value": null, "color": "green"}, {"value": 0.4, "color": "yellow"}, {"value": 0.5, "color": "red"}]}}}},

    {"id": 3, "type": "stat", "title": "Transcription quality score (vs baseline WER)",
      "gridPos": {"x": 8, "y": 0, "w": 4, "h": 4},
      "targets": [{"expr": "avg(oya_meet_transcription_quality_score{pack=\"$pack\"})", "refId": "A"}],
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"value": null, "color": "red"}, {"value": 0.90, "color": "yellow"}, {"value": 0.95, "color": "green"}]}}}},

    {"id": 4, "type": "stat", "title": "Whisper GPU pool depth (queue length)",
      "gridPos": {"x": 12, "y": 0, "w": 4, "h": 4},
      "targets": [{"expr": "avg(oya_meet_whisper_pool_depth{pack=\"$pack\"})", "refId": "A"}],
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"value": null, "color": "green"}, {"value": 3, "color": "yellow"}, {"value": 5, "color": "red"}]}}}},

    {"id": 5, "type": "stat", "title": "Summaries produced (24h)",
      "gridPos": {"x": 16, "y": 0, "w": 4, "h": 4},
      "targets": [{"expr": "sum(increase(oya_meet_summary_produced_total{pack=\"$pack\"}[24h]))", "refId": "A"}]},

    {"id": 6, "type": "stat", "title": "Summary post-end p95 (s) — target ≤ 60 (60min meeting)",
      "gridPos": {"x": 20, "y": 0, "w": 4, "h": 4},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(oya_meet_summary_produce_seconds_bucket{pack=\"$pack\"}[1h])))", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"mode": "absolute", "steps": [{"value": null, "color": "green"}, {"value": 50, "color": "yellow"}, {"value": 60, "color": "red"}]}}}},

    {"id": 7, "type": "timeseries", "title": "Whisper model version distribution (per pod)",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "targets": [{"expr": "sum by (whisper_model_version) (oya_meet_transcription_active_by_model{pack=\"$pack\"})", "legendFormat": "{{whisper_model_version}}", "refId": "A"}]},

    {"id": 8, "type": "timeseries", "title": "GPU pool utilization (%) per pod",
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
      "targets": [{"expr": "avg by (pod) (DCGM_FI_DEV_GPU_UTIL{namespace=\"meet\",pod=~\"transcription-worker-.*\"})", "legendFormat": "{{pod}}", "refId": "A"}]},

    {"id": 9, "type": "timeseries", "title": "Live translation BLEU on synthetic baseline (per language pair)",
      "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
      "targets": [{"expr": "avg by (language_pair) (oya_meet_translation_bleu{pack=\"$pack\"})", "legendFormat": "{{language_pair}}", "refId": "A"}]},

    {"id": 10, "type": "timeseries", "title": "Summary action-item extraction precision (P@1) per release",
      "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8},
      "targets": [{"expr": "avg by (ai_model_version) (oya_meet_summary_action_item_precision{pack=\"$pack\"})", "legendFormat": "{{ai_model_version}}", "refId": "A"}]},

    {"id": 11, "type": "stat", "title": "E2E meetings active (per ADR-MEET-0003)",
      "gridPos": {"x": 0, "y": 20, "w": 6, "h": 4},
      "targets": [{"expr": "sum(oya_meet_e2e_meetings_active{pack=\"$pack\"})", "refId": "A"}]},

    {"id": 12, "type": "stat", "title": "E2E admin decrypt attempts (target = 0)",
      "gridPos": {"x": 6, "y": 20, "w": 6, "h": 4},
      "targets": [{"expr": "sum(increase(oya_meet_e2e_admin_decrypt_attempt_total{pack=\"$pack\"}[24h]))", "refId": "A"}],
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"value": null, "color": "green"}, {"value": 1, "color": "red"}]}}}},

    {"id": 13, "type": "stat", "title": "EU AI Act Art. 50 label coverage (% AI outputs labelled)",
      "gridPos": {"x": 12, "y": 20, "w": 6, "h": 4},
      "targets": [{"expr": "sum(oya_meet_ai_outputs_labelled_total{pack=\"$pack\"}) / sum(oya_meet_ai_outputs_total{pack=\"$pack\"})", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "thresholds": {"mode": "absolute", "steps": [{"value": null, "color": "red"}, {"value": 0.99, "color": "yellow"}, {"value": 1.0, "color": "green"}]}}}},

    {"id": 14, "type": "stat", "title": "PHI redaction failure (target = 0)",
      "gridPos": {"x": 18, "y": 20, "w": 6, "h": 4},
      "targets": [{"expr": "sum(increase(oya_meet_phi_redaction_failure_total{pack=\"$pack\"}[24h]))", "refId": "A"}],
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"value": null, "color": "green"}, {"value": 1, "color": "red"}]}}}},

    {"id": 15, "type": "timeseries", "title": "Cross-tenant Whisper batch detection (target = 0)",
      "gridPos": {"x": 0, "y": 24, "w": 12, "h": 6},
      "targets": [{"expr": "sum(rate(oya_meet_transcription_cross_tenant_batch_total{pack=\"$pack\"}[5m]))", "legendFormat": "rate", "refId": "A"}],
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"value": null, "color": "green"}, {"value": 0.001, "color": "red"}]}}}},

    {"id": 16, "type": "timeseries", "title": "Auto-mute false-positive rate (target < 2%)",
      "gridPos": {"x": 12, "y": 24, "w": 12, "h": 6},
      "targets": [{"expr": "sum(rate(oya_meet_auto_mute_reversed_total{pack=\"$pack\"}[1h])) / sum(rate(oya_meet_auto_mute_decisions_total{pack=\"$pack\"}[1h]))", "legendFormat": "false-positive rate", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "thresholds": {"mode": "absolute", "steps": [{"value": null, "color": "green"}, {"value": 0.02, "color": "red"}]}}}}
  ]
}
