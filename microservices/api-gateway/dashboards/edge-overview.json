{
  "title": "api-gateway — Edge Overview",
  "schemaVersion": 39,
  "tags": ["api-gateway", "edge", "tier-0"],
  "templating": {
    "list": [
      {"name": "cell", "type": "query", "query": "label_values(oya_api_gateway_requests_total, cell)"},
      {"name": "tenant", "type": "query", "query": "label_values(oya_api_gateway_requests_total{cell=~\"$cell\"}, tenant_id)"}
    ]
  },
  "panels": [
    {"id": 1, "type": "stat", "title": "Requests/sec (global)", "targets": [{"expr": "sum(rate(oya_api_gateway_requests_total[1m]))"}]},
    {"id": 2, "type": "stat", "title": "5xx ratio", "targets": [{"expr": "sum(rate(oya_api_gateway_requests_total{code=~\"5..\"}[5m])) / sum(rate(oya_api_gateway_requests_total[5m]))"}]},
    {"id": 3, "type": "graph", "title": "Latency p50/p95/p99", "targets": [
      {"expr": "histogram_quantile(0.5, sum(rate(oya_api_gateway_latency_seconds_bucket[5m])) by (le))"},
      {"expr": "histogram_quantile(0.95, sum(rate(oya_api_gateway_latency_seconds_bucket[5m])) by (le))"},
      {"expr": "histogram_quantile(0.99, sum(rate(oya_api_gateway_latency_seconds_bucket[5m])) by (le))"}
    ]},
    {"id": 4, "type": "graph", "title": "Per-cell requests/sec", "targets": [{"expr": "sum(rate(oya_api_gateway_requests_total[1m])) by (cell)"}]},
    {"id": 5, "type": "graph", "title": "HTTP/3 negotiation ratio", "targets": [{"expr": "sum(rate(oya_api_gateway_alpn_negotiated_total{alpn=\"h3\"}[5m])) / sum(rate(oya_api_gateway_alpn_negotiated_total[5m]))"}]},
    {"id": 6, "type": "graph", "title": "TLS handshake success ratio", "targets": [{"expr": "sum(rate(oya_api_gateway_tls_handshake_total{status=\"success\"}[5m])) / sum(rate(oya_api_gateway_tls_handshake_total[5m]))"}]},
    {"id": 7, "type": "graph", "title": "Bot-score distribution (heatmap)", "targets": [{"expr": "sum(rate(oya_api_gateway_bot_score_bucket[5m])) by (le)"}]},
    {"id": 8, "type": "graph", "title": "Circuit breaker open count", "targets": [{"expr": "sum(oya_api_gateway_upstream_circuit_open_total)"}]},
    {"id": 9, "type": "graph", "title": "Rate-limit 429 ratio", "targets": [{"expr": "sum(rate(oya_api_gateway_requests_total{code=\"429\"}[5m])) / sum(rate(oya_api_gateway_requests_total[5m]))"}]},
    {"id": 10, "type": "graph", "title": "Cedar permit/deny ratio", "targets": [{"expr": "sum(rate(oya_api_gateway_cedar_decision_total[5m])) by (decision)"}]}
  ]
}
