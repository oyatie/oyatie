{
  "schemaVersion": 39,
  "title": "Data Pipeline local slo burn",
  "tags": [
    "data-pipeline",
    "local-operational-primitive",
    "adr-0130"
  ],
  "timezone": "utc",
  "templating": {
    "list": [
      {
        "name": "tenant_id",
        "type": "query",
        "query": "label_values(oya_data_pipeline_ingest_freshness_total, tenant_id)"
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Ingest batches available inside freshness objective burn",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(rate(oya_data_pipeline_ingest_freshness_good_total[30d])) by (tenant_id, cell_tier) / sum(rate(oya_data_pipeline_ingest_freshness_total[30d])) by (tenant_id, cell_tier)",
          "legendFormat": "ingest-freshness ratio"
        }
      ]
    },
    {
      "id": 2,
      "title": "Transform run latency burn",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(oya_data_pipeline_transform_latency_good_total[5m])) by (tenant_id, cell_tier) / sum(rate(oya_data_pipeline_transform_latency_total[5m])) by (tenant_id, cell_tier)",
          "legendFormat": "transform-latency ratio"
        }
      ]
    },
    {
      "id": 3,
      "title": "Null-rate checks remain below quality threshold burn",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(rate(oya_data_pipeline_quality_null_rate_good_total[30d])) by (tenant_id, cell_tier) / sum(rate(oya_data_pipeline_quality_null_rate_total[30d])) by (tenant_id, cell_tier)",
          "legendFormat": "quality-null-rate ratio"
        }
      ]
    },
    {
      "id": 4,
      "title": "Lineage captured for completed runs burn",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(oya_data_pipeline_lineage_capture_good_total[30d])) by (tenant_id, cell_tier) / sum(rate(oya_data_pipeline_lineage_capture_total[30d])) by (tenant_id, cell_tier)",
          "legendFormat": "lineage-capture ratio"
        }
      ]
    },
    {
      "id": 5,
      "title": "Dead-letter rate below pipeline threshold burn",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(rate(oya_data_pipeline_deadletter_rate_good_total[30d])) by (tenant_id, cell_tier) / sum(rate(oya_data_pipeline_deadletter_rate_total[30d])) by (tenant_id, cell_tier)",
          "legendFormat": "deadletter-rate ratio"
        }
      ]
    },
    {
      "id": 6,
      "title": "Schema drift detected before downstream publish burn",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(oya_data_pipeline_schema_drift_latency_good_total[5m])) by (tenant_id, cell_tier) / sum(rate(oya_data_pipeline_schema_drift_latency_total[5m])) by (tenant_id, cell_tier)",
          "legendFormat": "schema-drift-latency ratio"
        }
      ]
    }
  ]
}
