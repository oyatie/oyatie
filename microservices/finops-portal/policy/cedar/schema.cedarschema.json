{
  "schema_version": "1.0",
  "authored": "2026-05-18",
  "authority": "ADR-0183 cedar-policy-discipline",
  "_comment": "Cedar schema for finops-portal authorization. Loaded by the api crate (IP-005) at process start; validated by `cedar validate` in CI lane lean-a8-cedar-policy-validate.",
  "namespaces": {
    "FinopsPortal": {
      "entityTypes": {
        "TenantAdmin": {
          "shape": {
            "type": "Record",
            "attributes": {
              "tenant_id": { "type": "String", "required": true },
              "residency_region": { "type": "String", "required": true },
              "phi_authorized": { "type": "Boolean", "required": false }
            }
          }
        },
        "OpsFinops": {
          "shape": {
            "type": "Record",
            "attributes": {
              "tenant_scope": { "type": "String", "required": true },
              "residency_region": { "type": "String", "required": true }
            }
          }
        },
        "CustomerSuccess": {
          "shape": {
            "type": "Record",
            "attributes": {
              "managed_tenants": { "type": "Set", "element": { "type": "String" } },
              "residency_region": { "type": "String", "required": true }
            }
          }
        },
        "Regulator": {
          "shape": {
            "type": "Record",
            "attributes": {
              "pack": { "type": "String", "required": true },
              "residency_region": { "type": "String", "required": true }
            }
          }
        },
        "Tenant": {
          "shape": {
            "type": "Record",
            "attributes": {
              "tenant_id": { "type": "String", "required": true },
              "regulatory_pack": { "type": "String", "required": true },
              "residency_region": { "type": "String", "required": true },
              "classification": { "type": "String", "required": false }
            }
          }
        },
        "Invoice": {
          "shape": {
            "type": "Record",
            "attributes": {
              "tenant_id": { "type": "String", "required": true },
              "regulatory_pack": { "type": "String", "required": true },
              "residency_region": { "type": "String", "required": true },
              "period": { "type": "String", "required": true },
              "status": { "type": "String", "required": true }
            }
          }
        },
        "CostAllocationPolicy": {
          "shape": {
            "type": "Record",
            "attributes": {
              "name": { "type": "String", "required": true },
              "scope": { "type": "String", "required": true },
              "regulatory_pack": { "type": "String", "required": false }
            }
          }
        },
        "CreditApplication": {
          "shape": {
            "type": "Record",
            "attributes": {
              "tenant_id": { "type": "String", "required": true },
              "source": { "type": "String", "required": true },
              "regulatory_pack": { "type": "String", "required": true }
            }
          }
        },
        "RegulatorEvidence": {
          "shape": {
            "type": "Record",
            "attributes": {
              "quarter": { "type": "String", "required": true },
              "regulatory_pack": { "type": "String", "required": true },
              "residency_region": { "type": "String", "required": true }
            }
          }
        },
        "Dashboard": {
          "shape": {
            "type": "Record",
            "attributes": {
              "id": { "type": "String", "required": true },
              "scope": { "type": "String", "required": true }
            }
          }
        }
      },
      "actions": {
        "ReadInvoice": { "appliesTo": { "principalTypes": ["TenantAdmin", "OpsFinops", "CustomerSuccess"], "resourceTypes": ["Invoice"] } },
        "FinalizeInvoice": { "appliesTo": { "principalTypes": ["OpsFinops"], "resourceTypes": ["Invoice"] } },
        "ReadInvoicePdf": { "appliesTo": { "principalTypes": ["TenantAdmin", "OpsFinops"], "resourceTypes": ["Invoice"] } },
        "EditCostAllocationPolicy": { "appliesTo": { "principalTypes": ["OpsFinops"], "resourceTypes": ["CostAllocationPolicy"] } },
        "PromoteCostAllocationPolicy": { "appliesTo": { "principalTypes": ["OpsFinops"], "resourceTypes": ["CostAllocationPolicy"] } },
        "ApplyCredit": { "appliesTo": { "principalTypes": ["CustomerSuccess", "OpsFinops"], "resourceTypes": ["CreditApplication"] } },
        "ReadCreditLedger": { "appliesTo": { "principalTypes": ["TenantAdmin", "CustomerSuccess", "OpsFinops"], "resourceTypes": ["CreditApplication"] } },
        "ReadRegulatorEvidence": { "appliesTo": { "principalTypes": ["Regulator", "OpsFinops"], "resourceTypes": ["RegulatorEvidence"] } },
        "EmbedDashboard": { "appliesTo": { "principalTypes": ["TenantAdmin", "OpsFinops"], "resourceTypes": ["Dashboard"] } }
      }
    }
  }
}
