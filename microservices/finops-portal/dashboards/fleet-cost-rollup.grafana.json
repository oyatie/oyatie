{
  "schemaVersion": 39,
  "title": "finops-portal — Fleet Cost Rollup",
  "uid": "finops-portal-fleet-cost-rollup",
  "tags": ["finops-portal", "fleet", "ops-finops"],
  "timezone": "browser",
  "editable": false,
  "_authored": "2026-05-18",
  "_authority": "ADR-0186 + ADR-0199 + IP-008",
  "_panel_tenant_scope": false,
  "_fleet_scope": true,
  "templating": {
    "list": [
      {
        "name": "regulatory_pack",
        "label": "Regulatory pack",
        "type": "custom",
        "options": [
          { "text": "all", "value": ".*", "selected": true },
          { "text": "generic", "value": "generic" },
          { "text": "kr", "value": "kr" },
          { "text": "eu", "value": "eu" },
          { "text": "us-healthcare", "value": "us-healthcare" }
        ]
      },
      {
        "name": "cluster",
        "label": "Cluster",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${MIMIR_DS}" },
        "query": "label_values(opencost_pod_cost, cluster)",
        "includeAll": true,
        "multi": true
      }
    ]
  },
  "time": { "from": "now-30d", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Fleet total (current month)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${MIMIR_DS}" },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(opencost_pod_cost{regulatory_pack=~\"$regulatory_pack\",cluster=~\"$cluster\"})"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "currencyUSD" } }
    },
    {
      "id": 2,
      "title": "Active tenants (current month)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${MIMIR_DS}" },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "count(count by (tenant_id) (opencost_pod_cost{regulatory_pack=~\"$regulatory_pack\"}))"
        }
      ]
    },
    {
      "id": 3,
      "title": "Quarter-over-quarter growth",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${MIMIR_DS}" },
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(opencost_pod_cost{regulatory_pack=~\"$regulatory_pack\"}) / sum(opencost_pod_cost{regulatory_pack=~\"$regulatory_pack\"} offset 90d)) - 1"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit" } }
    },
    {
      "id": 4,
      "title": "Top-10 tenants by current-month spend",
      "type": "table",
      "datasource": { "type": "prometheus", "uid": "${MIMIR_DS}" },
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 6 },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by (tenant_id) (opencost_pod_cost{regulatory_pack=~\"$regulatory_pack\"}))",
          "format": "table"
        }
      ]
    },
    {
      "id": 5,
      "title": "Cost by cluster + cost-center",
      "type": "heatmap",
      "datasource": { "type": "prometheus", "uid": "${MIMIR_DS}" },
      "gridPos": { "h": 12, "w": 12, "x": 0, "y": 18 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (cluster, cost_center) (opencost_pod_cost{regulatory_pack=~\"$regulatory_pack\"})"
        }
      ]
    },
    {
      "id": 6,
      "title": "Growth trend (90 days)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${MIMIR_DS}" },
      "gridPos": { "h": 12, "w": 12, "x": 12, "y": 18 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(opencost_pod_cost{regulatory_pack=~\"$regulatory_pack\"}[1d]))"
        }
      ]
    },
    {
      "id": 7,
      "title": "Headroom alerts (active)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${MIMIR_DS}" },
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 30 },
      "targets": [
        {
          "refId": "A",
          "expr": "count(ALERTS{alertname=~\"TenantBudgetHeadroomLow|TenantBudgetExhausted\",alertstate=\"firing\"})"
        }
      ]
    }
  ]
}
