{
  "$schema": "https://schemas.grafana.com/dashboard.json",
  "_meta": {
    "doc_class": "GrafanaDashboard",
    "microservice": "anonymous",
    "owner_team": "axis-anonymous + ops-security + council-privacy",
    "audience": "platform operators + privacy engineers + council-privacy auditors",
    "tenant_scoped": false,
    "datasource": "Mimir aggregate (oya-anonymous-aggregate); recording-rules"
  },
  "uid": "anon-anonymity-health",
  "title": "Anonymity Health — anonymous µservice",
  "tags": ["anonymous", "privacy", "I1", "I2", "I7"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-7d", "to": "now"},
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "I1 invariant — user_id ↔ post_id correlation attempts (target = 0)",
      "gridPos": {"x": 0, "y": 0, "w": 8, "h": 4},
      "targets": [
        {"expr": "sum(rate(oya_anonymous_correlation_attempt_total[5m]))", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "red", "value": 1}]}}}
    },
    {
      "id": 2,
      "type": "stat",
      "title": "I2 invariant — affinity identity attribute received (target = 0; auto-discarded)",
      "gridPos": {"x": 8, "y": 0, "w": 8, "h": 4},
      "targets": [
        {"expr": "sum(rate(oya_anonymous_identity_attribute_received_and_discarded_total[5m]))", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 10}, {"color": "red", "value": 100}]}}}
    },
    {
      "id": 3,
      "type": "stat",
      "title": "I7 invariant — legal-process disclosures (last 24h)",
      "gridPos": {"x": 16, "y": 0, "w": 8, "h": 4},
      "targets": [
        {"expr": "sum(rate(oya_anonymous_legal_process_disclosure_executed_total[24h]))", "refId": "A"}
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Blind-signature verify latency (p50/p95/p99)",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum by (le)(rate(oya_anonymous_blind_signature_verify_latency_bucket[1m])))", "legendFormat": "p50", "refId": "A"},
        {"expr": "histogram_quantile(0.95, sum by (le)(rate(oya_anonymous_blind_signature_verify_latency_bucket[1m])))", "legendFormat": "p95", "refId": "B"},
        {"expr": "histogram_quantile(0.99, sum by (le)(rate(oya_anonymous_blind_signature_verify_latency_bucket[1m])))", "legendFormat": "p99", "refId": "C"}
      ],
      "fieldConfig": {"defaults": {"unit": "ms"}}
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Blinding-key rotation events (per pack)",
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum by (pack)(rate(oya_anonymous_blind_signature_key_rotation_total[1d]))", "legendFormat": "{{pack}}", "refId": "A"}
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Affinity-attestation verify failures (by reason)",
      "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum by (reason)(rate(oya_anonymous_affinity_attestation_verify_failure_total[5m]))", "legendFormat": "{{reason}}", "refId": "A"}
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Legal-process disclosures (by doctype, last 7d)",
      "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum by (doctype)(rate(oya_anonymous_legal_process_disclosure_executed_total[7d]))", "legendFormat": "{{doctype}}", "refId": "A"}
      ]
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Quarterly transparency-report disclosure count (live aggregate)",
      "gridPos": {"x": 0, "y": 20, "w": 8, "h": 4},
      "targets": [
        {"expr": "sum(oya_anonymous_transparency_report_disclosure_count)", "refId": "A"}
      ]
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Gag-order share (% of disclosures court-prohibited)",
      "gridPos": {"x": 8, "y": 20, "w": 8, "h": 4},
      "targets": [
        {"expr": "100 * sum(rate(oya_anonymous_legal_process_disclosure_executed_total{gag_order=\"true\"}[7d])) / sum(rate(oya_anonymous_legal_process_disclosure_executed_total[7d]))", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "percent"}}
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Dual-control approval latency (p99)",
      "gridPos": {"x": 16, "y": 20, "w": 8, "h": 4},
      "targets": [
        {"expr": "histogram_quantile(0.99, sum by (le)(rate(oya_anonymous_dual_control_approval_latency_bucket[1d])))", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "s"}}
    }
  ]
}
