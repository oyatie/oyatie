{
  "$schema": "https://schemas.grafana.com/dashboard.json",
  "_meta": {
    "doc_class": "GrafanaDashboard",
    "microservice": "anonymous",
    "owner_team": "axis-anonymous + axis-foundry-runtime",
    "audience": "moderators + axis-foundry-runtime + EU DSA transparency-report auditors",
    "tenant_scoped": true,
    "datasource": "Mimir per-tenant (oya-anonymous-{tenant})"
  },
  "uid": "anon-moderation-safety",
  "title": "Moderation + Safety — anonymous µservice",
  "tags": ["anonymous", "moderation", "EU-DSA", "EU-AI-Act"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-24h", "to": "now"},
  "templating": {
    "list": [
      {"name": "tenant", "type": "query", "query": "label_values(oya_anonymous_moderation_verdict_total, tenant_id)"}
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Moderation verdicts (last 24h)",
      "gridPos": {"x": 0, "y": 0, "w": 8, "h": 4},
      "targets": [
        {"expr": "sum(rate(oya_anonymous_moderation_verdict_total{tenant_id=\"$tenant\"}[24h]))", "refId": "A"}
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Auto-moderation share (T2-auto vs T1-assist)",
      "gridPos": {"x": 8, "y": 0, "w": 8, "h": 4},
      "targets": [
        {"expr": "100 * sum(rate(oya_anonymous_moderation_verdict_total{tier=\"T2-auto\",tenant_id=\"$tenant\"}[24h])) / sum(rate(oya_anonymous_moderation_verdict_total{tenant_id=\"$tenant\"}[24h]))", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "percent"}}
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Appeal reversal rate (last 7d) — EU DSA Art. 14 signal",
      "gridPos": {"x": 16, "y": 0, "w": 8, "h": 4},
      "targets": [
        {"expr": "100 * sum(rate(oya_anonymous_appeal_resolved_total{resolution=\"reversed_verdict\",tenant_id=\"$tenant\"}[7d])) / sum(rate(oya_anonymous_appeal_resolved_total{tenant_id=\"$tenant\"}[7d]))", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "percent", "thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 5}, {"color": "red", "value": 15}]}}}
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Classifier verdict distribution by class",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum by (class)(rate(oya_anonymous_moderation_verdict_total{tenant_id=\"$tenant\"}[1m]))", "legendFormat": "{{class}}", "refId": "A"}
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Classifier confidence distribution",
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum by (le)(rate(oya_anonymous_classifier_confidence_bucket{tenant_id=\"$tenant\"}[1m])))", "legendFormat": "p50", "refId": "A"},
        {"expr": "histogram_quantile(0.95, sum by (le)(rate(oya_anonymous_classifier_confidence_bucket{tenant_id=\"$tenant\"}[1m])))", "legendFormat": "p95", "refId": "B"}
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "NCMEC CyberTipline filings (last 30d) — 18 USC §2258A",
      "gridPos": {"x": 0, "y": 12, "w": 8, "h": 4},
      "targets": [
        {"expr": "sum(increase(oya_anonymous_ncmec_report_filed_total{tenant_id=\"$tenant\"}[30d]))", "refId": "A"}
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Abuse reports filed (last 24h)",
      "gridPos": {"x": 8, "y": 12, "w": 8, "h": 4},
      "targets": [
        {"expr": "sum(rate(oya_anonymous_abuse_report_filed_total{tenant_id=\"$tenant\"}[24h]))", "refId": "A"}
      ]
    },
    {
      "id": 8,
      "type": "stat",
      "title": "EU AI Act Art. 50 — ai_assessed_label present rate (target = 100%)",
      "gridPos": {"x": 16, "y": 12, "w": 8, "h": 4},
      "targets": [
        {"expr": "100 * sum(rate(oya_anonymous_moderation_verdict_total{ai_assessed_label_present=\"true\",tenant_id=\"$tenant\"}[1h])) / sum(rate(oya_anonymous_moderation_verdict_total{tenant_id=\"$tenant\"}[1h]))", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "percent", "thresholds": {"steps": [{"color": "red", "value": 0}, {"color": "yellow", "value": 99}, {"color": "green", "value": 100}]}}}
    },
    {
      "id": 9,
      "type": "table",
      "title": "Top 10 appeal reasons (last 7d)",
      "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8},
      "targets": [
        {"expr": "topk(10, sum by (reason)(increase(oya_anonymous_appeal_opened_total{tenant_id=\"$tenant\"}[7d])))", "format": "table", "refId": "A"}
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Moderation queue depth (per hop per ADR-COMM-0001)",
      "gridPos": {"x": 12, "y": 16, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum by (hop)(oya_anonymous_moderation_queue_depth{tenant_id=\"$tenant\"})", "legendFormat": "{{hop}}", "refId": "A"}
      ]
    }
  ]
}
