  "hyperscaler_inv_coverage": {
    "circuit_breaker": "INV-CIRCUIT-BREAKER-BULKHEAD via observability canonical PrometheusRule",
    "tenant_rate_limit": "INV-SHUFFLE-SHARDING via per-tenant and per-cell limit evidence",
    "golden_signals": "INV-FOUR-GOLDEN-SIGNALS via service OpenSLO or performance evidence",
    "error_budget_burn": "INV-SLO-ERROR-BUDGET via service SLO gate"
  },
  "audit_chain": {
    "enabled": true,
    "seal_events": [
      "oya.cloud-billing.doctrine-declared",
      "oya.cloud-billing.dr-failover"
    ]
  },
  "secrets_substrate": {
    "provider": "openbao",
    "format": "${openbao:secret/<path>}"
  },
  "ontology_projections": [],
  "mesh_layering": {
    "cilium_l4": true,
    "ambient_ztunnel": true,
    "ambient_waypoint": false,
    "north_south_only": false
  },
  "capacity_model": {
    "baseline_cpu_per_tenant": 0.25,
    "baseline_ram_per_tenant": 512,
    "storage_per_tenant": 25,
    "connections_per_tenant": {
      "valkey": 2,
      "postgres": 4,
      "outbound_http": 10
    },
    "scaling_dimension": "per_message",
    "cell_placement_class": "Tier-3",
    "notes": "Metering and invoice ledger load scales with Kafka-style metering messages, period-close workers, and tenant-scoped ledgers; PRD/architecture cite 5M events/sec and cell-aware data residency."
  },
  "sharding_automation": {
    "autosharding": "control_plane_driven",
    "auto_rebalance": {
      "enabled": false,
      "trigger_load_skew_threshold_percent": 30,
      "honors_residency": true,
      "honors_compliance_packs": true,
      "audit_chain_emit": true
    },
    "dynamic_sharding": {
      "enabled": false,
      "hot_split_threshold_p99_ms": 50,
      "hot_split_utilization_threshold_percent": 80,
      "cold_merge_utilization_threshold_percent": 20,
      "cold_merge_minimum_quiet_hours": 24,
      "audit_chain_emit": true
    }
  },
  "dr": {
    "rto_p99_seconds": 900,
    "rpo_p99_seconds": 60,
    "multi_region_active_active": true,
    "backup_substrate": [
      "postgres_wal_g",
      "object_storage_versioned",
      "audit_chain_merkle_seal"
    ],
    "failover_runbook": "runbooks/billing-ledger-failover.md",
    "dr_tier": "T2",
    "replication_shape": "active-active-multi-az-cross-region-warm"
  },
  "pod_runtime_tier": 2,
  "pod_runtime_tier_justification": "First-party billing application workload: it handles Oyatie-authored metering, invoices, settlement, and exports; it does not execute tenant-customer code, while FINANCIAL rows and event ledgers are protected by Cedar and audit-chain rather than a Tier-1 substrate runtime.",
  "pod_runtime_tier_surface_evidence": [
    "microservices/cloud-billing/PRD.md",
    "microservices/cloud-billing/ARCHITECTURE.md",
    "microservices/cloud-billing/implementation-plans/IP-014-cell-aware-billing-data-residency.md"
  ],
  "tenant_version_pinning": {
    "declared_versions": [
      "2026-05-21",
      "2026-02-21",
      "2025-11-21"
    ],
    "default_version": "2026-05-21",
    "supported_window_size": 3,
    "supported_window_minimum_days": 180,
    "supports_per_tenant_pinning": true,
    "deprecation_calendar": [],
    "public_surface_files": {
