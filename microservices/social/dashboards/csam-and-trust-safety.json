{
  "dashboard": {
    "title": "Social — CSAM + Trust & Safety",
    "uid": "social-csam-and-trust-safety",
    "tags": ["social", "csam", "trust-safety", "ADR-SOC-0003"],
    "panels": [
      {
        "id": 1,
        "title": "CSAM detection events (24h)",
        "type": "timeseries",
        "targets": [
          {"expr": "sum(rate(oya_social_csam_detect_total[5m])) by (classifier_source)"}
        ]
      },
      {
        "id": 2,
        "title": "NCMEC reports submitted (24h)",
        "type": "stat",
        "targets": [
          {"expr": "sum(rate(oya_social_csam_ncmec_report_total[24h]))"}
        ]
      },
      {
        "id": 3,
        "title": "CSAM classifier latency P99",
        "type": "timeseries",
        "targets": [
          {"expr": "histogram_quantile(0.99, sum(rate(oya_social_csam_classifier_duration_seconds_bucket[5m])) by (le))"}
        ]
      },
      {
        "id": 4,
        "title": "Content moderation actions by class (24h)",
        "type": "piechart",
        "targets": [
          {"expr": "sum(rate(oya_social_moderation_action_total[24h])) by (action_class)"}
        ]
      },
      {
        "id": 5,
        "title": "Appeals submitted vs resolved (DSA Art. 20)",
        "type": "timeseries",
        "targets": [
          {"expr": "sum(rate(oya_social_appeal_submit_total[5m]))", "legendFormat": "submitted"},
          {"expr": "sum(rate(oya_social_appeal_resolve_total[5m]))", "legendFormat": "resolved"}
        ]
      },
      {
        "id": 6,
        "title": "Statement-of-Reasons emission coverage (must be ≥95%)",
        "type": "stat",
        "targets": [
          {"expr": "sum(rate(oya_social_dsa_statement_of_reasons_emit_total[24h])) / sum(rate(oya_social_moderation_action_total[24h]))"}
        ]
      }
    ]
  }
}
