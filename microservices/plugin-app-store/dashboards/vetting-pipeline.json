{
  "title": "Plugin App Store \u2014 Vetting pipeline",
  "uid": "oya-plugin-app-store-vetting-pipeline",
  "schemaVersion": 39,
  "panels": [
    {
      "id": 1,
      "title": "Vetting throughput (decisions/submitted)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(oya_plugin_app_store_vetting_decision_total[1h])) / sum(rate(oya_plugin_app_store_vetting_submitted_total[1h]))"
        }
      ]
    },
    {
      "id": 2,
      "title": "Vetting backlog age p99",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.99, rate(oya_plugin_app_store_vetting_backlog_age_seconds_bucket[5m]))"
        }
      ]
    },
    {
      "id": 3,
      "title": "Rejection rate by stage",
      "type": "barchart",
      "targets": [
        {
          "expr": "sum by (stage) (rate(oya_plugin_app_store_vetting_decision_total{outcome=\"rejected\"}[1h]))"
        }
      ]
    },
    {
      "id": 4,
      "title": "Cosign verification latency p99",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.99, rate(oya_plugin_app_store_cosign_verify_seconds_bucket[5m]))"
        }
      ]
    },
    {
      "id": 5,
      "title": "Trivy scan latency p99",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.99, rate(oya_plugin_app_store_trivy_scan_seconds_bucket[5m]))"
        }
      ]
    },
    {
      "id": 6,
      "title": "Wasmtime isolation validation latency p99",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.99, rate(oya_plugin_app_store_wasmtime_isolation_validate_seconds_bucket[5m]))"
        }
      ]
    }
  ]
}