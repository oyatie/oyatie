    {"name": "oya-plugin-app-store-vetting-pipeline-correctness", "target": "1.0", "sli": "1 - (sum(rate(oya_plugin_app_store_vetting_false_approve_total[24h])) / sum(rate(oya_plugin_app_store_vetting_decision_total[24h])))", "file": "microservices/plugin-app-store/slos/vetting-pipeline-correctness.openslo.yaml"},
    {"name": "oya-plugin-app-store-per-plugin-rate-limit-correctness", "target": "1.0", "sli": "1 - (sum(rate(oya_plugin_app_store_rate_limit_bypass_total[5m])) / sum(rate(oya_plugin_app_store_plugin_request_total[5m])))", "file": "microservices/plugin-app-store/slos/per-plugin-rate-limit-correctness.openslo.yaml"},
    {"name": "oya-plugin-app-store-subscription-billing-correctness", "target": "1.0", "sli": "1 - (sum(rate(oya_plugin_app_store_billing_aggregation_mismatch_total[24h])) / sum(rate(oya_plugin_app_store_billing_aggregation_total[24h])))", "file": "microservices/plugin-app-store/slos/subscription-billing-correctness.openslo.yaml"}
