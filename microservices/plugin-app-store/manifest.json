  "doctrine": {
    "canonical_authority": "ADR-0213",
    "naming_reservation_note": "The substring 'marketplace' in oyatie µservice names is reserved for the future B2C commerce µservice (Amazon/Shopify class), per ADR-0213 §Disambiguation. This µservice (plugin/app distribution + vetting + per-plugin permissioning) is named plugin-app-store, NOT marketplace.",
    "in_house_roadmap_phase": "phase-1-target",
    "inheritance": [
      "Apple App Store — vetting + per-app permissions + sandbox + signature verification",
      "VS Code Marketplace — extension catalog + per-extension permissions + signed artifacts",
      "Shopify App Store — per-install model + scopes + subscription management",
      "AWS Marketplace (SaaS + AMI) — vetted catalog + per-account procurement + billing aggregation",
      "Salesforce AppExchange — enterprise vetting (security review)",
      "JetBrains Marketplace — paid plugins + revenue share + per-plugin signing"
    ]
  },
