{
  "schemaVersion": 39,
  "title": "Incident Management local slo burn",
  "tags": [
    "incident-management",
    "local-operational-primitive",
    "adr-0130"
  ],
  "timezone": "utc",
  "templating": {
    "list": [
      {
        "name": "tenant_id",
        "type": "query",
        "query": "label_values(oya_incident_management_page_to_acknowledge_total, tenant_id)"
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Pages acknowledged inside escalation objective burn",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(rate(oya_incident_management_page_to_acknowledge_good_total[30d])) by (tenant_id, cell_tier) / sum(rate(oya_incident_management_page_to_acknowledge_total[30d])) by (tenant_id, cell_tier)",
          "legendFormat": "page-to-acknowledge ratio"
        }
      ]
    },
    {
      "id": 2,
      "title": "Escalations delivered to current schedule target burn",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(oya_incident_management_escalation_delivery_good_total[30d])) by (tenant_id, cell_tier) / sum(rate(oya_incident_management_escalation_delivery_total[30d])) by (tenant_id, cell_tier)",
          "legendFormat": "escalation-delivery ratio"
        }
      ]
    },
    {
      "id": 3,
      "title": "War-room creation latency burn",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(rate(oya_incident_management_war_room_creation_latency_good_total[5m])) by (tenant_id, cell_tier) / sum(rate(oya_incident_management_war_room_creation_latency_total[5m])) by (tenant_id, cell_tier)",
          "legendFormat": "war-room-creation-latency ratio"
        }
      ]
    },
    {
      "id": 4,
      "title": "Stakeholder update publication latency burn",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(oya_incident_management_stakeholder_update_latency_good_total[5m])) by (tenant_id, cell_tier) / sum(rate(oya_incident_management_stakeholder_update_latency_total[5m])) by (tenant_id, cell_tier)",
          "legendFormat": "stakeholder-update-latency ratio"
        }
      ]
    },
    {
      "id": 5,
      "title": "Postmortems sealed with required timeline evidence burn",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(rate(oya_incident_management_postmortem_seal_completeness_good_total[30d])) by (tenant_id, cell_tier) / sum(rate(oya_incident_management_postmortem_seal_completeness_total[30d])) by (tenant_id, cell_tier)",
          "legendFormat": "postmortem-seal-completeness ratio"
        }
      ]
    },
    {
      "id": 6,
      "title": "Status page projection freshness burn",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(oya_incident_management_statuspage_sync_freshness_good_total[5m])) by (tenant_id, cell_tier) / sum(rate(oya_incident_management_statuspage_sync_freshness_total[5m])) by (tenant_id, cell_tier)",
          "legendFormat": "statuspage-sync-freshness ratio"
        }
      ]
    }
  ]
}
