{
  "$schema": "https://schemas.grafana.com/dashboard.json",
  "_meta": {
    "doc_class": "GrafanaDashboard",
    "microservice": "foundry-eval",
    "owner_team": "axis-foundry + ops-sre-reliability",
    "audience": "capability owners + axis-foundry operators",
    "tenant_scoped": false,
    "datasource": "ClickHouse parity_analytics + Mimir self-observability + per-pack endpoints"
  },
  "uid": "fe-eval-pass-rate",
  "title": "Eval Pass Rate (per-capability + per-cohort)",
  "tags": ["foundry-eval", "eval", "pass-rate"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "60s",
  "time": {"from": "now-7d", "to": "now"},
  "templating": {
    "list": [
      {
        "name": "pack",
        "type": "custom",
        "options": [
          {"text": "pack-kr", "value": "kr", "selected": true},
          {"text": "pack-eu", "value": "eu"},
          {"text": "pack-us", "value": "us"},
          {"text": "pack-us-healthcare", "value": "us-hc"},
          {"text": "pack-jp", "value": "jp"},
          {"text": "pack-sg", "value": "sg"},
          {"text": "pack-au", "value": "au"},
          {"text": "pack-in", "value": "in"},
          {"text": "pack-br", "value": "br"},
          {"text": "pack-ae", "value": "ae"},
          {"text": "pack-ksa", "value": "ksa"}
        ],
        "label": "Pack"
      },
      {
        "name": "capability",
        "type": "query",
        "query": "SELECT DISTINCT capability_id FROM parity_analytics WHERE pack='$pack'",
        "label": "Capability"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Capabilities currently HELD on publish-gate",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "targets": [
        {"expr": "count(oya_foundry_eval_publish_gate_verdict{pack=\"$pack\",verdict=~\"held.*\"})", "refId": "A"}
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Capabilities ELIGIBLE on latest run",
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
      "targets": [
        {"expr": "count(oya_foundry_eval_publish_gate_verdict{pack=\"$pack\",verdict=\"eligible\"})", "refId": "A"}
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Per-capability pass-rate (7d)",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "oya_foundry_eval_pass_rate{pack=\"$pack\",capability=\"$capability\"}",
          "legendFormat": "{{capability}}/{{cohort}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "table",
      "title": "Per-cohort latest pass-rate",
      "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "oya_foundry_eval_pass_rate_by_cohort{pack=\"$pack\",capability=\"$capability\"}",
          "format": "table",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Adversarial cohort pass-rate (target: 1.0)",
      "gridPos": {"x": 0, "y": 20, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "oya_foundry_eval_pass_rate_by_cohort{pack=\"$pack\",cohort=~\"adversarial-.*\"}",
          "legendFormat": "{{capability}}/{{cohort}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Linguistic cohort pass-rate (KR + JP + EN)",
      "gridPos": {"x": 0, "y": 28, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "oya_foundry_eval_pass_rate_by_cohort{pack=\"$pack\",cohort=~\"linguistic-.*\"}",
          "legendFormat": "{{capability}}/{{cohort}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Nightly cadence: last successful tick",
      "gridPos": {"x": 0, "y": 36, "w": 6, "h": 4},
      "targets": [
        {"expr": "time() - oya_foundry_eval_nightly_last_success_at{pack=\"$pack\"}", "refId": "A"}
      ]
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Eval-runner-worker alive",
      "gridPos": {"x": 6, "y": 36, "w": 6, "h": 4},
      "targets": [
        {"expr": "oya_foundry_eval_eval_runner_worker_alive{pack=\"$pack\"}", "refId": "A"}
      ]
    }
  ]
}
