{
  "$schema": "https://schemas.grafana.com/dashboard.json",
  "_meta": {
    "doc_class": "GrafanaDashboard",
    "microservice": "cell",
    "owner_team": "axis-cell-substrate + ops-sre-reliability",
    "related_artifacts": [
      "microservices/cell/contracts/openapi/cell.yaml",
      "microservices/cell/policy/ci-scope.cedar",
      "microservices/cell/capacity-model.md"
    ],
    "audience": "operators + tenant operators (latter sees only own cell)",
    "tenant_scoped": false,
    "datasource": "Mimir (per-pack); X-Scope-OrgID = principal.tenant_id (operator: tenant:oya-aggregate; tenant: own)"
  },
  "uid": "cell-utilization",
  "title": "Cell Utilization (per pack)",
  "tags": ["cell", "capacity", "operator"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "templating": {
    "list": [
      {
        "name": "pack",
        "type": "custom",
        "options": [
          {"text": "pack-kr", "value": "kr", "selected": true},
          {"text": "pack-eu", "value": "eu"},
          {"text": "pack-us", "value": "us"},
          {"text": "pack-us-healthcare", "value": "us-hc"},
          {"text": "pack-jp", "value": "jp"},
          {"text": "pack-sg", "value": "sg"},
          {"text": "pack-au", "value": "au"},
          {"text": "pack-in", "value": "in"},
          {"text": "pack-br", "value": "br"},
          {"text": "pack-ae", "value": "ae"},
          {"text": "pack-ksa", "value": "ksa"}
        ],
        "label": "Pack"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Cells in pack — by state",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 4},
      "targets": [
        {"expr": "count(oya_cell_state{pack=\"$pack\",state=\"ready\"})", "legendFormat": "ready", "refId": "A"},
        {"expr": "count(oya_cell_state{pack=\"$pack\",state=\"provisioning\"})", "legendFormat": "provisioning", "refId": "B"},
        {"expr": "count(oya_cell_state{pack=\"$pack\",state=\"draining\"})", "legendFormat": "draining", "refId": "C"},
        {"expr": "count(oya_cell_state{pack=\"$pack\",state=\"decommissioning-soft-delete\"})", "legendFormat": "decom-soft", "refId": "D"}
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Per-cell utilization (% of capacity envelope)",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "targets": [
        {"expr": "oya_cell_utilization_pct{pack=\"$pack\"}", "legendFormat": "{{cell_id}}", "refId": "A"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "steps": [
              {"color": "yellow", "value": 0},
              {"color": "green", "value": 40},
              {"color": "yellow", "value": 80},
              {"color": "red", "value": 90}
            ]
          }
        }
      },
      "alert": {
        "name": "cell-utilization-band-breach",
        "conditions": [
          {"evaluator": {"params": [80], "type": "gt"}, "query": {"params": ["A", "1h", "now"]}, "type": "query"}
        ],
        "notifications": [{"uid": "grafana-oncall"}]
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Tenants per pack (total)",
      "gridPos": {"x": 0, "y": 12, "w": 6, "h": 4},
      "targets": [
        {"expr": "sum(oya_cell_current_tenants{pack=\"$pack\"})", "refId": "A"}
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Avg tenants per cell (band [40%, 80%] target)",
      "gridPos": {"x": 6, "y": 12, "w": 6, "h": 4},
      "targets": [
        {"expr": "avg(oya_cell_current_tenants{pack=\"$pack\"})", "refId": "A"}
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Cell creation + decommission rate (per hour)",
      "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8},
      "targets": [
        {"expr": "rate(oya_cell_state_transition_total{pack=\"$pack\",new_state=\"ready\"}[1h])", "legendFormat": "new cells ready", "refId": "A"},
        {"expr": "rate(oya_cell_state_transition_total{pack=\"$pack\",new_state=\"decommissioned\"}[1h])", "legendFormat": "cells finalized", "refId": "B"}
      ]
    },
    {
      "id": 6,
      "type": "table",
      "title": "Cells in pack — current snapshot",
      "gridPos": {"x": 0, "y": 24, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "oya_cell_capacity_envelope{pack=\"$pack\"}",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ]
    }
  ]
}
