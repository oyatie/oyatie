{
  "$schema": "https://schemas.grafana.com/dashboard.json",
  "_meta": {
    "doc_class": "GrafanaDashboard",
    "microservice": "cell",
    "owner_team": "axis-cell-substrate",
    "related_artifacts": [
      "microservices/cell/PRD.md (Performance Targets)",
      "microservices/cell/failure-modes.md (FM-03 scheduler outage)"
    ],
    "audience": "operators",
    "tenant_scoped": false,
    "datasource": "Mimir (per-pack; oya-aggregate)"
  },
  "uid": "cell-scheduler-latency",
  "title": "Scheduler Latency + Placement Quality",
  "tags": ["cell", "scheduler", "latency"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "templating": {
    "list": [
      {
        "name": "pack",
        "type": "custom",
        "options": [
          {"text": "pack-kr", "value": "kr", "selected": true},
          {"text": "pack-eu", "value": "eu"},
          {"text": "pack-us", "value": "us"}
        ],
        "label": "Pack"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Cell-assignment lookup latency p50/p99/p999 (target p99 ≤ 50ms)",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum by (le) (rate(oya_cell_assignment_lookup_duration_seconds_bucket{pack=\"$pack\"}[5m])))", "legendFormat": "p50", "refId": "A"},
        {"expr": "histogram_quantile(0.99, sum by (le) (rate(oya_cell_assignment_lookup_duration_seconds_bucket{pack=\"$pack\"}[5m])))", "legendFormat": "p99", "refId": "B"},
        {"expr": "histogram_quantile(0.999, sum by (le) (rate(oya_cell_assignment_lookup_duration_seconds_bucket{pack=\"$pack\"}[5m])))", "legendFormat": "p999", "refId": "C"}
      ],
      "fieldConfig": {
        "defaults": {"unit": "s"}
      },
      "alert": {
        "name": "cell-assignment-lookup-p99-breach",
        "conditions": [
          {"evaluator": {"params": [0.05], "type": "gt"}, "query": {"params": ["B", "5m", "now"]}, "type": "query"}
        ],
        "notifications": [{"uid": "grafana-oncall"}]
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Scheduler placement decision latency p99 (target ≤ 500ms)",
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
      "targets": [
        {"expr": "histogram_quantile(0.99, sum by (le) (rate(oya_cell_placement_decision_duration_seconds_bucket{pack=\"$pack\"}[5m])))", "legendFormat": "p99", "refId": "A"}
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Placement queue depth",
      "gridPos": {"x": 0, "y": 16, "w": 6, "h": 4},
      "targets": [
        {"expr": "oya_cell_placement_queue_depth{pack=\"$pack\"}", "refId": "A"}
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              {"color": "green", "value": 0},
              {"color": "yellow", "value": 50},
              {"color": "red", "value": 100}
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Scheduler alive",
      "gridPos": {"x": 6, "y": 16, "w": 6, "h": 4},
      "targets": [
        {"expr": "oya_cell_scheduler_alive{pack=\"$pack\"}", "refId": "A"}
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Placement binpack quality (1.0 = ideal)",
      "gridPos": {"x": 0, "y": 20, "w": 12, "h": 8},
      "targets": [
        {"expr": "oya_cell_placement_binpack_score{pack=\"$pack\"}", "legendFormat": "binpack score", "refId": "A"}
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Tenant migration end-to-end duration p99 (target ≤ 10min)",
      "gridPos": {"x": 0, "y": 28, "w": 12, "h": 8},
      "targets": [
        {"expr": "histogram_quantile(0.99, sum by (le) (rate(oya_cell_migration_duration_seconds_bucket{pack=\"$pack\"}[1h])))", "legendFormat": "p99 (s)", "refId": "A"}
      ],
      "fieldConfig": {
        "defaults": {"unit": "s"}
      },
      "alert": {
        "name": "cell-migration-p99-breach",
        "conditions": [
          {"evaluator": {"params": [600], "type": "gt"}, "query": {"params": ["A", "1h", "now"]}, "type": "query"}
        ],
        "notifications": [{"uid": "grafana-oncall"}]
      }
    }
  ]
}
