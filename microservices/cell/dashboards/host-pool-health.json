{
  "$schema": "https://schemas.grafana.com/dashboard.json",
  "_meta": {
    "doc_class": "GrafanaDashboard",
    "microservice": "cell",
    "owner_team": "ops-sre-reliability + cloud-k8s",
    "related_artifacts": [
      "microservices/cell/failure-modes.md (FM-04 pool exhaustion; FM-08 drain stuck)",
      "microservices/cell/runbooks/host-pool-exhaustion.md"
    ],
    "audience": "operators",
    "tenant_scoped": false,
    "datasource": "Mimir (per-pack)"
  },
  "uid": "cell-host-pool-health",
  "title": "Host Pool Health (per pack)",
  "tags": ["cell", "host-pool", "operator"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "templating": {
    "list": [
      {
        "name": "pack",
        "type": "custom",
        "options": [
          {"text": "pack-kr", "value": "kr", "selected": true},
          {"text": "pack-eu", "value": "eu"},
          {"text": "pack-us", "value": "us"},
          {"text": "pack-us-healthcare", "value": "us-hc"},
          {"text": "pack-jp", "value": "jp"},
          {"text": "pack-sg", "value": "sg"},
          {"text": "pack-au", "value": "au"},
          {"text": "pack-in", "value": "in"},
          {"text": "pack-br", "value": "br"},
          {"text": "pack-ae", "value": "ae"},
          {"text": "pack-ksa", "value": "ksa"}
        ],
        "label": "Pack"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Warm pool size (target ≥ 2)",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "targets": [
        {"expr": "oya_cell_warm_pool_size{pack=\"$pack\"}", "refId": "A"}
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              {"color": "red", "value": 0},
              {"color": "yellow", "value": 1},
              {"color": "green", "value": 2}
            ]
          }
        }
      },
      "alert": {
        "name": "warm-pool-exhaustion",
        "conditions": [
          {"evaluator": {"params": [2], "type": "lt"}, "query": {"params": ["A", "5m", "now"]}, "type": "query"}
        ],
        "notifications": [{"uid": "grafana-oncall"}]
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Host pool by state",
      "gridPos": {"x": 6, "y": 0, "w": 12, "h": 4},
      "targets": [
        {"expr": "count(oya_cell_host_pool_state{pack=\"$pack\",pool_state=\"warm-standby\"})", "legendFormat": "warm", "refId": "A"},
        {"expr": "count(oya_cell_host_pool_state{pack=\"$pack\",pool_state=\"bound-to-cell\"})", "legendFormat": "bound", "refId": "B"},
        {"expr": "count(oya_cell_host_pool_state{pack=\"$pack\",pool_state=\"draining\"})", "legendFormat": "draining", "refId": "C"}
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Cell creation duration (warm-hit vs cold-provision)",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "targets": [
        {"expr": "histogram_quantile(0.99, sum by (le, source) (rate(oya_cell_create_duration_seconds_bucket{pack=\"$pack\"}[1h])))", "legendFormat": "{{source}} p99", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "s"}}
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Host drain duration (target p99 ≤ 30 min)",
      "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
      "targets": [
        {"expr": "histogram_quantile(0.99, sum by (le) (rate(oya_cell_host_drain_duration_seconds_bucket{pack=\"$pack\"}[1h])))", "legendFormat": "drain p99 (s)", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "s"}},
      "alert": {
        "name": "host-drain-stuck",
        "conditions": [
          {"evaluator": {"params": [1800], "type": "gt"}, "query": {"params": ["A", "30m", "now"]}, "type": "query"}
        ],
        "notifications": [{"uid": "grafana-oncall"}]
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Mass-drain anomaly detector (rate)",
      "gridPos": {"x": 0, "y": 20, "w": 12, "h": 8},
      "targets": [
        {"expr": "rate(oya_cell_host_drain_started_total{pack=\"$pack\"}[5m])", "legendFormat": "drains per second", "refId": "A"}
      ],
      "alert": {
        "name": "mass-drain-suspect",
        "conditions": [
          {"evaluator": {"params": [0.0167], "type": "gt"}, "query": {"params": ["A", "5m", "now"]}, "type": "query"}
        ],
        "notifications": [{"uid": "grafana-oncall"}]
      }
    }
  ]
}
