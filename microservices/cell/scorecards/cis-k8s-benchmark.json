{
  "$schema": "https://oyatie.dev/schemas/cis-k8s-benchmark.json",
  "microservice": "cell",
  "summary": "cell host pool, cell registry, cell boundary gate, bin-pack scheduler",
  "framework": "CIS Kubernetes Benchmark",
  "framework_version": "v1.10.0",
  "evaluated_at": "2026-05-18",
  "profile": "restricted",
  "categories": {
    "pod_security_standards": {
      "status": "green",
      "controls": [
        {
          "id": "5.7.1",
          "name": "Pods should run as non-root",
          "evidence": "microservices/cell/iac/helm/scheduler/templates/deployment.yaml#spec.template.spec.securityContext.runAsNonRoot=true",
          "passing": true
        },
        {
          "id": "5.7.2",
          "name": "Pods should have readOnlyRootFilesystem=true",
          "evidence": "microservices/cell/iac/helm/scheduler/templates/deployment.yaml#containers[].securityContext.readOnlyRootFilesystem=true",
          "passing": true
        },
        {
          "id": "5.7.3",
          "name": "Pods should drop ALL capabilities",
          "evidence": "microservices/cell/iac/helm/scheduler/templates/deployment.yaml#containers[].securityContext.capabilities.drop=[ALL]",
          "passing": true
        },
        {
          "id": "5.7.4",
          "name": "Pods should not allow privilege escalation",
          "evidence": "microservices/cell/iac/helm/scheduler/templates/deployment.yaml#containers[].securityContext.allowPrivilegeEscalation=false",
          "passing": true
        },
        {
          "id": "5.7.5",
          "name": "Pods should use seccompProfile RuntimeDefault",
          "evidence": "microservices/cell/iac/helm/scheduler/templates/deployment.yaml#spec.template.spec.securityContext.seccompProfile.type=RuntimeDefault",
          "passing": true
        }
      ]
    },
    "network_policies": {
      "status": "green",
      "controls": [
        {
          "id": "5.3.1",
          "name": "Default-deny NetworkPolicy in namespace",
          "evidence": "microservices/cell/iac/helm/scheduler/templates/networkpolicy.yaml#default-deny",
          "passing": true
        },
        {
          "id": "5.3.2",
          "name": "Explicit ingress allow-list via Istio mesh",
          "evidence": "microservices/cell/iac/helm/scheduler/templates/networkpolicy.yaml#allow-mesh-ingress",
          "passing": true
        },
        {
          "id": "5.3.3",
          "name": "Explicit egress allow-list (no 0.0.0.0/0 to private CIDRs)",
          "evidence": "microservices/cell/iac/helm/scheduler/templates/networkpolicy.yaml#allow-egress (RFC1918 excepted)",
          "passing": true
        },
        {
          "id": "5.3.4",
          "name": "DNS egress restricted to kube-system",
          "evidence": "microservices/cell/iac/helm/scheduler/templates/networkpolicy.yaml#egress (DNS to kube-system only)",
          "passing": true
        }
      ]
    },
    "rbac": {
      "status": "green",
      "controls": [
        {
          "id": "5.1.1",
          "name": "Cluster-admin role bindings minimized",
          "evidence": "microservices/cloud-k8s/policy/rbac.yaml (no wildcard cluster-admin bindings)",
          "passing": true
        },
        {
          "id": "5.1.2",
          "name": "Per-\u00b5service ServiceAccount (no default SA)",
          "evidence": "microservices/cell/iac/kustomize/base/serviceaccount.yaml",
          "passing": true
        },
        {
          "id": "5.1.3",
          "name": "Minimize wildcard use in Roles",
          "evidence": "microservices/cell/policy/rbac.yaml (no '*' verbs or resources)",
          "passing": true
        },
        {
          "id": "5.1.5",
          "name": "ServiceAccount token automount disabled where unused",
          "evidence": "microservices/cell/iac/helm/scheduler/templates/deployment.yaml#automountServiceAccountToken=true (only when SA used)",
          "passing": true
        }
      ]
    },
    "secrets_management": {
      "status": "green",
      "controls": [
        {
          "id": "5.4.1",
          "name": "Secrets via OpenBao SecretReference URIs (per ADR-0123)",
          "evidence": "microservices/cell/iac/helm/scheduler/values.yaml#openbao",
          "passing": true
        },
        {
          "id": "5.4.2",
          "name": "No literal secrets in values.yaml",
          "evidence": "registry/quality/lanes.yaml#evidence-secret-scan (CI gate); .github/workflows/oya-foundry-fitness-evidence-secret-scan.yml",
          "passing": true
        },
        {
          "id": "5.4.3",
          "name": "Per-pack secret namespaces enforced",
          "evidence": "microservices/cell/iac/kustomize/overlays/pack-kr/kustomization.yaml (per-pack SecretReference URIs)",
          "passing": true
        }
      ]
    },
    "image_security": {
      "status": "green",
      "controls": [
        {
          "id": "5.5.1",
          "name": "Images pinned by tag (no :latest)",
          "evidence": "microservices/cell/iac/helm/scheduler/values.yaml#image.tag (semver-pinned)",
          "passing": true
        },
        {
          "id": "5.5.2",
          "name": "Cosign signature verification at admission",
          "evidence": ".github/workflows/cosign.yml; microservices/cloud-k8s/policy/admission/cosign-verify.yaml",
          "passing": true
        },
        {
          "id": "5.5.3",
          "name": "SBOM published per build",
          "evidence": ".github/workflows/sbom.yml",
          "passing": true
        }
      ]
    }
  },
  "overall_status": "green"
}
