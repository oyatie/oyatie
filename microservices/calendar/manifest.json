        "oya-calendar-event-store-domain",
        "oya-calendar-event-store-kernel",
        "oya-calendar-event-store-rest",
        "oya-calendar-event-store-usecase",
        "oya-calendar-event-store-worker",
        "oya-calendar-tzdb-refresh-worker"
      ]
    },
    {
      "name": "ics-import-export",
      "description": "Bounded context 'ics-import-export' within calendar (data plane)",
