        "oya-calendar-ics-import-export-adapter-caldav-radicale",
        "oya-calendar-ics-import-export-adapter-caldav-sabredav",
        "oya-calendar-ics-import-export-adapter-icalendar"
      ]
    },
    {
      "name": "invitation-flow",
      "description": "Bounded context 'invitation-flow' within calendar (data plane)",
      "crates": [
        "oya-calendar-invitation-flow-kernel"
      ]
    },
    {
      "name": "recurrence-engine",
