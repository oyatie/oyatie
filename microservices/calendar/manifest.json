        "oya-calendar-recurrence-engine-adapter",
        "oya-calendar-recurrence-engine-kernel"
      ]
    },
    {
      "name": "room-booking",
      "description": "Bounded context 'room-booking' within calendar (data plane)",
      "crates": [
        "oya-calendar-room-booking-kernel"
      ]
    }
  ],
