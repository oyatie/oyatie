  "module_library_scope": {
    "note": "Per ADR-0339 (2026-05-21), cloud-iac is the canonical home for the shared OpenTofu IaC module library at microservices/cloud-iac/modules/<context>/<primitive>/. The library houses ~50 reusable per-context primitives consumed by every Oyatie microservice via thin invocation wrappers (<=80 LOC) at microservices/<name>/iac/<context>/main.tf. This is a scope expansion of the cloud-iac microservice from {iac-renderer, iac-validator, iac-applier, iac-registry, iac-rollback} bounded contexts to {iac-renderer, iac-validator, iac-applier, iac-registry, iac-rollback, modules-library}. Authoring the ~50 module bodies is queued as the Wave 15Q-IaC-modules sub-wave per /specs/master-plan-sequencing.json#realignment_wave_sequence.wave_15.subwaves.15Q-IaC-modules.",
    "canonical_path": "microservices/cloud-iac/modules/<context>/<primitive>/",
    "canonical_wrapper_path": "microservices/<name>/iac/<context>/main.tf",
    "wrapper_line_ceiling": 80,
    "wrapper_substance": "primitive selection + tenant-scoped parameters (which library primitives the microservice invokes + how tenant_id/tenant_class/compliance_pack/etc. are passed); NOT inline resource declarations",
    "contexts": [
      "aws-guest",
      "oci-guest",
      "oci-guest/always-free (demo_trial-only sub-context per feedback_oci_always_free_maximization_2026_05_20)",
      "on-prem",
      "colo (alias of on-prem)",
      "oyatie-as-cloud-provider"
    ],
    "primitive_count_minimum_set": 50,
    "primitive_enumeration_per_context": {
      "aws-guest": [
