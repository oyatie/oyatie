{
  "$schema": "https://schemas.grafana.com/dashboard.json",
  "_meta": {
    "doc_class": "GrafanaDashboard",
    "microservice": "forms",
    "owner_team": "axis-forms + foundry-providers-team + council-privacy + council-legal-compliance",
    "audience": "internal operators + axis-forms + council-privacy + regional AI-risk regulator on request",
    "tenant_scoped": false,
    "datasource": "Mimir aggregate (oya-forms tenant + foundry-providers tenant cross-aggregate)"
  },
  "uid": "forms-ai-form-build-quality",
  "title": "oyatie Forms — AI-form-build (T1/T2) Quality + Safety",
  "tags": ["forms", "ai-form-build", "ai-act", "safety", "risk_anchor-iii-4"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "60s",
  "time": {"from": "now-24h", "to": "now"},
  "templating": {
    "list": [
      {
        "name": "pack",
        "type": "custom",
        "options": [
          {"text": "pack-kr", "value": "kr", "selected": true},
          {"text": "pack-eu", "value": "eu"},
          {"text": "pack-us", "value": "us"},
          {"text": "pack-us-healthcare", "value": "us-hc"},
          {"text": "pack-jp", "value": "jp"},
          {"text": "pack-sg", "value": "sg"},
          {"text": "pack-au", "value": "au"},
          {"text": "pack-in", "value": "in"},
          {"text": "pack-br", "value": "br"},
          {"text": "pack-ae", "value": "ae"},
          {"text": "pack-ksa", "value": "ksa"}
        ]
      },
      {
        "name": "provider",
        "type": "query",
        "datasource": "Mimir",
        "query": "label_values(oya_forms_ai_build_request_total, provider_routed)",
        "label": "LLM Provider",
        "includeAll": true
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Schema-valid completion rate (target ≥ 80%)",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "targets": [
        {"expr": "sum(rate(oya_forms_ai_build_response_schema_valid_total{pack=\"$pack\"}[1h])) / sum(rate(oya_forms_ai_build_response_total{pack=\"$pack\"}[1h]))", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "percentunit", "thresholds": {"steps": [{"color": "red", "value": 0}, {"color": "yellow", "value": 0.7}, {"color": "green", "value": 0.8}]}}}
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Tenant accept rate (proxy for quality; target ≥ 50%)",
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
      "targets": [
        {"expr": "sum(rate(oya_forms_ai_build_draft_accepted_total{pack=\"$pack\"}[24h])) / sum(rate(oya_forms_ai_build_draft_requested_total{pack=\"$pack\"}[24h]))", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "percentunit", "thresholds": {"steps": [{"color": "red", "value": 0}, {"color": "yellow", "value": 0.3}, {"color": "green", "value": 0.5}]}}}
    },
    {
      "id": 3,
      "type": "stat",
      "title": "employment-context high-risk auto-decision detection sensitivity (high-recall)",
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
      "targets": [
        {"expr": "sum(rate(oya_forms_ai_build_auto_decision_detected_total{pack=\"$pack\"}[24h])) / sum(rate(oya_forms_ai_build_auto_decision_labelled_corpus_total{pack=\"$pack\"}[24h]))", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "percentunit", "thresholds": {"steps": [{"color": "red", "value": 0}, {"color": "yellow", "value": 0.85}, {"color": "green", "value": 0.9}]}}}
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Prompt-injection detected (MUST be near-zero of total)",
      "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
      "targets": [
        {"expr": "sum(rate(oya_forms_ai_build_prompt_injection_detected_total{pack=\"$pack\"}[1h])) / sum(rate(oya_forms_ai_build_request_total{pack=\"$pack\"}[1h]))", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "percentunit", "thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 0.001}, {"color": "red", "value": 0.01}]}}}
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "AI-form-build latency p95 (target ≤ 8s GA)",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "targets": [
        {"expr": "histogram_quantile(0.95, sum by (le, provider_routed) (rate(oya_forms_ai_build_latency_seconds_bucket{pack=\"$pack\",provider_routed=~\"$provider\"}[5m])))", "legendFormat": "{{provider_routed}} p95", "refId": "A"},
        {"expr": "vector(8.0)", "legendFormat": "GA budget (8s)", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"unit": "s"}}
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Latency breakdown (PII redactor + LLM + schema validation + Cedar)",
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
      "targets": [
        {"expr": "histogram_quantile(0.99, sum by (le, leg) (rate(oya_forms_ai_build_leg_seconds_bucket{pack=\"$pack\"}[5m])))", "legendFormat": "{{leg}} p99", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "s"}}
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Drafts by tier (T0 / T1 / T2-intra / T2-cross)",
      "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum by (tier) (rate(oya_forms_ai_build_request_total{pack=\"$pack\"}[5m]))", "legendFormat": "{{tier}}", "refId": "A"}
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "High-risk classified drafts + DPIA-required count",
      "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum(rate(oya_forms_ai_build_high_risk_classified_total{pack=\"$pack\"}[5m]))", "legendFormat": "high-risk classified", "refId": "A"},
        {"expr": "sum(rate(oya_forms_ai_build_dpia_required_total{pack=\"$pack\"}[5m]))", "legendFormat": "DPIA required", "refId": "B"}
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Rejection reasons (dsl-loader / Cedar / data-class mismatch / cross-µservice / injection)",
      "gridPos": {"x": 0, "y": 20, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum by (reject_reason) (rate(oya_forms_ai_build_rejected_total{pack=\"$pack\"}[5m]))", "legendFormat": "{{reject_reason}}", "refId": "A"}
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "T2-cross safety signals (per ADR-FORMS-0005)",
      "gridPos": {"x": 12, "y": 20, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum(rate(oya_forms_ai_build_t2_cross_safety_signal_total{pack=\"$pack\"}[1h]))", "legendFormat": "safety signals", "refId": "A"},
        {"expr": "sum(rate(oya_forms_ai_build_t2_cross_acceptance_total{pack=\"$pack\"}[1h])) / sum(rate(oya_forms_ai_build_t2_cross_request_total{pack=\"$pack\"}[1h]))", "legendFormat": "t2-cross acceptance rate", "refId": "B"},
        {"expr": "sum(rate(oya_forms_ai_build_t2_cross_revert_total{pack=\"$pack\"}[1h])) / sum(rate(oya_forms_ai_build_t2_cross_accepted_total{pack=\"$pack\"}[1h]))", "legendFormat": "t2-cross revert rate", "refId": "C"}
      ]
    },
    {
      "id": 11,
      "type": "stat",
      "title": "AI Act transparency obligation ack rate (pack-eu)",
      "gridPos": {"x": 0, "y": 28, "w": 12, "h": 4},
      "targets": [
        {"expr": "sum(rate(oya_forms_ai_build_transparency_ack_total{pack=\"eu\"}[24h])) / sum(rate(oya_forms_ai_build_response_total{pack=\"eu\"}[24h]))", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "percentunit", "thresholds": {"steps": [{"color": "red", "value": 0}, {"color": "yellow", "value": 0.95}, {"color": "green", "value": 0.999}]}}}
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Audit-chain seal coverage (AI-form-build invocations)",
      "gridPos": {"x": 12, "y": 28, "w": 12, "h": 4},
      "targets": [
        {"expr": "sum(rate(oya_forms_ai_build_audit_chain_sealed_total{pack=\"$pack\"}[1h])) / sum(rate(oya_forms_ai_build_request_total{pack=\"$pack\"}[1h]))", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "percentunit", "thresholds": {"steps": [{"color": "red", "value": 0}, {"color": "yellow", "value": 0.999}, {"color": "green", "value": 1.0}]}}}
    }
  ]
}
