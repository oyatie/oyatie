{
  "title": "— Webhook Receiver Throughput",
  "description": "Inbound webhook volume, signature-verify outcomes, replay-window blocks, enqueue latency, and DLQ depth. Precedent: Stripe Webhook monitoring dashboard.",
  "uid": "oya-connector-webhook-throughput",
  "tags": ["connector", "webhook", "throughput", "signature"],
  "microservice": "connector",
  "binding_adr": "ADR-0263",
  "refresh": "15s",
  "time": { "from": "now-3h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "tenant_id",
        "type": "query",
        "query": "label_values(oya_connector_webhook_received_total, tenant_id)",
        "label": "Tenant"
      },
      {
        "name": "connector",
        "type": "query",
        "query": "label_values(oya_connector_webhook_received_total{tenant_id=\"$tenant_id\"}, connector)",
        "label": "Connector"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Webhook Ingest Rate (events/s)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (connector) (rate(oya_connector_webhook_received_total{tenant_id=\"$tenant_id\"}[1m]))",
          "legendFormat": "{{connector}}"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "title": "Signature Verify Outcomes",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (result) (rate(oya_connector_webhook_signature_verify_total{tenant_id=\"$tenant_id\",connector=\"$connector\"}[1m]))",
          "legendFormat": "{{result}}"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "thresholds": [
        { "value": 0.01, "color": "yellow", "target": "failed_ratio" }
      ]
    },
    {
      "id": 3,
      "title": "Replay-Window Blocks (per 5min)",
      "type": "stat",
      "description": "Webhooks rejected because timestamp outside ±5min window (per ADR §transport). High value may indicate replay attack — see webhook-replay-attack-detected runbook.",
      "targets": [
        {
          "expr": "sum(increase(oya_connector_webhook_replay_blocked_total{tenant_id=\"$tenant_id\"}[5m]))",
          "legendFormat": "Replay blocks"
        }
      ],
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 8 },
      "thresholds": [
        { "value": 5, "color": "yellow" },
        { "value": 50, "color": "red" }
      ]
    },
    {
      "id": 4,
      "title": "Webhook Ack Latency P99 (ms)",
      "type": "gauge",
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(oya_connector_webhook_ack_duration_seconds_bucket{tenant_id=\"$tenant_id\"}[5m]))) * 1000",
          "legendFormat": "P99 ack ms"
        }
      ],
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 8 },
      "thresholds": [
        { "value": 200, "color": "yellow" },
        { "value": 500, "color": "red" }
      ]
    },
    {
      "id": 5,
      "title": "Idempotency-Key Dedup Rate",
      "type": "timeseries",
      "description": "Fraction of webhooks deduplicated by idempotency-key. Elevated dedup rate signals vendor retry storms.",
      "targets": [
        {
          "expr": "sum by (connector) (rate(oya_connector_webhook_dedup_total{tenant_id=\"$tenant_id\"}[5m]))",
          "legendFormat": "{{connector}} dedup/s"
        }
      ],
      "gridPos": { "h": 4, "w": 12, "x": 12, "y": 8 }
    },
    {
      "id": 6,
      "title": "Enqueue Success Rate",
      "type": "timeseries",
      "targets": [
        {
          "expr": "100 * sum(rate(oya_connector_webhook_enqueued_total{tenant_id=\"$tenant_id\",result=\"success\"}[1m])) / sum(rate(oya_connector_webhook_enqueued_total{tenant_id=\"$tenant_id\"}[1m]))",
          "legendFormat": "enqueue success %"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 }
    },
    {
      "id": 7,
      "title": "Top Webhook Sources by Volume",
      "type": "table",
      "targets": [
        {
          "expr": "topk(15, sum by (connector, source_ip_class) (increase(oya_connector_webhook_received_total{tenant_id=\"$tenant_id\"}[1h])))",
          "legendFormat": "{{connector}} / {{source_ip_class}}"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 }
    }
  ]
}
