{
  "title": "detection investigation-throughput",
  "schemaVersion": 39,
  "tags": [
    "detection",
    "ADR-0307",
    "ADR-0263"
  ],
  "panels": [
    {
      "title": "Signal volume",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(oya_detection_signals_total[5m]))"
        }
      ]
    },
    {
      "title": "Case opens",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(oya_detection_cases_opened_total[5m]))"
        }
      ]
    },
    {
      "title": "Fairness alerts",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(oya_detection_fairness_alerts)"
        }
      ]
    }
  ]
}
