{
  "$schema": "https://schemas.grafana.com/dashboard.json",
  "_meta": {
    "doc_class": "GrafanaDashboard",
    "microservice": "messenger",
    "owner_team": "axis-messenger + ops-security + council-privacy",
    "audience": "tenant compliance officer + axis-messenger SRE + ops-security",
    "tenant_scoped": true,
    "datasource": "per-pack Mimir; audit-chain seal index"
  },
  "uid": "msg-moderation-safety",
  "title": "messenger: moderation + safety + dual-context invariant",
  "tags": ["messenger", "moderation", "safety", "abuse", "dual-context"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {"from": "now-24h", "to": "now"},
  "templating": {
    "list": [
      {"name": "pack", "type": "custom", "label": "Pack",
        "options": [
          {"text": "pack-kr", "value": "kr", "selected": true},
          {"text": "pack-eu", "value": "eu"},
          {"text": "pack-us", "value": "us"},
          {"text": "pack-us-healthcare", "value": "us-hc"},
          {"text": "pack-jp", "value": "jp"},
          {"text": "pack-sg", "value": "sg"},
          {"text": "pack-au", "value": "au"},
          {"text": "pack-in", "value": "in"},
          {"text": "pack-br", "value": "br"},
          {"text": "pack-ae", "value": "ae"},
          {"text": "pack-ksa", "value": "ksa"}
        ]}
    ]
  },
  "panels": [
    {"id": 1, "type": "stat", "title": "Context-switch denied attempts (last 1h)",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "sum(increase(oya_messenger_dual_context_denied_total{pack=\"$pack\"}[1h]))", "refId": "A"}],
      "description": "Per policy/dual-context-isolation.md DCI-02: any non-zero value is a Sev-1.",
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"value": null, "color": "green"}, {"value": 1, "color": "red"}]}}}},

    {"id": 2, "type": "stat", "title": "Infected attachments quarantined (24h)",
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "sum(increase(oya_messenger_attachment_scan_total{scan_status=\"infected\",pack=\"$pack\"}[24h]))", "refId": "A"}]},

    {"id": 3, "type": "stat", "title": "Mention-storm rate (mentions/sec)",
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "sum(rate(oya_messenger_mention_emitted_total{pack=\"$pack\"}[5m]))", "refId": "A"}]},

    {"id": 4, "type": "stat", "title": "Four-eyes disclosure requests (24h)",
      "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "sum(increase(oya_messenger_four_eyes_disclosure_total{pack=\"$pack\"}[24h]))", "refId": "A"}]},

    {"id": 5, "type": "timeseries", "title": "Moderation classifier verdicts (per category)",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum by (verdict) (rate(oya_messenger_moderation_verdict_total{pack=\"$pack\"}[5m]))", "legendFormat": "{{verdict}}", "refId": "A"}
      ],
      "description": "Categories: ok, spam, abuse, harassment, csam-suspect, self-harm-suspect, hate-speech, sexual-content."},

    {"id": 6, "type": "timeseries", "title": "eDiscovery holds active (per tenant)",
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
      "targets": [{"expr": "sum by (tenant_id) (oya_messenger_ediscovery_holds_active{pack=\"$pack\"})", "legendFormat": "{{tenant_id}}", "refId": "A"}]},

    {"id": 7, "type": "timeseries", "title": "Cedar deny ratio (last 1h moving)",
      "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum(rate(oya_messenger_cedar_decision_total{decision=\"deny\",pack=\"$pack\"}[5m])) / sum(rate(oya_messenger_cedar_decision_total{pack=\"$pack\"}[5m]))", "legendFormat": "deny ratio", "refId": "A"}
      ]},

    {"id": 8, "type": "timeseries", "title": "Reported messages (per source: user-report, auto-classifier, both)",
      "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8},
      "targets": [{"expr": "sum by (report_source) (rate(oya_messenger_message_reports_total{pack=\"$pack\"}[5m]))", "legendFormat": "{{report_source}}", "refId": "A"}]},

    {"id": 9, "type": "table", "title": "Channels with active retention/hold tension (retention < hold-extension)",
      "gridPos": {"x": 0, "y": 20, "w": 12, "h": 8},
      "targets": [{"expr": "oya_messenger_retention_hold_conflict{pack=\"$pack\"}", "format": "table", "refId": "A"}]},

    {"id": 10, "type": "table", "title": "Recent four-eyes disclosure events (audit-chain seals)",
      "gridPos": {"x": 12, "y": 20, "w": 12, "h": 8},
      "targets": [{"expr": "topk(20, oya_messenger_four_eyes_disclosure_total{pack=\"$pack\"})", "format": "table", "refId": "A"}]},

    {"id": 11, "type": "stat", "title": "PHI channels in pack (us-healthcare only)",
      "gridPos": {"x": 0, "y": 28, "w": 6, "h": 4},
      "targets": [{"expr": "sum(oya_messenger_channels_phi_total{pack=\"$pack\"})", "refId": "A"}]},

    {"id": 12, "type": "stat", "title": "Personal-DM admin-decrypt attempts (MUST be zero)",
      "gridPos": {"x": 6, "y": 28, "w": 6, "h": 4},
      "targets": [{"expr": "sum(increase(oya_messenger_personal_dm_admin_decrypt_attempt_total{pack=\"$pack\"}[24h]))", "refId": "A"}],
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"value": null, "color": "green"}, {"value": 1, "color": "red"}]}}}}
  ]
}
