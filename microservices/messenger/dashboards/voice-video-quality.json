{
  "$schema": "https://schemas.grafana.com/dashboard.json",
  "_meta": {
    "doc_class": "GrafanaDashboard",
    "microservice": "messenger",
    "owner_team": "axis-messenger + ops-sre-reliability",
    "audience": "tenant operator + axis-messenger SRE; LiveKit SFU ops",
    "tenant_scoped": true,
    "datasource": "per-pack Mimir + LiveKit metrics"
  },
  "uid": "msg-voice-video",
  "title": "messenger: voice + video + huddle quality",
  "tags": ["messenger", "huddle", "webrtc", "livekit", "quality"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "templating": {
    "list": [
      {"name": "pack", "type": "custom", "label": "Pack",
        "options": [
          {"text": "pack-kr", "value": "kr", "selected": true},
          {"text": "pack-eu", "value": "eu"},
          {"text": "pack-us", "value": "us"},
          {"text": "pack-us-healthcare", "value": "us-hc"},
          {"text": "pack-jp", "value": "jp"},
          {"text": "pack-sg", "value": "sg"},
          {"text": "pack-au", "value": "au"},
          {"text": "pack-in", "value": "in"},
          {"text": "pack-br", "value": "br"},
          {"text": "pack-ae", "value": "ae"},
          {"text": "pack-ksa", "value": "ksa"}
        ]},
      {"name": "tenant", "type": "query", "label": "Tenant",
        "query": "label_values(oya_messenger_huddle_setup_seconds_count{pack=\"$pack\"}, tenant_id)"}
    ]
  },
  "panels": [
    {"id": 1, "type": "stat", "title": "Active huddles", "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "sum(livekit_rooms_active{pack=\"$pack\",tenant_id=\"$tenant\"})", "refId": "A"}]},

    {"id": 2, "type": "stat", "title": "Active participants", "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "sum(livekit_participants_active{pack=\"$pack\",tenant_id=\"$tenant\"})", "refId": "A"}]},

    {"id": 3, "type": "stat", "title": "Call setup p95 (s) — target ≤ 1.5",
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(oya_messenger_huddle_setup_seconds_bucket{pack=\"$pack\",tenant_id=\"$tenant\"}[5m])))", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"mode": "absolute", "steps": [{"value": null, "color": "green"}, {"value": 1.0, "color": "yellow"}, {"value": 1.5, "color": "red"}]}}}},

    {"id": 4, "type": "stat", "title": "Mean MOS (E-model G.107)",
      "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "avg(oya_messenger_media_mos{pack=\"$pack\",tenant_id=\"$tenant\"})", "refId": "A"}],
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"value": null, "color": "red"}, {"value": 3.5, "color": "yellow"}, {"value": 4.0, "color": "green"}]}}}},

    {"id": 5, "type": "timeseries", "title": "ICE candidate pair selection (host / srflx / relay)",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum by (candidate_kind) (rate(oya_messenger_ice_selected_total{pack=\"$pack\",tenant_id=\"$tenant\"}[5m]))", "legendFormat": "{{candidate_kind}}", "refId": "A"}
      ]},

    {"id": 6, "type": "timeseries", "title": "Packet loss % distribution (per active session)",
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum by (le) (rate(oya_messenger_media_packet_loss_pct_bucket{pack=\"$pack\",tenant_id=\"$tenant\"}[5m])))", "legendFormat": "p50", "refId": "A"},
        {"expr": "histogram_quantile(0.95, sum by (le) (rate(oya_messenger_media_packet_loss_pct_bucket{pack=\"$pack\",tenant_id=\"$tenant\"}[5m])))", "legendFormat": "p95", "refId": "B"},
        {"expr": "histogram_quantile(0.99, sum by (le) (rate(oya_messenger_media_packet_loss_pct_bucket{pack=\"$pack\",tenant_id=\"$tenant\"}[5m])))", "legendFormat": "p99", "refId": "C"}
      ]},

    {"id": 7, "type": "timeseries", "title": "Jitter ms p95",
      "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(oya_messenger_media_jitter_ms_bucket{pack=\"$pack\",tenant_id=\"$tenant\"}[5m])))", "legendFormat": "p95 jitter", "refId": "A"}]},

    {"id": 8, "type": "timeseries", "title": "LiveKit SFU CPU + memory",
      "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8},
      "targets": [
        {"expr": "avg by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"messenger\",pod=~\"livekit-.*\"}[5m]))", "legendFormat": "{{pod}} cpu", "refId": "A"},
        {"expr": "avg by (pod) (container_memory_usage_bytes{namespace=\"messenger\",pod=~\"livekit-.*\"}) / 1024 / 1024 / 1024", "legendFormat": "{{pod}} mem GB", "refId": "B"}
      ]},

    {"id": 9, "type": "table", "title": "Worst 10 sessions (p99 packet-loss)",
      "gridPos": {"x": 0, "y": 20, "w": 12, "h": 8},
      "targets": [{"expr": "topk(10, oya_messenger_media_packet_loss_pct{pack=\"$pack\",tenant_id=\"$tenant\"})", "format": "table", "refId": "A"}]},

    {"id": 10, "type": "timeseries", "title": "TURN bytes served / sec",
      "gridPos": {"x": 12, "y": 20, "w": 12, "h": 8},
      "targets": [{"expr": "sum(rate(coturn_traffic_bytes_total{pack=\"$pack\"}[5m]))", "legendFormat": "TURN bytes/sec", "refId": "A"}]},

    {"id": 11, "type": "stat", "title": "Burn-rate (huddle setup latency)",
      "gridPos": {"x": 0, "y": 28, "w": 6, "h": 4},
      "targets": [{"expr": "oya_promotion_burn_rate_fast_1h{microservice=\"messenger\",pack=\"$pack\",sli=\"voice-video-setup\"}", "refId": "A"}]},

    {"id": 12, "type": "stat", "title": "Burn-rate (media-quality)",
      "gridPos": {"x": 6, "y": 28, "w": 6, "h": 4},
      "targets": [{"expr": "oya_promotion_burn_rate_fast_1h{microservice=\"messenger\",pack=\"$pack\",sli=\"voice-video-quality\"}", "refId": "A"}]}
  ]
}
