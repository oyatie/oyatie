{
  "$schema": "https://docs.oyatie.dev/schemas/supported-oses.schema.json",
  "microservice": "performance-management",
  "date": "2026-05-21",
  "authority": "feedback_os_support_matrix_2026_05_20",
  "default_distribution_format": "container-image-oci",
  "tier_1_supported_oses": [
    {
      "id": "talos",
      "name": "Talos Linux",
      "format": "container-image-oci",
      "min_version": "1.7",
      "arch": ["linux/amd64", "linux/arm64"]
    },
    {
      "id": "rhel",
      "name": "Red Hat Enterprise Linux",
      "format": "rpm",
      "min_version": "9.4",
      "arch": ["linux/amd64", "linux/arm64", "linux/ppc64le", "linux/s390x"]
    },
    {
      "id": "oracle-linux",
      "name": "Oracle Linux",
      "format": "rpm",
      "min_version": "9.4",
      "arch": ["linux/amd64", "linux/arm64"]
    },
    {
      "id": "suse",
      "name": "SUSE Linux Enterprise Server",
      "format": "rpm",
      "min_version": "15-sp6",
      "arch": ["linux/amd64", "linux/arm64", "linux/ppc64le", "linux/s390x"]
    },
    {
      "id": "ubuntu-lts",
      "name": "Ubuntu LTS",
      "format": "deb",
      "min_version": "24.04",
      "arch": ["linux/amd64", "linux/arm64"]
    },
    {
      "id": "debian",
      "name": "Debian",
      "format": "deb",
      "min_version": "12",
      "arch": ["linux/amd64", "linux/arm64"]
    },
    {
      "id": "rocky",
      "name": "Rocky Linux",
      "format": "rpm",
      "min_version": "9.4",
      "arch": ["linux/amd64", "linux/arm64"]
    },
    {
      "id": "almalinux",
      "name": "AlmaLinux",
      "format": "rpm",
      "min_version": "9.4",
      "arch": ["linux/amd64", "linux/arm64"]
    },
    {
      "id": "centos-stream",
      "name": "CentOS Stream",
      "format": "rpm",
      "min_version": "9",
      "arch": ["linux/amd64", "linux/arm64"]
    },
    {
      "id": "amazon-linux",
      "name": "Amazon Linux",
      "format": "rpm",
      "min_version": "2023",
      "arch": ["linux/amd64", "linux/arm64"]
    },
    {
      "id": "flatcar",
      "name": "Flatcar Container Linux",
      "format": "container-image-oci",
      "min_version": "stable",
      "arch": ["linux/amd64", "linux/arm64"]
    },
    {
      "id": "photon",
      "name": "Photon OS",
      "format": "container-image-oci",
      "min_version": "5.0",
      "arch": ["linux/amd64", "linux/arm64"]
    },
    {
      "id": "macos-apple-silicon-m5-plus",
      "name": "macOS Apple Silicon M5+",
      "format": "pkg",
      "min_version": "16.0",
      "arch": ["darwin/arm64"],
      "scope": "cli-only",
      "note": "Service runs on Linux containers only; macOS support is for the `oya` CLI client."
    }
  ],
  "tier_2_arch_support": ["linux/ppc64le", "linux/s390x"],
  "forbidden": [
    "intel-macos",
    "pre-m5-apple-silicon",
    "windows-server-as-service-host"
  ],
  "ci_lane_per_os": true,
  "package_format_matrix": {
    "rpm": ["rhel", "oracle-linux", "suse", "rocky", "almalinux", "centos-stream", "amazon-linux"],
    "deb": ["ubuntu-lts", "debian"],
    "container-image-oci": ["talos", "flatcar", "photon"],
    "pkg": ["macos-apple-silicon-m5-plus"]
  }
}
