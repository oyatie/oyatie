  "hyperscaler_inv_coverage": {
    "circuit_breaker": "envoy-circuit-breaker-on-ops-control-center-command-upstream; max_connections=100, max_pending_requests=50, outlier_detection consecutive_5xx=3 base_ejection_time=30s",
