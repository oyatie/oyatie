    "primary_sre_signals": "rate=oya_ops_control_center_requests_total; errors=oya_ops_control_center_requests_total{status=~\"5..\"}; latency=oya_ops_control_center_request_duration_seconds_bucket; saturation=oya_ops_control_center_command_queue_depth",
