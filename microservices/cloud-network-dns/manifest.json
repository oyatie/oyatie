      "oya.cloud-network-dns.dr-failover"
    ]
  },
  "secrets_substrate": {
    "provider": "openbao",
    "format": "${openbao:secret/<path>}"
  },
  "ontology_projections": [],
  "mesh_layering": {
    "cilium_l4": true,
    "ambient_ztunnel": true,
    "ambient_waypoint": false,
    "north_south_only": false
  },
  "capacity_model": {
    "baseline_cpu_per_tenant": 0.06,
    "baseline_ram_per_tenant": 128,
    "storage_per_tenant": 1,
    "connections_per_tenant": {
      "valkey": 3,
      "postgres": 1,
      "outbound_http": 4
    },
    "scaling_dimension": "per_request",
    "cell_placement_class": "Tier-4",
    "notes": "DNS query/control load scales by request volume and zone-policy cache churn; ADR-0340 Tier-4 matches edge/perf-critical DNS placement."
  },
  "sharding_automation": {
    "autosharding": "control_plane_driven",
    "auto_rebalance": {
      "enabled": false,
      "trigger_load_skew_threshold_percent": 30,
      "honors_residency": true,
      "honors_compliance_packs": true,
      "audit_chain_emit": true
    },
    "dynamic_sharding": {
      "enabled": false,
      "hot_split_threshold_p99_ms": 50,
      "hot_split_utilization_threshold_percent": 80,
      "cold_merge_utilization_threshold_percent": 20,
      "cold_merge_minimum_quiet_hours": 24,
      "audit_chain_emit": true
    }
  },
  "dr": {
    "rto_p99_seconds": 300,
    "rpo_p99_seconds": 60,
    "multi_region_active_active": true,
    "backup_substrate": [
      "valkey_cluster",
      "postgres_wal_g",
      "object_storage_versioned"
    ],
    "failover_runbook": "runbooks/dns-zone-failover.md",
    "dr_tier": "T1",
    "replication_shape": "active-active-multi-az-cross-region-warm"
  },
  "pod_runtime_tier": 3,
  "pod_runtime_tier_justification": "DNS is edge/performance-critical: authoritative/recursive serving, health checks, and anycast routing demand dedicated edge runc placement per ADR-0338 Tier 3 rather than Kata substrate placement.",
