{
  "title": "Slides — Export + Import pipeline",
  "schemaVersion": 38,
  "uid": "oya-slides-export-import-pipeline",
  "tags": ["slides", "export", "import", "pptx", "pdf", "mp4"],
  "timezone": "browser",
  "refresh": "60s",
  "panels": [
    {
      "title": "Export PDF p95 (50-slide deck; target ≤ 3s)",
      "type": "stat",
      "datasource": "prometheus",
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(oya_slides_export_pdf_seconds_bucket[5m])))" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "thresholds": { "mode": "absolute", "steps": [{"value": 0, "color": "green"}, {"value": 3, "color": "orange"}, {"value": 5, "color": "red"}] } } },
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 }
    },
    {
      "title": "Export PPTX p95 (50-slide deck; target ≤ 5s)",
      "type": "stat",
      "datasource": "prometheus",
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(oya_slides_export_pptx_seconds_bucket[5m])))" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "thresholds": { "mode": "absolute", "steps": [{"value": 0, "color": "green"}, {"value": 5, "color": "orange"}, {"value": 8, "color": "red"}] } } },
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 }
    },
    {
      "title": "Export MP4 p95 (per-slide × 1s + 5s overhead)",
      "type": "stat",
      "datasource": "prometheus",
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(oya_slides_export_mp4_seconds_bucket[5m])))" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } },
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 }
    },
    {
      "title": "Export queue depth",
      "type": "stat",
      "datasource": "prometheus",
      "targets": [
        { "expr": "sum(oya_slides_export_queue_depth)" }
      ],
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [{"value": 0, "color": "green"}, {"value": 100, "color": "orange"}, {"value": 500, "color": "red"}] } } },
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 }
    },
    {
      "title": "Export throughput by format",
      "type": "timeseries",
      "datasource": "prometheus",
      "targets": [
        { "expr": "sum by (format) (rate(oya_slides_export_completed_total[5m]))" }
      ],
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 }
    },
    {
      "title": "Export error rate by format",
      "type": "timeseries",
      "datasource": "prometheus",
      "targets": [
        { "expr": "sum by (format) (rate(oya_slides_export_failed_total[5m])) / sum by (format) (rate(oya_slides_export_completed_total[5m]) + rate(oya_slides_export_failed_total[5m]))" }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit" } },
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 }
    },
    {
      "title": "Import throughput by format",
      "type": "timeseries",
      "datasource": "prometheus",
      "targets": [
        { "expr": "sum by (format) (rate(oya_slides_import_completed_total[5m]))" }
      ],
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 }
    },
    {
      "title": "Import error rate by format",
      "type": "timeseries",
      "datasource": "prometheus",
      "targets": [
        { "expr": "sum by (format) (rate(oya_slides_import_failed_total[5m])) / sum by (format) (rate(oya_slides_import_completed_total[5m]) + rate(oya_slides_import_failed_total[5m]))" }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit" } },
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 }
    },
    {
      "title": "ClamAV / OPSWAT scan verdicts (per import)",
      "type": "timeseries",
      "datasource": "prometheus",
      "targets": [
        { "expr": "sum by (verdict) (rate(oya_slides_import_scan_verdict_total[5m]))" }
      ],
      "gridPos": { "x": 0, "y": 20, "w": 12, "h": 6 }
    },
    {
      "title": "gVisor export worker OOM rate (Sev-1 if > 3 / 5min)",
      "type": "timeseries",
      "datasource": "prometheus",
      "targets": [
        { "expr": "sum(rate(oya_slides_export_worker_oom_total[5m]))" }
      ],
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [{"value": 0, "color": "green"}, {"value": 0.5, "color": "orange"}, {"value": 1, "color": "red"}] } } },
      "gridPos": { "x": 12, "y": 20, "w": 12, "h": 6 }
    },
    {
      "title": "PPTX round-trip subset fidelity (reference corpus drill)",
      "type": "stat",
      "datasource": "prometheus",
      "targets": [
        { "expr": "oya_slides_pptx_roundtrip_subset_pass_rate" }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "thresholds": { "mode": "absolute", "steps": [{"value": 0, "color": "red"}, {"value": 0.9, "color": "orange"}, {"value": 0.95, "color": "green"}] } } },
      "gridPos": { "x": 0, "y": 26, "w": 12, "h": 4 }
    },
    {
      "title": "Chart-live-link refresh latency",
      "type": "timeseries",
      "datasource": "prometheus",
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(oya_slides_chart_refresh_seconds_bucket[5m])))" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } },
      "gridPos": { "x": 12, "y": 26, "w": 12, "h": 4 }
    }
  ]
}
