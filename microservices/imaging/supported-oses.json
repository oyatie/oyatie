{
  "$schema": "https://docs.oyatie.com/schemas/microservice-supported-oses.schema.json",
  "microservice": "imaging",
  "date": "2026-05-21",
  "tier_1_oses": [
    {
      "os": "talos-linux",
      "version": ">=1.7",
      "package_format": "container-image",
      "ci_lane": "imaging-ci-talos",
      "rationale": "Talos is the default sovereign-cell host; immutable, signed, K8s-native for PACS+VNA workloads.",
      "primary_use": "sovereign-cell + on-prem hospital deployments"
    },
    {
      "os": "rhel-9",
      "version": ">=9.4",
      "package_format": "rpm",
      "ci_lane": "imaging-ci-rhel9",
      "rationale": "RHEL is the dominant hospital data-center OS; required for joint Red Hat certifications.",
      "primary_use": "on-prem hospital data centers"
    },
    {
      "os": "oracle-linux-9",
      "version": ">=9.4",
      "package_format": "rpm",
      "ci_lane": "imaging-ci-ol9",
      "rationale": "Oracle Linux pairs with OCI Always Free for demo_trial deployments and customer choice.",
      "primary_use": "oci-guest + Oracle-aligned health systems"
    },
    {
      "os": "suse-linux-enterprise-15",
      "version": ">=SP5",
      "package_format": "rpm",
      "ci_lane": "imaging-ci-sles15",
      "rationale": "SLES is common in European hospital systems and DACH region radiology departments.",
      "primary_use": "EU on-prem + SAP-aligned hospital systems"
    },
    {
      "os": "ubuntu-22.04-lts",
      "version": "22.04",
      "package_format": "deb",
      "ci_lane": "imaging-ci-ubuntu2204",
      "rationale": "Ubuntu LTS is the modern hospital cloud workload OS; common with AI vendor stacks.",
      "primary_use": "AI inference compute pods + research integrations"
    },
    {
      "os": "ubuntu-24.04-lts",
      "version": "24.04",
      "package_format": "deb",
      "ci_lane": "imaging-ci-ubuntu2404",
      "rationale": "Newest LTS for forward-compatibility lane; AI workloads using PyTorch 2.4+ frequently target it.",
      "primary_use": "AI inference compute pods"
    },
    {
      "os": "debian-12",
      "version": "12 (bookworm)",
      "package_format": "deb",
      "ci_lane": "imaging-ci-debian12",
      "rationale": "Debian stable is the OS of academic radiology research labs.",
      "primary_use": "research VNA mirrors + teaching hospitals"
    },
    {
      "os": "rocky-linux-9",
      "version": ">=9.4",
      "package_format": "rpm",
      "ci_lane": "imaging-ci-rocky9",
      "rationale": "Rocky is a drop-in for RHEL in cost-sensitive hospitals; CI parity required.",
      "primary_use": "on-prem hospital cost-sensitive deployments"
    },
    {
      "os": "almalinux-9",
      "version": ">=9.4",
      "package_format": "rpm",
      "ci_lane": "imaging-ci-alma9",
      "rationale": "AlmaLinux is the CloudLinux-backed RHEL alternative used by US safety-net hospitals.",
      "primary_use": "on-prem safety-net + critical-access hospitals"
    },
    {
      "os": "centos-stream-9",
      "version": "9",
      "package_format": "rpm",
      "ci_lane": "imaging-ci-stream9",
      "rationale": "Stream 9 is the upstream-of-RHEL lane; required for early-detection of RHEL regressions in PACS substrate.",
      "primary_use": "regression-pre-detection lane"
    },
    {
      "os": "amazon-linux-2023",
      "version": "2023",
      "package_format": "rpm",
      "ci_lane": "imaging-ci-al2023",
      "rationale": "AL2023 is the aws-guest deployment substrate for AI inference fan-out.",
      "primary_use": "aws-guest AI compute"
    },
    {
      "os": "flatcar-stable",
      "version": "stable channel",
      "package_format": "container-image",
      "ci_lane": "imaging-ci-flatcar",
      "rationale": "Flatcar provides Kinvolk/Microsoft-aligned immutable lane parity with Talos.",
      "primary_use": "alternate sovereign-cell + colo edge"
    },
    {
      "os": "photon-os-5",
      "version": ">=5.0",
      "package_format": "rpm",
      "ci_lane": "imaging-ci-photon5",
      "rationale": "Photon is VMware/Broadcom's hypervisor-native OS; hospital VMware estates rely on it.",
      "primary_use": "on-prem VMware hospital estates"
    }
  ],
  "tier_2_arches": ["linux/ppc64le", "linux/s390x"],
  "developer_workstation_only": ["darwin/arm64 (Apple Silicon M5+)"],
  "forbidden_oses": ["windows-server (use WSL2 layer-2 only)", "macos-intel (no Intel Macs)", "macos-pre-M5"]
}
