{
  "schema_version": "1.0",
  "microservice": "cell-lifecycle",
  "version": "0.1.0",
  "owner": "axis-cellular",
  "bounded_context": "cell-logical-state-machine",
  "governance_lane_authority": [
    "ADR-0276",
    "ADR-0266",
    "ADR-0204"
  ],
  "tenant_class": [
    "demo_trial",
    "paid"
  ],
  "pod_runtime_tier": 1,
  "cell_placement_class": 0,
  "id_strategy": "uuidv7",
  "id_strategy_note": "ADR-0275 was requested as authority for uuidv7; this scaffold declares uuidv7 ids for Cell, LifecycleHistory, and idempotency records while implementation remains downstream.",
  "bounded_contexts": [
    {
      "name": "cell-logical-state-machine",
      "description": "Logical Cell aggregate lifecycle state machine per ADR-0276 D-3; not infrastructure provisioning, tenant migration, routing, or generic cell service scope.",
