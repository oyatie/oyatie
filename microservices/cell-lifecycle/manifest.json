    "provider": "openbao",
    "format": "${openbao:secret/<path>}"
  },
  "ontology_projections": [
    {
      "entity_name": "Cell",
      "projection_target_table": "ontology_cells",
      "projection_kind": "idempotent-rewrite",
      "lag_budget_seconds": 30
    },
    {
      "entity_name": "LifecycleHistory",
      "projection_target_table": "ontology_cell_lifecycle_history",
      "projection_kind": "append-only",
      "lag_budget_seconds": 30
    }
  ],
  "mesh_layering": {
    "cilium_l4": true,
    "ambient_ztunnel": true,
    "ambient_waypoint": true,
    "north_south_only": false
