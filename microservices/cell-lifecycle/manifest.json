    "scaling_dimension": "per_request",
    "cell_placement_class": "Tier-0",
    "tenant_class_deltas": {
      "demo_trial": {
        "baseline_cpu_per_tenant": 0.005,
        "baseline_ram_per_tenant": 16,
        "storage_per_tenant": 1,
        "connections_per_tenant": {
          "valkey": 1,
          "postgres": 1,
          "outbound_http": 2
        },
        "scaling_dimension": "per_request",
        "cell_placement_class": "Tier-0"
      },
      "paid": {
        "baseline_cpu_per_tenant": 0.02,
        "baseline_ram_per_tenant": 64,
        "storage_per_tenant": 2,
        "connections_per_tenant": {
          "valkey": 1,
          "postgres": 1,
          "outbound_http": 4
        },
        "scaling_dimension": "per_request",
        "cell_placement_class": "Tier-0"
      }
    },
    "notes": "Small footprint control-plane registry; cell count grows slowly, but Tier-0 placement is required because lifecycle mistakes expand blast radius."
  },
  "dr": {
    "rto_minutes": 5,
    "rto_p99_seconds": 300,
    "rpo_p99_seconds": 30,
    "multi_region_active_active": true,
