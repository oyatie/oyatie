  "hyperscaler_inv_coverage": {
    "blast_radius_cellular_topology": "ADR-0204 Tier 0..4 placement checks enforced before promotion",
    "promotion_gate_error_budget": "ADR-0266 error budget, warm-soak, canary, mesh, tenant-class, compliance-pack gates",
    "audit_chain_seal": "ADR-0217 transition evidence emitted for every accepted or rejected privileged lifecycle transition",
    "carrier_triplet": "ADR-0267 header, URL prefix, and schema-level oyatie_version carriers in OpenAPI contract"
  },
  "audit_chain": {
    "enabled": true,
    "seal_events": [
      "cell.lifecycle.transition.accepted",
      "cell.lifecycle.transition.rejected",
      "cell.promotion.executed",
      "cell.drain.requested",
      "cell.decommission.executed",
      "cell.rollback.initiated"
    ]
  },
