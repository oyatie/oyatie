  "sharding_automation": {
    "autosharding_mode": "not_applicable_registry_authority",
    "auto_rebalance": {
      "enabled": false,
      "reason": "cell-lifecycle does not auto-rebalance itself; it triggers cell-rebalancer during drain."
    },
    "dynamic_sharding": {
      "enabled": false,
      "reason": "cell count grows slowly and registry history is Postgres-partitioned, not dynamically split by this service."
    },
    "drain_rebalance_trigger": {
      "enabled": true,
      "target_microservice": "cell-rebalancer",
      "receipt_required": true
    }
