  "slos": [
    {
      "name": "cell-lifecycle-register-api-p99",
      "target": "100ms",
      "sli": "api_p99_latency_ms{operation=\"registerCell\"}",
      "file": "microservices/cell-lifecycle/slos/cell-lifecycle.openslo.yaml"
    },
    {
      "name": "cell-lifecycle-promote-api-p99",
      "target": "500ms",
      "sli": "api_p99_latency_ms{operation=\"promoteCell\"}",
      "file": "microservices/cell-lifecycle/slos/cell-lifecycle.openslo.yaml"
    },
    {
      "name": "cell-lifecycle-drain-api-p99",
      "target": "200ms",
      "sli": "api_p99_latency_ms{operation=\"drainCell\"}",
      "file": "microservices/cell-lifecycle/slos/cell-lifecycle.openslo.yaml"
    },
    {
      "name": "cell-lifecycle-lookup-api-p99",
      "target": "50ms",
      "sli": "api_p99_latency_ms{operation=~\"listCells|getCellLifecycle\"}",
      "file": "microservices/cell-lifecycle/slos/cell-lifecycle.openslo.yaml"
    },
    {
      "name": "promotion-evidence-validation-p99",
      "target": "30s",
      "sli": "promotion_evidence_validation_p99_seconds",
      "file": "microservices/cell-lifecycle/slos/cell-lifecycle.openslo.yaml"
    },
    {
      "name": "drain-to-decommission-duration",
      "target": "168h",
      "sli": "drain_to_decommission_max_duration_hours",
      "file": "microservices/cell-lifecycle/slos/cell-lifecycle.openslo.yaml"
    }
  ],
