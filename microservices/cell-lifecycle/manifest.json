      "postgres_wal_g",
      "valkey_cluster",
      "audit_chain_merkle_seal"
    ],
    "failover_runbook": "runbooks/on-call.md",
    "dr_tier": "T1",
    "replication_shape": "active-active-multi-az-cross-region-warm"
  },
  "pod_runtime_tier_justification": "cell-lifecycle is a substrate service controlling logical cell state and tenant-data-plane blast-radius decisions, so it runs at Tier 1 Kata even though it does not execute tenant-supplied code.",
