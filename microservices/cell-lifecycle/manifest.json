  "capacity_model": {
    "baseline_cpu_per_tenant": 0.01,
    "baseline_ram_per_tenant": 32,
    "storage_per_tenant": 1,
    "connections_per_tenant": {
      "valkey": 1,
      "postgres": 1,
      "outbound_http": 3
