{
  "capability_id": "T2-tenant-domain-mgmt",
  "tier": "T2",
  "name": "Per-tenant from-domain lifecycle management",
  "owner": "oya-substrate-comms",
  "adr_anchors": ["ADR-0201", "ADR-0064", "ADR-0173"],
  "description": "Onboard, warm-up, rotate, and revoke per-tenant from-domains. Generates DKIM keys, emits DNS publish requests, binds provider identities, and tracks state.",
  "data_class": "Tenant-Config",
  "operations": [
    {
      "verb": "POST",
      "path": "/v1/tenants/{tenant_id}/from-domains",
      "name": "onboard"
    },
    {
      "verb": "GET",
      "path": "/v1/tenants/{tenant_id}/from-domains",
      "name": "list"
    },
    {
      "verb": "POST",
      "path": "/v1/tenants/{tenant_id}/from-domains/{from_domain}/rotate-dkim",
      "name": "rotate"
    },
    {
      "verb": "POST",
      "path": "/v1/tenants/{tenant_id}/from-domains/{from_domain}/revoke-dkim",
      "name": "revoke"
    }
  ],
  "states": [
    "requested",
    "dns-pending",
    "dns-published",
    "provider-binding",
    "provider-bound",
    "warm-up",
    "active",
    "rotating",
    "revoked"
  ],
  "audit_chain_events": [
    "from-domain.onboarded",
    "from-domain.state-transition",
    "dkim.rotated",
    "dkim.revoked",
    "dns.publish.requested"
  ],
  "slo_anchors": [
    "from-domain-onboarding-time"
  ]
}
