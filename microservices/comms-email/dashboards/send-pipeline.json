{
  "title": "comms-email · send pipeline",
  "description": "Hot-path send metrics: latency, success rate, DKIM signed rate, suppression hit rate.",
  "tags": ["comms-email", "adr-0201", "hot-path"],
  "panels": [
    {
      "title": "Send latency p99 (ms)",
      "type": "graph",
      "targets": [
        {"expr": "histogram_quantile(0.99, sum by (le, region) (rate(comms_email_send_latency_ms_bucket[5m])))"}
      ],
      "thresholds": [{"value": 500, "colorMode": "critical", "op": "gt"}]
    },
    {
      "title": "Send success rate",
      "type": "graph",
      "targets": [
        {"expr": "sum(rate(comms_email_provider_accepted_total[5m])) / (sum(rate(comms_email_provider_accepted_total[5m])) + sum(rate(comms_email_provider_error_total[5m])))"}
      ]
    },
    {
      "title": "DKIM signing rate",
      "type": "graph",
      "targets": [
        {"expr": "sum(rate(comms_email_provider_accepted_total{dkim_signed=\"true\"}[5m])) / sum(rate(comms_email_provider_accepted_total[5m]))"}
      ]
    },
    {
      "title": "Suppression preflight rejections",
      "type": "graph",
      "targets": [
        {"expr": "sum by (tenant_id) (rate(comms_email_preflight_rejected_total{kind=\"RecipientSuppressed\"}[5m]))"}
      ]
    },
    {
      "title": "Sends per provider",
      "type": "graph",
      "targets": [
        {"expr": "sum by (provider) (rate(comms_email_provider_accepted_total[5m]))"}
      ]
    }
  ]
}
