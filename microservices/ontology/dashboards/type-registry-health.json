{
  "title": "Ontology — Type Registry Health",
  "uid": "ontology-type-registry-health",
  "schemaVersion": 38,
  "tags": ["ontology", "type-registry", "schema-registry"],
  "timezone": "browser",
  "refresh": "30s",
  "panels": [
    {
      "type": "stat",
      "title": "Registered Object Types (total)",
      "targets": [
        {
          "expr": "count by (object_type) (oya_ontology_object_type_registered_total)",
          "legendFormat": "{{object_type}}"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Registered Link Types (total)",
      "targets": [
        {
          "expr": "count by (link_type) (oya_ontology_link_type_registered_total)"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Registered Action Types (total)",
      "targets": [
        {
          "expr": "count by (action_type) (oya_ontology_action_type_registered_total)"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Registered Function Types (total)",
      "targets": [
        {
          "expr": "count by (function_type) (oya_ontology_function_type_registered_total)"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Schema registry write throughput (per schema kind)",
      "targets": [
        {
          "expr": "rate(oya_ontology_type_registry_writes_total[5m])",
          "legendFormat": "{{schema_kind}}/{{outcome}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Schema-validation failures",
      "targets": [
        {
          "expr": "rate(oya_ontology_type_registry_validation_failures_total[5m])",
          "legendFormat": "{{schema_kind}}/{{error_type}}"
        }
      ],
      "alert": {
        "name": "Schema validation failures > 0 over 5m",
        "conditions": [{"type": "query", "evaluator": {"type": "gt", "params": [0]}}]
      }
    },
    {
      "type": "timeseries",
      "title": "Schema-propagation event lag (Kafka outbox → consumer)",
      "targets": [
        {
          "expr": "kafka_consumer_lag_seconds{group=\"ontology-schema-propagation\"}",
          "legendFormat": "{{partition}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Deprecated Object Type reads (catch laggard tenants)",
      "targets": [
        {
          "expr": "rate(oya_ontology_deprecated_type_read_total[1h])",
          "legendFormat": "{{type}}/{{tenant_id_hashed}}"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Tier-enforcement violations (last 24h)",
      "targets": [
        {
          "expr": "increase(oya_ontology_tier_enforcement_violations_total[24h])"
        }
      ],
      "alert": {
        "name": "Tier-enforcement violation > 0",
        "conditions": [{"type": "query", "evaluator": {"type": "gt", "params": [0]}}]
      }
    },
    {
      "type": "stat",
      "title": "Cedar coverage % (Action Types with permit)",
      "targets": [
        {
          "expr": "(count(oya_ontology_action_type_with_cedar_permit_total) / count(oya_ontology_action_type_registered_total)) * 100"
        }
      ],
      "thresholds": [{"color": "red", "value": 0}, {"color": "yellow", "value": 99.9}, {"color": "green", "value": 100}]
    },
    {
      "type": "timeseries",
      "title": "Schema-registry Valkey cache hit rate",
      "targets": [
        {
          "expr": "rate(oya_ontology_schema_cache_hit_total[5m]) / (rate(oya_ontology_schema_cache_hit_total[5m]) + rate(oya_ontology_schema_cache_miss_total[5m]))"
        }
      ]
    }
  ]
}
