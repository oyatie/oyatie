{
  "dashboard": {
    "title": "Ontology — Abuse-Defence Outcomes",
    "uid": "ontology-abuse-defence-outcomes",
    "tags": ["ontology", "abuse-defence", "ADR-0297", "UX-floor"],
    "panels": [
      {
        "id": 1,
        "title": "Default-path latency added by bot-mgmt (P99 ms)",
        "type": "timeseries",
        "targets": [
          {"expr": "histogram_quantile(0.99, sum(rate(oya_ontology_abuse_defence_added_latency_seconds_bucket[5m])) by (le))"}
        ],
        "thresholds": [{"color": "green", "value": 0}, {"color": "red", "value": 0.002}],
        "description": "UX-floor: MUST stay ≤2ms p99"
      },
      {
        "id": 2,
        "title": "False-positive rate (legitimate users blocked)",
        "type": "stat",
        "targets": [
          {"expr": "sum(rate(oya_ontology_abuse_defence_false_positive_total[24h])) / sum(rate(oya_ontology_abuse_defence_evaluation_total[24h]))"}
        ],
        "description": "Should be < 0.1%"
      },
      {
        "id": 3,
        "title": "Blocked-bot count by audience_type",
        "type": "timeseries",
        "targets": [
          {"expr": "sum(rate(oya_ontology_abuse_defence_blocked_total[5m])) by (audience_type, reason)"}
        ]
      },
      {
        "id": 4,
        "title": "CAPTCHA presentations (UX-friction events)",
        "type": "timeseries",
        "targets": [
          {"expr": "sum(rate(oya_ontology_abuse_defence_captcha_present_total[5m])) by (challenge_type)"}
        ],
        "description": "UX-floor: zero on default path; presented only when bot_score > 95"
      },
      {
        "id": 5,
        "title": "Per-tenant false-positive rate (tenant-admin visibility)",
        "type": "table",
        "targets": [
          {"expr": "sum(rate(oya_ontology_abuse_defence_false_positive_total[24h])) by (tenant_id) / sum(rate(oya_ontology_abuse_defence_evaluation_total[24h])) by (tenant_id)"}
        ]
      },
      {
        "id": 6,
        "title": "Adversary fingerprint count (24h)",
        "type": "stat",
        "targets": [
          {"expr": "count(count by (fingerprint) (oya_ontology_abuse_defence_blocked_total{reason=\"adversary_fingerprint\"}))"}
        ]
      }
    ]
  }
}
