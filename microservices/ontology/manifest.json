      "file": "microservices/ontology/slos/dynamic-layer-freshness.openslo.yaml"
    },
    {
      "name": "ontology-function-read-availability",
      "target": "0.9999",
      "sli": "sum(rate(oya_ontology_function_evaluations_total{outcome=\"success\"}[1m]))",
      "file": "microservices/ontology/slos/function-read-availability.openslo.yaml"
    },
    {
      "name": "ontology-function-read-latency",
      "target": "0.99",
      "sli": "sum(rate(oya_ontology_function_evaluation_duration_seconds_bucket{le=\"0.050\"}[1m]))",
      "file": "microservices/ontology/slos/function-read-latency.openslo.yaml"
    }
