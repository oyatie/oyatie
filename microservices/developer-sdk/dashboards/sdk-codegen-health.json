{
  "title": "Developer SDK \u2014 SDK codegen health",
  "uid": "oya-developer-sdk-codegen-health",
  "schemaVersion": 39,
  "panels": [
    {
      "id": 1,
      "title": "Codegen run latency p99 (per family)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (family) (rate(oya_developer_sdk_codegen_duration_seconds_bucket[5m])))"
        }
      ]
    },
    {
      "id": 2,
      "title": "Codegen determinism violations",
      "type": "stat",
      "targets": [
        {
          "expr": "rate(oya_developer_sdk_codegen_determinism_violation_total[1h])"
        }
      ]
    },
    {
      "id": 3,
      "title": "SDK package downloads (per family)",
      "type": "barchart",
      "targets": [
        {
          "expr": "sum by (family) (rate(oya_developer_sdk_package_download_total[1h]))"
        }
      ]
    },
    {
      "id": 4,
      "title": "Sandbox provision p99 latency",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.99, rate(oya_developer_sdk_sandbox_provision_seconds_bucket[5m]))"
        }
      ]
    },
    {
      "id": 5,
      "title": "Sandbox reset p99 latency",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.99, rate(oya_developer_sdk_sandbox_reset_seconds_bucket[5m]))"
        }
      ]
    }
  ]
}