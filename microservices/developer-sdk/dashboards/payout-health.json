{
  "title": "Developer SDK \u2014 Payout health",
  "uid": "oya-developer-sdk-payout-health",
  "schemaVersion": 39,
  "panels": [
    {
      "id": 1,
      "title": "Payout settlement correctness (1.0 target)",
      "type": "stat",
      "targets": [
        {
          "expr": "1 - (sum(rate(oya_developer_sdk_payout_settlement_mismatch_total[24h])) / sum(rate(oya_developer_sdk_payout_settlement_total[24h])))"
        }
      ]
    },
    {
      "id": 2,
      "title": "Payout latency p99 (batch wall-clock)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.99, rate(oya_developer_sdk_payout_batch_duration_seconds_bucket[5m]))"
        }
      ]
    },
    {
      "id": 3,
      "title": "Payouts by rail",
      "type": "barchart",
      "targets": [
        {
          "expr": "sum by (rail) (rate(oya_developer_sdk_payout_settled_total[24h]))"
        }
      ]
    },
    {
      "id": 4,
      "title": "Bank rejections by rail",
      "type": "barchart",
      "targets": [
        {
          "expr": "sum by (rail) (rate(oya_developer_sdk_payout_bank_rejected_total[24h]))"
        }
      ]
    },
    {
      "id": 5,
      "title": "Tax-form emission correctness",
      "type": "stat",
      "targets": [
        {
          "expr": "1 - (sum(rate(oya_developer_sdk_tax_form_emission_mismatch_total[7d])) / sum(rate(oya_developer_sdk_tax_form_emission_total[7d])))"
        }
      ]
    }
  ]
}