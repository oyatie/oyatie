{
  "$schema": "https://oyatie.dev/schemas/aws-well-architected.json",
  "microservice": "mail",
  "summary": "mailbox store + SMTP in/out + IMAP frontend + search + dual-context isolation",
  "framework": "AWS Well-Architected (5 pillars)",
  "framework_version": "2024-12",
  "evaluated_at": "2026-05-18",
  "pillars": {
    "operational_excellence": {
      "status": "green",
      "controls": [
        {
          "id": "OPS-01",
          "name": "Runbooks for every recoverable failure mode",
          "evidence": "microservices/mail/runbooks/ (6 runbooks)",
          "passing": true
        },
        {
          "id": "OPS-02",
          "name": "Failure modes catalogued",
          "evidence": "microservices/mail/failure-modes.md",
          "passing": true
        },
        {
          "id": "OPS-03",
          "name": "Incident-response procedure documented",
          "evidence": "microservices/mail/incident-response.md",
          "passing": true
        },
        {
          "id": "OPS-04",
          "name": "IaC-as-code (Helm + Kustomize per ADR-0131)",
          "evidence": "microservices/mail/iac/helm/mail-app/Chart.yaml",
          "passing": true
        },
        {
          "id": "OPS-05",
          "name": "Observability wiring (OTel + Prometheus)",
          "evidence": "microservices/mail/dashboards/ (3 dashboards)",
          "passing": true
        },
        {
          "id": "OPS-06",
          "name": "CI-gated deployment (branch protection + status checks)",
          "evidence": ".github/branch-protection.yaml; .github/workflows/promote-dev-to-staging.yml; .github/workflows/promote-staging-to-production.yml",
          "passing": true
        }
      ]
    },
    "security": {
      "status": "green",
      "controls": [
        {
          "id": "SEC-01",
          "name": "Threat model authored",
          "evidence": "microservices/mail/threat-model.md",
          "passing": true
        },
        {
          "id": "SEC-02",
          "name": "Secrets via OpenBao SecretReference URI (per ADR-0123)",
          "evidence": "microservices/mail/iac/helm/mail-app/values.yaml#openbao",
          "passing": true
        },
        {
          "id": "SEC-03",
          "name": "Cedar policy gate (ABAC default-deny)",
          "evidence": "microservices/mail/policy/",
          "passing": true
        },
        {
          "id": "SEC-04",
          "name": "TLS in-transit (Istio mTLS mesh)",
          "evidence": "microservices/cloud-k8s/iac/helm/istio-base/Chart.yaml#mesh-mtls=STRICT",
          "passing": true
        },
        {
          "id": "SEC-05",
          "name": "Branch protection + reviewer-agent APPROVE required",
          "evidence": ".github/branch-protection.yaml",
          "passing": true
        },
        {
          "id": "SEC-06",
          "name": "DPIA + compliance posture documented",
          "evidence": "microservices/mail/dpia.md, microservices/mail/compliance.md",
          "passing": true
        }
      ]
    },
    "reliability": {
      "status": "green",
      "controls": [
        {
          "id": "REL-01",
          "name": "OpenSLO manifests authored",
          "evidence": "microservices/mail/slos/ (9 OpenSLO manifests)",
          "passing": true
        },
        {
          "id": "REL-02",
          "name": "Capacity model documented",
          "evidence": "microservices/mail/capacity-model.md",
          "passing": true
        },
        {
          "id": "REL-03",
          "name": "Multi-region failover plan",
          "evidence": "microservices/mail/multi-region.md",
          "passing": true
        },
        {
          "id": "REL-04",
          "name": "Backfill / replay procedure",
          "evidence": "microservices/mail/backfill-replay.md",
          "passing": true
        },
        {
          "id": "REL-05",
          "name": "HPA + PDB declared",
          "evidence": "microservices/mail/iac/helm/mail-app/values.yaml#hpa",
          "passing": true
        },
        {
          "id": "REL-06",
          "name": "ADR-0130 SLO-gated promotion",
          "evidence": "docs/decisions/ADR-0130-agentic-slo-gated-promotion.md",
          "passing": true
        }
      ]
    },
    "performance_efficiency": {
      "status": "green",
      "controls": [
        {
          "id": "PERF-01",
          "name": "Resource requests + limits set",
          "evidence": "microservices/mail/iac/helm/mail-app/values.yaml#resources",
          "passing": true
        },
        {
          "id": "PERF-02",
          "name": "HPA targets cpu+memory utilization",
          "evidence": "microservices/mail/iac/helm/mail-app/values.yaml#hpa",
          "passing": true
        },
        {
          "id": "PERF-03",
          "name": "Capacity model w/ load projection",
          "evidence": "microservices/mail/capacity-model.md",
          "passing": true
        },
        {
          "id": "PERF-04",
          "name": "Caching tier (Valkey/Redis) declared",
          "evidence": "microservices/mail/iac/helm/mail-app/values.yaml (caching declared where applicable)",
          "passing": true
        },
        {
          "id": "PERF-05",
          "name": "Hyperscaler perf-budget lane (registry/quality/lanes.yaml)",
          "evidence": "registry/quality/lanes.yaml#perf-budget",
          "passing": true
        },
        {
          "id": "PERF-06",
          "name": "Statelessness + shardability validators",
          "evidence": "registry/quality/lanes.yaml#quality-statelessness, lanes.yaml#quality-shardability",
          "passing": true
        }
      ]
    },
    "cost_optimization": {
      "status": "green",
      "controls": [
        {
          "id": "COST-01",
          "name": "Cost budget documented",
          "evidence": "microservices/mail/cost-budget.md",
          "passing": true
        },
        {
          "id": "COST-02",
          "name": "HPA minReplicas right-sized",
          "evidence": "microservices/mail/iac/helm/mail-app/values.yaml#hpa.minReplicas",
          "passing": true
        },
        {
          "id": "COST-03",
          "name": "Image pinned by LTS policy (no :latest)",
          "evidence": "microservices/mail/iac/helm/mail-app/values.yaml#image.tag",
          "passing": true
        },
        {
          "id": "COST-04",
          "name": "Shared substrate (postgres-citus, redis, openbao) reused",
          "evidence": "microservices/mail/iac/helm/ (substrate sibling charts)",
          "passing": true
        },
        {
          "id": "COST-05",
          "name": "Per-pack overlays (kustomize) avoid per-tenant resource duplication",
          "evidence": "microservices/mail/iac/kustomize/overlays/",
          "passing": true
        }
      ]
    }
  },
  "overall_status": "green"
}
