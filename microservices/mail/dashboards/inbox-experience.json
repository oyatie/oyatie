{
  "$schema": "https://schemas.grafana.com/dashboard.json",
  "_meta": {
    "doc_class": "GrafanaDashboard",
    "microservice": "mail",
    "owner_team": "axis-mail",
    "related_artifacts": [
      "microservices/mail/slos/inbox-open-latency.openslo.yaml",
      "microservices/mail/slos/thread-render-latency.openslo.yaml",
      "microservices/mail/slos/search-latency.openslo.yaml",
      "microservices/mail/contracts/openapi/mail.yaml"
    ],
    "audience": "tenant operators + axis-mail oncall",
    "tenant_scoped": true,
    "datasource": "Mimir per-pack"
  },
  "uid": "mail-inbox-experience",
  "title": "Mail — Inbox experience (open + thread + search + IMAP/JMAP)",
  "tags": ["mail", "ux", "tenant-facing"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "templating": {
    "list": [
      {"name": "tenant_id", "type": "query", "datasource": "Mimir", "query": "label_values(oya_mail_inbox_open_seconds_bucket, tenant_id)", "refresh": 1, "label": "Tenant"},
      {"name": "pack", "type": "custom", "options": [
        {"text": "pack-kr", "value": "kr", "selected": true},
        {"text": "pack-eu", "value": "eu"},
        {"text": "pack-us", "value": "us"},
        {"text": "pack-us-healthcare", "value": "us-hc"},
        {"text": "pack-jp", "value": "jp"},
        {"text": "pack-sg", "value": "sg"},
        {"text": "pack-au", "value": "au"},
        {"text": "pack-in", "value": "in"},
        {"text": "pack-br", "value": "br"},
        {"text": "pack-ae", "value": "ae"},
        {"text": "pack-ksa", "value": "ksa"}
      ], "label": "Pack"}
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Inbox open p95 (target ≤ 300ms)",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "targets": [
        {"expr": "histogram_quantile(0.95, sum(rate(oya_mail_inbox_open_seconds_bucket{tenant_id=\"$tenant_id\",pack=\"$pack\"}[5m])) by (le))", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 0.3}, {"color": "red", "value": 0.6}]}}}
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Thread render p95 (target ≤ 150ms)",
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
      "targets": [
        {"expr": "histogram_quantile(0.95, sum(rate(oya_mail_thread_render_seconds_bucket{tenant_id=\"$tenant_id\",pack=\"$pack\"}[5m])) by (le))", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 0.15}, {"color": "red", "value": 0.3}]}}}
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Search p95 (target ≤ 500ms over 1M-message corpus)",
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
      "targets": [
        {"expr": "histogram_quantile(0.95, sum(rate(oya_mail_search_seconds_bucket{tenant_id=\"$tenant_id\",pack=\"$pack\"}[5m])) by (le))", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 0.5}, {"color": "red", "value": 1.0}]}}}
    },
    {
      "id": 4,
      "type": "stat",
      "title": "IMAP fetch p99 (target ≤ 300ms latest 50 headers)",
      "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
      "targets": [
        {"expr": "histogram_quantile(0.99, sum(rate(oya_mail_imap_fetch_headers_seconds_bucket{tenant_id=\"$tenant_id\",pack=\"$pack\"}[5m])) by (le))", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 0.3}, {"color": "red", "value": 0.6}]}}}
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Inbox open latency distribution (p50/p95/p99)",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum(rate(oya_mail_inbox_open_seconds_bucket{tenant_id=\"$tenant_id\",pack=\"$pack\"}[5m])) by (le))", "legendFormat": "p50", "refId": "A"},
        {"expr": "histogram_quantile(0.95, sum(rate(oya_mail_inbox_open_seconds_bucket{tenant_id=\"$tenant_id\",pack=\"$pack\"}[5m])) by (le))", "legendFormat": "p95", "refId": "B"},
        {"expr": "histogram_quantile(0.99, sum(rate(oya_mail_inbox_open_seconds_bucket{tenant_id=\"$tenant_id\",pack=\"$pack\"}[5m])) by (le))", "legendFormat": "p99", "refId": "C"}
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Concurrent IMAP/JMAP sessions",
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum(oya_mail_imap_session_concurrent{tenant_id=\"$tenant_id\",pack=\"$pack\"})", "legendFormat": "IMAP", "refId": "A"},
        {"expr": "sum(oya_mail_jmap_session_concurrent{tenant_id=\"$tenant_id\",pack=\"$pack\"})", "legendFormat": "JMAP", "refId": "B"}
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Search index lag (s)",
      "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
      "targets": [
        {"expr": "oya_mail_search_indexer_lag_seconds{tenant_id=\"$tenant_id\",pack=\"$pack\"}", "legendFormat": "indexer lag", "refId": "A"}
      ],
      "alert": {
        "name": "search-indexer-lag",
        "conditions": [
          {"evaluator": {"params": [60], "type": "gt"}, "query": {"params": ["A", "5m", "now"]}, "type": "query"}
        ],
        "notifications": [{"uid": "grafana-oncall-mail"}]
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Cross-context refusal rate (DCI-02 enforcement signal)",
      "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8},
      "targets": [
        {"expr": "rate(oya_mail_cross_context_routing_refused_total{tenant_id=\"$tenant_id\",pack=\"$pack\"}[5m])", "legendFormat": "from={{from}} to={{to}}", "refId": "A"}
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Cache hit rate (mailbox read; thread render)",
      "gridPos": {"x": 0, "y": 20, "w": 12, "h": 6},
      "targets": [
        {"expr": "rate(oya_mail_mailbox_cache_hit_total{tenant_id=\"$tenant_id\",pack=\"$pack\"}[5m]) / (rate(oya_mail_mailbox_cache_hit_total{tenant_id=\"$tenant_id\",pack=\"$pack\"}[5m]) + rate(oya_mail_mailbox_cache_miss_total{tenant_id=\"$tenant_id\",pack=\"$pack\"}[5m]))", "legendFormat": "mailbox", "refId": "A"},
        {"expr": "rate(oya_mail_thread_cache_hit_total{tenant_id=\"$tenant_id\",pack=\"$pack\"}[5m]) / (rate(oya_mail_thread_cache_hit_total{tenant_id=\"$tenant_id\",pack=\"$pack\"}[5m]) + rate(oya_mail_thread_cache_miss_total{tenant_id=\"$tenant_id\",pack=\"$pack\"}[5m]))", "legendFormat": "thread", "refId": "B"}
      ]
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Active mailboxes (per-cell baseline 100k / max 1M)",
      "gridPos": {"x": 12, "y": 20, "w": 12, "h": 6},
      "targets": [
        {"expr": "sum(oya_mail_mailbox_active_count{tenant_id=\"$tenant_id\",pack=\"$pack\"})", "refId": "A"}
      ]
    }
  ]
}
