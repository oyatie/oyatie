{
  "dashboard": {
    "title": "Mail — DMARC Deliverability",
    "uid": "mail-dmarc-deliverability",
    "tags": ["mail", "dmarc", "ADR-0273"],
    "panels": [
      {
        "id": 1,
        "title": "DKIM-pass rate per tenant",
        "type": "timeseries",
        "targets": [
          {"expr": "sum(rate(oya_mail_inbound_dkim_pass_total[5m])) by (tenant_id) / sum(rate(oya_mail_inbound_total[5m])) by (tenant_id)"}
        ]
      },
      {
        "id": 2,
        "title": "SPF-pass rate per tenant",
        "type": "timeseries",
        "targets": [
          {"expr": "sum(rate(oya_mail_inbound_spf_pass_total[5m])) by (tenant_id) / sum(rate(oya_mail_inbound_total[5m])) by (tenant_id)"}
        ]
      },
      {
        "id": 3,
        "title": "DMARC outcome distribution",
        "type": "piechart",
        "targets": [
          {"expr": "sum(rate(oya_mail_inbound_dmarc_outcome_total[1h])) by (outcome)"}
        ]
      },
      {
        "id": 4,
        "title": "Tenant DMARC policy state",
        "type": "table",
        "targets": [
          {"expr": "max(oya_mail_tenant_dmarc_policy{}) by (tenant_id, policy)"}
        ]
      },
      {
        "id": 5,
        "title": "BIMI logo render rate (recipient inbox)",
        "type": "stat",
        "targets": [
          {"expr": "sum(rate(oya_mail_bimi_logo_render_total[5m])) / sum(rate(oya_mail_inbound_dmarc_aligned_total[5m]))"}
        ]
      }
    ]
  }
}
