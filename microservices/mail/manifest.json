  "ontology_projections": [
    {
      "entity_name": "MailMessage",
      "projection_target_table": "ontology_mail_messages",
      "projection_kind": "idempotent-rewrite",
      "lag_budget_seconds": 60
    },
    {
      "entity_name": "Mailbox",
      "projection_target_table": "ontology_mailboxes",
      "projection_kind": "idempotent-rewrite",
      "lag_budget_seconds": 60
