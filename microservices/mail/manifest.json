        "oya-mail-inbound-smtp-adapter-smtp",
        "oya-mail-inbound-smtp-app"
      ]
    },
    {
      "name": "legal-hold",
      "description": "Bounded context 'legal-hold' within mail (control plane)",
      "crates": [
        "oya-mail-legal-hold-app"
      ]
    },
