    },
    {
      "name": "mail-outbound-delivery-latency",
      "target": "0.999",
      "sli": "histogram_quantile(0.99, sum(rate(oya_mail_outbound_delivery_seconds_bucket[5m])) by (le))",
      "file": "microservices/mail/slos/outbound-delivery-latency.openslo.yaml"
    },
    {
      "name": "mail-search-latency",
      "target": "0.99",
      "sli": "histogram_quantile(0.95, sum(rate(oya_mail_search_seconds_bucket[5m])) by (le))",
      "file": "microservices/mail/slos/search-latency.openslo.yaml"
    },
    {
      "name": "mail-spam-classification-latency",
      "target": "0.999",
      "sli": "histogram_quantile(0.99, sum(rate(oya_mail_inbound_spam_classify_seconds_bucket[5m])) by (le))",
      "file": "microservices/mail/slos/spam-classification-latency.openslo.yaml"
    },
    {
      "name": "mail-thread-render-latency",
      "target": "0.99",
      "sli": "histogram_quantile(0.95, sum(rate(oya_mail_thread_render_seconds_bucket[5m])) by (le))",
      "file": "microservices/mail/slos/thread-render-latency.openslo.yaml"
    }
