    {
      "name": "outbound-smtp",
      "description": "Bounded context 'outbound-smtp' within mail (egress plane)",
      "crates": [
        "oya-mail-outbound-smtp-adapter-smtp"
      ]
    },
    {
      "name": "retention-policy",
      "description": "Bounded context 'retention-policy' within mail (control plane)",
      "crates": [
        "oya-mail-retention-policy-worker"
      ]
    },
    {
      "name": "search-index",
      "description": "Bounded context 'search-index' within mail (data plane)",
      "crates": [
        "oya-mail-search-index-adapter-tantivy"
      ]
    }
  ],
