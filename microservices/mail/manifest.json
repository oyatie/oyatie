      "projection_kind": "idempotent-rewrite",
      "lag_budget_seconds": 60
    },
    {
      "entity_name": "RetentionPolicy",
      "projection_target_table": "ontology_mail_retention_policies",
      "projection_kind": "idempotent-rewrite",
      "lag_budget_seconds": 60
    },
    {
      "entity_name": "DeliverabilityReputation",
      "projection_target_table": "ontology_deliverability_reputations",
      "projection_kind": "idempotent-rewrite",
      "lag_budget_seconds": 60
    },
    {
      "entity_name": "TenantMailServer",
      "projection_target_table": "ontology_tenant_mail_servers",
      "projection_kind": "idempotent-rewrite",
      "lag_budget_seconds": 60
    }
  ],
