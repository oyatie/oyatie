  "slos": [
    {
      "name": "mail-dual-context-correctness",
      "target": "1.0",
      "sli": "sum(rate(oya_mail_cross_context_routing_refused_total[5m]))",
      "file": "microservices/mail/slos/dual-context-correctness.openslo.yaml"
    },
    {
      "name": "mail-ediscovery-export-freshness",
      "target": "0.995",
      "sli": "histogram_quantile(0.99, sum(rate(oya_mail_ediscovery_export_duration_seconds_bucket[30d])) by (le))",
      "file": "microservices/mail/slos/ediscovery-export-freshness.openslo.yaml"
    },
    {
      "name": "mail-inbound-receive-availability",
      "target": "0.9995",
      "sli": "sum(rate(oya_mail_inbound_smtp_data_accepted_total{pack=~\".+\"}[5m]))",
      "file": "microservices/mail/slos/inbound-receive-availability.openslo.yaml"
    },
    {
      "name": "mail-inbox-open-latency",
      "target": "0.99",
