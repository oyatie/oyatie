{
  "schema_version": "1.0",
  "microservice": "tenancy",
  "version": "0.1.0",
  "owner": "axis-tenancy",
  "bounded_contexts": [
    {
      "name": "tenancy",
      "description": "Bounded context 'tenancy' within tenancy (control plane)",
      "crates": [
        "oya-tenancy-cell-assignment-adapter-citus",
        "oya-tenancy-tenant-lifecycle-adapter",
        "oya-tenancy-tenant-lifecycle-adapter-postgres",
        "oya-tenancy-tenant-lifecycle-api",
        "oya-tenancy-tenant-lifecycle-app",
        "oya-tenancy-tenant-lifecycle-domain",
        "oya-tenancy-tenant-lifecycle-kernel",
        "oya-tenancy-tenant-lifecycle-rest",
        "oya-tenancy-tenant-lifecycle-sdk",
        "oya-tenancy-tenant-lifecycle-usecase",
        "oya-tenancy-tenant-lifecycle-worker"
      ]
    }
  ],
  "layers": [
    "adapter",
    "api",
    "app",
    "domain",
    "kernel",
    "rest",
    "sdk",
    "usecase",
    "worker"
  ],
  "contracts": {
    "openapi": [
      "microservices/tenancy/contracts/openapi/tenancy.yaml"
    ],
    "asyncapi": [
      "microservices/tenancy/contracts/asyncapi/tenant-events.yaml"
    ],
    "proto": [
      "microservices/tenancy/contracts/proto/tenancy.proto"
    ]
  },
  "capabilities": [
    {
      "tier": "T3",
      "name": "dsr-cascade-execute",
      "file": "microservices/tenancy/capabilities/dsr-cascade-execute.yaml",
      "eu_ai_act_risk_class": "high"
    },
    {
      "tier": "T3",
      "name": "isolation-policy-emit",
      "file": "microservices/tenancy/capabilities/isolation-policy-emit.yaml",
      "eu_ai_act_risk_class": "high"
    },
    {
      "tier": "T1",
      "name": "tenant-resolve",
      "file": "microservices/tenancy/capabilities/tenant-resolve.yaml",
      "eu_ai_act_risk_class": "minimal"
    }
  ],
  "slos": [
    {
      "name": "tenancy-availability",
      "target": "0.9999",
      "sli": "sum(rate(http_requests_total{job=\"oya-tenancy-tenant-lifecycle-rest\",route=\"/api/v1/tenants/.+\",status!~\"5..\"}[5m]))",
      "file": "microservices/tenancy/slos/availability.openslo.yaml"
    },
    {
      "name": "tenancy-correctness-rls-probe",
      "target": "1.0",
      "sli": "sum(rate(oya_tenancy_synthetic_cross_tenant_probe_success_total[5m]))",
      "file": "microservices/tenancy/slos/correctness.openslo.yaml"
    },
    {
      "name": "tenancy-freshness-rls-drift",
      "target": "0.995",
      "sli": "sum(rate(oya_tenancy_rls_state_validator_runs_total{success=\"true\"}[5m]))",
      "file": "microservices/tenancy/slos/freshness.openslo.yaml"
    },
    {
      "name": "tenancy-latency",
      "target": "0.99",
      "sli": "sum(rate(http_request_duration_seconds_bucket{job=\"oya-tenancy-tenant-lifecycle-rest\",route=\"/api/v1/tenants/.+\",le=\"0.005\"}[5m]))",
      "file": "microservices/tenancy/slos/latency.openslo.yaml"
    }
  ],
