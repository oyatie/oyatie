{
  "title": "Compliance — DSAR pipeline",
  "uid": "oya-compliance-dsar",
  "schemaVersion": 39,
  "panels": [
    {
      "id": 1,
      "title": "Open DSARs (per tenant)",
      "type": "timeseries",
      "targets": [{"expr": "count by (tenant_id) (oya_compliance_dsar_open)"}]
    },
    {
      "id": 2,
      "title": "DSAR completion days (p50 / p99)",
      "type": "stat",
      "targets": [
        {"expr": "histogram_quantile(0.5,  rate(oya_compliance_dsar_completion_days_bucket[28d]))"},
        {"expr": "histogram_quantile(0.99, rate(oya_compliance_dsar_completion_days_bucket[28d]))"}
      ]
    },
    {
      "id": 3,
      "title": "DSAR backlog vs circuit-break threshold",
      "type": "timeseries",
      "targets": [
        {"expr": "count(oya_compliance_dsar_open)"},
        {"expr": "100"}
      ]
    },
    {
      "id": 4,
      "title": "Days-to-statutory-SLA (per open DSAR)",
      "type": "table",
      "targets": [{"expr": "30 - oya_compliance_dsar_elapsed_days"}]
    },
    {
      "id": 5,
      "title": "Cross-tenant violation count (Sev-1)",
      "type": "stat",
      "targets": [{"expr": "sum(oya_compliance_cross_tenant_violation_total)"}]
    }
  ]
}
