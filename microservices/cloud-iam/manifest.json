    "circuit_breaker": "INV-CIRCUIT-BREAKER-BULKHEAD via observability canonical PrometheusRule",
    "tenant_rate_limit": "INV-SHUFFLE-SHARDING via per-tenant and per-cell limit evidence",
    "golden_signals": "INV-FOUR-GOLDEN-SIGNALS via service OpenSLO or performance evidence",
    "error_budget_burn": "INV-SLO-ERROR-BUDGET via service SLO gate"
  },
  "audit_chain": {
    "enabled": true,
    "seal_events": [
      "oya.cloud-iam.doctrine-declared",
      "oya.cloud-iam.dr-failover"
    ]
  },
  "secrets_substrate": {
    "provider": "openbao",
    "format": "${openbao:secret/<path>}"
  },
  "ontology_projections": [],
  "mesh_layering": {
    "cilium_l4": true,
    "ambient_ztunnel": true,
    "ambient_waypoint": false,
    "north_south_only": false
  },
  "capacity_model": {
    "baseline_cpu_per_tenant": 0.12,
    "baseline_ram_per_tenant": 256,
    "storage_per_tenant": 1,
    "connections_per_tenant": {
      "valkey": 4,
      "postgres": 2,
      "outbound_http": 8
    },
    "scaling_dimension": "per_request",
    "cell_placement_class": "Tier-0",
    "notes": "Hot-path Cedar authorize, token issue, introspection, and provider translation scale by authorization requests and principal/role counts."
  },
  "dr": {
    "rto_p99_seconds": 300,
    "rpo_p99_seconds": 30,
    "multi_region_active_active": true,
    "backup_substrate": [
      "postgres_wal_g",
      "valkey_cluster",
      "audit_chain_merkle_seal",
      "object_storage_versioned"
    ],
    "failover_runbook": "runbooks/identity-plane-failover.md",
    "dr_tier": "T1",
    "replication_shape": "active-active-multi-az-cross-region-warm"
  },
  "pod_runtime_tier": 1,
  "pod_runtime_tier_justification": "Foundation identity substrate: cloud-iam handles tenant principals, authorization, STS, and provider projection data, matching ADR-0338's Tier-1 floor for cloud-iam and ADR-0340's Tier-0 cellular class.",
  "pod_runtime_tier_surface_evidence": [
    "microservices/cloud-iam/performance-benchmark-numbers-2026-05-20.md",
    "microservices/cloud-iam/feature-parity-matrix-2026-05-20.md",
    "crates/oya-cloud-iam-api/src/lib.rs"
  ],
  "tenant_version_pinning": {
    "declared_versions": [
      "2026-05-21",
      "2026-02-21",
      "2025-11-21"
    ],
    "default_version": "2026-05-21",
    "supported_window_size": 3,
    "supported_window_minimum_days": 180,
    "supports_per_tenant_pinning": true,
    "deprecation_calendar": [],
    "public_surface_files": {
      "openapi": {
        "2026-05-21": "contracts/openapi/cloud/cloud-iam-v1.yaml",
        "2026-02-21": "contracts/openapi/cloud/cloud-iam-v1.yaml",
        "2025-11-21": "contracts/openapi/cloud/cloud-iam-v1.yaml"
      }
