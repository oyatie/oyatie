{
  "schemaVersion": 39,
  "title": "Whiteboard local policy decisions",
  "tags": [
    "whiteboard",
    "local-operational-primitive",
    "adr-0130"
  ],
  "timezone": "utc",
  "templating": {
    "list": [
      {
        "name": "tenant_id",
        "type": "query",
        "query": "label_values(oya_whiteboard_board_load_time_total, tenant_id)"
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Board load time for active canvases burn",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(rate(oya_whiteboard_board_load_time_good_total[5m])) by (tenant_id, cell_tier) / sum(rate(oya_whiteboard_board_load_time_total[5m])) by (tenant_id, cell_tier)",
          "legendFormat": "board-load-time ratio"
        }
      ]
    },
    {
      "id": 2,
      "title": "Collaborator presence freshness burn",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(oya_whiteboard_presence_freshness_good_total[5m])) by (tenant_id, cell_tier) / sum(rate(oya_whiteboard_presence_freshness_total[5m])) by (tenant_id, cell_tier)",
          "legendFormat": "presence-freshness ratio"
        }
      ]
    },
    {
      "id": 3,
      "title": "CRDT merges complete without conflict loss burn",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(rate(oya_whiteboard_crdt_merge_success_good_total[30d])) by (tenant_id, cell_tier) / sum(rate(oya_whiteboard_crdt_merge_success_total[30d])) by (tenant_id, cell_tier)",
          "legendFormat": "crdt-merge-success ratio"
        }
      ]
    },
    {
      "id": 4,
      "title": "Board export render latency burn",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(oya_whiteboard_export_render_latency_good_total[5m])) by (tenant_id, cell_tier) / sum(rate(oya_whiteboard_export_render_latency_total[5m])) by (tenant_id, cell_tier)",
          "legendFormat": "export-render-latency ratio"
        }
      ]
    },
    {
      "id": 5,
      "title": "Cursor movement delivered to collaborators burn",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(rate(oya_whiteboard_cursor_latency_good_total[5m])) by (tenant_id, cell_tier) / sum(rate(oya_whiteboard_cursor_latency_total[5m])) by (tenant_id, cell_tier)",
          "legendFormat": "cursor-latency ratio"
        }
      ]
    },
    {
      "id": 6,
      "title": "Whiteboard strokes persisted durably burn",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(oya_whiteboard_stroke_persistence_latency_good_total[5m])) by (tenant_id, cell_tier) / sum(rate(oya_whiteboard_stroke_persistence_latency_total[5m])) by (tenant_id, cell_tier)",
          "legendFormat": "stroke-persistence-latency ratio"
        }
      ]
    }
  ]
}
