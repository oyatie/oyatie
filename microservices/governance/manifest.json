    "enabled": true,
    "seal_events": [
      "oya.governance.audit-refresh",
      "oya.governance.finding-query",
      "oya.governance.lane-execute"
    ]
  },
  "secrets_substrate": {
    "provider": "openbao",
    "format": "${openbao:secret/<path>}"
  },
  "ontology_projections": [
    {
      "entity_name": "CedarFragment",
      "projection_target_table": "ontology_cedar_fragments",
      "projection_kind": "idempotent-rewrite",
      "lag_budget_seconds": 60
    },
    {
      "entity_name": "PolicyDecision",
      "projection_target_table": "ontology_policy_decisions",
      "projection_kind": "idempotent-rewrite",
      "lag_budget_seconds": 60
    }
  ],
  "mesh_layering": {
    "cilium_l4": true,
    "ambient_ztunnel": true,
    "ambient_waypoint": true,
    "north_south_only": false
  }
