{
  "$schema": "https://schemas.grafana.com/dashboard.json",
  "_meta": {
    "doc_class": "GrafanaDashboard",
    "microservice": "cloud-k8s",
    "owner_team": "axis-cloud + ops-sre-reliability",
    "audience": "cluster operators + FinOps",
    "tenant_scoped": false,
    "datasource": "Mimir (kubelet + cAdvisor + Cilium node)"
  },
  "uid": "cloud-k8s-node-utilization",
  "title": "cloud-k8s — Node Utilization",
  "tags": ["cloud-k8s", "kubernetes", "node", "capacity"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-3h", "to": "now"},
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Node CPU utilization (per node)",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "targets": [
        {"expr": "instance:node_cpu:rate:sum / on(instance) group_left machine_cpu_cores", "legendFormat": "{{instance}}", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "percentunit", "thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 0.7}, {"color": "red", "value": 0.9}]}}}
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Node memory utilization (per node)",
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
      "targets": [
        {"expr": "1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)", "legendFormat": "{{instance}}", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "percentunit", "thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 0.7}, {"color": "red", "value": 0.85}]}}}
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Pods per node (max + avg)",
      "gridPos": {"x": 0, "y": 8, "w": 8, "h": 6},
      "targets": [
        {"expr": "max(count by (node) (kube_pod_info))", "legendFormat": "max", "refId": "A"},
        {"expr": "avg(count by (node) (kube_pod_info))", "legendFormat": "avg", "refId": "B"}
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Unschedulable pods",
      "gridPos": {"x": 8, "y": 8, "w": 8, "h": 6},
      "targets": [
        {"expr": "sum(kube_pod_status_phase{phase=\"Pending\"})", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 5}, {"color": "red", "value": 50}]}}}
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Headroom (avg CPU + memory remaining)",
      "gridPos": {"x": 16, "y": 8, "w": 8, "h": 6},
      "targets": [
        {"expr": "1 - avg(instance:node_cpu:rate:sum / on(instance) group_left machine_cpu_cores)", "legendFormat": "CPU headroom", "refId": "A"},
        {"expr": "avg(node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)", "legendFormat": "Memory headroom", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"unit": "percentunit"}}
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Node disk I/O + utilization (per device)",
      "gridPos": {"x": 0, "y": 14, "w": 12, "h": 8},
      "targets": [
        {"expr": "rate(node_disk_io_time_seconds_total[5m])", "legendFormat": "{{instance}} {{device}}", "refId": "A"}
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Node network I/O (rx + tx)",
      "gridPos": {"x": 12, "y": 14, "w": 12, "h": 8},
      "targets": [
        {"expr": "rate(node_network_receive_bytes_total[5m])", "legendFormat": "rx {{instance}}", "refId": "A"},
        {"expr": "rate(node_network_transmit_bytes_total[5m])", "legendFormat": "tx {{instance}}", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"unit": "binBps"}}
    },
    {
      "id": 8,
      "type": "table",
      "title": "Node breakdown (pods × CPU × memory × age)",
      "gridPos": {"x": 0, "y": 22, "w": 24, "h": 10},
      "targets": [
        {"expr": "kube_node_info", "format": "table", "refId": "A"},
        {"expr": "count by (node) (kube_pod_info)", "format": "table", "refId": "B"},
        {"expr": "instance:node_cpu:rate:sum / on(instance) group_left machine_cpu_cores", "format": "table", "refId": "C"}
      ],
      "transformations": [
        {"id": "merge"}
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "containerd image pull duration (p99)",
      "gridPos": {"x": 0, "y": 32, "w": 12, "h": 6},
      "targets": [
        {"expr": "histogram_quantile(0.99, rate(containerd_image_pull_duration_seconds_bucket[5m]))", "legendFormat": "{{instance}}", "refId": "A"}
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "kubelet runtime errors",
      "gridPos": {"x": 12, "y": 32, "w": 12, "h": 6},
      "targets": [
        {"expr": "rate(kubelet_runtime_operations_errors_total[5m])", "legendFormat": "{{operation_type}} {{instance}}", "refId": "A"}
      ]
    }
  ]
}
