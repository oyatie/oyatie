  "slos": [
    {
      "name": "oya-cloud-k8s-cis-benchmark-conformance",
      "target": "1.0",
      "sli": "sum(rate(oya_cloud_k8s_cis_check_total{result=\"pass\"}[5m]))",
      "file": "microservices/cloud-k8s/slos/cis-benchmark-conformance.openslo.yaml"
    },
    {
      "name": "oya-cloud-k8s-cluster-api-availability",
      "target": "0.9995",
      "sli": "sum(rate(apiserver_request_total{code!~\"5..|502|503|504\"}[5m]))",
      "file": "microservices/cloud-k8s/slos/cluster-api-availability.openslo.yaml"
    },
    {
      "name": "oya-cloud-k8s-cluster-cni-availability",
      "target": "0.9995",
      "sli": "sum(rate(cilium_agent_up{result=\"healthy\"}[5m]))",
      "file": "microservices/cloud-k8s/slos/cluster-cni-availability.openslo.yaml"
    },
    {
      "name": "oya-cloud-k8s-node-readiness-correctness",
      "target": "0.999",
      "sli": "sum(rate(kube_node_status_condition{condition=\"Ready\",status=\"true\"}[5m]))",
      "file": "microservices/cloud-k8s/slos/node-readiness-correctness.openslo.yaml"
    },
    {
      "name": "oya-cloud-k8s-pod-scheduling-latency",
      "target": "0.95",
      "sli": "sum(rate(scheduler_pod_scheduling_duration_seconds_bucket{le=\"5\"}[5m]))",
      "file": "microservices/cloud-k8s/slos/pod-scheduling-latency.openslo.yaml"
    },
    {
      "name": "oya-cloud-k8s-service-mesh-availability",
      "target": "0.9995",
      "sli": "sum(rate(pilot_xds_pushes{outcome=\"success\"}[5m]))",
      "file": "microservices/cloud-k8s/slos/service-mesh-availability.openslo.yaml"
    }
  ],
