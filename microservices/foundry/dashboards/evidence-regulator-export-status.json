{
  "$schema": "https://schemas.grafana.com/dashboard.json",
  "_meta": {
    "doc_class": "GrafanaDashboard",
    "microservice": "foundry-evidence",
    "owner_team": "council-privacy + axis-foundry-evidence",
    "audience": "internal operators + council-privacy chair",
    "tenant_scoped": false,
    "datasource": "Mimir"
  },
  "uid": "foundry-evidence-regulator-export-status",
  "title": "Foundry-Evidence Regulator Export Status",
  "tags": ["foundry-evidence", "regulator-export", "council-privacy"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {"from": "now-7d", "to": "now"},
  "templating": {
    "list": [
      {
        "name": "pack",
        "type": "custom",
        "options": [
          {"text": "pack-kr", "value": "pack-kr", "selected": true},
          {"text": "pack-eu", "value": "pack-eu"},
          {"text": "pack-us", "value": "pack-us"},
          {"text": "pack-us-healthcare", "value": "pack-us-healthcare"},
          {"text": "pack-jp", "value": "pack-jp"},
          {"text": "pack-sg", "value": "pack-sg"},
          {"text": "pack-au", "value": "pack-au"},
          {"text": "pack-in", "value": "pack-in"},
          {"text": "pack-br", "value": "pack-br"},
          {"text": "pack-ae", "value": "pack-ae"},
          {"text": "pack-ksa", "value": "pack-ksa"}
        ],
        "label": "Pack"
      },
      {
        "name": "framework",
        "type": "custom",
        "options": [
          {"text": "All", "value": ".*", "selected": true},
          {"text": "eu-ai-act", "value": "eu-ai-act"},
          {"text": "hipaa", "value": "hipaa"},
          {"text": "gdpr", "value": "gdpr"},
          {"text": "kr-pipa", "value": "kr-pipa"},
          {"text": "soc2", "value": "soc2"},
          {"text": "iso-27001", "value": "iso-27001"}
        ],
        "label": "Framework"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "Active bundles by status",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "sum by (status, framework) (oya_foundry_evidence_regulator_export_bundle_state{pack=\"$pack\", framework=~\"$framework\"})",
          "format": "table",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Bundle assembly p99 (per 10k packs)",
      "gridPos": {"x": 0, "y": 8, "w": 6, "h": 4},
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(oya_foundry_evidence_regulator_export_assembly_duration_seconds_bucket{pack=\"$pack\", framework=~\"$framework\"}[1h])))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 20}, {"color": "red", "value": 30}]}
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Bundle delivery success rate (24h)",
      "gridPos": {"x": 6, "y": 8, "w": 6, "h": 4},
      "targets": [
        {
          "expr": "sum(rate(oya_foundry_evidence_regulator_export_delivered_total{pack=\"$pack\", framework=~\"$framework\"}[24h])) / sum(rate(oya_foundry_evidence_regulator_export_completed_total{pack=\"$pack\", framework=~\"$framework\"}[24h]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "percentunit", "thresholds": {"steps": [{"color": "red", "value": 0}, {"color": "yellow", "value": 0.99}, {"color": "green", "value": 0.999}]}}
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Bundle requests per framework (1d)",
      "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "sum by (framework) (rate(oya_foundry_evidence_regulator_export_requested_total{pack=\"$pack\", framework=~\"$framework\"}[1d]))",
          "legendFormat": "{{framework}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "table",
      "title": "Reissue events (linking original → reissue) — 30d window",
      "gridPos": {"x": 0, "y": 20, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "oya_foundry_evidence_regulator_export_reissued_total{pack=\"$pack\", framework=~\"$framework\"}",
          "format": "table",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "2-person-rule violations (should be 0)",
      "gridPos": {"x": 0, "y": 28, "w": 6, "h": 4},
      "targets": [
        {"expr": "sum(rate(oya_foundry_evidence_regulator_export_two_person_rule_violation_total{pack=\"$pack\"}[7d]))", "refId": "A"}
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "red", "value": 0.00001}]}
        }
      },
      "alert": {
        "name": "regulator-export-2pr-violation",
        "conditions": [{"evaluator": {"params": [0], "type": "gt"}, "query": {"params": ["A", "1h", "now"]}, "type": "query"}],
        "notifications": [{"uid": "grafana-oncall"}]
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Framework-profile field-completeness drift",
      "gridPos": {"x": 6, "y": 28, "w": 6, "h": 4},
      "targets": [
        {"expr": "sum(rate(oya_foundry_evidence_regulator_export_field_completeness_drift_total{pack=\"$pack\"}[7d]))", "refId": "A"}
      ]
    }
  ]
}
