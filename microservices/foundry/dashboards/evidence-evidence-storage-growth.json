{
  "$schema": "https://schemas.grafana.com/dashboard.json",
  "_meta": {
    "doc_class": "GrafanaDashboard",
    "microservice": "foundry-evidence",
    "owner_team": "ops-sre-reliability + axis-foundry-evidence",
    "audience": "internal operators + capacity planners",
    "tenant_scoped": false,
    "datasource": "Mimir + Postgres exporter"
  },
  "uid": "foundry-evidence-storage-growth",
  "title": "Foundry-Evidence Storage Growth + Archive Cascade",
  "tags": ["foundry-evidence", "capacity", "archive"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5m",
  "time": {"from": "now-30d", "to": "now"},
  "templating": {
    "list": [
      {
        "name": "pack",
        "type": "custom",
        "options": [
          {"text": "pack-kr", "value": "pack-kr", "selected": true},
          {"text": "pack-eu", "value": "pack-eu"},
          {"text": "pack-us", "value": "pack-us"},
          {"text": "pack-us-healthcare", "value": "pack-us-healthcare"},
          {"text": "pack-jp", "value": "pack-jp"},
          {"text": "pack-sg", "value": "pack-sg"},
          {"text": "pack-au", "value": "pack-au"},
          {"text": "pack-in", "value": "pack-in"},
          {"text": "pack-br", "value": "pack-br"},
          {"text": "pack-ae", "value": "pack-ae"},
          {"text": "pack-ksa", "value": "pack-ksa"}
        ],
        "label": "Pack"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Postgres index size (bytes)",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "pg_total_relation_size_bytes{database=\"foundry_evidence\", relation=\"evidence_pack\", pack=\"$pack\"}",
          "legendFormat": "evidence_pack",
          "refId": "A"
        },
        {
          "expr": "pg_total_relation_size_bytes{database=\"foundry_evidence\", relation=\"evidence_pack_warm\", pack=\"$pack\"}",
          "legendFormat": "evidence_pack_warm",
          "refId": "B"
        },
        {
          "expr": "pg_total_relation_size_bytes{database=\"foundry_evidence\", relation=\"evidence_pack_cold_index\", pack=\"$pack\"}",
          "legendFormat": "evidence_pack_cold_index",
          "refId": "C"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Evidence blob storage (bytes, via audit-chain WORM)",
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "oya_foundry_evidence_blob_storage_bytes{pack=\"$pack\", tier=\"hot\"}",
          "legendFormat": "hot",
          "refId": "A"
        },
        {
          "expr": "oya_foundry_evidence_blob_storage_bytes{pack=\"$pack\", tier=\"warm\"}",
          "legendFormat": "warm",
          "refId": "B"
        },
        {
          "expr": "oya_foundry_evidence_blob_storage_bytes{pack=\"$pack\", tier=\"cold\"}",
          "legendFormat": "cold",
          "refId": "C"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Archive cascade lag (hours)",
      "gridPos": {"x": 0, "y": 16, "w": 6, "h": 4},
      "targets": [
        {"expr": "oya_foundry_evidence_archive_cascade_lag_hours{pack=\"$pack\"}", "refId": "A"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "h",
          "thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 24}, {"color": "red", "value": 36}]}
        }
      },
      "alert": {
        "name": "archive-cascade-lag-high",
        "conditions": [{"evaluator": {"params": [36], "type": "gt"}, "query": {"params": ["A", "10m", "now"]}, "type": "query"}],
        "notifications": [{"uid": "grafana-oncall"}]
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Pack count (hot tier)",
      "gridPos": {"x": 6, "y": 16, "w": 6, "h": 4},
      "targets": [
        {"expr": "oya_foundry_evidence_pack_count_total{pack=\"$pack\", tier=\"hot\"}", "refId": "A"}
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Pack ingest rate vs cascade rate (packs/s)",
      "gridPos": {"x": 0, "y": 20, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "sum(rate(oya_foundry_evidence_pack_assembled_total{pack=\"$pack\"}[5m]))",
          "legendFormat": "ingest",
          "refId": "A"
        },
        {
          "expr": "sum(rate(oya_foundry_evidence_archive_cascade_packs_total{pack=\"$pack\"}[5m]))",
          "legendFormat": "cascade",
          "refId": "B"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Headroom projection (days to capacity bound)",
      "gridPos": {"x": 0, "y": 28, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "oya_foundry_evidence_capacity_headroom_days{pack=\"$pack\", tier=\"hot\"}",
          "legendFormat": "hot",
          "refId": "A"
        },
        {
          "expr": "oya_foundry_evidence_capacity_headroom_days{pack=\"$pack\", tier=\"warm\"}",
          "legendFormat": "warm",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "d",
          "thresholds": {"steps": [{"color": "red", "value": 0}, {"color": "yellow", "value": 90}, {"color": "green", "value": 180}]}
        }
      },
      "alert": {
        "name": "capacity-headroom-low",
        "conditions": [{"evaluator": {"params": [90], "type": "lt"}, "query": {"params": ["A", "1h", "now"]}, "type": "query"}],
        "notifications": [{"uid": "grafana-oncall"}]
      }
    }
  ]
}
