{
  "$schema": "https://schemas.grafana.com/dashboard.json",
  "_meta": {
    "doc_class": "GrafanaDashboard",
    "microservice": "foundry-guardrails",
    "owner_team": "axis-foundry-guardrails + ops-security",
    "audience": "ops-security + axis-foundry-guardrails internal (cross-tenant aggregate visible to ops-security only)",
    "tenant_scoped": false,
    "datasource": "Mimir oya-self + oya-aggregate (DP-noise-protected for cross-tenant aggregates)"
  },
  "uid": "fguard-jailbreak-rate",
  "title": "Jailbreak Attempt Rate",
  "tags": ["foundry-guardrails", "jailbreak", "security"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-24h", "to": "now"},
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Jailbreak attempts / hour (last 1h)",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "targets": [
        {"expr": "sum(rate(foundry_guardrails_jailbreak_attempt_total[1h])) * 3600", "refId": "A"}
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Jailbreak success (Sev-1) — last 24h",
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
      "targets": [
        {"expr": "sum(increase(foundry_guardrails_sev1_jailbreak_total[24h]))", "refId": "A"}
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Jailbreak attempts by detector source",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum by (detector) (rate(foundry_guardrails_jailbreak_attempt_total[1m]))", "legendFormat": "{{detector}}", "refId": "A"}
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Ensemble disagreement rate (LLM-judge fallback trigger)",
      "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum(rate(foundry_guardrails_llm_judge_invocations_total[5m])) / sum(rate(foundry_guardrails_classify_total[5m]))", "legendFormat": "judge / classify ratio", "refId": "A"}
      ]
    },
    {
      "id": 5,
      "type": "table",
      "title": "Top 10 tenants by jailbreak-attempt-rate",
      "gridPos": {"x": 0, "y": 20, "w": 12, "h": 8},
      "targets": [
        {"expr": "topk(10, sum by (tenant) (rate(foundry_guardrails_jailbreak_attempt_total[1h])))", "refId": "A", "format": "table"}
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Sev-1 jailbreak success events (last 7d)",
      "gridPos": {"x": 0, "y": 28, "w": 12, "h": 8},
      "targets": [
        {"expr": "increase(foundry_guardrails_sev1_jailbreak_total[7d])", "refId": "A"}
      ]
    }
  ]
}
