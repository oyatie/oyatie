        "from": "trigger-close-start",
        "to": "subledger-recon"
      },
      {
        "from": "subledger-recon",
        "to": "accruals"
      },
      {
        "from": "accruals",
        "to": "intercompany"
      },
      {
        "from": "intercompany",
        "to": "fx-reval"
      },
      {
        "from": "fx-reval",
        "to": "trial-balance"
      },
      {
        "from": "trial-balance",
        "to": "controller-approval"
      },
      {
        "from": "controller-approval",
        "to": "lock-period",
        "condition": "approved"
      },
      {
        "from": "lock-period",
        "to": "audit-close"
      },
      {
        "from": "audit-close",
        "to": "t-close-complete"
      }
    ]
  },
