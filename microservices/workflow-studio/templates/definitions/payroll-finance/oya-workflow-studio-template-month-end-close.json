{
  "template_id": "oya-workflow-studio-template-month-end-close",
  "schema_version": "1.0.0",
  "name": "Month-end close (T-1 to T+5)",
  "description": "Close-the-books pipeline: subledger reconciliation, accrual booking, intercompany elimination, FX revaluation, trial balance, lock period.",
  "persona": "finance-controller",
  "vertical": "payroll-finance",
  "node_graph": {
    "entry_node": "trigger-close-start",
    "terminal_nodes": [
      "t-close-complete"
    ],
    "nodes": [
      {
        "id": "trigger-close-start",
        "kind": "trigger",
        "label": "Month-end close start"
      },
      {
        "id": "subledger-recon",
        "kind": "connector-call",
        "label": "Reconcile subledgers",
        "connector": "oya-shared-connector-erp",
        "operation": "reconcile_subledgers"
      },
      {
        "id": "accruals",
        "kind": "transform",
        "label": "Book accruals"
      },
      {
        "id": "intercompany",
        "kind": "transform",
        "label": "Eliminate intercompany"
      },
      {
        "id": "fx-reval",
        "kind": "transform",
        "label": "FX revaluation"
      },
      {
        "id": "trial-balance",
