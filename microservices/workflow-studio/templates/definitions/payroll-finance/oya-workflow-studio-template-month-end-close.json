        "label": "Produce trial balance",
        "connector": "oya-shared-connector-erp",
        "operation": "produce_trial_balance"
      },
      {
        "id": "controller-approval",
        "kind": "human-approval",
        "label": "Controller sign-off"
      },
      {
        "id": "lock-period",
        "kind": "connector-call",
        "label": "Lock GL period",
        "connector": "oya-shared-connector-erp",
        "operation": "lock_period"
      },
      {
        "id": "audit-close",
        "kind": "audit-emit",
        "label": "Emit close seal"
      },
      {
        "id": "t-close-complete",
        "kind": "terminal",
        "label": "Close complete"
      }
    ],
    "edges": [
