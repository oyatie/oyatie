{
  "template_id": "oya-workflow-studio-template-bed-availability-prediction",
  "schema_version": "1.0.0",
  "name": "Bed availability prediction + transfer orchestration",
  "description": "Census + LOS prediction, bed-availability projection, inter-unit transfer orchestration, ED hold alerting.",
  "persona": "hospital-bed-manager",
  "vertical": "hospital-operations",
  "node_graph": {
    "entry_node": "trigger-census-pulse",
    "terminal_nodes": [
      "t-projection-published"
    ],
    "nodes": [
      {
        "id": "trigger-census-pulse",
        "kind": "trigger",
        "label": "30-minute census pulse"
      },
      {
        "id": "pull-census",
        "kind": "connector-call",
        "label": "Pull census",
        "connector": "oya-shared-connector-ehr",
        "operation": "pull_census"
      },
      {
        "id": "predict-los",
        "kind": "transform",
        "label": "Predict length-of-stay"
      },
      {
        "id": "project-beds",
        "kind": "transform",
        "label": "Project bed availability"
      },
      {
        "id": "decision-transfer",
        "kind": "decision",
        "label": "Inter-unit transfer needed?"
      },
      {
        "id": "orchestrate-transfer",
        "kind": "connector-call",
        "label": "Initiate transfer",
        "connector": "oya-shared-connector-ehr",
        "operation": "initiate_transfer"
      },
      {
        "id": "alert-ed-hold",
        "kind": "notify",
        "label": "Alert ED hold"
      },
      {
        "id": "audit-bed",
        "kind": "audit-emit",
        "label": "Emit bed projection seal"
      },
      {
        "id": "t-projection-published",
        "kind": "terminal",
        "label": "Projection published"
      }
    ],
    "edges": [
      {
        "from": "trigger-census-pulse",
        "to": "pull-census"
      },
      {
        "from": "pull-census",
        "to": "predict-los"
      },
      {
        "from": "predict-los",
        "to": "project-beds"
      },
      {
        "from": "project-beds",
        "to": "decision-transfer"
      },
      {
        "from": "decision-transfer",
        "to": "orchestrate-transfer",
        "condition": "transfer-needed"
      },
      {
        "from": "decision-transfer",
        "to": "alert-ed-hold",
        "condition": "ed-hold-alert"
      },
      {
        "from": "decision-transfer",
        "to": "audit-bed",
        "condition": "no-action"
      },
      {
        "from": "orchestrate-transfer",
        "to": "audit-bed"
      },
      {
        "from": "alert-ed-hold",
        "to": "audit-bed"
      },
      {
        "from": "audit-bed",
        "to": "t-projection-published"
      }
    ]
  },
  "input_parameters": [
    {
      "name": "facility_id",
      "type": "reference",
      "required": true,
      "description": "Facility id"
    },
    {
      "name": "horizon_hours",
      "type": "number",
      "required": true,
      "default": 12,
      "description": "Projection horizon hours"
    }
  ],
  "runtime_expectations": {
    "expected_duration_seconds_p50": 120,
    "expected_duration_seconds_p99": 300
  },
  "compliance_flags": [
    "hipaa",
    "hitech",
    "soc2-type-2"
  ],
  "audit_emission_points": [
    {
      "node_id": "predict-los",
      "seal_kind": "transform-attestation"
    },
    {
      "node_id": "project-beds",
      "seal_kind": "transform-attestation"
    },
    {
      "node_id": "audit-bed",
      "seal_kind": "decision-recorded"
    }
  ],
  "cedar_policy": {
    "policy_id": "cedar:oya-workflow-studio-template:bed-availability-prediction",
    "effect": "permit",
    "principal_scope": "Workflow::Tenant",
    "resource_scope": "FacilityCensus",
    "action_scope": "project_and_route",
    "conditions": []
  },
  "connector_dependencies": [
    {
      "connector_id": "oya-shared-connector-ehr",
      "operations": [
        "pull_census",
        "initiate_transfer"
      ],
      "criticality": "required"
    }
  ],
  "slo": {
    "max_duration_seconds": 300,
    "min_success_rate": 0.998,
    "openslo_ref": "microservices/workflow-studio/slos/oya-workflow-studio-template-bed-availability-prediction.openslo.yaml"
  },
  "cost_model": {
    "estimated_usd_per_execution_p50": 0.18,
    "foundry_inference_usd": 0.1,
    "connector_call_usd": 0.06,
    "storage_usd": 0.02
  },
  "test_mode_supported": true,
  "live_mode_supported": true,
  "documentation": {
    "explainer_path": "microservices/workflow-studio/templates/explainers/oya-workflow-studio-template-bed-availability-prediction.md",
    "fixture_path": "microservices/workflow-studio/templates/fixtures/oya-workflow-studio-template-bed-availability-prediction.fixture.json"
  },
  "tags": [
    "hospital",
    "bed-management",
    "prediction"
  ]
}
