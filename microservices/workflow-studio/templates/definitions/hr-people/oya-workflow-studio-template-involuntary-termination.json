{
  "template_id": "oya-workflow-studio-template-involuntary-termination",
  "schema_version": "1.0.0",
  "name": "Involuntary termination (legal-flagged)",
  "description": "Legal-gated termination flow: legal review, security access freeze, final compensation, audit + retention.",
  "persona": "hr-business-partner",
  "vertical": "hr-people",
  "node_graph": {
    "entry_node": "trigger-termination-requested",
    "terminal_nodes": [
      "t-term-complete"
    ],
    "nodes": [
      {
        "id": "trigger-termination-requested",
        "kind": "trigger",
        "label": "Termination requested"
      },
      {
        "id": "policy-involuntary-term",
        "kind": "policy-check",
        "label": "Cedar involuntary-term + legal-review-required"
      },
      {
        "id": "legal-review",
        "kind": "human-approval",
        "label": "Legal counsel approval"
      },
      {
        "id": "freeze-access",
        "kind": "connector-call",
        "label": "Freeze identity access immediately",
        "connector": "oya-shared-connector-identity",
        "operation": "freeze_access"
      },
      {
        "id": "final-comp",
        "kind": "connector-call",
        "label": "Final comp + severance",
        "connector": "oya-shared-connector-workday",
        "operation": "final_pay_severance"
      },
      {
        "id": "cobra-notice",
        "kind": "connector-call",
        "label": "Send COBRA notice",
        "connector": "oya-shared-connector-benefits",
        "operation": "cobra_notice"
      },
      {
        "id": "retain-record",
        "kind": "connector-call",
        "label": "Retain employment records",
        "connector": "oya-shared-connector-document-store",
        "operation": "retain_with_legal_hold"
      },
      {
        "id": "audit-term",
        "kind": "audit-emit",
        "label": "Emit termination + legal hold seal"
      },
      {
        "id": "t-term-complete",
        "kind": "terminal",
        "label": "Termination complete"
      }
    ],
    "edges": [
      {
        "from": "trigger-termination-requested",
        "to": "policy-involuntary-term"
      },
      {
        "from": "policy-involuntary-term",
        "to": "legal-review",
        "condition": "permit"
      },
      {
        "from": "legal-review",
        "to": "freeze-access"
      },
      {
        "from": "freeze-access",
        "to": "final-comp"
      },
      {
        "from": "final-comp",
        "to": "cobra-notice"
      },
      {
        "from": "cobra-notice",
        "to": "retain-record"
      },
      {
        "from": "retain-record",
        "to": "audit-term"
      },
      {
        "from": "audit-term",
        "to": "t-term-complete"
      }
    ]
  },
  "input_parameters": [
    {
      "name": "employee_id",
      "type": "reference",
      "required": true,
      "description": "Employee being terminated"
    },
    {
      "name": "termination_reason_code",
      "type": "enum",
      "required": true,
      "enum_values": [
        "misconduct",
        "performance",
        "redundancy",
        "policy-violation"
      ],
      "description": "Termination reason"
    },
    {
      "name": "severance_weeks",
      "type": "number",
      "required": false,
      "description": "Severance weeks if applicable"
    }
  ],
  "runtime_expectations": {
    "expected_duration_seconds_p50": 86400,
    "expected_duration_seconds_p99": 259200
  },
  "compliance_flags": [
    "soc2-type-2",
    "gdpr",
    "cobra",
    "eeoc",
    "flsa",
    "wage-act"
  ],
  "audit_emission_points": [
    {
      "node_id": "legal-review",
      "seal_kind": "human-approval-signature"
    },
    {
      "node_id": "freeze-access",
      "seal_kind": "policy-verdict"
    },
    {
      "node_id": "audit-term",
      "seal_kind": "termination-record"
    }
  ],
  "cedar_policy": {
    "policy_id": "cedar:oya-workflow-studio-template:involuntary-termination",
    "effect": "permit",
    "principal_scope": "Workflow::Tenant",
    "resource_scope": "EmployeeRecord",
    "action_scope": "involuntary_terminate",
    "conditions": [
      "resource.legal_reviewed == true",
      "principal.role in [\"hr-business-partner\"]"
    ]
  },
  "connector_dependencies": [
    {
      "connector_id": "oya-shared-connector-identity",
      "operations": [
        "freeze_access"
      ],
      "criticality": "required"
    },
    {
      "connector_id": "oya-shared-connector-workday",
      "operations": [
        "final_pay_severance"
      ],
      "criticality": "required"
    },
    {
      "connector_id": "oya-shared-connector-benefits",
      "operations": [
        "cobra_notice"
      ],
      "criticality": "required"
    },
    {
      "connector_id": "oya-shared-connector-document-store",
      "operations": [
        "retain_with_legal_hold"
      ],
      "criticality": "required"
    }
  ],
  "slo": {
    "max_duration_seconds": 259200,
    "min_success_rate": 0.999,
    "openslo_ref": "microservices/workflow-studio/slos/oya-workflow-studio-template-involuntary-termination.openslo.yaml"
  },
  "cost_model": {
    "estimated_usd_per_execution_p50": 2.1,
    "foundry_inference_usd": 0.1,
    "connector_call_usd": 1.7,
    "storage_usd": 0.3
  },
  "test_mode_supported": true,
  "live_mode_supported": true,
  "documentation": {
    "explainer_path": "microservices/workflow-studio/templates/explainers/oya-workflow-studio-template-involuntary-termination.md",
    "fixture_path": "microservices/workflow-studio/templates/fixtures/oya-workflow-studio-template-involuntary-termination.fixture.json"
  },
  "tags": [
    "hr",
    "termination",
    "legal-flagged",
    "cobra"
  ]
}
