{
  "template_id": "oya-workflow-studio-template-new-hire-onboarding",
  "schema_version": "1.0.0",
  "name": "New hire onboarding (Day 0 to Day 30)",
  "description": "Day-0 through Day-30 onboarding pipeline: identity provisioning, payroll registration, asset issuance, training enrolment, and Day-30 sentiment check.",
  "persona": "hr-business-partner",
  "vertical": "hr-people",
  "node_graph": {
    "entry_node": "trigger-offer-signed",
    "terminal_nodes": [
      "t-day30-complete"
    ],
    "nodes": [
      {
        "id": "trigger-offer-signed",
        "kind": "trigger",
        "label": "Offer signed event"
      },
      {
        "id": "policy-eligibility",
        "kind": "policy-check",
        "label": "Cedar onboarding policy",
        "parameters": {
          "policy": "oya-workflow-studio-template-new-hire-onboarding"
        }
      },
      {
        "id": "identity-provision",
        "kind": "connector-call",
        "label": "Provision identity",
        "connector": "oya-shared-connector-identity",
        "operation": "provision_user",
        "timeout_seconds": 60,
        "retry_policy": {
          "max_attempts": 3,
          "backoff_seconds": 5
        }
      },
      {
        "id": "payroll-register",
        "kind": "connector-call",
        "label": "Register in payroll",
        "connector": "oya-shared-connector-workday",
        "operation": "hire_employee",
        "timeout_seconds": 120,
        "retry_policy": {
          "max_attempts": 3,
          "backoff_seconds": 10
        }
      },
      {
        "id": "asset-issuance",
        "kind": "connector-call",
        "label": "Issue laptop + access",
        "connector": "oya-shared-connector-asset-management",
        "operation": "issue_kit",
        "timeout_seconds": 300
      },
      {
        "id": "training-enrol",
        "kind": "connector-call",
        "label": "Enrol mandatory training",
        "connector": "oya-shared-connector-lms",
        "operation": "enrol_curriculum"
      },
      {
        "id": "wait-30d",
        "kind": "wait",
        "label": "Wait 30 days"
      },
      {
        "id": "day30-survey",
        "kind": "connector-call",
        "label": "Day-30 sentiment survey",
        "connector": "oya-shared-connector-survey",
        "operation": "send_survey"
      },
      {
        "id": "audit-onboarding",
        "kind": "audit-emit",
        "label": "Emit onboarding seal"
      },
      {
        "id": "t-day30-complete",
        "kind": "terminal",
        "label": "Onboarding complete"
      }
    ],
    "edges": [
      {
        "from": "trigger-offer-signed",
        "to": "policy-eligibility"
      },
      {
        "from": "policy-eligibility",
        "to": "identity-provision",
        "condition": "permit"
      },
      {
        "from": "identity-provision",
        "to": "payroll-register"
      },
      {
        "from": "payroll-register",
        "to": "asset-issuance"
      },
      {
        "from": "asset-issuance",
        "to": "training-enrol"
      },
      {
        "from": "training-enrol",
        "to": "wait-30d"
      },
      {
        "from": "wait-30d",
        "to": "day30-survey"
      },
      {
        "from": "day30-survey",
        "to": "audit-onboarding"
      },
      {
        "from": "audit-onboarding",
        "to": "t-day30-complete"
      }
    ]
  },
  "input_parameters": [
    {
      "name": "employee_id",
      "type": "reference",
      "required": true,
      "description": "Employee reference issued at offer signing"
    },
    {
      "name": "start_date",
      "type": "date",
      "required": true,
      "description": "First day of employment"
    },
    {
      "name": "role_code",
      "type": "string",
      "required": true,
      "description": "Role classification code"
    }
  ],
  "runtime_expectations": {
    "expected_duration_seconds_p50": 2592000,
    "expected_duration_seconds_p99": 2851200
  },
  "compliance_flags": [
    "soc2-type-2",
    "gdpr",
    "ccpa",
    "i9-everify",
    "iso-27001"
  ],
  "audit_emission_points": [
    {
      "node_id": "identity-provision",
      "seal_kind": "external-call-receipt"
    },
    {
      "node_id": "payroll-register",
      "seal_kind": "external-call-receipt"
    },
    {
      "node_id": "audit-onboarding",
      "seal_kind": "decision-recorded"
    }
  ],
  "cedar_policy": {
    "policy_id": "cedar:oya-workflow-studio-template:new-hire-onboarding",
    "effect": "permit",
    "principal_scope": "Workflow::Tenant",
    "resource_scope": "EmployeeRecord",
    "action_scope": "onboard",
    "conditions": [
      "principal.role in [\"hr-business-partner\", \"people-ops-coordinator\"]"
    ]
  },
  "connector_dependencies": [
    {
      "connector_id": "oya-shared-connector-identity",
      "operations": [
        "provision_user"
      ],
      "criticality": "required"
    },
    {
      "connector_id": "oya-shared-connector-workday",
      "operations": [
        "hire_employee"
      ],
      "criticality": "required"
    },
    {
      "connector_id": "oya-shared-connector-asset-management",
      "operations": [
        "issue_kit"
      ],
      "criticality": "required"
    },
    {
      "connector_id": "oya-shared-connector-lms",
      "operations": [
        "enrol_curriculum"
      ],
      "criticality": "preferred"
    },
    {
      "connector_id": "oya-shared-connector-survey",
      "operations": [
        "send_survey"
      ],
      "criticality": "preferred"
    }
  ],
  "slo": {
    "max_duration_seconds": 2851200,
    "min_success_rate": 0.995,
    "openslo_ref": "microservices/workflow-studio/slos/oya-workflow-studio-template-new-hire-onboarding.openslo.yaml"
  },
  "cost_model": {
    "estimated_usd_per_execution_p50": 2.85,
    "foundry_inference_usd": 0.04,
    "connector_call_usd": 2.4,
    "storage_usd": 0.41
  },
  "test_mode_supported": true,
  "live_mode_supported": true,
  "documentation": {
    "explainer_path": "microservices/workflow-studio/templates/explainers/oya-workflow-studio-template-new-hire-onboarding.md",
    "fixture_path": "microservices/workflow-studio/templates/fixtures/oya-workflow-studio-template-new-hire-onboarding.fixture.json"
  },
  "tags": [
    "hr",
    "onboarding",
    "day-0",
    "day-30",
    "lifecycle"
  ]
}
