{
  "title": "Workflow Studio — Canvas perf",
  "uid": "oya-workflow-studio-canvas-perf",
  "schemaVersion": 39,
  "panels": [
    {"id": 1, "title": "p99 frame time @ 1000 nodes", "type": "timeseries", "targets": [{"expr": "histogram_quantile(0.99, rate(oya_workflow_studio_canvas_frame_seconds_bucket{node_count_bucket=\"1000\"}[5m]))"}]},
    {"id": 2, "title": "p99 frame time @ 5000 nodes (WebGL escape hatch)", "type": "timeseries", "targets": [{"expr": "histogram_quantile(0.99, rate(oya_workflow_studio_canvas_frame_seconds_bucket{node_count_bucket=\"5000\"}[5m]))"}]},
    {"id": 3, "title": "Loro CRDT sync round-trip p99", "type": "stat",         "targets": [{"expr": "histogram_quantile(0.99, rate(oya_workflow_studio_loro_sync_seconds_bucket[5m]))"}]},
    {"id": 4, "title": "Presence participant count (per room)", "type": "barchart", "targets": [{"expr": "count by (room_id) (oya_workflow_studio_presence_participant)"}]},
    {"id": 5, "title": "WebSocket reconnect rate", "type": "timeseries", "targets": [{"expr": "rate(oya_workflow_studio_ws_reconnect_total[5m])"}]}
  ]
}
