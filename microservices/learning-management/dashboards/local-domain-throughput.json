{
  "schemaVersion": 39,
  "title": "Learning Management local domain throughput",
  "tags": [
    "learning-management",
    "local-operational-primitive",
    "adr-0130"
  ],
  "timezone": "utc",
  "templating": {
    "list": [
      {
        "name": "tenant_id",
        "type": "query",
        "query": "label_values(oya_learning_management_assessment_submit_success_total, tenant_id)"
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Assessment submissions accepted once per authorized attempt burn",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(rate(oya_learning_management_assessment_submit_success_good_total[30d])) by (tenant_id, cell_tier) / sum(rate(oya_learning_management_assessment_submit_success_total[30d])) by (tenant_id, cell_tier)",
          "legendFormat": "assessment-submit-success ratio"
        }
      ]
    },
    {
      "id": 2,
      "title": "Cohort enrollment propagation latency burn",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(oya_learning_management_cohort_enrollment_latency_good_total[5m])) by (tenant_id, cell_tier) / sum(rate(oya_learning_management_cohort_enrollment_latency_total[5m])) by (tenant_id, cell_tier)",
          "legendFormat": "cohort-enrollment-latency ratio"
        }
      ]
    },
    {
      "id": 3,
      "title": "Learner progress projection freshness burn",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(rate(oya_learning_management_course_progress_freshness_good_total[1h])) by (tenant_id, cell_tier) / sum(rate(oya_learning_management_course_progress_freshness_total[1h])) by (tenant_id, cell_tier)",
          "legendFormat": "course-progress-freshness ratio"
        }
      ]
    },
    {
      "id": 4,
      "title": "Certificate issue latency after course completion burn",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(oya_learning_management_certificate_issue_latency_good_total[5m])) by (tenant_id, cell_tier) / sum(rate(oya_learning_management_certificate_issue_latency_total[5m])) by (tenant_id, cell_tier)",
          "legendFormat": "certificate-issue-latency ratio"
        }
      ]
    },
    {
      "id": 5,
      "title": "Live learning sessions joined successfully burn",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(rate(oya_learning_management_live_session_join_success_good_total[30d])) by (tenant_id, cell_tier) / sum(rate(oya_learning_management_live_session_join_success_total[30d])) by (tenant_id, cell_tier)",
          "legendFormat": "live-session-join-success ratio"
        }
      ]
    },
    {
      "id": 6,
      "title": "Course content delivery latency burn",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(oya_learning_management_content_delivery_latency_good_total[5m])) by (tenant_id, cell_tier) / sum(rate(oya_learning_management_content_delivery_latency_total[5m])) by (tenant_id, cell_tier)",
          "legendFormat": "content-delivery-latency ratio"
        }
      ]
    }
  ]
}
