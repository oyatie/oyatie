{
  "$schema": "https://schemas.grafana.com/dashboard.json",
  "_meta": {
    "doc_class": "GrafanaDashboard",
    "microservice": "application",
    "owner_team": "axis-application + ops-security",
    "audience": "operator + tenant admin (tenant-scoped variant)",
    "tenant_scoped": true,
    "datasource": "per-pack Mimir endpoint"
  },
  "uid": "app-session-active",
  "title": "Application Shell — Active Sessions",
  "tags": ["application", "session", "auth"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "templating": {
    "list": [
      {
        "name": "pack",
        "type": "custom",
        "options": [
          {"text": "pack-kr", "value": "kr", "selected": true},
          {"text": "pack-eu", "value": "eu"},
          {"text": "pack-us", "value": "us"},
          {"text": "pack-us-healthcare", "value": "us-hc"},
          {"text": "pack-jp", "value": "jp"},
          {"text": "pack-sg", "value": "sg"},
          {"text": "pack-au", "value": "au"},
          {"text": "pack-in", "value": "in"},
          {"text": "pack-br", "value": "br"},
          {"text": "pack-ae", "value": "ae"},
          {"text": "pack-ksa", "value": "ksa"}
        ],
        "label": "Pack"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Active sessions (now)",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "targets": [
        {"expr": "sum(oya_application_session_active{pack=\"$pack\"})", "refId": "A"}
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Sign-in success rate (5 min)",
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
      "targets": [
        {"expr": "sum(rate(oya_application_oidc_signin_success_total{pack=\"$pack\"}[5m])) / (sum(rate(oya_application_oidc_signin_attempt_total{pack=\"$pack\"}[5m])) > 0)", "refId": "A"}
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Valkey session-store memory ratio",
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
      "targets": [
        {"expr": "max(oya_application_valkey_memory_used_ratio{pack=\"$pack\"})", "refId": "A"}
      ],
      "options": {
        "thresholds": [
          {"value": 0, "color": "green"},
          {"value": 0.7, "color": "yellow"},
          {"value": 0.85, "color": "red"}
        ]
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Sessions created per second by provider",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum by (provider) (rate(oya_application_session_create_total{pack=\"$pack\"}[1m]))", "legendFormat": "{{provider}}", "refId": "A"}
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Sessions ended per second by reason",
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum by (reason) (rate(oya_application_session_end_total{pack=\"$pack\"}[1m]))", "legendFormat": "{{reason}}", "refId": "A"}
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Sign-in attempts blocked by rate-limit / WAF",
      "gridPos": {"x": 0, "y": 12, "w": 12, "h": 6},
      "targets": [
        {"expr": "sum by (reason) (rate(oya_application_auth_rate_limit_block_total{pack=\"$pack\"}[1m]))", "legendFormat": "{{reason}}", "refId": "A"}
      ]
    },
    {
      "id": 7,
      "type": "table",
      "title": "Top tenants by active session count",
      "gridPos": {"x": 12, "y": 12, "w": 12, "h": 6},
      "targets": [
        {"expr": "topk(20, sum by (tenant_id) (oya_application_session_active{pack=\"$pack\"}))", "format": "table", "refId": "A"}
      ]
    }
  ]
}
