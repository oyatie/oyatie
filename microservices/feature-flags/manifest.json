    },
    {
      "id": "ADR-0160",
      "title": "Progressive delivery Flagger",
      "scope": "repo",
      "file": "docs/decisions/ADR-0160-progressive-delivery-flagger.md"
    },
    {
      "id": "ADR-0183",
      "title": "Policy engine separation",
      "scope": "repo",
      "file": "docs/decisions/ADR-0183-policy-engine-separation-cedar-app-authz-kyverno-admission.md"
    }
  ],
  "contracts": {
    "openapi": ["microservices/feature-flags/contracts/feature-flags.openapi.yaml"],
    "asyncapi": ["microservices/feature-flags/contracts/feature-flags.asyncapi.yaml"],
    "proto": ["microservices/feature-flags/contracts/feature_flags.proto"]
  },
  "capabilities": [
    {
      "tier": "T0",
      "name": "flag-evaluation",
      "file": "microservices/feature-flags/capabilities/flag-evaluation.yaml"
