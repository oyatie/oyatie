{
  "title": "Feature Flags — Experiment Results",
  "uid": "feature-flags-experiments",
  "binding_adr": "ADR-0159",
  "microservice": "feature-flags",
  "description": "Experiment metrics with statistical significance indicators, SRM detection, and fairness audit overlays.",
  "panels": [
    {
      "title": "Active Experiments",
      "type": "stat",
      "targets": [
        {
          "expr": "count(oya_experiment_lifecycle_state{state=\"active\"})",
          "legendFormat": "Active experiments"
        }
      ]
    },
    {
      "title": "Experiment Assignments (rps by variant)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(oya_experiment_assignments_total[5m])) by (experiment_id, variant)",
          "legendFormat": "{{experiment_id}} / {{variant}}"
        }
      ]
    },
    {
      "title": "Conversion Rate by Variant",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(oya_experiment_conversion_total[5m])) by (experiment_id, variant) / sum(rate(oya_experiment_assignments_total[5m])) by (experiment_id, variant)",
          "legendFormat": "{{experiment_id}} / {{variant}} CVR"
        }
      ]
    },
    {
      "title": "Statistical Significance (Bayesian Posterior)",
      "type": "stat",
      "description": "Bayesian posterior probability that treatment beats control. ≥0.95 = significant.",
      "targets": [
        {
          "expr": "oya_experiment_bayesian_posterior_probability",
          "legendFormat": "{{experiment_id}}"
        }
      ],
      "thresholds": [
        {"value": 0.95, "color": "green"},
        {"value": 0.80, "color": "yellow"},
        {"value": 0.0, "color": "red"}
      ]
    },
    {
      "title": "Sample Ratio Mismatch (SRM) Detection",
      "type": "stat",
      "description": "Chi-squared p-value for assignment balance. p < 0.01 = SRM detected.",
      "alert": "page if srm_detected = true",
      "targets": [
        {
          "expr": "oya_experiment_srm_detected",
          "legendFormat": "{{experiment_id}} SRM"
        }
      ]
    },
    {
      "title": "Experiment Result Freshness Lag",
      "type": "timeseries",
      "slo_ref": "slos/experiment-result-freshness.openslo.yaml",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(oya_experiment_result_computation_lag_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95 freshness lag"
        }
      ],
      "thresholds": [
        {"value": 60.0, "color": "red"}
      ]
    },
    {
      "title": "Fairness Audit — Per-Class TPR/FPR Delta",
      "type": "table",
      "description": "Per protected class TPR/FPR deviation. ±2pp threshold per ADR-0309.",
      "targets": [
        {
          "expr": "oya_experiment_fairness_tpr_fpr_delta",
          "legendFormat": "{{experiment_id}} / {{protected_class}}"
        }
      ],
      "thresholds": [
        {"value": 0.02, "color": "red", "description": "±2pp threshold exceeded — ADR-0309 violation"}
      ]
    },
    {
      "title": "Sequential Test (mSPRT) — Stopping Boundary",
      "type": "timeseries",
      "targets": [
        {
          "expr": "oya_experiment_msprt_statistic",
          "legendFormat": "{{experiment_id}} mSPRT stat"
        },
        {
          "expr": "oya_experiment_msprt_boundary",
          "legendFormat": "{{experiment_id}} stopping boundary"
        }
      ]
    }
  ],
  "variables": [
    {"name": "experiment_id", "type": "query", "query": "label_values(oya_experiment_assignments_total, experiment_id)"},
    {"name": "tenant_id", "type": "query", "query": "label_values(oya_experiment_assignments_total, tenant_id)"}
  ],
  "links": [
    {"title": "Flag State Overview", "url": "/d/feature-flags-flag-state"},
    {"title": "Experiment Rollback Runbook", "url": "microservices/feature-flags/runbooks/experiment-rollback.md"}
  ]
}
