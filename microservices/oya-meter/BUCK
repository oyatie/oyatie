# Full targets wired when crate implementations land per D1-D5.

rust_library(
    name = "oya-meter-kernel",
    srcs = glob(["crates/oya-meter-kernel/src/**/*.rs"]),
    crate_root = "crates/oya-meter-kernel/src/lib.rs",
    visibility = ["PUBLIC"],
)

rust_library(
    name = "oya-meter-rest",
    srcs = glob(["crates/oya-meter-rest/src/**/*.rs"]),
    crate_root = "crates/oya-meter-rest/src/lib.rs",
    deps = [":oya-meter-kernel"],
    visibility = ["PUBLIC"],
)

rust_binary(
    name = "oya-meter-app",
    srcs = glob(["crates/oya-meter-app/src/**/*.rs"]),
    crate_root = "crates/oya-meter-app/src/main.rs",
    deps = [
        ":oya-meter-kernel",
        ":oya-meter-rest",
    ],
    visibility = ["PUBLIC"],
)

