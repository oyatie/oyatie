{
  "schema_version": "1.0",
  "microservice": "identity",
  "version": "0.1.0",
  "owner": "axis-identity",
  "bounded_contexts": [
    {
      "name": "zitadel-instance-controller",
      "description": "Manages Zitadel Instance lifecycle (deploy, upgrade, Postgres migration, JWKS rotation) per ADR-0187.",
      "crates": [
        "oya-identity-zitadel-instance-controller-kernel",
        "oya-identity-zitadel-instance-controller-domain",
        "oya-identity-zitadel-instance-controller-usecase",
        "oya-identity-zitadel-instance-controller-app",
        "oya-identity-zitadel-instance-controller-api",
        "oya-identity-zitadel-instance-controller-adapter"
      ]
    },
    {
      "name": "oidc-issuer",
      "description": "OIDC token issuance + introspection + JWKS serving per ADR-0187. Hot path.",
      "crates": [
        "oya-identity-oidc-issuer-kernel",
        "oya-identity-oidc-issuer-domain",
        "oya-identity-oidc-issuer-usecase",
        "oya-identity-oidc-issuer-app",
        "oya-identity-oidc-issuer-api",
        "oya-identity-oidc-issuer-rest",
        "oya-identity-oidc-issuer-sdk",
        "oya-identity-oidc-issuer-adapter-zitadel"
      ]
    },
    {
      "name": "webauthn-relying-party",
      "description": "WebAuthn L3 register/authenticate; AAGUID allowlist; FIDO-MDS3 refresh worker per ADR-0188.",
      "crates": [
        "oya-identity-webauthn-relying-party-kernel",
        "oya-identity-webauthn-relying-party-domain",
        "oya-identity-webauthn-relying-party-usecase",
        "oya-identity-webauthn-relying-party-app",
        "oya-identity-webauthn-relying-party-api",
        "oya-identity-webauthn-relying-party-rest",
        "oya-identity-webauthn-relying-party-adapter",
        "oya-identity-webauthn-aaguid-refresher-worker"
      ]
    },
    {
      "name": "scim-server",
      "description": "SCIM 2.0 RFC 7643/7644 inbound endpoint per tenant per ADR-0190.",
      "crates": [
        "oya-identity-scim-server-kernel",
        "oya-identity-scim-server-domain",
        "oya-identity-scim-server-usecase",
        "oya-identity-scim-server-app",
        "oya-identity-scim-server-api",
        "oya-identity-scim-server-rest",
        "oya-identity-scim-server-adapter-zitadel"
      ]
    },
    {
      "name": "hris-adapter",
      "description": "Pluggable adapter contract for non-SCIM HRIS (Workday/BambooHR/Rippling); poller worker.",
      "crates": [
        "oya-identity-hris-adapter-kernel",
        "oya-identity-hris-adapter-domain",
        "oya-identity-hris-adapter-usecase",
        "oya-identity-hris-adapter-app",
        "oya-identity-hris-adapter-api",
        "oya-identity-hris-adapter-worker"
      ]
    },
    {
      "name": "step-up-orchestrator",
      "description": "Step-up ACR grant flow per ADR-0189; JIT IT-approval bridge.",
      "crates": [
        "oya-identity-step-up-orchestrator-kernel",
        "oya-identity-step-up-orchestrator-domain",
        "oya-identity-step-up-orchestrator-usecase",
        "oya-identity-step-up-orchestrator-app",
        "oya-identity-step-up-orchestrator-api",
        "oya-identity-step-up-orchestrator-adapter"
      ]
    },
    {
      "name": "multi-context-principal-resolver",
      "description": "Resolves one principal across personal, work, healthcare, marketplace, and community contexts per ADR-0215.",
      "crates": [
        "oya-identity-multi-context-principal-resolver-kernel",
        "oya-identity-multi-context-principal-resolver-domain",
        "oya-identity-multi-context-principal-resolver-usecase",
        "oya-identity-multi-context-principal-resolver-api",
        "oya-identity-multi-context-principal-resolver-rest",
        "oya-identity-multi-context-principal-resolver-adapter"
      ]
    },
    {
      "name": "external-idp-federation",
      "description": "Upstream IdP federation (Google Workspace, Okta, Entra) via OIDC + SAML.",
      "crates": [
        "oya-identity-external-idp-federation-kernel",
        "oya-identity-external-idp-federation-domain",
        "oya-identity-external-idp-federation-usecase",
        "oya-identity-external-idp-federation-app",
        "oya-identity-external-idp-federation-api",
        "oya-identity-external-idp-federation-adapter"
      ]
    },
    {
      "name": "audit-emitter",
      "description": "Bridge to audit-chain µservice for all identity-class events per ADR-0162.",
      "crates": [
        "oya-identity-audit-emitter-kernel",
        "oya-identity-audit-emitter-usecase",
        "oya-identity-audit-emitter-app",
        "oya-identity-audit-emitter-api",
        "oya-identity-audit-emitter-adapter-audit-chain-bridge"
      ]
    }
  ],
  "layers": [
    "adapter",
    "api",
    "app",
    "domain",
    "kernel",
    "rest",
    "sdk",
    "usecase",
    "worker"
  ],
  "contracts": {
    "openapi": [
      "microservices/identity/contracts/openapi/identity.yaml",
      "microservices/identity/contracts/openapi/multi-context-split.yaml"
    ],
    "asyncapi": [
      "microservices/identity/contracts/asyncapi/identity-events.yaml",
      "microservices/identity/contracts/asyncapi/multi-context-events.yaml"
    ],
    "proto": [
      "microservices/identity/contracts/proto/identity.proto",
      "microservices/identity/contracts/proto/multi_context_split.proto"
    ]
  },
  "capabilities": [
    {
      "tier": "T0",
      "name": "oidc-token-issue",
      "file": "microservices/identity/capabilities/oidc-token-issue.yaml",
      "eu_ai_act_risk_class": "none"
    },
    {
      "tier": "T0",
      "name": "webauthn-authenticate",
      "file": "microservices/identity/capabilities/webauthn-authenticate.yaml",
      "eu_ai_act_risk_class": "none"
    },
    {
      "tier": "T1",
      "name": "step-up-acr-grant",
      "file": "microservices/identity/capabilities/step-up-acr-grant.yaml",
      "eu_ai_act_risk_class": "limited"
    },
    {
      "tier": "T1",
      "name": "multi-context-principal-resolve",
      "file": "microservices/identity/capabilities/multi-context-principal-resolve.yaml",
      "eu_ai_act_risk_class": "limited"
    },
    {
      "tier": "T2",
      "name": "scim-user-provision",
      "file": "microservices/identity/capabilities/scim-user-provision.yaml",
      "eu_ai_act_risk_class": "limited"
    }
  ],
  "slos": [
    {
      "name": "oya-identity-oidc-token-issue-latency",
      "target": "0.99",
      "sli": "histogram_quantile(0.99, sum(rate(oya_identity_oidc_issue_duration_seconds_bucket[5m])) by (le))",
      "file": "microservices/identity/slos/oidc-token-issue-latency.openslo.yaml"
    },
    {
      "name": "oya-identity-oidc-token-verify-latency",
      "target": "0.999",
      "sli": "histogram_quantile(0.999, sum(rate(oya_identity_oidc_verify_duration_seconds_bucket[5m])) by (le))",
      "file": "microservices/identity/slos/oidc-token-verify-latency.openslo.yaml"
    },
    {
      "name": "oya-identity-webauthn-authenticate-latency",
      "target": "0.99",
      "sli": "histogram_quantile(0.99, sum(rate(oya_identity_webauthn_authenticate_duration_seconds_bucket[5m])) by (le))",
      "file": "microservices/identity/slos/webauthn-authenticate-latency.openslo.yaml"
    },
    {
      "name": "oya-identity-scim-availability",
      "target": "0.9995",
      "sli": "sum(rate(oya_identity_scim_request_total{http_status!~\"5..\"}[5m])) / sum(rate(oya_identity_scim_request_total[5m]))",
      "file": "microservices/identity/slos/scim-availability.openslo.yaml"
    },
    {
      "name": "oya-identity-step-up-grant-latency",
      "target": "0.95",
      "sli": "histogram_quantile(0.95, sum(rate(oya_identity_step_up_grant_duration_seconds_bucket[5m])) by (le))",
      "file": "microservices/identity/slos/step-up-grant-latency.openslo.yaml"
    },
    {
      "name": "oya-identity-jwks-availability",
      "target": "0.99999",
      "sli": "sum(rate(oya_identity_jwks_request_total{http_status!~\"5..\"}[5m])) / sum(rate(oya_identity_jwks_request_total[5m]))",
      "file": "microservices/identity/slos/jwks-availability.openslo.yaml"
    },
    {
      "name": "oya-identity-audit-emit-completeness",
      "target": "1.0",
      "sli": "sum(rate(oya_identity_audit_emit_total{sealed=\"true\"}[5m])) / sum(rate(oya_identity_audit_emit_total[5m]))",
      "file": "microservices/identity/slos/audit-emit-completeness.openslo.yaml"
    },
    {
      "name": "oya-identity-aaguid-refresh-freshness",
      "target": "0.999",
      "sli": "sum(rate(oya_identity_aaguid_refresh_total{stale=\"false\"}[5m])) / sum(rate(oya_identity_aaguid_refresh_total[5m]))",
      "file": "microservices/identity/slos/aaguid-refresh-freshness.openslo.yaml"
    },
    {
      "name": "oya-identity-zitadel-instance-health",
      "target": "0.9999",
      "sli": "sum(up{job=\"zitadel\"}) / count(up{job=\"zitadel\"})",
      "file": "microservices/identity/slos/zitadel-instance-health.openslo.yaml"
    }
  ],
  "ips": [
    {"id": "IP-001", "title": "Zitadel Helm deployment per pack", "acceptance_status": "ga", "file": "microservices/identity/IP-001-zitadel-helm-per-pack.md"},
    {"id": "IP-002", "title": "OIDC issuer kernel + JWKS verify", "acceptance_status": "ga", "file": "microservices/identity/IP-002-oidc-issuer-kernel.md"},
    {"id": "IP-003", "title": "OIDC issuer Zitadel adapter", "acceptance_status": "ga", "file": "microservices/identity/IP-003-oidc-issuer-adapter-zitadel.md"},
    {"id": "IP-004", "title": "WebAuthn relying-party kernel", "acceptance_status": "ga", "file": "microservices/identity/IP-004-webauthn-relying-party-kernel.md"},
    {"id": "IP-005", "title": "WebAuthn register/authenticate REST", "acceptance_status": "ga", "file": "microservices/identity/IP-005-webauthn-rest.md"},
    {"id": "IP-006", "title": "FIDO-MDS3 AAGUID refresh worker", "acceptance_status": "ga", "file": "microservices/identity/IP-006-aaguid-refresh-worker.md"},
    {"id": "IP-007", "title": "SCIM 2.0 server kernel + RFC 7644 conformance", "acceptance_status": "ga", "file": "microservices/identity/IP-007-scim-server-kernel.md"},
    {"id": "IP-008", "title": "SCIM Zitadel adapter (lifecycle propagation)", "acceptance_status": "ga", "file": "microservices/identity/IP-008-scim-adapter-zitadel.md"},
    {"id": "IP-009", "title": "HRIS adapter contract + Workday/BambooHR/Rippling impls", "acceptance_status": "ga", "file": "microservices/identity/IP-009-hris-adapter.md"},
    {"id": "IP-010", "title": "Step-up ACR orchestrator + Cedar gate", "acceptance_status": "ga", "file": "microservices/identity/IP-010-step-up-orchestrator.md"},
    {"id": "IP-011", "title": "External IdP federation (Workspace/Okta/Entra)", "acceptance_status": "ga", "file": "microservices/identity/IP-011-external-idp-federation.md"},
    {"id": "IP-012", "title": "Audit emitter to audit-chain", "acceptance_status": "ga", "file": "microservices/identity/IP-012-audit-emitter.md"},
    {"id": "IP-013", "title": "Edge authz rules (Coraza + rate-limit + geo)", "acceptance_status": "ga", "file": "microservices/identity/IP-013-edge-authz-rules.md"},
    {"id": "IP-014", "title": "Continuous risk-scoring adjunct (CAEP)", "acceptance_status": "ga", "file": "microservices/identity/IP-014-continuous-risk-scoring.md"},
    {"id": "IP-015", "title": "oya-shared-* kernel crate exports + reference impls", "acceptance_status": "ga", "file": "microservices/identity/IP-015-shared-kernel-crates.md"},
    {"id": "IP-016", "title": "Zitadel scale validation load test (gate before pack-eu bellwether)", "acceptance_status": "ga", "file": "microservices/identity/IP-016-zitadel-scale-validation-load-test.md"},
    {"id": "IP-017", "title": "Multi-context principal resolver", "acceptance_status": "ga", "file": "microservices/identity/IP-017-multi-context-principal-resolver.md"}
  ],
  "regulatory_packs": ["kr", "eu", "us", "us-healthcare", "jp", "sg", "au", "in", "br", "ae", "ksa"],
  "lts_pins": {
    "zitadel": "v2.55.0",
    "zitadel_helm_chart": "9.34.1",
    "webauthn-rs": "0.5",
    "openidconnect": "4.0.1",
    "coraza": "v3",
    "owasp_crs": "4.25.0-lts",
    "postgres": "16.x"
  },
  "adrs": [
    {"id": "ADR-0187", "title": "Canonical OIDC IdP: Zitadel primary", "scope": "microservice", "file": "docs/decisions/ADR-0187-canonical-oidc-idp-zitadel-primary.md"},
    {"id": "ADR-0188", "title": "Passkey / WebAuthn Level-3 substrate", "scope": "microservice", "file": "docs/decisions/ADR-0188-passkey-webauthn-substrate.md"},
    {"id": "ADR-0189", "title": "Step-up authentication ACR classes", "scope": "microservice", "file": "docs/decisions/ADR-0189-step-up-authentication-acr-classes.md"},
    {"id": "ADR-0190", "title": "SCIM 2.0 inbound provisioning", "scope": "microservice", "file": "docs/decisions/ADR-0190-scim-2-provisioning-enterprise-tenants.md"},
    {"id": "ADR-0191", "title": "Edge authz tier vs origin Cedar PDP", "scope": "microservice", "file": "docs/decisions/ADR-0191-edge-authz-tier-vs-origin-cedar-pdp.md"},
    {"id": "ADR-0215", "title": "Multi-context platform architecture", "scope": "repo", "file": "docs/decisions/ADR-0215-multi-context-platform-architecture.md"},
    {"id": "ADR-0117", "title": "OpenBao SecretReference substrate", "scope": "repo"},
    {"id": "ADR-0145", "title": "Inter-microservice communication reform", "scope": "repo"},
    {"id": "ADR-0148", "title": "Service-mesh Cilium Ambient layered", "scope": "repo"},
    {"id": "ADR-0162", "title": "Per-tenant audit-log slicing", "scope": "repo"},
    {"id": "ADR-0182", "title": "API gateway north-south vs mesh east-west", "scope": "repo"},
    {"id": "ADR-0183", "title": "Policy-engine separation Cedar+Kyverno", "scope": "repo"}
  ],
  "hyperscaler_inv_coverage": {
    "circuit_breaker": "envoy-circuit-breaker-on-zitadel-upstream: max_connections=200, max_pending_requests=100, max_requests=400, max_retries=3, outlier_detection: per-tenant-budget split via consecutive_5xx=5 base_ejection_time=30s",
    "tenant_rate_limit": "envoy-rate-limit-per-tenant-id-header + per-scim-bearer-token; pgcat shuffle-sharding 4 shards year-1 → 16 year-3 → 64 year-5",
    "golden_signals": "rate=oya_identity_oidc_issue_total; errors=oya_identity_oidc_issue_total{error=~\".+\"}; latency=oya_identity_oidc_issue_duration_seconds; saturation=oya_identity_zitadel_postgres_pool_utilization; dashboard: dashboards/identity-overview.json panel-1",
    "error_budget_burn": "4-window multi-burn per ADR-0139 on all 9 SLOs in #slos; OnCall route: axis-identity"
  },
  "hyperscaler_invariants_v2": {
    "circuit_breaker_active": true,
    "shuffle_sharding_active": true,
    "four_golden_signals_active": true,
    "slo_error_budget_active": true,
    "evidence_path": "evidence/identity/hyperscaler-inv-conformance-2026-05-18.json"
  },
  "audit_chain": {
    "enabled": true,
    "seal_events": [
      "IdentityUserProvisioned",
      "IdentityUserReactivated",
      "IdentityUserSuspended",
      "IdentityUserDeleted",
      "IdentitySignInSucceeded",
      "IdentitySignInFailed",
      "IdentityStepUpGranted",
      "IdentityStepUpDenied",
      "IdentityContextResolved",
      "IdentityContextSwitchRefused",
      "IdentityWebAuthnRegistered",
      "IdentityWebAuthnRevoked",
      "IdentityScimRequestReceived",
      "IdentityOidcTokenIssued",
      "IdentityOidcTokenRevoked",
      "IdentityJwksRotated",
      "IdentityExternalIdpBound",
      "IdentityExternalIdpUnbound",
      "IdentityHrisHirePulled",
      "IdentityHrisTerminationPulled"
    ]
  },
  "secrets_substrate": {
    "provider": "openbao",
    "format": "${openbao:secret/<path>}"
  },
  "ontology_projections": [
    {
      "entity_name": "User",
      "projection_target_table": "ontology.identity_user_projection",
      "projection_kind": "idempotent-rewrite",
      "lag_budget_seconds": 5
    },
    {
      "entity_name": "Group",
      "projection_target_table": "ontology.identity_group_projection",
      "projection_kind": "idempotent-rewrite",
      "lag_budget_seconds": 5
    },
    {
      "entity_name": "WebAuthnCredential",
      "projection_target_table": "ontology.identity_webauthn_credential_projection",
      "projection_kind": "append-only",
      "lag_budget_seconds": 30
    }
  ],
  "data_classes_processed": [
    "PII_IDENTIFYING",
    "PII_QUASI_IDENTIFYING",
    "AUTHENTICATION",
    "AUDIT",
    "INTERNAL_ONLY"
  ],
  "rpo_rto": {
    "tier": "realtime",
    "rto_target_seconds": 30,
    "rpo_target_seconds": 0,
    "authority_adr": "ADR-0152"
  },
  "outbox_required": true,
  "mesh_layering": {
    "cilium_l4": true,
    "ambient_ztunnel": true,
    "ambient_waypoint": true
  }
}
