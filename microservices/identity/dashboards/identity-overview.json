{
  "$schema": "https://grafana.com/api/dashboards/json-schema",
  "title": "identity — Overview (4 core signals)",
  "uid": "identity-overview",
  "tags": ["identity", "core-signals", "hot-path"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "pack",
        "type": "custom",
        "label": "Pack",
        "options": [
          { "text": "kr", "value": "kr" },
          { "text": "eu", "value": "eu", "selected": true },
          { "text": "us", "value": "us" },
          { "text": "us-healthcare", "value": "us-healthcare" },
          { "text": "jp", "value": "jp" },
          { "text": "sg", "value": "sg" },
          { "text": "au", "value": "au" },
          { "text": "in", "value": "in" },
          { "text": "br", "value": "br" },
          { "text": "ae", "value": "ae" },
          { "text": "ksa", "value": "ksa" }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "core signal — Rate",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "title": "OIDC token issuance rate (rps)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "targets": [
        {
          "expr": "sum(rate(oya_identity_oidc_issue_total{pack=\"$pack\"}[5m])) by (grant_type)"
        }
      ]
    },
    {
      "id": 3,
      "title": "OIDC token verification rate (rps)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "targets": [
        {
          "expr": "sum(rate(oya_identity_oidc_verify_total{pack=\"$pack\"}[5m]))"
        }
      ]
    },
    {
      "id": 4,
      "type": "row",
      "title": "core signal — Errors",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 }
    },
    {
      "id": 5,
      "title": "OIDC issuance error rate (%)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 10 },
      "targets": [
        {
          "expr": "100 * sum(rate(oya_identity_oidc_issue_total{pack=\"$pack\",error!=\"\"}[5m])) / sum(rate(oya_identity_oidc_issue_total{pack=\"$pack\"}[5m]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.1 },
              { "color": "red", "value": 1.0 }
            ]
          }
        }
      }
    },
    {
      "id": 6,
      "title": "WebAuthn assertion failure rate (%)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 10 },
      "targets": [
        {
          "expr": "100 * sum(rate(oya_identity_webauthn_authenticate_total{pack=\"$pack\",outcome=\"failure\"}[5m])) / sum(rate(oya_identity_webauthn_authenticate_total{pack=\"$pack\"}[5m]))"
        }
      ]
    },
    {
      "id": 7,
      "title": "SCIM 5xx rate (%)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 10 },
      "targets": [
        {
          "expr": "100 * sum(rate(oya_identity_scim_request_total{pack=\"$pack\",http_status=~\"5..\"}[5m])) / sum(rate(oya_identity_scim_request_total{pack=\"$pack\"}[5m]))"
        }
      ]
    },
    {
      "id": 8,
      "title": "Step-up denied rate (%)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 10 },
      "targets": [
        {
          "expr": "100 * sum(rate(oya_identity_step_up_total{pack=\"$pack\",outcome=\"denied\"}[5m])) / sum(rate(oya_identity_step_up_total{pack=\"$pack\"}[5m]))"
        }
      ]
    },
    {
      "id": 9,
      "type": "row",
      "title": "core signal — Latency",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 16 }
    },
    {
      "id": 10,
      "title": "OIDC token-issue p50/p99/p999 (s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 17 },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(oya_identity_oidc_issue_duration_seconds_bucket{pack=\"$pack\"}[5m])) by (le))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.99, sum(rate(oya_identity_oidc_issue_duration_seconds_bucket{pack=\"$pack\"}[5m])) by (le))", "legendFormat": "p99" },
        { "expr": "histogram_quantile(0.999, sum(rate(oya_identity_oidc_issue_duration_seconds_bucket{pack=\"$pack\"}[5m])) by (le))", "legendFormat": "p999" }
      ]
    },
    {
      "id": 11,
      "title": "WebAuthn assertion p50/p99 (s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 17 },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(oya_identity_webauthn_authenticate_duration_seconds_bucket{pack=\"$pack\"}[5m])) by (le))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.99, sum(rate(oya_identity_webauthn_authenticate_duration_seconds_bucket{pack=\"$pack\"}[5m])) by (le))", "legendFormat": "p99" }
      ]
    },
    {
      "id": 12,
      "type": "row",
      "title": "core signal — Saturation",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 25 }
    },
    {
      "id": 13,
      "title": "Zitadel Postgres connection-pool utilisation (%)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 26 },
      "targets": [
        { "expr": "100 * oya_identity_zitadel_postgres_pool_utilization{pack=\"$pack\"}" }
      ]
    },
    {
      "id": 14,
      "title": "Zitadel pod CPU + memory (%)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 26 },
      "targets": [
        { "expr": "100 * avg(rate(container_cpu_usage_seconds_total{namespace=\"identity-$pack\",pod=~\"zitadel-.*\"}[5m]))", "legendFormat": "CPU" },
        { "expr": "100 * avg(container_memory_working_set_bytes{namespace=\"identity-$pack\",pod=~\"zitadel-.*\"} / container_spec_memory_limit_bytes)", "legendFormat": "Memory" }
      ]
    }
  ]
}
