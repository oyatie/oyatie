{
  "schemaVersion": 39,
  "title": "Financial Planning local audit completeness",
  "tags": [
    "financial-planning",
    "local-operational-primitive",
    "adr-0130"
  ],
  "timezone": "utc",
  "templating": {
    "list": [
      {
        "name": "tenant_id",
        "type": "query",
        "query": "label_values(oya_financial_planning_board_report_seal_completeness_total, tenant_id)"
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Board reports sealed with lineage evidence burn",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(rate(oya_financial_planning_board_report_seal_completeness_good_total[30d])) by (tenant_id, cell_tier) / sum(rate(oya_financial_planning_board_report_seal_completeness_total[30d])) by (tenant_id, cell_tier)",
          "legendFormat": "board-report-seal-completeness ratio"
        }
      ]
    },
    {
      "id": 2,
      "title": "FX rates refreshed for active planning scenarios burn",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(oya_financial_planning_fx_rate_freshness_good_total[1h])) by (tenant_id, cell_tier) / sum(rate(oya_financial_planning_fx_rate_freshness_total[1h])) by (tenant_id, cell_tier)",
          "legendFormat": "fx-rate-freshness ratio"
        }
      ]
    },
    {
      "id": 3,
      "title": "Close-cycle workflow advances inside finance calendar objective burn",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(rate(oya_financial_planning_close_cycle_latency_good_total[30d])) by (tenant_id, cell_tier) / sum(rate(oya_financial_planning_close_cycle_latency_total[30d])) by (tenant_id, cell_tier)",
          "legendFormat": "close-cycle-latency ratio"
        }
      ]
    },
    {
      "id": 4,
      "title": "Forecast recalculation latency burn",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(oya_financial_planning_forecast_recalc_latency_good_total[5m])) by (tenant_id, cell_tier) / sum(rate(oya_financial_planning_forecast_recalc_latency_total[5m])) by (tenant_id, cell_tier)",
          "legendFormat": "forecast-recalc-latency ratio"
        }
      ]
    },
    {
      "id": 5,
      "title": "Variance explanations available after source ledger update burn",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(rate(oya_financial_planning_variance_explain_freshness_good_total[1h])) by (tenant_id, cell_tier) / sum(rate(oya_financial_planning_variance_explain_freshness_total[1h])) by (tenant_id, cell_tier)",
          "legendFormat": "variance-explain-freshness ratio"
        }
      ]
    },
    {
      "id": 6,
      "title": "Budget lock operations complete with controller evidence burn",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(oya_financial_planning_budget_lock_success_good_total[30d])) by (tenant_id, cell_tier) / sum(rate(oya_financial_planning_budget_lock_success_total[30d])) by (tenant_id, cell_tier)",
          "legendFormat": "budget-lock-success ratio"
        }
      ]
    }
  ]
}
