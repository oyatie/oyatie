{
  "$schema": "https://schemas.grafana.com/dashboard.json",
  "_meta": {
    "doc_class": "GrafanaDashboard",
    "microservice": "workflow-engine",
    "owner_team": "ops-sre-reliability + axis-workflow",
    "audience": "internal operators",
    "tenant_scoped": true,
    "datasource": "Mimir per-pack endpoints"
  },
  "uid": "wf-engine-step-latency",
  "title": "Workflow Engine — Step Latency + Event-to-Action",
  "tags": ["workflow-engine", "operator", "latency", "slo"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "templating": {
    "list": [
      {
        "name": "pack",
        "type": "custom",
        "options": [
          {"text": "pack-kr", "value": "kr", "selected": true},
          {"text": "pack-eu", "value": "eu"},
          {"text": "pack-us", "value": "us"},
          {"text": "pack-us-healthcare", "value": "us-hc"},
          {"text": "pack-jp", "value": "jp"},
          {"text": "pack-sg", "value": "sg"},
          {"text": "pack-au", "value": "au"},
          {"text": "pack-in", "value": "in"},
          {"text": "pack-br", "value": "br"},
          {"text": "pack-ae", "value": "ae"},
          {"text": "pack-ksa", "value": "ksa"}
        ],
        "label": "Pack"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Step execution latency (p50 / p99 / p999)",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(oya_workflow_engine_step_duration_seconds_bucket{pack=\"$pack\",kind=\"local\"}[5m]))) * 1000",
          "legendFormat": "p50 (ms)",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(oya_workflow_engine_step_duration_seconds_bucket{pack=\"$pack\",kind=\"local\"}[5m]))) * 1000",
          "legendFormat": "p99 (ms)",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.999, sum by (le) (rate(oya_workflow_engine_step_duration_seconds_bucket{pack=\"$pack\",kind=\"local\"}[5m]))) * 1000",
          "legendFormat": "p999 (ms)",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 100},
              {"color": "red", "value": 200}
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Engine dispatch latency: run start → first step (p99)",
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(oya_workflow_engine_dispatch_latency_seconds_bucket{pack=\"$pack\"}[5m]))) * 1000",
          "legendFormat": "p99 (ms)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Event-to-action latency (outbox → worker → step dispatch) p99",
      "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(oya_workflow_engine_event_to_action_seconds_bucket{pack=\"$pack\"}[5m]))) * 1000",
          "legendFormat": "p99 (ms)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Step latency SLO burn rate",
      "gridPos": {"x": 0, "y": 24, "w": 12, "h": 4},
      "targets": [
        {
          "expr": "oya:workflow_engine_step_latency_burn_rate_1h{pack=\"$pack\"}",
          "legendFormat": "burn (1h)",
          "refId": "A"
        }
      ]
    }
  ]
}
