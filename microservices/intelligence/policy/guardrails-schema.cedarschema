// foundry-guardrails — Cedar v4 schema
// Defines entity types, action set, and context shape used by all Cedar fragments.
// Per ADR-0140 (retired per ADR-0145) + policy/guardrail-enforcement.md.
//
// All Cedar fragments under microservices/intelligence/policy/*.cedar MUST
// validate against this schema; the oya-governance-cedar-fragment-coverage
// CI lane refuses unschema'd fragments.

namespace OyaFoundryGuardrails {

  // =========================================================================
  // Entity types
  // =========================================================================

  entity TenantOperator = {
    tenant_id: String,
    sensitive_data_entitlements?: Set<String>   // optional; only present per DPA
  };

  entity Service = {
    pr_sha?: String,         // present for CI rule-mutation invocations
    spiffe_id?: String       // for in-cluster mTLS callers
  };

  entity Auditor = {
    engagement_active: Bool,
    scoped_tenants: Set<String>,
    token_expires_at: Long    // epoch seconds
  };

  entity TenantData = {
    tenant_id: String,
    data_class?: String,      // BEHAVIORAL_TENANT_PRODUCT | PII_IDENTIFYING | PHI | INTERNAL_ONLY | AUDIT | SECRET | SENSITIVE_PIPA_ART23
    decision_kind?: String    // block | allow | redact (FP-mark only valid on block)
  };

  entity GuardrailDecision = {
    decision_id: String,
    invocation_id: String,
    tenant_id: String,
    pack: String
  };

  entity RuleStoreEntry = {
    rule_id: String,
    version: Long,
    pack: String,
    tenant_id?: String,
    author_spiffe: String
  };

  entity MetricSeries = {
    metric_name: String,
    tenant_id?: String,
    pack?: String
  };

  entity OperationalRecord = {
    record_type: String       // classifier_deploy | rule_mutation | cedar_bundle_history
  };

  entity ShadowEnforceDelta = {
    rule_id: String,
    delta: Decimal
  };

  entity ClassifierDeploymentRecord = {
    model_id: String,
    version: String,
    pack: String
  };

  entity SchemaValidationRequest = {};
  entity ProbeEndpoint = {};
  entity EnumDescriptor = {};

  // =========================================================================
  // Action set
  // =========================================================================

  action classify_prompt
    appliesTo {
      principal: [TenantOperator, Service],
      resource: [GuardrailDecision]
    };

  action validate_output
    appliesTo {
      principal: [TenantOperator, Service],
      resource: [GuardrailDecision]
    };

  action enforce_autonomy
    appliesTo {
      principal: [TenantOperator, Service],
      resource: [GuardrailDecision]
    };

  action read_decision_detail
    appliesTo {
      principal: [TenantOperator, Auditor],
      resource: [TenantData]
    };

  action read_decision_history
    appliesTo {
      principal: [Auditor],
      resource: [TenantData]
    };

  action read_audit_chain_seal
    appliesTo {
      principal: [Auditor],
      resource: [TenantData]
    };

  action read_false_positive_budget
    appliesTo {
      principal: [TenantOperator],
      resource: [TenantData]
    };

  action mark_false_positive
    appliesTo {
      principal: [TenantOperator],
      resource: [TenantData]
    };

  action list_tenant_overlays
    appliesTo {
      principal: [TenantOperator],
      resource: [TenantData]
    };

  action read_tenant_overlay
    appliesTo {
      principal: [TenantOperator],
      resource: [TenantData]
    };

  action read_metrics
    appliesTo {
      principal: [TenantOperator, Service, Auditor],
      resource: [MetricSeries]
    };

  action write_rule_definition
    appliesTo {
      principal: [Service],
      resource: [RuleStoreEntry]
    };

  action write_cedar_fragment_registry
    appliesTo {
      principal: [Service],
      resource: [RuleStoreEntry]
    };

  action read_shadow_enforce_delta
    appliesTo {
      principal: [Service, TenantOperator],
      resource: [ShadowEnforceDelta]
    };

  action read_classifier_model_deploy_history
    appliesTo {
      principal: [Service, Auditor],
      resource: [ClassifierDeploymentRecord, OperationalRecord]
    };

  action read_rule_mutation_history
    appliesTo {
      principal: [Auditor],
      resource: [OperationalRecord]
    };

  action read_cedar_bundle_history
    appliesTo {
      principal: [Auditor],
      resource: [OperationalRecord]
    };

  action read_audit_chain_seal_aggregate
    appliesTo {
      principal: [Service],
      resource: [MetricSeries]
    };

  action validate_cedar_overlay_schema
    appliesTo {
      principal: [TenantOperator, Service],
      resource: [SchemaValidationRequest]
    };

  action health_probe
    appliesTo {
      principal: [TenantOperator, Service],
      resource: [ProbeEndpoint]
    };

  action readiness_probe
    appliesTo {
      principal: [TenantOperator, Service],
      resource: [ProbeEndpoint]
    };

  action read_block_reason_taxonomy
    appliesTo {
      principal: [TenantOperator, Service],
      resource: [EnumDescriptor]
    };

  action write_metrics
    appliesTo {
      principal: [Service],
      resource: [MetricSeries]
    };

  action write_logs
    appliesTo {
      principal: [Service],
      resource: [MetricSeries]
    };

  action write_traces
    appliesTo {
      principal: [Service],
      resource: [MetricSeries]
    };

  action write_decision
    appliesTo {
      principal: [Service],
      resource: [GuardrailDecision]
    };

  action write_tenant_overlay
    appliesTo {
      principal: [Service],
      resource: [TenantData]
    };

  action deploy_classifier_model
    appliesTo {
      principal: [Service],
      resource: [ClassifierDeploymentRecord]
    };
}
