{
  "$schema": "https://schemas.grafana.com/dashboard.json",
  "_meta": {
    "doc_class": "GrafanaDashboard",
    "microservice": "foundry-providers",
    "owner_team": "axis-foundry",
    "related_artifacts": [
      "microservices/intelligence/PRD.md",
      "microservices/intelligence/contracts/asyncapi/provider-events.yaml",
      "microservices/intelligence/policy/provider-router-tenant-scope.cedar"
    ],
    "audience": "tenant operators + axis-foundry on-call",
    "tenant_scoped": true,
    "datasource": "Mimir (per-pack); X-Scope-OrgID = principal.tenant_id"
  },
  "uid": "fprov-provider-call-rate",
  "title": "Provider Call Rate (per tenant)",
  "tags": ["foundry-providers", "router", "tenant-facing"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-24h", "to": "now"},
  "timepicker": {"refresh_intervals": ["10s","30s","1m","5m","15m"]},
  "templating": {
    "list": [
      {
        "name": "tenant",
        "type": "query",
        "datasource": "Mimir",
        "query": "label_values(oya_foundry_providers_provider_invocations_total, tenant)",
        "refresh": 1,
        "label": "Tenant"
      },
      {
        "name": "pack",
        "type": "custom",
        "options": [
          {"text": "kr", "value": "kr"},
          {"text": "eu", "value": "eu"},
          {"text": "us", "value": "us"},
          {"text": "us-healthcare", "value": "us-healthcare"},
          {"text": "jp", "value": "jp"},
          {"text": "sg", "value": "sg"},
          {"text": "au", "value": "au"},
          {"text": "in", "value": "in"},
          {"text": "br", "value": "br"},
          {"text": "ae", "value": "ae"},
          {"text": "ksa", "value": "ksa"}
        ],
        "label": "Pack"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Calls per second — by vendor",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum by (vendor) (rate(oya_foundry_providers_provider_invocations_total{tenant=\"$tenant\",pack=\"$pack\"}[5m]))", "legendFormat": "{{vendor}}", "refId": "A"}
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Calls — last 1h",
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
      "targets": [
        {"expr": "sum(increase(oya_foundry_providers_provider_invocations_total{tenant=\"$tenant\",pack=\"$pack\"}[1h]))", "refId": "A"}
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Tokens — last 1h",
      "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
      "targets": [
        {"expr": "sum(increase(oya_foundry_providers_provider_tokens_total{tenant=\"$tenant\",pack=\"$pack\"}[1h]))", "refId": "A"}
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Calls per second — by (vendor, transport)",
      "gridPos": {"x": 0, "y": 8, "w": 24, "h": 8},
      "targets": [
        {"expr": "sum by (vendor, transport) (rate(oya_foundry_providers_provider_invocations_total{tenant=\"$tenant\",pack=\"$pack\"}[5m]))", "legendFormat": "{{vendor}} / {{transport}}", "refId": "A"}
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Router decision latency — p50 / p99",
      "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8},
      "targets": [
        {"expr": "histogram_quantile(0.5, sum by (le) (rate(oya_foundry_providers_router_decision_latency_ms_bucket{tenant=\"$tenant\"}[5m])))", "legendFormat": "p50", "refId": "A"},
        {"expr": "histogram_quantile(0.99, sum by (le) (rate(oya_foundry_providers_router_decision_latency_ms_bucket{tenant=\"$tenant\"}[5m])))", "legendFormat": "p99", "refId": "B"}
      ],
      "alert": {
        "name": "router-decision-p99-breach",
        "conditions": [
          {"evaluator": {"params": [5], "type": "gt"}, "query": {"params": ["B", "5m", "now"]}, "type": "query"}
        ],
        "notifications": [{"uid": "grafana-oncall"}]
      }
    },
    {
      "id": 6,
      "type": "table",
      "title": "Tool-call proposals (vendor-emitted; not yet executed)",
      "gridPos": {"x": 12, "y": 16, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum by (vendor, tool_name) (rate(oya_foundry_providers_tool_call_proposed_total{tenant=\"$tenant\"}[1h]))", "format": "table", "refId": "A"}
      ]
    }
  ]
}
