{
  "$schema": "https://schemas.grafana.com/dashboard.json",
  "_meta": {
    "doc_class": "GrafanaDashboard",
    "microservice": "foundry-eval",
    "owner_team": "axis-foundry + ops-sre-reliability",
    "audience": "axis-foundry + ops-sre",
    "tenant_scoped": false,
    "datasource": "Mimir self-observability + ClickHouse replay_divergence"
  },
  "uid": "fe-replay-determinism",
  "title": "Replay Determinism (divergence ≤ 100ms tolerance per ADR-0024)",
  "tags": ["foundry-eval", "replay", "determinism"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-24h", "to": "now"},
  "templating": {
    "list": [
      {
        "name": "pack",
        "type": "custom",
        "options": [
          {"text": "pack-kr", "value": "kr", "selected": true},
          {"text": "pack-eu", "value": "eu"},
          {"text": "pack-us", "value": "us"},
          {"text": "pack-us-healthcare", "value": "us-hc"}
        ],
        "label": "Pack"
      },
      {
        "name": "capability",
        "type": "query",
        "query": "SELECT DISTINCT capability_id FROM replay_divergence WHERE pack='$pack'",
        "label": "Capability"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Replay-determinism divergence (ms) — p50 / p99 / p999",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum by (le) (rate(oya_foundry_eval_replay_divergence_ms_bucket{pack=\"$pack\",capability=\"$capability\"}[5m])))", "legendFormat": "p50", "refId": "A"},
        {"expr": "histogram_quantile(0.99, sum by (le) (rate(oya_foundry_eval_replay_divergence_ms_bucket{pack=\"$pack\",capability=\"$capability\"}[5m])))", "legendFormat": "p99", "refId": "B"},
        {"expr": "histogram_quantile(0.999, sum by (le) (rate(oya_foundry_eval_replay_divergence_ms_bucket{pack=\"$pack\",capability=\"$capability\"}[5m])))", "legendFormat": "p999", "refId": "C"}
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              {"color": "green", "value": null},
              {"color": "orange", "value": 50},
              {"color": "red", "value": 100}
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Capabilities currently breaching 100ms tolerance",
      "gridPos": {"x": 0, "y": 8, "w": 6, "h": 4},
      "targets": [
        {"expr": "count(oya_foundry_eval_replay_divergence_ms{pack=\"$pack\",quantile=\"0.99\"} > 100)", "refId": "A"}
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Held model upgrades (replay-gate)",
      "gridPos": {"x": 6, "y": 8, "w": 6, "h": 4},
      "targets": [
        {"expr": "count(oya_foundry_eval_model_upgrade_held{pack=\"$pack\",reason=\"replay_divergence\"})", "refId": "A"}
      ]
    },
    {
      "id": 4,
      "type": "table",
      "title": "Top divergent replay-samples (last 24h)",
      "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "topk(20, oya_foundry_eval_replay_divergence_ms{pack=\"$pack\"})",
          "format": "table",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Replay-engine alive + lag",
      "gridPos": {"x": 0, "y": 20, "w": 12, "h": 8},
      "targets": [
        {"expr": "oya_foundry_eval_replay_engine_alive{pack=\"$pack\"}", "legendFormat": "alive", "refId": "A"},
        {"expr": "time() - oya_foundry_eval_replay_last_sample_at{pack=\"$pack\"}", "legendFormat": "lag (s)", "refId": "B"}
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Per-subject-DEK shred rate (last 24h)",
      "gridPos": {"x": 0, "y": 28, "w": 6, "h": 4},
      "targets": [
        {"expr": "rate(oya_foundry_eval_subject_dek_shred_total{pack=\"$pack\"}[24h])", "refId": "A"}
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "DSR cascade SLA: % within 30d",
      "gridPos": {"x": 6, "y": 28, "w": 6, "h": 4},
      "targets": [
        {"expr": "oya_foundry_eval_dsr_cascade_sla_pct{pack=\"$pack\"}", "refId": "A"}
      ]
    }
  ]
}
