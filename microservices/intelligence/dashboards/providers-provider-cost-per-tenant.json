{
  "$schema": "https://schemas.grafana.com/dashboard.json",
  "_meta": {
    "doc_class": "GrafanaDashboard",
    "microservice": "foundry-providers",
    "owner_team": "ops-finops + axis-foundry",
    "related_artifacts": [
      "microservices/intelligence/cost-budget.md",
      "microservices/intelligence/runbooks/rate-limit-cascade-recovery.md"
    ],
    "audience": "tenant operators + ops-finops",
    "tenant_scoped": true,
    "datasource": "Mimir (per-pack)"
  },
  "uid": "fprov-cost-per-tenant",
  "title": "Provider Cost per Tenant",
  "tags": ["foundry-providers", "cost", "finops", "tenant-facing"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {"from": "now-30d", "to": "now"},
  "templating": {
    "list": [
      {"name": "tenant", "type": "query", "datasource": "Mimir", "query": "label_values(oya_foundry_providers_provider_cost_usd_total, tenant)", "label": "Tenant"}
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Cost — last 24h",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "sum(increase(oya_foundry_providers_provider_cost_usd_total{tenant=\"$tenant\"}[24h]))", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "currencyUSD"}}
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Cost — last 30d",
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "sum(increase(oya_foundry_providers_provider_cost_usd_total{tenant=\"$tenant\"}[30d]))", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "currencyUSD"}}
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Per-day ceiling — utilisation %",
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
      "targets": [
        {"expr": "100 * sum(increase(oya_foundry_providers_provider_cost_usd_total{tenant=\"$tenant\"}[1d])) / max(oya_foundry_providers_tenant_cost_ceiling_usd{tenant=\"$tenant\",window=\"1d\"})", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "percent", "thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 70}, {"color": "orange", "value": 90}, {"color": "red", "value": 100}]}}}
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Median cost per call (USD)",
      "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
      "targets": [
        {"expr": "histogram_quantile(0.5, sum by (le) (rate(oya_foundry_providers_provider_cost_usd_bucket{tenant=\"$tenant\"}[1h])))", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "currencyUSD"}}
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Cost over time — by vendor",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum by (vendor) (rate(oya_foundry_providers_provider_cost_usd_total{tenant=\"$tenant\"}[1h]) * 3600)", "legendFormat": "{{vendor}}", "refId": "A"}
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Tokens consumed per hour — by vendor",
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum by (vendor) (rate(oya_foundry_providers_provider_tokens_total{tenant=\"$tenant\"}[1h]) * 3600)", "legendFormat": "{{vendor}}", "refId": "A"}
      ]
    },
    {
      "id": 7,
      "type": "table",
      "title": "Cost by (vendor, model_id)",
      "gridPos": {"x": 0, "y": 12, "w": 24, "h": 8},
      "targets": [
        {"expr": "sum by (vendor, model_id) (increase(oya_foundry_providers_provider_cost_usd_total{tenant=\"$tenant\"}[7d]))", "format": "table", "refId": "A"}
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Cost-per-1K-tokens — by vendor",
      "gridPos": {"x": 0, "y": 20, "w": 24, "h": 8},
      "targets": [
        {"expr": "avg by (vendor) (oya_foundry_providers_provider_cost_per_1k_tokens_usd{tenant=\"$tenant\"})", "legendFormat": "{{vendor}}", "refId": "A"}
      ]
    }
  ]
}
