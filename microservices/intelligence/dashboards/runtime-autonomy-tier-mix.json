{
  "$schema": "https://schemas.grafana.com/dashboard.json",
  "_meta": {
    "doc_class": "GrafanaDashboard",
    "microservice": "foundry-runtime",
    "owner_team": "axis-foundry-runtime + ops-security + council-privacy",
    "related_artifacts": [
      "microservices/intelligence/policy/runtime-isolation.md",
      "microservices/intelligence/threat-model.md"
    ],
    "audience": "ops-security + council-privacy + axis-foundry-runtime",
    "tenant_scoped": true,
    "datasource": "Mimir (per-pack)"
  },
  "uid": "fr-autonomy-ceiling-mix",
  "title": "Foundry Runtime — Autonomy tier mix + violation surface",
  "tags": ["foundry-runtime", "autonomy", "security"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {"from": "now-7d", "to": "now"},
  "templating": {
    "list": [
      {
        "name": "tenant",
        "type": "query",
        "datasource": "Mimir",
        "query": "label_values(oya_foundry_runtime_invocations_total, tenant_id)",
        "refresh": 1,
        "label": "Tenant",
        "includeAll": true
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "piechart",
      "title": "Autonomy tier mix (7d) — $tenant",
      "gridPos": {"x": 0, "y": 0, "w": 8, "h": 8},
      "targets": [
        {"expr": "sum by (autonomy_level_used) (oya_foundry_runtime_invocations_total{tenant_id=~\"$tenant\"})", "legendFormat": "T{{autonomy_level_used}}", "refId": "A"}
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Autonomy ceiling (current)",
      "gridPos": {"x": 8, "y": 0, "w": 4, "h": 4},
      "targets": [
        {"expr": "max(oya_foundry_runtime_autonomy_ceiling{tenant_id=\"$tenant\"})", "refId": "A"}
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {"type": "value", "options": {"0": {"text": "T0 (read-only)", "color": "green"}, "1": {"text": "T1 (own-tenant)", "color": "green"}, "2": {"text": "T2 (tenant + audit)", "color": "yellow"}, "3": {"text": "T3 (tier-3)", "color": "orange"}, "4": {"text": "T4 (tier-4)", "color": "red"}}}
          ]
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Autonomy violations (last 24h)",
      "gridPos": {"x": 12, "y": 0, "w": 4, "h": 4},
      "targets": [
        {"expr": "sum(increase(oya_foundry_runtime_autonomy_violation_total{tenant_id=~\"$tenant\"}[24h]))", "refId": "A"}
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 1}, {"color": "red", "value": 10}]}
        }
      },
      "alert": {
        "name": "autonomy-violation-surge",
        "conditions": [
          {"evaluator": {"params": [10], "type": "gt"}, "query": {"params": ["A", "5m", "now"]}, "type": "query"}
        ],
        "notifications": [{"uid": "grafana-oncall"}]
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "regional AI-risk high-risk capability invocations (24h)",
      "gridPos": {"x": 16, "y": 0, "w": 4, "h": 4},
      "targets": [
        {"expr": "sum(increase(oya_foundry_runtime_invocations_total{tenant_id=~\"$tenant\",risk_class=\"high_risk_auto_decision\"}[24h]))", "refId": "A"}
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Ceiling-elevation events (24h; 2-person rule per ADR-0022)",
      "gridPos": {"x": 20, "y": 0, "w": 4, "h": 4},
      "targets": [
        {"expr": "sum(increase(oya_foundry_runtime_ceiling_elevated_total{tenant_id=~\"$tenant\"}[24h]))", "refId": "A"}
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Autonomy violations over time — by capability",
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum by (capability_id) (rate(oya_foundry_runtime_autonomy_violation_total{tenant_id=~\"$tenant\"}[5m]))", "legendFormat": "{{capability_id}}", "refId": "A"}
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Tier mix over time",
      "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum by (autonomy_level_used) (rate(oya_foundry_runtime_invocations_total{tenant_id=~\"$tenant\"}[5m]))", "legendFormat": "T{{autonomy_level_used}}", "refId": "A"}
      ]
    },
    {
      "id": 8,
      "type": "table",
      "title": "Recent autonomy violations",
      "gridPos": {"x": 0, "y": 16, "w": 24, "h": 8},
      "targets": [
        {"expr": "oya_foundry_runtime_autonomy_violation_total{tenant_id=~\"$tenant\"}", "format": "table", "instant": false, "refId": "A"}
      ]
    }
  ]
}
