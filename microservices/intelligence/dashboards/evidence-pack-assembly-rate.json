{
  "$schema": "https://schemas.grafana.com/dashboard.json",
  "_meta": {
    "doc_class": "GrafanaDashboard",
    "microservice": "foundry-evidence",
    "owner_team": "ops-sre-reliability + axis-foundry-evidence",
    "audience": "internal operators (cross-tenant view; admin-only RBAC + Cedar)",
    "tenant_scoped": false,
    "datasource": "Mimir (oya-self + oya-aggregate); foundry-evidence self-SLI series"
  },
  "uid": "foundry-evidence-pack-assembly-rate",
  "title": "Foundry-Evidence Pack Assembly Rate",
  "tags": ["foundry-evidence", "pack-assembly", "operator"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "templating": {
    "list": [
      {
        "name": "pack",
        "type": "custom",
        "options": [
          {"text": "pack-kr", "value": "pack-kr", "selected": true},
          {"text": "pack-eu", "value": "pack-eu"},
          {"text": "pack-us", "value": "pack-us"},
          {"text": "pack-us-healthcare", "value": "pack-us-healthcare"},
          {"text": "pack-jp", "value": "pack-jp"},
          {"text": "pack-sg", "value": "pack-sg"},
          {"text": "pack-au", "value": "pack-au"},
          {"text": "pack-in", "value": "pack-in"},
          {"text": "pack-br", "value": "pack-br"},
          {"text": "pack-ae", "value": "pack-ae"},
          {"text": "pack-ksa", "value": "pack-ksa"}
        ],
        "label": "Pack"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "record_invocation rate by source µservice",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "sum by (source_microservice) (rate(oya_foundry_evidence_record_invocation_total{pack=\"$pack\"}[1m]))",
          "legendFormat": "{{source_microservice}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "record_invocation p99 latency",
      "gridPos": {"x": 0, "y": 8, "w": 6, "h": 4},
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(oya_foundry_evidence_record_invocation_duration_seconds_bucket{pack=\"$pack\"}[5m])))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 0.3}, {"color": "red", "value": 0.5}]}
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Pack assembly success rate (5m)",
      "gridPos": {"x": 6, "y": 8, "w": 6, "h": 4},
      "targets": [
        {
          "expr": "sum(rate(oya_foundry_evidence_pack_assembled_total{pack=\"$pack\"}[5m])) / (sum(rate(oya_foundry_evidence_pack_assembled_total{pack=\"$pack\"}[5m])) + sum(rate(oya_foundry_evidence_pack_assembly_failed_total{pack=\"$pack\"}[5m])))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {"steps": [{"color": "red", "value": 0}, {"color": "yellow", "value": 0.999}, {"color": "green", "value": 0.9999}]}
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Pack assembly latency p50/p99/p999",
      "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum by (le) (rate(oya_foundry_evidence_pack_assembly_duration_seconds_bucket{pack=\"$pack\"}[5m])))", "legendFormat": "p50", "refId": "A"},
        {"expr": "histogram_quantile(0.99, sum by (le) (rate(oya_foundry_evidence_pack_assembly_duration_seconds_bucket{pack=\"$pack\"}[5m])))", "legendFormat": "p99", "refId": "B"},
        {"expr": "histogram_quantile(0.999, sum by (le) (rate(oya_foundry_evidence_pack_assembly_duration_seconds_bucket{pack=\"$pack\"}[5m])))", "legendFormat": "p999", "refId": "C"}
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Pack assembly failures by class",
      "gridPos": {"x": 0, "y": 20, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "sum by (failure_class) (rate(oya_foundry_evidence_pack_assembly_failed_total{pack=\"$pack\"}[5m]))",
          "legendFormat": "{{failure_class}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Partial-pack rate (signals incomplete at seal time)",
      "gridPos": {"x": 0, "y": 28, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "sum by (missing_source) (rate(oya_foundry_evidence_pack_assembled_partial_total{pack=\"$pack\"}[5m]))",
          "legendFormat": "missing={{missing_source}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Late-signal rate (post-seal)",
      "gridPos": {"x": 0, "y": 36, "w": 6, "h": 4},
      "targets": [
        {"expr": "rate(oya_foundry_evidence_late_signal_total{pack=\"$pack\"}[5m])", "refId": "A"}
      ]
    },
    {
      "id": 8,
      "type": "stat",
      "title": "audit-chain bridge backlog depth (seconds)",
      "gridPos": {"x": 6, "y": 36, "w": 6, "h": 4},
      "targets": [
        {"expr": "oya_foundry_evidence_audit_chain_emit_backlog_depth_seconds{pack=\"$pack\"}", "refId": "A"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 60}, {"color": "red", "value": 600}]}
        }
      },
      "alert": {
        "name": "audit-chain-bridge-backlog-high",
        "conditions": [{"evaluator": {"params": [600], "type": "gt"}, "query": {"params": ["A", "5m", "now"]}, "type": "query"}],
        "notifications": [{"uid": "grafana-oncall"}]
      }
    }
  ]
}
