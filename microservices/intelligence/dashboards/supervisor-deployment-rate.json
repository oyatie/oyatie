{
  "$schema": "https://schemas.grafana.com/dashboard.json",
  "_meta": {
    "doc_class": "GrafanaDashboard",
    "microservice": "foundry-supervisor",
    "owner_team": "ops-sre-reliability + axis-foundry-control-plane",
    "audience": "internal operators (cross-tenant view; behind admin-only RBAC + Cedar)",
    "tenant_scoped": false,
    "datasource": "per-pack Mimir endpoints"
  },
  "uid": "fnd-sup-deployment-rate",
  "title": "Capability Deployment Rate (cross-tenant)",
  "tags": ["foundry-supervisor", "operator", "deployment"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-24h", "to": "now"},
  "templating": {
    "list": [
      {
        "name": "pack",
        "type": "custom",
        "options": [
          {"text": "pack-kr", "value": "kr", "selected": true},
          {"text": "pack-eu", "value": "eu"},
          {"text": "pack-us", "value": "us"},
          {"text": "pack-us-healthcare", "value": "us-hc"},
          {"text": "pack-jp", "value": "jp"},
          {"text": "pack-sg", "value": "sg"},
          {"text": "pack-au", "value": "au"},
          {"text": "pack-in", "value": "in"},
          {"text": "pack-br", "value": "br"},
          {"text": "pack-ae", "value": "ae"},
          {"text": "pack-ksa", "value": "ksa"}
        ],
        "label": "Pack"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Capabilities deployed (last 24h)",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "targets": [
        {"expr": "sum(increase(oya_supervisor_capability_deployed_total{pack=\"$pack\"}[24h]))", "legendFormat": "total", "refId": "A"}
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Deployments rolled-out / rolled-back (24h)",
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
      "targets": [
        {"expr": "sum(increase(oya_supervisor_deployment_phase_transitions_total{pack=\"$pack\",to_phase=\"rolled-out\"}[24h]))", "legendFormat": "rolled-out", "refId": "A"},
        {"expr": "sum(increase(oya_supervisor_deployment_phase_transitions_total{pack=\"$pack\",to_phase=\"rolled-back\"}[24h]))", "legendFormat": "rolled-back", "refId": "B"}
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Admit → 100% rollout latency (p50 / p99 / p999)",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum(rate(oya_supervisor_deployment_full_rollout_seconds_bucket{pack=\"$pack\"}[5m])) by (le))", "legendFormat": "p50", "refId": "A"},
        {"expr": "histogram_quantile(0.99, sum(rate(oya_supervisor_deployment_full_rollout_seconds_bucket{pack=\"$pack\"}[5m])) by (le))", "legendFormat": "p99", "refId": "B"},
        {"expr": "histogram_quantile(0.999, sum(rate(oya_supervisor_deployment_full_rollout_seconds_bucket{pack=\"$pack\"}[5m])) by (le))", "legendFormat": "p999", "refId": "C"}
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Rollouts paused (held by observability EligibilityChanged held verdict)",
      "gridPos": {"x": 0, "y": 12, "w": 12, "h": 6},
      "targets": [
        {"expr": "sum(rate(oya_supervisor_deployment_phase_transitions_total{pack=\"$pack\",to_phase=\"held\"}[5m])) by (capability_id)", "legendFormat": "{{capability_id}}", "refId": "A"}
      ]
    },
    {
      "id": 5,
      "type": "table",
      "title": "Deployments currently in HELD or stuck > 15 min",
      "gridPos": {"x": 0, "y": 18, "w": 12, "h": 6},
      "targets": [
        {"expr": "oya_supervisor_deployment_phase_age_seconds{pack=\"$pack\",phase=~\"canary.*|held\"} > 900", "format": "table", "refId": "A"}
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Admit-loop schema-rejection rate",
      "gridPos": {"x": 0, "y": 24, "w": 12, "h": 6},
      "targets": [
        {"expr": "sum(rate(oya_supervisor_admit_schema_rejection_total{pack=\"$pack\"}[5m])) by (tenant)", "legendFormat": "{{tenant}}", "refId": "A"}
      ]
    }
  ]
}
