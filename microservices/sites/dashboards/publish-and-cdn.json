{
  "$schema": "https://schemas.grafana.com/dashboard.json",
  "_meta": {
    "doc_class": "GrafanaDashboard",
    "microservice": "sites",
    "owner_team": "axis-sites + ops-sre-reliability",
    "audience": "tenant operator + axis-sites SRE",
    "tenant_scoped": true,
    "datasource": "per-pack Mimir; tenant-scoped via X-Scope-OrgID"
  },
  "uid": "sites-publish-and-cdn",
  "title": "sites: publish pipeline + CDN delivery",
  "tags": ["sites", "publish", "cdn", "burn-rate"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "templating": {
    "list": [
      {"name": "pack", "type": "custom", "label": "Pack",
        "options": [
          {"text": "pack-kr", "value": "kr", "selected": true},
          {"text": "pack-eu", "value": "eu"},
          {"text": "pack-us", "value": "us"},
          {"text": "pack-us-healthcare", "value": "us-hc"},
          {"text": "pack-jp", "value": "jp"},
          {"text": "pack-sg", "value": "sg"},
          {"text": "pack-au", "value": "au"},
          {"text": "pack-in", "value": "in"},
          {"text": "pack-br", "value": "br"},
          {"text": "pack-ae", "value": "ae"},
          {"text": "pack-ksa", "value": "ksa"}
        ]},
      {"name": "tenant", "type": "query", "label": "Tenant",
        "query": "label_values(oya_sites_page_render_total{pack=\"$pack\"}, tenant_id)"}
    ]
  },
  "panels": [
    {"id": 1, "type": "stat", "title": "Publishes/min",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "sum(rate(oya_sites_publish_succeeded_total{pack=\"$pack\",tenant_id=\"$tenant\"}[1m]))", "refId": "A"}]},

    {"id": 2, "type": "stat", "title": "Publish p95 (s)",
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(oya_sites_publish_duration_seconds_bucket{pack=\"$pack\",tenant_id=\"$tenant\"}[5m])))", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"mode": "absolute", "steps": [{"value": null, "color": "green"}, {"value": 5, "color": "yellow"}, {"value": 10, "color": "red"}]}}}},

    {"id": 3, "type": "stat", "title": "CDN cache hit ratio",
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "sum(rate(oya_sites_cdn_cache_hit_total{pack=\"$pack\",tenant_id=\"$tenant\"}[5m])) / sum(rate(oya_sites_cdn_request_total{pack=\"$pack\",tenant_id=\"$tenant\"}[5m]))", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "thresholds": {"mode": "absolute", "steps": [{"value": null, "color": "red"}, {"value": 0.6, "color": "yellow"}, {"value": 0.8, "color": "green"}]}}}},

    {"id": 4, "type": "stat", "title": "Page-render p95 (s)",
      "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(oya_sites_page_render_seconds_bucket{pack=\"$pack\",tenant_id=\"$tenant\"}[5m])))", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"mode": "absolute", "steps": [{"value": null, "color": "green"}, {"value": 0.2, "color": "yellow"}, {"value": 0.4, "color": "red"}]}}}},

    {"id": 5, "type": "timeseries", "title": "Publish-pipeline duration p50/p95/p99",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum by (le) (rate(oya_sites_publish_duration_seconds_bucket{pack=\"$pack\",tenant_id=\"$tenant\"}[5m])))", "legendFormat": "p50", "refId": "A"},
        {"expr": "histogram_quantile(0.95, sum by (le) (rate(oya_sites_publish_duration_seconds_bucket{pack=\"$pack\",tenant_id=\"$tenant\"}[5m])))", "legendFormat": "p95", "refId": "B"},
        {"expr": "histogram_quantile(0.99, sum by (le) (rate(oya_sites_publish_duration_seconds_bucket{pack=\"$pack\",tenant_id=\"$tenant\"}[5m])))", "legendFormat": "p99", "refId": "C"}
      ]},

    {"id": 6, "type": "timeseries", "title": "CDN cache hit ratio (per-route top 10)",
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
      "targets": [
        {"expr": "topk(10, sum by (route) (rate(oya_sites_cdn_cache_hit_total{pack=\"$pack\",tenant_id=\"$tenant\"}[5m])) / sum by (route) (rate(oya_sites_cdn_request_total{pack=\"$pack\",tenant_id=\"$tenant\"}[5m])))", "legendFormat": "{{route}}", "refId": "A"}
      ]},

    {"id": 7, "type": "timeseries", "title": "CDN invalidation events",
      "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum(rate(oya_sites_cdn_invalidation_succeeded_total{pack=\"$pack\",tenant_id=\"$tenant\"}[5m]))", "legendFormat": "succeeded", "refId": "A"},
        {"expr": "sum(rate(oya_sites_cdn_invalidation_failed_total{pack=\"$pack\",tenant_id=\"$tenant\"}[5m]))", "legendFormat": "failed", "refId": "B"}
      ]},

    {"id": 8, "type": "timeseries", "title": "Origin request rate (cache misses)",
      "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum(rate(oya_sites_cdn_origin_request_total{pack=\"$pack\",tenant_id=\"$tenant\"}[5m]))", "legendFormat": "origin RPS", "refId": "A"}
      ]},

    {"id": 9, "type": "table", "title": "Top-10 tenants by publish QPS (last 1h)",
      "gridPos": {"x": 0, "y": 20, "w": 24, "h": 8},
      "targets": [
        {"expr": "topk(10, sum by (tenant_id) (rate(oya_sites_publish_succeeded_total{pack=\"$pack\"}[1h])))", "format": "table", "refId": "A"}
      ]}
  ],
  "annotations": {
    "list": [
      {"name": "rollouts", "datasource": "argo-rollouts", "iconColor": "blue", "query": "{microservice=\"sites\"}"},
      {"name": "policy-changes", "datasource": "prometheus", "iconColor": "purple", "expr": "changes(oya_sites_policy_version[1h]) > 0"}
    ]
  }
}
