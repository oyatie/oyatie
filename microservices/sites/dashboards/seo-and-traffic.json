{
  "$schema": "https://schemas.grafana.com/dashboard.json",
  "_meta": {
    "doc_class": "GrafanaDashboard",
    "microservice": "sites",
    "owner_team": "axis-sites + axis-observability",
    "audience": "tenant operator + axis-sites SRE",
    "tenant_scoped": true,
    "datasource": "per-pack Mimir; tenant-scoped via X-Scope-OrgID"
  },
  "uid": "sites-seo-and-traffic",
  "title": "sites: SEO + traffic + accessibility",
  "tags": ["sites", "seo", "traffic", "wcag"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {"from": "now-24h", "to": "now"},
  "templating": {
    "list": [
      {"name": "pack", "type": "custom", "label": "Pack",
        "options": [
          {"text": "pack-kr", "value": "kr", "selected": true},
          {"text": "pack-eu", "value": "eu"},
          {"text": "pack-us", "value": "us"},
          {"text": "pack-us-healthcare", "value": "us-hc"}
        ]},
      {"name": "tenant", "type": "query", "label": "Tenant",
        "query": "label_values(oya_sites_page_render_total{pack=\"$pack\"}, tenant_id)"}
    ]
  },
  "panels": [
    {"id": 1, "type": "stat", "title": "Pageviews / 24h (anonymous)",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "sum(increase(oya_sites_analytics_pageview_total{pack=\"$pack\",tenant_id=\"$tenant\"}[24h]))", "refId": "A"}]},

    {"id": 2, "type": "stat", "title": "Unique sessions / 24h (hashed)",
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "count(count by (session_hash) (oya_sites_analytics_session_total{pack=\"$pack\",tenant_id=\"$tenant\"}))", "refId": "A"}]},

    {"id": 3, "type": "stat", "title": "WCAG 2.2 AA correctness ratio",
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "avg(oya_sites_wcag_aa_correctness_score{pack=\"$pack\",tenant_id=\"$tenant\"})", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "thresholds": {"mode": "absolute", "steps": [{"value": null, "color": "red"}, {"value": 0.95, "color": "yellow"}, {"value": 1.0, "color": "green"}]}}}},

    {"id": 4, "type": "stat", "title": "SEO meta correctness ratio",
      "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "avg(oya_sites_seo_meta_correctness_score{pack=\"$pack\",tenant_id=\"$tenant\"})", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "thresholds": {"mode": "absolute", "steps": [{"value": null, "color": "red"}, {"value": 0.95, "color": "yellow"}, {"value": 1.0, "color": "green"}]}}}},

    {"id": 5, "type": "timeseries", "title": "Pageviews per hour (last 24h)",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum(rate(oya_sites_analytics_pageview_total{pack=\"$pack\",tenant_id=\"$tenant\"}[1h]))", "legendFormat": "RPS", "refId": "A"}
      ]},

    {"id": 6, "type": "timeseries", "title": "Top-10 pages by view (last 24h)",
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
      "targets": [
        {"expr": "topk(10, sum by (route) (rate(oya_sites_analytics_pageview_total{pack=\"$pack\",tenant_id=\"$tenant\"}[1h])))", "legendFormat": "{{route}}", "refId": "A"}
      ]},

    {"id": 7, "type": "timeseries", "title": "Referrer mix (top 10)",
      "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
      "targets": [
        {"expr": "topk(10, sum by (referrer_class) (rate(oya_sites_analytics_pageview_total{pack=\"$pack\",tenant_id=\"$tenant\"}[1h])))", "legendFormat": "{{referrer_class}}", "refId": "A"}
      ]},

    {"id": 8, "type": "timeseries", "title": "Site-search query QPS + p95",
      "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum(rate(oya_sites_search_query_total{pack=\"$pack\",tenant_id=\"$tenant\"}[5m]))", "legendFormat": "QPS", "refId": "A"},
        {"expr": "histogram_quantile(0.95, sum by (le) (rate(oya_sites_search_query_seconds_bucket{pack=\"$pack\",tenant_id=\"$tenant\"}[5m])))", "legendFormat": "p95 (s)", "refId": "B"}
      ]},

    {"id": 9, "type": "timeseries", "title": "Sitemap regenerations + robots.txt edits",
      "gridPos": {"x": 0, "y": 20, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum(rate(oya_sites_sitemap_regenerated_total{pack=\"$pack\",tenant_id=\"$tenant\"}[1h]))", "legendFormat": "sitemap regen", "refId": "A"},
        {"expr": "sum(rate(oya_sites_robots_emitted_total{pack=\"$pack\",tenant_id=\"$tenant\"}[1h]))", "legendFormat": "robots.txt emit", "refId": "B"}
      ]},

    {"id": 10, "type": "timeseries", "title": "WCAG 2.2 AA correctness over time (per-page average)",
      "gridPos": {"x": 12, "y": 20, "w": 12, "h": 8},
      "targets": [
        {"expr": "avg(oya_sites_wcag_aa_correctness_score{pack=\"$pack\",tenant_id=\"$tenant\"})", "legendFormat": "ratio", "refId": "A"}
      ]}
  ]
}
