    },
    {
      "name": "sites-acme-renew-latency",
      "target": "0.95",
      "sli": "histogram_quantile(0.95, sum(rate(oya_sites_acme_renewal_duration_seconds_bucket[5m])) by (le))",
      "file": "microservices/sites/slos/acme-renew-latency.openslo.yaml"
    },
    {
      "name": "sites-cms-query-latency",
      "target": "0.99",
