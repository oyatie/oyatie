    {
      "name": "sites-site-search-latency",
      "target": "0.99",
      "sli": "histogram_quantile(0.95, sum(rate(oya_sites_search_query_seconds_bucket[5m])) by (le))",
      "file": "microservices/sites/slos/site-search-latency.openslo.yaml"
    },
    {
      "name": "sites-static-asset-latency",
      "target": "0.999",
