      "name": "search",
      "description": "Bounded context 'search' within sites (data plane)",
      "crates": [
        "oya-sites-search-adapter-meilisearch"
      ]
    },
    {
      "name": "site",
      "description": "Bounded context 'site' within sites (data plane)",
      "crates": [
        "oya-sites-site-app",
        "oya-sites-site-kernel"
      ]
    }
  ],
