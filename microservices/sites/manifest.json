    {
      "name": "sites-seo-meta-correctness",
      "target": "1.0",
      "sli": "sum(rate(oya_sites_seo_meta_validation_total{result=\"passed\"}[5m]))",
      "file": "microservices/sites/slos/seo-meta-correctness.openslo.yaml"
