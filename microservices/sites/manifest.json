        "oya-sites-domain-binding-adapter-acme",
        "oya-sites-domain-binding-adapter-cert-manager",
        "oya-sites-domain-binding-app"
      ]
    },
    {
      "name": "page",
      "description": "Bounded context 'page' within sites (data plane)",
