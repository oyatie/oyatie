  "owner": "axis-sites",
  "bounded_contexts": [
    {
      "name": "block",
      "description": "Bounded context 'block' within sites (data plane)",
      "crates": [
        "oya-sites-block-adapter-loro"
      ]
    },
    {
      "name": "cdn-delivery",
      "description": "Bounded context 'cdn-delivery' within sites (control plane)",
      "crates": [
        "oya-sites-cdn-delivery-adapter-cloudflare-cdn-stub",
        "oya-sites-cdn-delivery-adapter-libvips",
        "oya-sites-cdn-delivery-adapter-pandoc",
        "oya-sites-cdn-delivery-adapter-s3",
        "oya-sites-cdn-delivery-app"
      ]
    },
    {
      "name": "cms-collection",
      "description": "Bounded context 'cms-collection' within sites (data plane)",
      "crates": [
        "oya-sites-cms-collection-adapter-postgres"
      ]
    },
    {
      "name": "domain-binding",
      "description": "Bounded context 'domain-binding' within sites (control plane)",
