{
  "$schema": "https://schemas.grafana.com/dashboard.json",
  "_meta": {
    "doc_class": "GrafanaDashboard",
    "microservice": "shorts",
    "owner_team": "axis-shorts + ops-security + council-privacy + ops-legal",
    "audience": "tenant operator + moderator + compliance-officer + ops-legal",
    "tenant_scoped": true,
    "datasource": "per-pack Mimir; tenant-scoped via X-Scope-OrgID"
  },
  "uid": "shorts-moderation-and-safety",
  "title": "shorts: moderation + safety + copyright + minor-protection",
  "tags": ["shorts", "moderation", "dmca", "minor-protection", "eu-ai-act", "eu-dsa"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-24h", "to": "now"},
  "templating": {
    "list": [
      {"name": "pack", "type": "custom", "label": "Pack",
        "options": [
          {"text": "pack-kr", "value": "kr", "selected": true},
          {"text": "pack-eu", "value": "eu"},
          {"text": "pack-us", "value": "us"},
          {"text": "pack-us-healthcare", "value": "us-hc"},
          {"text": "pack-jp", "value": "jp"},
          {"text": "pack-sg", "value": "sg"},
          {"text": "pack-au", "value": "au"},
          {"text": "pack-in", "value": "in"},
          {"text": "pack-br", "value": "br"},
          {"text": "pack-ae", "value": "ae"},
          {"text": "pack-ksa", "value": "ksa"}
        ]},
      {"name": "tenant", "type": "query", "label": "Tenant",
        "query": "label_values(oya_shorts_moderation_verdict_total{pack=\"$pack\"}, tenant_id)"}
    ]
  },
  "panels": [
    {"id": 1, "type": "stat", "title": "Moderation verdicts/sec",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "sum(rate(oya_shorts_moderation_verdict_total{pack=\"$pack\",tenant_id=\"$tenant\"}[5m]))", "refId": "A"}]},

    {"id": 2, "type": "stat", "title": "Classifier latency p99 (s)",
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "histogram_quantile(0.99, sum by (le) (rate(oya_shorts_moderation_classifier_duration_seconds_bucket{pack=\"$pack\"}[5m])))", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"mode": "absolute", "steps": [{"value": null, "color": "green"}, {"value": 1, "color": "yellow"}, {"value": 2, "color": "red"}]}}}},

    {"id": 3, "type": "stat", "title": "Auto-hide rate (per 1k videos)",
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "1000 * sum(rate(oya_shorts_moderation_action_taken_total{action=\"auto_hide\",pack=\"$pack\",tenant_id=\"$tenant\"}[1h])) / sum(rate(oya_shorts_video_published_total{pack=\"$pack\",tenant_id=\"$tenant\"}[1h]))", "refId": "A"}]},

    {"id": 4, "type": "stat", "title": "Appeal SLA compliance (≤ 7d resolution)",
      "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "sum(rate(oya_shorts_appeal_resolved_within_sla_total{pack=\"$pack\",tenant_id=\"$tenant\"}[7d])) / sum(rate(oya_shorts_appeal_resolved_total{pack=\"$pack\",tenant_id=\"$tenant\"}[7d]))", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "thresholds": {"mode": "absolute", "steps": [{"value": null, "color": "red"}, {"value": 0.95, "color": "yellow"}, {"value": 0.99, "color": "green"}]}}}},

    {"id": 5, "type": "timeseries", "title": "Moderation verdict breakdown",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum by (verdict) (rate(oya_shorts_moderation_verdict_total{pack=\"$pack\",tenant_id=\"$tenant\"}[5m]))", "legendFormat": "{{verdict}}", "refId": "A"}
      ]},

    {"id": 6, "type": "timeseries", "title": "Classifier drift (rate vs 24h baseline)",
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum(rate(oya_shorts_moderation_verdict_total{verdict=~\"nsfw|violence|harassment|csam_suspect|minor_protection_concern\",pack=\"$pack\"}[15m])) / sum(rate(oya_shorts_moderation_verdict_total{verdict=~\"nsfw|violence|harassment|csam_suspect|minor_protection_concern\",pack=\"$pack\"}[24h]))", "legendFormat": "drift ratio", "refId": "A"}
      ]},

    {"id": 7, "type": "timeseries", "title": "DMCA copyright claims + counter-notices",
      "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum(rate(oya_shorts_copyright_claim_filed_total{pack=\"$pack\",tenant_id=\"$tenant\"}[5m]))", "legendFormat": "claims", "refId": "A"},
        {"expr": "sum(rate(oya_shorts_counter_notice_filed_total{pack=\"$pack\",tenant_id=\"$tenant\"}[5m]))", "legendFormat": "counter-notices", "refId": "B"},
        {"expr": "sum(rate(oya_shorts_dmca_takedown_executed_total{pack=\"$pack\",tenant_id=\"$tenant\"}[5m]))", "legendFormat": "takedowns", "refId": "C"}
      ]},

    {"id": 8, "type": "timeseries", "title": "Repeat-infringer strikes",
      "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum by (policy_action) (rate(oya_shorts_repeat_infringer_flagged_total{pack=\"$pack\",tenant_id=\"$tenant\"}[24h]))", "legendFormat": "{{policy_action}}", "refId": "A"}
      ]},

    {"id": 9, "type": "timeseries", "title": "Age-gate + parental-link establishment",
      "gridPos": {"x": 0, "y": 20, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum(rate(oya_shorts_age_attestation_total{pack=\"$pack\",is_minor=\"true\"}[5m]))", "legendFormat": "minor attestations", "refId": "A"},
        {"expr": "sum(rate(oya_shorts_parental_link_established_total{pack=\"$pack\"}[5m]))", "legendFormat": "parental links", "refId": "B"}
      ]},

    {"id": 10, "type": "stat", "title": "Minor-protection bypass attempts (Sev-1 trigger)",
      "gridPos": {"x": 12, "y": 20, "w": 6, "h": 4},
      "targets": [{"expr": "sum(increase(oya_shorts_minor_protection_bypass_attempt_total{pack=\"$pack\"}[24h]))", "refId": "A"}],
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"value": null, "color": "green"}, {"value": 1, "color": "red"}]}}}},

    {"id": 11, "type": "stat", "title": "Cross-context routing attempts",
      "gridPos": {"x": 18, "y": 20, "w": 6, "h": 4},
      "targets": [{"expr": "sum(increase(oya_shorts_dual_context_denied_total{pack=\"$pack\"}[24h]))", "refId": "A"}],
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"value": null, "color": "green"}, {"value": 1, "color": "red"}]}}}},

    {"id": 12, "type": "stat", "title": "Personal-tier federation attempts",
      "gridPos": {"x": 12, "y": 24, "w": 6, "h": 4},
      "targets": [{"expr": "sum(increase(oya_shorts_personal_tier_federation_attempt_total{pack=\"$pack\"}[24h]))", "refId": "A"}],
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"value": null, "color": "green"}, {"value": 1, "color": "red"}]}}}},

    {"id": 13, "type": "stat", "title": "Pack residency violations",
      "gridPos": {"x": 18, "y": 24, "w": 6, "h": 4},
      "targets": [{"expr": "sum(increase(oya_shorts_pack_residency_violation_total{pack=\"$pack\"}[24h]))", "refId": "A"}],
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"value": null, "color": "green"}, {"value": 1, "color": "red"}]}}}},

    {"id": 14, "type": "table", "title": "Top 10 abusing claimants (false-positive rate > 5%)",
      "gridPos": {"x": 0, "y": 28, "w": 24, "h": 8},
      "targets": [{"expr": "topk(10, (sum by (claimant_ref) (rate(oya_shorts_copyright_claim_false_positive_total{pack=\"$pack\"}[7d])) / sum by (claimant_ref) (rate(oya_shorts_copyright_claim_filed_total{pack=\"$pack\"}[7d]))))", "format": "table", "refId": "A"}]}
  ]
}
