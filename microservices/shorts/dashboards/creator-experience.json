{
  "$schema": "https://schemas.grafana.com/dashboard.json",
  "_meta": {
    "doc_class": "GrafanaDashboard",
    "microservice": "shorts",
    "owner_team": "axis-shorts + gtm-customer-success",
    "audience": "tenant operator + creator (own data only)",
    "tenant_scoped": true,
    "datasource": "per-pack Mimir; tenant-scoped via X-Scope-OrgID; k-anonymity ≥ 10 enforced on audience slices"
  },
  "uid": "shorts-creator-experience",
  "title": "shorts: creator experience (analytics + posting cadence + audience growth)",
  "tags": ["shorts", "creator-analytics", "audience"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "60s",
  "time": {"from": "now-30d", "to": "now"},
  "templating": {
    "list": [
      {"name": "pack", "type": "custom", "label": "Pack",
        "options": [
          {"text": "pack-kr", "value": "kr", "selected": true},
          {"text": "pack-eu", "value": "eu"},
          {"text": "pack-us", "value": "us"},
          {"text": "pack-us-healthcare", "value": "us-hc"},
          {"text": "pack-jp", "value": "jp"},
          {"text": "pack-sg", "value": "sg"},
          {"text": "pack-au", "value": "au"},
          {"text": "pack-in", "value": "in"},
          {"text": "pack-br", "value": "br"},
          {"text": "pack-ae", "value": "ae"},
          {"text": "pack-ksa", "value": "ksa"}
        ]},
      {"name": "creator", "type": "query", "label": "Creator (self-scoped via Cedar)",
        "query": "label_values(oya_shorts_video_published_total{pack=\"$pack\"}, creator_ref)"}
    ]
  },
  "panels": [
    {"id": 1, "type": "stat", "title": "Total views (30d)",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "sum(increase(oya_shorts_video_view_total{pack=\"$pack\",creator_ref=\"$creator\"}[30d]))", "refId": "A"}]},

    {"id": 2, "type": "stat", "title": "Total likes (30d)",
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "sum(increase(oya_shorts_like_added_total{pack=\"$pack\",creator_ref=\"$creator\"}[30d]))", "refId": "A"}]},

    {"id": 3, "type": "stat", "title": "Total comments (30d)",
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "sum(increase(oya_shorts_comment_published_total{pack=\"$pack\",creator_ref=\"$creator\"}[30d]))", "refId": "A"}]},

    {"id": 4, "type": "stat", "title": "Total shares (30d)",
      "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "sum(increase(oya_shorts_share_emitted_total{pack=\"$pack\",creator_ref=\"$creator\"}[30d]))", "refId": "A"}]},

    {"id": 5, "type": "timeseries", "title": "Daily videos published",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum(increase(oya_shorts_video_published_total{pack=\"$pack\",creator_ref=\"$creator\"}[1d]))", "legendFormat": "videos published", "refId": "A"}
      ]},

    {"id": 6, "type": "timeseries", "title": "Follower growth",
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
      "targets": [
        {"expr": "oya_shorts_creator_follower_count{pack=\"$pack\",creator_ref=\"$creator\"}", "legendFormat": "followers", "refId": "A"}
      ]},

    {"id": 7, "type": "timeseries", "title": "Watch-time completion ratio (per video; aggregated)",
      "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
      "targets": [
        {"expr": "avg by (video_id) (oya_shorts_watch_completion_ratio{pack=\"$pack\",creator_ref=\"$creator\"})", "legendFormat": "{{video_id}}", "refId": "A"}
      ]},

    {"id": 8, "type": "timeseries", "title": "Average watch seconds per view",
      "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8},
      "targets": [
        {"expr": "avg(oya_shorts_average_watch_seconds_per_view{pack=\"$pack\",creator_ref=\"$creator\"})", "legendFormat": "avg watch sec", "refId": "A"}
      ]},

    {"id": 9, "type": "table", "title": "Audience slices (k-anonymity ≥ 10; slices below k suppressed)",
      "gridPos": {"x": 0, "y": 20, "w": 24, "h": 8},
      "targets": [
        {"expr": "oya_shorts_audience_slice_viewer_count{pack=\"$pack\",creator_ref=\"$creator\",suppressed=\"false\"}", "format": "table", "refId": "A"}
      ]},

    {"id": 10, "type": "timeseries", "title": "Posting cadence (videos / week)",
      "gridPos": {"x": 0, "y": 28, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum(increase(oya_shorts_video_published_total{pack=\"$pack\",creator_ref=\"$creator\"}[7d]))", "legendFormat": "weekly", "refId": "A"}
      ]},

    {"id": 11, "type": "timeseries", "title": "Top sound usage by creator",
      "gridPos": {"x": 12, "y": 28, "w": 12, "h": 8},
      "targets": [
        {"expr": "topk(5, sum by (sound_ref) (rate(oya_shorts_video_published_total{pack=\"$pack\",creator_ref=\"$creator\"}[7d])))", "legendFormat": "{{sound_ref}}", "refId": "A"}
      ]},

    {"id": 12, "type": "stat", "title": "Total stitches received (creator's videos clipped by others)",
      "gridPos": {"x": 0, "y": 36, "w": 6, "h": 4},
      "targets": [{"expr": "sum(increase(oya_shorts_stitch_created_total{source_creator_ref=\"$creator\",pack=\"$pack\"}[30d]))", "refId": "A"}]},

    {"id": 13, "type": "stat", "title": "Total duets received",
      "gridPos": {"x": 6, "y": 36, "w": 6, "h": 4},
      "targets": [{"expr": "sum(increase(oya_shorts_duet_created_total{source_creator_ref=\"$creator\",pack=\"$pack\"}[30d]))", "refId": "A"}]},

    {"id": 14, "type": "stat", "title": "Repeat-infringer strikes (own)",
      "gridPos": {"x": 12, "y": 36, "w": 6, "h": 4},
      "targets": [{"expr": "oya_shorts_creator_repeat_infringer_strike_count{creator_ref=\"$creator\",pack=\"$pack\"}", "refId": "A"}],
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"value": null, "color": "green"}, {"value": 1, "color": "yellow"}, {"value": 3, "color": "red"}]}}}},

    {"id": 15, "type": "stat", "title": "Active appeals (own)",
      "gridPos": {"x": 18, "y": 36, "w": 6, "h": 4},
      "targets": [{"expr": "sum(oya_shorts_appeal_open_count{creator_ref=\"$creator\",pack=\"$pack\"})", "refId": "A"}]}
  ]
}
