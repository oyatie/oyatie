{
  "$schema": "https://schemas.grafana.com/dashboard.json",
  "_meta": {
    "doc_class": "GrafanaDashboard",
    "microservice": "shorts",
    "owner_team": "axis-shorts + ops-sre-reliability",
    "audience": "tenant operator + axis-shorts SRE",
    "tenant_scoped": true,
    "datasource": "per-pack Mimir; tenant-scoped via X-Scope-OrgID"
  },
  "uid": "shorts-video-pipeline",
  "title": "shorts: video pipeline (upload + transcode + storage + delivery)",
  "tags": ["shorts", "video", "transcode", "cdn", "drm"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "templating": {
    "list": [
      {"name": "pack", "type": "custom", "label": "Pack",
        "options": [
          {"text": "pack-kr", "value": "kr", "selected": true},
          {"text": "pack-eu", "value": "eu"},
          {"text": "pack-us", "value": "us"},
          {"text": "pack-us-healthcare", "value": "us-hc"},
          {"text": "pack-jp", "value": "jp"},
          {"text": "pack-sg", "value": "sg"},
          {"text": "pack-au", "value": "au"},
          {"text": "pack-in", "value": "in"},
          {"text": "pack-br", "value": "br"},
          {"text": "pack-ae", "value": "ae"},
          {"text": "pack-ksa", "value": "ksa"}
        ]},
      {"name": "tenant", "type": "query", "label": "Tenant",
        "query": "label_values(oya_shorts_video_upload_total{pack=\"$pack\"}, tenant_id)"}
    ]
  },
  "panels": [
    {"id": 1, "type": "stat", "title": "Video-start p95 (s)",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(oya_shorts_video_start_duration_seconds_bucket{pack=\"$pack\",tenant_id=\"$tenant\"}[5m])))", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"mode": "absolute", "steps": [{"value": null, "color": "green"}, {"value": 0.3, "color": "yellow"}, {"value": 0.4, "color": "red"}]}}}},

    {"id": 2, "type": "stat", "title": "Feed-load p95 (s)",
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(oya_shorts_feed_render_duration_seconds_bucket{pack=\"$pack\",tenant_id=\"$tenant\"}[5m])))", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"mode": "absolute", "steps": [{"value": null, "color": "green"}, {"value": 0.2, "color": "yellow"}, {"value": 0.25, "color": "red"}]}}}},

    {"id": 3, "type": "stat", "title": "Uploads/sec (5m rate)",
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "sum(rate(oya_shorts_video_upload_total{pack=\"$pack\",tenant_id=\"$tenant\",result=\"success\"}[5m]))", "refId": "A"}]},

    {"id": 4, "type": "stat", "title": "Transcode queue depth",
      "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "sum(oya_shorts_transcode_queue_depth{pack=\"$pack\"})", "refId": "A"}],
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"value": null, "color": "green"}, {"value": 500, "color": "yellow"}, {"value": 1000, "color": "red"}]}}}},

    {"id": 5, "type": "timeseries", "title": "Transcode duration p95 by bitrate rung",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "targets": [
        {"expr": "histogram_quantile(0.95, sum by (le, rung) (rate(oya_shorts_transcode_duration_seconds_bucket{pack=\"$pack\"}[5m])))", "legendFormat": "{{rung}}", "refId": "A"}
      ]},

    {"id": 6, "type": "timeseries", "title": "CDN cache hit ratio (per region)",
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum by (pop_region) (rate(oya_shorts_cdn_cache_hit_total{pack=\"$pack\"}[5m])) / sum by (pop_region) (rate(oya_shorts_cdn_cache_request_total{pack=\"$pack\"}[5m]))", "legendFormat": "{{pop_region}}", "refId": "A"}
      ]},

    {"id": 7, "type": "timeseries", "title": "Upload + Transcode + Publish funnel",
      "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum(rate(oya_shorts_video_upload_total{pack=\"$pack\",tenant_id=\"$tenant\",result=\"success\"}[5m]))", "legendFormat": "upload", "refId": "A"},
        {"expr": "sum(rate(oya_shorts_transcode_complete_total{pack=\"$pack\",tenant_id=\"$tenant\"}[5m]))", "legendFormat": "transcode", "refId": "B"},
        {"expr": "sum(rate(oya_shorts_video_published_total{pack=\"$pack\",tenant_id=\"$tenant\"}[5m]))", "legendFormat": "publish", "refId": "C"}
      ]},

    {"id": 8, "type": "timeseries", "title": "ffmpeg worker pool utilization + errors",
      "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8},
      "targets": [
        {"expr": "avg(oya_shorts_transcode_worker_cpu_utilization{pack=\"$pack\"})", "legendFormat": "cpu util", "refId": "A"},
        {"expr": "sum(rate(oya_shorts_transcode_worker_error_total{pack=\"$pack\"}[5m]))", "legendFormat": "errors/sec", "refId": "B"}
      ]},

    {"id": 9, "type": "timeseries", "title": "Thumbnail-gen latency p95",
      "gridPos": {"x": 0, "y": 20, "w": 12, "h": 8},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(oya_shorts_thumbnail_gen_duration_seconds_bucket{pack=\"$pack\"}[5m])))", "legendFormat": "p95", "refId": "A"}]},

    {"id": 10, "type": "timeseries", "title": "Copyright fingerprint match latency p95 (Chromaprint + DCT)",
      "gridPos": {"x": 12, "y": 20, "w": 12, "h": 8},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(oya_shorts_fingerprint_match_duration_seconds_bucket{pack=\"$pack\"}[5m])))", "legendFormat": "p95", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"mode": "absolute", "steps": [{"value": null, "color": "green"}, {"value": 1.5, "color": "yellow"}, {"value": 2, "color": "red"}]}}}},

    {"id": 11, "type": "timeseries", "title": "DRM license issuance rate + latency p95",
      "gridPos": {"x": 0, "y": 28, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum by (key_system) (rate(oya_shorts_drm_license_issued_total{pack=\"$pack\"}[5m]))", "legendFormat": "rate {{key_system}}", "refId": "A"},
        {"expr": "histogram_quantile(0.95, sum by (le) (rate(oya_shorts_drm_license_duration_seconds_bucket{pack=\"$pack\"}[5m])))", "legendFormat": "p95", "refId": "B"}
      ]},

    {"id": 12, "type": "timeseries", "title": "Auto-caption generation rate + duration ratio (foundry-runtime ASR)",
      "gridPos": {"x": 12, "y": 28, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum(rate(oya_shorts_caption_generated_total{pack=\"$pack\"}[5m]))", "legendFormat": "rate", "refId": "A"},
        {"expr": "histogram_quantile(0.95, sum by (le) (rate(oya_shorts_caption_generation_video_duration_ratio_bucket{pack=\"$pack\"}[5m])))", "legendFormat": "p95 video-dur×", "refId": "B"}
      ]},

    {"id": 13, "type": "stat", "title": "Eligibility verdict",
      "gridPos": {"x": 0, "y": 36, "w": 6, "h": 4},
      "targets": [{"expr": "oya:current_verdict:by_microservice_env{microservice=\"shorts\",pack=\"$pack\",environment=\"production\"}", "refId": "A"}]},

    {"id": 14, "type": "stat", "title": "Burn-rate (fast 1h)",
      "gridPos": {"x": 6, "y": 36, "w": 6, "h": 4},
      "targets": [{"expr": "oya_promotion_burn_rate_fast_1h{microservice=\"shorts\",pack=\"$pack\",sli=\"video_start_availability\"}", "refId": "A"}],
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"value": null, "color": "green"}, {"value": 6, "color": "yellow"}, {"value": 14.4, "color": "red"}]}}}},

    {"id": 15, "type": "table", "title": "Top 10 video uploaders (uploads/sec)",
      "gridPos": {"x": 12, "y": 36, "w": 12, "h": 8},
      "targets": [{"expr": "topk(10, sum by (creator_ref) (rate(oya_shorts_video_upload_total{pack=\"$pack\",tenant_id=\"$tenant\"}[5m])))", "format": "table", "refId": "A"}]}
  ]
}
