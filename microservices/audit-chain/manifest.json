  "hyperscaler_inv_coverage": {
    "circuit_breaker": "INV-CIRCUIT-BREAKER-BULKHEAD → microservices/observability/iac/helm/observability/templates/hyperscaler-invariants-canonical-prometheusrule.yaml#OyaCapabilityCircuitOpen",
    "tenant_rate_limit": "INV-SHUFFLE-SHARDING → microservices/observability/iac/helm/observability/templates/hyperscaler-invariants-canonical-prometheusrule.yaml#OyaTenantRateLimit429Surge",
    "golden_signals": "INV-FOUR-GOLDEN-SIGNALS → microservices/observability/iac/helm/observability/templates/hyperscaler-invariants-canonical-prometheusrule.yaml#OyaSaturationCpuOver70pct",
    "error_budget_burn": "INV-SLO-ERROR-BUDGET → microservices/observability/iac/helm/observability/templates/hyperscaler-invariants-canonical-prometheusrule.yaml#OyaErrorBudgetFastBurn1h14x"
  },
  "audit_chain": {
    "enabled": true,
    "seal_events": [
      "oya.audit-chain.audit-emit",
      "oya.audit-chain.seal-mint",
      "oya.audit-chain.verify-merkle"
    ]
  },
  "secrets_substrate": {
    "provider": "openbao",
    "format": "${openbao:secret/<path>}"
  },
  "ontology_projections": [
    {
      "entity_name": "AuditEvent",
      "projection_target_table": "ontology_audit_events",
      "projection_kind": "idempotent-rewrite",
      "lag_budget_seconds": 60
    },
    {
      "entity_name": "AuditShard",
      "projection_target_table": "ontology_audit_shards",
      "projection_kind": "idempotent-rewrite",
      "lag_budget_seconds": 60
    }
  ],
  "mesh_layering": {
    "cilium_l4": true,
    "ambient_ztunnel": true,
    "ambient_waypoint": true,
    "north_south_only": false
  }
