    },
    {
      "name": "tasks-bulk-update-latency",
      "target": "0.99",
      "sli": "histogram_quantile(0.95, sum(rate(oya_tasks_bulk_update_seconds_bucket{batch_size=\"100\"}[5m])) by (le))",
      "file": "microservices/tasks/slos/bulk-update-latency.openslo.yaml"
    },
    {
      "name": "tasks-dependency-cycle-detection-correctness",
