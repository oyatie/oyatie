{
  "$schema": "https://docs.oyatie.dev/schemas/microservice-manifest.schema.json",
  "schema_version": "1.0",
  "microservice": "cell-rebalancer",
  "title": "Cell Rebalancer",
  "version": "0.1.0",
  "status": "wave-15-zd-scaffold",
  "date": "2026-05-21",
  "owner": "axis-platform-reliability",
  "owner_team": "axis-platform-reliability + axis-tenancy + axis-governance",
  "bounded_context": "tenant-migration-across-cells",
  "bounded_contexts": [
    {
      "name": "tenant-migration-across-cells",
      "description": "Durable workflow authority for moving already-placed tenants between eligible cells under auto-rebalance, manual ops, compliance-pack rotation, residency change, and cell-drain triggers.",
      "crates": [
        "oya-cell-rebalancer-kernel",
        "oya-cell-rebalancer-domain",
        "oya-cell-rebalancer-usecase",
        "oya-cell-rebalancer-api",
        "oya-cell-rebalancer-rest",
        "oya-cell-rebalancer-worker",
        "oya-cell-rebalancer-adapter-postgres",
        "oya-cell-rebalancer-adapter-valkey",
        "oya-cell-rebalancer-adapter-tenancy",
        "oya-cell-rebalancer-adapter-policy-engine",
        "oya-cell-rebalancer-adapter-audit-chain",
        "oya-cell-rebalancer-app"
      ]
    }
  ],
  "layers": [
    "kernel",
    "domain",
    "usecase",
    "api",
    "rest",
    "grpc",
    "worker",
    "adapter",
    "infrastructure",
    "app",
    "sdk"
  ],
