  "id_strategy": "uuidv7",
  "id_strategy_authority_note": "Identifier authority is pending in this checkout; uuidv7 is retained for job_id and migration_id because ADR-0276 D-2 requires durable workflow ids and the implementation wave must bind the final identifier doctrine once it lands.",
  "pod_runtime_tier": 1,
  "pod_runtime_tier_justification": "cell-rebalancer is substrate control plane touching tenant data-plane placement and migration metadata, so it runs under Kata + Cloud Hypervisor as a Tier 1 workload.",
  "pod_runtime_tier_surface_evidence": [
    "microservices/cell-rebalancer/ARCH.md",
    "microservices/cell-rebalancer/IPs/IP-CR-003-tenant-migration-workflow-state-machine.md",
    "microservices/cell-rebalancer/IPs/IP-CR-006-audit-chain-evidence-emission.md"
  ],
  "cell_placement_class": 0,
  "cell_placement_class_name": "Tier-0",
  "capacity_model": {
    "baseline_cpu_per_tenant": 0.25,
    "baseline_ram_per_tenant": 384,
    "storage_per_tenant": 2,
    "connections_per_tenant": {
      "valkey": 4,
      "postgres": 4,
      "outbound_http": 8
    },
    "scaling_dimension": "per_workflow_run",
    "cell_placement_class": "Tier-0",
    "tenant_class_deltas": {
      "paid": {
        "baseline_cpu_per_tenant": 0.25,
        "baseline_ram_per_tenant": 384,
        "storage_per_tenant": 2,
        "connections_per_tenant": {
          "valkey": 4,
          "postgres": 4,
          "outbound_http": 8
        },
        "scaling_dimension": "per_workflow_run",
        "cell_placement_class": "Tier-0",
        "notes": "Paid tenants may carry compliance-pack and support escalation floors."
      },
      "demo_trial": {
        "baseline_cpu_per_tenant": 0.08,
        "baseline_ram_per_tenant": 128,
        "storage_per_tenant": 1,
        "connections_per_tenant": {
          "valkey": 2,
          "postgres": 2,
          "outbound_http": 4
        },
        "scaling_dimension": "per_workflow_run",
        "cell_placement_class": "Tier-0",
        "notes": "Demo trial tenants are eligible but rate limited and cost-attributed internally."
      }
    },
    "per_tenant_class": {
      "paid": {
        "cpu_vcpu": 0.25,
        "ram_mib": 384,
        "workflow_storage_gb": 2,
        "valkey_connections": 4,
        "postgres_connections": 4,
        "outbound_http_connections": 8
      },
      "demo_trial": {
        "cpu_vcpu": 0.08,
        "ram_mib": 128,
        "workflow_storage_gb": 1,
        "valkey_connections": 2,
        "postgres_connections": 2,
        "outbound_http_connections": 4
      }
    },
    "notes": "Values model active migration workflows, not steady idle status reads; capacity is intentionally Tier-0 because a bad workflow can move tenants across cells."
  },
  "dr": {
    "rto_p99_seconds": 300,
    "rpo_p99_seconds": 60,
    "rto_minutes": 5,
    "rpo_minutes": 1,
    "multi_region_active_active": true,
    "backup_substrate": [
      "postgres_wal_g",
      "valkey_cluster",
      "audit_chain_merkle_seal"
    ],
    "failover_runbook": "runbooks/emergency-drain.md",
    "dr_tier": "T1",
    "replication_shape": "active-active-multi-az-cross-region-warm",
    "per_pack_floors": {
      "hipaa": {
        "rto_minutes": 60,
        "rpo_minutes": 5,
        "multi_region_required": true
      },
      "gdpr": {
        "rto_minutes": 60,
        "rpo_minutes": 5,
        "multi_region_required": true
      },
      "soc2": {
        "rto_minutes": 240,
        "rpo_minutes": 15,
        "multi_region_required": false
      },
      "csap": {
        "rto_minutes": 60,
        "rpo_minutes": 15,
        "multi_region_required": true
      },
      "pci": {
        "rto_minutes": 1440,
        "rpo_minutes": 60,
        "multi_region_required": false
      }
    }
  },
  "sharding_automation": {
    "autosharding": "control_plane_driven",
    "auto_rebalance": {
      "enabled": true,
      "trigger_load_skew_threshold_percent": 30,
      "honors_residency": true,
      "honors_compliance_packs": true,
      "audit_chain_emit": true,
      "executor_microservice": "cell-rebalancer",
      "blast_radius_max_tenants_per_job": 100
    },
    "dynamic_sharding": {
      "enabled": true,
      "hot_split_threshold_p99_ms": 50,
      "hot_split_utilization_threshold_percent": 80,
      "cold_merge_utilization_threshold_percent": 20,
      "cold_merge_minimum_quiet_hours": 24,
      "audit_chain_emit": true,
      "execution_boundary": "within-cell sharding surfaces; cell-rebalancer handles across-cell tenant migration only"
    }
  },
