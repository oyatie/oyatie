  "foundry_boundary": {
    "principal": "oyatie.foundry.cell-rebalancer",
    "allowed_actions": [
      "create auto-rebalance jobs with signed workflow identity",
      "read eligible status",
      "emit evidence"
    ],
    "forbidden_actions": [
      "create cells",
      "change cell identity",
      "bypass compliance packs",
      "exceed 100 tenants per job",
      "mutate Cedar policies without self-modification gate"
    ]
  },
  "finops": {
