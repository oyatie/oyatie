  "hyperscaler_inv_coverage": {
    "blast_radius": "blast_radius_max_tenants_per_job <= 100",
    "audit_chain": "every state change sealed",
    "cedar": "every mutation pre-evaluated",
    "residency": "cross-jurisdiction permit required",
    "slo": "api and migration p99 targets declared"
  },
  "audit_chain": {
    "enabled": true,
    "seal_events": [
      "cell-rebalancer.job.created",
      "cell-rebalancer.job.validated",
      "cell-rebalancer.job.started",
      "cell-rebalancer.tenant.transitioned",
      "cell-rebalancer.job.aborted",
      "cell-rebalancer.tenant.rolled_back",
      "cell-rebalancer.job.completed",
      "cell-rebalancer.job.failed"
    ]
  },
  "secrets_substrate": {
    "provider": "openbao",
    "format": "${openbao:secret/<path>}",
    "paths": [
      "secret/cell-rebalancer/postgres",
      "secret/cell-rebalancer/valkey",
      "secret/cell-rebalancer/audit-chain",
      "secret/cell-rebalancer/policy-engine"
    ]
  },
  "ontology_projections": [
    {
      "entity_name": "RebalanceJob",
      "projection_target_table": "ontology_rebalance_jobs",
      "projection_kind": "idempotent-rewrite",
      "lag_budget_seconds": 30
    },
    {
      "entity_name": "TenantMigration",
      "projection_target_table": "ontology_tenant_migrations",
      "projection_kind": "idempotent-rewrite",
      "lag_budget_seconds": 30
    }
  ],
