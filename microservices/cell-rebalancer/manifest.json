    {
      "tier": "T0",
      "name": "audit-evidence-emit",
      "file": "microservices/cell-rebalancer/capabilities/capability-catalog.md",
      "risk_class": "critical"
    }
  ],
  "slos": [
    {
      "name": "api_p99_latency_ms.create",
      "target": "<=200ms",
      "sli": "histogram_quantile(0.99, http_request_duration_ms_bucket{operation=\"createRebalanceJobV20260521Tag8001\"})",
      "file": "microservices/cell-rebalancer/slos/cell-rebalancer.openslo.yaml"
    },
    {
      "name": "api_p99_latency_ms.status",
      "target": "<=50ms",
      "sli": "histogram_quantile(0.99, http_request_duration_ms_bucket{operation=~\"get|list\"})",
      "file": "microservices/cell-rebalancer/slos/cell-rebalancer.openslo.yaml"
    },
    {
      "name": "migration_duration_p99_seconds.intra_region",
      "target": "<=600s",
      "sli": "histogram_quantile(0.99, cell_rebalancer_migration_duration_seconds_bucket{migration_distance=\"intra_region\"})",
      "file": "microservices/cell-rebalancer/slos/cell-rebalancer.openslo.yaml"
    },
    {
      "name": "migration_duration_p99_seconds.cross_region",
      "target": "<=3600s",
      "sli": "histogram_quantile(0.99, cell_rebalancer_migration_duration_seconds_bucket{migration_distance=\"cross_region\"})",
      "file": "microservices/cell-rebalancer/slos/cell-rebalancer.openslo.yaml"
    },
    {
      "name": "migration_success_rate_percent",
      "target": ">=99.9",
      "sli": "success / total tenant migrations",
      "file": "microservices/cell-rebalancer/slos/cell-rebalancer.openslo.yaml"
    },
    {
      "name": "blast_radius_max_tenants_per_job",
      "target": "<=100",
      "sli": "max(cell_rebalancer_job_tenants_total)",
      "file": "microservices/cell-rebalancer/slos/cell-rebalancer.openslo.yaml"
    }
  ],
