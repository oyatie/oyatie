#!/usr/bin/env python3
"""Multi-model delivery pipeline runner (harness control plane helpers).

Grok (orchestrator) owns judgment; this tool owns deterministic gates:
CAPTURE_INTENT, DISPATCH, PREFLIGHT, dual-critic independence, FALSE_GREEN_SCAN,
slice admit (TDD), journals, PR packet scaffolding.

It invokes mm-role for role stages. Live model calls are opt-in (not dry by default
only when --execute-roles is set).
"""

from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
import uuid
from datetime import datetime, timezone
from pathlib import Path
from typing import Any, Dict, List, Optional


ROOT_MARKER = ".grok/harness/pipeline.json"


def now() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def find_repo_root(start: Path) -> Path:
    cur = start.resolve()
    for p in [cur, *cur.parents]:
        if (p / ROOT_MARKER).is_file():
            return p
        if (p / ".git").exists() and (p / ".grok").exists():
            return p
    return cur


def load_json(path: Path) -> Any:
    return json.loads(path.read_text())


def write_json(path: Path, data: Any) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(data, indent=2) + "\n")


def run_preflight(repo: Path, out: Path, allow_diverged: bool = False) -> dict:
    cmd = [
        str(repo / ".grok/bin/mm-preflight"),
        "--cwd",
        str(repo),
        "--out",
        str(out),
        "--json-always",
    ]
    if allow_diverged:
        cmd.append("--allow-diverged")
    p = subprocess.run(cmd, text=True, capture_output=True, check=False)
    if out.is_file():
        return load_json(out)
    # fallback parse stdout/stderr
    blob = p.stdout or p.stderr
    return json.loads(blob)



def dual_critic_independence_admit(
    packet: dict,
    *,
    require_cross_model: bool = True,
) -> dict:
    """Admit dual-critic packets with independence honesty (drive.v1.json)."""
    blockers: List[str] = []
    independence = (packet or {}).get("independence") or "unknown"
    critics = (packet or {}).get("critics") or []
    verdict = (packet or {}).get("verdict") or packet.get("admit_recommendation")
    if independence in ("same_family", "unknown") and require_cross_model:
        blockers.append(
            f"independence={independence} does not clear merge when require_cross_model_critics"
        )
    if independence == "cross_model":
        providers = []
        for i, c in enumerate(critics):
            if not isinstance(c, dict):
                blockers.append(f"critics[{i}] not object")
                continue
            prov = c.get("provider")
            if not prov:
                blockers.append(f"critics[{i}] missing provider")
            else:
                providers.append(str(prov))
        if len(set(providers)) < 2:
            blockers.append(
                f"cross_model requires >=2 distinct providers, got {providers!r}"
            )
    if verdict not in ("APPROVE", "CLEAR", "admit", "ADMIT"):
        blockers.append(f"verdict not admit-class: {verdict!r}")
    return {
        "admitted": not blockers,
        "stage": "DUAL_CRITIC_INDEPENDENCE",
        "independence": independence,
        "blockers": blockers,
        "providers": [
            c.get("provider")
            for c in critics
            if isinstance(c, dict) and c.get("provider")
        ],
    }


def capture_intent(repo: Path, run_dir: Path, raw_prompt: str, source: str = "cli") -> dict:
    intent = {
        "schema": "intent.v1",
        "raw_prompt": raw_prompt,
        "captured_at": now(),
        "source": source,
        "risk_hint": "unknown",
        "context_refs": [],
        "constraints_stated": [],
    }
    out = run_dir / "stages" / "CAPTURE_INTENT" / "intent.json"
    write_json(out, intent)
    (run_dir / "stages" / "CAPTURE_INTENT" / "raw_prompt.md").write_text(
        raw_prompt if raw_prompt.endswith("\n") else raw_prompt + "\n"
    )
    return intent


def path_overlap(slices: List[dict]) -> List[str]:
    """Return path-overlap violations among parallel_ok slices."""
    active: List[tuple[str, str]] = []
    violations: List[str] = []
    for s in slices:
        if not s.get("parallel_ok", True):
            continue
        sid = s.get("id", "?")
        for path in s.get("paths") or []:
            for other_id, other_path in active:
                if other_id == sid:
                    continue
                if path == other_path or path.startswith(other_path.rstrip("/") + "/") or other_path.startswith(
                    path.rstrip("/") + "/"
                ):
                    violations.append(f"{sid}:{path} overlaps {other_id}:{other_path}")
            active.append((sid, path))
    return violations


def false_green_scan(run_dir: Path) -> dict:
    """Deterministic anti-false-green checks against journaled reports."""
    checks = {
        "no_skipped_tests": True,
        "no_deleted_red_tests": True,
        "no_weakened_asserts": True,
        "no_generated_face_hand_edit": True,
        "red_proof_present": False,
        "green_same_suite": False,
        "verify_commands_nonempty": False,
        "no_ignore_attribute_added_to_hide_fail": True,
    }
    findings: List[dict] = []

    red_paths = list((run_dir / "stages" / "RED_TEST").rglob("red_test_report.json"))
    green_paths = list((run_dir / "stages" / "GREEN_TEST").rglob("green_test_report.json"))
    verify_paths = list((run_dir / "stages" / "VERIFY").rglob("verify_report.json"))
    # also accept top-level stage files
    red_paths += list((run_dir / "stages" / "RED_TEST").glob("*.json"))
    green_paths += list((run_dir / "stages" / "GREEN_TEST").glob("*.json"))

    red = None
    for p in red_paths:
        try:
            cand = load_json(p)
            if cand.get("schema") == "red_test_report.v1" or cand.get("proof_failed") is not None:
                red = cand
                break
        except Exception:
            continue
    green = None
    for p in green_paths:
        try:
            cand = load_json(p)
            if cand.get("schema") == "green_test_report.v1" or cand.get("proof_passed") is not None:
                green = cand
                break
        except Exception:
            continue

    if red and red.get("proof_failed") is True and red.get("product_code_changed") is False:
        checks["red_proof_present"] = True
    else:
        findings.append(
            {
                "code": "missing_red_proof",
                "path": "stages/RED_TEST",
                "summary": "red_test_report.v1 with proof_failed=true and product_code_changed=false required",
            }
        )

    if green and green.get("proof_passed") is True and green.get("same_suite_as_red") is True:
        checks["green_same_suite"] = True
    else:
        findings.append(
            {
                "code": "missing_green_same_suite",
                "path": "stages/GREEN_TEST",
                "summary": "green_test_report.v1 with proof_passed and same_suite_as_red required",
            }
        )

    # scan all stage text for skip language
    for p in (run_dir / "stages").rglob("*"):
        if not p.is_file():
            continue
        if p.suffix not in {".md", ".rs", ".txt", ".json"}:
            continue
        try:
            body = p.read_text(errors="replace")
        except Exception:
            continue
        if detect_test_skip(body):
            checks["no_skipped_tests"] = False
            findings.append(
                {
                    "code": "test_skip_language",
                    "path": str(p.relative_to(run_dir)),
                    "summary": "skip/ignore/weaken test language detected",
                }
            )
        if "#[ignore]" in body or "#[cfg(test)]\n#[ignore]" in body:
            checks["no_ignore_attribute_added_to_hide_fail"] = False

    for p in verify_paths:
        try:
            v = load_json(p)
            cmds = v.get("commands") or []
            if cmds:
                checks["verify_commands_nonempty"] = True
            if v.get("skipped_tests") is True:
                checks["no_skipped_tests"] = False
                findings.append(
                    {
                        "code": "skipped_tests_flag",
                        "path": str(p.relative_to(run_dir)),
                        "summary": "verify_report.skipped_tests=true",
                    }
                )
        except Exception:
            pass

    # if no verify report, still allow when green present (partial wave)
    if not checks["verify_commands_nonempty"] and green:
        checks["verify_commands_nonempty"] = True

    clean = all(checks.values()) and not findings
    report = {
        "schema": "false_green_scan.v1",
        "clean": clean,
        "checks": checks,
        "findings": findings,
    }
    out = run_dir / "stages" / "FALSE_GREEN_SCAN" / "false_green_scan.json"
    write_json(out, report)
    return report


def dual_critic_admit(critiques: List[dict]) -> dict:
    """Fail closed: need >=2 critiques each with explicit admit recommendation."""
    blockers: List[str] = []
    if len(critiques) < 2:
        blockers.append(f"need >=2 critic reports, got {len(critiques)}")
        return {
            "admitted": False,
            "stage": "CRITIC",
            "blockers": blockers,
            "evidence_refs": [],
        }
def detect_test_skip(text: str) -> bool:
    needles = [
        "skip test",
        "skipping test",
        "#[ignore]",
        "tests skipped",
        "delete the test",
        "weaken the gate",
    ]
    low = text.lower()
    return any(n in low for n in needles)



def cmd_start(args: argparse.Namespace) -> int:
    """Start a run: CAPTURE_INTENT first, then PREFLIGHT (forbid raw execute path)."""
    repo = find_repo_root(Path(args.cwd))
    run_id = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ") + "-" + uuid.uuid4().hex[:8]
    run_dir = repo / ".grok" / "mm-runs" / run_id
    run_dir.mkdir(parents=True, exist_ok=True)

    pipeline = load_json(repo / ".grok/harness/pipeline.json")
    roles = load_json(repo / ".grok/multi-model-roles.json")
    dod = load_json(repo / ".grok/harness/dod-checklist.json")

    intent = capture_intent(repo, run_dir, args.objective, source="cli")
    completed = ["CAPTURE_INTENT"]

    # Optional dry journal for harden/decompose when not executing roles
    write_json(
        run_dir / "stages" / "PROMPT_HARDEN" / "awaiting_role.json",
        {
            "stage": "PROMPT_HARDEN",
            "role": "PROMPT_HARDENER",
            "input": "stages/CAPTURE_INTENT/intent.json",
            "output_schema": "hardened_prompt.v1",
            "command_hint": f"mm-pipeline role --run-id {run_id} --role PROMPT_HARDENER --stage PROMPT_HARDEN",
        },
    )
    write_json(
        run_dir / "stages" / "DECOMPOSE" / "awaiting_role.json",
        {
            "stage": "DECOMPOSE",
            "role": "PLANNER",
            "output_schema": "work_graph.v1",
            "command_hint": f"mm-pipeline role --run-id {run_id} --role PLANNER --stage DECOMPOSE",
        },
    )

    preflight_path = run_dir / "preflight.json"
    pre = run_preflight(repo, preflight_path, allow_diverged=args.allow_diverged)
    if pre.get("ok"):
        completed.append("PREFLIGHT")

    run = {
        "run_id": run_id,
        "created_at": now(),
        "objective": args.objective,
        "risk": args.risk,
        "focus": args.focus,
        "repo": str(repo),
        "status": "blocked" if not pre.get("ok") else "intent_captured",
        "stage_pointer": "PREFLIGHT" if pre.get("ok") else "CAPTURE_INTENT",
        "preflight_ok": bool(pre.get("ok")),
        "origin_dev_sha": pre.get("origin_dev_sha"),
        "head_sha": pre.get("head_sha"),
        "stages_completed": completed,
        "pipeline_version": pipeline.get("version"),
        "roles_version": roles.get("version"),
        "human_admit_plan": False,
        "admitted_plan": False,
        "intent_schema": intent.get("schema"),
        "forbid_raw_execute": bool((pipeline.get("entry") or {}).get("forbid_raw_execute", True)),
        "implement_loop": (pipeline.get("implement_loop") or {}).get("sequence"),
        "notes": [
            "Front door: CAPTURE_INTENT done; run PROMPT_HARDENER then PLANNER(DECOMPOSE) then dispatch before IMPLEMENT"
        ],
    }
    if not pre.get("ok"):
        run["notes"].append("PREFLIGHT failed; fix baseline before multi-model execute")
        run["blockers"] = pre.get("blockers", [])

    write_json(run_dir / "run.json", run)
    write_json(run_dir / "pipeline.snapshot.json", pipeline)
    write_json(run_dir / "dod.snapshot.json", dod)
    (run_dir / "objective.md").write_text(
        f"# Objective\n\n{args.objective}\n\n"
        f"- risk: {args.risk}\n- focus: {args.focus}\n"
        f"- created_at: {run['created_at']}\n"
        f"- origin_dev_sha: {run.get('origin_dev_sha')}\n"
        f"- next: PROMPT_HARDEN → DECOMPOSE → DISPATCH → PLAN/CRITIC → RED_TEST…\n"
    )

    print(
        json.dumps(
            {
                "run_id": run_id,
                "run_dir": str(run_dir),
                "intent": str(run_dir / "stages/CAPTURE_INTENT/intent.json"),
                "preflight_ok": pre.get("ok"),
                "next": [
                    "mm-pipeline role --run-id … --role PROMPT_HARDENER --stage PROMPT_HARDEN",
                    "mm-pipeline role --run-id … --role PLANNER --stage DECOMPOSE",
                    "mm-pipeline dispatch --run-id …",
                    "… ADMIT_PLAN then RED_TEST → IMPLEMENT → …",
                ],
                "blockers": pre.get("blockers", []),
            },
            indent=2,
        )
    )
    return 0 if pre.get("ok") else 2


def cmd_dispatch(args: argparse.Namespace) -> int:
    """Mechanical DISPATCH: validate work_graph path overlap and journal ledger."""
    repo = find_repo_root(Path(args.cwd))
    run_dir, run = load_run(repo, args.run_id)
    graph_paths = list((run_dir / "stages" / "DECOMPOSE").rglob("work_graph.json"))
    if args.work_graph:
        graph_paths = [Path(args.work_graph)]
    if not graph_paths:
        report = {
            "admitted": False,
            "stage": "DISPATCH",
            "blockers": ["work_graph.v1 missing under stages/DECOMPOSE"],
        }
        write_json(run_dir / "stages" / "DISPATCH" / "dispatch.json", report)
        print(json.dumps(report, indent=2))
        return 2
    graph = load_json(graph_paths[0])
    slices = graph.get("slices") or []
    violations = path_overlap(slices) or graph.get("path_overlap_violations") or []
    report = {
        "admitted": len(violations) == 0 and len(slices) > 0,
        "stage": "DISPATCH",
        "slice_ids": [s.get("id") for s in slices],
        "path_overlap_violations": violations,
        "dispatch_order": graph.get("dispatch_order")
        or [s.get("id") for s in slices],
        "blockers": []
        if not violations and slices
        else (["empty slices"] if not slices else ["path overlap: " + "; ".join(violations)]),
        "work_graph": str(graph_paths[0]),
    }
    write_json(run_dir / "stages" / "DISPATCH" / "dispatch.json", report)
    if report["admitted"]:
        run.setdefault("stages_completed", []).append("DISPATCH")
        run["stage_pointer"] = "DISPATCH"
        run["dispatched"] = True
    else:
        run["status"] = "dispatch_blocked"
    write_json(run_dir / "run.json", run)
    print(json.dumps(report, indent=2))
    return 0 if report["admitted"] else 2


def cmd_false_green_scan(args: argparse.Namespace) -> int:
    repo = find_repo_root(Path(args.cwd))
    run_dir, run = load_run(repo, args.run_id)
    report = false_green_scan(run_dir)
    if report.get("clean"):
        run.setdefault("stages_completed", []).append("FALSE_GREEN_SCAN")
        run["stage_pointer"] = "FALSE_GREEN_SCAN"
    else:
        run["status"] = "false_green_blocked"
    write_json(run_dir / "run.json", run)
    print(json.dumps(report, indent=2))
    return 0 if report.get("clean") else 2


def cmd_admit_slice(args: argparse.Namespace) -> int:
    """Admit implement slice: red+green+false_green (+ optional dual-critic packet)."""
    repo = find_repo_root(Path(args.cwd))
    run_dir, run = load_run(repo, args.run_id)
    blockers: List[str] = []
    if not run.get("preflight_ok"):
        blockers.append("preflight not green")
    if not run.get("admitted_plan") and not args.force:
        blockers.append("plan not admitted")

    fg = false_green_scan(run_dir)
    if not fg.get("clean"):
        blockers.append("false_green_scan not clean")
        blockers.extend(f"{f['code']}:{f['summary']}" for f in fg.get("findings") or [])

    # dual critic packet optional but if present must pass independence when required
    packet_paths = list((run_dir / "stages" / "REVIEW_DIFF").rglob("*dual*critic*.json"))
    packet_paths += list((run_dir / "stages" / "CRITIC_DIFF").rglob("*.json"))
    drive = {}
    drive_path = repo / ".grok/harness/drive.v1.json"
    if drive_path.is_file():
        drive = load_json(drive_path)
    require_xm = bool((drive.get("merge_policy") or {}).get("require_cross_model_critics", True))
    if args.dual_critic_json:
        packet_paths = [Path(args.dual_critic_json)]
    if packet_paths:
        packet = load_json(packet_paths[0])
        ind = dual_critic_independence_admit(packet, require_cross_model=require_xm)
        if not ind.get("admitted"):
            blockers.extend(ind.get("blockers") or [])
    elif require_xm and not args.force:
        blockers.append("REVIEW_DIFF dual-critic packet missing (required for slice admit)")

    admission = {
        "admitted": not blockers,
        "stage": "ADMIT_SLICE",
        "blockers": blockers,
        "false_green": fg,
    }
    write_json(run_dir / "stages" / "ADMIT_SLICE" / "admission.json", admission)
    if admission["admitted"]:
        run.setdefault("stages_completed", []).append("ADMIT_SLICE")
        run["status"] = "slice_admitted"
        run["stage_pointer"] = "ADMIT_SLICE"
    else:
        run["status"] = "slice_rejected"
    write_json(run_dir / "run.json", run)
    print(json.dumps(admission, indent=2))
    return 0 if admission["admitted"] else 2


def cmd_admit_dual_critic(args: argparse.Namespace) -> int:
    repo = find_repo_root(Path(args.cwd))
    packet = load_json(Path(args.packet))
    drive = load_json(repo / ".grok/harness/drive.v1.json")
    require_xm = bool((drive.get("merge_policy") or {}).get("require_cross_model_critics", True))
    if args.allow_same_family:
        require_xm = False
    report = dual_critic_independence_admit(packet, require_cross_model=require_xm)
    print(json.dumps(report, indent=2))
    return 0 if report.get("admitted") else 2


def load_run(repo: Path, run_id: str) -> tuple[Path, dict]:
    run_dir = repo / ".grok" / "mm-runs" / run_id
    run_path = run_dir / "run.json"
    if not run_path.is_file():
        raise SystemExit(f"unknown run_id: {run_id}")
    return run_dir, load_json(run_path)


def cmd_status(args: argparse.Namespace) -> int:
    repo = find_repo_root(Path(args.cwd))
    run_dir, run = load_run(repo, args.run_id)
    print(json.dumps({"run_dir": str(run_dir), **run}, indent=2))
    return 0


def cmd_preflight(args: argparse.Namespace) -> int:
    repo = find_repo_root(Path(args.cwd))
    out = Path(args.out) if args.out else repo / ".grok" / "mm-runs" / "_ad-hoc" / "preflight.json"
    pre = run_preflight(repo, out, allow_diverged=args.allow_diverged)
    print(json.dumps(pre, indent=2))
    return 0 if pre.get("ok") else 2


def cmd_admit_plan(args: argparse.Namespace) -> int:
    """Deterministic admit from critic JSON files."""
    repo = find_repo_root(Path(args.cwd))
    run_dir, run = load_run(repo, args.run_id)
    if not run.get("preflight_ok"):
        admission = {
            "admitted": False,
            "stage": "ADMIT_PLAN",
            "blockers": ["preflight not green"],
            "evidence_refs": [str(run_dir / "preflight.json")],
        }
        write_json(run_dir / "stages" / "ADMIT_PLAN" / "admission.json", admission)
        print(json.dumps(admission, indent=2))
        return 2

    critic_paths = list((run_dir / "stages" / "CRITIC_PLAN").glob("**/critique.json"))
    if args.critic_json:
        critic_paths = [Path(p) for p in args.critic_json]

    critiques = []
    for p in critic_paths:
        critiques.append(load_json(p))

    admission = dual_critic_admit(critiques)
    admission["stage"] = "ADMIT_PLAN"

    # risk human gate
    if run.get("risk") in ("high", "critical") and not run.get("human_admit_plan"):
        admission["admitted"] = False
        admission["blockers"] = list(admission.get("blockers") or []) + [
            "human_admit_plan required for high/critical risk (mm-pipeline human-admit --run-id ...)"
        ]

    # scan plan text for test-skip language if present
    plan_path = run_dir / "stages" / "PLAN" / "result.md"
    if plan_path.is_file() and detect_test_skip(plan_path.read_text()):
        admission["admitted"] = False
        admission["blockers"] = list(admission.get("blockers") or []) + [
            "plan text appears to skip/weaken tests"
        ]

    write_json(run_dir / "stages" / "ADMIT_PLAN" / "admission.json", admission)
    run["admitted_plan"] = bool(admission["admitted"])
    run["stage_pointer"] = "ADMIT_PLAN"
    if admission["admitted"]:
        run.setdefault("stages_completed", []).append("ADMIT_PLAN")
        run["status"] = "plan_admitted"
    else:
        run["status"] = "plan_rejected"
    write_json(run_dir / "run.json", run)
    print(json.dumps(admission, indent=2))
    return 0 if admission["admitted"] else 2


def cmd_human_admit(args: argparse.Namespace) -> int:
    repo = find_repo_root(Path(args.cwd))
    run_dir, run = load_run(repo, args.run_id)
    run["human_admit_plan"] = True
    run.setdefault("notes", []).append(f"human_admit_plan at {now()}: {args.reason or 'ok'}")
    write_json(run_dir / "run.json", run)
    print(json.dumps({"human_admit_plan": True, "run_id": args.run_id}, indent=2))
    return 0


def cmd_pr_packet(args: argparse.Namespace) -> int:
    repo = find_repo_root(Path(args.cwd))
    run_dir, run = load_run(repo, args.run_id)
    dod = load_json(run_dir / "dod.snapshot.json") if (run_dir / "dod.snapshot.json").is_file() else load_json(repo / ".grok/harness/dod-checklist.json")
    lines = [
        "# PR packet (multi-model harness)",
        "",
        f"- run_id: `{run['run_id']}`",
        f"- objective: {run.get('objective')}",
        f"- risk: {run.get('risk')}",
        f"- origin_dev_sha: `{run.get('origin_dev_sha')}`",
        f"- head_sha: `{run.get('head_sha')}`",
        f"- admitted_plan: {run.get('admitted_plan')}",
        "",
        "## Governance",
        "",
        "- PR target: `dev`",
        "- Merge authority: reviewer APPROVE + **oya-ci-required** only (ADR-0515)",
        "- This harness is **not** merge authority",
        "",
        "## Definition of Done",
        "",
    ]
    for item in dod.get("items", []):
        lines.append(f"- [ ] {item['id']}: {item['text']}")
    lines += [
        "",
        "## Evidence index",
        "",
        f"- preflight: `{(run_dir / 'preflight.json')}`",
        f"- run: `{(run_dir / 'run.json')}`",
        f"- stages: `{(run_dir / 'stages')}`",
        "",
        "## Post-merge product completion (human)",
        "",
        "- [ ] promoted commit oya-ci-required green",
        "- [ ] rollout verification",
        "- [ ] rollback note validated",
        "- [ ] observability check",
        "- [ ] browser/user-story evidence if UI",
        "- [ ] release-note impact assessed",
        "",
    ]
    out = run_dir / "evidence" / "admission-packet.md"
    out.parent.mkdir(parents=True, exist_ok=True)
    out.write_text("\n".join(lines))
    print(json.dumps({"path": str(out)}, indent=2))
    return 0


def cmd_close_run(args: argparse.Namespace) -> int:
    """score → grade → evaluate → learn (deterministic close loop)."""
    repo = find_repo_root(Path(args.cwd))
    run_dir, run = load_run(repo, args.run_id)
    steps = [
        [str(repo / ".grok/bin/mm-score"), "--cwd", str(repo), "--run-id", args.run_id],
        [str(repo / ".grok/bin/mm-grade"), "--cwd", str(repo), "--run-id", args.run_id],
        [str(repo / ".grok/bin/mm-evaluate"), "full", "--cwd", str(repo), "--run-id", args.run_id],
        [str(repo / ".grok/bin/mm-learn"), "from-run", "--cwd", str(repo), "--run-id", args.run_id],
    ]
    results = []
    for cmd in steps:
        p = subprocess.run(cmd, text=True, capture_output=True, check=False)
        results.append(
            {
                "cmd": Path(cmd[0]).name,
                "exit": p.returncode,
                "stdout_tail": (p.stdout or "")[-500:],
                "stderr_tail": (p.stderr or "")[-300:],
            }
        )
        if p.returncode != 0 and Path(cmd[0]).name in ("mm-score", "mm-grade"):
            print(json.dumps({"ok": False, "failed": Path(cmd[0]).name, "results": results}, indent=2))
            return p.returncode
    run["status"] = "closed"
    run["stage_pointer"] = "LEARN"
    write_json(run_dir / "run.json", run)
    print(json.dumps({"ok": True, "run_id": args.run_id, "results": results}, indent=2))
    return 0


def cmd_role(args: argparse.Namespace) -> int:
    """Invoke mm-role and journal under stages/<STAGE>/."""
    repo = find_repo_root(Path(args.cwd))
    run_dir, run = load_run(repo, args.run_id)
    if args.role == "EXECUTOR" and not run.get("preflight_ok"):
        print("mm-pipeline: EXECUTOR blocked: preflight not green", file=sys.stderr)
        return 2
    if args.role == "EXECUTOR" and not run.get("admitted_plan") and not args.force:
        print("mm-pipeline: EXECUTOR blocked: plan not admitted (use --force only with human intent)", file=sys.stderr)
        return 2
    if args.role == "EXECUTOR" and not args.force:
        red_ok = False
        for p in (run_dir / "stages" / "RED_TEST").rglob("*.json"):
            try:
                r = load_json(p)
            except Exception:
                continue
            if r.get("proof_failed") is True and r.get("product_code_changed") is False:
                red_ok = True
                break
        if not red_ok:
            print(
                "mm-pipeline: EXECUTOR blocked: RED_TEST proof missing (red_test_report.v1 proof_failed=true, product_code_changed=false)",
                file=sys.stderr,
            )
            return 2

    stage = args.stage or args.role
    out_dir = run_dir / "stages" / stage / f"{args.role}-{now().replace(':', '')}"
    out_dir.mkdir(parents=True, exist_ok=True)

    mm_role = repo / ".grok/bin/mm-role"
    cmd = [str(mm_role), args.role, "--cwd", str(repo), "--out", str(out_dir)]
    if args.dry_run:
        cmd.append("--dry-run")
    if args.prompt_file:
        cmd.extend(["--prompt-file", args.prompt_file])
    else:
        prompt = args.prompt or (run_dir / "objective.md").read_text()
        cmd.extend(["--", prompt])

    print("mm-pipeline: running:", " ".join(cmd[:6]), "...", file=sys.stderr)
    p = subprocess.run(cmd, check=False)
    run.setdefault("stages_completed", [])
    if p.returncode == 0:
        if stage not in run["stages_completed"]:
            run["stages_completed"].append(stage)
        run["stage_pointer"] = stage
    write_json(run_dir / "run.json", run)
    return p.returncode


def build_parser() -> argparse.ArgumentParser:
    ap = argparse.ArgumentParser(description="Multi-model harness pipeline")
    # Parent so --cwd works before or after subcommand patterns via inheritance
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--cwd", default=".", help="repo root or subdir")

    sub = ap.add_subparsers(dest="cmd", required=True)

    sp = sub.add_parser("start", parents=[common], help="start a run (always runs PREFLIGHT)")
    sp.add_argument("--objective", required=True)
    sp.add_argument("--risk", default="medium", choices=["low", "medium", "high", "critical"])
    sp.add_argument("--focus", default="full")
    sp.add_argument("--allow-diverged", action="store_true")
    sp.set_defaults(func=cmd_start)

    sp = sub.add_parser("status", parents=[common], help="show run status")
    sp.add_argument("--run-id", required=True)
    sp.set_defaults(func=cmd_status)

    sp = sub.add_parser("preflight", parents=[common], help="run PREFLIGHT only")
    sp.add_argument("--out", default="")
    sp.add_argument("--allow-diverged", action="store_true")
    sp.set_defaults(func=cmd_preflight)

    sp = sub.add_parser("admit-plan", parents=[common], help="deterministic plan admission from critic JSON")
    sp.add_argument("--run-id", required=True)
    sp.add_argument("--critic-json", nargs="*", default=[])
    sp.set_defaults(func=cmd_admit_plan)

    sp = sub.add_parser("human-admit", parents=[common], help="record human admit for high/critical plans")
    sp.add_argument("--run-id", required=True)
    sp.add_argument("--reason", default="")
    sp.set_defaults(func=cmd_human_admit)

    sp = sub.add_parser("pr-packet", parents=[common], help="write PR admission packet")
    sp.add_argument("--run-id", required=True)
    sp.set_defaults(func=cmd_pr_packet)

    sp = sub.add_parser("role", parents=[common], help="run a role via mm-role and journal it")
    sp.add_argument("--run-id", required=True)
    sp.add_argument("--role", required=True, choices=["PLANNER", "EXECUTOR", "ARCHITECT", "CRITIC", "SECURITY", "VERIFIER", "PROMPT_HARDENER", "TEST_ENGINEER", "SIMPLIFIER", "HARDENER"])
    sp.add_argument("--stage", default="")
    sp.add_argument("--prompt", default="")
    sp.add_argument("--prompt-file", default="")
    sp.add_argument("--dry-run", action="store_true")
    sp.add_argument("--force", action="store_true")
    sp.set_defaults(func=cmd_role)

    sp = sub.add_parser("close-run", parents=[common], help="score → grade → evaluate → learn")
    sp.add_argument("--run-id", required=True)
    sp.set_defaults(func=cmd_close_run)

    sp = sub.add_parser("dispatch", parents=[common], help="mechanical DISPATCH from work_graph.v1")
    sp.add_argument("--run-id", required=True)
    sp.add_argument("--work-graph", default="", help="path to work_graph.json")
    sp.set_defaults(func=cmd_dispatch)

    sp = sub.add_parser("false-green-scan", parents=[common], help="mechanical FALSE_GREEN_SCAN for implement loop")
    sp.add_argument("--run-id", required=True)
    sp.set_defaults(func=cmd_false_green_scan)

    sp = sub.add_parser("admit-slice", parents=[common], help="admit implement slice (red+green+false-green+review)")
    sp.add_argument("--run-id", required=True)
    sp.add_argument("--dual-critic-json", default="")
    sp.add_argument("--force", action="store_true")
    sp.set_defaults(func=cmd_admit_slice)

    sp = sub.add_parser("admit-dual-critic", parents=[common], help="admit dual-critic packet independence")
    sp.add_argument("--packet", required=True, help="path to dual-critic JSON packet")
    sp.add_argument("--allow-same-family", action="store_true")
    sp.set_defaults(func=cmd_admit_dual_critic)

    return ap


def main() -> int:
    ap = build_parser()
    args = ap.parse_args()
    return int(args.func(args))


if __name__ == "__main__":
    sys.exit(main())
