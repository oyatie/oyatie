#!/usr/bin/env python3
"""Enqueue overdue reorg/rewrite/debrand/refactor/remove cards onto task board.

Reads REORG-REBRAND-BACKLOG.md for card IDs + waves; upserts ready lanes with
source=reorg. Never silent on long-overdue debt. Not merge authority.

Respects doctrine: reorg != only move; re-query origin/dev before execute.
"""
from __future__ import annotations

import argparse
import json
import re
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path
from typing import Any, Dict, List, Optional, Tuple


# Seed cards from REORG-REBRAND-BACKLOG (must stay path-conscious; W0/W1 preferred for parallel)
