def now() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def find_repo(start: Path) -> Path:
    cur = start.resolve()
    for p in [cur, *cur.parents]:
        if (p / ".grok/programs/delivery-fabric/task-board.v1.json").is_file() or (
            p / ".git"
        ).exists():
            return p
    return cur


def upsert(lanes: List[dict], lane: dict) -> None:
    for i, e in enumerate(lanes):
        if e.get("id") == lane["id"]:
            if e.get("status") in ("claimed", "in_progress", "implementing", "cleared", "waived"):
                # preserve terminal/claim
                if e.get("status") in ("claimed", "in_progress", "implementing"):
                    lane["status"] = e["status"]
                    lane["claimed_by"] = e.get("claimed_by")
                    lane["claimed_at"] = e.get("claimed_at")
                else:
                    return  # don't reopen cleared/waived automatically
            lane["first_seen_at"] = e.get("first_seen_at") or now()
            lane["updated_at"] = now()
            lanes[i] = {**e, **lane}
            return
    lane["first_seen_at"] = now()
    lane["updated_at"] = now()
    lanes.append(lane)


def origin_dev_sha(repo: Path) -> str:
    try:
        p = subprocess.run(
            ["git", "rev-parse", "origin/dev"],
            cwd=str(repo),
            text=True,
            capture_output=True,
            check=False,
        )
        return (p.stdout or "").strip()
    except OSError:
        return ""


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--cwd", default=".")
    ap.add_argument("--waves", default="W0,W1,W2", help="comma waves to enqueue")
    ap.add_argument("--dry-run", action="store_true")
    args = ap.parse_args()
    repo = find_repo(Path(args.cwd))
    board_path = repo / ".grok/programs/delivery-fabric/task-board.v1.json"
    if board_path.is_file():
        board = json.loads(board_path.read_text())
    else:
        board = {"schema": "task-board.v1", "lanes": [], "notes": []}

    waves = {w.strip() for w in args.waves.split(",") if w.strip()}
    lanes = list(board.get("lanes") or [])
    dev = origin_dev_sha(repo)
    added = []
    for card in SEED_CARDS:
        if card["wave"] not in waves:
            continue
        lid = f"REORG-{card['id']}"
        lane = {
            "id": lid,
            "title": f"[{card['class']}/{card['wave']}] {card['title']}",
            "status": "ready",
            "priority": card["priority"],
            "paths": card["paths"],
            "depends_on": [],
            "source": "reorg",
            "source_ref": f"REORG-REBRAND-BACKLOG.md#{card['id']}",
            "reorg_class": card["class"],
            "reorg_wave": card["wave"],
            "authority": card["authority"],
            "bead_id": None,
            "pr": None,
            "branch": None,
            "dod": card["dod"]
            + [
                "Re-query live ADRs on origin/dev before push (REORG-DOCTRINE §1)",
                f"Worktree from origin/dev@{dev[:12] if dev else 'unknown'}",
                "One concern per PR; dual-critic APPROVE + oya-ci-required for merge",
            ],
            "blockers": list(card.get("blockers") or []),
            "claimed_by": None,
            "claimed_at": None,
        }
        if lane["blockers"]:
            lane["status"] = "blocked"
            lane["priority"] = "P2"
        upsert(lanes, lane)
        added.append(lid)

    board["lanes"] = lanes
    board["updated_at"] = now()
    board["updated_by"] = "mm-reorg-enqueue"
    board["origin_dev"] = {"sha": dev, "sha12": dev[:12] if dev else None, "at": now()}
    board.setdefault("notes", [])
    board["notes"] = [
        f"mm-reorg-enqueue {now()}: waves={sorted(waves)} added/upserted {len(added)} reorg lanes; origin/dev={dev[:12] if dev else '?'}"
    ] + [n for n in board["notes"] if not str(n).startswith("mm-reorg-enqueue ")][:15]
    board["reorg_queue"] = {
        "waves": sorted(waves),
        "lane_ids": added,
        "doctrine": ".grok/programs/REORG-DOCTRINE.md",
        "backlog": ".grok/programs/REORG-REBRAND-BACKLOG.md",
    }

    if not args.dry_run:
        board_path.parent.mkdir(parents=True, exist_ok=True)
        board_path.write_text(json.dumps(board, indent=2) + "\n")

    print(
        json.dumps(
            {
                "ok": True,
                "origin_dev": dev[:12] if dev else None,
                "waves": sorted(waves),
                "upserted": added,
                "reorg_ready": sum(
                    1
                    for L in lanes
                    if L.get("source") == "reorg" and L.get("status") == "ready"
                ),
                "reorg_blocked": sum(
                    1
                    for L in lanes
                    if L.get("source") == "reorg" and L.get("status") == "blocked"
                ),
                "board": str(board_path),
            },
            indent=2,
        )
    )
    return 0


if __name__ == "__main__":
    sys.exit(main())
