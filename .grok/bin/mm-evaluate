#!/usr/bin/env python3
"""Continuously evaluate the harness/workflow itself across throughput, quality, pipeline, prompts, hyperscaler design, portability, lifecycle.

Usage:
  mm-evaluate run --run-id <id> [--cwd .]
  mm-evaluate static --cwd .
  mm-evaluate full --run-id <id> [--cwd .]
"""

from __future__ import annotations

import argparse
import json
import re
import time
from datetime import datetime, timezone
from pathlib import Path
from typing import Any, Dict, List, Optional, Tuple


def now() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def load_json(path: Path) -> Any:
    return json.loads(path.read_text())


def write_json(path: Path, data: Any) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(data, indent=2) + "\n")


def find_repo(start: Path) -> Path:
    cur = start.resolve()
    for p in [cur, *cur.parents]:
        if (p / ".grok/harness/evaluation.v1.json").is_file():
            return p
    return cur


def dim(score: float, signals: List[str], max_s: float = 100.0) -> dict:
    return {"score": round(min(max(score, 0.0), max_s), 2), "max": max_s, "signals": signals}


def eval_static(repo: Path) -> dict:
    """Portability + prompt engineering static checks + hyperscaler checklist presence."""
    hard: List[str] = []
    dims: Dict[str, dict] = {}

    # kit completeness
    kit_path = repo / ".grok/harness/kit.v1.json"
    if kit_path.is_file():
        kit = load_json(kit_path)
        missing = []
        for rel in (kit.get("bins") or []) + (kit.get("configs") or []) + (kit.get("workflows") or []):
            if not (repo / ".grok" / rel.replace("bin/", "bin/").lstrip("./")).exists():
                # paths in kit are relative to .grok/
                if not (repo / ".grok" / rel).exists():
                    missing.append(rel)
        if missing:
            hard.append(f"kit:missing:{','.join(missing[:5])}")
        forb = kit.get("forbidden_clis") or []
        if "gjc" not in forb or "hermes" not in forb:
            hard.append("kit:forbidden_clis_incomplete")

    # portability
    p_score, p_sig = 0.0, []
    if (repo / ".grok/bin/mm-bootstrap").is_file():
        p_score += 30
        p_sig.append("bootstrap_present")
    else:
        p_sig.append("bootstrap_missing")
        hard.append("portability:no_bootstrap")
    if kit_path.is_file():
        p_score = min(100.0, p_score + 10)
        p_sig.append("kit_manifest_present")
    prof = repo / ".grok/harness/project-profile.v1.json"
    if prof.is_file():
        p_score += 25
        p_sig.append("project_profile_present")
        try:
            pj = load_json(prof)
            for key in ("base_ref", "pr_target"):
                if (pj.get("vcs") or {}).get(key):
                    p_score += 10
                    p_sig.append(f"vcs.{key}")
        except Exception as e:
            p_sig.append(f"profile_parse_error:{e}")
    else:
        p_sig.append("project_profile_missing")

    # hardcoded absolute Developer paths in configs (not README examples)
    bad_abs = 0
    for path in (repo / ".grok/harness").rglob("*.json"):
        text = path.read_text(errors="replace")
        if "/Users/" in text and "examples" not in path.name:
            # allow examples key content in project-profile
            if path.name == "project-profile.v1.json" and "examples" in text:
                continue
            bad_abs += 1
    if bad_abs == 0:
        p_score += 25
        p_sig.append("no_hardcoded_user_paths_in_harness_json")
    else:
        p_sig.append(f"hardcoded_paths_files={bad_abs}")
    dims["portability"] = dim(p_score, p_sig)

    # prompt engineering (workflows)
    pe_score, pe_sig = 0.0, []
    wfs = list((repo / ".grok/workflows").glob("*.rhai")) if (repo / ".grok/workflows").is_dir() else []
    if wfs:
        pe_score += 20
        pe_sig.append(f"workflows={len(wfs)}")
    lens_ok = 0
    tool_ok = 0
    ortho = 0
    forb = 0
    for wf in wfs:
        t = wf.read_text(errors="replace")
        if "REASONING LENS PACK" in t or "lens" in t.lower():
            lens_ok += 1
        if "read_file" in t or "read-only tools" in t or "Use read-only" in t:
            tool_ok += 1
        if "CRITIC A" in t and "CRITIC B" in t:
            ortho += 1
        if re.search(r"\b(gjc|omc|omx|hermes)\b", t) and "FORBIDDEN" not in t and "not gjc" not in t.lower():
            # count dependency usage vs forbid
            if "invoke" in t.lower() or "run gjc" in t or "omc ask" in t:
                forb += 1
    if wfs and lens_ok == len(wfs):
        pe_score += 25
        pe_sig.append("all_workflows_mention_lenses")
    elif lens_ok:
        pe_score += 15
        pe_sig.append(f"lens_workflows={lens_ok}/{len(wfs)}")
    if tool_ok:
        pe_score += 25
        pe_sig.append("tool_use_commanded")
    if ortho:
        pe_score += 20
        pe_sig.append("orthogonal_critics_in_workflow")
    if forb == 0:
        pe_score += 10
        pe_sig.append("no_forbidden_cli_dependency")
    else:
        hard.append("prompt:forbidden_cli_dependency")
        pe_sig.append(f"forbidden_cli_hits={forb}")
    dims["prompt_engineering"] = dim(pe_score, pe_sig)

    # Dual-critic packet contract (static): drive policy + critique schema + admit rules
    # + kit 2.2 parallel critic spawn metrics surface.
    # Not merge authority — only verifies the harness can host dual-critic packets/metrics.
    dc_score, dc_sig = 0.0, []
    drive_path = repo / ".grok/harness/drive.v1.json"
    critique_schema = repo / ".grok/harness/schemas/critique.v1.json"
    spawn_schema = repo / ".grok/harness/schemas/critic_spawn_metrics.v1.json"
    pipe_path = repo / ".grok/harness/pipeline.json"
    par_path = repo / ".grok/harness/parallelism.v1.json"
    if drive_path.is_file():
        try:
            drive = load_json(drive_path)
            mp = drive.get("merge_policy") or {}
            if mp.get("require_agent_dual_critic"):
                dc_score += 25
                dc_sig.append("drive_require_agent_dual_critic")
            else:
                dc_sig.append("drive_dual_critic_optional")
                dc_score += 8
            paths = mp.get("agent_review_paths") or []
            if paths:
                dc_score += 20
                dc_sig.append(f"dual_critic_packet_globs={len(paths)}")
            else:
                dc_sig.append("dual_critic_packet_globs_missing")
            admit_v = mp.get("agent_review_admit_verdicts") or []
            if admit_v:
                dc_score += 8
                dc_sig.append(f"admit_verdicts={len(admit_v)}")
            if mp.get("forbid_self_approve", False):
                dc_score += 8
                dc_sig.append("forbid_self_approve")
        except Exception as e:
            dc_sig.append(f"drive_parse_error:{e}")
    else:
        dc_sig.append("drive_v1_missing")
    if critique_schema.is_file():
        dc_score += 10
        dc_sig.append("critique_schema_present")
        try:
            cs = load_json(critique_schema)
            props = (cs.get("properties") or {})
            if "admit_recommendation" in props or "findings" in props:
                dc_score += 4
                dc_sig.append("critique_schema_has_admit_or_findings")
        except Exception as e:
            dc_sig.append(f"critique_schema_parse_error:{e}")
    else:
        dc_sig.append("critique_schema_missing")
    if spawn_schema.is_file():
        dc_score += 8
        dc_sig.append("critic_spawn_metrics_schema")
    else:
        dc_sig.append("critic_spawn_metrics_schema_missing")
    if par_path.is_file():
        try:
            par = load_json(par_path)
            critics = par.get("critics") or {}
            metrics = par.get("metrics") or {}
            if critics.get("parallel") and int(critics.get("default_instances") or 0) >= 2:
                dc_score += 8
                dc_sig.append(
                    f"parallelism_critics_parallel instances={critics.get('default_instances')}"
                )
            else:
                dc_sig.append("parallelism_critics_not_parallel_or_lt2")
            if metrics.get("record_critic_spawn"):
                dc_score += 4
                dc_sig.append("parallelism_record_critic_spawn")
            else:
                dc_sig.append("parallelism_record_critic_spawn_off")
        except Exception as e:
            dc_sig.append(f"parallelism_parse_error:{e}")
    else:
        dc_sig.append("parallelism_v1_missing")
    if pipe_path.is_file():
        try:
            pipe = load_json(pipe_path)
            admit = pipe.get("admit_rules") or {}
            if admit.get("dual_critic_both_must_confirm"):
                dc_score += 3
                dc_sig.append("pipeline_dual_critic_both_must_confirm")
            dual_stages = [
                s
                for s in (pipe.get("stages") or [])
                if isinstance(s, dict) and s.get("kind") == "dual_critic"
            ]
            ok_inst = [s for s in dual_stages if int(s.get("instances") or 0) >= 2]
            if ok_inst:
                dc_score += 4
                dc_sig.append(f"pipeline_dual_critic_instances>={len(ok_inst)}stages")
            elif dual_stages:
                dc_sig.append("pipeline_dual_critic_instances_lt2")
            else:
                dc_sig.append("pipeline_dual_critic_stages_missing")
        except Exception as e:
            dc_sig.append(f"pipeline_parse_error:{e}")
    # CLI surface for plan/record (kit 2.2)
    pipe_bin = repo / ".grok/bin/mm-pipeline"
    if pipe_bin.is_file():
        try:
            t = pipe_bin.read_text(errors="replace")
            if "plan-critics" in t and "record-critics" in t and "critic_spawn_metrics" in t:
                dc_score += 3
                dc_sig.append("mm_pipeline_critic_spawn_cli")
            else:
                dc_sig.append("mm_pipeline_critic_spawn_cli_missing")
        except Exception as e:
            dc_sig.append(f"mm_pipeline_read_error:{e}")
    dims["dual_critic_packet"] = dim(min(dc_score, 100.0), dc_sig)

    # hyperscaler design checklist in configs
    h_score, h_sig = 0.0, []
    eval_doc = load_json(repo / ".grok/harness/evaluation.v1.json")
    checks = (eval_doc.get("dimensions") or {}).get("hyperscaler_enterprise_design", {}).get("checklist") or []
    lenses = load_json(repo / ".grok/harness/lenses.v1.json").get("lenses") or {}
    hit = 0
    for c in checks:
        if c in lenses or c.replace("_", "") in "".join(lenses.keys()):
            hit += 1
        elif any(c in k for k in lenses):
            hit += 1
    # map checklist names to lens ids loosely
    mapping = {
        "blast_radius_cell": "blast_radius_cell",
        "zero_trust": "zero_trust",
        "constant_work": "constant_work",
        "shared_nothing_or_stale_state": "shared_nothing",
        "finops_or_budget": "finops",
        "telemetry_first": "telemetry_first",
        "operability_day2": "operability_day2",
    }
    hit = sum(1 for c in checks if mapping.get(c, c) in lenses)
    if checks:
        h_score = 100.0 * hit / len(checks)
        h_sig.append(f"lens_checklist_coverage={hit}/{len(checks)}")
    # safety + preflight existence
    if (repo / ".grok/bin/mm-preflight").is_file():
        h_score = min(100.0, h_score + 0)  # already full possible
        h_sig.append("preflight_tool_present")
    if (repo / ".grok/harness/safety.md").is_file():
        h_sig.append("safety_md_present")
    dims["hyperscaler_enterprise_design"] = dim(h_score, h_sig)

    # lifecycle map present
    rows = (eval_doc.get("lifecycle_map") or {}).get("rows") or []
    lf = 100.0 if len(rows) >= 8 else 50.0 * (len(rows) / 8.0)
    dims["lifecycle_fidelity"] = dim(lf, [f"lifecycle_rows={len(rows)}"])

    return {"dims": dims, "hard_fails": hard, "known_failures": eval_doc.get("known_failures") or []}


def eval_run(repo: Path, run_id: str) -> dict:
    run_dir = repo / ".grok" / "mm-runs" / run_id
    if not run_dir.is_dir():
        raise SystemExit(f"unknown run_id {run_id}")

    hard: List[str] = []
    dims: Dict[str, dict] = {}
    run = load_json(run_dir / "run.json") if (run_dir / "run.json").is_file() else {}
    pre = load_json(run_dir / "preflight.json") if (run_dir / "preflight.json").is_file() else {}
    grade = load_json(run_dir / "grade.json") if (run_dir / "grade.json").is_file() else {}
    score = load_json(run_dir / "scorecard.json") if (run_dir / "scorecard.json").is_file() else {}
    packet = (run_dir / "evidence" / "admission-packet.md")
    packet_t = packet.read_text(errors="replace") if packet.is_file() else ""
    goals = load_json(run_dir / "goals.json") if (run_dir / "goals.json").is_file() else {}

    # throughput — kit 2.2 critic spawn metrics when present
    t_score, t_sig = 30.0, ["partial_instrumentation"]
    meta_files = list(run_dir.rglob("meta.json")) if run_dir.exists() else []
    if meta_files:
        for m in meta_files:
            try:
                mj = load_json(m)
                if mj.get("started_at") and mj.get("finished_at"):
                    t_sig.append("has_role_timestamps")
                    break
            except Exception:
                pass
        t_score += 15
        t_sig.append(f"role_metas={len(meta_files)}")
    # dual critic parallel intended
    if (run_dir / "stages" / "CRITIC_PLAN").exists() or grade:
        t_score += 15
        t_sig.append("critic_stage_present_or_graded")
    # serial execute policy awareness
    t_score += 15
    t_sig.append("executor_serial_policy_documented")

    # critic spawn metrics (plan/record artifacts)
    spawn_paths = list(run_dir.rglob("critic_spawn_metrics.json")) if run_dir.exists() else []
    plan_paths = list(run_dir.rglob("critic_spawn_plan.json")) if run_dir.exists() else []
    if spawn_paths or plan_paths:
        t_score += 10
        t_sig.append(f"critic_spawn_artifacts plan={len(plan_paths)} record={len(spawn_paths)}")
    agg_path = run_dir / "critic_spawn_metrics.json"
    if agg_path.is_file():
        try:
            sm = load_json(agg_path)
            counts = sm.get("counts") or {}
            planned = int(counts.get("planned") or 0)
            recorded = int(counts.get("recorded") or 0)
            t_sig.append(f"critic_spawn_planned={planned}")
            t_sig.append(f"critic_spawn_recorded={recorded}")
            if recorded >= 2:
                t_score += 10
                t_sig.append("critic_spawn_recorded_ge2")
            elif planned >= 2:
                t_score += 5
                t_sig.append("critic_spawn_planned_ge2_not_yet_recorded")
            paths = sm.get("paths") or []
            if paths:
                t_sig.append(f"critic_packet_paths={len(paths)}")
            pe = (sm.get("duration_ms") or {}).get("parallel_efficiency")
            if pe is not None:
                t_score += 5
                t_sig.append(f"critic_spawn_parallel_efficiency={pe}")
        except Exception as e:
            t_sig.append(f"critic_spawn_metrics_parse_error:{e}")
    dims["concurrent_throughput"] = dim(min(t_score, 100.0), t_sig)

    # outcome quality
    o_score, o_sig = 0.0, []
    letter = grade.get("letter")
    if letter:
        band = {"A": 100, "B": 85, "C": 70, "D": 55, "F": 30}.get(letter, 40)
        o_score += band * 0.5
        o_sig.append(f"grade={letter}")
    elif score:
        o_score += 40
        o_sig.append("scorecard_without_grade")
    else:
        o_sig.append("no_grade_or_scorecard")
    if grade.get("ship_ready"):
        o_score += 15
        o_sig.append("ship_ready_draft")
    if not grade.get("hard_fails"):
        o_score += 20
        o_sig.append("no_hard_fails_in_grade")
    else:
        o_sig.append(f"hard_fails={grade.get('hard_fails')}")
        hard.extend([f"outcome:{h}" for h in grade.get("hard_fails") or []])
    if score.get("admitted_plan") or grade.get("admitted_plan"):
        o_score += 15
        o_sig.append("plan_admitted")
    dims["outcome_quality"] = dim(o_score, o_sig)

    # delivery pipeline fit
    d_score, d_sig = 0.0, []
    if pre.get("ok") is True:
        d_score += 40
        d_sig.append("preflight_ok")
    elif pre:
        d_sig.append("preflight_failed")
        hard.append("pipeline:preflight_failed")
    else:
        d_sig.append("preflight_missing")
    if pre.get("behind_count") == 0:
        d_score += 20
        d_sig.append("behind_0")
    elif pre.get("behind_count", 0) and pre.get("behind_count", 0) > 0:
        hard.append("pipeline:behind_origin_dev")
        d_sig.append(f"behind={pre.get('behind_count')}")
    blob = packet_t + json.dumps(run) + json.dumps(goals)
    if "oya-ci-required" in blob or "oya_ci" in blob:
        d_score += 20
        d_sig.append("mentions_required_context")
    if re.search(r"merge.?ready|ready to merge", blob, re.I) and "not" not in blob.lower():
        # weak heuristic
        d_sig.append("possible_merge_claim")
    else:
        d_score += 20
        d_sig.append("no_strong_merge_authority_claim")
    dims["delivery_pipeline_fit"] = dim(d_score, d_sig)

    return {"dims": dims, "hard_fails": hard}


def combine(static: dict, run: Optional[dict], eval_doc: dict) -> dict:
    weights = {}
    for k, v in (eval_doc.get("dimensions") or {}).items():
        weights[k] = float(v.get("weight") or 0)

    dims: Dict[str, dict] = {}
    dims.update(static.get("dims") or {})
    if run:
        for k, v in (run.get("dims") or {}).items():
            dims[k] = v

    # Only score dimensions we actually evaluated. Static-only must not
    # zero-fill run metrics (throughput/outcome/pipeline) or grades go to F.
    evaluated = set(dims.keys())
    active_w = {k: w for k, w in weights.items() if k in evaluated}
    if not active_w:
        active_w = weights
        for k in weights:
            if k not in dims:
                dims[k] = dim(0, ["not_evaluated"])

    total_w = sum(active_w.values()) or 1.0
    score = sum(float((dims[k]).get("score") or 0) * active_w[k] for k in active_w) / total_w

    hard = list(static.get("hard_fails") or [])
    if run:
        hard.extend(run.get("hard_fails") or [])

    letter = "F"
    if not hard:
        if score >= 90:
            letter = "A"
        elif score >= 80:
            letter = "B"
        elif score >= 70:
            letter = "C"
        elif score >= 60:
            letter = "D"
    else:
        letter = "F"
        score = min(score, 59.99)

    gaps = []
    for kf in eval_doc.get("known_failures") or []:
        gaps.append(
            {
                "id": kf.get("id"),
                "area": kf.get("area"),
                "symptom": kf.get("symptom"),
                "close_gap": kf.get("close_gap"),
            }
        )

    return {
        "evaluated_at": now(),
        "letter": letter,
        "score": round(score, 2),
        "hard_fails": hard,
        "dimensions": dims,
        "known_failures": gaps,
        "close_gap_priority": eval_doc.get("close_gap_priority") or [],
        "lifecycle_map": (eval_doc.get("lifecycle_map") or {}).get("rows") or [],
    }


def write_report(repo: Path, result: dict, run_id: Optional[str]) -> Path:
    lines = [
        f"# Workflow continuous evaluation",
        "",
        f"- evaluated_at: {result['evaluated_at']}",
        f"- letter: **{result['letter']}** ({result['score']})",
        f"- hard_fails: {', '.join(result['hard_fails']) or '(none)'}",
        "",
        "## Dimensions",
        "",
    ]
    for k, v in (result.get("dimensions") or {}).items():
        lines.append(f"### {k} — {v.get('score')}/{v.get('max')}")
        for s in v.get("signals") or []:
            lines.append(f"- {s}")
        lines.append("")
    lines += ["## Known failures & close-gap", ""]
    for g in result.get("known_failures") or []:
        lines.append(f"- **{g.get('id')}** ({g.get('area')}): {g.get('symptom')}")
        lines.append(f"  - close: {g.get('close_gap')}")
    lines += ["", "## Lifecycle fidelity (real life ↔ harness)", ""]
    for row in result.get("lifecycle_map") or []:
        lines.append(f"- **{row.get('real_life')}** → `{row.get('harness')}`")
        lines.append(f"  - gap: {row.get('gap')}")
    lines += [
        "",
        "## Priority close-gap order",
        "",
    ]
    for p in result.get("close_gap_priority") or []:
        lines.append(f"1. {p}" if False else f"- {p}")
    text = "\n".join(lines) + "\n"
    if run_id:
        out = repo / ".grok" / "mm-runs" / run_id / "workflow-evaluation.md"
    else:
        out = repo / ".grok" / "memory" / "evaluations" / f"{datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%SZ')}.md"
    out.parent.mkdir(parents=True, exist_ok=True)
    out.write_text(text)
    write_json(out.with_suffix(".json"), result)
    return out


def main() -> int:
    ap = argparse.ArgumentParser(description="Evaluate multi-agent workflow continuously")
    ap.add_argument("--cwd", default=".")
    sub = ap.add_subparsers(dest="cmd", required=True)
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--cwd", default=".")

    sp = sub.add_parser("static", parents=[common])
    sp.set_defaults(mode="static")

    sp = sub.add_parser("run", parents=[common])
    sp.add_argument("--run-id", required=True)
    sp.set_defaults(mode="run")

    sp = sub.add_parser("full", parents=[common])
    sp.add_argument("--run-id", required=True)
    sp.set_defaults(mode="full")

    args = ap.parse_args()
    repo = find_repo(Path(args.cwd))
    eval_doc = load_json(repo / ".grok/harness/evaluation.v1.json")

    static = eval_static(repo)
    run = None
    run_id = getattr(args, "run_id", None)
    if args.mode in ("run", "full"):
        run = eval_run(repo, args.run_id)
    if args.mode == "static":
        run = None
        run_id = None

    result = combine(static, run, eval_doc)
    result["mode"] = args.mode
    if run_id:
        result["run_id"] = run_id
    path = write_report(repo, result, run_id)
    print(json.dumps({"letter": result["letter"], "score": result["score"], "path": str(path), "hard_fails": result["hard_fails"]}, indent=2))
    return 0 if result["letter"] not in ("F",) or args.mode == "static" else 0


if __name__ == "__main__":
    raise SystemExit(main())
