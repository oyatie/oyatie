#!/usr/bin/env python3
"""Render a lens-pack system prefix for agent prompts (fine-tunable via harness JSON)."""

from __future__ import annotations

import argparse
import json
from pathlib import Path
from typing import List


def find_repo(start: Path) -> Path:
    cur = start.resolve()
    for p in [cur, *cur.parents]:
        if (p / ".grok/harness/lenses.v1.json").is_file():
            return p
    return cur


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--cwd", default=".")
    ap.add_argument("--stage", default="")
    ap.add_argument("--perspective", default="")
    ap.add_argument("--lenses", default="", help="comma-separated lens ids override")
    args = ap.parse_args()
    repo = find_repo(Path(args.cwd))
    lenses_doc = json.loads((repo / ".grok/harness/lenses.v1.json").read_text())
    packs = json.loads((repo / ".grok/harness/stage-lens-packs.v1.json").read_text())
    catalog = lenses_doc.get("lenses") or {}

    ids: List[str] = []
    if args.lenses:
        ids = [x.strip() for x in args.lenses.split(",") if x.strip()]
    elif args.stage:
        st = (packs.get("stages") or {}).get(args.stage) or {}
        if args.perspective:
            for p in st.get("perspectives") or []:
                if p.get("id") == args.perspective:
                    ids = list(p.get("lenses") or [])
                    break
            if not ids:
                raise SystemExit(f"perspective {args.perspective} not in stage {args.stage}")
        else:
            ids = list(st.get("pack") or [])
    else:
        raise SystemExit("provide --stage and optional --perspective, or --lenses")

    lines = [
        "REASONING LENS PACK (mandatory for this stage/perspective):",
        "Use ONLY these lenses as primary reasoning filters. Do not apply all 16 lenses.",
        "",
    ]
    for i, lid in enumerate(ids, 1):
        L = catalog.get(lid) or {}
        lines.append(f"{i}. {lid}")
        lines.append(f"   brief: {L.get('brief', '')}")
        lines.append(f"   avoid: {L.get('anti_pattern', '')}")
        lines.append("")
    lines.append("Output must cite evidence paths you actually inspected.")
    lines.append("Fail closed: if evidence is missing, say so; do not invent ownership or success.")
    print("\n".join(lines))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
