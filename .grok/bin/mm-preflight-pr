#!/usr/bin/env python3
"""Local pre-PR gate — catch product defects BEFORE gh pr create / push thrash.

Process failure this fixes: agents opened reorg/process PRs that went all-red
on CI; triage showed ALL reds were GHA Set-up-job CDN flakes — but we also had
NO mandatory local suite for reorg leaves, so real defects would also have
landed as PR-red without a preflight stop.

This is NOT oya-ci-required. It is a local fail-closed gate for implement.

Usage:
  .grok/bin/mm-preflight-pr [--base origin/dev] [--json] [--write-receipt]

Exit: 0 ok; 1 failed checks (do not open/push PR); 2 env/usage.
"""
from __future__ import annotations

import argparse
import json
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path
from typing import Any, Dict, List, Tuple


def sh(args: List[str], timeout: int = 300) -> Tuple[int, str]:
    try:
        r = subprocess.run(args, capture_output=True, text=True, timeout=timeout)
        return r.returncode, (r.stdout or "") + (r.stderr or "")
    except Exception as e:
        return 99, str(e)


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("--base", default="origin/dev")
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--write-receipt", action="store_true")
    ap.add_argument("--skip-cargo", action="store_true")
    args = ap.parse_args()

    code, root_s = sh(["git", "rev-parse", "--show-toplevel"])
    if code != 0:
        print("mm-preflight-pr: not a git repo", file=sys.stderr)
        return 2
    root = Path(root_s.strip())
    head = subprocess.check_output(["git", "rev-parse", "HEAD"], cwd=root, text=True).strip()

    code, diff = sh(["git", "diff", "--name-only", f"{args.base}...HEAD"], timeout=60)
    if code != 0:
        # try fetch
        sh(["git", "fetch", "origin", "dev"], timeout=120)
        code, diff = sh(["git", "diff", "--name-only", f"{args.base}...HEAD"], timeout=60)
    changed = [ln for ln in diff.splitlines() if ln.strip()]

    checks: List[Dict[str, Any]] = []
    fail = False

    def add(cid: str, ok: bool, detail: str, skip: bool = False) -> None:
        nonlocal fail
        checks.append({"id": cid, "ok": ok, "detail": detail, "skipped": skip})
        tag = "SKIP" if skip else ("PASS" if ok else "FAIL")
        print(f"{tag}  {cid} — {detail}")
        if not ok and not skip:
            fail = True

    if not changed:
        add("diff_nonempty", False, f"no files changed vs {args.base} — refuse empty PR")
    else:
        add("diff_nonempty", True, f"{len(changed)} paths vs {args.base}")

    # JSON validity for changed json
    for f in changed:
        if not f.endswith(".json"):
            continue
        p = root / f
        if not p.is_file():
            continue
        try:
            json.loads(p.read_text())
            add(f"json_valid:{f}", True, "parse ok")
        except Exception as e:
            add(f"json_valid:{f}", False, str(e)[:120])

    # Python syntax for changed .py under .grok
    for f in changed:
        if f.endswith(".py") and (f.startswith(".grok/") or f.startswith("tools/")):
            p = root / f
            if p.is_file():
                c, o = sh([sys.executable, "-m", "py_compile", str(p)], timeout=60)
                add(f"py_compile:{f}", c == 0, o[:120] if c else "ok")

    # Move-plan singleton if specs/reorg touched
    if any(f.startswith("specs/reorg/") for f in changed):
        live = []
        reorg = root / "specs" / "reorg"
        if reorg.is_dir():
            for p in reorg.glob("*-move-plan.json"):
                if "PARKED" in p.name or "BLOCKED" in p.name:
                    continue
                live.append(p.name)
        ok = len(live) <= 1
        add(
            "reorg_moveplan_singleton",
            ok,
            f"live executable plans={live}" if live else "zero live plans (ok)",
        )
        # cargo test singleton if available
        if not args.skip_cargo:
            c, o = sh(
                [
                    "cargo",
                    "test",
                    "-p",
                    "ci-baseline-ratchet",
                    "--test",
                    "gate_registration",
                    "reorg_at_most_one_executable_move_plan",
                    "--",
                    "--nocapture",
                ],
                timeout=300,
            )
            add(
                "cargo_singleton_test",
                c == 0,
                "reorg_at_most_one_executable_move_plan" if c == 0 else o[-200:],
            )

    # Dual-home reorg: if deleting oya/X, require consumer retarget evidence in same diff
    oya_deletes = [f for f in changed if f.startswith("oya/") and f.endswith("/manifest.json") is False]
    # simpler: if oya path removed - check git status
    code_d, deleted = sh(["git", "diff", "--name-only", "--diff-filter=D", f"{args.base}...HEAD"])
    del_oya = [f for f in deleted.splitlines() if f.startswith("oya/")]
    if del_oya:
        # require either evidence/reorg or specs/capability-registry change
        has_evidence = any(f.startswith("evidence/reorg/") for f in changed)
        has_registry = "specs/capability-registry.json" in changed
        add(
            "dual_home_consumer_packet",
            has_evidence and has_registry,
            "delete under oya/ requires evidence/reorg/* + capability-registry retarget in same PR"
            if not (has_evidence and has_registry)
            else f"oya deletes={len(del_oya)} with evidence+registry",
        )

    # North-star: no new *.generated.json hand paths
    gen = [f for f in changed if f.endswith(".generated.json")]
    add(
        "no_hand_generated_json",
        len(gen) == 0,
        "ok" if not gen else f"forbidden hand faces: {gen[:5]}",
    )

    # GraphQL gate if graphql test or marketplace scan roots touched
    if any("graphql-usage-policy" in f for f in changed) or any(
        f.startswith("marketplace/") or f.startswith("oya/marketplace") for f in changed
    ):
        if not args.skip_cargo:
            c, o = sh(
                [
                    "cargo",
                    "test",
                    "-p",
                    "ci-graphql-usage-policy",
                    "--test",
                    "no_graphql_without_adr",
                ],
                timeout=300,
            )
            add("cargo_graphql_policy", c == 0, "ok" if c == 0 else o[-200:])

    # Process: refuse PR open if only .md evidence with no machine checks when claiming reorg execute
    reorg_execute_signals = any(
        f.startswith("oya/") or f.startswith("marketplace/") or f.startswith("observability/")
        for f in changed
    ) and any(f.startswith("evidence/reorg/") for f in changed)
    if reorg_execute_signals:
        add(
            "reorg_execute_has_machine_touch",
            any(
                f.startswith("specs/") or f.startswith("ci/") or f.endswith("manifest.json")
                for f in changed
            ),
            "execute dual-home rehome should retarget registry/ci/manifest consumers",
        )

    receipt = {
        "schema": "preflight-pr.v1",
        "ok": not fail,
        "head": head,
        "base": args.base,
        "changed": changed,
        "checks": checks,
        "written_at": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
        "tool": ".grok/bin/mm-preflight-pr",
        "not_claiming": ["merge_authority", "oya_ci_required"],
        "process_note": (
            "This gate catches LOCAL product defects only. GHA Set-up-job CDN flakes "
            "cannot be predicted here — use mm-ci-triage after open; do not thrash tips."
        ),
    }

    if args.write_receipt or True:
        out = Path(root) / ".grok/mm-runs/_fabric" / "preflight-pr.latest.json"
        # mm-runs may be gitignored — also write evidence for agents that need tracked? keep untracked
        out.parent.mkdir(parents=True, exist_ok=True)
        out.write_text(json.dumps(receipt, indent=2) + "\n")
        # optional tracked evidence path under hyperscaler if reorg
        print(f"receipt → {out}")

    if args.json:
        print(json.dumps(receipt, indent=2))
    else:
        print(f"mm-preflight-pr ok={receipt['ok']} head={head[:12]} checks={len(checks)}")
        if fail:
            print("PROCESS: fix FAILs above before gh pr create / push", file=sys.stderr)

    return 1 if fail else 0


if __name__ == "__main__":
    sys.exit(main())
