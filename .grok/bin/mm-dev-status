#!/usr/bin/env python3
"""Report origin/dev remote tip + CI awareness for fabric (always-on).

Fetches refs (optional), prints JSON: sha, subject, oya-ci on tip, open PR lag.
Not merge authority. Exit 0 always when query succeeds; 2 on gh/git hard fail.
"""
from __future__ import annotations

import argparse
import json
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path
from typing import Any, Dict, List, Optional, Tuple


def run(cmd: List[str], cwd: Path, timeout: int = 60) -> Tuple[int, str, str]:
    try:
        p = subprocess.run(cmd, cwd=str(cwd), text=True, capture_output=True, timeout=timeout, check=False)
        return p.returncode, p.stdout or "", p.stderr or ""
    except (OSError, subprocess.TimeoutExpired) as e:
        return 2, "", str(e)


def find_repo(start: Path) -> Path:
    cur = start.resolve()
    for p in [cur, *cur.parents]:
        if (p / ".git").exists():
            return p
    return cur


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--cwd", default=".")
    ap.add_argument("--fetch", action="store_true", help="git fetch origin dev")
    ap.add_argument("--base", default="dev")
    args = ap.parse_args()
    repo = find_repo(Path(args.cwd))

    if args.fetch:
        run(["git", "fetch", "origin", args.base], repo, timeout=120)

    code, sha, err = run(["git", "rev-parse", f"origin/{args.base}"], repo)
    if code != 0:
        print(json.dumps({"ok": False, "error": "rev-parse failed", "stderr": err[:300]}, indent=2))
        return 2
    sha = sha.strip()
    _, subj, _ = run(["git", "log", "-1", "--format=%s", sha], repo)
    _, when, _ = run(["git", "log", "-1", "--format=%cI", sha], repo)

    # Latest oya-ci-required on that SHA
    oya = {"conclusion": None, "status": None, "url": None, "databaseId": None}
    code, out, _ = run(
        [
            "gh",
            "run",
            "list",
            "--branch",
            args.base,
            "--limit",
            "15",
            "--json",
            "databaseId,conclusion,status,name,headSha,url,createdAt",
        ],
        repo,
        timeout=60,
    )
    if code == 0 and out.strip():
        try:
            runs = json.loads(out)
            for r in runs:
                if r.get("name") == "oya-ci-required" and (r.get("headSha") or "").startswith(sha[:12]):
                    oya = {
                        "conclusion": r.get("conclusion"),
                        "status": r.get("status"),
                        "url": r.get("url"),
                        "databaseId": r.get("databaseId"),
                    }
                    break
            if oya.get("conclusion") is None:
                # any latest oya-ci on branch
                for r in runs:
                    if r.get("name") == "oya-ci-required":
                        oya = {
                            "conclusion": r.get("conclusion"),
                            "status": r.get("status"),
                            "url": r.get("url"),
                            "databaseId": r.get("databaseId"),
                            "headSha": r.get("headSha"),
                            "note": "latest branch run may not match tip SHA",
                        }
                        break
        except json.JSONDecodeError:
            pass

    # Open PRs lag vs origin/dev
    code, out, _ = run(
        [
            "gh",
            "pr",
            "list",
            "--base",
            args.base,
            "--state",
            "open",
            "--limit",
            "30",
            "--json",
            "number,title,headRefOid,headRefName,isDraft",
        ],
        repo,
        timeout=60,
    )
    pr_lag = []
    if code == 0 and out.strip():
        try:
            for pr in json.loads(out):
                num = pr.get("number")
                head = pr.get("headRefOid") or ""
                # commits behind: rev-list
                c2, behind, _ = run(
                    ["git", "rev-list", "--count", f"{head}..origin/{args.base}"],
                    repo,
                    timeout=30,
                )
                c3, ahead, _ = run(
                    ["git", "rev-list", "--count", f"origin/{args.base}..{head}"],
                    repo,
                    timeout=30,
                )
                pr_lag.append(
                    {
                        "pr": num,
                        "title": (pr.get("title") or "")[:80],
                        "branch": pr.get("headRefName"),
                        "draft": pr.get("isDraft"),
                        "behind_dev": int(behind.strip() or 0) if c2 == 0 else None,
                        "ahead_dev": int(ahead.strip() or 0) if c3 == 0 else None,
                        "head": head[:12],
                    }
                )
        except (json.JSONDecodeError, ValueError):
            pass

    # Primary checkout awareness
    _, head_local, _ = run(["git", "rev-parse", "HEAD"], repo)
    _, branch_local, _ = run(["git", "branch", "--show-current"], repo)
    c4, behind_local, _ = run(
        ["git", "rev-list", "--count", f"HEAD..origin/{args.base}"], repo, timeout=30
    )

    report = {
        "ok": True,
        "ts": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
        "base": args.base,
        "origin_dev": {
            "sha": sha,
            "sha12": sha[:12],
            "subject": subj.strip(),
            "committed_at": when.strip(),
            "oya_ci_required": oya,
        },
        "local": {
            "head": head_local.strip()[:12],
            "branch": branch_local.strip(),
            "behind_origin_dev": int(behind_local.strip() or 0) if c4 == 0 else None,
        },
        "open_prs_vs_dev": pr_lag,
        "prs_behind_dev": [p for p in pr_lag if (p.get("behind_dev") or 0) > 0],
        "process": {
            "all_lanes_must_rebase_when_behind": True,
            "reorg_requires_fresh_origin_dev_worktree": True,
            "stale_execute_is_defect": True,
        },
    }
    print(json.dumps(report, indent=2))
    return 0


if __name__ == "__main__":
    sys.exit(main())
