#!/usr/bin/env python3
"""Compile stage/perspective/role prompts from fine-tune JSON (single source of truth).

Kills F-PROMPT-DRIFT: workflows and mm-role should consume this output rather than
hand-duplicating lens encyclopedias.

Usage:
  mm-prompt --stage CRITIC_PLAN --perspective critic_a
  mm-prompt --stage PLAN --role PLANNER --objective "…"
  mm-prompt --stage CRITIC_PLAN --perspective critic_b --objective-file plan.json
  mm-prompt --list-perspectives --stage CRITIC_PLAN
"""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path
from typing import Any, Dict, List, Optional


def find_repo(start: Path) -> Path:
    cur = start.resolve()
    for p in [cur, *cur.parents]:
        if (p / ".grok/harness/lenses.v1.json").is_file():
            return p
    return cur


def load(repo: Path, rel: str) -> Any:
    return json.loads((repo / rel).read_text())


def lens_block(catalog: dict, ids: List[str]) -> str:
    lines = [
        "REASONING LENS PACK (mandatory for this stage/perspective):",
        "Use ONLY these lenses as primary reasoning filters. Do not apply all 16 lenses.",
        "",
    ]
    for i, lid in enumerate(ids, 1):
        L = catalog.get(lid) or {}
        lines.append(f"{i}. {lid}")
        lines.append(f"   brief: {L.get('brief', '')}")
        lines.append(f"   avoid: {L.get('anti_pattern', '')}")
        lines.append("")
    lines.append("Output must cite evidence paths you actually inspected.")
    lines.append("Fail closed: if evidence is missing, say so; do not invent ownership or success.")
    lines.append("Do not invoke gjc, omc, omx, or hermes CLIs.")
    return "\n".join(lines)


def resolve_lens_ids(packs: dict, stage: str, perspective: str, lenses_csv: str) -> List[str]:
    if lenses_csv:
        return [x.strip() for x in lenses_csv.split(",") if x.strip()]
    st = (packs.get("stages") or {}).get(stage) or {}
    if perspective:
        for p in st.get("perspectives") or []:
            if p.get("id") == perspective:
                return list(p.get("lenses") or [])
        raise SystemExit(f"perspective {perspective!r} not found in stage {stage!r}")
    return list(st.get("pack") or [])


def role_system(roles: dict, role: str) -> str:
    r = (roles.get("roles") or {}).get(role) or {}
    return (r.get("system") or "").strip()


def compile_prompt(
    repo: Path,
    *,
    stage: str = "",
    perspective: str = "",
    role: str = "",
    lenses_csv: str = "",
    objective: str = "",
    extra: str = "",
    profile: Optional[dict] = None,
) -> str:
    catalog = load(repo, ".grok/harness/lenses.v1.json").get("lenses") or {}
    packs = load(repo, ".grok/harness/stage-lens-packs.v1.json")
    roles = load(repo, ".grok/multi-model-roles.json")
    if profile is None:
        pp = repo / ".grok/harness/project-profile.v1.json"
        profile = load(repo, ".grok/harness/project-profile.v1.json") if pp.is_file() else {}

    parts: List[str] = []

    if role:
        sys = role_system(roles, role)
        if sys:
            parts.append(f"ROLE: {role}\n{sys}")
        else:
            parts.append(f"ROLE: {role}")

    if stage or lenses_csv:
        ids = resolve_lens_ids(packs, stage, perspective, lenses_csv)
        if not ids and stage:
            raise SystemExit(f"no lenses for stage={stage} perspective={perspective}")
        parts.append(lens_block(catalog, ids))
        if perspective:
            parts.append(f"PERSPECTIVE ID: {perspective} (orthogonal to sibling perspectives).")

    # Project authority snippet (portable)
    vcs = (profile or {}).get("vcs") or {}
    auth = (profile or {}).get("authority") or {}
    if vcs or auth:
        parts.append(
            "PROJECT AUTHORITY:\n"
            f"- base_ref: {vcs.get('base_ref', 'origin/dev')}\n"
            f"- pr_target: {vcs.get('pr_target', 'dev')}\n"
            f"- required_status_context: {vcs.get('required_status_context', '')}\n"
            f"- merge: {auth.get('merge', 'human review + required CI')}\n"
            f"- not merge authority: {auth.get('not_merge_authority', [])}\n"
        )

    if objective:
        parts.append(f"OBJECTIVE:\n{objective.strip()}")

    if extra:
        parts.append(extra.strip())

    parts.append(
        "ENGINEERING RULES:\n"
        "- Prefer process/gate fixes that prevent recurrence over one-off patches.\n"
        "- Never skip, delete, or weaken tests to go green.\n"
        "- Prefer smallest sufficient change (essentialism).\n"
        "- Use read-only tools unless role explicitly allows write.\n"
    )
    return "\n\n".join(parts) + "\n"


def main() -> int:
    ap = argparse.ArgumentParser(description="Compile mm harness prompts from JSON packs")
    ap.add_argument("--cwd", default=".")
    ap.add_argument("--stage", default="")
    ap.add_argument("--perspective", default="")
    ap.add_argument("--role", default="")
    ap.add_argument("--lenses", default="")
    ap.add_argument("--objective", default="")
    ap.add_argument("--objective-file", default="")
    ap.add_argument("--extra-file", default="")
    ap.add_argument("--list-perspectives", action="store_true")
    ap.add_argument("--json", action="store_true", help="emit {lens_ids,prompt}")
    args = ap.parse_args()

    repo = find_repo(Path(args.cwd))
    packs = load(repo, ".grok/harness/stage-lens-packs.v1.json")

    if args.list_perspectives:
        if not args.stage:
            raise SystemExit("--list-perspectives requires --stage")
        st = (packs.get("stages") or {}).get(args.stage) or {}
        print(json.dumps(st.get("perspectives") or [], indent=2))
        return 0

    objective = args.objective
    if args.objective_file:
        objective = Path(args.objective_file).read_text()
    extra = ""
    if args.extra_file:
        extra = Path(args.extra_file).read_text()

    ids = []
    if args.stage or args.lenses:
        ids = resolve_lens_ids(packs, args.stage, args.perspective, args.lenses)

    prompt = compile_prompt(
        repo,
        stage=args.stage,
        perspective=args.perspective,
        role=args.role,
        lenses_csv=args.lenses,
        objective=objective,
        extra=extra,
    )

    if args.json:
        print(json.dumps({"lens_ids": ids, "prompt": prompt}, indent=2))
    else:
        sys.stdout.write(prompt)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
