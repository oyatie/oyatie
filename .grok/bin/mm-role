#!/usr/bin/env bash
# Multi-model role dispatcher for Grok-orchestrated delivery.
# Usage:
#   mm-role <ROLE> [--cwd DIR] [--out DIR] [--prompt-file PATH | -- PROMPT...]
# Roles: PLANNER | EXECUTOR | ARCHITECT | CRITIC | SECURITY | VERIFIER
# Not merge authority. Artifacts under --out (default: .grok/mm-runs/<ts>-<role>).

set -euo pipefail

ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
ROLES_JSON="${ROOT}/.grok/multi-model-roles.json"
ROLE=""
CWD="${ROOT}"
OUT=""
PROMPT_FILE=""
PROMPT_ARGS=()
DRY_RUN=0
TIMEOUT_S=""

die() { echo "mm-role: $*" >&2; exit 2; }

usage() {
  cat <<'EOF'
Usage: mm-role <ROLE> [options] [-- prompt...]

Roles: PLANNER | EXECUTOR | ARCHITECT | CRITIC | SECURITY | VERIFIER

Options:
  --cwd DIR          Working directory (default: repo root)
  --out DIR          Artifact directory (default: .grok/mm-runs/<ts>-<role>)
  --prompt-file PATH Prompt from file
  --timeout-s N      Override role timeout seconds
  --dry-run          Print the command only
  -h, --help         Show help
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    --cwd) CWD="${2:-}"; shift 2 ;;
    --out) OUT="${2:-}"; shift 2 ;;
    --prompt-file) PROMPT_FILE="${2:-}"; shift 2 ;;
    --timeout-s) TIMEOUT_S="${2:-}"; shift 2 ;;
    --dry-run) DRY_RUN=1; shift ;;
    --) shift; PROMPT_ARGS+=("$@"); break ;;
    PLANNER|EXECUTOR|ARCHITECT|CRITIC|SECURITY|VERIFIER|planner|executor|architect|critic|security|verifier)
      ROLE="$(printf '%s' "$1" | tr '[:lower:]' '[:upper:]')"; shift ;;
    *)
      if [[ -z "$ROLE" ]]; then
        die "unknown arg or role: $1"
      fi
      PROMPT_ARGS+=("$1"); shift ;;
  esac
done

[[ -n "$ROLE" ]] || die "role required"
[[ -f "$ROLES_JSON" ]] || die "missing $ROLES_JSON"
CWD="$(cd "$CWD" && pwd)"

if [[ -n "$PROMPT_FILE" ]]; then
  [[ -f "$PROMPT_FILE" ]] || die "prompt file not found: $PROMPT_FILE"
  PROMPT="$(cat "$PROMPT_FILE")"
elif [[ ${#PROMPT_ARGS[@]} -gt 0 ]]; then
  PROMPT="${PROMPT_ARGS[*]}"
else
  if [[ ! -t 0 ]]; then
    PROMPT="$(cat)"
  else
    die "provide --prompt-file, -- prompt, or stdin"
  fi
fi

# Extract role fields
eval "$(
  python3 - "$ROLES_JSON" "$ROLE" <<'PY'
import json, sys, shlex
path, role = sys.argv[1], sys.argv[2]
data = json.load(open(path))
r = data["roles"].get(role)
if not r:
    sys.stderr.write(f"mm-role: unknown role {role}\n")
    raise SystemExit(2)
def emit(k, v):
    print(f"{k}={shlex.quote(str(v))}")
emit("MM_PROVIDER", r["provider"])
emit("MM_MODEL", r["model"])
emit("MM_CLI", r["cli"])
emit("MM_MODE", r.get("mode", "read-only"))
emit("MM_SANDBOX", r.get("sandbox", "read-only"))
emit("MM_SYSTEM", r["system"])
emit("MM_EFFORT", r.get("effort", "high"))
emit("MM_TIMEOUT", r.get("timeout_s", 1800))
emit("MM_REQUIRES_PREFLIGHT", "1" if r.get("requires_preflight_green") else "0")
PY
)"

if [[ -n "$TIMEOUT_S" ]]; then
  MM_TIMEOUT="$TIMEOUT_S"
fi

# Git provenance
HEAD_SHA="$(git -C "$CWD" rev-parse HEAD 2>/dev/null || echo unknown)"
ORIGIN_DEV_SHA="$(git -C "$CWD" rev-parse origin/dev 2>/dev/null || echo unknown)"
BRANCH="$(git -C "$CWD" branch --show-current 2>/dev/null || echo unknown)"

# EXECUTOR preflight gate: if latest preflight in mm-runs says not ok, refuse
if [[ "$ROLE" == "EXECUTOR" && "$MM_REQUIRES_PREFLIGHT" == "1" && "$DRY_RUN" -eq 0 ]]; then
  python3 - "$CWD" <<'PY' || die "EXECUTOR blocked: preflight not green (run mm-pipeline preflight / start on origin/dev lane)"
import json, sys
from pathlib import Path
cwd = Path(sys.argv[1])
runs = cwd / ".grok" / "mm-runs"
ok = False
if runs.is_dir():
    candidates = sorted(runs.glob("**/preflight.json"), key=lambda p: p.stat().st_mtime, reverse=True)
    for c in candidates[:5]:
        try:
            data = json.loads(c.read_text())
        except Exception:
            continue
        if data.get("ok") is True and data.get("cwd") in (str(cwd), str(cwd.resolve())):
            ok = True
            break
        # also accept preflight written for this repo without strict cwd match if behind==0
        if data.get("ok") is True and data.get("behind_count") == 0 and not data.get("dirty_unrelated"):
            ok = True
            break
sys.exit(0 if ok else 2)
PY
fi

TS="$(date -u +%Y%m%dT%H%M%SZ)"
if [[ -z "$OUT" ]]; then
  OUT="${ROOT}/.grok/mm-runs/${TS}-${ROLE}"
fi
mkdir -p "$OUT"

META="${OUT}/meta.json"
PROMPT_OUT="${OUT}/prompt.md"
RESULT_OUT="${OUT}/result.md"
STDOUT_OUT="${OUT}/stdout.txt"
STDERR_OUT="${OUT}/stderr.txt"
CMD_OUT="${OUT}/command.txt"
ENVELOPE="${OUT}/envelope.json"
PROMPT_HASH="$(printf '%s' "$PROMPT" | shasum -a 256 | awk '{print $1}')"

{
  echo "# Role: ${ROLE}"
  echo
  echo "## System"
  echo
  echo "${MM_SYSTEM}"
  echo
  echo "## Task"
  echo
  echo "${PROMPT}"
  echo
  echo "## Constraints"
  echo
  echo "- Provider: ${MM_PROVIDER}"
  echo "- Model: ${MM_MODEL}"
  echo "- Mode: ${MM_MODE}"
  echo "- Cwd: ${CWD}"
  echo "- Branch: ${BRANCH}"
  echo "- HEAD: ${HEAD_SHA}"
  echo "- origin/dev: ${ORIGIN_DEV_SHA}"
  echo "- Write artifacts only under the workspace; do not claim merge authority."
  echo "- Oyatie: isolated worktree lane, PR against dev, single required context oya-ci-required."
  echo "- Forbidden: git reset --hard, git stash, force-push, hand-edit *.generated.json, skip tests."
} >"$PROMPT_OUT"

python3 - "$META" "$ROLE" "$MM_PROVIDER" "$MM_MODEL" "$MM_CLI" "$MM_MODE" "$CWD" "$OUT" \
  "$HEAD_SHA" "$ORIGIN_DEV_SHA" "$BRANCH" "$PROMPT_HASH" "$MM_TIMEOUT" <<'PY'
import json, sys
(
    path, role, provider, model, cli, mode, cwd, out,
    head, origin_dev, branch, phash, timeout,
) = sys.argv[1:14]
from datetime import datetime, timezone
now = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
json.dump({
  "role": role,
  "provider": provider,
  "model": model,
  "cli": cli,
  "mode": mode,
  "cwd": cwd,
  "out": out,
  "head_sha": head,
  "origin_dev_sha": origin_dev,
  "branch": branch,
  "prompt_sha256": phash,
  "timeout_s": int(timeout),
  "started_at": now,
}, open(path, "w"), indent=2)
print(path)
PY

FULL_PROMPT="$(cat "$PROMPT_OUT")"
EXIT_CODE=0

run_with_timeout() {
  # usage: run_with_timeout cmd...
  if command -v timeout >/dev/null 2>&1; then
    timeout "${MM_TIMEOUT}" "$@"
  elif command -v gtimeout >/dev/null 2>&1; then
    gtimeout "${MM_TIMEOUT}" "$@"
  else
    "$@"
  fi
}

run_codex() {
  local sandbox="$MM_SANDBOX"
  local -a cmd=(
    codex exec
    -m "$MM_MODEL"
    -s "$sandbox"
    -C "$CWD"
    --ephemeral
    -o "$RESULT_OUT"
    --skip-git-repo-check
    -c "model_reasoning_effort=\"high\""
  )
  printf '%s\n' "${cmd[@]}" >"$CMD_OUT"
  echo "<prompt in prompt.md>" >>"$CMD_OUT"
  if [[ "$DRY_RUN" -eq 1 ]]; then
    echo "DRY-RUN: ${cmd[*]} <prompt>"
    printf '%s\n' "# dry-run\n" >"$RESULT_OUT"
    return 0
  fi
  set +e
  run_with_timeout "${cmd[@]}" "$FULL_PROMPT" >"$STDOUT_OUT" 2>"$STDERR_OUT"
  EXIT_CODE=$?
  set -e
}

run_claude() {
  local -a cmd=(
    claude
    -p
    --model "$MM_MODEL"
    --effort "$MM_EFFORT"
    --output-format text
  )
  if [[ "$MM_MODE" == "read-only" ]]; then
    cmd+=(--allowedTools "Read,Grep,Glob,Bash(git *),Bash(rg *),Bash(ls *)")
  fi
  printf '%s\n' "${cmd[@]}" >"$CMD_OUT"
  echo "<prompt in prompt.md>" >>"$CMD_OUT"
  if [[ "$DRY_RUN" -eq 1 ]]; then
    echo "DRY-RUN: ${cmd[*]} <prompt>"
    printf '%s\n' "# dry-run\n" >"$RESULT_OUT"
    return 0
  fi
  set +e
  run_with_timeout "${cmd[@]}" "$FULL_PROMPT" >"$RESULT_OUT" 2>"$STDERR_OUT"
  EXIT_CODE=$?
  set -e
  cp "$RESULT_OUT" "$STDOUT_OUT" 2>/dev/null || true
}

case "$MM_CLI" in
  codex) run_codex ;;
  claude) run_claude ;;
  *) die "unsupported cli: $MM_CLI" ;;
esac

python3 - "$META" "$ENVELOPE" "$EXIT_CODE" "$ROLE" "$MM_MODEL" "$RESULT_OUT" <<'PY'
import json, sys
from datetime import datetime, timezone
from pathlib import Path
meta_path, env_path, exit_code, role, model, result_path = sys.argv[1:7]
meta = json.load(open(meta_path))
meta["finished_at"] = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
meta["exit_code"] = int(exit_code)
json.dump(meta, open(meta_path, "w"), indent=2)
success = int(exit_code) == 0
env = {
  "success": success,
  "role": role,
  "model": model,
  "exit_code": int(exit_code),
  "result_path": result_path,
  "meta_path": meta_path,
  "duration_note": "see started_at/finished_at in meta.json",
  "schema_ok": None,
  "head_sha": meta.get("head_sha"),
  "origin_dev_sha": meta.get("origin_dev_sha"),
}
json.dump(env, open(env_path, "w"), indent=2)
print(json.dumps(env))
PY

echo "mm-role: role=${ROLE} model=${MM_MODEL} out=${OUT} exit=${EXIT_CODE}"
echo "mm-role: result=${RESULT_OUT}"
exit "$EXIT_CODE"
