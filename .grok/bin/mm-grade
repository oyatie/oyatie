#!/usr/bin/env python3
"""Map scorecard.json → grade.json + process_edits.md (deterministic loop-back)."""

from __future__ import annotations

import argparse
import json
from datetime import datetime, timezone
from pathlib import Path
from typing import Any, Dict, List


def now() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def load_json(path: Path) -> Any:
    return json.loads(path.read_text())


def write_json(path: Path, data: Any) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(data, indent=2) + "\n")


def find_repo(start: Path) -> Path:
    cur = start.resolve()
    for p in [cur, *cur.parents]:
        if (p / ".grok/harness/pipeline.json").is_file():
            return p
    return cur


def letter_for(score: float, bands: dict) -> str:
    for L in ("A", "B", "C", "D", "F"):
        if score >= float(bands.get(L, {}).get("min", 0)):
            # check from high to low
            pass
    # proper high-to-low
    ordered = sorted(
        ((L, float(bands[L]["min"])) for L in bands if L in ("A", "B", "C", "D", "F")),
        key=lambda x: -x[1],
    )
    for L, mn in ordered:
        if score >= mn:
            return L
    return "F"


def grade_scorecard(repo: Path, run_id: str, scorecard: dict | None = None) -> dict:
    run_dir = repo / ".grok" / "mm-runs" / run_id
    rubric = load_json(repo / ".grok/harness/rubrics/run-grade.v1.json")
    if scorecard is None:
        sc_path = run_dir / "scorecard.json"
        if not sc_path.is_file():
            raise SystemExit("scorecard.json missing; run mm-score first")
        scorecard = load_json(sc_path)

    dims = scorecard.get("dimensions") or {}
    weights = {k: v["weight"] for k, v in rubric.get("dimensions", {}).items()}
    # weighted average
    total_w = 0.0
    acc = 0.0
    for name, w in weights.items():
        d = dims.get(name) or {"score": 0}
        acc += float(d.get("score", 0)) * float(w)
        total_w += float(w)
    score = acc / total_w if total_w else 0.0

    hard_fails = list(scorecard.get("hard_fails") or [])
    letter = letter_for(score, rubric.get("bands") or {"F": {"min": 0}})

    # hard fail forces F
    if hard_fails:
        letter = "F"
        score = min(score, 59.99)

    # plan-only cap
    if scorecard.get("mode") == "plan_only":
        max_plan = rubric.get("plan_only_max_grade") or "B"
        order = ["F", "D", "C", "B", "A"]
        if order.index(letter) > order.index(max_plan):
            letter = max_plan

    # ship ready
    sr_cfg = rubric.get("ship_ready") or {}
    min_grade = sr_cfg.get("min_grade") or "B"
    order = ["F", "D", "C", "B", "A"]
    ship = order.index(letter) >= order.index(min_grade)
    if hard_fails:
        ship = False
    if sr_cfg.get("require_admitted_plan") and not scorecard.get("admitted_plan"):
        ship = False
    if scorecard.get("mode") == "execute":
        vh = float((dims.get("verification_honesty") or {}).get("score") or 0)
        if vh < float(sr_cfg.get("if_executed_min_verify_honesty") or 80):
            ship = False
    if letter == "F":
        ship = False

    # failure classes + loop backs
    failure_classes: List[str] = []
    loop_backs: List[dict] = []
    notes: List[str] = []

    def add(cls: str, action: str, detail: str = "") -> None:
        if cls not in failure_classes:
            failure_classes.append(cls)
        loop_backs.append({"class": cls, "action": action, "detail": detail})

    if any(h.startswith("baseline:") for h in hard_fails):
        add(
            "baseline",
            "Refuse execute; create fresh worktree from origin/dev; re-run PREFLIGHT",
            ",".join(h for h in hard_fails if h.startswith("baseline:")),
        )
    if any(h.startswith("verify:") for h in hard_fails):
        add(
            "verify_dishonest",
            "Block ADMIT_SLICE; re-run VERIFIER; process-edit EXECUTOR system prompt",
            ",".join(h for h in hard_fails if h.startswith("verify:")),
        )
    if any(h.startswith("security:") for h in hard_fails):
        add(
            "harness_bug" if "generated" in str(hard_fails) else "verify_dishonest",
            "Reject generated hand-edits; restore materialize-only policy",
            ",".join(hard_fails),
        )

    adv = float((dims.get("adversarial_rigor") or {}).get("score") or 0)
    if adv < 50 and "adversarial_weak" not in failure_classes:
        add(
            "adversarial_weak",
            "Re-run CRITIC×2 with stricter evidence requirements; block admit until both cite paths",
            f"adversarial_rigor={adv}",
        )

    sep = float((dims.get("separation_of_duties") or {}).get("score") or 0)
    if sep < 50:
        add(
            "adversarial_weak",
            "Ensure ≥2 CRITIC instances and split EXECUTOR/CRITIC contexts",
            f"separation_of_duties={sep}",
        )

    deliv = float((dims.get("delivery_effectiveness") or {}).get("score") or 0)
    if deliv < 40 and scorecard.get("admitted_plan"):
        add(
            "delivery_miss",
            "Feed dual-confirmed P0/P1 findings into PLANNER as mandatory coverage",
            f"delivery_effectiveness={deliv}",
        )
    elif deliv < 40 and not scorecard.get("admitted_plan"):
        add(
            "delivery_miss",
            "Complete PLAN + dual CRITIC + ADMIT_PLAN before treating delivery as covered",
            f"delivery_effectiveness={deliv}",
        )

    if letter in ("A", "B") and not hard_fails:
        notes.append("No mandatory process loop-back; optional polish only")
    elif letter == "C":
        notes.append("Conditional: apply top process_edits before re-execute")
    elif letter in ("D", "F"):
        notes.append("Blocked or weak: fix process/harness before expanding delivery scope")

    notes.append("SHIP-READY is journal-only; merge authority remains reviewer APPROVE + oya-ci-required")

    grade = {
        "run_id": run_id,
        "letter": letter,
        "score": round(score, 2),
        "ship_ready": ship,
        "hard_fails": hard_fails,
        "failure_classes": failure_classes,
        "loop_backs": loop_backs,
        "notes": notes,
        "mode": scorecard.get("mode"),
        "dimension_scores": {k: v.get("score") for k, v in dims.items()},
        "graded_at": now(),
    }

    write_json(run_dir / "grade.json", grade)

    # process_edits.md
    lines = [
        f"# Process edits for run `{run_id}`",
        "",
        f"- grade: **{letter}** ({grade['score']})",
        f"- ship_ready: {ship}",
        f"- mode: {scorecard.get('mode')}",
        f"- graded_at: {grade['graded_at']}",
        "",
        "## Hard fails",
        "",
    ]
    if hard_fails:
        for h in hard_fails:
            lines.append(f"- `{h}`")
    else:
        lines.append("- (none)")
    lines += ["", "## Loop-backs (Bun: edit the loop)", ""]
    if loop_backs:
        for lb in loop_backs:
            lines.append(f"### `{lb['class']}`")
            lines.append("")
            lines.append(f"- action: {lb['action']}")
            if lb.get("detail"):
                lines.append(f"- detail: {lb['detail']}")
            lines.append("")
    else:
        lines.append("- none required")
        lines.append("")
    lines += [
        "## Dimension scores",
        "",
    ]
    for k, v in (grade.get("dimension_scores") or {}).items():
        lines.append(f"- {k}: {v}")
    lines += [
        "",
        "## Rules",
        "",
        "- Do not hand-fix symptoms only; patch harness prompts/admit rules when a class repeats.",
        "- Models do not self-assign grades; re-run `mm-score` / `mm-grade` after changes.",
        "- Not merge authority.",
        "",
    ]
    (run_dir / "process_edits.md").write_text("\n".join(lines))

    # append KPI ledger
    ledger = repo / ".grok" / "mm-runs" / "_ledger"
    ledger.mkdir(parents=True, exist_ok=True)
    kpi_line = {
        "ts": now(),
        "run_id": run_id,
        "letter": letter,
        "score": grade["score"],
        "ship_ready": ship,
        "hard_fails": hard_fails,
        "failure_classes": failure_classes,
        "mode": scorecard.get("mode"),
    }
    with (ledger / "kpi.jsonl").open("a") as f:
        f.write(json.dumps(kpi_line) + "\n")

    return grade


def main() -> int:
    ap = argparse.ArgumentParser(description="Grade multi-model harness run")
    ap.add_argument("--cwd", default=".")
    ap.add_argument("--run-id", required=True)
    ap.add_argument("--score-first", action="store_true", help="run mm-score before grade")
    args = ap.parse_args()
    repo = find_repo(Path(args.cwd))

    if args.score_first:
        import subprocess
        import sys

        r = subprocess.run(
            [str(repo / ".grok/bin/mm-score"), "--cwd", str(repo), "--run-id", args.run_id],
            check=False,
        )
        if r.returncode != 0:
            return r.returncode

    grade = grade_scorecard(repo, args.run_id)
    print(json.dumps(grade, indent=2))
    # exit 0 always for successful grading; non-zero if F optional?
    # Use 0 so automation can read JSON; callers check letter.
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
