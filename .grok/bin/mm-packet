#!/usr/bin/env python3
"""R3 post-merge product-completion packet automation.

Fill AGENTS post-merge product-completion packet fields from a MERGED PR
or a promoted SHA after trunk `oya-ci-required` is SUCCESS on the exact
promoted commit.

Not merge authority. Does not claim ultragoal complete.
Does not edit product oya-ci-required workflows.

Usage:
  .grok/bin/mm-packet --pr 1559 --program cas-fabric
  .grok/bin/mm-packet --pr 1559 --dry-run
  .grok/bin/mm-packet --sha a4a5ace5… --program cas-fabric --pr 1559
  .grok/bin/mm-drive packet --pr 1559   # same surface via mm-drive

Fail-closed (exit 2) when:
  - PR is not MERGED (or merge commit missing)
  - trunk oya-ci-required is not SUCCESS on the exact promoted SHA
"""

from __future__ import annotations

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path
from typing import Any, Dict, List, Optional, Tuple

TEMPLATE_REF = "programs/hyperscaler-delivery-lanes/R3-postmerge-packet-template.md"
PACKET_TYPE = "post_merge_product_completion"
AUTHORITY = (
    "Not merge authority; post-merge product gate evidence only. "
    "Does not claim ultragoal complete. Filled only after squash to origin/dev + "
    "post-merge oya-ci-required green on promoted SHA (PR-head green is not enough)."
)
OYA_CI_NAME = "oya-ci-required"
RUN_URL_RE = re.compile(
    r"(https://github\.com/[^/]+/[^/]+/actions/runs/\d+)"
)


def now() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def find_grok(start: Path) -> Path:
    cur = start.resolve()
    for p in [cur, *cur.parents]:
        g = p / ".grok"
        if (g / "harness" / "pipeline.json").is_file() or (g / "bin").is_dir():
            return g
    return cur / ".grok"


def gh_available() -> bool:
    return shutil.which("gh") is not None


def run_gh(args: List[str], timeout: int = 45) -> Tuple[int, str, str]:
    try:
        p = subprocess.run(
            ["gh", *args],
            capture_output=True,
            text=True,
            timeout=timeout,
        )
        return p.returncode, p.stdout or "", p.stderr or ""
    except (OSError, subprocess.TimeoutExpired) as e:
        return 1, "", str(e)


def run_git(args: List[str], cwd: Optional[Path] = None, timeout: int = 30) -> Tuple[int, str, str]:
    try:
        p = subprocess.run(
            ["git", *args],
            capture_output=True,
            text=True,
            timeout=timeout,
            cwd=str(cwd) if cwd else None,
        )
        return p.returncode, (p.stdout or "").strip(), p.stderr or ""
    except (OSError, subprocess.TimeoutExpired) as e:
        return 1, "", str(e)


def normalize_run_url(url: str) -> str:
    if not url:
        return ""
    m = RUN_URL_RE.search(url)
    if m:
        return m.group(1)
    # strip /job/<id> suffix if present without full match
    if "/actions/runs/" in url and "/job/" in url:
        return url.split("/job/")[0]
    return url


def query_merged_pr(pr: int, timeout: int = 45) -> dict:
    """Return merge metadata for PR. ok=False with reasons on fail."""
    if not gh_available():
        return {"ok": False, "reasons": ["gh_not_found"]}
    code, out, err = run_gh(
        [
            "pr",
            "view",
            str(pr),
            "--json",
            "number,state,title,mergedAt,mergeCommit,baseRefName,headRefOid,url,author",
        ],
        timeout=timeout,
    )
    if code != 0:
        return {
            "ok": False,
            "reasons": [f"gh_pr_view_failed:{(err or out or '').strip()[:200]}"],
        }
    try:
        data = json.loads(out)
    except json.JSONDecodeError:
        return {"ok": False, "reasons": ["gh_json_decode_failed"]}

    state = str(data.get("state") or "").upper()
    reasons: List[str] = []
    if state != "MERGED":
        reasons.append(f"pr_not_merged:{state or 'unknown'}")

    merge_commit = data.get("mergeCommit") or {}
    oid = ""
    if isinstance(merge_commit, dict):
        oid = str(merge_commit.get("oid") or "")
    if not oid and state == "MERGED":
        reasons.append("merge_commit_missing")

    base = str(data.get("baseRefName") or "")
    if base and base != "dev":
        # soft note only — still allow if merged + CI green; record base
        pass

    author = ""
    if isinstance(data.get("author"), dict):
        author = str(data["author"].get("login") or "")

    return {
        "ok": len(reasons) == 0,
        "reasons": reasons,
        "pr": int(data.get("number") or pr),
        "state": state,
        "title": str(data.get("title") or ""),
        "merged_at": str(data.get("mergedAt") or ""),
        "promoted_commit": oid,
        "base_ref": base or "dev",
        "head_ref_oid": str(data.get("headRefOid") or ""),
        "url": str(data.get("url") or ""),
        "author": author,
    }


def query_pr_for_sha(sha: str, timeout: int = 45) -> Optional[dict]:
    """Best-effort: find a merged PR associated with commit SHA."""
    if not gh_available() or not sha:
        return None
    code, out, err = run_gh(
        [
            "api",
            f"repos/{{owner}}/{{repo}}/commits/{sha}/pulls",
            "--jq",
            (
                '[.[] | {number,state,title,merged_at:.merged_at,'
                'base:.base.ref,url:.html_url}]'
            ),
        ],
        timeout=timeout,
    )
    if code != 0 or not out.strip():
        return None
    try:
        items = json.loads(out)
    except json.JSONDecodeError:
        return None
    if not isinstance(items, list) or not items:
        return None
    # Prefer merged (API often returns state=closed with merged_at) + base dev
    def is_merged(i: dict) -> bool:
        st = str(i.get("state") or "").upper()
        if st == "MERGED":
            return True
        if st == "CLOSED" and i.get("merged_at"):
            return True
        return bool(i.get("merged_at"))

    merged = [i for i in items if isinstance(i, dict) and is_merged(i)]
    pick = None
    for i in merged:
        if str(i.get("base") or "") == "dev":
            pick = i
            break
    if pick is None and merged:
        pick = merged[0]
    if pick is None:
        pick = items[0] if isinstance(items[0], dict) else None
    return pick


def query_oya_ci_required(sha: str, timeout: int = 45) -> dict:
    """Locate oya-ci-required check-run on exact SHA. Fail-closed if not SUCCESS."""
    if not gh_available():
        return {"ok": False, "reasons": ["gh_not_found"], "status": "missing"}
    if not re.fullmatch(r"[0-9a-fA-F]{7,40}", sha or ""):
        return {"ok": False, "reasons": ["invalid_sha"], "status": "missing"}

    # Prefer check-runs (GitHub Actions required context)
    code, out, err = run_gh(
        [
            "api",
            f"repos/{{owner}}/{{repo}}/commits/{sha}/check-runs?per_page=100",
            "--jq",
            (
                '[.check_runs[] | select(.name=="oya-ci-required") | '
                "{name,status,conclusion,html_url,details_url,head_sha,completed_at}]"
            ),
        ],
        timeout=timeout,
    )
    runs: List[dict] = []
    if code == 0 and out.strip():
        try:
            parsed = json.loads(out)
            if isinstance(parsed, list):
                runs = [r for r in parsed if isinstance(r, dict)]
        except json.JSONDecodeError:
            runs = []

    # Also try commit status contexts (legacy)
    if not runs:
        code2, out2, _e2 = run_gh(
            [
                "api",
                f"repos/{{owner}}/{{repo}}/commits/{sha}/status",
                "--jq",
                (
                    '{state:.state, statuses:[.statuses[] | select(.context=="oya-ci-required") | '
                    "{context,state,target_url,description,updated_at}]}"
                ),
            ],
            timeout=timeout,
        )
        if code2 == 0 and out2.strip():
            try:
                st = json.loads(out2)
                for s in st.get("statuses") or []:
                    if not isinstance(s, dict):
                        continue
                    state = str(s.get("state") or "").lower()
                    conc = {
                        "success": "success",
                        "failure": "failure",
                        "error": "failure",
                        "pending": "pending",
                    }.get(state, state)
                    runs.append(
                        {
                            "name": OYA_CI_NAME,
                            "status": "completed" if state in ("success", "failure", "error") else state,
                            "conclusion": conc,
                            "html_url": s.get("target_url") or "",
                            "details_url": s.get("target_url") or "",
                            "head_sha": sha,
                            "completed_at": s.get("updated_at") or "",
                        }
                    )
            except json.JSONDecodeError:
                pass

    if not runs:
        return {
            "ok": False,
            "reasons": ["oya_ci_required_missing_on_promoted_sha"],
            "status": "missing",
            "head_sha": sha,
            "run_url": "",
            "completed_at": "",
            "raw": {"check_runs_query_stderr": (err or "")[:200]},
        }

    # Prefer SUCCESS completed; else newest completed
    def rank(r: dict) -> Tuple[int, str]:
        conc = str(r.get("conclusion") or "").lower()
        st = str(r.get("status") or "").lower()
        score = 0
        if conc == "success" and st in ("completed", ""):
            score = 3
        elif st == "completed":
            score = 2
        elif st in ("in_progress", "queued", "pending"):
            score = 1
        return (score, str(r.get("completed_at") or ""))

    best = sorted(runs, key=rank, reverse=True)[0]
    conc = str(best.get("conclusion") or "").lower()
    st = str(best.get("status") or "").lower()
    head = str(best.get("head_sha") or sha)
    run_url = normalize_run_url(
        str(best.get("html_url") or best.get("details_url") or "")
    )
    completed_at = str(best.get("completed_at") or "")
    # normalize Zulu
    if completed_at.endswith("+00:00"):
        completed_at = completed_at.replace("+00:00", "Z")
    if completed_at and not completed_at.endswith("Z") and "T" in completed_at:
        # leave as-is if other timezone
        pass

    reasons: List[str] = []
    if head and sha and not (
        head.lower() == sha.lower()
        or head.lower().startswith(sha.lower())
        or sha.lower().startswith(head.lower()[:12])
    ):
        # exact promoted SHA required
        if head.lower() != sha.lower():
            reasons.append(f"oya_ci_head_sha_mismatch:got={head}")
    if conc != "success":
        reasons.append(f"oya_ci_required_not_success:{conc or st or 'unknown'}")
    if st and st not in ("completed", "") and conc != "success":
        reasons.append(f"oya_ci_required_status:{st}")

    status_out = "success" if conc == "success" else (conc or st or "unknown")
    return {
        "ok": len(reasons) == 0,
        "reasons": reasons,
        "status": status_out,
        "run_url": run_url,
        "head_sha": head or sha,
        "completed_at": completed_at,
        "check_name": OYA_CI_NAME,
    }


def origin_dev_tip(repo: Path) -> Tuple[Optional[str], Optional[str]]:
    """Return (tip_sha, note). Fetches optionally when MM_PACKET_FETCH=1."""
    if os.environ.get("MM_PACKET_FETCH", "").strip() in ("1", "true", "yes"):
        run_git(["fetch", "origin", "dev", "--quiet"], cwd=repo, timeout=60)
    code, out, err = run_git(["rev-parse", "origin/dev"], cwd=repo, timeout=15)
    if code == 0 and out:
        return out.strip(), None
    code2, out2, _e2 = run_git(["rev-parse", "dev"], cwd=repo, timeout=15)
    if code2 == 0 and out2:
        return out2.strip(), "used_local_dev_not_origin"
    return None, (err or "origin_dev_unresolved")[:200]


def default_out_path(grok: Path, program: str, pr: Optional[int], sha: str) -> Path:
    prog = (program or "hyperscaler-delivery-lanes").strip().strip("/")
    # allow program=cas-fabric or programs/cas-fabric
    if prog.startswith("programs/"):
        prog = prog[len("programs/") :]
    stem = f"{pr}-post-merge-completion-packet.json" if pr else f"{sha[:12]}-post-merge-completion-packet.json"
    return grok / "programs" / prog / "evidence" / stem


def load_existing_packet(path: Path) -> Optional[dict]:
    if not path.is_file():
        return None
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
        return data if isinstance(data, dict) else None
    except (OSError, json.JSONDecodeError):
        return None


HUMAN_KEYS = (
    "rollout_verification",
    "rollback_note",
    "observability_check",
    "browser_user_story_evidence",
    "release_governance_release_note_impact",
)


def build_packet(
    *,
    pr_meta: dict,
    oya: dict,
    human: dict,
    existing: Optional[dict],
    mark_closed: bool,
    origin_tip: Optional[str],
    tip_note: Optional[str],
) -> dict:
    pr = pr_meta.get("pr")
    promoted = str(pr_meta.get("promoted_commit") or "")
    title = str(pr_meta.get("title") or "")
    branch = str(pr_meta.get("base_ref") or "dev") or "dev"

    # Preserve human narrative fields from existing packet when not overridden
    def pick(key: str, default: str = "") -> str:
        if key in human and human[key] is not None and str(human[key]).strip() != "":
            return str(human[key])
        if existing and str(existing.get(key) or "").strip():
            return str(existing.get(key))
        return default

    harvest_existing = (existing or {}).get("agent_observation_harvest") or {}
    if not isinstance(harvest_existing, dict):
        harvest_existing = {}
    harvest_cards = human.get("harvest_cards")
    if harvest_cards is None or str(harvest_cards).strip() == "":
        harvest_cards = harvest_existing.get("cards_created_or_linked") or ""
    harvest_rationale = human.get("harvest_rationale")
    if harvest_rationale is None or str(harvest_rationale).strip() == "":
        harvest_rationale = harvest_existing.get("rationale") or ""

    tip_eq = None
    if origin_tip and promoted:
        tip_eq = origin_tip.lower() == promoted.lower()

    packet: Dict[str, Any] = {
        "packet_type": PACKET_TYPE,
        "pr": pr,
        "title": title,
        "promoted_commit": promoted,
        "branch": branch if branch == "dev" else branch,
        "oya_ci_required": {
            "status": oya.get("status") or "unknown",
            "run_url": oya.get("run_url") or "",
            "head_sha": oya.get("head_sha") or promoted,
            "completed_at": oya.get("completed_at") or "",
        },
        "rollout_verification": pick("rollout_verification"),
        "rollback_note": pick("rollback_note"),
        "observability_check": pick("observability_check"),
        "browser_user_story_evidence": pick("browser_user_story_evidence"),
        "release_governance_release_note_impact": pick(
            "release_governance_release_note_impact"
        ),
        "agent_observation_harvest": {
            "cards_created_or_linked": str(harvest_cards or ""),
            "rationale": str(harvest_rationale or ""),
        },
        # Never auto-close as product-complete without explicit --closed.
        # Even with --closed, ultragoal is never claimed complete by this tool.
        "completion_packet_closed": False,
        "recorded_at": now(),
        "template_ref": TEMPLATE_REF,
        "authority": AUTHORITY,
        "ultragoal_complete": False,
        "merge_method": "squash",
        "pr_state": str(pr_meta.get("state") or "MERGED"),
        "promoted_at": str(pr_meta.get("merged_at") or ""),
        "automation": {
            "tool": "mm-packet",
            "generated_at": now(),
            "not_merge_authority": True,
            "does_not_claim_ultragoal_complete": True,
            "origin_dev_tip": origin_tip,
            "origin_dev_tip_equals_promoted": tip_eq,
            "origin_dev_tip_note": tip_note,
            "pr_url": pr_meta.get("url") or "",
        },
    }

    if mark_closed:
        # Only allow closed when machine gates already passed (caller enforces)
        # and human fields are non-empty (or were preserved from existing).
        missing_human = [k for k in HUMAN_KEYS if not str(packet.get(k) or "").strip()]
        harvest = packet["agent_observation_harvest"]
        if not str(harvest.get("cards_created_or_linked") or "").strip() and not str(
            harvest.get("rationale") or ""
        ).strip():
            missing_human.append("agent_observation_harvest")
        if missing_human:
            packet["completion_packet_closed"] = False
            packet["automation"]["closed_refused_missing_human_fields"] = missing_human
        else:
            packet["completion_packet_closed"] = True

    return packet


def build_from_args(args: argparse.Namespace) -> Tuple[dict, int]:
    """Return (result_json, exit_code). exit 2 = fail-closed gate."""
    grok = find_grok(Path(args.cwd))
    repo = grok.parent if grok.name == ".grok" else Path(args.cwd).resolve()
    timeout = int(args.timeout or 45)
    reasons: List[str] = []

    pr: Optional[int] = int(args.pr) if args.pr is not None else None
    sha = (args.sha or "").strip()

    pr_meta: dict = {
        "ok": False,
        "reasons": [],
        "pr": pr,
        "state": "",
        "title": "",
        "merged_at": "",
        "promoted_commit": "",
        "base_ref": "dev",
        "url": "",
    }

    if pr is not None:
        pr_meta = query_merged_pr(pr, timeout=timeout)
        reasons.extend(pr_meta.get("reasons") or [])
        if not sha:
            sha = str(pr_meta.get("promoted_commit") or "")
        elif pr_meta.get("promoted_commit") and sha:
            # if both provided, promoted must match merge commit (allow prefix)
            mc = str(pr_meta["promoted_commit"]).lower()
            s = sha.lower()
            if not (mc == s or mc.startswith(s) or s.startswith(mc[:12])):
                reasons.append(
                    f"sha_does_not_match_merge_commit:arg={sha},merge={pr_meta['promoted_commit']}"
                )
            else:
                sha = str(pr_meta["promoted_commit"])
        if pr_meta.get("promoted_commit"):
            sha = str(pr_meta["promoted_commit"])
    elif sha:
        # SHA-only path: require CI on that SHA; try to attach PR metadata
        found = query_pr_for_sha(sha, timeout=timeout)
        if found:
            pr = int(found.get("number") or 0) or None
            # commits/{sha}/pulls returns state "closed" for merged PRs;
            # treat closed+merged_at (or MERGED) as promoted.
            raw_state = str(found.get("state") or "").upper()
            merged_at = str(found.get("merged_at") or "")
            if raw_state == "MERGED" or (raw_state == "CLOSED" and merged_at):
                state = "MERGED"
            else:
                state = raw_state
            pr_meta = {
                "ok": True,
                "reasons": [],
                "pr": pr,
                "state": state,
                "title": str(found.get("title") or ""),
                "merged_at": merged_at,
                "promoted_commit": sha,
                "base_ref": str(found.get("base") or "dev"),
                "url": str(found.get("url") or ""),
            }
            if state != "MERGED":
                reasons.append(f"pr_not_merged:{state or 'unknown'}")
                pr_meta["ok"] = False
        else:
            pr_meta = {
                "ok": True,  # SHA path without PR is allowed if CI green
                "reasons": [],
                "pr": None,
                "state": "SHA_ONLY",
                "title": args.title or "",
                "merged_at": "",
                "promoted_commit": sha,
                "base_ref": "dev",
                "url": "",
            }
    else:
        return (
            {
                "ok": False,
                "reasons": ["require_pr_or_sha"],
                "ultragoal_complete": False,
                "authority": AUTHORITY,
            },
            1,
        )

    if not sha:
        if "promoted_commit_unresolved" not in reasons and not any(
            r.startswith("pr_not_merged:") for r in reasons
        ):
            reasons.append("promoted_commit_unresolved")
        elif not sha and any(r.startswith("pr_not_merged:") for r in reasons):
            # unmerged PRs have no merge commit; keep a single explicit reason
            if "merge_commit_missing" not in reasons:
                reasons.append("merge_commit_missing")

    oya = (
        query_oya_ci_required(sha, timeout=timeout)
        if sha
        else {
            "ok": False,
            "reasons": [],  # already covered by pr/merge reasons
            "status": "missing",
            "run_url": "",
            "head_sha": "",
            "completed_at": "",
        }
    )
    reasons.extend(oya.get("reasons") or [])
    # de-dupe reasons preserve order
    _seen = set()
    _uniq: List[str] = []
    for r in reasons:
        if r not in _seen:
            _seen.add(r)
            _uniq.append(r)
    reasons = _uniq

    tip, tip_note = origin_dev_tip(repo)

    human = {
        "rollout_verification": args.rollout_verification or "",
        "rollback_note": args.rollback_note or "",
        "observability_check": args.observability_check or "",
        "browser_user_story_evidence": args.browser_user_story or "",
        "release_governance_release_note_impact": args.release_impact or "",
        "harvest_cards": args.harvest_cards or "",
        "harvest_rationale": args.harvest_rationale or "",
    }
    # Convenience: --class docs-only fills a short rollout note if empty
    if args.rollout_class and not human["rollout_verification"]:
        cls = args.rollout_class.strip()
        human["rollout_verification"] = (
            f"{cls}: verified promoted squash commit on trunk; "
            f"post-merge oya-ci-required success on exact promoted SHA."
        )

    out_path = (
        Path(args.out).resolve()
        if args.out
        else default_out_path(grok, args.program or "", pr, sha or "unknown")
    )
    existing = None if args.no_merge_existing else load_existing_packet(out_path)

    gate_ok = len(reasons) == 0
    packet = build_packet(
        pr_meta={**pr_meta, "promoted_commit": sha},
        oya=oya,
        human=human,
        existing=existing,
        mark_closed=bool(args.closed) and gate_ok,
        origin_tip=tip,
        tip_note=tip_note,
    )

    result: Dict[str, Any] = {
        "ok": gate_ok,
        "reasons": reasons,
        "pr": pr,
        "promoted_commit": sha,
        "oya_ci_required": packet.get("oya_ci_required"),
        "out": str(out_path),
        "dry_run": bool(args.dry_run),
        "written": False,
        "packet": packet,
        "ultragoal_complete": False,
        "authority": AUTHORITY,
        "next": (
            "packet ready (machine fields). Fill human narrative fields if empty, "
            "then re-run with --closed when 1–8 verified. "
            "Do NOT close ultragoal from this tool alone."
            if gate_ok
            else "fail-closed: fix merge/trunk CI before recording packet as evidence"
        ),
    }

    if not gate_ok:
        return result, 2

    if args.dry_run:
        return result, 0

    if out_path.is_file() and not args.force and existing is not None:
        # Overwrite is allowed when re-query succeeds (R3 re-verify); force only for
        # refusing accidental clobber when MM_PACKET_NO_CLOBBER=1
        if os.environ.get("MM_PACKET_NO_CLOBBER", "").strip() in ("1", "true", "yes"):
            result["ok"] = False
            result["reasons"] = ["out_exists_set_force_or_unset_MM_PACKET_NO_CLOBBER"]
            return result, 1

    out_path.parent.mkdir(parents=True, exist_ok=True)
    out_path.write_text(json.dumps(packet, indent=2) + "\n", encoding="utf-8")
    result["written"] = True
    return result, 0


def build_arg_parser() -> argparse.ArgumentParser:
    ap = argparse.ArgumentParser(
        description=(
            "R3 post-merge product-completion packet automation "
            "(not merge authority; never claims ultragoal complete)"
        )
    )
    ap.add_argument("--cwd", default=".", help="repo / worktree root (finds .grok)")
    ap.add_argument("--pr", type=int, default=None, help="merged PR number")
    ap.add_argument(
        "--sha",
        default="",
        help="promoted commit SHA (defaults to PR merge commit when --pr set)",
    )
    ap.add_argument(
        "--program",
        default="",
        help="program id under .grok/programs/ (default: hyperscaler-delivery-lanes)",
    )
    ap.add_argument(
        "--out",
        default="",
        help="output JSON path (default: .grok/programs/<program>/evidence/<pr>-post-merge-completion-packet.json)",
    )
    ap.add_argument("--dry-run", action="store_true", help="print packet JSON; do not write")
    ap.add_argument(
        "--force",
        action="store_true",
        help="allow overwrite when MM_PACKET_NO_CLOBBER=1",
    )
    ap.add_argument(
        "--closed",
        action="store_true",
        help="set completion_packet_closed=true only if gates pass and human fields present",
    )
    ap.add_argument(
        "--no-merge-existing",
        action="store_true",
        help="do not preserve human fields from an existing packet at --out",
    )
    ap.add_argument("--timeout", type=int, default=45)
    ap.add_argument("--title", default="", help="title override for --sha without PR")
    ap.add_argument(
        "--rollout-class",
        default="",
        help="short class (docs-only|runtime|governance|build-time|other) for rollout stub",
    )
    ap.add_argument("--rollout-verification", default="")
    ap.add_argument("--rollback-note", default="")
    ap.add_argument("--observability-check", default="")
    ap.add_argument("--browser-user-story", default="")
    ap.add_argument("--release-impact", default="")
    ap.add_argument("--harvest-cards", default="")
    ap.add_argument("--harvest-rationale", default="")
    ap.add_argument(
        "--json",
        action="store_true",
        help="accepted for CLI symmetry; output is always JSON",
    )
    return ap


def main(argv: Optional[List[str]] = None) -> int:
    ap = build_arg_parser()
    args = ap.parse_args(argv)
    result, code = build_from_args(args)
    print(json.dumps(result, indent=2))
    return code


if __name__ == "__main__":
    raise SystemExit(main())
