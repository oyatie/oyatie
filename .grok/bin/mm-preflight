#!/usr/bin/env python3
"""PREFLIGHT: enforce project-profile base_ref cleanliness for harness lanes.

Fail closed when behind base_ref or when unrelated dirty paths exist.
base_ref defaults from .grok/harness/project-profile.v1.json (vcs.base_ref),
else origin/dev.
Exit 0 only when ok=true (or --json-always with ok reflected in payload).
"""

from __future__ import annotations

import argparse
import json
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path
from typing import List, Optional, Sequence


DEFAULT_ALLOW_PREFIXES = (
    ".grok/",
    ".gitignore",  # harness may append mm-runs ignore
)

DEFAULT_ALLOW_EXACT = {
    ".gitignore",
}


def run(cmd: Sequence[str], cwd: Path) -> str:
    p = subprocess.run(
        list(cmd),
        cwd=str(cwd),
        text=True,
        capture_output=True,
        check=False,
    )
    if p.returncode != 0:
        raise RuntimeError(
            f"command failed ({p.returncode}): {' '.join(cmd)}\n{p.stderr.strip()}"
        )
    return p.stdout.strip()


def git_lines(cmd: Sequence[str], cwd: Path) -> List[str]:
    out = run(cmd, cwd)
    if not out:
        return []
    return [ln for ln in out.splitlines() if ln.strip()]


def porcelain_path(line: str) -> str:
    """Extract path from `git status --porcelain` line."""
    line = line.rstrip("\n")
    if line.startswith("?? "):
        return line[3:].strip().strip('"')
    # Standard short format: two status chars, space, path (optional rename "a -> b")
    if len(line) >= 4 and line[2] == " ":
        rest = line[3:]
        if " -> " in rest:
            rest = rest.split(" -> ", 1)[1]
        return rest.strip().strip('"')
    # Fallback: last field
    parts = line.split(maxsplit=1)
    return (parts[-1] if parts else line).strip().strip('"')


def is_allowlisted(path_line: str, allow_prefixes: Sequence[str]) -> bool:
    p = porcelain_path(path_line)
    if p in DEFAULT_ALLOW_EXACT:
        return True
    for pref in allow_prefixes:
        if p == pref.rstrip("/") or p.startswith(pref):
            return True
    return False


def load_profile_base_ref(cwd: Path) -> str:
    prof = cwd / ".grok" / "harness" / "project-profile.v1.json"
    if not prof.is_file():
        # walk up for monorepo / worktree layouts
        for p in [cwd, *cwd.parents]:
            cand = p / ".grok" / "harness" / "project-profile.v1.json"
            if cand.is_file():
                prof = cand
                break
    if prof.is_file():
        try:
            data = json.loads(prof.read_text())
            ref = ((data.get("vcs") or {}).get("base_ref") or "").strip()
            if ref:
                return ref
        except Exception:
            pass
    return "origin/dev"


def fetch_base_ref(cwd: Path, base_ref: str) -> Optional[str]:
    """Fetch remote tip for refs like origin/dev → git fetch origin dev."""
    if not base_ref.startswith("origin/"):
        return None  # local ref; nothing to fetch
    remote = "origin"
    branch = base_ref[len("origin/") :]
    if not branch:
        return f"invalid base_ref {base_ref}"
    p = subprocess.run(
        ["git", "fetch", remote, branch],
        cwd=str(cwd),
        text=True,
        capture_output=True,
        check=False,
    )
    if p.returncode != 0:
        return f"git fetch {remote} {branch} failed: {p.stderr.strip()[:200]}"
    return None


def preflight(
    cwd: Path,
    base_ref: str = "origin/dev",
    fetch: bool = True,
    allow_diverged: bool = False,
    allow_prefixes: Sequence[str] = DEFAULT_ALLOW_PREFIXES,
) -> dict:
    blockers: List[str] = []
    if fetch:
        err = fetch_base_ref(cwd, base_ref)
        if err:
            blockers.append(err)

    try:
        base_sha = run(["git", "rev-parse", base_ref], cwd)
        head_sha = run(["git", "rev-parse", "HEAD"], cwd)
        behind = int(run(["git", "rev-list", "--count", f"HEAD..{base_ref}"], cwd) or "0")
        ahead = int(run(["git", "rev-list", "--count", f"{base_ref}..HEAD"], cwd) or "0")
        branch = run(["git", "branch", "--show-current"], cwd)
        dirty = git_lines(["git", "status", "--porcelain"], cwd)
    except RuntimeError as e:
        blockers.append(str(e))
        base_sha = head_sha = branch = ""
        behind = ahead = -1
        dirty = []

    allowlisted = []
    unrelated = []
    for d in dirty:
        if is_allowlisted(d, allow_prefixes):
            allowlisted.append(d)
        else:
            unrelated.append(d)

    if behind > 0 and not allow_diverged:
        blockers.append(
            f"behind {base_ref} by {behind} commits; create a fresh worktree from {base_ref}"
        )
    if behind > 0 and allow_diverged:
        blockers.append(
            f"allow_diverged set but still behind {base_ref} by {behind}; EXECUTOR remains blocked"
        )
    if unrelated:
        blockers.append(
            f"unrelated dirty paths ({len(unrelated)}); clean lane or allowlist only .grok/"
        )

    # EXECUTOR-blocking conditions even with allow_diverged:
    execute_blocked = behind > 0 or bool(unrelated) or bool(blockers)

    ok = len([b for b in blockers if "allow_diverged" not in b]) == 0 and behind == 0 and not unrelated
    # simplify: ok means ready for full pipeline including execute
    ok = behind == 0 and not unrelated and not any(
        "fetch" in b or "command failed" in b for b in blockers
    )

    result = {
        "ok": ok,
        "base_sha": base_sha,
        "origin_dev_sha": base_sha,  # backward-compatible alias
        "head_sha": head_sha,
        "behind_count": max(behind, 0) if behind >= 0 else behind,
        "ahead_count": max(ahead, 0) if ahead >= 0 else ahead,
        "dirty_paths": dirty,
        "dirty_unrelated": unrelated,
        "allowlisted_dirty": allowlisted,
        "base_ref": base_ref,
        "branch": branch,
        "cwd": str(cwd),
        "allow_diverged": allow_diverged,
        "execute_blocked": execute_blocked or not ok,
        "blockers": blockers if not ok else [],
        "checked_at": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
    }
    if not ok and not result["blockers"]:
        result["blockers"] = ["preflight failed"]
    return result


def main() -> int:
    ap = argparse.ArgumentParser(description="Multi-model harness PREFLIGHT")
    ap.add_argument("--cwd", default=".", help="repo cwd")
    ap.add_argument(
        "--base-ref",
        default="",
        help="git ref to be not-behind (default: project-profile vcs.base_ref or origin/dev)",
    )
    ap.add_argument("--no-fetch", action="store_true")
    ap.add_argument("--allow-diverged", action="store_true")
    ap.add_argument("--out", default="", help="write JSON to path")
    ap.add_argument("--json-always", action="store_true", help="print JSON even on failure")
    args = ap.parse_args()

    cwd = Path(args.cwd).resolve()
    base_ref = args.base_ref.strip() or load_profile_base_ref(cwd)
    result = preflight(
        cwd=cwd,
        base_ref=base_ref,
        fetch=not args.no_fetch,
        allow_diverged=args.allow_diverged,
    )

    text = json.dumps(result, indent=2)
    if args.out:
        out = Path(args.out)
        out.parent.mkdir(parents=True, exist_ok=True)
        out.write_text(text + "\n")
    if result["ok"] or args.json_always:
        print(text)
    else:
        print(text, file=sys.stderr)
        for b in result.get("blockers", []):
            print(f"mm-preflight: BLOCKED: {b}", file=sys.stderr)

    return 0 if result["ok"] else 2


if __name__ == "__main__":
    sys.exit(main())
