#!/usr/bin/env bash
# preflight-ci-infra — R4 local assist for CI / admission-plane PRs.
#
# Lives under .grok/bin (harness). Do NOT add equivalents under infra/* (reorg target).
#
# Run BEFORE git push when the branch touches GitHub workflows, cloud-ci gates,
# infra/ci|arc paths, or ci/facade admission code. Writes a receipt that
# mm-drive merge-check enforces for CI-infra PRs (agents cannot skip).
#
# Usage:
#   .grok/bin/preflight-ci-infra [--base origin/dev] [--pr N] [--skip-buck]
#                                [--receipt PATH] [--json]
#                                [--allow-cwd-not-pr-head]
#   mm-drive preflight-ci --pr N
#
# When --pr N is set (default agent path), cwd HEAD MUST equal
# `gh pr view N --json headRefOid` or the tool exits 1 with ok:false receipt.
# That is intentional process enforcement: receipts from wrong trees are a
# systematic agent bug (Bun: fix the harness, not the operator memory).
# Override with --allow-cwd-not-pr-head only for local non-receipt experiments.
#
# Exit codes:
#   0 = ok (or no CI-infra paths → skip with ok receipt)
#   1 = failed checks (do not push) OR cwd/PR head mismatch
#   2 = usage / environment error
#
# Not merge authority: oya-ci-required remains sole protected context (ADR-0515).

set -euo pipefail

BASE_REF="${PREFLIGHT_BASE:-origin/dev}"
PR_NUM=""
SKIP_BUCK=0
RECEIPT=""
JSON_OUT=0
REQUIRE_BUCK="${PREFLIGHT_REQUIRE_BUCK:-0}"
# Process fix (Bun: edit the harness, not hero rebases): receipts minted on wrong trees
# (stale primary, clean tip, wrong worktree) caused merge-check head_mismatch and false
# confidence. When --pr is set, cwd HEAD MUST equal the PR head SHA unless explicitly waived.
ALLOW_CWD_NOT_PR_HEAD="${PREFLIGHT_ALLOW_CWD_NOT_PR_HEAD:-0}"

usage() {
  sed -n '2,28p' "$0" | sed 's/^# \{0,1\}//'
  exit 2
}

while [ $# -gt 0 ]; do
  case "$1" in
    --base) BASE_REF="$2"; shift 2 ;;
    --pr) PR_NUM="$2"; shift 2 ;;
    --skip-buck) SKIP_BUCK=1; shift ;;
    --receipt) RECEIPT="$2"; shift 2 ;;
    --json) JSON_OUT=1; shift ;;
    --require-buck) REQUIRE_BUCK=1; shift ;;
    --allow-cwd-not-pr-head) ALLOW_CWD_NOT_PR_HEAD=1; shift ;;
    -h|--help) usage ;;
    *) echo "unknown arg: $1" >&2; usage ;;
  esac
done

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || {
  echo "preflight-ci-infra: not a git repository" >&2
  exit 2
}
cd "$REPO_ROOT"

if ! git rev-parse --verify "${BASE_REF}" >/dev/null 2>&1; then
  echo "preflight-ci-infra: base ${BASE_REF} missing — run: git fetch origin dev" >&2
  exit 2
fi

HEAD_SHA="$(git rev-parse HEAD)"
HEAD12="$(git rev-parse --short=12 HEAD)"

# ── Process gate: --pr requires cwd at that PR's head (fail-closed) ─────
# Agents repeatedly ran preflight on origin/dev tip or cas-live-proof dirty
# trees, producing ok:true receipts that mm-drive correctly rejected as
# head_mismatch. Fix the tool, not the operator memory.
if [ -n "$PR_NUM" ] && [ "$ALLOW_CWD_NOT_PR_HEAD" != "1" ]; then
  if ! command -v gh >/dev/null 2>&1; then
    echo "preflight-ci-infra: gh required when --pr is set (to resolve headRefOid)" >&2
    exit 2
  fi
  PR_HEAD="$(gh pr view "$PR_NUM" --json headRefOid -q .headRefOid 2>/dev/null || true)"
  if [ -z "$PR_HEAD" ]; then
    echo "preflight-ci-infra: cannot resolve head for PR #${PR_NUM} — is gh auth/repo correct?" >&2
    exit 2
  fi
  if [ "$HEAD_SHA" != "$PR_HEAD" ]; then
    echo "preflight-ci-infra: PROCESS FAIL — cwd HEAD != PR #${PR_NUM} head" >&2
    echo "  cwd HEAD:  ${HEAD_SHA}" >&2
    echo "  PR head:   ${PR_HEAD}" >&2
    echo "  Fix: checkout the PR worktree at that SHA (git worktree add … origin/<branch>)," >&2
    echo "       then re-run: .grok/bin/preflight-ci-infra --pr ${PR_NUM}" >&2
    echo "  Do NOT run preflight from clean tip / dirty primary / unrelated worktree." >&2
    echo "  This is a process gate (Bun: fix harness, not operator memory)." >&2
    echo "  Override only for local non-receipt experiments: --allow-cwd-not-pr-head" >&2
    # Write a fail receipt so agents cannot paper over with a stale ok file from another tree
    mkdir -p "$(dirname "${RECEIPT:-$REPO_ROOT/.grok/programs/hyperscaler-delivery-lanes/evidence/preflight-ci-infra-pr-${PR_NUM}.json}")"
    FAIL_RECEIPT="${RECEIPT:-$REPO_ROOT/.grok/programs/hyperscaler-delivery-lanes/evidence/preflight-ci-infra-pr-${PR_NUM}.json}"
    python3 - "$FAIL_RECEIPT" "$HEAD_SHA" "$PR_HEAD" "$PR_NUM" <<'PY'
import json, sys
from datetime import datetime, timezone
path, cwd_head, pr_head, pr = sys.argv[1:5]
open(path, "w", encoding="utf-8").write(json.dumps({
  "schema": "preflight-ci-infra.v1",
  "ok": False,
  "head": cwd_head,
  "expected_pr_head": pr_head,
  "base": None,
  "pr": int(pr) if pr.isdigit() else None,
  "ci_infra_paths": [],
  "checks": [{"id": "cwd_is_pr_head", "ok": False,
              "detail": f"cwd HEAD {cwd_head[:12]} != PR head {pr_head[:12]} — run from PR worktree"}],
  "process_gate": "cwd_must_equal_pr_head",
  "written_at": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
  "tool": ".grok/bin/preflight-ci-infra",
  "not_claiming": ["merge_authority", "oya_ci_required", "ultragoal_complete", "CAS_warm", "RE"],
}, indent=2) + "\n")
print(f"fail-receipt → {path}", file=sys.stderr)
PY
    exit 1
  fi
  # Matched — record for success receipt (log_pass runs after CHECKS init)
  EXPECTED_PR_HEAD="$PR_HEAD"
  CWD_IS_PR_HEAD_OK=1
else
  EXPECTED_PR_HEAD=""
  CWD_IS_PR_HEAD_OK=0
fi

# Paths that historically force FULL / admission thrash when wrong.
is_ci_infra_path() {
  case "$1" in
    .github/workflows/*|infra/ci/*|infra/arc/*|ci/facade/*|cloud/cloud-ci/*|oya-ci.toml) return 0 ;;
    *) return 1 ;;
  esac
}

# Bash 3.2 compatible (macOS /bin/bash): no mapfile.
CHANGED_FILE="$(mktemp "${TMPDIR:-/tmp}/preflight-ci-changed.XXXXXX")"
{
  git diff --name-only --diff-filter=ACMR "${BASE_REF}...HEAD" 2>/dev/null || true
  git diff --name-only --diff-filter=ACMR HEAD 2>/dev/null || true
  git diff --name-only --cached --diff-filter=ACMR 2>/dev/null || true
} | sed '/^$/d' | sort -u >"$CHANGED_FILE"

CI_PATHS=()
while IFS= read -r f || [ -n "$f" ]; do
  [ -z "$f" ] && continue
  if is_ci_infra_path "$f"; then
    CI_PATHS+=("$f")
  fi
done <"$CHANGED_FILE"
rm -f "$CHANGED_FILE"
DEFAULT_RECEIPT="${REPO_ROOT}/.grok/programs/hyperscaler-delivery-lanes/evidence/preflight-ci-infra-latest.json"
if [ -n "$PR_NUM" ]; then
  DEFAULT_RECEIPT="${REPO_ROOT}/.grok/programs/hyperscaler-delivery-lanes/evidence/preflight-ci-infra-pr-${PR_NUM}.json"
fi
RECEIPT="${RECEIPT:-$DEFAULT_RECEIPT}"

CHECKS=()
FAIL=0
log_pass() { CHECKS+=("{\"id\":\"$1\",\"ok\":true,\"detail\":$(python3 -c 'import json,sys; print(json.dumps(sys.argv[1]))' "$2")}"); echo "PASS  $1 — $2"; }
log_fail() { CHECKS+=("{\"id\":\"$1\",\"ok\":false,\"detail\":$(python3 -c 'import json,sys; print(json.dumps(sys.argv[1]))' "$2")}"); echo "FAIL  $1 — $2" >&2; FAIL=1; }
log_skip() { CHECKS+=("{\"id\":\"$1\",\"ok\":true,\"skipped\":true,\"detail\":$(python3 -c 'import json,sys; print(json.dumps(sys.argv[1]))' "$2")}"); echo "SKIP  $1 — $2"; }

write_receipt() {
  local ok_flag="$1"
  mkdir -p "$(dirname "$RECEIPT")"
  local checks_json
  if [ ${#CHECKS[@]} -eq 0 ]; then
    checks_json="[]"
  else
    checks_json="[$(IFS=,; echo "${CHECKS[*]}")]"
  fi
  local paths_json
  paths_json="$(printf '%s\n' "${CI_PATHS[@]:-}" | python3 -c 'import json,sys; print(json.dumps([l.strip() for l in sys.stdin if l.strip()]))')"
  python3 - "$RECEIPT" "$ok_flag" "$HEAD_SHA" "$BASE_REF" "$PR_NUM" "$paths_json" "$checks_json" "${EXPECTED_PR_HEAD:-}" <<'PY'
import json, sys
from datetime import datetime, timezone
path, ok_s, head, base, pr, paths_json, checks_json, expected_pr_head = sys.argv[1:9]
receipt = {
  "schema": "preflight-ci-infra.v1",
  "ok": ok_s == "true",
  "head": head,
  "base": base,
  "pr": int(pr) if pr.isdigit() else None,
  "ci_infra_paths": json.loads(paths_json),
  "checks": json.loads(checks_json),
  "written_at": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
  "tool": ".grok/bin/preflight-ci-infra",
  "not_claiming": ["merge_authority", "oya_ci_required", "ultragoal_complete", "CAS_warm", "RE"],
}
if expected_pr_head:
  receipt["expected_pr_head"] = expected_pr_head
  receipt["process_gate"] = "cwd_must_equal_pr_head"
open(path, "w", encoding="utf-8").write(json.dumps(receipt, indent=2) + "\n")
print(f"receipt → {path}")
PY
}

# Process gate evidence on success path when --pr matched
if [ -n "$PR_NUM" ] && [ "${CWD_IS_PR_HEAD_OK:-0}" = "1" ]; then
  log_pass "cwd_is_pr_head" "cwd HEAD equals PR #${PR_NUM} headRefOid"
elif [ -n "$PR_NUM" ] && [ "$ALLOW_CWD_NOT_PR_HEAD" = "1" ]; then
  log_skip "cwd_is_pr_head" "waived via --allow-cwd-not-pr-head (non-receipt experiments only)"
fi

if [ ${#CI_PATHS[@]} -eq 0 ]; then
  log_skip "scope" "no CI-infra paths vs ${BASE_REF}; preflight not required"
  write_receipt true
  if [ "$JSON_OUT" = 1 ]; then
    cat "$RECEIPT"
  else
    echo "preflight-ci-infra: SKIP (no CI-infra paths) head=${HEAD12}"
  fi
  exit 0
fi

echo "preflight-ci-infra: ${#CI_PATHS[@]} CI-infra path(s) vs ${BASE_REF} head=${HEAD12}"
printf '  - %s\n' "${CI_PATHS[@]}"

# ── Static: no hand-edited generated faces in the change set ───────────
GEN_HIT=0
for f in "${CI_PATHS[@]}"; do
  case "$f" in
    *.generated.json)
      GEN_HIT=1
      log_fail "no_hand_edit_generated" "diff includes $f — materialize via sanctioned script/gate only"
      ;;
  esac
done
if [ "$GEN_HIT" = 0 ]; then
  log_pass "no_hand_edit_generated" "no *.generated.json in CI-infra path set"
fi

# ── Static: RUSTUP_HOME unbound-safe if workflow / install-buck2 / gate_registration touched ──
RUSTUP_TOUCH=0
for f in "${CI_PATHS[@]}"; do
  case "$f" in
    .github/workflows/oya-ci-required.yml|infra/ci/install-buck2.sh|ci/facade/baseline-ratchet/tests/gate_registration.rs)
      RUSTUP_TOUCH=1
      ;;
  esac
done
if [ "$RUSTUP_TOUCH" = 1 ]; then
  if [ -f .github/workflows/oya-ci-required.yml ]; then
    if grep -qE 'RUSTUP_HOME:.*\$\{RUSTUP_HOME:-\$\{HOME\}/\.rustup\}|RUSTUP_HOME:.*\$\{\{ env\.RUSTUP_HOME' .github/workflows/oya-ci-required.yml \
      || grep -q 'RUSTUP_HOME' .github/workflows/oya-ci-required.yml; then
      # Prefer default form used on hosted GHA
      if grep -qE '\$\{RUSTUP_HOME:-\$\{HOME\}/\.rustup\}|RUSTUP_HOME: \$\{HOME\}/\.rustup|RUSTUP_HOME: /home/runner/\.rustup' .github/workflows/oya-ci-required.yml \
        || grep -q 'RUSTUP_HOME' infra/ci/install-buck2.sh 2>/dev/null; then
        log_pass "rustup_home_hosted" "workflow/install-buck2 reference RUSTUP_HOME (hosted-safe form expected)"
      else
        log_fail "rustup_home_hosted" "RUSTUP_HOME touched but hosted default form not found"
      fi
    else
      log_fail "rustup_home_hosted" "CI shell steps may use RUSTUP_HOME under set -u without default"
    fi
  else
    log_skip "rustup_home_hosted" "workflow missing in tree"
  fi
else
  log_skip "rustup_home_hosted" "RUSTUP surfaces not in path set"
fi

# ── Static: ARC optional mount contract when runner values change ──────
if printf '%s\n' "${CI_PATHS[@]}" | grep -q 'infra/arc/runner-scale-set-arm64-values.yaml'; then
  OPT_COUNT="$(grep -cE 'optional:[[:space:]]*true' infra/arc/runner-scale-set-arm64-values.yaml || true)"
  if [ "${OPT_COUNT}" -ge 2 ]; then
    log_pass "arc_optional_mounts" "optional:true count=${OPT_COUNT} (capacity test must match)"
  else
    log_fail "arc_optional_mounts" "unexpected optional:true count=${OPT_COUNT}"
  fi
else
  log_skip "arc_optional_mounts" "arm64 values not in path set"
fi

# ── Static: soft multi-arch continue-on-error present if workflow touched ──
if printf '%s\n' "${CI_PATHS[@]}" | grep -q '^\.github/workflows/oya-ci-required\.yml$'; then
  if grep -q 'continue-on-error: \${{ matrix.soft }}' .github/workflows/oya-ci-required.yml \
    || grep -q 'continue-on-error: ${{ matrix.soft }}' .github/workflows/oya-ci-required.yml; then
    log_pass "soft_multiarch" "matrix.soft continue-on-error present"
  else
    log_fail "soft_multiarch" "workflow touch without matrix.soft continue-on-error — soft windows must not bind fan-in"
  fi
  if grep -q 'fail-fast: false' .github/workflows/oya-ci-required.yml; then
    log_pass "matrix_fail_fast_false" "platform matrix fail-fast: false (surface-all)"
  else
    log_fail "matrix_fail_fast_false" "platform matrix should use fail-fast: false"
  fi
else
  log_skip "soft_multiarch" "oya-ci-required.yml not in path set"
fi

# ── Buck unit targets (cheap vs FULL cone) ─────────────────────────────
have_buck=0
if command -v buck2 >/dev/null 2>&1; then
  have_buck=1
fi

run_buck_test() {
  local label="$1"
  local target="$2"
  if [ "$SKIP_BUCK" = 1 ]; then
    log_skip "$label" " --skip-buck"
    return 0
  fi
  if [ "$have_buck" != 1 ]; then
    if [ "$REQUIRE_BUCK" = 1 ]; then
      log_fail "$label" "buck2 not on PATH and --require-buck set"
    else
      log_skip "$label" "buck2 not on PATH (set PREFLIGHT_REQUIRE_BUCK=1 to fail closed)"
    fi
    return 0
  fi
  echo "RUN   buck2 test ${target}"
  if buck2 test "${target}" 2>&1; then
    log_pass "$label" "buck2 test ${target}"
  else
    log_fail "$label" "buck2 test ${target} failed"
  fi
}

NEED_CAPACITY=0
NEED_GATE_REG=0
NEED_FRESHNESS=0
for f in "${CI_PATHS[@]}"; do
  case "$f" in
    infra/arc/*) NEED_CAPACITY=1 ;;
    .github/workflows/*|infra/ci/install-buck2.sh|ci/facade/baseline-ratchet/*) NEED_GATE_REG=1 ;;
    ci/facade/generated-artifact-freshness/*|infra/ci/materialize-cloud-ci-generated-faces.sh) NEED_FRESHNESS=1 ;;
  esac
done

if [ "$NEED_CAPACITY" = 1 ]; then
  run_buck_test "buck_capacity" "//infra/arc:ci-workspace-capacity-test"
else
  log_skip "buck_capacity" "infra/arc not in path set"
fi

if [ "$NEED_GATE_REG" = 1 ]; then
  run_buck_test "buck_gate_registration" "//ci/facade/baseline-ratchet:ci-baseline-ratchet-gate-registration"
else
  log_skip "buck_gate_registration" "workflow/install-buck2/gate_registration not in path set"
fi

if [ "$NEED_FRESHNESS" = 1 ]; then
  run_buck_test "buck_freshness" "//ci/facade/generated-artifact-freshness:ci-generated-artifact-freshness-unittest"
else
  log_skip "buck_freshness" "freshness/materialize paths not in path set"
fi

if [ "$FAIL" = 1 ]; then
  write_receipt false
  echo "preflight-ci-infra: FAILED — do not push; fix queue above, re-run once." >&2
  echo "Discipline: batch all local reds before one push (cancel-in-progress kills FULL mid-run)." >&2
  exit 1
fi

write_receipt true
if [ "$JSON_OUT" = 1 ]; then
  cat "$RECEIPT"
else
  echo "preflight-ci-infra: OK head=${HEAD12} receipt=${RECEIPT}"
  echo "Next: dual-critic re-head → ONE push → wait for complete oya-ci-required (no mid-run push)."
fi
exit 0
