#!/usr/bin/env python3
"""Quantitative / ML / RL workers for the single mm-delivery pipeline.

Wraps .grok/python/mm_ml and optionally Developer/harness (process_metrics,
mm_bridge, router). Not merge authority; suggestions are human-gated.

Usage:
  mm-quant process --write
  mm-quant reward --run-id <id> --write
  mm-quant bandit --write
  mm-quant learn-hook --run-id <id>
  mm-quant route-prior --task-class implementation --language rust
"""

from __future__ import annotations

import sys
from pathlib import Path


def main() -> int:
    here = Path(__file__).resolve()
    grok = here.parent.parent
    py = grok / "python"
    if str(py) not in sys.path:
        sys.path.insert(0, str(py))
    from mm_ml.cli import main as cli_main

    return int(cli_main())


if __name__ == "__main__":
    raise SystemExit(main())
