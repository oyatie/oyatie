{
  "version": "1.0.0",
  "name": "mm-run-grade",
  "description": "Deterministic run scoring for multi-model harness. Missing evidence scores 0 (fail closed).",
  "bands": {
    "A": { "min": 90, "label": "excellent" },
    "B": { "min": 80, "label": "ship_ready_draft" },
    "C": { "min": 70, "label": "conditional" },
    "D": { "min": 60, "label": "weak" },
    "F": { "min": 0, "label": "blocked" }
  },
  "ship_ready": {
    "min_grade": "B",
    "require_admitted_plan": true,
    "require_no_hard_fail": true,
    "if_executed_min_verify_honesty": 80,
    "never_claims_merge_authority": true
  },
  "plan_only_max_grade": "B",
  "dimensions": {
    "baseline_integrity": {
      "weight": 0.15,
      "hard_fail_if_below": 100,
      "note": "Hard-fail entire run if preflight not fully green (behind or unrelated dirty)"
    },
    "separation_of_duties": { "weight": 0.10 },
    "adversarial_rigor": { "weight": 0.15 },
    "verification_honesty": {
      "weight": 0.15,
      "hard_fail_on_test_skip": true
    },
    "contract_discipline": { "weight": 0.10 },
    "security_supply_chain": { "weight": 0.10 },
    "delivery_effectiveness": { "weight": 0.20 },
    "harness_operability": { "weight": 0.05 }
  },
  "loop_back": {
    "max_auto_retries": 3,
    "promote_process_edit_after_repeats": 2,
    "classes": [
      "baseline",
      "adversarial_weak",
      "verify_dishonest",
      "scope_creep",
      "delivery_miss",
      "harness_bug"
    ]
  },
  "process_edit_triggers": [
    "skip test",
    "skipping test",
    "#[ignore]",
    "tests skipped",
    "delete the test",
    "weaken the gate",
    "stub out",
    "hand-edit generated",
    ".generated.json"
  ]
}
