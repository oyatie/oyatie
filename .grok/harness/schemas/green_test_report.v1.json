{
  "$id": "green_test_report.v1",
  "type": "object",
  "required": ["schema", "suite_commands", "proof_passed", "same_suite_as_red"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "green_test_report.v1" },
    "suite_commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["cmd", "exit_code", "expect_zero"],
        "properties": {
          "cmd": { "type": "string" },
          "exit_code": { "type": "integer" },
          "expect_zero": { "const": true }
        }
      }
    },
    "proof_passed": { "type": "boolean" },
    "same_suite_as_red": {
      "type": "boolean",
      "description": "Commands must match RED suite (or strict superset documented)"
    },
    "red_report_ref": { "type": "string" }
  }
}
