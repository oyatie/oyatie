{
  "$id": "verify_report.v1",
  "type": "object",
  "required": ["commands", "fail_closed", "summary"],
  "properties": {
    "summary": { "type": "string" },
    "fail_closed": { "type": "boolean" },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["cmd", "expect"],
        "properties": {
          "cmd": { "type": "string" },
          "expect": { "type": "string" },
          "exit_code": { "type": ["integer", "null"] },
          "ran": { "type": "boolean" }
        }
      }
    },
    "skipped_tests": { "type": "boolean" }
  }
}
