{
  "$id": "preflight.v1",
  "type": "object",
  "required": [
    "ok",
    "origin_dev_sha",
    "head_sha",
    "behind_count",
    "ahead_count",
    "dirty_paths",
    "dirty_unrelated",
    "base_ref",
    "checked_at"
  ],
  "properties": {
    "ok": { "type": "boolean" },
    "origin_dev_sha": { "type": "string", "minLength": 7 },
    "head_sha": { "type": "string", "minLength": 7 },
    "behind_count": { "type": "integer", "minimum": 0 },
    "ahead_count": { "type": "integer", "minimum": 0 },
    "dirty_paths": { "type": "array", "items": { "type": "string" } },
    "dirty_unrelated": { "type": "array", "items": { "type": "string" } },
    "allowlisted_dirty": { "type": "array", "items": { "type": "string" } },
    "base_ref": { "type": "string" },
    "branch": { "type": "string" },
    "cwd": { "type": "string" },
    "allow_diverged": { "type": "boolean" },
    "blockers": { "type": "array", "items": { "type": "string" } },
    "checked_at": { "type": "string" }
  }
}
