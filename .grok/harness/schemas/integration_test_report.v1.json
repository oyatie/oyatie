{
  "$id": "integration_test_report.v1",
  "type": "object",
  "required": ["schema", "commands", "boundaries_covered", "all_passed"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "integration_test_report.v1" },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["cmd", "exit_code"],
        "properties": {
          "cmd": { "type": "string" },
          "exit_code": { "type": "integer" }
        }
      }
    },
    "boundaries_covered": {
      "type": "array",
      "items": { "type": "string" },
      "description": "e.g. API↔domain, gate↔fixture, schema↔CLI"
    },
    "all_passed": { "type": "boolean" },
    "waiver": {
      "type": "string",
      "description": "Only if integration truly N/A for pure docs; must not be used to skip product code"
    }
  }
}
