{
  "$id": "goals.v1",
  "type": "object",
  "required": ["run_id", "created_at", "objective", "goals", "status"],
  "properties": {
    "run_id": { "type": "string" },
    "created_at": { "type": "string" },
    "objective": { "type": "string" },
    "risk": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["active", "blocked", "complete", "aborted"]
    },
    "goals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "objective", "status"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "objective": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["pending", "active", "complete", "failed", "blocked"]
          },
          "lens_pack": { "type": "array", "items": { "type": "string" } },
          "role": { "type": "string" },
          "evidence": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
