{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hardened_prompt.v1",
  "title": "Mechanically enhanced prompt for instruction-following",
  "type": "object",
  "required": [
    "schema",
    "objective",
    "success_criteria",
    "non_goals",
    "constraints",
    "authority",
    "verification",
    "ambiguities_resolved",
    "ambiguities_open",
    "source_intent_ref"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "hardened_prompt.v1" },
    "source_intent_ref": { "type": "string" },
    "objective": {
      "type": "string",
      "minLength": 1,
      "description": "Single clear objective statement (what done looks like)"
    },
    "why_now": { "type": "string" },
    "actors": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Who benefits / who operates day-2"
    },
    "success_criteria": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "non_goals": {
      "type": "array",
      "items": { "type": "string" }
    },
    "constraints": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Hard constraints (branch, merge authority, no hand-edit generated, kit rules)"
    },
    "authority": {
      "type": "object",
      "required": ["base_ref", "pr_target", "required_status_context", "not_merge_authority"],
      "properties": {
        "base_ref": { "type": "string" },
        "pr_target": { "type": "string" },
        "required_status_context": { "type": "string" },
        "not_merge_authority": { "type": "boolean" },
        "kit_required": { "type": "boolean" }
      }
    },
    "verification": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" },
      "description": "Concrete commands or checks that prove success"
    },
    "risk": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"]
    },
    "blast_radius": { "type": "string" },
    "ambiguities_resolved": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["question", "assumption"],
        "properties": {
          "question": { "type": "string" },
          "assumption": { "type": "string" },
          "confidence": { "type": "string", "enum": ["low", "medium", "high"] }
        }
      }
    },
    "ambiguities_open": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Must block execute if non-empty and risk high/critical without human gate"
    },
    "instruction_pack": {
      "type": "string",
      "description": "Full prompt text for downstream roles (mechanical render)"
    },
    "hardening_model": {
      "type": "object",
      "properties": {
        "provider": { "type": "string" },
        "model": { "type": "string" },
        "role": { "type": "string" }
      }
    }
  }
}
