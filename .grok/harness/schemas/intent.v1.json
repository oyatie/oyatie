{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "intent.v1",
  "title": "Raw user intent capture",
  "type": "object",
  "required": ["raw_prompt", "captured_at", "source"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "intent.v1" },
    "raw_prompt": { "type": "string", "minLength": 1 },
    "captured_at": { "type": "string" },
    "source": {
      "type": "string",
      "enum": ["user_chat", "cli", "mm_goals", "scheduler", "other"]
    },
    "risk_hint": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical", "unknown"]
    },
    "context_refs": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Paths, PR numbers, ADRs, goals cited by the user"
    },
    "constraints_stated": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
