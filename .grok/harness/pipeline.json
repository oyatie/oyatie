  "admit_rules": {
    "dual_critic_both_must_confirm": true,
    "missing_evidence_is_reject": true,
    "test_skip_is_reject": true,
    "generated_face_hand_edit_is_reject": true,
    "behind_origin_dev_blocks_execute": true,
    "require_hardened_prompt_before_plan": true,
    "require_work_graph_before_dispatch": true,
    "path_overlap_blocks_parallel_dispatch": true,
    "open_ambiguities_block_high_risk_execute": true,
    "require_red_test_proof_before_implement": true,
    "require_green_same_suite_as_red": true,
    "skipped_tests_is_reject": true,
    "weakened_assert_is_reject": true,
    "deleted_red_test_is_reject": true,
    "require_false_green_scan_clean": true,
    "require_simplify_and_harden_or_explicit_waiver": true
  },
  "improvement_loop": {
    "entry": "PROMPT_SUBMIT \u2192 CAPTURE_INTENT \u2192 PROMPT_HARDEN \u2192 DECOMPOSE \u2192 DISPATCH \u2192 PREFLIGHT \u2192 \u2026",
    "after_run": [
      "SCORE_GRADE",
      "LEARN",
      "POSTMORTEM"
    ],
    "edit_surface": "harness/*.v1.json + pipeline.json stages + multi-model-roles.json",
    "anti_pattern": "new workflow file per lane/program; free-form execute from raw chat",
    "forbid_raw_execute": true,
    "doctrine": "programs/INTENT-LIFECYCLE.md"
  },
  "self_improvement": {
    "always_learn": true,
    "process_edit_on_classes": [
      "F-SAME-FAMILY-CRITIC-LAUNDER",
      "F-CI-PUSH-THRASH",
      "F-KIT-NOT-ON-DEV",
      "F-WORKTREE-MISSING-KIT",
      "F-BABYSIT-WITHOUT-MM-DRIVE",
      "F-STATIC-EVAL-FALSE-GREEN",
      "raw_execute_without_harden"
    ],
    "promote_skills_human_gated": true
  },
  "implement_loop": {
    "sequence": [
      "RED_TEST",
      "IMPLEMENT",
      "GREEN_TEST",
      "INTEGRATION_TEST",
      "FALSE_GREEN_SCAN",
      "REVIEW_DIFF",
      "SECURITY_DIFF",
      "SIMPLIFY",
      "HARDEN",
      "VERIFY",
      "ADMIT_SLICE"
    ],
    "tdd_required": true,
    "forbid_implement_without_red_proof": true,
    "forbid_delete_or_skip_failing_tests": true,
    "re_run_green_after_simplify_and_harden": true,
    "doctrine": "programs/IMPLEMENT-LIFECYCLE.md"
  }
}
