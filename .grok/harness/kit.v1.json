{
  "version": "1.0.0",
  "name": "mm-delivery-kit",
  "description": "Portable multi-agent delivery harness. One pipeline (harness/pipeline.json); fine-tune JSON under harness/ only. No gjc/omc/omx/hermes CLIs.",
  "forbidden_clis": ["gjc", "omc", "omx", "hermes"],
  "axioms": [
    "not_merge_authority",
    "judgment_weight_before_speed",
    "independence_engineered",
    "deterministic_admit_and_score",
    "edit_process_not_only_symptom",
    "single_pipeline_improve_over_time",
    "single_fine_tune_surface",
    "repo_portable",
    "base_ref_clean_execute",
    "no_forbidden_clis",
    "vertical_slices_ship_value"
  ],
  "configs": [
    "harness/kit.v1.json",
    "harness/project-profile.v1.json",
    "harness/lenses.v1.json",
    "harness/stage-lens-packs.v1.json",
    "harness/model-routing.v1.json",
    "harness/learning-loop.v1.json",
    "harness/evaluation.v1.json",
    "harness/parallelism.v1.json",
    "harness/quantitative-methods.v1.json",
    "harness/drive.v1.json",
    "harness/DRIVE.md",
    "harness/pipeline.json",
    "harness/safety.md",
    "harness/dod-checklist.json",
    "harness/LIFECYCLE-AND-GAPS.md",
    "harness/rubrics/run-grade.v1.json",
    "multi-model-roles.json"
  ],
  "pipeline": "harness/pipeline.json",
  "workflows": [
    "workflows/lens-delivery-plan.rhai"
  ],
  "python_workers": {
    "package": "python/mm_ml",
    "runner": "bin/mm-quant",
    "optional_requirements": "python/requirements-ml.txt",
    "external_harness": "/Users/jasonlee/Developer/harness"
  },
  "drive": {
    "runner": "bin/mm-drive",
    "config": "harness/drive.v1.json",
    "stop_hook": "hooks/mm-drive-stop.json",
    "note": "Ultragoal/Ralph outer loop; same pipeline, not a second product"
  },
  "bins": [
    "bin/mm-bootstrap",
    "bin/mm-drive",
    "bin/mm-evaluate",
    "bin/mm-goals",
    "bin/mm-grade",
    "bin/mm-learn",
    "bin/mm-lens-prompt",
    "bin/mm-paths",
    "bin/mm-pipeline",
    "bin/mm-preflight",
    "bin/mm-prompt",
    "bin/mm-quant",
    "bin/mm-role",
    "bin/mm-score",
    "bin/mm-sync-workflow-prompts"
  ],
  "note": "Single pipeline: pipeline.json SSOT. Outer drive: mm-drive + Stop hook. Plan face: lens-delivery-plan.rhai only. Quant: mm-quant + optional Developer/harness. No per-lane workflows; no gjc/omc/omx/hermes.",
  "evaluate_slo": {
    "static_min_letter": "B",
    "static_min_score": 80
  },
  "run_journal": {
    "root": "mm-runs/<run_id>/",
    "required_on_start": ["run.json", "preflight.json"],
    "optional": [
      "goals.json",
      "ledger.jsonl",
      "scorecard.json",
      "grade.json",
      "process_edits.md",
      "workflow-evaluation.md",
      "trajectory.jsonl",
      "findings.json",
      "evidence/admission-packet.md"
    ]
  }
}
