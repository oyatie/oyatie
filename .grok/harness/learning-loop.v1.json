{
  "version": "1.0.0",
  "description": "Hermes-inspired closed learning loop — without Hermes CLI. Skills and memories are repo-local under .grok/.",
  "inspired_by": [
    "https://github.com/nousresearch/hermes-agent (learning loop, skills, memory, trajectories)",
    "https://bun.com/blog/bun-in-rust (edit the process, dual adversarial)",
    "https://blog.gaebal-gajae.dev/archive.html (Daily Reflection / Setup Tip lanes)"
  ],
  "lanes": {
    "daily_reflection": {
      "purpose": "What was judged, fixed, learned; failure examples",
      "path_template": ".grok/memory/reflections/{date}.md"
    },
    "setup_tip": {
      "purpose": "Reusable operational prescription (process edit)",
      "path_template": ".grok/memory/tips/{slug}.md"
    },
    "behind": {
      "purpose": "Direction changes, philosophy, non-day-scoped judgment",
      "path_template": ".grok/memory/behind/{slug}.md"
    },
    "skill": {
      "purpose": "Procedural skill extracted from successful runs (agentskills-shaped)",
      "path_template": ".grok/skills/{name}/SKILL.md"
    }
  },
  "triggers": {
    "after_grade_lt": "B",
    "after_hard_fail": true,
    "after_repeat_failure_class": 2,
    "after_ship_ready": false
  },
  "kpi_repeat_detector": {
    "version": "1.0.0",
    "description": "Slice 3.1 — scan mm-runs/_ledger/kpi.jsonl; when a failure_class count meets threshold, emit human-gated promote suggestions. Never auto-edits packs (F-LEARN-NOT-AUTO-PROMOTED).",
    "threshold": 2,
    "ledger": "mm-runs/_ledger/kpi.jsonl",
    "suggest_promote": true,
    "auto_promote_packs": false,
    "write_suggest_artifact": true,
    "promote_surfaces": [
      "harness/stage-lens-packs.v1.json",
      "multi-model-roles.json",
      "harness/pipeline.json",
      "harness/model-routing.v1.json"
    ],
    "cli": "mm-learn kpi-repeat",
    "from_run_hook": true
  },
  "actions": {
    "write_process_edits": true,
    "append_kpi_ledger": true,
    "propose_skill_draft": true,
    "run_kpi_repeat_detector": true,
    "nudge_memory": "After complex tasks, record one tip or reflection; do not invent work when verified empty."
  },
  "verified_empty_is_work": true,
  "trajectory": {
    "store_under": ".grok/mm-runs/{run_id}/trajectory.jsonl",
    "compress_to": ".grok/memory/trajectories/{run_id}.md"
  },
  "toolsets": {
    "read_only": ["read_file", "grep", "list_dir", "git_read"],
    "workspace_write": ["read_file", "grep", "list_dir", "search_replace", "run_tests"],
    "forbidden_global": ["gjc", "omc", "omx", "hermes"]
  }
}
