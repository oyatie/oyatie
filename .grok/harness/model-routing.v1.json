  "complexity_axes": [
    "reasoning",
    "ambiguity",
    "blast_radius",
    "adversarial",
    "tool_loop"
  ],
  "rules": [
    {
      "when": {
        "task_class": "scout_recon"
      },
      "then": {
        "require_preset": "composer-2.5",
        "forbid_edits": true
      }
    },
    {
      "when": {
        "task_class": [
          "architect",
          "planning",
          "ralplan"
        ]
      },
      "then": {
        "require_preset": "claude-fable-5-thinking-max"
      }
    },
    {
      "when": {
        "judgment_weight_gte": 4
      },
      "then": {
        "forbid_effort_below": "high",
        "require_dual_critic": true,
        "prefer_quality_preset": "claude-fable-5-thinking-max",
        "forbid_presets_as_escalation": [
          "gpt-5.6-terra-xhigh",
          "gpt-5.6-luna-max"
        ]
      }
    },
    {
      "when": {
        "blast_surface": [
          "merge-admission-required",
          "oya-ci-required",
          "human_admit"
        ]
      },
      "then": {
        "require_dual_critic": true,
        "require_security": true,
        "human_admit": true,
        "prefer_quality_preset": "claude-fable-5-thinking-max",
        "critic_preset": "claude-opus-5-thinking-high"
      }
    },
    {
      "when": {
        "task_class": "mechanical",
        "judgment_weight_lte": 2
      },
      "then": {
        "allow_presets": [
          "cursor-grok-4.5-high",
          "gpt-5.6-terra-xhigh",
          "gpt-5.6-luna-max"
        ]
      }
    },
    {
      "when": {
        "independence_required": true
      },
      "then": {
        "critic_provider_ne_executor_provider": true
      }
    },
    {
      "when": {
        "model_slug_contains": "-fast"
      },
      "then": {
        "forbid": true,
        "reason": "no premium for slightly faster inference"
      }
    }
  ],
  "fitness": {
    "window": 10,
    "promote_on": "higher admit*verify*(1-hard_fail) at cost_ratio_le 1.5"
  }
}
