#!/usr/bin/env bash
# check-daemon-hotset — fan check-daemon across ≤hot_set_max integ stations.
#
# Policy-as-data: .grok/harness/daemon-hotset.v1.json
# Cite envelopes#merge_windows.hot_set_max (do not invent a second max).
#
# Usage:
#   export SWARM_ORCHESTRATOR=1
#   ./.grok/swarm/check-daemon-hotset                 # all .worktrees/integ-* (capped)
#   ./.grok/swarm/check-daemon-hotset integ-ci integ-specs
#   SWARM_HOT_SET_STATIONS="integ-ci,integ-os" ./.grok/swarm/check-daemon-hotset
#
# LSP/rust-analyzer read-only diagnostics are a carve-out ≠ this builder.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
cd "$ROOT"

HARNESS="$ROOT/.grok/harness/daemon-hotset.v1.json"
DAEMON="$ROOT/.grok/swarm/check-daemon"

# Stations live under the main checkout's `.worktrees/`, not under a linked worktree root.
resolve_worktrees_dir() {
  local main=""
  if [[ -n "${SWARM_MAIN_CHECKOUT:-}" ]]; then
    main="${SWARM_MAIN_CHECKOUT}"
  else
    local common
    common="$(git rev-parse --git-common-dir 2>/dev/null || true)"
    if [[ -n "$common" ]]; then
      common="$(cd "$common" && pwd)"
      # common-dir is usually <main>/.git
      main="$(cd "$common/.." && pwd)"
    fi
  fi
  if [[ -n "$main" && -d "$main/.worktrees" ]]; then
    printf '%s\n' "$main/.worktrees"
    return 0
  fi
  if [[ -d "$ROOT/.worktrees" ]]; then
    printf '%s\n' "$ROOT/.worktrees"
    return 0
  fi
  echo "check-daemon-hotset: cannot locate main .worktrees/ (set SWARM_MAIN_CHECKOUT)" >&2
  return 1
}
WORKTREES="$(resolve_worktrees_dir)"

if [[ "${SWARM_ORCHESTRATOR:-}" != "1" ]]; then
  echo "check-daemon-hotset: requires SWARM_ORCHESTRATOR=1" >&2
  exit 1
fi
if [[ ! -x "$DAEMON" && ! -f "$DAEMON" ]]; then
  echo "check-daemon-hotset: missing $DAEMON" >&2
  exit 1
fi

HOT_SET_MAX="$(
  python3 - "$HARNESS" <<'PY'
import json, sys
from pathlib import Path
p = Path(sys.argv[1])
if not p.is_file():
    print(4)  # fallback matches envelopes default; harness should exist
    raise SystemExit(0)
d = json.loads(p.read_text())
print(int(d.get("rule", {}).get("hot_set_max", 4)))
PY
)"

resolve_station() {
  local name="$1"
  local cand
  if [[ "$name" = /* ]]; then
    cand="$name"
  elif [[ -d "$WORKTREES/$name" ]]; then
    cand="$WORKTREES/$name"
  elif [[ -d "$WORKTREES/integ-$name" ]]; then
    cand="$WORKTREES/integ-$name"
  elif [[ "$name" == integ-* && -d "$WORKTREES/$name" ]]; then
    cand="$WORKTREES/$name"
  else
    echo "check-daemon-hotset: station not found: $name" >&2
    return 1
  fi
  # Durable integ stations only — never lane-* / advisory scratch as hot-set.
  if [[ "$cand" != *"/.worktrees/"* ]]; then
    echo "check-daemon-hotset: refusing non-.worktrees station: $cand" >&2
    return 1
  fi
  local base
  base="$(basename "$cand")"
  if [[ "$base" != integ-* ]]; then
    echo "check-daemon-hotset: refusing lane/scratch as hot-set station: $cand" >&2
    return 1
  fi
  printf '%s\n' "$cand"
}

stations=()
if [[ $# -gt 0 ]]; then
  for arg in "$@"; do
    stations+=("$(resolve_station "$arg")")
  done
elif [[ -n "${SWARM_HOT_SET_STATIONS:-}" ]]; then
  IFS=',' read -r -a raw <<<"$SWARM_HOT_SET_STATIONS"
  for arg in "${raw[@]}"; do
    arg="$(echo "$arg" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
    [[ -z "$arg" ]] && continue
    stations+=("$(resolve_station "$arg")")
  done
else
  if [[ -d "$WORKTREES" ]]; then
    while IFS= read -r d; do
      stations+=("$d")
    done < <(find "$WORKTREES" -maxdepth 1 -type d -name 'integ-*' | sort)
  fi
fi

n="${#stations[@]}"
if [[ "$n" -eq 0 ]]; then
  echo "check-daemon-hotset: no integ stations selected (pass names or set SWARM_HOT_SET_STATIONS)" >&2
  exit 1
fi
if [[ "$n" -gt "$HOT_SET_MAX" ]]; then
  echo "check-daemon-hotset: REFUSE hot_set_gt_max ($n > $HOT_SET_MAX); cite envelopes#merge_windows.hot_set_max / harness daemon-hotset.v1.json" >&2
  printf '  %s\n' "${stations[@]}" >&2
  exit 2
fi

echo "check-daemon-hotset: running on $n station(s) (max=$HOT_SET_MAX)" >&2
fail=0
for st in "${stations[@]}"; do
  echo "check-daemon-hotset: >>> $st" >&2
  if ! SWARM_ORCHESTRATOR=1 SWARM_CANDIDATE_ROOT="$st" python3 "$DAEMON"; then
    echo "check-daemon-hotset: daemon failed for $st" >&2
    fail=1
  fi
done

if [[ "$fail" -ne 0 ]]; then
  echo "check-daemon-hotset: completed with failures" >&2
  exit 1
fi
echo "check-daemon-hotset: OK ($n stations)" >&2
