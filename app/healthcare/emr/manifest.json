{
  "$schema": "https://docs.oyatie.com/schemas/microservice-manifest.schema.json",
  "microservice": "emr",
  "tier": "product",
  "tier_subtype": "product-consumer",
  "dr_tier": "T2",
  "title": "Electronic Medical Record (EMR/EHR)",
  "status": "wave-15m-b-authoring",
  "date": "2026-05-21",
  "audience_type": "tenant-b2b-healthcare-provider",
  "doctrine_summary": "Foundational healthcare record-of-truth µservice. Owns Patient + Encounter + Problem + Medication + Allergy + Vital + Note + Order + Result + CareTeam + OrderSet + Documentation + BillingCode + PatientEducation + PortalSession bounded contexts. FHIR R5 (default) + R4 (compatibility) API surface. Cedar-gated PHI access; HIPAA pack mandatory.",
  "binding_adrs": [
    "ADR-0131",
    "ADR-0132",
    "ADR-0244",
    "ADR-0251",
    "ADR-0328",
    "ADR-0329",
    "ADR-0330",
    "ADR-0331",
    "ADR-0332"
  ],
  "tenant_class_eligibility": {
    "eligible_classes": [
      "b2b-healthcare-provider",
      "b2b-healthcare-network",
      "b2b-academic-medical-center",
      "b2b-community-clinic",
      "b2b-ambulatory-surgery-center",
      "b2b-telehealth-platform",
      "b2b-rural-health-clinic",
      "b2b-federally-qualified-health-center",
      "b2b-skilled-nursing-facility",
      "b2b-home-health-agency"
    ],
    "ineligible_classes": [
      "b2c-individual",
      "b2c-family",
      "b2b-non-healthcare"
    ],
    "tenant_home_cell_required": true,
    "sovereign_pack_overrides_allowed": true,
    "cross_tenant_record_sharing": "per-patient-consent-only"
  },
  "paid_billing_components_emitted": [
    "emr.patient.active_per_month",
    "emr.encounter.recorded_per_month",
    "emr.note.signed_per_month",
    "emr.order.entered_per_month",
    "emr.fhir.read_per_thousand",
    "emr.fhir.write_per_thousand",
    "emr.patient_portal.active_user_per_month",
    "emr.documentation_template.usage_per_month",
    "emr.clinical_decision_support.invocation_per_thousand",
    "emr.audit_event.emission_per_million"
  ],
  "deployment_contexts": [
    "oyatie-public-cloud",
    "guest-on-aws",
    "guest-on-oci",
    "on-prem",
    "colo",
    "oyatie-as-cloud-provider"
  ],
  "deployment_context_defaults": {
    "preferred_for_us_tenants": [
      "oyatie-public-cloud",
      "guest-on-aws",
      "on-prem"
    ],
    "preferred_for_eu_tenants": [
      "on-prem",
      "colo",
      "oyatie-as-cloud-provider"
    ],
    "preferred_for_kr_tenants": [
      "on-prem",
      "colo"
    ],
    "sovereign_cell_required_for": [
      "academic-medical-center",
      "veterans-affairs-adjacent",
      "department-of-defense-medical"
    ],
    "rationale": "Healthcare tenants often refuse public-cloud PHI residency. The on-prem + colo + oyatie-as-cloud-provider contexts win the regulated-segment market that Epic's MyChart-Hosted + Cerner CommunityWorks own today."
  },
  "supported_oses": [
    "talos-1.9",
    "rhel-9",
    "oracle-linux-9",
    "suse-15-sp6",
    "ubuntu-24.04-lts",
    "debian-12",
    "rocky-9",
    "almalinux-9",
    "centos-stream-9",
    "amazon-linux-2023",
    "flatcar-stable",
    "photon-os-5.0",
    "macos-26-apple-silicon-m5-plus"
  ],
  "arch_matrix": [
    "linux/amd64",
    "linux/arm64",
    "darwin/arm64",
    "linux/ppc64le",
    "linux/s390x"
  ],
  "compliance_packs_required": [
    "HIPAA-2024"
  ],
  "compliance_packs_recommended": [
    "SOC2-T2-2024",
    "ISO-27001-2022",
    "EU-GDPR-2018-baseline",
    "KR-PIPA-2023-amendment",
    "KR-MEDICAL-LAW-2024",
    "FDA-21CFR-PART11-2024",
    "FERPA-2024"
  ],
  "cell_eligibility": {
    "required_certification_levels_any_of": [
      "hipaa-certified",
      "hipaa-pci-certified",
      "healthcare-sovereign"
    ],
    "forbidden_certification_levels": [
      "general-only"
    ],
    "tier_pattern": "tier-0-tier-1-tenant-aware",
    "shuffle_sharding_enabled": true,
    "cross_cell_phi_replication": "metadata-only-unless-pack-allows-and-consent-grants"
  },
  "layer_enum_conformance": {
    "source": "ADR-0105",
    "contract_versions": {
      "rest": "OpenAPI 3.2.0",
      "events": "AsyncAPI 3.1.0",
      "grpc": "proto3",
      "naming": "BNF v4.1"
    },
    "declared_layers": [
      "api",
      "rest",
      "application",
      "usecase",
      "domain",
      "kernel",
      "adapter",
      "worker",
      "governance"
    ]
  },
  "bounded_contexts": [
    "patient",
    "encounter",
    "problem",
    "medication",
    "allergy",
    "vital",
    "note",
    "order",
    "result",
    "care-team",
    "order-set",
    "documentation",
    "billing-code",
    "patient-education",
    "portal-session"
  ],
  "substrate_dependencies": [
    "tenancy",
    "ontology",
    "audit-chain",
    "policy-engine",
    "cell",
    "cloud-iam",
    "cloud-kms",
    "cloud-storage",
    "observability",
    "consent-graph",
    "workflow-engine"
  ],
  "product_dependencies": [
    "healthcare-integration",
    "diagnostics",
    "pharmacy",
    "emergency",
    "clinical-decision-support",
    "care-management",
    "cloud-billing"
  ],
  "fhir_versions_supported": [
    "R5",
    "R4"
  ],
  "fhir_default_version": "R5",
  "hl7_v2_legacy_path": "via-healthcare-integration",
  "ihe_profiles_supported": [
    "ITI-PIX-Patient-Identifier-Cross-Reference",
    "ITI-XDS-Cross-Enterprise-Document-Sharing",
    "ITI-XCA-Cross-Community-Access",
    "PCC-XDS-MS-Medical-Summary",
    "QED-Query-for-Existing-Data"
  ],
  "competitor_parity_targets": {
    "primary": [
      "Epic",
      "Oracle Health Cerner",
      "athenahealth"
    ],
    "secondary": [
      "Allscripts Veradigm",
      "Meditech Expanse",
      "eClinicalWorks",
      "NextGen Healthcare",
      "Greenway Health"
    ],
    "target_capability_coverage_percent": 105,
    "target_capability_count": 120
  },
  "performance_targets": {
    "chart_open_p99_ms": 800,
    "order_entry_p99_ms": 200,
    "fhir_read_p99_ms": 150,
    "fhir_write_p99_ms": 300,
    "search_p99_ms": 400,
    "note_save_p99_ms": 250,
    "throughput_qps_per_cell": 50000,
    "concurrent_clinicians_per_cell": 25000,
    "concurrent_portal_users_per_cell": 100000
  },
  "naming_justifications": {
    "microservice_slug": "emr (kebab-case, BNF v4.1) — abbreviates 'electronic medical record'. EMR chosen over 'ehr' because clinicians use 'EMR' colloquially while regulators alternate; the µservice covers both (EMR = clinician-facing; EHR = patient-facing portal slice still owned here).",
    "crate_pattern": "oya-emr-<bc>-<layer> where <bc> ∈ {patient, encounter, problem, medication, allergy, vital, note, order, result, care-team, order-set, documentation, billing-code, patient-education, portal-session} and <layer> ∈ ADR-0105 13-layer enum.",
    "exemptions": "none"
  },
  "data_classification": {
    "primary_class": "phi-protected-health-information",
    "secondary_classes": [
      "pii-name",
      "pii-dob",
      "pii-ssn",
      "pii-address",
      "pii-phone",
      "pii-email",
      "pci-cardholder-data-billing-only",
      "minor-data-pediatric-encounter",
      "behavioral-health-extra-sensitive",
      "substance-use-disorder-42-cfr-part-2",
      "genetic-data-gina-protected",
      "hiv-status-state-protected"
    ],
    "minimum_encryption_at_rest": "AES-256-GCM-with-tenant-scoped-KEK",
    "minimum_encryption_in_transit": "TLS-1.3-or-QUIC-HTTP/3",
    "tokenization_required_for": [
      "billing-code-claim-submission-cycle"
    ],
    "key_management": "BYOK-via-cloud-kms-with-platform-default-fallback"
  },
  "criticality_tier": "Tier 0",
  "rto_minutes": 15,
  "rpo_seconds": 60,
  "availability_target_percent": 99.99,
  "audit_chain_retention_years": 7,
  "audit_event_classes_emitted": [
    "PatientCreated",
    "PatientMerged",
    "PatientViewed",
    "EncounterOpened",
    "EncounterClosed",
    "ProblemAdded",
    "ProblemResolved",
    "MedicationPrescribed",
    "MedicationDiscontinued",
    "AllergyRecorded",
    "VitalRecorded",
    "NoteSigned",
    "NoteAmended",
    "OrderEntered",
    "OrderCanceled",
    "OrderResulted",
    "ResultReviewed",
    "ResultAcknowledged",
    "CareTeamMemberAdded",
    "CareTeamMemberRemoved",
    "BreakGlassInvoked",
    "BreakGlassReviewed",
    "FhirResourceRead",
    "FhirResourceWritten",
    "PortalSessionStarted",
    "PortalSessionEnded",
    "PatientEducationAssigned",
    "BillingCodeCaptured"
  ],
  "owner_team": "axis-emr + council-clinical + council-product",
  "capability_tiers": [
    "product"
  ],
  "hyperscaler_benchmark": "Epic; Oracle Health Cerner; athenahealth; Allscripts Veradigm; Meditech Expanse",
  "operational_concern": "Clinical record of truth — patient demographics, encounters, problems, medications, allergies, vitals, notes, orders, results, care team, FHIR API surface, mobile + web patient portal, HIPAA-compliant audit trail. Cannot be owned by generic 'application' or 'crm' — domain depth, regulatory weight, and clinical-workflow surface require dedicated µservice.",
  "failure_domain": "cell-aware service eligible for hipaa-certified cells only",
  "layer": "rest",
  "doc_class": "Machine-Readable-Spec",
  "wave_15m_b_substance_floor": {
    "prd_lines_minimum": 800,
    "architecture_lines_minimum": 600,
    "readme_lines_minimum": 300,
    "openapi_paths_minimum": 30,
    "asyncapi_channels_minimum": 20,
    "proto_services_minimum": 8,
    "openslo_files_minimum": 10,
    "cedar_policies_minimum": 6,
    "iac_contexts_required": 6,
    "decisions_minimum": 3,
    "implementation_plans_minimum": 10,
    "competitor_parity_capabilities_minimum": 100,
    "supported_oses_tier_1": 13
  },
  "capacity_model": {
    "baseline_cpu_per_tenant": 0.75,
    "baseline_ram_per_tenant": 1536,
    "storage_per_tenant": 35,
    "connections_per_tenant": {
      "valkey": 6,
      "postgres": 8,
      "outbound_http": 10
    },
    "scaling_dimension": "per_request",
    "cell_placement_class": "Tier-2",
    "notes": "Chart-of-truth FHIR and portal traffic scales with chart, order, medication, and portal API requests; Tier-2 keeps the PHI application data plane aligned with pod_runtime_tier=1 without claiming Tier-0 substrate ownership."
  },
  "sharding_automation": {
    "autosharding": "control_plane_driven",
    "auto_rebalance": {
      "enabled": false,
      "trigger_load_skew_threshold_percent": 30,
      "honors_residency": true,
      "honors_compliance_packs": true,
      "audit_chain_emit": true
    },
    "dynamic_sharding": {
      "enabled": false,
      "hot_split_threshold_p99_ms": 50,
      "hot_split_utilization_threshold_percent": 80,
      "cold_merge_utilization_threshold_percent": 20,
      "cold_merge_minimum_quiet_hours": 24,
      "audit_chain_emit": true
    }
  },
  "dr": {
    "rto_p99_seconds": 900,
    "rpo_p99_seconds": 60,
    "multi_region_active_active": true,
    "backup_substrate": [
      "postgres_wal_g",
      "valkey_cluster",
      "object_storage_versioned",
      "audit_chain_merkle_seal"
    ],
    "failover_runbook": "runbooks/emr-cell-failover.md",
    "dr_tier": "T2",
    "replication_shape": "active-active-multi-az-cross-region-warm"
  },
  "pod_runtime_tier": 1,
  "pod_runtime_tier_justification": "EMR owns the longitudinal PHI chart-of-truth and touches tenant clinical data across clinician, portal, order, medication, and billing workflows. It does not execute tenant-customer code, so Tier 0 is not justified, but the blast radius and HIPAA data-plane duties require Tier 1 isolation and Tier-2 cell placement.",
  "pod_runtime_tier_surface_evidence": [
    "microservices/emr/PRD.md",
    "microservices/emr/ARCHITECTURE.md",
    "microservices/emr/manifest.json",
    "microservices/emr/contracts/openapi-emr-v1.yaml"
  ],
  "tenant_version_pinning": {
    "declared_versions": [
      "2026-05-21"
    ],
    "default_version": "2026-05-21",
    "supported_window_size": 3,
    "supported_window_minimum_days": 180,
    "supports_per_tenant_pinning": true,
    "public_surface_files": {
      "openapi": {
        "2026-05-21": "contracts/openapi-emr-v1.yaml"
      },
      "asyncapi": {
        "2026-05-21": "contracts/asyncapi-emr-v1.yaml"
      }
    }
  },
  "consumes_upstream_oss": [
    "postgresql",
    "valkey",
    "cedar",
    "openbao",
    "opentofu"
  ],
  "iac_module_invocations": [
