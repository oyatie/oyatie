    },
    {
      "context": "oyatie-as-cloud-provider",
      "primitive": "per-cell-nodepool-kata",
      "version_pin": "v1"
    }
  ],
  "mesh_layering": {
    "cilium_l4": true,
    "ambient_ztunnel": true,
    "ambient_waypoint": false,
    "north_south_only": false
  },
  "slo_exemption": {
    "status": "live_exempted_no_runtime_sli",
    "owner": "axis-emr + council-clinical + council-product",
    "rationale": "No current measured runtime SLI is declared for this foundation or planning-only service; the manifest must not claim production or hyperscaler-ready SLO coverage until an OpenSLO file lands.",
    "cutover_on": "2026-12-31",
    "evidence": "specs/master-plan-sequencing.json#realignment_wave_sequence"
  }
}
