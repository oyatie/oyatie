{
  "dashboard": {
    "title": "Notes — E2E Encryption Health",
    "uid": "notes-e2e-encryption-health",
    "tags": ["notes", "e2e", "MLS", "ADR-NOTES-0001"],
    "panels": [
      {
        "id": 1,
        "title": "MLS group-key rotations per tenant (24h)",
        "type": "timeseries",
        "targets": [
          {"expr": "sum(rate(oya_notes_mls_key_rotate_total[5m])) by (tenant_id)"}
        ]
      },
      {
        "id": 2,
        "title": "E2E share-link issuance vs redemption",
        "type": "timeseries",
        "targets": [
          {"expr": "sum(rate(oya_notes_share_link_issue_total{e2e=\"true\"}[5m]))", "legendFormat": "issued"},
          {"expr": "sum(rate(oya_notes_share_link_redeem_total{e2e=\"true\"}[5m]))", "legendFormat": "redeemed"}
        ]
      },
      {
        "id": 3,
        "title": "E2E invariant violation events (MUST be zero)",
        "type": "stat",
        "targets": [
          {"expr": "sum(rate(oya_notes_e2e_invariant_violation_total[1h]))"}
        ],
        "thresholds": [{"color": "red", "value": 0.000001}]
      },
      {
        "id": 4,
        "title": "Server-side plaintext access attempts (should be zero on E2E notes)",
        "type": "stat",
        "targets": [
          {"expr": "sum(rate(oya_notes_server_plaintext_access_attempt_total{e2e=\"true\"}[1h]))"}
        ]
      },
      {
        "id": 5,
        "title": "PHI classifier outcome distribution (clinical tier)",
        "type": "piechart",
        "targets": [
          {"expr": "sum(rate(oya_notes_phi_detect_total[1h])) by (verdict)"}
        ]
      }
    ]
  }
}
