{
  "$schema": "https://schemas.grafana.com/dashboard.json",
  "_meta": {
    "doc_class": "GrafanaDashboard",
    "microservice": "notes",
    "owner_team": "council-privacy + ops-security + axis-notes",
    "audience": "council-privacy + tenant DPO + auditor",
    "tenant_scoped": true,
    "datasource": "per-pack Mimir; tenant-scoped via X-Scope-OrgID",
    "purpose": "Visibility into E2E posture invariants — every panel SHOULD return zero for invariant-violation counters; non-zero is incident"
  },
  "uid": "notes-privacy-and-e2e-health",
  "title": "notes: privacy + E2E invariant health",
  "tags": ["notes", "privacy", "e2e", "mls", "ai-refusal", "burn-rate"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-24h", "to": "now"},
  "templating": {
    "list": [
      {"name": "pack", "type": "custom", "label": "Pack",
        "options": [
          {"text": "pack-kr", "value": "kr", "selected": true},
          {"text": "pack-eu", "value": "eu"},
          {"text": "pack-us", "value": "us"},
          {"text": "pack-us-healthcare", "value": "us-hc"},
          {"text": "pack-jp", "value": "jp"},
          {"text": "pack-sg", "value": "sg"},
          {"text": "pack-au", "value": "au"},
          {"text": "pack-in", "value": "in"},
          {"text": "pack-br", "value": "br"},
          {"text": "pack-ae", "value": "ae"},
          {"text": "pack-ksa", "value": "ksa"}
        ]},
      {"name": "tenant", "type": "query", "label": "Tenant",
        "query": "label_values(oya_notes_note_create_total{pack=\"$pack\"}, tenant_id)"}
    ]
  },
  "panels": [
    {"id": 1, "type": "stat", "title": "AI calls blocked on E2E (MUST be 0)",
      "description": "Per ADR-NOTES-0005. Non-zero = Sev-1 invariant breach.",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "sum(increase(oya_notes_ai_call_blocked_e2e_total{pack=\"$pack\"}[5m]))", "refId": "A"}],
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"value": null, "color": "green"}, {"value": 1, "color": "red"}]}}}},

    {"id": 2, "type": "stat", "title": "Dual-context deny attempts (MUST be 0)",
      "description": "Per DCI-01..07. Non-zero = Sev-1.",
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "sum(increase(oya_notes_dual_context_denied_total{pack=\"$pack\"}[5m]))", "refId": "A"}],
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"value": null, "color": "green"}, {"value": 1, "color": "red"}]}}}},

    {"id": 3, "type": "stat", "title": "Personal-tier decrypt attempts (MUST be 0)",
      "description": "Per Inv-E2E-05. Non-zero = Sev-1.",
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "sum(increase(oya_notes_personal_decrypt_attempt_total{pack=\"$pack\"}[5m]))", "refId": "A"}],
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"value": null, "color": "green"}, {"value": 1, "color": "red"}]}}}},

    {"id": 4, "type": "stat", "title": "Loro collab blocked on E2E (MUST be 0)",
      "description": "Per DCI-09 + ADR-NOTES-0003. Non-zero = Sev-1.",
      "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "sum(increase(oya_notes_collab_session_blocked_e2e_total{pack=\"$pack\"}[5m]))", "refId": "A"}],
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"value": null, "color": "green"}, {"value": 1, "color": "red"}]}}}},

    {"id": 5, "type": "timeseries", "title": "MLS epoch advances (per-user rotation)",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "targets": [{"expr": "sum(rate(oya_notes_mls_epoch_advance_total{pack=\"$pack\",tenant_id=\"$tenant\"}[5m]))", "legendFormat": "advance/sec", "refId": "A"}]},

    {"id": 6, "type": "timeseries", "title": "MLS epoch convergence within 24h ratio",
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
      "targets": [{"expr": "oya_notes_mls_epoch_converged_within_24h_ratio{pack=\"$pack\",tenant_id=\"$tenant\"}", "legendFormat": "{{tenant_id}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"min": 0, "max": 1, "thresholds": {"mode": "absolute", "steps": [{"value": null, "color": "red"}, {"value": 0.95, "color": "yellow"}, {"value": 0.99, "color": "green"}]}}}},

    {"id": 7, "type": "timeseries", "title": "AI assist invocations (Professional-tier only)",
      "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum by (capability) (rate(oya_notes_ai_assist_call_total{pack=\"$pack\",tenant_id=\"$tenant\",result=\"success\"}[5m]))", "legendFormat": "{{capability}}", "refId": "A"}
      ]},

    {"id": 8, "type": "timeseries", "title": "Share-link brute-force attempts",
      "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8},
      "targets": [{"expr": "sum(rate(oya_notes_share_link_brute_force_attempts_total{pack=\"$pack\",tenant_id=\"$tenant\"}[5m]))", "legendFormat": "attempts/sec", "refId": "A"}]},

    {"id": 9, "type": "timeseries", "title": "Web-clipper invalid-token rate",
      "gridPos": {"x": 0, "y": 20, "w": 12, "h": 6},
      "targets": [{"expr": "sum(rate(oya_notes_web_clipper_invalid_token_total{pack=\"$pack\",tenant_id=\"$tenant\"}[5m]))", "legendFormat": "{{tenant_id}}", "refId": "A"}]},

    {"id": 10, "type": "timeseries", "title": "Personal-tier ciphertext blob storage (per tenant)",
      "gridPos": {"x": 12, "y": 20, "w": 12, "h": 6},
      "targets": [{"expr": "oya_notes_personal_ciphertext_bytes{pack=\"$pack\",tenant_id=\"$tenant\"}", "legendFormat": "{{tenant_id}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "bytes"}}},

    {"id": 11, "type": "table", "title": "Four-eyes disclosure events (Professional)",
      "gridPos": {"x": 0, "y": 26, "w": 24, "h": 8},
      "targets": [{"expr": "oya_notes_four_eyes_disclosure_total{pack=\"$pack\",tenant_id=\"$tenant\"}", "format": "table", "refId": "A"}]},

    {"id": 12, "type": "stat", "title": "E2E invariant CI lane: e2e-ai-refusal",
      "gridPos": {"x": 0, "y": 34, "w": 6, "h": 4},
      "targets": [{"expr": "oya_ci_lane_status{lane=\"oya-check-e2e-ai-refusal\",microservice=\"notes\"}", "refId": "A"}]},

    {"id": 13, "type": "stat", "title": "E2E invariant CI lane: dual-context-isolation",
      "gridPos": {"x": 6, "y": 34, "w": 6, "h": 4},
      "targets": [{"expr": "oya_ci_lane_status{lane=\"oya-check-dual-context-isolation\",microservice=\"notes\"}", "refId": "A"}]},

    {"id": 14, "type": "stat", "title": "Pack residency CI lane",
      "gridPos": {"x": 12, "y": 34, "w": 6, "h": 4},
      "targets": [{"expr": "oya_ci_lane_status{lane=\"oya-check-notes-pack-residency\",microservice=\"notes\"}", "refId": "A"}]},

    {"id": 15, "type": "stat", "title": "Personal-event-minimisation CI lane",
      "gridPos": {"x": 18, "y": 34, "w": 6, "h": 4},
      "targets": [{"expr": "oya_ci_lane_status{lane=\"oya-check-personal-event-minimisation\",microservice=\"notes\"}", "refId": "A"}]}
  ]
}
