    name = "mail-app-wire",
    srcs = ["tests/wire.rs", "tests/wire/submission.rs", "tests/wire/outbound.rs", "tests/wire/jmap_submission.rs", "tests/wire/starttls.rs", "tests/wire/pop.rs", "tests/wire/mx_config.rs"],
