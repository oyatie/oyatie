_KERNEL = "//app/mail/core/kernel:mail-kernel"
_API = "//app/mail/ports/api:mail-api"
_SQL = "third-party//mail/sqlite:rusqlite"
_JSON = "third-party//:serde_json"
_SHA = "third-party//:sha2"
_LIB_DEPS = [_KERNEL, _API, _SQL, _JSON, "third-party//:serde", _SHA, "third-party//mail:mail-parser", "third-party//mail:mail-builder"]
# The `contract` cargo feature: test doubles and the legacy fixture.
_CONTRACT = ["--cfg", "feature=\"contract\""]

rust_library(
    name = "mail-sqlite-store",
    srcs = glob(["src/**/*.rs"]),
    crate = "mail_sqlite_store",
    crate_root = "src/lib.rs",
    visibility = ["PUBLIC"],
    deps = _LIB_DEPS,
)

rust_library(
    name = "mail-sqlite-store-contract",
    srcs = glob(["src/**/*.rs"]),
    crate = "mail_sqlite_store",
    crate_root = "src/lib.rs",
    rustc_flags = _CONTRACT,
    visibility = ["PUBLIC"],
    deps = _LIB_DEPS,
)

rust_test(
    name = "mail-sqlite-store-unittest",
    srcs = glob(["src/**/*.rs"]),
    crate = "mail_sqlite_store",
    crate_root = "src/lib.rs",
    rustc_flags = _CONTRACT,
    visibility = ["PUBLIC"],
    deps = _LIB_DEPS,
)

# Integration tests against the plain library: name -> (sources, extra deps).
_TESTS = {
    "atomic_modseq": ([], []),
    "content": ([], [_SQL, _JSON]),
    "durable": ([], [_SQL]),
    "events": ([], []),
    "history": ([], []),
    "mailbox": ([], [_SQL]),
    "outbound": ([], [_SQL]),
    "queue": (["tests/queue/failures.rs"], [_SQL]),
    "selection": ([], [_SQL]),
    "submission_store": ([], [_SQL]),
    "submission_store_more": (["tests/submission_store/retention.rs"], [_SQL]),
    "threads": ([], [_SQL]),
    "transfer": ([], [_SQL]),
    "vacation": ([], []),
}

[
    rust_test(
        name = "mail-sqlite-store-" + name.replace("_", "-"),
        srcs = ["tests/" + name + ".rs"] + extra_srcs,
        crate = name,
        crate_root = "tests/" + name + ".rs",
        visibility = ["PUBLIC"],
        deps = [":mail-sqlite-store", _KERNEL, _API] + extra_deps,
    )
    for name, (extra_srcs, extra_deps) in _TESTS.items()
]

# Integration tests that need the `contract` feature compiled into the store.
_CONTRACT_TESTS = {
    "convert": (glob(["tests/convert/*.rs"]), [_SQL, _SHA]),
    "counting": ([], []),
}

[
    rust_test(
        name = "mail-sqlite-store-" + name,
        srcs = ["tests/" + name + ".rs"] + extra_srcs,
        crate = name,
        crate_root = "tests/" + name + ".rs",
        visibility = ["PUBLIC"],
        deps = [":mail-sqlite-store-contract", _KERNEL, _API] + extra_deps,
    )
    for name, (extra_srcs, extra_deps) in _CONTRACT_TESTS.items()
]
