      "os_id": "macos-26-apple-silicon-m5-plus",
      "name": "macOS",
      "version": "26 (Tahoe), M5+ Apple Silicon only",
      "kernel_min": "n/a",
      "package_format": "pkg / Homebrew",
      "primary_use": "Developer workstation only — NOT a runtime target for the EMR µservice. Used to build, test, and run the dev CLI.",
      "ci_lane": "lane-os-macos-26-arm64",
      "supported_archs": ["darwin/arm64"],
      "deployment_contexts": ["dev-only"]
    }
  ],
  "tier_2": [
    {
      "os_id": "linux-ppc64le-baseline",
      "rationale": "IBM Power servers in healthcare IDNs (rare but present in tier-1 health systems running legacy AIX-migrated workloads on Linux); IBM-partnership opportunities",
      "supported_archs": ["linux/ppc64le"]
    },
    {
      "os_id": "linux-s390x-baseline",
      "rationale": "IBM Z mainframes in major IDN data centers; some EU health authorities still run Z; long-tail",
      "supported_archs": ["linux/s390x"]
    }
  ],
  "explicitly_unsupported": [
    {
      "os_id": "windows-server",
      "rationale": "EMR is Linux-native; Windows runtime adds attack surface + licensing complexity with no clinical benefit. Tenants requiring Windows-domain SSO use cloud-iam ADFS bridge."
    },
    {
      "os_id": "macos-intel",
      "rationale": "Apple deprecated Intel macOS support 2024-2026 cycle; Tier-1 dev workstation is Apple Silicon M5+ only."
    },
    {
      "os_id": "macos-pre-m5",
      "rationale": "Performance + security baseline assumes M5-generation neural-engine + secure-enclave."
    },
    {
      "os_id": "freebsd",
      "rationale": "Not in Tier-1 hyperscaler standard set; would dilute supported-OS focus."
    }
  ],
  "arch_matrix": {
    "tier_1": ["linux/amd64", "linux/arm64", "darwin/arm64"],
    "tier_2": ["linux/ppc64le", "linux/s390x"]
  },
  "release_artifacts_per_os": [
    "container-image (multi-arch OCI; signed via cosign + Rekor)",
    "rpm-package (rhel, oracle-linux, suse, rocky, almalinux, centos-stream, amazon-linux, photon)",
    "deb-package (ubuntu, debian)",
    "talos-machine-config-yaml (talos)",
    "flatcar-systemd-unit (flatcar)",
    "pkg + Homebrew formula (macos dev only)"
  ]
}
