{
  "$schema": "https://schemas.grafana.com/dashboard.json",
  "_meta": {
    "doc_class": "GrafanaDashboard",
    "microservice": "social",
    "owner_team": "axis-social + ops-sre-reliability",
    "audience": "tenant operator + axis-social SRE",
    "tenant_scoped": true,
    "datasource": "per-pack Mimir; tenant-scoped via X-Scope-OrgID"
  },
  "uid": "social-feed-experience",
  "title": "social: feed experience (latency + cache + ranking + freshness)",
  "tags": ["social", "feed", "latency", "burn-rate"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "templating": {
    "list": [
      {"name": "pack", "type": "custom", "label": "Pack",
        "options": [
          {"text": "pack-kr", "value": "kr", "selected": true},
          {"text": "pack-eu", "value": "eu"},
          {"text": "pack-us", "value": "us"},
          {"text": "pack-us-healthcare", "value": "us-hc"},
          {"text": "pack-jp", "value": "jp"},
          {"text": "pack-sg", "value": "sg"},
          {"text": "pack-au", "value": "au"},
          {"text": "pack-in", "value": "in"},
          {"text": "pack-br", "value": "br"},
          {"text": "pack-ae", "value": "ae"},
          {"text": "pack-ksa", "value": "ksa"}
        ]},
      {"name": "tenant", "type": "query", "label": "Tenant",
        "query": "label_values(oya_social_post_create_total{pack=\"$pack\"}, tenant_id)"}
    ]
  },
  "panels": [
    {"id": 1, "type": "stat", "title": "Feed-render p95 (s)",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(oya_social_feed_render_duration_seconds_bucket{pack=\"$pack\",tenant_id=\"$tenant\"}[5m])))", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"mode": "absolute", "steps": [{"value": null, "color": "green"}, {"value": 0.15, "color": "yellow"}, {"value": 0.2, "color": "red"}]}}}},

    {"id": 2, "type": "stat", "title": "Feed-cache hit ratio",
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "sum(rate(oya_social_feed_cache_hit_total{pack=\"$pack\",tenant_id=\"$tenant\"}[5m])) / sum(rate(oya_social_feed_cache_request_total{pack=\"$pack\",tenant_id=\"$tenant\"}[5m]))", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "thresholds": {"mode": "absolute", "steps": [{"value": null, "color": "red"}, {"value": 0.7, "color": "yellow"}, {"value": 0.9, "color": "green"}]}}}},

    {"id": 3, "type": "stat", "title": "Posts/sec (5m rate)",
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "sum(rate(oya_social_post_create_total{pack=\"$pack\",tenant_id=\"$tenant\",result=\"success\"}[5m]))", "refId": "A"}]},

    {"id": 4, "type": "stat", "title": "Post-create p99 (s)",
      "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "histogram_quantile(0.99, sum by (le) (rate(oya_social_post_create_duration_seconds_bucket{pack=\"$pack\",tenant_id=\"$tenant\"}[5m])))", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"mode": "absolute", "steps": [{"value": null, "color": "green"}, {"value": 0.15, "color": "yellow"}, {"value": 0.25, "color": "red"}]}}}},

    {"id": 5, "type": "timeseries", "title": "Feed-render latency percentiles",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum by (le) (rate(oya_social_feed_render_duration_seconds_bucket{pack=\"$pack\",tenant_id=\"$tenant\"}[5m])))", "legendFormat": "p50", "refId": "A"},
        {"expr": "histogram_quantile(0.95, sum by (le) (rate(oya_social_feed_render_duration_seconds_bucket{pack=\"$pack\",tenant_id=\"$tenant\"}[5m])))", "legendFormat": "p95", "refId": "B"},
        {"expr": "histogram_quantile(0.99, sum by (le) (rate(oya_social_feed_render_duration_seconds_bucket{pack=\"$pack\",tenant_id=\"$tenant\"}[5m])))", "legendFormat": "p99", "refId": "C"}
      ]},

    {"id": 6, "type": "timeseries", "title": "Feed-cache freshness (lag seconds)",
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
      "targets": [{"expr": "oya_social_feed_cache_lag_seconds{pack=\"$pack\",tenant_id=\"$tenant\"}", "legendFormat": "lag", "refId": "A"}]},

    {"id": 7, "type": "timeseries", "title": "Feed mode split (chronological vs algorithmic)",
      "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum by (feed_mode) (rate(oya_social_feed_render_total{pack=\"$pack\",tenant_id=\"$tenant\"}[5m]))", "legendFormat": "{{feed_mode}}", "refId": "A"}
      ]},

    {"id": 8, "type": "timeseries", "title": "Post-create + comment + repost + react rate",
      "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum(rate(oya_social_post_create_total{pack=\"$pack\",tenant_id=\"$tenant\",kind=\"post\"}[5m]))", "legendFormat": "post", "refId": "A"},
        {"expr": "sum(rate(oya_social_post_create_total{pack=\"$pack\",tenant_id=\"$tenant\",kind=\"comment\"}[5m]))", "legendFormat": "comment", "refId": "B"},
        {"expr": "sum(rate(oya_social_post_create_total{pack=\"$pack\",tenant_id=\"$tenant\",kind=\"repost\"}[5m]))", "legendFormat": "repost", "refId": "C"},
        {"expr": "sum(rate(oya_social_reaction_added_total{pack=\"$pack\",tenant_id=\"$tenant\"}[5m]))", "legendFormat": "reaction", "refId": "D"}
      ]},

    {"id": 9, "type": "timeseries", "title": "Ranking-model inference latency p99",
      "gridPos": {"x": 0, "y": 20, "w": 12, "h": 8},
      "targets": [{"expr": "histogram_quantile(0.99, sum by (le) (rate(oya_social_ranking_inference_seconds_bucket{pack=\"$pack\"}[5m])))", "legendFormat": "p99", "refId": "A"}]},

    {"id": 10, "type": "timeseries", "title": "Follow-action latency p99",
      "gridPos": {"x": 12, "y": 20, "w": 12, "h": 8},
      "targets": [{"expr": "histogram_quantile(0.99, sum by (le) (rate(oya_social_follow_action_duration_seconds_bucket{pack=\"$pack\",tenant_id=\"$tenant\"}[5m])))", "legendFormat": "p99", "refId": "A"}]},

    {"id": 11, "type": "stat", "title": "Burn-rate (fast 1h)",
      "gridPos": {"x": 0, "y": 28, "w": 6, "h": 4},
      "targets": [{"expr": "oya_promotion_burn_rate_fast_1h{microservice=\"social\",pack=\"$pack\",sli=\"feed_render_availability\"}", "refId": "A"}],
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"value": null, "color": "green"}, {"value": 6, "color": "yellow"}, {"value": 14.4, "color": "red"}]}}}},

    {"id": 12, "type": "stat", "title": "Eligibility verdict",
      "gridPos": {"x": 6, "y": 28, "w": 6, "h": 4},
      "targets": [{"expr": "oya:current_verdict:by_microservice_env{microservice=\"social\",pack=\"$pack\",environment=\"production\"}", "refId": "A"}]},

    {"id": 13, "type": "table", "title": "Top 10 noisy accounts (posts/sec)",
      "gridPos": {"x": 12, "y": 28, "w": 12, "h": 8},
      "targets": [{"expr": "topk(10, sum by (author_ref) (rate(oya_social_post_create_total{pack=\"$pack\",tenant_id=\"$tenant\"}[5m])))", "format": "table", "refId": "A"}]}
  ]
}
