{
  "dashboard": {
    "title": "Social — Abuse-Defence Outcomes (EXTENSIVE)",
    "uid": "social-abuse-defence-outcomes",
    "tags": ["social", "abuse-defence", "ADR-0297", "UX-floor"],
    "panels": [
      {
        "id": 1,
        "title": "Default-path latency added by bot-mgmt (P99 ms)",
        "type": "timeseries",
        "targets": [
          {"expr": "histogram_quantile(0.99, sum(rate(oya_social_abuse_defence_added_latency_seconds_bucket[5m])) by (le))"}
        ],
        "thresholds": [{"color": "green", "value": 0}, {"color": "red", "value": 0.002}],
        "description": "UX-floor: MUST stay ≤2ms p99 — friction kills social adoption"
      },
      {
        "id": 2,
        "title": "Sock-puppet clusters detected (24h)",
        "type": "timeseries",
        "targets": [
          {"expr": "sum(rate(oya_social_sock_puppet_detect_total[1h])) by (confidence_band)"}
        ]
      },
      {
        "id": 3,
        "title": "CSAM detections + NCMEC reports (24h) — MUST be high-precision",
        "type": "stat",
        "targets": [
          {"expr": "sum(rate(oya_social_csam_detect_total[24h]))", "legendFormat": "detections"},
          {"expr": "sum(rate(oya_social_csam_ncmec_report_total[24h]))", "legendFormat": "NCMEC reports"}
        ]
      },
      {
        "id": 4,
        "title": "Spoof attempts blocked (impersonation + AP signature failures)",
        "type": "timeseries",
        "targets": [
          {"expr": "sum(rate(oya_social_spoof_attempt_block_total[5m])) by (reason)"}
        ]
      },
      {
        "id": 5,
        "title": "Scrape-pattern detections",
        "type": "timeseries",
        "targets": [
          {"expr": "sum(rate(oya_social_scrape_pattern_detect_total[5m])) by (pattern)"}
        ]
      },
      {
        "id": 6,
        "title": "CAPTCHA presentations by route (sign-up + suspicious-only)",
        "type": "timeseries",
        "targets": [
          {"expr": "sum(rate(oya_social_abuse_defence_challenge_present_total[5m])) by (route, challenge_type)"}
        ]
      },
      {
        "id": 7,
        "title": "False-positive rate per tenant tier (24h)",
        "type": "table",
        "targets": [
          {"expr": "sum(rate(oya_social_abuse_defence_false_positive_total[24h])) by (tenant_tier) / sum(rate(oya_social_abuse_defence_evaluation_total[24h])) by (tenant_tier)"}
        ]
      },
      {
        "id": 8,
        "title": "Honeypot trips + canary leaks (24h)",
        "type": "stat",
        "targets": [
          {"expr": "sum(rate(oya_social_honeypot_trip_total[24h]))", "legendFormat": "honeypot"},
          {"expr": "sum(rate(oya_social_canary_leak_detect_total[24h]))", "legendFormat": "canary"}
        ]
      },
      {
        "id": 9,
        "title": "Federation inbound signature failures (24h)",
        "type": "timeseries",
        "targets": [
          {"expr": "sum(rate(oya_social_federation_inbound_signature_fail_total[5m])) by (instance)"}
        ]
      }
    ]
  }
}
