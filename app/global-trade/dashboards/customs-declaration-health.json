{
  "title": "Global Trade health",
  "tags": [
    "erp",
    "global-trade",
    "customs-declaration",
    "GTS"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "benchmarks": [
    "SAP GTS Global Trade Services",
    "Oracle Global Trade Management",
    "Workday supplier-compliance workflow counterpart",
    "NetSuite international tax and trade counterpart",
    "Microsoft Dynamics 365 global trade and export-control counterpart"
  ],
  "panels": [
    {
      "title": "customs-declaration command rate",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(oya_global_trade_customs_declaration_commands_total[5m])) by (tenant_id)"
        }
      ]
    },
    {
      "title": "customs-declaration p99 latency",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(oya_global_trade_customs_declaration_latency_seconds_bucket[5m])) by (le, tenant_id))"
        }
      ]
    },
    {
      "title": "customs-declaration audit events",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(rate(audit_events_total{service=\"global-trade\",bounded_context=\"customs-declaration\"}[5m]))"
        }
      ]
    }
  ]
}
