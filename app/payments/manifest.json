{
  "schema_version": "1.0",
  "microservice": "payments",
  "tier": "product",
  "tier_subtype": "product-consumer",
  "dr_tier": "T1",
  "version": "0.1.0",
  "owner": "axis-payments",
  "slo_tier": "tier-0-revenue-critical",
  "pci_scope": true,
  "cell_tier": {
    "control_plane": "Tier1",
    "data_plane": "Tier3-per-tenant",
    "note": "Tier-1 control plane per ADR-0248; per-tenant data cells at Tier-3"
  },
  "bounded_contexts": [
    {
      "name": "charge",
      "description": "Charge creation, authorization, capture, void",
      "crates": [
        "oya-payments-charge-kernel",
        "oya-payments-charge-domain",
        "oya-payments-charge-usecase",
        "oya-payments-charge-rest",
        "oya-payments-charge-grpc",
        "oya-payments-charge-app"
      ],
      "crate_status": "historical_inventory_only_deleted_1451"
    },
    {
      "name": "refund",
      "description": "Refund issuance, window enforcement, PSP refund",
      "crates": [
        "oya-payments-refund-domain",
        "oya-payments-refund-usecase"
      ],
      "crate_status": "historical_inventory_only_deleted_1451"
    },
    {
      "name": "payout",
      "description": "Payout scheduling, cooling-period, bank-account verification",
      "crates": [
        "oya-payments-payout-domain",
        "oya-payments-payout-usecase"
      ],
      "crate_status": "historical_inventory_only_deleted_1451"
    },
    {
      "name": "dispute",
      "description": "Chargeback lifecycle, evidence, representment",
      "crates": [
        "oya-payments-dispute-domain",
        "oya-payments-dispute-usecase"
      ],
      "crate_status": "historical_inventory_only_deleted_1451"
    },
    {
      "name": "subscription-lifecycle",
      "description": "Subscription, billing-cycle, dunning, trial, usage-based billing",
      "crates": [
        "oya-payments-subscription-domain",
        "oya-payments-subscription-usecase"
      ],
      "crate_status": "historical_inventory_only_deleted_1451"
    },
    {
      "name": "kyc-kyb",
      "description": "Sub-merchant onboarding, KYC/KYB verification, AML monitoring",
      "crates": [
        "oya-payments-kyc-kyb-domain",
        "oya-payments-kyc-kyb-usecase"
      ],
      "crate_status": "historical_inventory_only_deleted_1451"
    },
    {
      "name": "settlement",
      "description": "Settlement batch, reconciliation, discrepancy detection",
      "crates": [
        "oya-payments-settlement-domain",
        "oya-payments-settlement-worker"
      ],
      "crate_status": "historical_inventory_only_deleted_1451"
    }
  ],
  "layers": [
    "adapter",
    "api",
    "app",
    "domain",
    "grpc",
    "kernel",
    "rest",
    "sdk",
    "usecase",
