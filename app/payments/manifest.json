      ]
    }
  },
  "capabilities": [
    {
      "tier": "T0",
      "name": "charge",
      "file": "app/payments/capabilities/charge.yaml",
      "risk_class": "financial"
    },
    {
      "tier": "T0",
      "name": "payout",
      "file": "app/payments/capabilities/payout.yaml",
      "risk_class": "financial"
