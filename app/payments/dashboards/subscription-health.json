{
  "__inputs": [
    {
      "name": "DS_MIMIR",
      "label": "Mimir",
      "description": "Mimir datasource (payments µservice metrics)",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "12.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" }
  ],
  "annotations": {
    "list": []
  },
  "description": "Payments subscription health: active subscriptions, churn, dunning success, revenue at risk",
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    { "title": "Payments Overview", "url": "/d/payments-overview", "type": "dashboards" },
    { "title": "Runbook: PSP Outage", "url": "https://github.com/oyatie/oyatie/blob/dev/app/payments/runbooks/psp-outage.md", "type": "link" }
  ],
  "panels": [
    {
      "id": 1,
      "title": "Active subscriptions",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_MIMIR}" },
          "expr": "sum(payments_subscription_active_total)",
          "legendFormat": "Active"
        }
      ]
    },
    {
      "id": 2,
      "title": "Past-due subscriptions",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_MIMIR}" },
          "expr": "sum(payments_subscription_past_due_total)",
          "legendFormat": "Past Due"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "yellow", "value": 100 },
              { "color": "red", "value": 500 }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "Dunning recovery rate (7d)",
      "type": "gauge",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_MIMIR}" },
          "expr": "sum(rate(payments_dunning_recovered_total[7d])) / sum(rate(payments_dunning_attempted_total[7d]))",
          "legendFormat": "Dunning recovery rate"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "steps": [
              { "color": "red", "value": 0 },
              { "color": "yellow", "value": 0.6 },
              { "color": "green", "value": 0.8 }
            ]
          },
          "min": 0,
          "max": 1
        }
      }
    },
    {
      "id": 4,
      "title": "Monthly recurring revenue at risk (past-due)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_MIMIR}" },
          "expr": "sum(payments_subscription_past_due_mrr_usd)",
          "legendFormat": "MRR at risk"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "currencyUSD" } }
    },
    {
      "id": 5,
      "title": "Subscription churn rate (30d)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_MIMIR}" },
          "expr": "rate(payments_subscription_cancelled_total[30d]) / avg_over_time(payments_subscription_active_total[30d])",
          "legendFormat": "Churn rate"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit" } }
    },
    {
      "id": 6,
      "title": "Dunning steps distribution",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_MIMIR}" },
          "expr": "sum by (step) (payments_dunning_step_total)",
          "legendFormat": "Step {{step}}"
        }
      ]
    }
  ],
  "refresh": "1m",
  "schemaVersion": 39,
  "tags": ["payments", "subscription", "dunning", "revenue"],
  "time": { "from": "now-30d", "to": "now" },
  "timepicker": {},
  "title": "Payments — Subscription Health",
  "uid": "payments-subscription-health",
  "version": 1
}
