{
  "$schema": "https://schemas.grafana.com/dashboard.json",
  "_meta": {
    "doc_class": "GrafanaDashboard",
    "microservice": "payments",
    "owner_team": "ops-fraud + axis-payments + ops-customer-success",
    "audience": "ops-fraud + tenant-admins (per-tenant view)",
    "tenant_scoped": true,
    "datasource": "Mimir"
  },
  "uid": "payments-dispute-volume",
  "title": "Dispute Volume — chargeback trends",
  "tags": ["payments", "dispute", "chargeback"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5m",
  "time": {"from": "now-30d", "to": "now"},
  "templating": {
    "list": [
      {"name": "tenant", "type": "query", "datasource": "Mimir", "query": "label_values(payments_dispute_open_total, tenant_id_class)"}
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Open disputes (now)",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "sum(payments_dispute_open_total{tenant_id_class=~\"$tenant\"})", "refId": "A"}]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Disputes opened (30d)",
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "sum(increase(payments_dispute_total{tenant_id_class=~\"$tenant\"}[30d]))", "refId": "A"}]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Chargeback rate (30d)",
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "sum(increase(payments_dispute_total{tenant_id_class=~\"$tenant\"}[30d])) / sum(increase(payments_charge_total{outcome=\"captured\",tenant_id_class=~\"$tenant\"}[30d]))", "refId": "A"}]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Win-rate (30d)",
      "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "sum(increase(payments_dispute_total{state=\"won\",tenant_id_class=~\"$tenant\"}[30d])) / sum(increase(payments_dispute_total{state=~\"won|lost\",tenant_id_class=~\"$tenant\"}[30d]))", "refId": "A"}]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Dispute open-rate per day",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "targets": [{"expr": "sum(increase(payments_dispute_total{tenant_id_class=~\"$tenant\"}[1d]))", "refId": "A"}]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Dispute reason-code distribution",
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
      "targets": [{"expr": "sum by (reason_code) (increase(payments_dispute_total{tenant_id_class=~\"$tenant\"}[1d]))", "refId": "A"}]
    },
    {
      "id": 12,
      "type": "table",
      "title": "Top-10 sub-merchants by chargeback rate (last 30d)",
      "gridPos": {"x": 0, "y": 12, "w": 24, "h": 8},
      "targets": [{"expr": "topk(10, sum by (sub_merchant_id_class) (increase(payments_dispute_total{tenant_id_class=~\"$tenant\"}[30d])) / sum by (sub_merchant_id_class) (increase(payments_charge_total{outcome=\"captured\",tenant_id_class=~\"$tenant\"}[30d])))", "refId": "A"}]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Dispute representment evidence-submission lag",
      "gridPos": {"x": 0, "y": 20, "w": 12, "h": 8},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le)(rate(payments_dispute_evidence_submission_lag_seconds_bucket{tenant_id_class=~\"$tenant\"}[5m])))", "refId": "A"}]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Per-PSP dispute distribution",
      "gridPos": {"x": 12, "y": 20, "w": 12, "h": 8},
      "targets": [{"expr": "sum by (psp) (increase(payments_dispute_total{tenant_id_class=~\"$tenant\"}[1d]))", "refId": "A"}]
    }
  ]
}
