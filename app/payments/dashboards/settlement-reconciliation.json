{
  "__inputs": [
    {
      "name": "DS_MIMIR",
      "label": "Mimir",
      "type": "datasource",
      "pluginId": "prometheus"
    }
  ],
  "description": "Settlement reconciliation status per PSP: discrepancies, batch completion, settlement lag",
  "editable": false,
  "panels": [
    {
      "id": 1,
      "title": "Settlement discrepancies (open)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_MIMIR}" },
          "expr": "sum(payments_settlement_discrepancy_open_total)",
          "legendFormat": "Open discrepancies"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "red", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "title": "Reconciliation batch completion (24h)",
      "type": "gauge",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_MIMIR}" },
          "expr": "sum(rate(payments_settlement_batch_reconciled_total[24h])) / sum(rate(payments_settlement_batch_total[24h]))",
          "legendFormat": "Completion rate"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "steps": [
              { "color": "red", "value": 0 },
              { "color": "yellow", "value": 0.95 },
              { "color": "green", "value": 0.999 }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "Discrepancy value by PSP (USD)",
      "type": "bargauge",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_MIMIR}" },
          "expr": "sum by (psp) (payments_settlement_discrepancy_amount_usd)",
          "legendFormat": "{{psp}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "currencyUSD" } }
    },
    {
      "id": 4,
      "title": "Settlement lag by PSP (hours)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_MIMIR}" },
          "expr": "histogram_quantile(0.99, sum by (psp, le) (rate(payments_settlement_lag_hours_bucket[24h])))",
          "legendFormat": "{{psp}} p99"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "h" } }
    }
  ],
  "refresh": "5m",
  "schemaVersion": 39,
  "tags": ["payments", "settlement", "reconciliation", "treasury"],
  "time": { "from": "now-7d", "to": "now" },
  "title": "Payments — Settlement Reconciliation",
  "uid": "payments-settlement-reconciliation",
  "version": 1
}
