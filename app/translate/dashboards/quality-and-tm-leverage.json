{
  "$schema": "https://schemas.grafana.com/dashboard.json",
  "_meta": {
    "doc_class": "GrafanaDashboard",
    "microservice": "translate",
    "owner_team": "axis-translate + tenant-localization-ops",
    "audience": "tenant operator + axis-translate SRE + council-privacy",
    "tenant_scoped": true,
    "datasource": "per-pack Mimir; tenant-scoped via X-Scope-OrgID"
  },
  "uid": "translate-quality-tm-leverage",
  "title": "translate: quality + TM leverage (QE scores, leverage %, glossary, edit-distance)",
  "tags": ["translate", "quality-estimation", "tm-leverage", "glossary", "edit-distance"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {"from": "now-24h", "to": "now"},
  "templating": {
    "list": [
      {"name": "pack", "type": "custom", "label": "Pack",
        "options": [
          {"text": "pack-kr", "value": "kr", "selected": true},
          {"text": "pack-eu", "value": "eu"},
          {"text": "pack-us", "value": "us"},
          {"text": "pack-us-healthcare", "value": "us-hc"},
          {"text": "pack-jp", "value": "jp"}
        ]},
      {"name": "tenant", "type": "query", "label": "Tenant",
        "query": "label_values(oya_translate_qe_invocations_total{pack=\"$pack\"}, tenant_id)"},
      {"name": "lang_pair", "type": "query", "label": "Language pair",
        "query": "label_values(oya_translate_qe_score{pack=\"$pack\",tenant_id=\"$tenant\"}, lang_pair)"}
    ]
  },
  "panels": [
    {"id": 1, "type": "stat", "title": "QE invocations/sec",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "sum(rate(oya_translate_qe_invocations_total{pack=\"$pack\",tenant_id=\"$tenant\"}[5m]))", "refId": "A"}]},

    {"id": 2, "type": "stat", "title": "QE score p50",
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "histogram_quantile(0.50, sum by (le) (rate(oya_translate_qe_score_bucket{pack=\"$pack\",tenant_id=\"$tenant\"}[1h])))", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "thresholds": {"mode": "absolute", "steps": [{"value": null, "color": "red"}, {"value": 50, "color": "yellow"}, {"value": 75, "color": "green"}]}}}},

    {"id": 3, "type": "stat", "title": "TM leverage % (exact + ICE)",
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "100 * (sum(rate(oya_translate_tm_leverage_total{pack=\"$pack\",tenant_id=\"$tenant\",match=~\"exact|ice\"}[1h])) / sum(rate(oya_translate_tm_leverage_total{pack=\"$pack\",tenant_id=\"$tenant\"}[1h])))", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percent", "thresholds": {"mode": "absolute", "steps": [{"value": null, "color": "red"}, {"value": 30, "color": "yellow"}, {"value": 60, "color": "green"}]}}}},

    {"id": 4, "type": "stat", "title": "Glossary-override rate",
      "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "sum(rate(oya_translate_glossary_override_total{pack=\"$pack\",tenant_id=\"$tenant\"}[1h]))", "refId": "A"}]},

    {"id": 5, "type": "histogram", "title": "QE score distribution (last 1h)",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "targets": [{"expr": "sum by (le) (rate(oya_translate_qe_score_bucket{pack=\"$pack\",tenant_id=\"$tenant\"}[1h]))", "refId": "A"}]},

    {"id": 6, "type": "timeseries", "title": "QE score by language-pair (p50)",
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
      "targets": [{"expr": "histogram_quantile(0.50, sum by (le, lang_pair) (rate(oya_translate_qe_score_bucket{pack=\"$pack\",tenant_id=\"$tenant\"}[1h])))", "legendFormat": "{{lang_pair}}", "refId": "A"}]},

    {"id": 7, "type": "timeseries", "title": "TM leverage breakdown over time",
      "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum(rate(oya_translate_tm_leverage_total{pack=\"$pack\",tenant_id=\"$tenant\",match=\"exact\"}[5m]))", "legendFormat": "exact (100%)", "refId": "A"},
        {"expr": "sum(rate(oya_translate_tm_leverage_total{pack=\"$pack\",tenant_id=\"$tenant\",match=\"ice\"}[5m]))", "legendFormat": "ICE", "refId": "B"},
        {"expr": "sum(rate(oya_translate_tm_leverage_total{pack=\"$pack\",tenant_id=\"$tenant\",match=\"fuzzy\"}[5m]))", "legendFormat": "fuzzy (75-99%)", "refId": "C"},
        {"expr": "sum(rate(oya_translate_tm_leverage_total{pack=\"$pack\",tenant_id=\"$tenant\",match=\"none\"}[5m]))", "legendFormat": "none (MT only)", "refId": "D"}
      ]},

    {"id": 8, "type": "timeseries", "title": "Post-edit-distance (PED) distribution",
      "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum by (le) (rate(oya_translate_post_edit_distance_bucket{pack=\"$pack\",tenant_id=\"$tenant\"}[1h])))", "legendFormat": "p50", "refId": "A"},
        {"expr": "histogram_quantile(0.95, sum by (le) (rate(oya_translate_post_edit_distance_bucket{pack=\"$pack\",tenant_id=\"$tenant\"}[1h])))", "legendFormat": "p95", "refId": "B"}
      ]},

    {"id": 9, "type": "timeseries", "title": "QE macro bias vs reference eval baseline",
      "gridPos": {"x": 0, "y": 20, "w": 12, "h": 8},
      "targets": [{"expr": "oya_translate_qe_macro_bias{pack=\"$pack\"}", "legendFormat": "bias (reference-eval delta)", "refId": "A"}],
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"value": -5, "color": "red"}, {"value": -2, "color": "yellow"}, {"value": 2, "color": "green"}, {"value": 5, "color": "red"}]}}}},

    {"id": 10, "type": "table", "title": "Glossary-override top terms (24h)",
      "gridPos": {"x": 12, "y": 20, "w": 12, "h": 8},
      "targets": [{"expr": "topk(10, sum by (term_id) (rate(oya_translate_glossary_override_total{pack=\"$pack\",tenant_id=\"$tenant\"}[24h])))", "format": "table", "refId": "A"}]},

    {"id": 11, "type": "stat", "title": "QE bound-violations (must be 0)",
      "gridPos": {"x": 0, "y": 28, "w": 6, "h": 4},
      "targets": [{"expr": "increase(oya_translate_qe_bound_violation_total{pack=\"$pack\"}[24h])", "refId": "A"}],
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"value": null, "color": "green"}, {"value": 1, "color": "red"}]}}}},

    {"id": 12, "type": "stat", "title": "EU AI Act disclosure emission rate (must be 100% on EU)",
      "gridPos": {"x": 6, "y": 28, "w": 6, "h": 4},
      "targets": [{"expr": "100 * (sum(rate(oya_translate_eu_ai_act_disclosure_emitted_total{pack=\"eu\"}[1h])) / sum(rate(oya_translate_qe_invocations_total{pack=\"eu\"}[1h])))", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percent", "thresholds": {"mode": "absolute", "steps": [{"value": null, "color": "red"}, {"value": 99.99, "color": "green"}]}}}},

    {"id": 13, "type": "stat", "title": "Termbase conflicts (24h)",
      "gridPos": {"x": 12, "y": 28, "w": 6, "h": 4},
      "targets": [{"expr": "sum(increase(oya_translate_termbase_concept_conflict_total{pack=\"$pack\",tenant_id=\"$tenant\"}[24h]))", "refId": "A"}]},

    {"id": 14, "type": "stat", "title": "TBX roundtrip fidelity",
      "gridPos": {"x": 18, "y": 28, "w": 6, "h": 4},
      "targets": [{"expr": "avg(oya_translate_termbase_roundtrip_fidelity{pack=\"$pack\",tenant_id=\"$tenant\"})", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "thresholds": {"mode": "absolute", "steps": [{"value": null, "color": "red"}, {"value": 0.95, "color": "yellow"}, {"value": 0.99, "color": "green"}]}}}}
  ]
}
