# Product-scaffold package for the community composition rehomed from oya/community.
# Keeps the scaffold's YAML artifacts (contracts, capabilities, SLOs, IaC) and the
# internal Proto contract in the Buck2 corpus graph (ADR-0541) so the
# corpus-index-coverage ratchet counts them as indexed build inputs instead of
# unpackaged debt, mirroring app/calendar/BUCK and oya/BUCK.

load("//governance/corpus/extract:yaml_facts.bzl", "corpus_yaml_facts_shards")

# Hermetic input set for gates that must validate every live service manifest.
filegroup(
    name = "live-service-manifest-corpus",
    srcs = glob(["**/manifest.json"]),
    visibility = ["PUBLIC"],
)

# Hermetic input set for gates that validate the full internal Proto contract corpus.
filegroup(
    name = "proto-contract-corpus",
    srcs = glob(["**/*.proto"]),
    visibility = ["PUBLIC"],
)

# Corpus graph extraction (ADR-0541). Fixed-size faces bound configured action inputs while keeping
# all YAML ownership in this existing package.
corpus_yaml_facts_shards(
    srcs = glob(["**/*.yaml", "**/*.yml"]),
    shard_size = 256,
)
