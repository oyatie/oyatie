{
  "title": "Community — Moderation Queue Depth",
  "uid": "community-moderation-queue-depth",
  "tags": ["community", "moderation-queue"],
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-12h", "to": "now" },
  "templating": {
    "list": [
      { "name": "tenant_id", "type": "query", "datasource": "prometheus", "query": "label_values(community_moderation_queue_depth, tenant_id)", "includeAll": true }
    ]
  },
  "panels": [
    {
      "title": "Moderation queue depth (per tenant)",
      "type": "timeseries",
      "datasource": "prometheus",
      "targets": [
        { "expr": "community_moderation_queue_depth{tenant_id=~\"$tenant_id\"}", "legendFormat": "{{tenant_id}}" }
      ],
      "alert": {
        "name": "community-moderation-queue-depth-critical",
        "conditions": [
          { "evaluator": { "type": "gt", "params": [100000] }, "operator": { "type": "and" }, "query": { "params": ["A", "10m", "now"] }, "reducer": { "type": "max" } }
        ]
      }
    },
    {
      "title": "Oldest flag age (per tenant)",
      "type": "timeseries",
      "datasource": "prometheus",
      "targets": [
        { "expr": "community_moderation_oldest_flag_age_seconds{tenant_id=~\"$tenant_id\"}" }
      ]
    },
    {
      "title": "Flag rate (per tenant, by reason)",
      "type": "timeseries",
      "datasource": "prometheus",
      "targets": [
        { "expr": "sum by (tenant_id, reason) (rate(community_flag_raised_total{tenant_id=~\"$tenant_id\"}[5m]))" }
      ]
    },
    {
      "title": "Moderation action rate (per tenant, by verb)",
      "type": "timeseries",
      "datasource": "prometheus",
      "targets": [
        { "expr": "sum by (tenant_id, verb) (rate(community_moderation_actioned_total{tenant_id=~\"$tenant_id\"}[5m]))" }
      ]
    },
    {
      "title": "Moderation worker OOM kills",
      "type": "timeseries",
      "datasource": "prometheus",
      "targets": [
        { "expr": "rate(community_moderation_worker_oom_kill_total[5m])" }
      ],
      "alert": {
        "name": "community-moderation-worker-oom",
        "conditions": [
          { "evaluator": { "type": "gt", "params": [0] }, "operator": { "type": "and" }, "query": { "params": ["A", "5m", "now"] }, "reducer": { "type": "max" } }
        ]
      }
    },
    {
      "title": "Foundry-guardrails bridge lag",
      "type": "timeseries",
      "datasource": "prometheus",
      "targets": [
        { "expr": "community_guardrails_bridge_lag_seconds" }
      ]
    }
  ]
}
