{
  "title": "Community — Vote Rate",
  "uid": "oya-community-vote-rate",
  "tags": ["community", "voting-engine"],
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      { "name": "tenant_id", "type": "query", "datasource": "prometheus", "query": "label_values(oya_community_vote_cast_total, tenant_id)", "includeAll": true }
    ]
  },
  "panels": [
    {
      "title": "Vote rate (per tenant, by direction)",
      "type": "timeseries",
      "datasource": "prometheus",
      "targets": [
        { "expr": "sum by (tenant_id, direction) (rate(oya_community_vote_cast_total{tenant_id=~\"$tenant_id\"}[5m]))", "legendFormat": "{{tenant_id}} / {{direction}}" }
      ]
    },
    {
      "title": "Vote cast p99",
      "type": "timeseries",
      "datasource": "prometheus",
      "targets": [
        { "expr": "histogram_quantile(0.99, sum by (le, tenant_id) (rate(oya_community_vote_cast_duration_seconds_bucket{tenant_id=~\"$tenant_id\"}[5m])))" }
      ]
    },
    {
      "title": "Vote tally Valkey vs Postgres divergence (%)",
      "type": "timeseries",
      "datasource": "prometheus",
      "targets": [
        { "expr": "oya_community_vote_tally_divergence_ratio{tenant_id=~\"$tenant_id\"} * 100" }
      ],
      "alert": {
        "name": "community-vote-tally-divergence",
        "conditions": [
          { "evaluator": { "type": "gt", "params": [0.1] }, "operator": { "type": "and" }, "query": { "params": ["A", "5m", "now"] }, "reducer": { "type": "max" } }
        ]
      }
    },
    {
      "title": "Per-post vote velocity (top 25, last 1h)",
      "type": "table",
      "datasource": "prometheus",
      "targets": [
        { "expr": "topk(25, sum by (tenant_id, post_id) (rate(oya_community_vote_cast_total{tenant_id=~\"$tenant_id\"}[1h])))" }
      ]
    },
    {
      "title": "Vote velocity z-score (anomaly > 5)",
      "type": "timeseries",
      "datasource": "prometheus",
      "targets": [
        { "expr": "oya_community_vote_velocity_zscore{tenant_id=~\"$tenant_id\"}" }
      ],
      "alert": {
        "name": "community-vote-velocity-anomaly",
        "conditions": [
          { "evaluator": { "type": "gt", "params": [5] }, "operator": { "type": "and" }, "query": { "params": ["A", "10m", "now"] }, "reducer": { "type": "max" } }
        ]
      }
    }
  ]
}
