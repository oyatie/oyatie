{
  "annotations": {
    "list": [
      {
        "name": "Deployments",
        "datasource": "prometheus",
        "iconColor": "rgba(0, 211, 255, 1)",
        "enable": true,
        "expr": "changes(community_deployment_info[1m]) > 0"
      }
    ]
  },
  "title": "Community — Post Throughput",
  "uid": "community-post-throughput",
  "tags": ["community", "post-store", "throughput"],
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "tenant_id",
        "type": "query",
        "datasource": "prometheus",
        "query": "label_values(community_post_create_total, tenant_id)",
        "includeAll": true
      }
    ]
  },
  "panels": [
    {
      "title": "Post create rate (per tenant, 5m)",
      "type": "timeseries",
      "datasource": "prometheus",
      "targets": [
        {
          "expr": "sum by (tenant_id, kind) (rate(community_post_create_total{tenant_id=~\"$tenant_id\"}[5m]))",
          "legendFormat": "{{tenant_id}} / {{kind}}"
        }
      ]
    },
    {
      "title": "Post edit rate (per tenant)",
      "type": "timeseries",
      "datasource": "prometheus",
      "targets": [
        {
          "expr": "sum by (tenant_id) (rate(community_post_edit_total{tenant_id=~\"$tenant_id\"}[5m]))"
        }
      ]
    },
    {
      "title": "Post delete rate (per tenant) — anomaly trigger > 100/day",
      "type": "timeseries",
      "datasource": "prometheus",
      "targets": [
        {
          "expr": "sum by (tenant_id, deletor_role) (rate(community_post_delete_total{tenant_id=~\"$tenant_id\"}[5m]))"
        }
      ],
      "alert": {
        "name": "community-tenant-admin-delete-velocity",
        "conditions": [
          {
            "evaluator": { "type": "gt", "params": [100] },
            "operator": { "type": "and" },
            "query": { "params": ["A", "1d", "now"] },
            "reducer": { "type": "sum" }
          }
        ]
      }
    },
    {
      "title": "Post create latency (p50/p99/p999)",
      "type": "timeseries",
      "datasource": "prometheus",
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le, tenant_id) (rate(community_post_create_duration_seconds_bucket{tenant_id=~\"$tenant_id\"}[5m])))", "legendFormat": "p50 {{tenant_id}}" },
        { "expr": "histogram_quantile(0.99, sum by (le, tenant_id) (rate(community_post_create_duration_seconds_bucket{tenant_id=~\"$tenant_id\"}[5m])))", "legendFormat": "p99 {{tenant_id}}" },
        { "expr": "histogram_quantile(0.999, sum by (le, tenant_id) (rate(community_post_create_duration_seconds_bucket{tenant_id=~\"$tenant_id\"}[5m])))", "legendFormat": "p999 {{tenant_id}}" }
      ]
    },
    {
      "title": "Feed render latency (p99)",
      "type": "timeseries",
      "datasource": "prometheus",
      "targets": [
        { "expr": "histogram_quantile(0.99, sum by (le, tenant_id) (rate(community_feed_render_duration_seconds_bucket{tenant_id=~\"$tenant_id\"}[5m])))" }
      ]
    },
    {
      "title": "Tenant post velocity z-score (anomaly > 5)",
      "type": "timeseries",
      "datasource": "prometheus",
      "targets": [
        { "expr": "community_post_velocity_zscore{tenant_id=~\"$tenant_id\"}" }
      ]
    }
  ]
}
