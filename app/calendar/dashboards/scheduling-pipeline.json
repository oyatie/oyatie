{
  "$schema": "https://schemas.grafana.com/dashboard.json",
  "_meta": {
    "doc_class": "GrafanaDashboard",
    "microservice": "calendar",
    "owner_team": "axis-calendar + ops-sre-reliability",
    "audience": "tenant operator + axis-calendar SRE",
    "tenant_scoped": true,
    "datasource": "per-pack Mimir; tenant-scoped via X-Scope-OrgID"
  },
  "uid": "cal-scheduling-pipeline",
  "title": "calendar: scheduling pipeline (invitation flow + RFC 6638 polls + RSVP fanout)",
  "tags": ["calendar", "scheduling", "rfc-6638", "invitation", "rsvp", "burn-rate"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "templating": {
    "list": [
      {"name": "pack", "type": "custom", "label": "Pack",
        "options": [
          {"text": "pack-kr", "value": "kr", "selected": true},
          {"text": "pack-eu", "value": "eu"},
          {"text": "pack-us", "value": "us"},
          {"text": "pack-us-healthcare", "value": "us-hc"},
          {"text": "pack-jp", "value": "jp"},
          {"text": "pack-sg", "value": "sg"},
          {"text": "pack-au", "value": "au"},
          {"text": "pack-in", "value": "in"},
          {"text": "pack-br", "value": "br"},
          {"text": "pack-ae", "value": "ae"},
          {"text": "pack-ksa", "value": "ksa"}
        ]},
      {"name": "tenant", "type": "query", "label": "Tenant",
        "query": "label_values(calendar_event_create_total{pack=\"$pack\"}, tenant_id)"}
    ]
  },
  "panels": [
    {"id": 1, "type": "stat", "title": "Events created (5m rate)",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "sum(rate(calendar_event_create_total{pack=\"$pack\",tenant_id=\"$tenant\"}[5m]))", "refId": "A"}]},

    {"id": 2, "type": "stat", "title": "Invitations outbound/sec",
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "sum(rate(calendar_invitation_flow_outbound_total{pack=\"$pack\",tenant_id=\"$tenant\"}[5m]))", "refId": "A"}]},

    {"id": 3, "type": "stat", "title": "RSVP fanout p95 (s)",
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(calendar_rsvp_fanout_seconds_bucket{pack=\"$pack\",tenant_id=\"$tenant\"}[5m])))", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"mode": "absolute", "steps": [{"value": null, "color": "green"}, {"value": 0.5, "color": "yellow"}, {"value": 1.0, "color": "red"}]}}}},

    {"id": 4, "type": "stat", "title": "Scheduling-poll convergence p95 (s)",
      "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(calendar_scheduling_poll_convergence_seconds_bucket{pack=\"$pack\",tenant_id=\"$tenant\"}[5m])))", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"mode": "absolute", "steps": [{"value": null, "color": "green"}, {"value": 0.5, "color": "yellow"}, {"value": 1.0, "color": "red"}]}}}},

    {"id": 5, "type": "timeseries", "title": "Invitation flow throughput (outbound vs inbound)",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum(rate(calendar_invitation_flow_outbound_total{pack=\"$pack\",tenant_id=\"$tenant\"}[5m]))", "legendFormat": "outbound", "refId": "A"},
        {"expr": "sum(rate(calendar_invitation_flow_inbound_total{pack=\"$pack\",tenant_id=\"$tenant\"}[5m]))", "legendFormat": "inbound", "refId": "B"}
      ]},

    {"id": 6, "type": "timeseries", "title": "Scheduling-poll state distribution",
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum by (state) (calendar_scheduling_poll_state{pack=\"$pack\",tenant_id=\"$tenant\"})", "legendFormat": "{{state}}", "refId": "A"}
      ]},

    {"id": 7, "type": "timeseries", "title": "RSVP fanout latency p50/p95/p99",
      "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum by (le) (rate(calendar_rsvp_fanout_seconds_bucket{pack=\"$pack\",tenant_id=\"$tenant\"}[5m])))", "legendFormat": "p50", "refId": "A"},
        {"expr": "histogram_quantile(0.95, sum by (le) (rate(calendar_rsvp_fanout_seconds_bucket{pack=\"$pack\",tenant_id=\"$tenant\"}[5m])))", "legendFormat": "p95", "refId": "B"},
        {"expr": "histogram_quantile(0.99, sum by (le) (rate(calendar_rsvp_fanout_seconds_bucket{pack=\"$pack\",tenant_id=\"$tenant\"}[5m])))", "legendFormat": "p99", "refId": "C"}
      ]},

    {"id": 8, "type": "timeseries", "title": "Orphan polls (RFC 6638 deadlocks)",
      "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum(calendar_scheduling_poll_orphan_count{pack=\"$pack\",tenant_id=\"$tenant\"})", "legendFormat": "orphans", "refId": "A"}
      ]},

    {"id": 9, "type": "timeseries", "title": "Invitation loop indicator (outbound × inbound per invitation_id, top 5)",
      "gridPos": {"x": 0, "y": 20, "w": 24, "h": 8},
      "targets": [
        {"expr": "topk(5, sum by (invitation_id) (rate(calendar_invitation_flow_outbound_total{pack=\"$pack\",tenant_id=\"$tenant\"}[5m]) * rate(calendar_invitation_flow_inbound_total{pack=\"$pack\",tenant_id=\"$tenant\"}[5m])))", "legendFormat": "{{invitation_id}}", "refId": "A"}
      ]},

    {"id": 10, "type": "table", "title": "Per-event SLO burn (last 30d)",
      "gridPos": {"x": 0, "y": 28, "w": 24, "h": 8},
      "targets": [
        {"expr": "label_replace((1 - histogram_quantile(0.95, sum by (le, event_id) (rate(calendar_rsvp_fanout_seconds_bucket{pack=\"$pack\",tenant_id=\"$tenant\"}[30d])))) , \"slo\", \"rsvp-fanout-p95\", \"\", \"\")", "format": "table", "refId": "A"}
      ]}
  ],
  "annotations": {
    "list": [
      {"name": "rollouts", "datasource": "argo-rollouts", "iconColor": "blue", "query": "{microservice=\"calendar\"}"},
      {"name": "tzdb-bumps", "datasource": "prometheus", "iconColor": "orange", "expr": "changes(calendar_tzdb_release_in_use[1h]) > 0"}
    ]
  }
}
