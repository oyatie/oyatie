{
  "$schema": "https://schemas.grafana.com/dashboard.json",
  "_meta": {
    "doc_class": "GrafanaDashboard",
    "microservice": "calendar",
    "owner_team": "axis-calendar + ops-sre-reliability",
    "audience": "tenant operator + axis-calendar SRE",
    "tenant_scoped": true,
    "datasource": "per-pack Mimir; tenant-scoped via X-Scope-OrgID"
  },
  "uid": "cal-availability-freebusy",
  "title": "calendar: availability + free/busy (intra-tenant + cross-tenant)",
  "tags": ["calendar", "availability", "freebusy", "rfc-7953", "burn-rate"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "templating": {
    "list": [
      {"name": "pack", "type": "custom", "label": "Pack",
        "options": [
          {"text": "pack-kr", "value": "kr", "selected": true},
          {"text": "pack-eu", "value": "eu"},
          {"text": "pack-us", "value": "us"},
          {"text": "pack-us-healthcare", "value": "us-hc"},
          {"text": "pack-jp", "value": "jp"},
          {"text": "pack-sg", "value": "sg"},
          {"text": "pack-au", "value": "au"},
          {"text": "pack-in", "value": "in"},
          {"text": "pack-br", "value": "br"},
          {"text": "pack-ae", "value": "ae"},
          {"text": "pack-ksa", "value": "ksa"}
        ]},
      {"name": "tenant", "type": "query", "label": "Tenant",
        "query": "label_values(oya_calendar_freebusy_query_total{pack=\"$pack\"}, tenant_id)"}
    ]
  },
  "panels": [
    {"id": 1, "type": "stat", "title": "Free/busy queries/sec",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "sum(rate(oya_calendar_freebusy_query_total{pack=\"$pack\",tenant_id=\"$tenant\"}[5m]))", "refId": "A"}]},

    {"id": 2, "type": "stat", "title": "Free/busy p99 (s)",
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "histogram_quantile(0.99, sum by (le) (rate(oya_calendar_freebusy_query_seconds_bucket{pack=\"$pack\",tenant_id=\"$tenant\"}[5m])))", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"mode": "absolute", "steps": [{"value": null, "color": "green"}, {"value": 0.2, "color": "yellow"}, {"value": 0.4, "color": "red"}]}}}},

    {"id": 3, "type": "stat", "title": "Valkey cache hit ratio",
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "sum(rate(oya_calendar_freebusy_cache_hit_total{pack=\"$pack\",tenant_id=\"$tenant\"}[5m])) / sum(rate(oya_calendar_freebusy_query_total{pack=\"$pack\",tenant_id=\"$tenant\"}[5m]))", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "thresholds": {"mode": "absolute", "steps": [{"value": null, "color": "red"}, {"value": 0.6, "color": "yellow"}, {"value": 0.8, "color": "green"}]}}}},

    {"id": 4, "type": "stat", "title": "Cross-tenant queries (Cedar-admitted)",
      "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "sum(rate(oya_calendar_freebusy_query_total{pack=\"$pack\",tenant_id=\"$tenant\",query_class=\"cross_tenant\"}[5m]))", "refId": "A"}]},

    {"id": 5, "type": "timeseries", "title": "Free/busy latency p50/p95/p99 (by attendee-count bucket)",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum by (le, attendee_count_bucket) (rate(oya_calendar_freebusy_query_seconds_bucket{pack=\"$pack\",tenant_id=\"$tenant\"}[5m])))", "legendFormat": "p50 {{attendee_count_bucket}}", "refId": "A"},
        {"expr": "histogram_quantile(0.95, sum by (le, attendee_count_bucket) (rate(oya_calendar_freebusy_query_seconds_bucket{pack=\"$pack\",tenant_id=\"$tenant\"}[5m])))", "legendFormat": "p95 {{attendee_count_bucket}}", "refId": "B"},
        {"expr": "histogram_quantile(0.99, sum by (le, attendee_count_bucket) (rate(oya_calendar_freebusy_query_seconds_bucket{pack=\"$pack\",tenant_id=\"$tenant\"}[5m])))", "legendFormat": "p99 {{attendee_count_bucket}}", "refId": "C"}
      ]},

    {"id": 6, "type": "timeseries", "title": "Cross-tenant query refusal rate (Cedar refuses)",
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum(rate(oya_calendar_freebusy_cross_tenant_refused_total{pack=\"$pack\",tenant_id=\"$tenant\"}[5m]))", "legendFormat": "refused", "refId": "A"},
        {"expr": "sum(rate(oya_calendar_freebusy_cross_tenant_admitted_total{pack=\"$pack\",tenant_id=\"$tenant\"}[5m]))", "legendFormat": "admitted", "refId": "B"}
      ]},

    {"id": 7, "type": "timeseries", "title": "Cache rebuild events (per `runbooks/availability-cache-rebuild.md`)",
      "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum(rate(oya_calendar_freebusy_cache_rebuild_total{pack=\"$pack\",tenant_id=\"$tenant\"}[5m]))", "legendFormat": "rebuild events", "refId": "A"}
      ]},

    {"id": 8, "type": "timeseries", "title": "Agenda-render p95 (1 week / 100 events)",
      "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8},
      "targets": [
        {"expr": "histogram_quantile(0.95, sum by (le) (rate(oya_calendar_agenda_render_seconds_bucket{pack=\"$pack\",tenant_id=\"$tenant\"}[5m])))", "legendFormat": "agenda p95", "refId": "A"}
      ]},

    {"id": 9, "type": "table", "title": "Top-10 tenants by free/busy QPS (last 1h)",
      "gridPos": {"x": 0, "y": 20, "w": 24, "h": 8},
      "targets": [
        {"expr": "topk(10, sum by (tenant_id) (rate(oya_calendar_freebusy_query_total{pack=\"$pack\"}[1h])))", "format": "table", "refId": "A"}
      ]}
  ],
  "annotations": {
    "list": [
      {"name": "rollouts", "datasource": "argo-rollouts", "iconColor": "blue", "query": "{microservice=\"calendar\"}"},
      {"name": "policy-changes", "datasource": "prometheus", "iconColor": "purple", "expr": "changes(oya_calendar_policy_version[1h]) > 0"}
    ]
  }
}
