{
  "schemaVersion": 39,
  "title": "Healthcare Integration local operator remediation",
  "tags": [
    "healthcare-integration",
    "local-operational-primitive",
    "adr-0130"
  ],
  "timezone": "utc",
  "templating": {
    "list": [
      {
        "name": "tenant_id",
        "type": "query",
        "query": "label_values(oya_healthcare_integration_fhir_bundle_success_total, tenant_id)"
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "FHIR bundle exchange success burn",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(rate(oya_healthcare_integration_fhir_bundle_success_good_total[30d])) by (tenant_id, cell_tier) / sum(rate(oya_healthcare_integration_fhir_bundle_success_total[30d])) by (tenant_id, cell_tier)",
          "legendFormat": "fhir-bundle-success ratio"
        }
      ]
    },
    {
      "id": 2,
      "title": "Patient consent synchronization freshness burn",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(oya_healthcare_integration_consent_sync_freshness_good_total[1h])) by (tenant_id, cell_tier) / sum(rate(oya_healthcare_integration_consent_sync_freshness_total[1h])) by (tenant_id, cell_tier)",
          "legendFormat": "consent-sync-freshness ratio"
        }
      ]
    },
    {
      "id": 3,
      "title": "HIPAA access review latency burn",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(rate(oya_healthcare_integration_hipaa_access_review_latency_good_total[5m])) by (tenant_id, cell_tier) / sum(rate(oya_healthcare_integration_hipaa_access_review_latency_total[5m])) by (tenant_id, cell_tier)",
          "legendFormat": "hipaa-access-review-latency ratio"
        }
      ]
    },
    {
      "id": 4,
      "title": "PHI delivery completed inside clinical integration objective burn",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(oya_healthcare_integration_phi_delivery_latency_good_total[5m])) by (tenant_id, cell_tier) / sum(rate(oya_healthcare_integration_phi_delivery_latency_total[5m])) by (tenant_id, cell_tier)",
          "legendFormat": "phi-delivery-latency ratio"
        }
      ]
    },
    {
      "id": 5,
      "title": "HIPAA audit records complete for PHI access burn",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(rate(oya_healthcare_integration_audit_completeness_good_total[30d])) by (tenant_id, cell_tier) / sum(rate(oya_healthcare_integration_audit_completeness_total[30d])) by (tenant_id, cell_tier)",
          "legendFormat": "audit-completeness ratio"
        }
      ]
    },
    {
      "id": 6,
      "title": "HL7 acknowledgement latency burn",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(oya_healthcare_integration_hl7_ack_latency_good_total[5m])) by (tenant_id, cell_tier) / sum(rate(oya_healthcare_integration_hl7_ack_latency_total[5m])) by (tenant_id, cell_tier)",
          "legendFormat": "hl7-ack-latency ratio"
        }
      ]
    }
  ]
}
