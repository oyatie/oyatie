SPINE_CRATE_DEPS = [
    "//app/foundry/core/edits:foundry-edits",
    "//app/foundry/ports/draft/records:foundry-records-draft",
    "//data/core/data-boundary-kernel:data-boundary-kernel",
    "//data/core/ontology-kernel:data-ontology-kernel",
]

SPINE_TEST_DEPS = [":foundry-spine"] + SPINE_CRATE_DEPS

rust_library(
    name = "foundry-spine",
    srcs = glob(["src/**/*.rs"]),
    crate = "foundry_spine",
    crate_root = "src/lib.rs",
    visibility = ["PUBLIC"],
    deps = SPINE_CRATE_DEPS + [
        "//app/foundry/ports/draft/audit:foundry-audit-draft",
        "//app/foundry/ports/draft/projection:foundry-projection-draft",
    ],
)

rust_test(
    name = "foundry-spine-unittest",
    srcs = glob(["src/**/*.rs"]),
    crate = "foundry_spine",
    crate_root = "src/lib.rs",
    visibility = ["PUBLIC"],
    deps = SPINE_CRATE_DEPS + [
        "//app/foundry/ports/draft/audit:foundry-audit-draft",
        "//app/foundry/ports/draft/projection:foundry-projection-draft",
    ],
)

PROJECTION_TEST_DEPS = SPINE_TEST_DEPS + [
    "//app/foundry/ports/draft/projection:foundry-projection-draft",
]

KERNEL_TEST_DEPS = [
    ":foundry-spine",
    "//data/core/data-boundary-kernel:data-boundary-kernel",
    "//data/core/ontology-kernel:data-ontology-kernel",
]

# One row per test crate built from a tests/ file: the target's name suffix
# after foundry-spine-, the crate root's stem under tests/, the
# package-relative paths of any support modules it includes, and its deps.
# The crate's own unittest target is glob-sourced over src/ and stays a
# stanza above.
SPINE_TESTS = [
    ("refusals", "refusal_taxonomy", [], [":foundry-spine"]),
    ("projector", "projector_fold", [], SPINE_TEST_DEPS),
    ("fold-law", "fold_law", [], SPINE_TEST_DEPS),
    ("determinism", "fold_determinism", [], SPINE_TEST_DEPS),
    ("checkpoints", "checkpoint_resume", [], SPINE_TEST_DEPS),
    ("writer-gates", "writer_gates", [], SPINE_TEST_DEPS),
    ("writer-retry", "writer_retry", [], SPINE_TEST_DEPS),
    ("writer-retry-fields", "writer_retry_fields", ["tests/migration_support/log.rs"], SPINE_TEST_DEPS),
    ("writer-durability", "writer_durability", [], SPINE_TEST_DEPS + ["//app/foundry/adapters/draft/records-sqlite:foundry-records-sqlite-draft"]),
    ("history", "history_views", [], SPINE_TEST_DEPS),
    ("denials", "denial_trail", [], SPINE_TEST_DEPS),
    ("cedar", "cedar_policy_gate", [], SPINE_TEST_DEPS + ["third-party//:cedar-policy"]),
    ("cedar-seed", "cedar_seed", [], ["third-party//:cedar-policy"]),
    ("audit-emission", "audit_emission", [], SPINE_TEST_DEPS + ["//app/foundry/ports/draft/audit:foundry-audit-draft"]),
    ("revision-pinning", "revision_pinning", [], PROJECTION_TEST_DEPS),
    ("migration-cycles", "migration_cycles", [], KERNEL_TEST_DEPS),
    ("migration-plan", "migration_plan", ["tests/migration_plan_support/mod.rs"], KERNEL_TEST_DEPS),
    ("migration-runner", "migration_runner", ["tests/migration_support/log.rs", "tests/migration_support/mod.rs"], SPINE_TEST_DEPS),
    ("migration-runner-faults", "migration_runner_faults", ["tests/migration_support/log.rs", "tests/migration_support/mod.rs"], SPINE_TEST_DEPS),
    ("migration-audit", "migration_audit", ["tests/migration_support/log.rs", "tests/migration_support/mod.rs"], SPINE_TEST_DEPS),
    ("write-through", "write_through", ["tests/write_through_support/mod.rs"], PROJECTION_TEST_DEPS),
    ("write-through-links", "write_through_links", [], PROJECTION_TEST_DEPS),
    ("paged-reads", "paged_reads", [], PROJECTION_TEST_DEPS),
    ("write-through-poison", "write_through_poison", ["tests/migration_support/log.rs", "tests/migration_support/mod.rs", "tests/write_through_support/mod.rs"], PROJECTION_TEST_DEPS),
    ("store-sync-status", "store_sync_status", [], PROJECTION_TEST_DEPS),
    ("projection-catchup", "projection_catchup", ["tests/catchup_support/mod.rs", "tests/write_through_support/mod.rs"], PROJECTION_TEST_DEPS),
    ("durable-projection-rebuild", "durable_projection_rebuild", ["tests/catchup_support/mod.rs"], SPINE_TEST_DEPS + ["//app/foundry/adapters/draft/projection-sqlite:foundry-projection-sqlite-draft", "//app/foundry/ports/draft/projection:foundry-projection-draft"]),
    ("catchup-refusals", "catchup_refusals", ["tests/catchup_support/mod.rs", "tests/write_through_support/mod.rs"], PROJECTION_TEST_DEPS),
]

[
    rust_test(
        name = "foundry-spine-" + suffix,
        srcs = sorted(["tests/" + stem + ".rs"] + support),
        crate = stem,
        crate_root = "tests/" + stem + ".rs",
        visibility = ["PUBLIC"],
        deps = deps,
    )
    for suffix, stem, support, deps in SPINE_TESTS
]
