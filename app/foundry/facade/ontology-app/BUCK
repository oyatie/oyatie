[
    rust_test(
        name = "foundry-ontology-app-" + suffix,
        srcs = TEST_SRCS,
        crate = stem,
        crate_root = "tests/" + stem + ".rs",
        visibility = ["PUBLIC"],
        env = {"CARGO_MANIFEST_DIR": "$(location :slo-inputs)/facade/ontology-app"} if suffix == "slo-render" else {},
        resources = [":slo-inputs"] if suffix == "slo-render" else [],
        deps = [dep for dep in deps if dep != "//policy/core/pdp-kernel:policy-pdp-kernel"],
        named_deps = {
            "policy_pdp_kernel": dep
            for dep in deps
            if dep == "//policy/core/pdp-kernel:policy-pdp-kernel"
        },
    )
    for suffix, stem, deps in FACADE_TESTS
]

# The drills spawn the real executable, located through the env cargo sets.
DRILLS = [
    ("drill-corrupt-store", "corrupt_store_boot_refusal"),
    ("drill-sigkill-replay", "kill_midwrite_replay_identity"),
    ("drill-drain", "shutdown_drains_inflight"),
]

[
    rust_test(
        name = "foundry-ontology-app-" + suffix,
        srcs = TEST_SRCS,
        crate = stem,
        crate_root = "tests/" + stem + ".rs",
        env = {"CARGO_BIN_EXE_foundry-ontology-app": "$(location :foundry-ontology-app-bin)"},
        resources = [":foundry-ontology-app-bin"],
        visibility = ["PUBLIC"],
        deps = ["third-party//:serde_json"],
    )
    for suffix, stem in DRILLS
]
