# The dependency set every driven-surface test in this package shares: the
# library under test, the durable records adapter behind its port, and the
# axum/tower machinery for driving a router in-process.
FACADE_TEST_DEPS = [
    ":foundry-ontology-app",
    "//app/foundry/adapters/draft/records-sqlite:foundry-records-sqlite-draft",
    "//app/foundry/ports/draft/records:foundry-records-draft",
    "third-party//:axum",
    "third-party//:http-body-util",
    "third-party//:serde_json",
    "third-party//:tokio",
    "third-party//:tower",
]

# The registry evolution the migration suites install is a second revision of
# an entity type, so they name the kernel's definition vocabulary directly.
MIGRATION_TEST_DEPS = FACADE_TEST_DEPS + [
    "//data/core/data-boundary-kernel:data-boundary-kernel",
    "//data/core/ontology-kernel:data-ontology-kernel",
]

TEST_SRCS = glob(["tests/**/*.rs"])

filegroup(
    name = "slo-inputs",
    srcs = {
        "facade/ontology-app/Cargo.toml": "Cargo.toml",
        "observability": "//app/foundry/observability:slo-payloads",
    },
)

# Preserve the source-relative paths of the compiled-in policy bundle.
LIBRARY_SRCS = {path: "facade/ontology-app/" + path for path in glob(["src/**/*.rs"])}
LIBRARY_SRCS.update({
    "//app/foundry/cedar:foundry.cedarschema": "cedar/foundry.cedarschema",
    "//app/foundry/cedar:foundry-policies.cedar": "cedar/foundry-policies.cedar",
})

rust_library(
    name = "foundry-ontology-app",
    mapped_srcs = LIBRARY_SRCS,
    crate = "foundry_ontology_app",
    crate_root = "facade/ontology-app/src/lib.rs",
    visibility = ["PUBLIC"],
    named_deps = {
        "policy_pdp_cedar": "//policy/adapters/pdp-cedar:policy-pdp-cedar",
        "policy_pdp_kernel": "//policy/core/pdp-kernel:policy-pdp-kernel",
    },
    deps = [
        "//app/foundry/adapters/draft/records-sqlite:foundry-records-sqlite-draft",
        "//app/foundry/core/edits:foundry-edits",
        "//app/foundry/core/spine:foundry-spine",
        "//app/foundry/adapters/draft/projection-sqlite:foundry-projection-sqlite-draft",
        "//app/foundry/core/ontology-query-domain:foundry-ontology-query-domain",
        "//app/foundry/core/ontology-query-usecase:foundry-ontology-query-usecase",
        "//app/foundry/ports/draft/caller:foundry-caller-draft",
        "//app/foundry/ports/draft/projection:foundry-projection-draft",
        "//app/foundry/ports/draft/records:foundry-records-draft",
        "//app/foundry/ports/draft/submission:foundry-submission-draft",
        "//data/core/data-boundary-kernel:data-boundary-kernel",
        "//data/core/ontology-kernel:data-ontology-kernel",
        "//iam/core/platform-contracts-kernel:shared-platform-contracts-kernel",
        "//data/core/ulid-id-kernel:shared-ulid-id-kernel",
        "third-party//:axum",
        "third-party//:serde",
        "third-party//:serde_json",
        "third-party//:tokio",
        "third-party//:tracing",
        "third-party//:tracing-subscriber",
    ],
)

rust_binary(
    name = "foundry-ontology-app-bin",
    srcs = glob(["src/**/*.rs"]),
    crate_root = "src/main.rs",
    visibility = ["PUBLIC"],
    deps = [
        ":foundry-ontology-app",
        "third-party//:axum",
        "third-party//:tokio",
        "third-party//:tracing",
    ],
)

