{
  "$schema": "https://schemas.grafana.com/dashboard.json",
  "_meta": {
    "doc_class": "GrafanaDashboard",
    "microservice": "sheets",
    "owner_team": "axis-sheets + ops-sre-reliability",
    "audience": "internal operators + axis-sheets",
    "tenant_scoped": false,
    "datasource": "Mimir aggregate (sheets tenant)"
  },
  "uid": "sheets-recalc-engine-health",
  "title": "Sheets — Recalc-Engine + Formula-Engine + Large-Sheet Storage Health",
  "tags": ["sheets", "recalc", "formula-engine", "arrow"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "templating": {
    "list": [
      {
        "name": "pack",
        "type": "custom",
        "options": [
          {"text": "pack-kr", "value": "kr", "selected": true},
          {"text": "pack-eu", "value": "eu"},
          {"text": "pack-us", "value": "us"},
          {"text": "pack-us-healthcare", "value": "us-hc"},
          {"text": "pack-jp", "value": "jp"},
          {"text": "pack-sg", "value": "sg"},
          {"text": "pack-au", "value": "au"},
          {"text": "pack-in", "value": "in"},
          {"text": "pack-br", "value": "br"},
          {"text": "pack-ae", "value": "ae"},
          {"text": "pack-ksa", "value": "ksa"}
        ],
        "label": "Pack"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Recalc-engine workers active",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "targets": [
        {"expr": "count(up{job=\"recalc-engine-worker\",pack=\"$pack\"} == 1)", "refId": "A"}
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Recalc queue depth (cluster)",
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
      "targets": [
        {"expr": "sum(sheets_recalc_queue_depth{pack=\"$pack\"})", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 100}, {"color": "red", "value": 500}]}}}
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Slow-formula kills (last 1h)",
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
      "targets": [
        {"expr": "sum(increase(sheets_recalc_slow_formula_killed_total{pack=\"$pack\"}[1h]))", "refId": "A"}
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Dep-graph cycles detected (last 1h)",
      "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
      "targets": [
        {"expr": "sum(increase(sheets_recalc_cycle_detected_total{pack=\"$pack\"}[1h]))", "refId": "A"}
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Recalc 100k-cell p95 (vs 1s GA budget)",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "targets": [
        {"expr": "histogram_quantile(0.95, sum by (le) (rate(sheets_recalc_100k_seconds_bucket{pack=\"$pack\"}[5m])))", "legendFormat": "100k p95", "refId": "A"},
        {"expr": "vector(1.0)", "legendFormat": "budget (1s)", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"unit": "s"}}
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Recalc 1M-cell p95 (vs 10s GA budget)",
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
      "targets": [
        {"expr": "histogram_quantile(0.95, sum by (le) (rate(sheets_recalc_1m_seconds_bucket{pack=\"$pack\"}[5m])))", "legendFormat": "1M p95", "refId": "A"},
        {"expr": "vector(10.0)", "legendFormat": "budget (10s)", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"unit": "s"}}
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Dep-graph depth distribution (per workbook top-N)",
      "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
      "targets": [
        {"expr": "topk(10, sheets_recalc_dep_graph_depth{pack=\"$pack\"})", "legendFormat": "{{tenant_id}}/{{workbook_id}}", "refId": "A"}
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Parallel-recalc utilization (rayon thread pool busy %)",
      "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8},
      "targets": [
        {"expr": "avg by (pod) (sheets_recalc_rayon_thread_pool_busy_pct{pack=\"$pack\"})", "legendFormat": "{{pod}}", "refId": "A"}
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Slow-formula count (formulas exceeding 5s individual eval)",
      "gridPos": {"x": 0, "y": 20, "w": 12, "h": 8},
      "targets": [
        {"expr": "topk(10, rate(sheets_formula_eval_slow_total{pack=\"$pack\"}[5m]))", "legendFormat": "{{tenant_id}}/{{workbook_id}}/{{cell_ref}}", "refId": "A"}
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Formula-engine corpus mismatch rate (must be 0)",
      "gridPos": {"x": 12, "y": 20, "w": 12, "h": 8},
      "targets": [
        {"expr": "rate(sheets_formula_engine_corpus_mismatch_total{pack=\"$pack\"}[5m])", "legendFormat": "mismatch/sec", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "red", "value": 0.001}]}}}
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Arrow/Parquet hot↔cold migration rate",
      "gridPos": {"x": 0, "y": 28, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum by (direction) (rate(sheets_large_sheet_storage_migration_total{pack=\"$pack\"}[5m]))", "legendFormat": "{{direction}}", "refId": "A"}
      ]
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Arrow/Parquet block count (cluster, large-sheet cold tier)",
      "gridPos": {"x": 12, "y": 28, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum(sheets_large_sheet_storage_block_count{pack=\"$pack\"})", "refId": "A"}
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "XLSX export worker queue depth + gVisor sandbox utilization",
      "gridPos": {"x": 0, "y": 36, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum(sheets_xlsx_export_queue_depth{pack=\"$pack\"})", "legendFormat": "queue depth", "refId": "A"},
        {"expr": "avg(sheets_xlsx_export_gvisor_busy_pct{pack=\"$pack\"})", "legendFormat": "gVisor busy %", "refId": "B"}
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "XLSX export p95 (vs 5s GA budget for 100k-cell)",
      "gridPos": {"x": 12, "y": 36, "w": 12, "h": 8},
      "targets": [
        {"expr": "histogram_quantile(0.95, sum by (le) (rate(sheets_xlsx_export_seconds_bucket{pack=\"$pack\"}[5m])))", "legendFormat": "export p95", "refId": "A"},
        {"expr": "vector(5.0)", "legendFormat": "budget (5s)", "refId": "B"}
      ]
    }
  ]
}
