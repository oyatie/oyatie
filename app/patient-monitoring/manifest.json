{
  "$schema": "https://docs.oyatie.com/schemas/microservice-manifest.schema.json",
  "microservice": "patient-monitoring",
  "tier": "product",
  "tier_subtype": "product-consumer",
  "dr_tier": "T2",
  "title": "Patient Monitoring (Vital Signs Telemetry + RPM + ICU)",
  "status": "wave-15m-f-authoring",
  "date": "2026-05-21",
  "audience_type": "tenant-b2b-healthcare-provider",
  "doctrine_summary": "Hyperscaler-grade continuous physiologic surveillance µservice. Owns VitalSignsStream + Waveform + ICUMonitoring + RPM + AlarmManagement + SmartAlarm + Trending + DeteriorationPrediction + SepsisEarlyWarning + CodeBlue + TelemetryCoverage + CentralStation + MobileNotification + WaveformArchive + DeviceInterop + TrendAnalytics + WearableIntegration + ICUBundleCompliance bounded contexts. Streams 50-1000Hz waveforms through internal gRPC/proto3 over HTTP/2; a FlatBuffers projection is only a benchmark-gated derived adapter and is not canonical; 1Hz numeric vitals via FHIR Observation[vital-signs]; ML deterioration scoring (NEWS2/MEWS/qSOFA/SOFA/Rothman analog) every 5 minutes; smart alarm engine reduces alarm-fatigue ≥40% vs. Philips/GE/Mindray baselines. Cedar-gated bed-group + alarm-suppression authority chain; HIPAA + EU-AI-Act packs mandatory; FDA 21 CFR Part 11 + IEC 62304 SaMD Class C lifecycle binding.",
  "binding_adrs": [
    "ADR-0131",
    "ADR-0132",
    "ADR-0244",
    "ADR-0245",
    "ADR-0248",
    "ADR-0251",
    "ADR-0253",
    "ADR-0254",
    "ADR-0328",
    "ADR-0332"
  ],
