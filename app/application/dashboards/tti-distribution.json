{
  "$schema": "https://schemas.grafana.com/dashboard.json",
  "_meta": {
    "doc_class": "GrafanaDashboard",
    "microservice": "application",
    "owner_team": "axis-application + ops-sre-reliability",
    "audience": "operator + tenant admin (tenant-scoped variant)",
    "tenant_scoped": true,
    "datasource": "per-pack Mimir endpoint"
  },
  "uid": "app-tti-distribution",
  "title": "Application Shell — TTI distribution",
  "tags": ["application", "tti", "performance"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "templating": {
    "list": [
      {
        "name": "pack",
        "type": "custom",
        "options": [
          {"text": "pack-kr", "value": "kr", "selected": true},
          {"text": "pack-eu", "value": "eu"},
          {"text": "pack-us", "value": "us"},
          {"text": "pack-us-healthcare", "value": "us-hc"},
          {"text": "pack-jp", "value": "jp"},
          {"text": "pack-sg", "value": "sg"},
          {"text": "pack-au", "value": "au"},
          {"text": "pack-in", "value": "in"},
          {"text": "pack-br", "value": "br"},
          {"text": "pack-ae", "value": "ae"},
          {"text": "pack-ksa", "value": "ksa"}
        ],
        "label": "Pack"
      },
      {
        "name": "tenant_id",
        "type": "query",
        "query": "label_values(application_tti_seconds, tenant_id)",
        "label": "Tenant"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "gauge",
      "title": "TTI p99 (warm cache, 5 min)",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 6},
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(application_tti_seconds_bucket{pack=\"$pack\", tenant_id=\"$tenant_id\", cache=\"warm\"}[5m])))",
          "refId": "A"
        }
      ],
      "options": {
        "thresholds": [
          {"value": 0, "color": "green"},
          {"value": 1.5, "color": "yellow"},
          {"value": 2.0, "color": "red"}
        ],
        "max": 4
      }
    },
    {
      "id": 2,
      "type": "histogram",
      "title": "TTI distribution (last 1 h, warm + cold)",
      "gridPos": {"x": 6, "y": 0, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "sum by (cache, le) (rate(application_tti_seconds_bucket{pack=\"$pack\", tenant_id=\"$tenant_id\"}[1h]))",
          "refId": "A",
          "format": "heatmap"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "TTI p50 / p99 / p999 over time",
      "gridPos": {"x": 0, "y": 8, "w": 18, "h": 8},
      "targets": [
        {"expr": "histogram_quantile(0.5, sum by (le) (rate(application_tti_seconds_bucket{pack=\"$pack\", tenant_id=\"$tenant_id\"}[5m])))", "legendFormat": "p50", "refId": "A"},
        {"expr": "histogram_quantile(0.99, sum by (le) (rate(application_tti_seconds_bucket{pack=\"$pack\", tenant_id=\"$tenant_id\"}[5m])))", "legendFormat": "p99", "refId": "B"},
        {"expr": "histogram_quantile(0.999, sum by (le) (rate(application_tti_seconds_bucket{pack=\"$pack\", tenant_id=\"$tenant_id\"}[5m])))", "legendFormat": "p999", "refId": "C"}
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "SLO budget burn rate (1h / 6h / 3d / 30d)",
      "gridPos": {"x": 0, "y": 16, "w": 18, "h": 4},
      "targets": [
        {"expr": "oya:application:tti:burn_rate:1h{pack=\"$pack\", tenant_id=\"$tenant_id\"}", "legendFormat": "1h", "refId": "A"},
        {"expr": "oya:application:tti:burn_rate:6h{pack=\"$pack\", tenant_id=\"$tenant_id\"}", "legendFormat": "6h", "refId": "B"},
        {"expr": "oya:application:tti:burn_rate:3d{pack=\"$pack\", tenant_id=\"$tenant_id\"}", "legendFormat": "3d", "refId": "C"},
        {"expr": "oya:application:tti:burn_rate:30d{pack=\"$pack\", tenant_id=\"$tenant_id\"}", "legendFormat": "30d", "refId": "D"}
      ]
    }
  ]
}
