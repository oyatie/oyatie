load("@prelude//rust:cargo_buildscript.bzl", "buildscript_run")

rust_binary(
    name = "hr-employment-domain-build-script",
    srcs = ["build.rs"],
    crate = "build_script_build",
    crate_root = "build.rs",
    visibility = [],
)

rust_test(
    name = "hr-employment-domain-build-script-test",
    srcs = ["build.rs"],
    crate = "hr_employment_domain_build_script_test",
    crate_root = "build.rs",
    visibility = ["PUBLIC"],
)

export_file(name = "build.rs", visibility = [])

genrule(
    name = "hr-employment-domain-source-items",
    srcs = glob(["src/items/*.rs"]),
    out = "source_items",
    cmd = "mkdir -p $OUT && cp $SRCS $OUT/",
)

genrule(
    name = "hr-employment-domain-source-test-items",
    srcs = glob(["src/test_items/*.rs"]),
    out = "source_test_items",
    cmd = "mkdir -p $OUT && if [ -n \"$SRCS\" ]; then cp $SRCS $OUT/; fi",
)

genrule(
    name = "hr-employment-domain-usecase-items",
    srcs = glob(["tests/usecase_items/*.rs"]),
    out = "usecase_items",
    cmd = "mkdir -p $OUT && if [ -n \"$SRCS\" ]; then cp $SRCS $OUT/; fi",
)

genrule(
    name = "hr-employment-domain-leave-balance-items",
    srcs = glob(["tests/leave_balance_items/*.rs"]),
    out = "leave_balance_items",
    cmd = "mkdir -p $OUT && cp $SRCS $OUT/",
)

genrule(
    name = "hr-employment-domain-leave-carryover-forfeiture-items",
    srcs = glob(["tests/leave_carryover_forfeiture_items/*.rs"]),
    out = "leave_carryover_forfeiture_items",
    cmd = "mkdir -p $OUT && cp $SRCS $OUT/",
)

genrule(
    name = "hr-employment-domain-onboarding-items",
    srcs = glob(["tests/onboarding_items/*.rs"]),
    out = "onboarding_items",
    cmd = "mkdir -p $OUT && cp $SRCS $OUT/",
)

genrule(
    name = "hr-employment-domain-manifest-dir",
    srcs = [
        ":build.rs",
        ":hr-employment-domain-source-items",
        ":hr-employment-domain-source-test-items",
        ":hr-employment-domain-usecase-items",
        ":hr-employment-domain-leave-balance-items",
        ":hr-employment-domain-leave-carryover-forfeiture-items",
        ":hr-employment-domain-onboarding-items",
    ],
    out = "manifest_dir",
    cmd = "mkdir -p $OUT/src/items $OUT/src/test_items $OUT/tests/usecase_items $OUT/tests/leave_balance_items $OUT/tests/leave_carryover_forfeiture_items $OUT/tests/onboarding_items && cp $(location :build.rs) $OUT/ && cp -R $(location :hr-employment-domain-source-items)/. $OUT/src/items/ && cp -R $(location :hr-employment-domain-source-test-items)/. $OUT/src/test_items/ && cp -R $(location :hr-employment-domain-usecase-items)/. $OUT/tests/usecase_items/ && cp -R $(location :hr-employment-domain-leave-balance-items)/. $OUT/tests/leave_balance_items/ && cp -R $(location :hr-employment-domain-leave-carryover-forfeiture-items)/. $OUT/tests/leave_carryover_forfeiture_items/ && cp -R $(location :hr-employment-domain-onboarding-items)/. $OUT/tests/onboarding_items/",
)

buildscript_run(
    name = "hr-employment-domain-build-script-run",
    buildscript_rule = ":hr-employment-domain-build-script",
    package_name = "hr-employment-domain",
    version = "0.1.0",
    manifest_dir = ":hr-employment-domain-manifest-dir",
)

_BUILD_ENV = {"OUT_DIR": "$(location :hr-employment-domain-build-script-run[out_dir])"}

rust_library(
    name = "hr-employment-domain",
    srcs = glob(["src/**/*.rs", "migrations/**/*.sql", "**/*.cedar", "**/*.sql", "**/*.json", "**/*.toml", "**/*.yaml", "**/*.yml", "**/*.proto", "**/*.html", "**/*.css", "**/*.txt"]),
    crate = "hr_employment_domain",
    crate_root = "src/lib.rs",
    env = _BUILD_ENV,
    visibility = ["PUBLIC"],
    deps = [
        "//data/core/data-boundary-kernel:data-boundary-kernel",
    ],
)

