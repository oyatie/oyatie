# Product package for the HR product forever home rehomed from oya/hr
# (integ/hr absorb, PR #1677). This package keeps the product's YAML artifacts
# (contracts, catalog) in the Buck2 corpus graph (ADR-0541) so the
# corpus-index-coverage ratchet counts them as indexed build inputs instead of
# unpackaged debt, mirroring the root-level residual packages (flags/BUCK,
# iac/BUCK, ...) and the app/calendar product package.

load("//governance/corpus/extract:yaml_facts.bzl", "corpus_yaml_facts_shards")

# Corpus graph extraction (ADR-0541). Fixed-size faces bound configured action inputs while keeping
# all YAML ownership in this existing package.
corpus_yaml_facts_shards(
    srcs = glob(["**/*.yaml", "**/*.yml"]),
    shard_size = 256,
)
