{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.oyatie.com/registry/test-set-registry.json",
  "title": "TestSetRegistry",
  "description": "Registry-driven test commands by language/surface. Consumed by M01-P07 GitOps VCS admission to enforce unit/integration/e2e standards.",
  "_meta": {
    "doc_class": "Registry",
    "registry_id": "REG-TEST-SET",
    "version": "1.0.0",
    "status": "Accepted-seed",
    "owner_team": "axis-foundry + ops-quality",
    "created_at": "2026-05-14T07:22:20Z",
    "updated_at": "2026-05-14T07:22:20Z",
    "standard_ref": "/specs/test-standard.json",
    "purpose": "Registry of test sets, commands, tiers, and evidence outputs used by Oya VCS and CI admission gates."
  },
  "rows": [
    {
      "language_or_surface": "Rust",
      "tiers": [
        "unit",
        "integration",
        "contract",
        "property"
      ],
      "command": "cargo nextest run --workspace --all-features --no-fail-fast",
      "required_when": [
        "Rust crate changed"
      ],
      "runner": "cargo-nextest",
      "evidence_outputs": [
        "target/nextest/junit.xml",
        "target/nextest/**/*.json"
      ],
      "owner_team": "axis-foundry",
      "promotion_blocking": true,
      "test_set_id": "rust-nextest-workspace"
    },
    {
      "language_or_surface": "Rust",
      "tiers": [
        "fuzz"
      ],
      "command": "cargo fuzz run <target>",
      "required_when": [
        "unsafe/FFI/untrusted parser changed"
      ],
      "runner": "cargo-fuzz",
      "evidence_outputs": [
        "fuzz/artifacts/**"
      ],
      "owner_team": "axis-foundry",
      "promotion_blocking": true,
      "test_set_id": "rust-fuzz"
    },
    {
      "language_or_surface": "TypeScript/JavaScript",
      "tiers": [
        "unit",
        "integration"
      ],
      "command": "cargo run -p dev-cli -- gate validate typescript-workspace --lane test",
      "required_when": [
        "TS/JS package changed"
      ],
      "runner": "repo lane",
      "evidence_outputs": [
        "configured by package"
      ],
      "owner_team": "axis-foundry",
      "promotion_blocking": true,
      "test_set_id": "typescript-unit-integration"
    },
    {
      "language_or_surface": "Web",
      "tiers": [
        "e2e"
      ],
      "command": "playwright test (via owning package script)",
      "required_when": [
        "web route/UI/workflow changed"
      ],
      "runner": "Playwright",
      "evidence_outputs": [
        "playwright-report/**",
        "test-results/**"
      ],
      "owner_team": "axis-application",
      "promotion_blocking": "production-if-user-facing",
      "test_set_id": "web-e2e"
    },
    {
      "language_or_surface": "Swift/iOS/macOS",
      "tiers": [
        "unit",
        "integration",
        "e2e"
      ],
      "command": "swift test / xcodebuild test (target-specific)",
      "required_when": [
        "Swift module or Apple client flow changed"
      ],
      "runner": "SwiftPM/XCTest/XCUITest",
      "evidence_outputs": [
        ".xcresult",
        ".build/test-results/**"
      ],
      "owner_team": "axis-clients",
      "promotion_blocking": true,
      "test_set_id": "swift-unit-integration"
    },
    {
      "language_or_surface": "Kotlin/Android",
      "tiers": [
        "unit",
        "integration",
        "e2e"
      ],
      "command": "./gradlew test connectedCheck (target-specific)",
      "required_when": [
        "Kotlin/Android module or flow changed"
      ],
      "runner": "Gradle/JUnit/Espresso",
      "evidence_outputs": [
        "build/test-results/**",
        "build/reports/androidTests/**"
      ],
      "owner_team": "axis-clients",
      "promotion_blocking": true,
      "test_set_id": "kotlin-unit-integration"
    },
    {
      "language_or_surface": "C#/WinUI",
      "tiers": [
        "unit",
        "integration",
        "e2e"
      ],
      "command": "dotnet test / Windows UI smoke (target-specific)",
      "required_when": [
        "C#/WinUI project, XAML, or desktop flow changed"
      ],
      "runner": "dotnet test + Windows UI runner",
      "evidence_outputs": [
        "TestResults/**",
        "*.trx"
      ],
      "owner_team": "axis-clients",
      "promotion_blocking": "production-if-user-facing",
      "test_set_id": "dotnet-winui"
    },
    {
      "language_or_surface": "C/C++",
      "tiers": [
        "unit",
        "integration"
      ],
      "command": "ctest --output-on-failure (target-specific)",
      "required_when": [
        "C/C++ target or native bridge changed"
      ],
      "runner": "CTest",
      "evidence_outputs": [
        "Testing/**"
      ],
      "owner_team": "axis-clients",
      "promotion_blocking": true,
      "test_set_id": "cpp-native"
    },
    {
      "language_or_surface": "Contracts/Schemas",
      "tiers": [
        "contract",
        "integration"
      ],
      "command": "cargo run -p dev-cli -- gate validate openapi-rest-route-parity && cargo run -p dev-cli -- gate validate api-semver",
      "required_when": [
        "OpenAPI/AsyncAPI/Proto/schema changed"
      ],
      "runner": "dev-cli",
      "evidence_outputs": [
        "/evidence/*contract*",
        "/evidence/*openapi*"
      ],
      "owner_team": "council-architecture",
      "promotion_blocking": true,
      "test_set_id": "contract-parity"
    }
  ],
  "gap_policy": "A missing platform runner is recorded as gap_accepted_with_reason only for non-production promotion; production promotion remains blocked for user-facing surfaces."
}
