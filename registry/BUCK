# Corpus graph extraction (ADR-0541). The repo's densest YAML package — 768 of the 861 YAML files
# that live inside any buck2 package at all. ONE action, so a single-file edit here re-extracts this
# shard and nothing else.
genrule(
    name = "corpus-yaml-facts",
    srcs = glob(["**/*.yaml", "**/*.yml"]),
    out = "yaml-facts.json",
    cmd = "$(exe //governance/corpus/extract:yaml-facts) --target root//registry:corpus-yaml-facts --prefix registry --out $OUT $SRCS",
)
