{
  "$schema": "https://schemas.grafana.com/dashboard.json",
  "_meta": {
    "doc_class": "GrafanaDashboard",
    "microservice": "meet",
    "owner_team": "axis-meet + ops-sre-reliability + council-privacy",
    "audience": "tenant compliance officer + axis-meet SRE + ops-security",
    "tenant_scoped": true,
    "datasource": "per-pack Mimir + S3 metrics + audit-chain seal index",
    "reference_standards": ["SEC Rule 17a-4(f) WORM", "HIPAA §164.312", "MiFID II RTS 6", "ADR-MEET-0002", "ADR-MEET-0004"]
  },
  "uid": "meet-recording-pipeline",
  "title": "meet: recording pipeline + retention + egress + holds",
  "tags": ["meet", "recording", "transcript", "egress", "hold", "compliance"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {"from": "now-24h", "to": "now"},
  "templating": {
    "list": [
      {"name": "pack", "type": "custom", "label": "Pack",
        "options": [
          {"text": "pack-kr", "value": "kr", "selected": true},
          {"text": "pack-eu", "value": "eu"},
          {"text": "pack-us", "value": "us"},
          {"text": "pack-us-healthcare", "value": "us-hc"},
          {"text": "pack-us-financial", "value": "us-fin"},
          {"text": "pack-jp", "value": "jp"},
          {"text": "pack-sg", "value": "sg"},
          {"text": "pack-au", "value": "au"},
          {"text": "pack-in", "value": "in"},
          {"text": "pack-br", "value": "br"},
          {"text": "pack-ae", "value": "ae"},
          {"text": "pack-ksa", "value": "ksa"}
        ]}
    ]
  },
  "panels": [
    {"id": 1, "type": "stat", "title": "Recordings active",
      "gridPos": {"x": 0, "y": 0, "w": 4, "h": 4},
      "targets": [{"expr": "sum(oya_meet_recording_active_total{pack=\"$pack\"})", "refId": "A"}]},

    {"id": 2, "type": "stat", "title": "Recordings finalized (24h)",
      "gridPos": {"x": 4, "y": 0, "w": 4, "h": 4},
      "targets": [{"expr": "sum(increase(oya_meet_recording_finalized_total{pack=\"$pack\"}[24h]))", "refId": "A"}]},

    {"id": 3, "type": "stat", "title": "Recording start p95 (s) — target ≤ 0.8",
      "gridPos": {"x": 8, "y": 0, "w": 4, "h": 4},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(oya_meet_recording_start_seconds_bucket{pack=\"$pack\"}[5m])))", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"mode": "absolute", "steps": [{"value": null, "color": "green"}, {"value": 0.8, "color": "yellow"}, {"value": 1.0, "color": "red"}]}}}},

    {"id": 4, "type": "stat", "title": "Recording upload failure rate (5m)",
      "gridPos": {"x": 12, "y": 0, "w": 4, "h": 4},
      "targets": [{"expr": "sum(rate(oya_meet_recording_upload_failure_total{pack=\"$pack\"}[5m])) / sum(rate(oya_meet_recording_upload_total{pack=\"$pack\"}[5m]))", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "thresholds": {"mode": "absolute", "steps": [{"value": null, "color": "green"}, {"value": 0.01, "color": "yellow"}, {"value": 0.05, "color": "red"}]}}}},

    {"id": 5, "type": "stat", "title": "Active eDiscovery holds",
      "gridPos": {"x": 16, "y": 0, "w": 4, "h": 4},
      "targets": [{"expr": "sum(oya_meet_ediscovery_holds_active{pack=\"$pack\"})", "refId": "A"}]},

    {"id": 6, "type": "stat", "title": "Four-eyes disclosure (24h)",
      "gridPos": {"x": 20, "y": 0, "w": 4, "h": 4},
      "targets": [{"expr": "sum(increase(oya_meet_four_eyes_disclosure_total{pack=\"$pack\"}[24h]))", "refId": "A"}]},

    {"id": 7, "type": "timeseries", "title": "Recording storage growth (GB / day) by tenant top-10",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "targets": [{"expr": "topk(10, sum by (tenant_id) (rate(oya_meet_recording_blob_bytes_total{pack=\"$pack\"}[1d])) / 1024 / 1024 / 1024)", "legendFormat": "{{tenant_id}}", "refId": "A"}]},

    {"id": 8, "type": "timeseries", "title": "ffmpeg worker local-disk buffer usage",
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
      "targets": [{"expr": "avg by (pod) (oya_meet_recording_local_buffer_pct{pack=\"$pack\"})", "legendFormat": "{{pod}}", "refId": "A"}],
      "description": "Per ADR-MEET-0002: ≤ 1h buffer per pod for S3 outage scenario."},

    {"id": 9, "type": "timeseries", "title": "RTMP egress streams active (per platform)",
      "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
      "targets": [{"expr": "sum by (platform_label) (oya_meet_live_stream_egress_active{pack=\"$pack\"})", "legendFormat": "{{platform_label}}", "refId": "A"}]},

    {"id": 10, "type": "timeseries", "title": "RTMP egress allow-list deny attempts (Sev-1 alert if > 0)",
      "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8},
      "targets": [{"expr": "sum(rate(oya_meet_egress_allow_list_deny_total{pack=\"$pack\"}[5m]))", "legendFormat": "deny rate", "refId": "A"}],
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"value": null, "color": "green"}, {"value": 0.01, "color": "red"}]}}}},

    {"id": 11, "type": "timeseries", "title": "Webinar attendees by tier (Interactive vs Broadcast)",
      "gridPos": {"x": 0, "y": 20, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum by (broadcast_tier) (oya_meet_webinar_attendees_active{pack=\"$pack\"})", "legendFormat": "{{broadcast_tier}}", "refId": "A"}
      ]},

    {"id": 12, "type": "timeseries", "title": "Recording retention bound countdown (top 10 closest to expiry)",
      "gridPos": {"x": 12, "y": 20, "w": 12, "h": 8},
      "targets": [{"expr": "bottomk(10, oya_meet_recording_retention_bound_seconds_remaining{pack=\"$pack\"})", "format": "table", "refId": "A"}]},

    {"id": 13, "type": "table", "title": "Recent four-eyes disclosure events (audit-chain seals)",
      "gridPos": {"x": 0, "y": 28, "w": 12, "h": 6},
      "targets": [{"expr": "topk(20, oya_meet_four_eyes_disclosure_total{pack=\"$pack\"})", "format": "table", "refId": "A"}]},

    {"id": 14, "type": "stat", "title": "Cross-pack residency violation (target = 0)",
      "gridPos": {"x": 12, "y": 28, "w": 6, "h": 6},
      "targets": [{"expr": "sum(increase(oya_meet_pack_residency_violation_total{pack=\"$pack\"}[24h]))", "refId": "A"}],
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"value": null, "color": "green"}, {"value": 1, "color": "red"}]}}}},

    {"id": 15, "type": "stat", "title": "S3 Object Lock violations (target = 0)",
      "gridPos": {"x": 18, "y": 28, "w": 6, "h": 6},
      "targets": [{"expr": "sum(increase(oya_meet_recording_worm_violation_total{pack=\"$pack\"}[24h]))", "refId": "A"}],
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"value": null, "color": "green"}, {"value": 1, "color": "red"}]}}}}
  ]
}
