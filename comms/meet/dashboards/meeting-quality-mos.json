{
  "$schema": "https://schemas.grafana.com/dashboard.json",
  "_meta": {
    "doc_class": "GrafanaDashboard",
    "microservice": "meet",
    "owner_team": "axis-meet + ops-sre-reliability",
    "audience": "tenant operator + axis-meet SRE; LiveKit SFU ops",
    "tenant_scoped": true,
    "datasource": "per-pack Mimir + LiveKit metrics + coturn metrics",
    "reference_standards": ["ITU-T G.107 (E-model MOS)", "ITU-T Y.1541 (IPTV class)", "RFC 8825 WebRTC"]
  },
  "uid": "meet-quality-mos",
  "title": "meet: meeting quality + MOS + media glass-to-glass",
  "tags": ["meet", "webrtc", "livekit", "quality", "mos", "g107"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "templating": {
    "list": [
      {"name": "pack", "type": "custom", "label": "Pack",
        "options": [
          {"text": "pack-kr", "value": "kr", "selected": true},
          {"text": "pack-eu", "value": "eu"},
          {"text": "pack-us", "value": "us"},
          {"text": "pack-us-healthcare", "value": "us-hc"},
          {"text": "pack-us-financial", "value": "us-fin"},
          {"text": "pack-jp", "value": "jp"},
          {"text": "pack-sg", "value": "sg"},
          {"text": "pack-au", "value": "au"},
          {"text": "pack-in", "value": "in"},
          {"text": "pack-br", "value": "br"},
          {"text": "pack-ae", "value": "ae"},
          {"text": "pack-ksa", "value": "ksa"}
        ]},
      {"name": "tenant", "type": "query", "label": "Tenant",
        "query": "label_values(oya_meet_participant_join_seconds_count{pack=\"$pack\"}, tenant_id)"}
    ]
  },
  "panels": [
    {"id": 1, "type": "stat", "title": "Active meetings", "gridPos": {"x": 0, "y": 0, "w": 4, "h": 4},
      "targets": [{"expr": "sum(livekit_rooms_active{pack=\"$pack\",tenant_id=\"$tenant\",microservice=\"meet\"})", "refId": "A"}]},

    {"id": 2, "type": "stat", "title": "Active participants", "gridPos": {"x": 4, "y": 0, "w": 4, "h": 4},
      "targets": [{"expr": "sum(livekit_participants_active{pack=\"$pack\",tenant_id=\"$tenant\",microservice=\"meet\"})", "refId": "A"}]},

    {"id": 3, "type": "stat", "title": "Participant join p95 (s) — target ≤ 1.5",
      "gridPos": {"x": 8, "y": 0, "w": 4, "h": 4},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(oya_meet_participant_join_seconds_bucket{pack=\"$pack\",tenant_id=\"$tenant\"}[5m])))", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"mode": "absolute", "steps": [{"value": null, "color": "green"}, {"value": 1.0, "color": "yellow"}, {"value": 1.5, "color": "red"}]}}}},

    {"id": 4, "type": "stat", "title": "Mean MOS (E-model G.107)",
      "gridPos": {"x": 12, "y": 0, "w": 4, "h": 4},
      "targets": [{"expr": "avg(oya_meet_media_mos{pack=\"$pack\",tenant_id=\"$tenant\"})", "refId": "A"}],
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"value": null, "color": "red"}, {"value": 3.5, "color": "yellow"}, {"value": 4.0, "color": "green"}]}}}},

    {"id": 5, "type": "stat", "title": "Media glass-to-glass p95 (intra-region; target ≤ 150ms)",
      "gridPos": {"x": 16, "y": 0, "w": 4, "h": 4},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(oya_meet_media_glass_to_glass_seconds_bucket{pack=\"$pack\",region_pair=\"intra\"}[5m])))", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"mode": "absolute", "steps": [{"value": null, "color": "green"}, {"value": 0.15, "color": "yellow"}, {"value": 0.25, "color": "red"}]}}}},

    {"id": 6, "type": "stat", "title": "Room create p95 (s) — target ≤ 0.1",
      "gridPos": {"x": 20, "y": 0, "w": 4, "h": 4},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(oya_meet_room_create_seconds_bucket{pack=\"$pack\",tenant_id=\"$tenant\"}[5m])))", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"mode": "absolute", "steps": [{"value": null, "color": "green"}, {"value": 0.08, "color": "yellow"}, {"value": 0.1, "color": "red"}]}}}},

    {"id": 7, "type": "timeseries", "title": "ICE candidate pair selection (host / srflx / relay)",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum by (candidate_kind) (rate(oya_meet_ice_selected_total{pack=\"$pack\",tenant_id=\"$tenant\"}[5m]))", "legendFormat": "{{candidate_kind}}", "refId": "A"}
      ]},

    {"id": 8, "type": "timeseries", "title": "Packet loss % distribution (per active session)",
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum by (le) (rate(oya_meet_media_packet_loss_pct_bucket{pack=\"$pack\",tenant_id=\"$tenant\"}[5m])))", "legendFormat": "p50", "refId": "A"},
        {"expr": "histogram_quantile(0.95, sum by (le) (rate(oya_meet_media_packet_loss_pct_bucket{pack=\"$pack\",tenant_id=\"$tenant\"}[5m])))", "legendFormat": "p95", "refId": "B"},
        {"expr": "histogram_quantile(0.99, sum by (le) (rate(oya_meet_media_packet_loss_pct_bucket{pack=\"$pack\",tenant_id=\"$tenant\"}[5m])))", "legendFormat": "p99", "refId": "C"}
      ]},

    {"id": 9, "type": "timeseries", "title": "Jitter ms p95",
      "gridPos": {"x": 0, "y": 12, "w": 8, "h": 8},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(oya_meet_media_jitter_ms_bucket{pack=\"$pack\",tenant_id=\"$tenant\"}[5m])))", "legendFormat": "p95 jitter", "refId": "A"}]},

    {"id": 10, "type": "timeseries", "title": "LiveKit SFU CPU + memory",
      "gridPos": {"x": 8, "y": 12, "w": 8, "h": 8},
      "targets": [
        {"expr": "avg by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"meet\",pod=~\"livekit-.*\"}[5m]))", "legendFormat": "{{pod}} cpu", "refId": "A"},
        {"expr": "avg by (pod) (container_memory_usage_bytes{namespace=\"meet\",pod=~\"livekit-.*\"}) / 1024 / 1024 / 1024", "legendFormat": "{{pod}} mem GB", "refId": "B"}
      ]},

    {"id": 11, "type": "timeseries", "title": "TURN bytes served / sec (coturn)",
      "gridPos": {"x": 16, "y": 12, "w": 8, "h": 8},
      "targets": [{"expr": "sum(rate(coturn_traffic_bytes_total{pack=\"$pack\",namespace=\"meet\"}[5m]))", "legendFormat": "TURN bytes/sec", "refId": "A"}]},

    {"id": 12, "type": "timeseries", "title": "Screen-share start p95",
      "gridPos": {"x": 0, "y": 20, "w": 8, "h": 6},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(oya_meet_screen_share_start_seconds_bucket{pack=\"$pack\",tenant_id=\"$tenant\"}[5m])))", "legendFormat": "p95", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"mode": "absolute", "steps": [{"value": null, "color": "green"}, {"value": 0.8, "color": "yellow"}, {"value": 1.2, "color": "red"}]}}}},

    {"id": 13, "type": "timeseries", "title": "Inter-region SFU mesh latency",
      "gridPos": {"x": 8, "y": 20, "w": 8, "h": 6},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(oya_meet_media_glass_to_glass_seconds_bucket{pack=\"$pack\",region_pair=\"inter\"}[5m])))", "legendFormat": "p95 inter", "refId": "A"}]},

    {"id": 14, "type": "table", "title": "Worst 10 sessions (p99 packet-loss)",
      "gridPos": {"x": 16, "y": 20, "w": 8, "h": 6},
      "targets": [{"expr": "topk(10, oya_meet_media_packet_loss_pct{pack=\"$pack\",tenant_id=\"$tenant\"})", "format": "table", "refId": "A"}]},

    {"id": 15, "type": "stat", "title": "Burn-rate (room create latency 1h)",
      "gridPos": {"x": 0, "y": 26, "w": 6, "h": 4},
      "targets": [{"expr": "oya_promotion_burn_rate_fast_1h{microservice=\"meet\",pack=\"$pack\",sli=\"room-create-latency\"}", "refId": "A"}]},

    {"id": 16, "type": "stat", "title": "Burn-rate (participant join 1h)",
      "gridPos": {"x": 6, "y": 26, "w": 6, "h": 4},
      "targets": [{"expr": "oya_promotion_burn_rate_fast_1h{microservice=\"meet\",pack=\"$pack\",sli=\"participant-join-latency\"}", "refId": "A"}]},

    {"id": 17, "type": "stat", "title": "Burn-rate (media glass-to-glass 1h)",
      "gridPos": {"x": 12, "y": 26, "w": 6, "h": 4},
      "targets": [{"expr": "oya_promotion_burn_rate_fast_1h{microservice=\"meet\",pack=\"$pack\",sli=\"media-glass-to-glass-latency\"}", "refId": "A"}]},

    {"id": 18, "type": "stat", "title": "Eligibility verdict",
      "gridPos": {"x": 18, "y": 26, "w": 6, "h": 4},
      "targets": [{"expr": "oya:current_verdict:by_microservice_env{microservice=\"meet\",pack=\"$pack\",environment=\"production\"}", "refId": "A"}]}
  ]
}
