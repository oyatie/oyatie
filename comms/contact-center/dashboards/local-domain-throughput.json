{
  "schemaVersion": 39,
  "title": "Contact Center local domain throughput",
  "tags": [
    "contact-center",
    "local-operational-primitive",
    "adr-0130"
  ],
  "timezone": "utc",
  "templating": {
    "list": [
      {
        "name": "tenant_id",
        "type": "query",
        "query": "label_values(oya_contact_center_transfer_success_total, tenant_id)"
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Warm and cold transfers completed with target agent acknowledgement burn",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(rate(oya_contact_center_transfer_success_good_total[30d])) by (tenant_id, cell_tier) / sum(rate(oya_contact_center_transfer_success_total[30d])) by (tenant_id, cell_tier)",
          "legendFormat": "transfer-success ratio"
        }
      ]
    },
    {
      "id": 2,
      "title": "Omnichannel route decision latency burn",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(oya_contact_center_route_decision_latency_good_total[5m])) by (tenant_id, cell_tier) / sum(rate(oya_contact_center_route_decision_latency_total[5m])) by (tenant_id, cell_tier)",
          "legendFormat": "route-decision-latency ratio"
        }
      ]
    },
    {
      "id": 3,
      "title": "Agent presence state freshness burn",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(rate(oya_contact_center_agent_presence_freshness_good_total[5m])) by (tenant_id, cell_tier) / sum(rate(oya_contact_center_agent_presence_freshness_total[5m])) by (tenant_id, cell_tier)",
          "legendFormat": "agent-presence-freshness ratio"
        }
      ]
    },
    {
      "id": 4,
      "title": "Recording actions with consent evidence burn",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(oya_contact_center_recording_consent_correctness_good_total[30d])) by (tenant_id, cell_tier) / sum(rate(oya_contact_center_recording_consent_correctness_total[30d])) by (tenant_id, cell_tier)",
          "legendFormat": "recording-consent-correctness ratio"
        }
      ]
    },
    {
      "id": 5,
      "title": "Callback scheduling latency burn",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(rate(oya_contact_center_callback_schedule_latency_good_total[5m])) by (tenant_id, cell_tier) / sum(rate(oya_contact_center_callback_schedule_latency_total[5m])) by (tenant_id, cell_tier)",
          "legendFormat": "callback-schedule-latency ratio"
        }
      ]
    },
    {
      "id": 6,
      "title": "Calls completed without unexpected drop burn",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(oya_contact_center_call_drop_rate_good_total[30d])) by (tenant_id, cell_tier) / sum(rate(oya_contact_center_call_drop_rate_total[30d])) by (tenant_id, cell_tier)",
          "legendFormat": "call-drop-rate ratio"
        }
      ]
    }
  ]
}
