  "packs": [
    "soc2",
    "iso27001",
    "gdpr",
    "HIPAA-2024",
    "PCI-DSS-L1-v4",
    "kr-pipa",
    "TCPA",
    "hipaa"
  ],
  "hyperscaler_benchmark": "Genesys Cloud; Twilio Flex; Zendesk Talk; Five9; Five9. The operational reason for a dedicated flat microservice is: real-time voice routing; recording consent",
  "owner_team": "axis-contact-center + council-product",
  "tenant_classification": "tenant-scoped product surface; demo_trial cap-bounded, paid billing_components per_seat + per_usage",
  "data_classification": "tenant-scoped operational records with audit evidence",
  "compliance_packs_applicable": [
    "soc2",
    "iso27001",
    "gdpr",
    "HIPAA-2024",
    "PCI-DSS-L1-v4",
    "kr-pipa",
    "TCPA",
    "hipaa"
  ],
