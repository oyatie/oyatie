    "messenger",
    "community",
    "intelligence",
    "recordings",
    "workflow-engine",
    "compliance",
    "observability"
  ],
  "failure_domain": "cell-aware service eligible for single-region, multi-region, and sovereign-pack-bound topologies",
  "criticality_class": "product-critical",
  "layer": "rest",
  "doc_class": "Machine-Readable-Spec",
  "capacity_model": {
    "baseline_cpu_per_tenant": 0.2,
    "baseline_ram_per_tenant": 384,
    "storage_per_tenant": 10,
    "connections_per_tenant": {
      "valkey": 10,
      "postgres": 4,
      "outbound_http": 36
    },
    "scaling_dimension": "per_message",
    "cell_placement_class": "Tier-3",
    "notes": "Voice events, agent state, routing decisions, consent markers, and recording lifecycle state are message-driven and media-heavy."
  },
  "sharding_automation": {
    "autosharding": "control_plane_driven",
    "auto_rebalance": {
      "enabled": false,
      "trigger_load_skew_threshold_percent": 30,
      "honors_residency": true,
      "honors_compliance_packs": true,
      "audit_chain_emit": true
    },
    "dynamic_sharding": {
      "enabled": false,
      "hot_split_threshold_p99_ms": 50,
      "hot_split_utilization_threshold_percent": 80,
      "cold_merge_utilization_threshold_percent": 20,
      "cold_merge_minimum_quiet_hours": 24,
      "audit_chain_emit": true
    }
  },
  "dr": {
    "rto_p99_seconds": 3600,
    "rpo_p99_seconds": 300,
    "multi_region_active_active": true,
    "backup_substrate": [
      "valkey_cluster",
      "postgres_wal_g",
      "object_storage_versioned",
      "seaweedfs_replicated"
    ],
    "failover_runbook": "runbooks/pstn-provider-failover.md",
    "dr_tier": "T1",
    "replication_shape": "active-active-multi-az-cross-region-warm"
  },
  "pod_runtime_tier": 2,
  "pod_runtime_tier_justification": "Contact center is a first-party real-time communications product. It touches HIPAA/PCI/TCPA tenant data and consent state, but it does not run tenant code or act as shared edge infrastructure, so runtime Tier 2 is retained.",
  "pod_runtime_tier_surface_evidence": [
    "microservices/contact-center/PRD.md",
    "microservices/contact-center/ARCHITECTURE.md",
    "microservices/contact-center/IP-026-omnichannel-routing-policy-engine.md"
  ],
  "tenant_version_pinning": {
    "declared_versions": [
      "2026-05-21"
    ],
    "default_version": "2026-05-21",
    "supported_window_size": 3,
    "supported_window_minimum_days": 180,
    "supports_per_tenant_pinning": true,
    "deprecation_calendar": [],
    "public_surface_files": {
      "openapi": {
        "2026-05-21": "microservices/contact-center/contracts/openapi-v1.yaml"
      },
      "asyncapi": {
        "2026-05-21": "microservices/contact-center/contracts/asyncapi-v1.yaml"
      }
    }
