{
  "$schema": "https://schemas.grafana.com/dashboard.json",
  "_meta": {
    "doc_class": "GrafanaDashboard",
    "microservice": "messenger",
    "owner_team": "axis-messenger + ops-sre-reliability",
    "audience": "tenant operator + axis-messenger SRE",
    "tenant_scoped": true,
    "datasource": "per-pack Mimir; tenant-scoped via X-Scope-OrgID"
  },
  "uid": "msg-realtime-fanout",
  "title": "messenger: real-time fan-out (WebSocket + presence + read-receipt)",
  "tags": ["messenger", "websocket", "fanout", "burn-rate"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "templating": {
    "list": [
      {"name": "pack", "type": "custom", "label": "Pack",
        "options": [
          {"text": "pack-kr", "value": "kr", "selected": true},
          {"text": "pack-eu", "value": "eu"},
          {"text": "pack-us", "value": "us"},
          {"text": "pack-us-healthcare", "value": "us-hc"},
          {"text": "pack-jp", "value": "jp"},
          {"text": "pack-sg", "value": "sg"},
          {"text": "pack-au", "value": "au"},
          {"text": "pack-in", "value": "in"},
          {"text": "pack-br", "value": "br"},
          {"text": "pack-ae", "value": "ae"},
          {"text": "pack-ksa", "value": "ksa"}
        ]},
      {"name": "tenant", "type": "query", "label": "Tenant",
        "query": "label_values(oya_messenger_message_send_total{pack=\"$pack\"}, tenant_id)"}
    ]
  },
  "panels": [
    {"id": 1, "type": "stat", "title": "Active WebSocket connections",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "sum(oya_messenger_gateway_active_connections_total{pack=\"$pack\",tenant_id=\"$tenant\"})", "refId": "A"}]},

    {"id": 2, "type": "stat", "title": "Messages/sec (5m rate)",
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "sum(rate(oya_messenger_message_send_total{pack=\"$pack\",tenant_id=\"$tenant\",result=\"success\"}[5m]))", "refId": "A"}]},

    {"id": 3, "type": "stat", "title": "Message-send p99 (s)",
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "histogram_quantile(0.99, sum by (le) (rate(oya_messenger_message_send_duration_seconds_bucket{pack=\"$pack\",tenant_id=\"$tenant\"}[5m])))", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"mode": "absolute", "steps": [{"value": null, "color": "green"}, {"value": 0.05, "color": "yellow"}, {"value": 0.1, "color": "red"}]}}}},

    {"id": 4, "type": "stat", "title": "WS fanout p99 (s)",
      "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "histogram_quantile(0.99, sum by (le) (rate(oya_messenger_ws_fanout_duration_seconds_bucket{pack=\"$pack\",tenant_id=\"$tenant\"}[5m])))", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"mode": "absolute", "steps": [{"value": null, "color": "green"}, {"value": 0.05, "color": "yellow"}, {"value": 0.1, "color": "red"}]}}}},

    {"id": 5, "type": "timeseries", "title": "WebSocket connections per gateway pod",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "targets": [{"expr": "oya_messenger_gateway_active_connections_total{pack=\"$pack\"} by (pod)", "legendFormat": "{{pod}}", "refId": "A"}]},

    {"id": 6, "type": "timeseries", "title": "Message-send latency percentiles",
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum by (le) (rate(oya_messenger_message_send_duration_seconds_bucket{pack=\"$pack\",tenant_id=\"$tenant\"}[5m])))", "legendFormat": "p50", "refId": "A"},
        {"expr": "histogram_quantile(0.95, sum by (le) (rate(oya_messenger_message_send_duration_seconds_bucket{pack=\"$pack\",tenant_id=\"$tenant\"}[5m])))", "legendFormat": "p95", "refId": "B"},
        {"expr": "histogram_quantile(0.99, sum by (le) (rate(oya_messenger_message_send_duration_seconds_bucket{pack=\"$pack\",tenant_id=\"$tenant\"}[5m])))", "legendFormat": "p99", "refId": "C"}
      ]},

    {"id": 7, "type": "timeseries", "title": "Read-receipt fanout p99 + coalesce ratio",
      "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
      "targets": [
        {"expr": "histogram_quantile(0.99, sum by (le) (rate(oya_messenger_read_receipt_fanout_duration_seconds_bucket{pack=\"$pack\",tenant_id=\"$tenant\"}[5m])))", "legendFormat": "p99 fanout", "refId": "A"},
        {"expr": "sum(rate(oya_messenger_read_receipt_coalesced_total{pack=\"$pack\",tenant_id=\"$tenant\"}[5m])) / sum(rate(oya_messenger_read_receipt_submitted_total{pack=\"$pack\",tenant_id=\"$tenant\"}[5m]))", "legendFormat": "coalesce ratio", "refId": "B"}
      ]},

    {"id": 8, "type": "timeseries", "title": "Presence propagation p99",
      "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8},
      "targets": [{"expr": "histogram_quantile(0.99, sum by (le) (rate(oya_messenger_presence_propagation_seconds_bucket{pack=\"$pack\",tenant_id=\"$tenant\"}[5m])))", "legendFormat": "p99", "refId": "A"}]},

    {"id": 9, "type": "timeseries", "title": "Mention fanout p99",
      "gridPos": {"x": 0, "y": 20, "w": 12, "h": 8},
      "targets": [{"expr": "histogram_quantile(0.99, sum by (le) (rate(oya_messenger_mention_fanout_duration_seconds_bucket{pack=\"$pack\",tenant_id=\"$tenant\"}[5m])))", "legendFormat": "p99", "refId": "A"}]},

    {"id": 10, "type": "timeseries", "title": "WebSocket frame backpressure (queued frames per pod)",
      "gridPos": {"x": 12, "y": 20, "w": 12, "h": 8},
      "targets": [{"expr": "oya_messenger_gateway_frame_queue_depth{pack=\"$pack\"}", "legendFormat": "{{pod}}", "refId": "A"}]},

    {"id": 11, "type": "stat", "title": "Burn-rate (fast 1h)",
      "gridPos": {"x": 0, "y": 28, "w": 6, "h": 4},
      "targets": [{"expr": "oya_promotion_burn_rate_fast_1h{microservice=\"messenger\",pack=\"$pack\",sli=\"availability\"}", "refId": "A"}],
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"value": null, "color": "green"}, {"value": 6, "color": "yellow"}, {"value": 14.4, "color": "red"}]}}}},

    {"id": 12, "type": "stat", "title": "Eligibility verdict",
      "gridPos": {"x": 6, "y": 28, "w": 6, "h": 4},
      "targets": [{"expr": "oya:current_verdict:by_microservice_env{microservice=\"messenger\",pack=\"$pack\",environment=\"production\"}", "refId": "A"}]},

    {"id": 13, "type": "table", "title": "Top 10 noisy channels (msgs/sec)",
      "gridPos": {"x": 12, "y": 28, "w": 12, "h": 8},
      "targets": [{"expr": "topk(10, sum by (channel_id) (rate(oya_messenger_message_send_total{pack=\"$pack\",tenant_id=\"$tenant\"}[5m])))", "format": "table", "refId": "A"}]}
  ]
}
