{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "contract_id": "RESILIENCE-001-MESSENGER-RUNTIME-CONTROL-LOOP",
  "source_task": "t_c127bb35",
  "status": "Evidence-contract-only",
  "service": {
    "name": "messenger",
    "path": "comms/messenger",
    "manifest": "comms/messenger/manifest.json",
    "bounded_context": "message-stream"
  },
  "authority": {
    "accepted_adrs": [
      "ADR-0165",
      "ADR-0168",
      "ADR-0176",
      "ADR-0180",
      "ADR-0186",
      "ADR-0210",
      "ADR-0241"
    ],
    "proposed_context_adrs": [
      "ADR-0263",
      "ADR-0306"
    ],
    "proposed_context_only": true,
    "proposed_context_boundary": "ADR-0263 and ADR-0306 are cited only for planned evidence/audit/disaster vocabulary; this contract does not elevate Proposed ADRs to binding merge or runtime authority."
  },
  "claim_controls": {
    "metadata_only": true,
    "evidence_contract_only": true,
    "strict_separation": true,
    "no_live_chaos_execution": true,
    "no_runtime_control_loop": true,
    "no_measured_slo_claim": true,
    "no_public_sla_slo_claim": true,
    "no_status_page_live_claim": true,
    "no_disaster_mode_runtime_claim": true,
    "no_production_readiness_claim": true,
    "no_tenant_traffic_claim": true,
    "proposed_adrs_not_elevated": true
  },
  "runtime_control_loop": {
    "chaos_catalog": {
      "catalog_status": "scenario_catalog_only",
      "engine": "Chaos Mesh 2.x",
      "cadence": "nightly-staging-after-review-and-runtime-wiring",
      "scenarios": [
        {
          "id": "pod-kill",
          "path": "comms/messenger/chaos/scenarios/pod-kill.yaml",
          "failure_mode": "single messenger pod killed during staging drill",
          "target": "messenger app deployment"
        },
        {
          "id": "network-delay-100ms",
          "path": "comms/messenger/chaos/scenarios/network-delay-100ms.yaml",
          "failure_mode": "100ms latency injection on messenger traffic",
          "target": "messenger app deployment"
        },
        {
          "id": "dependency-failure",
          "path": "comms/messenger/chaos/scenarios/dependency-failure.yaml",
          "failure_mode": "Valkey Streams handoff dependency abort for POST /api/v1/messages",
          "target": "message-stream dependency boundary"
        },
        {
          "id": "disk-slow-1000ms",
          "path": "comms/messenger/chaos/scenarios/disk-slow-1000ms.yaml",
          "failure_mode": "1000ms IO latency on messenger attachment/message-state paths",
          "target": "messenger app deployment"
        }
      ],
      "slo_gate_refs": [
        "message-send-availability",
        "message-send-latency"
      ],
      "release_blocker_semantics": "A future staging drill failure must block messenger promotion only after live drill execution and measured SLO evidence exist; this slice declares the evidence contract only."
    },
    "brownout_signal": {
      "source_spec": "specs/brownout-degradation-signal.json",
      "header_name": "oya-degradation-class",
      "metric_name": "oya_degradation_class",
      "classes": [
        "nominal",
        "degraded",
        "brownout",
        "outage"
      ],
      "audit_chain_class": "DegradationStateChange",
      "messenger_policy": "message-stream REST, websocket fanout, huddle signaling, and attachment worker paths must emit nominal/degraded/brownout/outage once runtime implementation exists."
    },
    "slo_composition": {
      "composition_ref": "comms/observability/slos/messenger/composition.openslo.yaml",
      "composition_kind": "critical_path",
      "parent_slo": "messenger-runtime-reliability",
      "child_slo_refs": [
        "message-send-availability",
        "message-send-latency",
        "websocket-fanout-latency",
        "presence-propagation"
      ],
      "rollback_frontier": "messenger parent reliability composition; no Flagger or SLO engine runtime is claimed in this slice."
    },
    "tail_sampling": {
      "manifest_field_ref": "comms/messenger/manifest.json#/observability_trace_sampling_recipe",
      "head_bps": 100,
      "tail_policies": [
        "status_code=ERROR",
        "latency_p99",
        "new_endpoint_warmup",
        "slo_burn",
        "audit_event",
        "random_baseline=0.01"
      ],
      "p99_latency_threshold_ms": 100,
      "decision_wait_seconds": 30,
      "claim_boundary": "Per-service manifest recipe only; no collector gateway or Tempo ingestion runtime is deployed by this slice."
    },
    "status_page_projection": {
      "projection_status": "projection_contract_only",
      "component": "messenger",
      "api_shape": "Statuspage.io-compatible summary.json/component projection contract only; no public status service is deployed by this slice.",
      "status_enum_map": {
        "operational": "all messenger critical-path SLOs healthy",
        "degraded_performance": "latency or brownout class degraded while availability remains inside target",
        "partial_outage": "availability SLO breach isolated to a subset of cells or regions",
        "major_outage": "fleet-wide messenger availability SLO breach",
        "under_maintenance": "scheduled messenger maintenance window active"
      },
      "independence_requirement": "Future public status projection must not depend on tenant auth availability."
    },
    "disaster_mode_evidence": {
      "source_adr": "ADR-0306",
      "source_adr_status": "Proposed/context-only",
      "headers": [
        "X-Oya-Disaster-Mode-Active",
        "X-Oya-DR-Pair-Cell",
        "X-Oya-Load-Shed-Tier"
      ],
      "audit_event_classes": [
        "DisasterModeActivated",
        "DisasterModeDeactivated",
        "DRPairFailoverInitiated",
        "DRPairFailoverCompleted",
        "LoadShedTierEscalated"
      ],
      "emergency_services_never_throttle": true,
      "messenger_scope": "Messenger may shed non-essential fanout and media features in a future disaster-mode runtime, but must preserve emergency-services non-throttle if an emergency path is ever routed through messenger."
    }
  },
  "evidence_required_before_runtime_claim": [
    "chaos_drill_receipt",
    "measured_slo_window",
    "brownout_state_transition_receipt",
    "tail_sampling_fidelity_receipt",
    "status_page_projection_receipt",
    "dr_or_disaster_mode_drill_receipt",
    "audit_chain_correlation_receipt",
    "independent_review_approval",
    "oya_ci_required_green"
  ],
  "nonclaims": [
    "no_live_chaos_execution",
    "no_runtime_control_loop",
    "no_measured_slo_claim",
    "no_public_sla_slo_claim",
    "no_status_page_live_claim",
    "no_disaster_mode_runtime_claim",
    "no_production_readiness_claim",
    "no_tenant_traffic_claim"
  ]
}
