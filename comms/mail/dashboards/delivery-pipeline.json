{
  "$schema": "https://schemas.grafana.com/dashboard.json",
  "_meta": {
    "doc_class": "GrafanaDashboard",
    "microservice": "mail",
    "owner_team": "axis-mail + ops-deliverability",
    "related_artifacts": [
      "comms/mail/contracts/openapi/mail.yaml",
      "comms/mail/contracts/asyncapi/mail-events.yaml",
      "microservices/mail/slos/outbound-delivery-latency.openslo.yaml",
      "microservices/mail/slos/inbound-receive-availability.openslo.yaml",
      "comms/mail/runbooks/smtp-queue-backup.md",
      "comms/mail/runbooks/dkim-key-rotation.md"
    ],
    "audience": "tenant operators + ops-deliverability",
    "tenant_scoped": true,
    "datasource": "Mimir (per-pack); X-Scope-OrgID = principal.tenant_id"
  },
  "uid": "mail-delivery-pipeline",
  "title": "Mail — Delivery pipeline (inbound + outbound)",
  "tags": ["mail", "delivery", "deliverability", "tenant-facing"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "templating": {
    "list": [
      {"name": "tenant_id", "type": "query", "datasource": "Mimir", "query": "label_values(oya_mail_outbound_message_total, tenant_id)", "refresh": 1, "label": "Tenant"},
      {"name": "pack", "type": "custom", "options": [
        {"text": "pack-kr", "value": "kr", "selected": true},
        {"text": "pack-eu", "value": "eu"},
        {"text": "pack-us", "value": "us"},
        {"text": "pack-us-healthcare", "value": "us-hc"},
        {"text": "pack-jp", "value": "jp"},
        {"text": "pack-sg", "value": "sg"},
        {"text": "pack-au", "value": "au"},
        {"text": "pack-in", "value": "in"},
        {"text": "pack-br", "value": "br"},
        {"text": "pack-ae", "value": "ae"},
        {"text": "pack-ksa", "value": "ksa"}
      ], "label": "Pack"}
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Inbound message rate (msg/s)",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "targets": [
        {"expr": "sum(rate(oya_mail_inbound_message_total{tenant_id=\"$tenant_id\",pack=\"$pack\"}[5m]))", "refId": "A"}
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Outbound message rate (msg/s)",
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
      "targets": [
        {"expr": "sum(rate(oya_mail_outbound_message_total{tenant_id=\"$tenant_id\",pack=\"$pack\"}[5m]))", "refId": "A"}
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Outbound queue depth (s)",
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
      "targets": [
        {"expr": "oya_mail_outbound_queue_depth_seconds{tenant_id=\"$tenant_id\",pack=\"$pack\"}", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 30}, {"color": "red", "value": 60}]}}}
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Deliverability reputation",
      "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
      "targets": [
        {"expr": "oya_mail_deliverability_reputation_score{tenant_id=\"$tenant_id\",pack=\"$pack\"}", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "none", "thresholds": {"steps": [{"color": "red", "value": 0}, {"color": "yellow", "value": 70}, {"color": "green", "value": 85}]}}}
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Inbound: SMTP DATA p99 + post-data persist p99",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "targets": [
        {"expr": "histogram_quantile(0.99, sum(rate(oya_mail_inbound_smtp_data_duration_seconds_bucket{tenant_id=\"$tenant_id\",pack=\"$pack\"}[5m])) by (le))", "legendFormat": "SMTP DATA p99", "refId": "A"},
        {"expr": "histogram_quantile(0.99, sum(rate(oya_mail_inbound_smtp_post_data_persist_seconds_bucket{tenant_id=\"$tenant_id\",pack=\"$pack\"}[5m])) by (le))", "legendFormat": "Persist p99", "refId": "B"}
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Outbound: submission p99 + delivery p99 (queue → recipient MX)",
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
      "targets": [
        {"expr": "histogram_quantile(0.99, sum(rate(oya_mail_outbound_submission_seconds_bucket{tenant_id=\"$tenant_id\",pack=\"$pack\"}[5m])) by (le))", "legendFormat": "Submission p99", "refId": "A"},
        {"expr": "histogram_quantile(0.99, sum(rate(oya_mail_outbound_delivery_seconds_bucket{tenant_id=\"$tenant_id\",pack=\"$pack\"}[5m])) by (le))", "legendFormat": "Delivery p99", "refId": "B"}
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "DKIM verify (inbound) + sign (outbound)",
      "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum by (result) (rate(oya_mail_inbound_dkim_verify_total{tenant_id=\"$tenant_id\",pack=\"$pack\"}[5m]))", "legendFormat": "verify {{result}}", "refId": "A"},
        {"expr": "sum(rate(oya_mail_outbound_dkim_sign_total{tenant_id=\"$tenant_id\",pack=\"$pack\"}[5m]))", "legendFormat": "sign success", "refId": "B"},
        {"expr": "sum(rate(oya_mail_outbound_dkim_sign_error_total{tenant_id=\"$tenant_id\",pack=\"$pack\"}[5m]))", "legendFormat": "sign error", "refId": "C"}
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "SPF / DMARC / ARC alignment (inbound)",
      "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum by (result) (rate(oya_mail_inbound_spf_total{tenant_id=\"$tenant_id\",pack=\"$pack\"}[5m]))", "legendFormat": "spf {{result}}", "refId": "A"},
        {"expr": "sum by (result) (rate(oya_mail_inbound_dmarc_total{tenant_id=\"$tenant_id\",pack=\"$pack\"}[5m]))", "legendFormat": "dmarc {{result}}", "refId": "B"},
        {"expr": "sum by (result) (rate(oya_mail_inbound_arc_total{tenant_id=\"$tenant_id\",pack=\"$pack\"}[5m]))", "legendFormat": "arc {{result}}", "refId": "C"}
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Bounce classification + complaint rate",
      "gridPos": {"x": 0, "y": 20, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum by (bounce_class) (rate(oya_mail_outbound_bounce_total{tenant_id=\"$tenant_id\",pack=\"$pack\"}[5m]))", "legendFormat": "{{bounce_class}}", "refId": "A"},
        {"expr": "rate(oya_mail_outbound_complaint_total{tenant_id=\"$tenant_id\",pack=\"$pack\"}[5m])", "legendFormat": "complaint", "refId": "B"}
      ]
    },
    {
      "id": 10,
      "type": "table",
      "title": "Top destination domains by deferral / bounce volume",
      "gridPos": {"x": 12, "y": 20, "w": 12, "h": 8},
      "targets": [
        {"expr": "topk(10, sum by (recipient_domain) (rate(oya_mail_outbound_defer_total{tenant_id=\"$tenant_id\",pack=\"$pack\"}[1h])))", "format": "table", "refId": "A"}
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "DKIM key age (days) per active selector",
      "gridPos": {"x": 0, "y": 28, "w": 12, "h": 6},
      "targets": [
        {"expr": "oya_mail_dkim_key_age_days{tenant_id=\"$tenant_id\",pack=\"$pack\"}", "legendFormat": "{{selector}}", "refId": "A"}
      ],
      "alert": {
        "name": "dkim-key-rotation-overdue",
        "conditions": [
          {"evaluator": {"params": [90], "type": "gt"}, "query": {"params": ["A", "5m", "now"]}, "type": "query"}
        ],
        "notifications": [{"uid": "grafana-oncall-mail"}]
      }
    },
    {
      "id": 12,
      "type": "stat",
      "title": "MTA-STS + TLS-RPT health",
      "gridPos": {"x": 12, "y": 28, "w": 12, "h": 6},
      "targets": [
        {"expr": "oya_mail_mta_sts_published_total{tenant_id=\"$tenant_id\",pack=\"$pack\"}", "legendFormat": "MTA-STS policies published", "refId": "A"},
        {"expr": "rate(oya_mail_tls_rpt_report_received_total{tenant_id=\"$tenant_id\",pack=\"$pack\"}[24h])", "legendFormat": "TLS-RPT reports/24h", "refId": "B"}
      ]
    }
  ]
}
