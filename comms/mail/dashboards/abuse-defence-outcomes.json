{
  "dashboard": {
    "title": "Mail — Abuse-Defence Outcomes",
    "uid": "mail-abuse-defence-outcomes",
    "tags": ["mail", "abuse-defence", "ADR-0297", "UX-floor"],
    "panels": [
      {
        "id": 1,
        "title": "Default-path JMAP latency added (P99 ms)",
        "type": "timeseries",
        "targets": [
          {"expr": "histogram_quantile(0.99, sum(rate(oya_mail_abuse_defence_added_latency_seconds_bucket[5m])) by (le))"}
        ],
        "thresholds": [{"color": "green", "value": 0}, {"color": "red", "value": 0.002}],
        "description": "UX-floor: MUST stay ≤2ms p99"
      },
      {
        "id": 2,
        "title": "Anti-phishing block rate",
        "type": "timeseries",
        "targets": [
          {"expr": "sum(rate(oya_mail_anti_phishing_block_total[5m])) by (reason)"}
        ]
      },
      {
        "id": 3,
        "title": "Quarantine release rate",
        "type": "timeseries",
        "targets": [
          {"expr": "sum(rate(oya_mail_anti_phishing_release_total[5m])) by (reason)"}
        ]
      },
      {
        "id": 4,
        "title": "CAPTCHA presentations (sign-up + password-reset only)",
        "type": "timeseries",
        "targets": [
          {"expr": "sum(rate(oya_mail_abuse_defence_captcha_present_total[5m])) by (route)"}
        ]
      },
      {
        "id": 5,
        "title": "False-positive rate (24h)",
        "type": "stat",
        "targets": [
          {"expr": "sum(rate(oya_mail_abuse_defence_false_positive_total[24h])) / sum(rate(oya_mail_abuse_defence_evaluation_total[24h]))"}
        ]
      },
      {
        "id": 6,
        "title": "Account-compromise events (24h)",
        "type": "stat",
        "targets": [
          {"expr": "sum(rate(oya_mail_account_compromise_event_total[24h]))"}
        ]
      }
    ]
  }
}
