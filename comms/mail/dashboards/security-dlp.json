{
  "$schema": "https://schemas.grafana.com/dashboard.json",
  "_meta": {
    "doc_class": "GrafanaDashboard",
    "microservice": "mail",
    "owner_team": "ops-security + council-privacy + axis-mail",
    "related_artifacts": [
      "microservices/mail/threat-model.md",
      "microservices/mail/dpia.md",
      "microservices/mail/policy/dual-context-isolation.md",
      "comms/mail/capabilities/T1-assist.yaml",
      "comms/mail/capabilities/T2-auto.yaml",
      "comms/mail/runbooks/dlp-quarantine-release.md",
      "comms/mail/runbooks/spam-rule-rollback.md",
      "comms/mail/runbooks/e2e-encryption-key-recovery.md"
    ],
    "audience": "internal security operators (admin RBAC + Cedar)",
    "tenant_scoped": false,
    "datasource": "Mimir aggregate (DP-noise protected for cross-tenant aggregates)"
  },
  "uid": "mail-security-dlp",
  "title": "Mail — Security + DLP + abuse + dual-context",
  "tags": ["mail", "security", "dlp", "operator"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-24h", "to": "now"},
  "templating": {
    "list": [
      {"name": "pack", "type": "custom", "options": [
        {"text": "pack-kr", "value": "kr", "selected": true},
        {"text": "pack-eu", "value": "eu"},
        {"text": "pack-us", "value": "us"},
        {"text": "pack-us-healthcare", "value": "us-hc"},
        {"text": "pack-jp", "value": "jp"},
        {"text": "pack-sg", "value": "sg"},
        {"text": "pack-au", "value": "au"},
        {"text": "pack-in", "value": "in"},
        {"text": "pack-br", "value": "br"},
        {"text": "pack-ae", "value": "ae"},
        {"text": "pack-ksa", "value": "ksa"}
      ], "label": "Pack"}
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "DLP quarantine depth (count)",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "targets": [
        {"expr": "sum(oya_mail_dlp_quarantine_depth{pack=\"$pack\"})", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 50}, {"color": "red", "value": 200}]}}}
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Oldest DLP quarantine age (h)",
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
      "targets": [
        {"expr": "max(oya_mail_dlp_quarantine_age_p99_seconds{pack=\"$pack\"}) / 3600", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "h", "thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 2}, {"color": "red", "value": 24}]}}}
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Spam FP rate (5m)",
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
      "targets": [
        {"expr": "oya_mail_inbound_spam_false_positive_rate_5m{pack=\"$pack\"}", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "percentunit", "thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 0.01}, {"color": "red", "value": 0.05}]}}}
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Cross-context routing refusals (24h)",
      "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
      "targets": [
        {"expr": "sum(increase(oya_mail_cross_context_routing_refused_total{pack=\"$pack\"}[24h]))", "refId": "A"}
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "DLP quarantine inflow vs outflow",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "targets": [
        {"expr": "rate(oya_mail_dlp_quarantined_total{pack=\"$pack\"}[5m])", "legendFormat": "inflow", "refId": "A"},
        {"expr": "rate(oya_mail_dlp_released_total{pack=\"$pack\"}[5m])", "legendFormat": "outflow (release)", "refId": "B"},
        {"expr": "rate(oya_mail_dlp_discarded_total{pack=\"$pack\"}[5m])", "legendFormat": "outflow (discard)", "refId": "C"}
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Abuse verdicts (inbound classifier)",
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum by (verdict) (rate(oya_mail_abuse_verdict_total{pack=\"$pack\"}[5m]))", "legendFormat": "{{verdict}}", "refId": "A"}
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Spam classifier model version + per-rule fire rate (top 10)",
      "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
      "targets": [
        {"expr": "oya_mail_spam_classifier_model_version{pack=\"$pack\"}", "legendFormat": "model version", "refId": "A"},
        {"expr": "topk(10, sum by (rule_id) (rate(oya_mail_inbound_spam_rule_fire_total{pack=\"$pack\"}[5m])))", "legendFormat": "{{rule_id}}", "refId": "B"}
      ]
    },
    {
      "id": 8,
      "type": "table",
      "title": "Personal-pillar protection violations (must be 0)",
      "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum by (kind) (increase(oya_mail_personal_pillar_hold_attempt_total{pack=\"$pack\"}[24h]))", "legendFormat": "hold attempts", "refId": "A", "format": "table"},
        {"expr": "sum by (kind) (increase(oya_mail_personal_pillar_kms_violation_total{pack=\"$pack\"}[24h]))", "legendFormat": "kms violations", "refId": "B", "format": "table"}
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Legal hold engaged + released (24h)",
      "gridPos": {"x": 0, "y": 20, "w": 12, "h": 6},
      "targets": [
        {"expr": "increase(oya_mail_legal_hold_engaged_total{pack=\"$pack\"}[24h])", "legendFormat": "engaged", "refId": "A"},
        {"expr": "increase(oya_mail_legal_hold_released_total{pack=\"$pack\"}[24h])", "legendFormat": "released", "refId": "B"},
        {"expr": "increase(oya_mail_legal_hold_bypass_attempt_total{pack=\"$pack\"}[24h])", "legendFormat": "bypass attempt (page!)", "refId": "C"}
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Retention floor conformance + statutory-floor saves",
      "gridPos": {"x": 12, "y": 20, "w": 12, "h": 6},
      "targets": [
        {"expr": "increase(oya_mail_retention_expired_total{pack=\"$pack\"}[24h])", "legendFormat": "expired", "refId": "A"},
        {"expr": "increase(oya_mail_retention_statutory_floor_save_total{pack=\"$pack\"}[24h])", "legendFormat": "saved by floor", "refId": "B"},
        {"expr": "increase(oya_mail_retention_hold_check_skip_total{pack=\"$pack\"}[24h])", "legendFormat": "skipped by hold", "refId": "C"}
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "eDiscovery exports (last 30d)",
      "gridPos": {"x": 0, "y": 26, "w": 12, "h": 6},
      "targets": [
        {"expr": "increase(oya_mail_ediscovery_export_sealed_total{pack=\"$pack\"}[30d])", "legendFormat": "exports sealed", "refId": "A"},
        {"expr": "histogram_quantile(0.99, sum(rate(oya_mail_ediscovery_export_duration_seconds_bucket{pack=\"$pack\"}[30d])) by (le))", "legendFormat": "duration p99", "refId": "B"}
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "DKIM rotation cadence (per-tenant key age in days)",
      "gridPos": {"x": 12, "y": 26, "w": 12, "h": 6},
      "targets": [
        {"expr": "max by (tenant_id) (oya_mail_dkim_key_age_days{pack=\"$pack\"})", "legendFormat": "{{tenant_id}}", "refId": "A"}
      ],
      "alert": {
        "name": "dkim-key-overdue-90d",
        "conditions": [{"evaluator": {"params": [90], "type": "gt"}, "query": {"params": ["A", "5m", "now"]}, "type": "query"}],
        "notifications": [{"uid": "grafana-oncall-mail-security"}]
      }
    }
  ]
}
