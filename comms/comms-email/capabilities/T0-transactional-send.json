{
  "capability_id": "T0-transactional-send",
  "tier": "T0",
  "name": "Transactional email send",
  "owner": "oya-substrate-comms",
  "adr_anchors": ["ADR-0201", "ADR-0149"],
  "description": "Send a single transactional message to one or more recipients with DKIM signing, SPF authorization, DMARC enforcement, idempotency-key dedup, and audit-chain emission.",
  "data_class": "PII",
  "operations": [
    {
      "verb": "POST",
      "path": "/v1/messages",
      "idempotent": true,
      "idempotency_header": "Idempotency-Key",
      "max_recipients": 50
    }
  ],
  "rate_limits": {
    "per_tenant_per_minute": 1000,
    "burst_multiplier": 2
  },
  "preflight": [
    "DkimBindingMissing",
    "SpfNotAuthorized",
    "DmarcPolicyForbidden",
    "RecipientSuppressed",
    "RateCeilingExceeded",
    "InvalidAddress",
    "EmptyMessage",
    "NoRecipients",
    "IdempotencyConflict"
  ],
  "audit_chain_events": [
    "send.preflight.accepted",
    "send.preflight.rejected",
    "send.provider.accepted",
    "send.provider.error"
  ],
  "slo_anchors": [
    "send-latency-p99",
    "send-success-rate",
    "dkim-signing-rate"
  ]
}
