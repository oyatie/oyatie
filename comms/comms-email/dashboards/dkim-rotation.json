{
  "title": "Comms-Email — DKIM Rotation",
  "uid": "comms-email-dkim-rotation",
  "schemaVersion": 39,
  "tags": ["comms-email", "dkim", "ADR-0273"],
  "panels": [
    {"id": 1, "type": "stat", "title": "Keys age > 80d (rotate soon)",
     "targets": [{"expr": "count(oya_comms_email_dkim_key_age_days > 80)"}]},
    {"id": 2, "type": "stat", "title": "Keys past 90d rotation SLA",
     "targets": [{"expr": "count(oya_comms_email_dkim_key_age_days > 90)"}]},
    {"id": 3, "type": "timeseries", "title": "Rotations per day",
     "targets": [{"expr": "sum(rate(oya_comms_email_dkim_rotated_total[1d]))"}]},
    {"id": 4, "type": "table", "title": "DMARC alignment failures by tenant",
     "targets": [{"expr": "sum by (tenant_id) (rate(oya_comms_email_dmarc_alignment_fail_total[1h]))"}]}
  ],
  "binding_adrs": ["ADR-0273", "ADR-0263"]
}
