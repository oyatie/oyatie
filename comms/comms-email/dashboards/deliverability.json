{
  "title": "comms-email · deliverability",
  "description": "Long-haul deliverability: delivered rate, bounce rate, complaint rate, DMARC alignment.",
  "tags": ["comms-email", "adr-0201", "deliverability"],
  "panels": [
    {
      "title": "Delivered rate (24h)",
      "type": "graph",
      "targets": [
        {"expr": "sum(rate(comms_email_delivery_event_total{kind=\"delivered\"}[24h])) / sum(rate(comms_email_provider_accepted_total[24h]))"}
      ]
    },
    {
      "title": "Bounce rate (1h, per tenant)",
      "type": "graph",
      "targets": [
        {"expr": "sum by (tenant_id) (rate(comms_email_delivery_event_total{kind=\"bounced\"}[1h])) / sum by (tenant_id) (rate(comms_email_provider_accepted_total[1h]))"}
      ],
      "thresholds": [{"value": 0.05, "colorMode": "critical", "op": "gt"}]
    },
    {
      "title": "Complaint rate (1h, per tenant)",
      "type": "graph",
      "targets": [
        {"expr": "sum by (tenant_id) (rate(comms_email_delivery_event_total{kind=\"complained\"}[1h])) / sum by (tenant_id) (rate(comms_email_provider_accepted_total[1h]))"}
      ],
      "thresholds": [{"value": 0.001, "colorMode": "critical", "op": "gt"}]
    },
    {
      "title": "DMARC alignment rate (post-warmup)",
      "type": "graph",
      "targets": [
        {"expr": "sum(rate(comms_email_dmarc_aligned_total{warmup=\"complete\"}[24h])) / sum(rate(comms_email_dmarc_report_total{warmup=\"complete\"}[24h]))"}
      ]
    },
    {
      "title": "Open + click rate by tenant",
      "type": "graph",
      "targets": [
        {"expr": "sum by (tenant_id, kind) (rate(comms_email_delivery_event_total{kind=~\"opened|clicked\"}[24h]))"}
      ]
    }
  ]
}
