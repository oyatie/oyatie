      "python parse specs/capability-registry.json capabilities + pending_relocations",
      "rg oya/{drive,recordings,emergency,imaging,diagnostics} across specs/ci/docs",
      "read ADR-0615 §2 Q2/Q3/Q4/Q8 + §3 + §6"
    ],
    "no_path_moves": true,
    "no_new_move_plan": true
  }
}
