{
  "schema_version": "1.0",
  "ledger_kind": "parent-wiring-todo",
  "emitted_at": "2026-05-18",
  "batch": "storage-backup-autoscaling-finops",
  "authored_by": "agent-storage-batch",
  "leave_for_parent": true,
  "notes": "Per scope-confirmation directive: child agent did NOT touch dispatcher, lanes.yaml, manifest schema. Items below are the wiring deltas the parent agent must apply.",
  "manifest_schema_deltas": [
    {
      "path": "storage.object_store.enabled",
      "type": "boolean",
      "default": false,
      "description": "Toggle SeaweedFS object-store consumption for this µservice per ADR-0196.",
      "authority_adr": "ADR-0196"
    },
    {
      "path": "storage.object_store.buckets",
      "type": "array<object>",
      "schema": {
        "name": "string (canonical shape oya-<purpose>-<tenant-or-shared>-<env>)",
        "purpose": "enum (workflow-artifacts|evidence|clickhouse-cold|milvus-object|velero-backup|audit-chain-archive|backup-postgres|backup-filesystem|tenant-uploads|finops-focus-export)",
        "quota": "string (Helm-style: 100Gi)",
        "ttl": "duration (90d, 7y, 10y, ...)"
      },
      "description": "Per-µservice bucket preallocation list per ADR-0196 D-3.",
      "authority_adr": "ADR-0196"
    },
    {
      "path": "storage.backup.tier",
      "type": "enum",
      "values": ["app", "batch", "gpu", "regulatory"],
      "description": "Backup workload-class per ADR-0197 D-4. Determines RPO/RTO target.",
      "authority_adr": "ADR-0197"
    },
    {
      "path": "storage.backup.retention_days",
      "type": "integer",
      "minimum": 0,
      "description": "Declared backup retention; validated against regulatory_pack floor per ADR-0197 D-5.",
      "authority_adr": "ADR-0197"
    },
    {
      "path": "compute.autoscaler.node_pool",
      "type": "enum",
      "values": ["app", "batch", "gpu", "regulatory"],
      "description": "Karpenter NodePool selector per ADR-0198 D-2.",
      "authority_adr": "ADR-0198"
    },
    {
      "path": "finops.cost_center",
      "type": "string (closed enum from registry/finops/cost-tag-vocabulary.yaml)",
      "description": "Mandatory per ADR-0199 D-1. CI-enforced via oya-check-tenant-cost-labels-coverage.",
      "authority_adr": "ADR-0199"
    },
    {
      "path": "finops.workload_class",
      "type": "enum",
      "values": ["app", "batch", "gpu", "regulatory"],
      "description": "Mandatory per ADR-0199 D-1.",
      "authority_adr": "ADR-0199"
    },
    {
      "path": "finops.regulatory_pack",
      "type": "enum",
      "values": ["generic", "kr", "eu", "us-healthcare", "us-financial", "us-public-sector"],
      "description": "Drives retention floor + region-pin behavior.",
      "authority_adr": "ADR-0199"
    }
  ],
  "helm_helper_additions": [
    {
      "helper": "oya.tenantCostLabels",
      "file": "microservices/governance/iac/helm/_oya-helpers/templates/_helpers.tpl",
      "spec": "emits oya.io/tenant-id, oya.io/cost-center (required), oya.io/workload-class (required), oya.io/regulatory-pack (default generic). See docs/standards/finops-cost-attribution-canonical.md for the canonical body.",
      "authority_adr": "ADR-0199 D-2"
    }
  ],
  "lanes_yaml_additions": [
    {
      "lane_name": "tenant-cost-labels-coverage-advisory",
      "lane_mode": "advisory",
      "gate_crate": "oya-check-tenant-cost-labels-coverage",
      "scope_glob": "microservices/*/iac/helm/*/rendered/*.yaml",
      "promotion_target": "strict when fleet coverage backlog reaches zero",
      "authority_adr": "ADR-0199 D-7"
    },
    {
      "lane_name": "backup-retention-discipline-advisory",
      "lane_mode": "advisory",
      "gate_crate": "oya-check-backup-retention-discipline",
      "scope_glob": "microservices/*/manifest.json (storage.backup.* fields)",
      "promotion_target": "strict when all µservices declare valid retention",
      "authority_adr": "ADR-0197 D-5"
    }
  ],
  "dispatcher_additions": [
    {
      "gate_id": "oya-check-tenant-cost-labels-coverage",
      "subcommand": "gate validate tenant-cost-labels-coverage",
      "advisory": true
    },
    {
      "gate_id": "oya-check-backup-retention-discipline",
      "subcommand": "gate validate backup-retention-discipline",
      "advisory": true
    }
  ],
  "child_agent_deliverables_landed_this_batch": {
    "adrs": [
      "docs/decisions/ADR-0196-object-storage-canonical-seaweedfs-primary-ceph-scale-up.md",
      "docs/decisions/ADR-0197-backup-substrate-velero-pgbackrest-restic.md",
      "docs/decisions/ADR-0198-k8s-node-autoscaling-karpenter.md",
      "docs/decisions/ADR-0199-per-tenant-cost-attribution-finops-substrate.md"
    ],
    "standards_docs": [
      "docs/standards/backup-canonical.md",
      "docs/standards/finops-cost-attribution-canonical.md"
    ],
    "helm_charts": [
      "microservices/cloud-iac/iac/helm/seaweedfs/",
