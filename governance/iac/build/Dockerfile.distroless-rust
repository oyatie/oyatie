# Canonical multi-stage Dockerfile per ADR-0146.
#
# Every µservice's CI references this file (or a per-µservice symlink) so
# the canonical base image + nonroot UID directive can be enforced by a
# single Rust validator (`oya gate validate container-base-image`).
#
# Authority: docs/decisions/ADR-0146-container-base-image-distroless-nonroot.md
# Standard: docs/standards/container-image-convention.md

# ---- stage 1: builder ---------------------------------------------------
# Rust 1.97.1-slim is pinned in registry catalog `lts_pins.rust`; bump via
# ADR-0064 canonical-base-and-localization update + workspace-hygiene
# lane.
FROM rust:1.97.1-slim AS builder
WORKDIR /build

# musl target = static binary that runs cleanly under distroless static.
RUN rustup target add x86_64-unknown-linux-musl

COPY . .
ARG BIN_NAME=oya-app
RUN cargo build --release \
        --target x86_64-unknown-linux-musl \
        --bin "${BIN_NAME}"

# ---- stage 2: runtime ---------------------------------------------------
# `static-debian12:nonroot` ships CA-cert bundle, /etc/passwd with the
# `nonroot` UID 65532 pre-baked, and timezone data. 2.5 MB compressed.
FROM gcr.io/distroless/static-debian12:nonroot

# Copy the static binary out of the builder stage. The destination is
# `/app` so the ENTRYPOINT is fixed regardless of BIN_NAME.
ARG BIN_NAME=oya-app
COPY --from=builder /build/target/x86_64-unknown-linux-musl/release/${BIN_NAME} /app

# `nonroot` UID 65532 is the only UID baked into the distroless image.
# The matching K8s policy is oya.securityContext.podStandard65534, which
# accepts 65532 explicitly.
USER 65532:65532

ENTRYPOINT ["/app"]
