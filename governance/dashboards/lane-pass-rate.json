{
  "$schema": "https://grafana.com/schema/dashboards/v10.0.0/dashboard.json",
  "uid": "governance-lane-pass-rate",
  "title": "Governance — Lane Pass Rate + Latency",
  "tags": [
    "governance",
    "lane-runtime",
    "fitness",
    "axis-foundry"
  ],
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "microservice",
        "type": "query",
        "datasource": "Mimir-governance",
        "query": "label_values(oya_governance_lane_run_total, microservice)"
      },
      {
        "name": "lane_id",
        "type": "query",
        "datasource": "Mimir-governance",
        "query": "label_values(oya_governance_lane_run_total{microservice=~\"$microservice\"}, lane_id)"
      },
      {
        "name": "severity",
        "type": "custom",
        "query": "BLOCKER,WARN,INFO",
        "current": {
          "value": "BLOCKER"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Lane Pass Rate (24h, BLOCKER lanes)",
      "datasource": "Mimir-governance",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(rate(oya_governance_lane_run_total{verdict=\"PASS\",severity=\"BLOCKER\"}[24h])) / sum(rate(oya_governance_lane_run_total{severity=\"BLOCKER\"}[24h]))",
          "legendFormat": "Pass rate"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": 0
              },
              {
                "color": "yellow",
                "value": 0.95
              },
              {
                "color": "green",
                "value": 0.99
              }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Total Lane Runs (24h)",
      "datasource": "Mimir-governance",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(increase(oya_governance_lane_run_total[24h]))"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "p99 Lane Latency (24h)",
      "datasource": "Mimir-governance",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(oya_governance_lane_duration_seconds_bucket[24h])) by (le))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "yellow",
                "value": 10
              },
              {
                "color": "red",
                "value": 60
              }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Active PRs in Gate",
      "datasource": "Mimir-governance",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(oya_governance_admission_pending_total)"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Lane Pass Rate per Microservice (1h moving avg)",
      "datasource": "Mimir-governance",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (microservice) (rate(oya_governance_lane_run_total{verdict=\"PASS\",microservice=~\"$microservice\"}[1h])) / sum by (microservice) (rate(oya_governance_lane_run_total{microservice=~\"$microservice\"}[1h]))",
          "legendFormat": "{{microservice}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Lane Latency p50 / p99 (per lane_id)",
      "datasource": "Mimir-governance",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le, lane_id) (rate(oya_governance_lane_duration_seconds_bucket{lane_id=~\"$lane_id\"}[5m])))",
          "legendFormat": "p50 {{lane_id}}"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le, lane_id) (rate(oya_governance_lane_duration_seconds_bucket{lane_id=~\"$lane_id\"}[5m])))",
          "legendFormat": "p99 {{lane_id}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "id": 7,
      "type": "table",
      "title": "Top 10 Failing Lanes (1h)",
      "datasource": "Mimir-governance",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "topk(10, sum by (lane_id, severity) (increase(oya_governance_lane_run_total{verdict=\"FAIL\"}[1h])))",
          "format": "table"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "ARC Runner Pool Utilization",
      "datasource": "Mimir-governance",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(oya_governance_arc_runners_active) / sum(oya_governance_arc_runners_total)",
          "legendFormat": "Utilization"
        },
        {
          "expr": "sum(oya_governance_arc_queue_depth)",
          "legendFormat": "Queue depth"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Resource overrun (OOM + SIGKILL) — F-01",
      "datasource": "Mimir-governance",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "expr": "sum by (lane_id) (increase(oya_governance_lane_resource_overrun_total[5m]))",
          "legendFormat": "{{lane_id}}"
        }
      ]
    }
  ],
  "annotations": {
    "list": [
      {
        "datasource": "Mimir-governance",
        "name": "Break-glass merges",
        "iconColor": "red",
        "expr": "oya_governance_break_glass_invocation_total > 0",
        "tagKeys": "incident_id"
      },
      {
        "datasource": "Mimir-governance",
        "name": "Baseline pin updates",
        "iconColor": "blue",
        "expr": "increase(oya_governance_baseline_pin_updated_total[1h]) > 0",
        "tagKeys": "axis"
      }
    ]
  }
}
