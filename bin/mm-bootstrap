#!/usr/bin/env bash
# Install this harness into another git repo for portability (e.g. ~/Developer/console).
# Does NOT invoke gjc/omc/omx/hermes.
set -euo pipefail

SRC="$(cd "$(dirname "$0")/.." && pwd)"
DST="${1:-}"
if [[ -z "$DST" ]]; then
  echo "Usage: mm-bootstrap <target-repo-root>" >&2
  exit 2
fi
DST="$(cd "$DST" && pwd)"
if [[ ! -d "$DST/.git" && ! -f "$DST/.git" ]]; then
  echo "mm-bootstrap: $DST is not a git repo root" >&2
  exit 2
fi

mkdir -p "$DST/.grok"
rsync -a \
  --exclude 'mm-runs/' \
  --exclude 'memory/' \
  "$SRC/" "$DST/.grok/"

chmod +x "$DST/.grok/bin/"* 2>/dev/null || true

# ensure ignores
if [[ -f "$DST/.gitignore" ]]; then
  if ! grep -q '^\.grok/mm-runs' "$DST/.gitignore" 2>/dev/null; then
    printf '\n# multi-agent harness journals\n.grok/mm-runs/\n.grok/memory/\n' >>"$DST/.gitignore"
  fi
else
  printf '.grok/mm-runs/\n.grok/memory/\n' >"$DST/.gitignore"
fi

# stamp project profile if still oyatie default
PROF="$DST/.grok/harness/project-profile.v1.json"
if [[ -f "$PROF" ]]; then
  python3 - "$PROF" "$DST" <<'PY'
import json, sys, os
path, dst = sys.argv[1], sys.argv[2]
name = os.path.basename(dst.rstrip("/"))
data = json.load(open(path))
if data.get("project_id") == "oyatie" and name != "oyatie":
    data["project_id"] = name
    data["display_name"] = name
    data["_bootstrap_note"] = "Review vcs.base_ref, pr_target, required_status_context, and surfaces for this repo."
    json.dump(data, open(path, "w"), indent=2)
    print(f"mm-bootstrap: updated project_id -> {name} (review VCS fields)")
else:
    print("mm-bootstrap: project-profile left as-is")
PY
fi

echo "mm-bootstrap: installed harness into $DST/.grok"
echo "mm-bootstrap: next — edit .grok/harness/project-profile.v1.json"
echo "mm-bootstrap: then  — .grok/bin/mm-preflight --cwd $DST"
