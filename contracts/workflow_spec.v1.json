{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.oyatie.com/contracts/workflow_spec.v1.json",
  "title": "OyatieWorkflowSpecV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tenant_id",
    "definition_id",
    "version",
    "nodes",
    "edges"
  ],
  "properties": {
    "schema_version": {
      "const": "workflow_spec.v1"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^ten_[A-Za-z0-9_.-]+$",
      "oyatie": {
        "data_class": "INTERNAL_ONLY"
      }
    },
    "definition_id": {
      "type": "string",
      "pattern": "^wfd_[A-Za-z0-9_.-]+$",
      "oyatie": {
        "data_class": "INTERNAL_ONLY"
      }
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[a-z0-9.-]+)?$",
      "oyatie": {
        "data_class": "PUBLIC"
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^wfn_[A-Za-z0-9_.-]+$",
            "oyatie": {
              "data_class": "INTERNAL_ONLY"
            }
          },
          "kind": {
            "enum": [
              "http",
              "transform",
              "branch",
              "join",
              "capability_call",
              "human_review"
            ],
            "oyatie": {
              "data_class": "PUBLIC"
            }
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "oyatie": {
              "data_class": "INTERNAL_ONLY"
            }
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "to"
        ],
        "properties": {
          "from": {
            "type": "string",
            "pattern": "^wfn_[A-Za-z0-9_.-]+$",
            "oyatie": {
              "data_class": "INTERNAL_ONLY"
            }
          },
          "to": {
            "type": "string",
            "pattern": "^wfn_[A-Za-z0-9_.-]+$",
            "oyatie": {
              "data_class": "INTERNAL_ONLY"
            }
          },
          "condition": {
            "type": "string",
            "oyatie": {
              "data_class": "INTERNAL_ONLY"
            }
          }
        }
      }
    }
  }
}
