# Residual product/docs surface for network capability (dual-home burn-down).
# Live crates live under network/{core,ports,adapters} with their own package
# BUCKs. This package owns residual service docs, capability-root manifest,
# contracts, and OpenSLO YAML now under network/observability/slos/ (rehomed
# from cloud/cloud-network and cloud/cloud-network-dns in wave 26) so they
# remain in the Buck2 corpus graph (ADR-0541).

load("//governance/corpus/extract:yaml_facts.bzl", "corpus_yaml_facts_shards")

# Hermetic input set for gates that must validate network residual manifests.
filegroup(
    name = "live-service-manifest-corpus",
    srcs = glob(["**/manifest.json"]),
    visibility = ["PUBLIC"],
)

corpus_yaml_facts_shards(
    srcs = glob(["**/*.yaml", "**/*.yml"]),
    shard_size = 256,
)
